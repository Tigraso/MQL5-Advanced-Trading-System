void              LoadTasksFromBin()
  {
   ArrayResize(m_taskList, 0);
   string filePath = g_dataPath + "TM_Tasks.bin";
   if(!FileIsExist(filePath))
      return;

   int file = FileOpen(filePath, FILE_READ|FILE_BIN);
   if(file != INVALID_HANDLE)
     {
      FileReadArray(file, g_tasksDisk);
      FileClose(file);
      // ... (El resto de tu código queda igual) ...

      int total = ArraySize(g_tasksDisk);
      ArrayResize(m_taskList, total);

      for(int i=0; i<total; i++)
        {
         m_taskList[i].taskId         = g_tasksDisk[i].taskId;
         m_taskList[i].actionId       = g_tasksDisk[i].actionId;
         m_taskList[i].execTime       = g_tasksDisk[i].execTime;
         m_taskList[i].ticket         = g_tasksDisk[i].ticket;
         m_taskList[i].completed      = g_tasksDisk[i].completed;
         m_taskList[i].retryCount     = g_tasksDisk[i].retryCount;
         m_taskList[i].isLoop         = g_tasksDisk[i].isLoop;
         m_taskList[i].isPriceMode    = g_tasksDisk[i].isPriceMode;
         m_taskList[i].entryPrice     = g_tasksDisk[i].entryPrice;
         m_taskList[i].stopLimitPrice = g_tasksDisk[i].stopLimitPrice;
         m_taskList[i].sl_value       = g_tasksDisk[i].sl_value;
         m_taskList[i].tp_value       = g_tasksDisk[i].tp_value;
         m_taskList[i].lots           = g_tasksDisk[i].lots;
         m_taskList[i].isVirtual      = g_tasksDisk[i].isVirtual;
         m_taskList[i].isSplit        = g_tasksDisk[i].isSplit;
         m_taskList[i].isHide         = g_tasksDisk[i].isHide;
         m_taskList[i].isOCO          = g_tasksDisk[i].isOCO;

         // Conversión: Char Array -> String
         m_taskList[i].symbol      = CharArrayToString(g_tasksDisk[i].symbol);
         m_taskList[i].description = CharArrayToString(g_tasksDisk[i].description);
         ArrayCopy(m_taskList[i].days, g_tasksDisk[i].days);

         m_taskList[i].ts.isActive = g_tasksDisk[i].ts_isActive;
         m_taskList[i].ts.mode     = g_tasksDisk[i].ts_mode;
         ArrayCopy(m_taskList[i].ts.inputs,  g_tasksDisk[i].ts_inputs);
         ArrayCopy(m_taskList[i].ts.units,   g_tasksDisk[i].ts_units);
         ArrayCopy(m_taskList[i].ts.dropIdx, g_tasksDisk[i].ts_dropIdx);

         m_taskList[i].be.isActive   = g_tasksDisk[i].be_isActive;
         m_taskList[i].be.isAuto     = g_tasksDisk[i].be_isAuto;
         m_taskList[i].be.valStart   = g_tasksDisk[i].be_valStart;
         m_taskList[i].be.valOffset  = g_tasksDisk[i].be_valOffset;
         m_taskList[i].be.modeStart  = g_tasksDisk[i].be_modeStart;
         m_taskList[i].be.modeOffset = g_tasksDisk[i].be_modeOffset;

         m_taskList[i].grid.distMode = g_tasksDisk[i].grid_distMode;
         m_taskList[i].grid.lotMode  = g_tasksDisk[i].grid_lotMode;
         for(int k=0; k<5; k++)
           {
            m_taskList[i].grid.rows[k].isActiveTP  = g_tasksDisk[i].grid_rows[k].isActiveTP;
            m_taskList[i].grid.rows[k].isActiveSL  = g_tasksDisk[i].grid_rows[k].isActiveSL;
            m_taskList[i].grid.rows[k].valTP_Price = g_tasksDisk[i].grid_rows[k].valTP_Price;
            m_taskList[i].grid.rows[k].valTP_Vol   = g_tasksDisk[i].grid_rows[k].valTP_Vol;
            m_taskList[i].grid.rows[k].valSL_Price = g_tasksDisk[i].grid_rows[k].valSL_Price;
            m_taskList[i].grid.rows[k].valSL_Vol   = g_tasksDisk[i].grid_rows[k].valSL_Vol;
           }
        }
     }
  }

