//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
   void              DrawCanvasSubMenu_Edit(CUIEngine &subEngine, ulong ticket, int finalMenuX, int btnY, bool esPosicion, double entry, double tp, double sl, bool isBuyDir)
     {
      CTradeState *mem = TradeRAM.Get(ticket);
      if(mem == NULL)
         return;

      // 1. ¿Es una orden Stop Limit?
      long oType = mem.isVirtual ? mem.virtType : OrderGetInteger(ORDER_TYPE);
      bool isStopLimit = (!esPosicion && (oType == ORDER_TYPE_BUY_STOP_LIMIT || oType == ORDER_TYPE_SELL_STOP_LIMIT));

      // 2. Altura dinámica del submenú (Ajustada para fuente 12)
      int subW = 145; // Un poco más ancho para que quepan los números grandes
      int subH = esPosicion ? 105 : (isStopLimit ? 160 : 133);
      int subX = GetSmartSubMenuX(finalMenuX, subW);
      string canvasName = "CanvasSubMenu_" + IntegerToString(ticket);

      if(ObjectFind(0, canvasName) < 0)
        {
         subEngine.Init(ENGINE_EA2_SUBMENU, canvasName, subX, btnY, subW, subH, ticket);
         DWM.RegisterWindow(GetPointer(subEngine));
         ObjectSetInteger(0, canvasName, OBJPROP_ZORDER, 2000);
         ObjectSetInteger(0, canvasName, OBJPROP_BACK, false);
        }
      else
        {
         ObjectSetInteger(0, canvasName, OBJPROP_XDISTANCE, subX);
         ObjectSetInteger(0, canvasName, OBJPROP_YDISTANCE, btnY);
         subEngine.m_panelX = subX;
         subEngine.m_panelY = btnY;
         subEngine.Resize(subW, subH); // Adaptamos altura si mutó
        }
      subEngine.Clear();
      subEngine.AddPanel(0, 0, subW, subH, Theme.bg, Theme.border);

      int currentY = 5;
      int inpX = 45;
      int inpW = 90; // Cajitas más anchas

      // DIBUJAR GATILLO (Solo Stop Limits)
      if(isStopLimit)
        {
         subEngine.AddLabel("PSL:", 5, currentY + 4, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
         subEngine.AddButton(OP_TM_INP_EDIT_TRIG, inpX, currentY, inpW, 22, DoubleToString(mem.draftTrig, _Digits), Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
         currentY += 26;
        }

      if(!esPosicion)
        {
         subEngine.AddLabel("Price:", 5, currentY + 4, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
         subEngine.AddButton(OP_TM_INP_EDIT_PR, inpX, currentY, inpW, 22, DoubleToString(mem.draftPr, _Digits), Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
         currentY += 26;
        }

      subEngine.AddLabel("TP:", 5, currentY + 4, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      subEngine.AddButton(OP_TM_INP_EDIT_TP, inpX, currentY, inpW, 22, DoubleToString(mem.draftTP, _Digits), Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      currentY += 26;

      subEngine.AddLabel("SL:", 5, currentY + 4, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      subEngine.AddButton(OP_TM_INP_EDIT_SL, inpX, currentY, inpW, 22, DoubleToString(mem.draftSL, _Digits), Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      currentY += 28; // Un poco más de aire antes del botón Apply

      subEngine.AddButton(OP_TM_M_EDIT_APPLY, 5, currentY, subW - 10, 22, "APPLY", Theme.accent, Theme.surface, Theme.accent, Theme.bg, Theme.accent, TA_CENTER|TA_VCENTER, "Arial", 12);
      subEngine.Render();
     }

//+------------------------------------------------------------------+
//| HELPER PARA EL GRID: Calcula el lote de una fila                 |
//+------------------------------------------------------------------+
   double            CalculateGridRowLot(int lotMode, double baseVol, double currentRem, double rawValV, double stepVol, double minVol)
     {
      double calcLot = 0;
      if(lotMode == 0)
         calcLot = baseVol * (rawValV / 100.0);
      else
         if(lotMode == 1)
            calcLot = currentRem * (rawValV / 100.0);
         else
            calcLot = rawValV;

      calcLot = MathFloor(calcLot / stepVol) * stepVol;
      if(calcLot < minVol)
         calcLot = minVol;
      if(calcLot > currentRem)
         calcLot = currentRem;
      return calcLot;
     }

//+------------------------------------------------------------------+
//| SUB-VENTANA: GRID (TP/SL) EN CCANVAS (Z-Order Normalizado)       |
//+------------------------------------------------------------------+
   void              DrawCanvasSubMenu_Grid(CUIEngine &subEngine, ulong ticket, int finalMenuX, int btnY, bool esPosicion)
     {
      int subW = 340;
      int subH = 175; // Altura fija y perfecta
      int subX = GetSmartSubMenuX(finalMenuX, subW);

      string canvasName = "CanvasSubMenu_" + IntegerToString(ticket);

      if(ObjectFind(0, canvasName) < 0)
        {
         subEngine.Init(ENGINE_EA2_SUBMENU, canvasName, subX, btnY, subW, subH, ticket);
         DWM.RegisterWindow(GetPointer(subEngine));
         ObjectSetInteger(0, canvasName, OBJPROP_ZORDER, Z_SUB_MENU); // <-- CAPA LIMPIA (30)
         ObjectSetInteger(0, canvasName, OBJPROP_BACK, false);
        }
      else
        {
         ObjectSetInteger(0, canvasName, OBJPROP_XDISTANCE, subX);
         ObjectSetInteger(0, canvasName, OBJPROP_YDISTANCE, btnY);
         subEngine.m_panelX = subX;
         subEngine.m_panelY = btnY;
         // ADIÓS AL RESIZE: Ya no lo necesitamos. Si cambia de menú, ProcessOrderMenuClick lo destruye.
        }

      subEngine.Clear();

      CTradeState *mem = TradeRAM.Get(ticket);
      if(mem == NULL)
         return;

      uint bgMenu = Theme.bg;
      uint colBorder = Theme.border;
      subEngine.AddPanel(0, 0, subW, subH, bgMenu, colBorder);

      int distMode = mem.grid.distMode;
      int lotMode  = mem.grid.lotMode;

      int yTop = 5;
      int wHeadBtn = (subW - 15) / 2;

      // 1. DROPDOWNS SUPERIORES
      // 1. LOS BOTONES DE LOS DROPDOWNS (Arriba)
      string txtDist = g_gridDistOpts[distMode] + " ▼";
      // Le ponemos Theme.border (Gris claro) como color Hover (8vo parámetro)
      subEngine.AddButton(OP_TM_GRID_DIST_DROP, 5, yTop, wHeadBtn, 20, txtDist, Theme.surface, Theme.border, Theme.surface, Theme.textMain, ColorToARGB(C'255,20,110',255), TA_CENTER|TA_VCENTER, "Arial", 12);

      string txtLot = g_gridLotOpts[lotMode] + " ▼";
      subEngine.AddButton(OP_TM_GRID_LOT_DROP, 10 + wHeadBtn, yTop, wHeadBtn, 20, txtLot, Theme.surface, Theme.border, Theme.surface, Theme.textMain, ColorToARGB(C'0,240,240',255), TA_CENTER|TA_VCENTER, "Arial", 12);

      int startY = yTop + 25;
      int rowH   = 22;
      int gapGrid = 5;

      double baseVol = esPosicion ? PositionGetDouble(POSITION_VOLUME) : OrderGetDouble(ORDER_VOLUME_CURRENT);
      double currentRemTP = baseVol;
      double currentRemSL = baseVol;
      double stepVol = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
      double minVol  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);

      string sT = IntegerToString(ticket);

      // 2. CONSTRUIR LAS 5 FILAS
      for(int k=0; k<5; k++)
        {
         int currentY = startY + (k * (rowH + gapGrid));
         string sI = IntegerToString(k+1);

         // --- LADO IZQUIERDO (TP) ---
         // LADO IZQUIERDO (TP)
         // --- LADO IZQUIERDO (TP) ---
         bool isTPActive = mem.grid.rows[k].isActiveTP;
         uint colTP      = isTPActive ? Theme.buy : Theme.surface;
         uint colTPHover = isTPActive ? Theme.buy : Theme.bg;
         uint colTPTxt   = isTPActive ? Theme.bg : Theme.textMain;

         double rawValV = mem.grid.rows[k].valTP_Vol;
         if(rawValV == 0)
            rawValV = 20;
         double calcLot = CalculateGridRowLot(lotMode, baseVol, currentRemTP, rawValV, stepVol, minVol);
         if(isTPActive)
            currentRemTP = MathMax(0, currentRemTP - calcLot);

         string txtTPBtn = "TP" + sI + ": " + DoubleToString(calcLot, 2);
         subEngine.AddButton((ushort)(OP_TM_GRID_TP_1 + k), 5, currentY, 75, 20, txtTPBtn, colTP, colTPHover, colTP, colTPTxt, colTP, TA_CENTER|TA_VCENTER, "Arial", 12);

         // INPUTS TP
         double valTP_P = mem.grid.rows[k].valTP_Price;
         subEngine.AddButton((ushort)(OP_INP_GRID_TP_P_1 + k), 85, currentY, 37, 20, DoubleToString(valTP_P, distMode==1?_Digits:1), Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, isTPActive ? colTP : Theme.border, TA_CENTER|TA_VCENTER, "Arial", 9);

         double valTP_V = mem.grid.rows[k].valTP_Vol;
         subEngine.AddButton((ushort)(OP_INP_GRID_TP_V_1 + k), 127, currentY, 37, 20, DoubleToString(valTP_V==0?20:valTP_V, 0), Theme.inputBg, Theme.border, Theme.accent, Theme.textDim, isTPActive ? colTP : Theme.border, TA_CENTER|TA_VCENTER, "Arial", 9);


         // --- LADO DERECHO (SL) ---
         int rightStart = 170;
         bool isSLActive = mem.grid.rows[k].isActiveSL;
         uint colSL      = isSLActive ? Theme.sell : Theme.surface;
         uint colSLHover = isSLActive ? Theme.sell : Theme.bg;
         uint colSLTxt   = isSLActive ? Theme.bg : Theme.textMain;

         double rawValSLV = mem.grid.rows[k].valSL_Vol;
         if(rawValSLV == 0)
            rawValSLV = 20;
         double calcLotSL = CalculateGridRowLot(lotMode, baseVol, currentRemSL, rawValSLV, stepVol, minVol);
         if(isSLActive)
            currentRemSL = MathMax(0, currentRemSL - calcLotSL);

         string txtSLBtn = "SL" + sI + ": " + DoubleToString(calcLotSL, 2);
         subEngine.AddButton((ushort)(OP_TM_GRID_SL_1 + k), rightStart, currentY, 75, 20, txtSLBtn, colSL, colSLHover, colSL, colSLTxt, colSL, TA_CENTER|TA_VCENTER, "Arial", 12);

         // INPUTS SL
         double valSL_P = mem.grid.rows[k].valSL_Price;
         subEngine.AddButton((ushort)(OP_INP_GRID_SL_P_1 + k), rightStart + 80, currentY, 37, 20, DoubleToString(valSL_P, distMode==1?_Digits:1), Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, isSLActive ? colSL : Theme.border, TA_CENTER|TA_VCENTER, "Arial", 9);

         double valSL_V = mem.grid.rows[k].valSL_Vol;
         subEngine.AddButton((ushort)(OP_INP_GRID_SL_V_1 + k), rightStart + 122, currentY, 37, 20, DoubleToString(valSL_V==0?20:valSL_V, 0), Theme.inputBg, Theme.border, Theme.accent, Theme.textDim, isSLActive ? colSL : Theme.border, TA_CENTER|TA_VCENTER, "Arial", 9);


        }

      subEngine.Render();
     }

//+------------------------------------------------------------------+
//| SUB-VENTANA: BREAK EVEN EN CCANVAS                               |
//+------------------------------------------------------------------+
   void              DrawCanvasSubMenu_BE(CUIEngine &subEngine, ulong ticket, int finalMenuX, int btnY)
     {
      int subW = 160;
      int subH = 105;
      int subX = GetSmartSubMenuX(finalMenuX, subW);
      string canvasName = "CanvasSubMenu_" + IntegerToString(ticket);

      if(ObjectFind(0, canvasName) < 0)
        {
         subEngine.Init(ENGINE_EA2_SUBMENU, canvasName, subX, btnY, subW, subH, ticket);
         DWM.RegisterWindow(GetPointer(subEngine));
         ObjectSetInteger(0, canvasName, OBJPROP_ZORDER, Z_SUB_MENU);
         ObjectSetInteger(0, canvasName, OBJPROP_BACK, false);
        }
      else
        {
         ObjectSetInteger(0, canvasName, OBJPROP_XDISTANCE, subX);
         ObjectSetInteger(0, canvasName, OBJPROP_YDISTANCE, btnY);
         subEngine.m_panelX = subX;
         subEngine.m_panelY = btnY;
        }
      subEngine.Clear();

      CTradeState *mem = TradeRAM.Get(ticket);
      if(mem == NULL)
         return;

      subEngine.AddPanel(0, 0, subW, subH, Theme.bg, Theme.border); // <-- TEMA

      bool isBEActive = mem.be.isActive;
      uint colBE = isBEActive ? Theme.accent : Theme.surface; // <-- TEMA
      subEngine.AddButton(OP_TM_BE_EXEC, 5, 5, subW-10, 22, "BREAK EVEN: " + (isBEActive?"ON":"OFF"), colBE, Theme.border, colBE, (isBEActive?Theme.bg:Theme.textMain), colBE, TA_CENTER|TA_VCENTER, "Arial", 12);

      string sT = IntegerToString(ticket);

      // --- START ---
      int yRow1 = 33;
      subEngine.AddLabel("Start:", 5, yRow1 + 3, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      double valSt = mem.be.valStart;
      if(valSt == 0)
         valSt = 10;

      subEngine.AddButton(OP_INP_BE_START, 45, yRow1, 50, 20, DoubleToString(valSt, (mem.be.modeStart==0)?0:2), Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      // --- START ---
      int mStart = (int)mem.be.modeStart;
      if(mStart < 0 || mStart > 3)
         mStart = 0;
      // Botón rotativo (Sin flecha)
      subEngine.AddButton(OP_TM_BE_START_DROP, 100, yRow1, 55, 20, g_beModes[mStart], Theme.surface, Theme.border, Theme.surface, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      // --- OFFSET ---
      int yRow2 = 58;
      bool isAuto = mem.be.isAuto;
      subEngine.AddLabel("Offset:", 5, yRow2 + 3, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);

      double valOff = mem.be.valOffset;
      string strOff = isAuto ? "AUTO" : DoubleToString(valOff, (mem.be.modeOffset==0)?0:2);
      uint offBg = isAuto ? Theme.bg : Theme.inputBg;

      subEngine.AddButton(OP_INP_BE_OFFSET, 45, yRow2, 50, 20, strOff, offBg, Theme.border, Theme.accent, isAuto?Theme.textDim:Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      // --- OFFSET ---
      int mOff = (int)mem.be.modeOffset;
      if(mOff < 0 || mOff > 3)
         mOff = 0;
      // Botón rotativo (Sin flecha)
      subEngine.AddButton(OP_TM_BE_OFF_DROP, 100, yRow2, 55, 20, g_beModes[mOff], Theme.surface, Theme.border, Theme.surface, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      // --- AUTO BUTTON ---
      uint colAuto = isAuto ? ColorToARGB(C'255,20,110', 255) : ColorToARGB(C'50,50,55', 255);
      subEngine.AddButton(OP_TM_BE_AUTO, 5, 82, subW-10, 18, isAuto ? "AUTO OFFSET: ON" : "AUTO OFFSET", colAuto, Theme.border, colAuto, isAuto?Theme.bg:Theme.textMain, colAuto, TA_CENTER|TA_VCENTER, "Arial", 12);

      subEngine.Render();
     }

