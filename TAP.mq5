//+------------------------------------------------------------------+
//| GESTOR DE VENTANAS (DESKTOP WINDOW MANAGER)                      |
//+------------------------------------------------------------------+
   class CWindowManager
     {
   private:
      CUIEngine         *m_windows[]; // Pila de ventanas (Z-Stack)
      int               m_baseZ;      // Z-Order inicial (10)

   public:
      // --- VARIABLES UNIVERSALES DE ARRASTRE ---
      CUIEngine         *m_dragWindow; // Puntero a la ventana que estamos arrastrando
      int               m_dragOffsetX;
      int               m_dragOffsetY;

      // --- MEMORIA DEL FANTASMA ACTIVO (O(1) Routing) ---
      CUIEngine         *m_activeGhostEngine;
      ulong             m_activeGhostTicket;
      int               m_activeGhostOpCode;
      string            m_activeGhostName;

                     CWindowManager() : m_baseZ(10), m_dragWindow(NULL), m_activeGhostEngine(NULL), m_activeGhostTicket(0), m_activeGhostOpCode(0), m_activeGhostName("")  {}
                    ~CWindowManager() { ArrayResize(m_windows, 0); }

      // +------------------------------------------------------------------+
      // | EL RAYCAST (EL ESCUDO ANTI-TRANSPARENCIA A 120 FPS)              |
      // +------------------------------------------------------------------+
      CUIEngine*        RaycastMouse(int absX, int absY, int mouseState, int lastState)
        {
         // 1. ¿ESTAMOS ARRASTRANDO UNA VENTANA? (Motor de movimiento fluido)
         if(mouseState == 1 && lastState == 1 && CheckPointer(m_dragWindow) != POINTER_INVALID)
           {
            int newX = absX - m_dragOffsetX;
            int newY = absY - m_dragOffsetY;

            int chartW = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);
            int chartH = (int)ChartGetInteger(0, CHART_HEIGHT_IN_PIXELS);

            if(newY + 30 > chartH)
               newY = chartH - 30;
            if(newX + (m_dragWindow.m_panelW / 2) > chartW)
               newX = chartW - (m_dragWindow.m_panelW / 2);
            if(newX < 0)
               newX = 0;
            if(newY < 0)
               newY = 0;

            m_dragWindow.m_panelX = newX;
            m_dragWindow.m_panelY = newY;
            ObjectSetInteger(0, m_dragWindow.m_canvasName, OBJPROP_XDISTANCE, newX);
            ObjectSetInteger(0, m_dragWindow.m_canvasName, OBJPROP_YDISTANCE, newY);
            ChartRedraw();
            return m_dragWindow;
           }

         // 2. SOLTAR EL RATÓN (Fin del arrastre o clic general)
         if(mouseState == 0 && lastState == 1)
           {
            // Si estábamos arrastrando una ventana, guardamos su posición
            if(CheckPointer(m_dragWindow) != POINTER_INVALID)
              {
               // === ENRUTADOR INTELIGENTE O(1) ===
               // Del 0 al 4 son ventanas estáticas que se guardan en g_panelDisk
               if(m_dragWindow.m_engineType <= ENGINE_MODAL_INFO)
                 {
                  SavePanelToBin();
                 }

               // Lógica de restauración de submenús (¡Cero Strings!)
               if(m_dragWindow.m_engineType == ENGINE_EA2_MENU)
                 {
                  ulong tk = m_dragWindow.m_ownerTicket; // Lectura directa desde RAM
                  CTradeState *mem = TradeRAM.Get(tk);
                  if(mem != NULL && g_dragRestoreSubMenu != 0)
                    {
                     mem.activeSubMenu = g_dragRestoreSubMenu;
                     g_dragRestoreSubMenu = 0;
                     UpdateOpenTradesVisuals();
                     ChartRedraw();
                    }
                 }

               m_dragWindow.ResetHovers();
               m_dragWindow = NULL;
              }

            ChartSetInteger(0, CHART_MOUSE_SCROLL, true);
            return NULL;
           }
         // 3. RAYCAST TOP-DOWN
         int size =        ArraySize(m_windows);
         for(int i = size - 1; i >= 0; i--)
           {
            CUIEngine *win = m_windows[i];
            if(CheckPointer(win) == POINTER_INVALID)
               continue;

            bool overDrop = false;
            if(win.m_openDropdown != 0)
              {
               if(absX >= win.m_dropX && absX <= win.m_dropX + win.m_dropW && absY >= win.m_dropY && absY <= win.m_dropY + win.m_dropH)
                  overDrop = true;
              }

            if(win.IsMouseOver(absX, absY) || overDrop)
              {
               if(mouseState == 1 && lastState == 0)
                 {
                  this.BringToFront(win);

                  int clickedBtn = win.GetClickedButton(absX, absY);
                  int dropIdx    = win.CheckDropdownClick(absX, absY);

                  // --- FIX ARQUITECTÓNICO: ESTADO UI ---
                  // No borrar el menú si el clic fue EXACTAMENTE en el botón que lo abrió.
                  // Esto permite que el ToggleDropdown haga su trabajo suavemente sin parpadear.
                  if(win.m_openDropdown != 0 && dropIdx == -1 && clickedBtn != win.m_openDropdown)
                    {
                     win.ClearDrop();
                    }

                  int localY = absY - win.m_panelY;
                  if(localY <= 38 && clickedBtn == 0 && win.m_openDropdown == 0 && !overDrop)
                    {
                     m_dragWindow = win;
                     m_dragOffsetX = absX - win.m_panelX;
                     m_dragOffsetY = absY - win.m_panelY;

                     if(win.m_engineType == ENGINE_EA2_MENU)
                       {
                        ulong tk = win.m_ownerTicket; // ¡BUM! Instantáneo.
                        CTradeState *mem = TradeRAM.Get(tk);
                        if(mem != NULL)
                          {
                           g_dragRestoreSubMenu = mem.activeSubMenu;
                           mem.activeSubMenu = 0;
                           // --- SOLUCIÓN 1: DESREGISTRAR DEL DWM ANTES DE MATARLO ---
                           DWM.UnregisterWindow(GetPointer(mem.subMenuCanvas));
                           mem.subMenuCanvas.DestroyCanvas();
                          }
                       }

                     ChartSetInteger(0, CHART_MOUSE_SCROLL, false);
                     win.ResetHovers();
                     return win;
                    }
                 }

               // ... el resto sigue igual ...
               // B. PROCESAR HOVER Y PASAR EVENTO AL MOTOR
               if(win.m_openDropdown != 0)
                  win.ProcessDropdownHover(absX, absY);

               long lx = absX;
               double dy = absY;
               win.OnEvent(CHARTEVENT_MOUSE_MOVE, lx, dy, IntegerToString(mouseState));

               return win; // 🛑 ¡CORTE DE RAYO! Protege las ventanas de abajo.
              }
           }
         return            NULL; // Atraviesa todo y toca el gráfico
        }

      // 4. CERRAR TODOS LOS DROPDOWNS (GLOBAL BLUR)
      void              CloseAllDropdowns()
        {
         int size = ArraySize(m_windows);
         for(int i = 0; i < size; i++)
           {
            if(CheckPointer(m_windows[i]) != POINTER_INVALID)
              {
               if(m_windows[i].m_openDropdown != 0)
                  m_windows[i].ClearDrop();
              }
           }
        }

      // 1. REGISTRAR UNA NUEVA VENTANA (Nace en la cima)
      void              RegisterWindow(CUIEngine *win)
        {
         if(CheckPointer(win) == POINTER_INVALID)
            return;

         // Evitar duplicados (si ya estaba registrada, abortamos)
         int size = ArraySize(m_windows);
         for(int i = 0; i < size; i++)
           {
            if(m_windows[i] == win)
               return;
           }

         // Añadimos al final del array
         ArrayResize(m_windows, size + 1);
         m_windows[size] = win;

         // La coronamos: Nace con el mayor Z-Order posible y se recrea visualmente
         win.BringToFront(m_baseZ + size);
        }

      // 2. ELIMINAR UNA VENTANA (Ej: Se cierra un menú o el NewsWin)
      void              UnregisterWindow(CUIEngine *win)
        {
         if(CheckPointer(win) == POINTER_INVALID)
            return;

         int size = ArraySize(m_windows);
         int index = -1;

         // Buscamos dónde está la ventana en el array
         for(int i = 0; i < size; i++)
           {
            if(m_windows[i] == win)
              {
               index = i;
               break;
              }
           }

         if(index == -1)
            return; // No estaba registrada

         // Desplazamos las que estaban por encima de ella un paso hacia abajo
         for(int i = index; i < size - 1; i++)
           {
            m_windows[i] = m_windows[i + 1];
            // Degradación silenciosa: bajamos el Z-Order sin repintarlas
            m_windows[i].SetZOrder(m_baseZ + i);
           }

         // Achicamos el array borrando el último espacio duplicado
         ArrayResize(m_windows, size - 1);
        }

      // 3. TRAER AL FRENTE (El motor matemático que la sube a la cima)
      void              BringToFront(CUIEngine *win)
        {
         if(CheckPointer(win) == POINTER_INVALID)
            return;

         int size = ArraySize(m_windows);
         if(size <= 0)
            return; // Si hay 0 o 1 ventana, no hay nada que reordenar

         int index = -1;
         for(int i = 0; i < size; i++)
           {
            if(m_windows[i] == win)
              {
               index = i;
               break;
              }
           }

         if(index == -1)
            return; // No estaba registrada

         // Si ya es la Reyna (está en la cima), solo la recreamos visualmente por si MT5 la tapó
         if(index == size - 1)
           {
            win.BringToFront(m_baseZ + index);
            return;
           }

         // Guardamos temporalmente la ventana que va a subir al trono
         CUIEngine *target = m_windows[index];

         // Desplazamos TODAS las que estaban por encima de ella un nivel hacia ABAJO
         for(int i = index; i < size - 1; i++)
           {
            m_windows[i] = m_windows[i + 1];
            m_windows[i].SetZOrder(m_baseZ + i); // Degradación silenciosa
           }

         // Ponemos la target en la cima del array y la recreamos a todo dar
         m_windows[size - 1] = target;
         target.BringToFront(m_baseZ + size - 1);
        }
     };

// Instancia global de nuestro Árbitro de Ventanas
   CWindowManager    DWM;

   CUIEngine         TimeWin; // Motor para la ventana del Time Trader

   CUIEngine         ConfirmWin; // Motor CCanvas para la ventana de confirmación

