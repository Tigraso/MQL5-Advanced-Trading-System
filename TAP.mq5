         subEngine.m_panelY = btnY;
        }
      subEngine.Clear();
      subEngine.AddPanel(0, 0, subW, subH, Theme.bg, Theme.border);
      subEngine.AddLabel("Close %:", 10, 10, "Arial", 12, Theme.textMain, TA_LEFT|TA_TOP);

      CTradeState *mem = TradeRAM.Get(ticket);
      double draftPart = (mem != NULL) ? mem.draftPart : 50.0;

