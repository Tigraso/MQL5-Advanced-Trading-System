//+------------------------------------------------------------------+
//| MOTOR DE VISIBILIDAD: COLAPSO DE LA FIGURA PRE-OP (EA1)          |
//+------------------------------------------------------------------+
void              ApplyPreOpCollapseState(bool collapsed)
  {
   long state = collapsed ? OBJ_NO_PERIODS : OBJ_ALL_PERIODS;

   // 1. Líneas Base
   ObjectSetInteger(0, m_lineEntry, OBJPROP_TIMEFRAMES, state);
   ObjectSetInteger(0, m_lineSL, OBJPROP_TIMEFRAMES, state);
   ObjectSetInteger(0, m_lineTP, OBJPROP_TIMEFRAMES, state);

   // 2. Stop Limit Secundario
   if(m_isStopLimitMode && ObjectFind(0, m_lineStopLimit) >= 0)
     {
      ObjectSetInteger(0, m_lineStopLimit, OBJPROP_TIMEFRAMES, state);
      ObjectSetInteger(0, m_btnSec_Name, OBJPROP_TIMEFRAMES, state);
      ObjectSetInteger(0, m_btnSec_Name + "_VisLine", OBJPROP_TIMEFRAMES, state);
     }

   // 3. Botonera de Control
   ObjectSetInteger(0, m_btnCenter_Name, OBJPROP_TIMEFRAMES, state);
   ObjectSetInteger(0, m_btnSL_Name, OBJPROP_TIMEFRAMES, state);
   ObjectSetInteger(0, m_btnTP_Name, OBJPROP_TIMEFRAMES, state);
   ObjectSetInteger(0, m_btnMKT_Chart_Name, OBJPROP_TIMEFRAMES, state);
   ObjectSetInteger(0, m_btnREV_Chart_Name, OBJPROP_TIMEFRAMES, state);
   ObjectSetInteger(0, m_btnSLim_Chart_Name, OBJPROP_TIMEFRAMES, state);
   ObjectSetInteger(0, m_btnClose_Chart_Name, OBJPROP_TIMEFRAMES, state);
   ObjectSetInteger(0, m_btnOpen_Chart_Name, OBJPROP_TIMEFRAMES, state);
   ObjectSetInteger(0, m_btnLockSL_Name, OBJPROP_TIMEFRAMES, state);
   ObjectSetInteger(0, m_btnLockTP_Name, OBJPROP_TIMEFRAMES, state);

   // 4. Líneas Avanzadas (Grid, TS, BE)
   if(collapsed)
      HideAdvancedLinesForZeroLoad(0);
   else
      ShowAdvancedLinesAfterZeroLoad(0);
  }
  
  //+------------------------------------------------------------------+
//| ESCUDO ACTIVO: Aniquila operaciones no autorizadas al instante   |
//+------------------------------------------------------------------+
void              EnforceAccountLock()
  {
   // Si no hay candado activo, no hacemos nada
   if(g_protect.accountLockedUntil <= TimeCore.Now())
      return;

   bool tradeKilled = false;

   // 1. BARRIDO DE POSICIONES VIVAS
   for(int i = PositionsTotal() - 1; i >= 0; i--)
     {
      ulong tk = PositionGetTicket(i);
      if(tk > 0)
        {
         long magic = PositionGetInteger(POSITION_MAGIC);
         string sym = PositionGetString(POSITION_SYMBOL);

         // Disparamos a matar usando tu motor asíncrono (cero lag)
         QueueClosePosition(tk);
         tradeKilled = true;

         // CAMINO A: Si es un EA Rebelde (Magic distinto de 0 y distinto al nuestro)
         if(magic != 0 && magic != MAGIC_NUM)
           {
            HuntAndDestroyRogueChart(sym);
           }
        }
     }

   // 2. BARRIDO DE ÓRDENES PENDIENTES
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      ulong tk = OrderGetTicket(i);
      if(tk > 0)
        {
         long magic = OrderGetInteger(ORDER_MAGIC);
         string sym = OrderGetString(ORDER_SYMBOL);

         // Disparamos a matar (Motor Asíncrono)
         QueueDeleteOrder(tk);
         tradeKilled = true;

         // CAMINO A: Si es un EA Rebelde
         if(magic != 0 && magic != MAGIC_NUM)
           {
            HuntAndDestroyRogueChart(sym);
           }
        }
     }

   if(tradeKilled)
     {
      Print("[Security] Account is LOCKED. Unauthorized trade detected and neutralized.");
      PlaySound("timeout.wav");
     }
  }

//+------------------------------------------------------------------+
//| CAZADOR DE EAs: Busca el gráfico del intruso y lo cierra         |
//+------------------------------------------------------------------+
void              HuntAndDestroyRogueChart(string targetSym)
  {
   long currChart = ChartFirst();
   while(currChart >= 0)
     {
      // ESCUDO DE SUPERVIVENCIA: ¡Jamás nos suicidamos a nosotros mismos!
      if(currChart != m_chartId)
        {
         // Si el gráfico tiene el símbolo donde el EA rebelde atacó...
         if(ChartSymbol(currChart) == targetSym)
           {
            PrintFormat("[Security] Rogue EA detected on chart %s. Terminating chart...", targetSym);
            ChartClose(currChart); // ¡Aniquilación del bot intruso!
           }
        }
      currChart = ChartNext(currChart);
     }
  }
//+------------------------------------------------------------------

