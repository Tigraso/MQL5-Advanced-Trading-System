// ====================================================================
struct ScheduledTask
  {
   // --- 1. IDENTIDAD Y TIEMPO ---
   ulong             taskId;        // ID Único (Basado en el tiempo exacto de creación)
   int               actionId;      // Qué acción va a realizar (Buy, Sell, Close...)
   datetime          execTime;      // Cuándo se va a ejecutar
   string            symbol;
   string            description;
   long              ticket;        // Para acciones de cierre de ticket específico
   bool              completed;
   int               retryCount;    // Para evitar bucles infinitos si el broker rechaza

   bool              days[7];       // Días permitidos
   bool              isLoop;        // ¿Es repetitivo?

   // --- 2. DATOS DE PRECIO Y LOTE (Modo Exacto) ---
   bool              isPriceMode;   // ¿Se programó con Pips o con Precio exacto?
   double            entryPrice;    // Precio de entrada (0 = Al mercado)
   double            stopLimitPrice;// Gatillo morado (Si es Stop Limit)
   double            sl_value;      // Valor exacto de SL (Pips o Precio)
   double            tp_value;      // Valor exacto de TP (Pips o Precio)
   double            lots;

   // --- 3. EL CLON DEL GESTOR (EA2) ---
   bool              isVirtual;     // ¿Era orden virtual?
   bool              isSplit;       // ¿Tenía el Trade Splitting encendido?
   bool              isHide;        // ¿Tenía el Hide TP/SL encendido?
   bool              isOCO;         // ¿Tenía OCO encendido?

   STrailingStop     ts;            // Clon exacto del Trailing Stop
   SBreakEven        be;            // Clon exacto del Break Even
   SGridManager      grid;          // Clon exacto del Grid
  };


