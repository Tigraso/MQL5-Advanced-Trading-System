//+------------------------------------------------------------------+
//| INICIALIZACIÓN Y CARGA DE HOTKEYS                                |
//+------------------------------------------------------------------+
void InitHotkeyDefaults()
  {
   g_hotkeyDisk[0].masterSwitch = false; // Apagado por seguridad
   for(int i=0; i<9; i++)
     {
      g_hotkeyDisk[0].keys[i].enabled = false;
      g_hotkeyDisk[0].keys[i].requireCtrl = false;
     }

// Valores por defecto lógicos
   g_hotkeyDisk[0].keys[0].keyCode = 9;
   StringToCharArray("TAB", g_hotkeyDisk[0].keys[0].keyName);
   g_hotkeyDisk[0].keys[1].keyCode = 13;
   StringToCharArray("ENTER", g_hotkeyDisk[0].keys[1].keyName);
   g_hotkeyDisk[0].keys[2].keyCode = 78;
   StringToCharArray("N", g_hotkeyDisk[0].keys[2].keyName);
   g_hotkeyDisk[0].keys[3].keyCode = 77;
   StringToCharArray("M", g_hotkeyDisk[0].keys[3].keyName);
   g_hotkeyDisk[0].keys[4].keyCode = 66;
   StringToCharArray("B", g_hotkeyDisk[0].keys[4].keyName);
   g_hotkeyDisk[0].keys[5].keyCode = 83;
   StringToCharArray("S", g_hotkeyDisk[0].keys[5].keyName);

   g_hotkeyDisk[0].keys[6].keyCode = 8;
   StringToCharArray("BACKSPACE", g_hotkeyDisk[0].keys[6].keyName);
   g_hotkeyDisk[0].keys[6].requireCtrl = true;

   g_hotkeyDisk[0].keys[7].keyCode = 46;
   StringToCharArray("DELETE", g_hotkeyDisk[0].keys[7].keyName);
   g_hotkeyDisk[0].keys[7].requireCtrl = true;

   g_hotkeyDisk[0].keys[8].keyCode = 48;
   StringToCharArray("0", g_hotkeyDisk[0].keys[8].keyName);
   g_hotkeyDisk[0].keys[8].requireCtrl = true;
  }


// Traductor de teclas
string GetKeyNameStr(long code)
  {
   if(code == 8)
      return "BACKSPACE";
   if(code == 9)
      return "TAB";
   if(code == 13)
      return "ENTER";
   if(code == 27)
      return "ESC";
   if(code == 32)
      return "SPACE";
   if(code == 46)
      return "DELETE";
   if(code >= 48 && code <= 57)
      return CharToString((uchar)code); // 0-9
   if(code >= 65 && code <= 90)
      return CharToString((uchar)code); // A-Z
   return "KEY_" + IntegerToString(code);
  }

