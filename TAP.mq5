// --- PALETA DE COLORES (THEME CYBERPUNK) ---
struct SPalette
  {
   uint              bg;
   uint              surface;
   uint              border;
   uint              textMain;
   uint              textDim;
   uint              accent;
   uint              buy;
   uint              sell;
   uint              inputBg;
  };

SPalette Theme;


ushort g_dragRestoreSubMenu = 0; // Recuerda qué submenú revivir tras el arrastre
void InitTheme()
  {
   switch(g_currentTheme)
     {
      case 0: // CYBERPUNK (Intacto)
         Theme.bg       = ColorToARGB(C'15,17,20', 245);
         Theme.surface  = ColorToARGB(C'25,28,32', 255);
         Theme.border   = ColorToARGB(C'40,40,45', 245);
         Theme.textMain = ColorToARGB(C'240,240,240', 255);
         Theme.textDim  = ColorToARGB(C'130,130,130', 255);
         Theme.accent   = ColorToARGB(C'255,160,0', 255);
         Theme.buy      = ColorToARGB(C'40,167,69', 255);
         Theme.sell     = ColorToARGB(C'220,53,69', 255);
         Theme.inputBg  = ColorToARGB(C'10,10,10', 255);
         break;

      case 1: // DARK GOLD (Oro más vivo, menos gris)
         Theme.bg       = ColorToARGB(C'20,18,15', 245);    // Café muy oscuro y puro
         Theme.surface  = ColorToARGB(C'32,28,24', 255);    // Botones chocolate oscuro
         Theme.border   = ColorToARGB(C'60,50,40', 245);
         Theme.textMain = ColorToARGB(C'255,250,240', 255); // Blanco más puro
         Theme.textDim  = ColorToARGB(C'160,150,130', 255);
         Theme.accent   = ColorToARGB(C'218,165,32', 255);  // Goldenrod (Oro clásico y fuerte)
         Theme.buy      = ColorToARGB(C'46,204,113', 255);  // Verde esmeralda vivo
         Theme.sell     = ColorToARGB(C'231,76,60', 255);   // Rojo vivo elegante
         Theme.inputBg  = ColorToARGB(C'12,10,8', 255);
         break;

      case 2: // MIDNIGHT BLUE (Azul eléctrico pero corporativo)
         Theme.bg       = ColorToARGB(C'10,15,25', 245);    // Azul noche profundo
         Theme.surface  = ColorToARGB(C'20,30,45', 255);    // Botones azul marino
         Theme.border   = ColorToARGB(C'40,55,80', 245);
         Theme.textMain = ColorToARGB(C'240,245,255', 255); // Blanco hielo brillante
         Theme.textDim  = ColorToARGB(C'140,160,190', 255);
         Theme.accent   = ColorToARGB(C'0,150,255', 255);   // Deep Sky Blue (Con mucha fuerza)
         Theme.buy      = ColorToARGB(C'0,200,100', 255);   // Verde agua potente
         Theme.sell     = ColorToARGB(C'255,80,120', 255);  // Rojo rosado fuerte
         Theme.inputBg  = ColorToARGB(C'5,8,15', 255);
         break;

      case 3: // LIGHT MODE (Intacto)
         Theme.bg       = ColorToARGB(C'240,245,250', 245);
         Theme.surface  = ColorToARGB(C'255,255,255', 255);
         Theme.border   = ColorToARGB(C'200,210,220', 245);
         Theme.textMain = ColorToARGB(C'20,30,40', 255);
         Theme.textDim  = ColorToARGB(C'100,110,120', 255);
         Theme.accent   = ColorToARGB(C'0,100,200', 255);
         Theme.buy      = ColorToARGB(C'10,150,50', 255);
         Theme.sell     = ColorToARGB(C'220,20,50', 255);
         Theme.inputBg  = ColorToARGB(C'230,235,240', 255);
         break;

      case 4: // DREAMCORE ROSE (Fondo oscuro puro, Rosa con personalidad)
         Theme.bg       = ColorToARGB(C'20,15,22', 245);    // Morado abisal
         Theme.surface  = ColorToARGB(C'35,25,40', 255);    // Botones púrpura
         Theme.border   = ColorToARGB(C'60,40,70', 245);
         Theme.textMain = ColorToARGB(C'255,245,250', 255); // Blanco muy brillante
         Theme.textDim  = ColorToARGB(C'170,140,160', 255);
         Theme.accent   = ColorToARGB(C'255,105,180', 255); // Hot Pink (Rosa vibrante, nada de humo)
         Theme.buy      = ColorToARGB(C'0,220,160', 255);   // Verde menta neón (contrasta 10/10 con rosa)
         Theme.sell     = ColorToARGB(C'255,50,100', 255);  // Rojo fresa encendido
         Theme.inputBg  = ColorToARGB(C'10,5,12', 255);
         break;
     }
  }
// --- ESTADOS Y ESTRUCTURAS DE DATOS ---
enum ENUM_UI_STATE { STATE_NORMAL, STATE_HOVER, STATE_PRESSED };

enum ENUM_ENGINE_TYPE
  {
   ENGINE_MAIN_PANEL = 0,
   ENGINE_TIME_TRADER,
   ENGINE_PROTECT,
   ENGINE_NEWS,
   ENGINE_MODAL_INFO,
   ENGINE_CONFIRM,
   ENGINE_SETTINGS,
   ENGINE_HOTKEYS,
   ENGINE_EXIT,
   ENGINE_HELP,
   ENGINE_EA2_MENU,
   ENGINE_EA2_SUBMENU,
   ENGINE_UNKNOWN
  };

struct SUIPanel { int x; int y; int w; int h; uint bgCol; uint borderCol; bool isOverlay; };
struct SUILabel { string name; string text; int x; int y; string font; int size; uint clr; uint align; };
struct SUILine  { int x1; int y1; int x2; int y2; uint clr; }; // <--- NUEVO
struct SInputText { string name; int x; int y; string text; uint clr; };

struct SUISticker { int x; int y; int r; string text; string font; int fontSize; uint clr; };

// ====================================================================
// SEÑAL DE INTERRUPCIÓN HFT (Arquitectura de Eventos)
// ====================================================================
int g_hft_nuke_signal = -1; // -1 significa "Todo en orden". 0 a 8 son las alarmas.

// ====================================================================
// MOTOR VECTORIAL: Diccionario de Íconos (Pixel-Perfect CCanvas)
// ====================================================================
enum ENUM_VECTOR_ICON
  {
   VICON_NONE = 0,
   VICON_NEWS,      // Periódico
   VICON_TIME,      // Reloj
   VICON_SHIELD,    // Escudo de Protección
   VICON_DROP_DOWN, // Flecha ▼
   VICON_MENU_DOTS, // Tres puntos verticales ...
   VICON_MOVE,      // Flechas arriba/abajo ↕
   VICON_CLOSE,     // Cruz X gruesa
   VICON_MINIMIZE,  // Guion bajo
   VICON_RESTORE,    // Cuadrado
   VICON_GEAR,       // <--- NUEVO: La Tuerca ⚙️
   VICON_CAMERA,     // <--- NUEVO: Cámara de Fotos 📷
   VICON_EYE,       // Ojo (Hide/Show) 👁️
   VICON_LINES,     // Líneas de Trading 📉
   VICON_BELL       // Campana de Alarma 🔔
  };

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
class CUIButton
  {
public:
   int               m_id; // <--- ¡ADIÓS STRING, HOLA VELOCIDAD!
   int               m_x, m_y, m_w, m_h;
   string            m_text;
   uint              m_colorNormal, m_colorHover, m_colorPressed, m_textColor, m_borderColor;
   ENUM_UI_STATE     m_state;
   uint              m_align;
   string            m_font;
   int               m_fontSize;
   bool              m_isOverlay;
   ENUM_VECTOR_ICON  m_icon; // <--- NUEVA VARIABLE

                     CUIButton() : m_state(STATE_NORMAL), m_id(0) {}

   // Nota: Cambiamos el primer parámetro a ushort
   void              Init(int id, int x, int y, int w, int h, string text, uint cNorm, uint cHov, uint cPress, uint cText, uint cBorder, uint align, string font, int fontSize, bool isOverlay, ENUM_VECTOR_ICON icon = VICON_NONE)
     {
      m_id = id; // Asignación ultra rápida
      m_x = x;
      m_y = y;
      m_w = w;
      m_h = h;
      m_text = text;
      m_colorNormal = cNorm;
      m_colorHover = cHov;
      m_colorPressed = cPress;
      m_textColor = cText;
      m_borderColor = cBorder;
      m_align = align;
      m_font = font;
      m_fontSize = fontSize;
      m_isOverlay = isOverlay;
      m_icon      = icon; // <--- ASIGNAR AQUÍ
     }

   bool              HitTest(int localX, int localY)
     {
      return (localX >= m_x && localX <= m_x + m_w && localY >= m_y && localY <= m_y + m_h);
     }
  };

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
class CUIEngine
  {
private:
   CCanvas           m_canvas;

   CCanvas           m_canvasDrop; // <--- NUESTRO SEGUNDO MOTOR GRÁFICO


   SUILine           m_lines[];    // <--- NUEVO

public:
   ushort            m_engineType;  // Identidad O(1)
   ulong             m_ownerTicket; // Ticket dueño O(1) (0 si es el Panel Principal)
   int               m_activeGhostID; // Rastrea qué input está vivo
   int               m_openDropdown; // <--- Ahora guarda el ID del botón que abrió el menú
   string            m_dropdownOptions[];
   CUIButton         m_buttons[];
   SUIPanel          m_panels[];
   SUISticker        m_stickers[];
   SUILabel          m_labels[];
   int               m_dropX, m_dropY, m_dropW, m_dropH, m_dropItemH;
   int               m_dropHoverIndex;
   int               m_dropCols; // <--- NUEVO: Control de columnas del menú
   int               m_dropOffsetX; // <--- NUEVO: Memoria de desplazamiento horizontal
   int               m_dropOffsetY; // <--- NUEVO: Memoria de desplazamiento vertical
   int               m_panelX, m_panelY, m_panelW, m_panelH;
   int               m_zOrder; // NUEVO: Guarda el Z-Order matemático actual de esta ventana
   SInputText        m_inputText[]; // <--- AÑADIR AQUÍ
   string            m_canvasName; // <--- NUEVO


   // Constructor limpio
                     CUIEngine()
     {
      m_dropOffsetX=0;
      m_dropOffsetY=0;
      m_openDropdown = 0;
      m_dropHoverIndex = -1;
      m_dropCols = 1;     // <--- EVITA EL ZERO DIVIDE
      m_dropItemH = 20;   // <--- EVITA EL ZERO DIVIDE
      m_dropW = 100;      // <--- EVITA EL ZERO DIVIDE}
      m_activeGhostID = 0;
     }
                    ~CUIEngine() { m_canvas.Destroy(); ClearDrop(); }

   // --- ACTUALIZACIÓN QUIRÚRGICA (CERO LAG) ---
   // Borra y repinta un solo botón sin afectar al resto del Canvas
   bool              FastUpdateText(int id, string newText)
     {
      for(int i=0; i<ArraySize(m_buttons); i++)
        {
         if(m_buttons[i].m_id == id)
           {
            if(m_buttons[i].m_text == newText)
               return false; // No hacemos nada si el texto es el mismo

            m_buttons[i].m_text = newText;

            // 1. Determinar el color de fondo actual del botón
            uint bg = m_buttons[i].m_colorNormal;
            if(m_buttons[i].m_state == STATE_HOVER)
               bg = m_buttons[i].m_colorHover;
            if(m_buttons[i].m_state == STATE_PRESSED)
               bg = m_buttons[i].m_colorPressed;

            // 2. Pintar un "parche" sobre las coordenadas exactas del botón para borrarlo
            m_canvas.FillRectangle(m_buttons[i].m_x, m_buttons[i].m_y, m_buttons[i].m_x + m_buttons[i].m_w, m_buttons[i].m_y + m_buttons[i].m_h, bg);

            // 3. Repintar su borde original
            m_canvas.Rectangle(m_buttons[i].m_x, m_buttons[i].m_y, m_buttons[i].m_x + m_buttons[i].m_w, m_buttons[i].m_y + m_buttons[i].m_h, m_buttons[i].m_borderColor);

            // 4. Calcular el centrado matemático del nuevo texto (Idéntico a Render)
            m_canvas.FontSet(m_buttons[i].m_font, m_buttons[i].m_fontSize, FW_BOLD);
            int txtW = 0, txtH = 0;
            m_canvas.TextSize(newText, txtW, txtH);

            int startX = m_buttons[i].m_x + (m_buttons[i].m_w - txtW) / 2;
            if((m_buttons[i].m_align & TA_CENTER) != TA_CENTER)
               startX = m_buttons[i].m_x + 10;

            int tY = m_buttons[i].m_y + (m_buttons[i].m_h - txtH) / 2;

            // 5. Imprimir el texto
            m_canvas.TextOut(startX, tY, newText, m_buttons[i].m_textColor, TA_LEFT|TA_TOP);

            // 6. Enviar a la pantalla
            m_canvas.Update();
            return true;
           }
        }
      return false;
     }

   // --- PROCESA EL HOVER DEL DROPDOWN VISUALMENTE ---
   void              ProcessDropdownHover(int absX, int absY)
     {
      if(m_openDropdown == 0)
         return;
      SyncDropdownPosition();
      int hoverIdx = -1;
      if(absX >= m_dropX && absX <= m_dropX + m_dropW && absY >= m_dropY && absY <= m_dropY + m_dropH)
        {
         int itemW = m_dropW / m_dropCols;
         int c = (absX - m_dropX) / itemW;
         int r = (absY - m_dropY) / m_dropItemH;
         hoverIdx = r * m_dropCols + c;
        }
      if(hoverIdx >= ArraySize(m_dropdownOptions))
         hoverIdx = ArraySize(m_dropdownOptions) - 1;
      if(hoverIdx != m_dropHoverIndex)
        {
         m_dropHoverIndex = hoverIdx;
         RenderDrop();
         ChartRedraw();
        }
     }


   // --- NUEVO: Detectar si el ratón está sobre el panel o sus menús ---
   bool              IsMouseOver(int mX, int mY)
     {
      // Revisar si está sobre un menú desplegable abierto
      if(m_openDropdown != 0)
        {
         if(mX >= m_dropX && mX <= m_dropX + m_dropW && mY >= m_dropY && mY <= m_dropY + m_dropH)
            return true;
        }
      // Revisar si está sobre el panel principal
      return (mX >= m_panelX && mX <= m_panelX + m_panelW && mY >= m_panelY && mY <= m_panelY + m_panelH);
     }




   // --- AÑADIR ESTA FUNCIÓN DEBAJO DE AddLabel ---
   void              AddInputText(string name, int x, int y, string text, uint clr)
     {
      int s = ArraySize(m_inputText);
      ArrayResize(m_inputText, s + 1, 50);
      m_inputText[s].name = name; // <--- GUARDAMOS EL NOMBRE
      m_inputText[s].x = x;
      m_inputText[s].y = y;
      m_inputText[s].text = text;
      m_inputText[s].clr = clr;
     }

   // --- NUEVO MÉTODO: AÑADIR STICKER HUECO ---
   void              AddSticker(int x, int y, int r, string text, string font, int fontSize, uint clr)
     {
      int s = ArraySize(m_stickers);
      ArrayResize(m_stickers, s + 1, 50);
      m_stickers[s].x = x; // Coordenada X del centro
      m_stickers[s].y = y; // Coordenada Y del centro
      m_stickers[s].r = r; // Radio del círculo
      m_stickers[s].text = text;
      m_stickers[s].font = font;
      m_stickers[s].fontSize = fontSize;
      m_stickers[s].clr = clr;
     }
   // --- NUEVO MÉTODO: PÁRRAFO CON AUTO-SALTO DE LÍNEA (WORD WRAP) ---
   // Devuelve la coordenada Y donde terminó de escribir, para saber dónde poner el siguiente.
   int               AddParagraph(string text, int x, int y, int maxW, string font, int size, uint clr)
     {
      m_canvas.FontSet(font, size, FW_NORMAL);
      string words[];
      StringSplit(text, ' ', words);
      string currentLine = "";
      int currentY = y;
      int lineHeight = size + 6; // Espaciado entre líneas

      for(int i=0; i<ArraySize(words); i++)
        {
         string testLine = currentLine + (currentLine=="" ? "" : " ") + words[i];
         int txtW=0, txtH=0;
         m_canvas.TextSize(testLine, txtW, txtH); // Medimos los píxeles reales

         // Si la línea de prueba se pasa del ancho máximo, guardamos la anterior y bajamos
         if(txtW > maxW && currentLine != "")
           {
            AddLabel(currentLine, x, currentY, font, size, clr, TA_LEFT|TA_TOP);
            currentLine = words[i]; // La nueva palabra pasa a la siguiente línea
            currentY += lineHeight;
           }
         else
           {
            currentLine = testLine;
           }
        }
      // Añadimos la última línea que haya quedado colgada
      if(currentLine != "")
         AddLabel(currentLine, x, currentY, font, size, clr, TA_LEFT|TA_TOP);

      return currentY + lineHeight; // Devolvemos dónde debe empezar el próximo ítem
     }
   // 1. NUEVO INIT REUTILIZABLE (Añadimos zOrder, engineType y ownerTicket)
   bool              Init(ushort engineType, string canvasName, int startX, int startY, int width, int height, ulong ownerTicket = 0, long zOrder = 100)
     {
      m_engineType  = engineType;
      m_ownerTicket = ownerTicket;

      InitTheme();
      m_canvasName = canvasName;
      m_panelW = width;
      // ... (El resto de la función Init queda exactamente igual)
      m_panelH = height;
      m_panelX = startX;
      m_panelY = startY;

      bool created = m_canvas.CreateBitmapLabel(0, 0, m_canvasName, m_panelX, m_panelY, m_panelW, m_panelH, COLOR_FORMAT_ARGB_NORMALIZE);

      if(created)
        {
         ObjectSetInteger(0, m_canvasName, OBJPROP_BACK, false);
         ObjectSetInteger(0, m_canvasName, OBJPROP_ZORDER, zOrder); // <--- MAGIA AQUÍ

         // --- ESCUDO ANTI-SALTO (1-2 PX) ---
         ObjectSetInteger(0, m_canvasName, OBJPROP_SELECTABLE, false);
         ObjectSetInteger(0, m_canvasName, OBJPROP_SELECTED, false);
         ObjectSetInteger(0, m_canvasName, OBJPROP_HIDDEN, true);
        }
      return created;
     }

   // --- 1. RECREACIÓN NINJA (Para la ventana que pasa al frente) ---
   void              BringToFront(int newZ)
     {
      m_zOrder = newZ;
      if(m_canvasName == "")
         return; // Escudo por si no está inicializada

      // 1. Guardamos el nombre de la memoria RAM gráfica
      string resName = m_canvas.ResourceName();

      // 2. Destruimos el "proyector" físico (MT5 lo borra del lienzo)
      ObjectDelete(0, m_canvasName);

      // 3. Recreamos el proyector en el mismo milisegundo (Pasa a ser el objeto más nuevo)
      ObjectCreate(0, m_canvasName, OBJ_BITMAP_LABEL, 0, 0, 0);

      // 4. Lo volvemos a enchufar a nuestra memoria RAM intacta
      ObjectSetString(0, m_canvasName, OBJPROP_BMPFILE, 0, resName);

      // 5. Restauramos sus propiedades físicas
      ObjectSetInteger(0, m_canvasName, OBJPROP_XDISTANCE, m_panelX);
      ObjectSetInteger(0, m_canvasName, OBJPROP_YDISTANCE, m_panelY);
      ObjectSetInteger(0, m_canvasName, OBJPROP_XSIZE, m_panelW);
      ObjectSetInteger(0, m_canvasName, OBJPROP_YSIZE, m_panelH);
      ObjectSetInteger(0, m_canvasName, OBJPROP_BACK, false);

      // Le asignamos el Z-Order matemático nuevo
      ObjectSetInteger(0, m_canvasName, OBJPROP_ZORDER, m_zOrder);

      // 6. Escudos anti-selección
      ObjectSetInteger(0, m_canvasName, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, m_canvasName, OBJPROP_SELECTED, false);
      ObjectSetInteger(0, m_canvasName, OBJPROP_HIDDEN, true);

      m_canvas.Update();
     }

   // --- 2. DEGRADACIÓN SILENCIOSA (Para las ventanas que bajan un nivel) ---
   void              SetZOrder(int newZ)
     {
      m_zOrder = newZ;
      if(m_canvasName != "")
         ObjectSetInteger(0, m_canvasName, OBJPROP_ZORDER, m_zOrder); // Solo toca el número, no repinta
     }

   // 2. INIT SECUNDARIO
   bool              Init(int chartW, int width, int height, long zOrder = 100)
     {
      InitTheme();
      m_panelW = width;
      m_panelH = height;
      m_panelX = 20; // Derecha
      m_panelY = 50;

      bool created = m_canvas.CreateBitmapLabel(0, 0, "CanvasProEngine", m_panelX, m_panelY, m_panelW, m_panelH, COLOR_FORMAT_ARGB_NORMALIZE);

      if(created)
        {
         ObjectSetInteger(0, m_canvasName, OBJPROP_BACK, false);
         ObjectSetInteger(0, m_canvasName, OBJPROP_ZORDER, 0);
         ObjectSetInteger(0, m_canvasName, OBJPROP_ZORDER, zOrder);

         // --- ESCUDO ANTI-SALTO (1-2 PX) ---
         ObjectSetInteger(0, m_canvasName, OBJPROP_SELECTABLE, false);
         ObjectSetInteger(0, m_canvasName, OBJPROP_SELECTED, false);
         ObjectSetInteger(0, m_canvasName, OBJPROP_HIDDEN, true); // Oculta de la lista de objetos Ctrl+B
        }
      return created;
     }

   // NUEVO MÉTODO DESTROY BLINDADO (Anti-Fantasmas)
   void              DestroyCanvas()
     {
      if(m_canvasName != "") // Escudo: Solo borra si tiene un nombre asignado
        {
         // 🛡️ ESCUDO ANTI-RASTRO: Deseleccionar antes de aniquilar
         ObjectSetInteger(0, m_canvasName, OBJPROP_SELECTED, false);
         ObjectSetInteger(0, m_canvasName, OBJPROP_SELECTABLE, false);

         ClearDrop();
         m_canvas.Destroy();
         ObjectDelete(0, m_canvasName);
         m_canvasName = ""; // Resetea la memoria

         // --- SOLUCIÓN ZOMBIS: Vaciamos todos los arrays internos ---
         Clear();
         ChartRedraw();
        }
     }


   // 3. NUEVO MÉTODO PARA AÑADIR LÍNEAS
   void              AddLine(int x1, int y1, int x2, int y2, uint clr)
     {
      int s = ArraySize(m_lines);
      ArrayResize(m_lines, s + 1, 50);
      m_lines[s].x1 = x1;
      m_lines[s].y1 = y1;
      m_lines[s].x2 = x2;
      m_lines[s].y2 = y2;
      m_lines[s].clr = clr;
     }

   void              Clear()
     {
      ArrayResize(m_buttons, 0);
      ArrayResize(m_panels, 0);
      ArrayResize(m_labels, 0);
      ArrayResize(m_lines, 0);
      ArrayResize(m_inputText, 0); // <--- AÑADIR AQUÍ
      ArrayResize(m_stickers, 0);
     }


   // --- NUEVO: Fuerza a todos los botones a apagarse ---
   void              ResetHovers()
     {
      bool redraw = false;
      for(int i = 0; i < ArraySize(m_buttons); i++)
        {
         if(m_buttons[i].m_state != STATE_NORMAL)
           {
            m_buttons[i].m_state = STATE_NORMAL;
            redraw = true;
           }
        }
      if(redraw)
         Render();
     }

   // --- NUEVA FUNCIÓN: Cambiar altura del panel en tiempo real ---
   void              Resize(int newWidth, int newHeight)
     {
      if(m_panelW == newWidth && m_panelH == newHeight)
         return; // Si ya tiene ese tamaño exacto, no hacer nada

      m_panelW = newWidth;
      m_panelH = newHeight;
      m_canvas.Resize(m_panelW, m_panelH); // Redimensionar el lienzo interno en RAM

      // Actualizar el objeto físico en el gráfico de MT5 usando su nombre dinámico
      ObjectSetInteger(0, m_canvasName, OBJPROP_XSIZE, m_panelW);
      ObjectSetInteger(0, m_canvasName, OBJPROP_YSIZE, m_panelH);
     }

   void              AddPanel(int x, int y, int w, int h, uint bg, uint border, bool isOverlay = false) // <-- Añadir = false
     {
      int s = ArraySize(m_panels);
      ArrayResize(m_panels, s + 1, 50);
      m_panels[s].x = x;
      m_panels[s].y = y;
      m_panels[s].w = w;
      m_panels[s].h = h;
      m_panels[s].bgCol = bg;
      m_panels[s].borderCol = border;
      m_panels[s].isOverlay = isOverlay; // <-- Añadir
     }

   void              AddLabel(string text, int x, int y, string font, int size, uint clr, uint align)
     {
      int s = ArraySize(m_labels);
      ArrayResize(m_labels, s + 1, 100);
      m_labels[s].text = text;
      m_labels[s].x = x;
      m_labels[s].y = y;
      m_labels[s].font = font;
      m_labels[s].size = size;
      m_labels[s].clr = clr;
      m_labels[s].align = align;
     }

   // 1. Añadir etiqueta con Nombre (Para poder buscarla y actualizarla luego)
   void              AddLabelNamed(string name, string text, int x, int y, string font, int size, uint clr, uint align)
     {
      int s = ArraySize(m_labels);
      ArrayResize(m_labels, s + 1, 100);
      m_labels[s].name = name;
      m_labels[s].text = text;
      m_labels[s].x = x;
      m_labels[s].y = y;
      m_labels[s].font = font;
      m_labels[s].size = size;
      m_labels[s].clr = clr;
      m_labels[s].align = align;
     }

   // 2. Actualizar el texto de una etiqueta específica (Ej: El Reloj) sin redibujar todo
   void              SetLabelText(string name, string text)
     {
      for(int i=0; i<ArraySize(m_labels); i++)
        {
         if(m_labels[i].name == name)
           {
            m_labels[i].text = text;
            return;
           }
        }
     }

   // Cambiar el color de un texto en tiempo real
   void              SetLabelColor(string name, uint clr)
     {
      for(int i=0; i<ArraySize(m_labels); i++)
        {
         if(m_labels[i].name == name)
           {
            m_labels[i].clr = clr;
            return;
           }
        }
     }

   // Cambiamos 'string name' por 'int id'
   // Cambiamos 'string name' por 'int id'
   void              AddButton(int id, int x, int y, int w, int h, string text, uint cNorm, uint cHov, uint cPress, uint cText, uint cBorder = 0, uint align = TA_CENTER|TA_VCENTER, string font="Arial", int fontSize=12, bool isOverlay = false, ENUM_VECTOR_ICON icon = VICON_NONE)
     {
      int s = ArraySize(m_buttons);
      ArrayResize(m_buttons, s + 1, 100);
      if(cBorder == 0)
         cBorder = Theme.border;

      // =======================================================
      // MAGIA HOVER DINÁMICO (Suma +15 de brillo al color base)
      // =======================================================
      int a = (int)((cNorm >> 24) & 0xFF);
      int r = (int)((cNorm >> 16) & 0xFF);
      int g = (int)((cNorm >> 8) & 0xFF);
      int b = (int)(cNorm & 0xFF);
      // Aclaramos asegurando no pasarnos del blanco puro (255)
      r = (int)MathMin(255, r + 15);
      g = (int)MathMin(255, g + 15);
      b = (int)MathMin(255, b + 15);

      // Reensamblamos el color ARGB
      uint smartHover = (uint)((a << 24) | (r << 16) | (g << 8) | b);
      // =======================================================

      // =======================================================
      // 🛡️ ESCUDO ANTI-PARPADEO NARANJA PARA LOS INPUTS
      // =======================================================
      // Detectamos si el ID del botón pertenece a una caja de texto (Input)
      bool isInput = (id > 3000) || // Rango de Inputs del Panel Principal y Gestor (3001 a 3306)
                     (id >= OP_TIME_INP_DATE && id <= OP_TIME_INP_TICKET) || // Time Trader Inputs (607 a 609)
                     (id >= OP_PROT_INP_0 && id <= OP_PROT_INP_0 + 13);      // Equity Protect Inputs (750 a 763)

      uint finalPress = cPress;
      if(isInput)
        {
         // Si es un Input, anulamos el color naranja agresivo del clic.
         // Le inyectamos el color del Hover para que la transición sea 100% limpia.
         finalPress = smartHover;
        }
      // =======================================================

      // Le pasamos nuestro "smartHover" y el "finalPress" procesado
      m_buttons[s].Init(id, x, y, w, h, text, cNorm, smartHover, finalPress, cText, cBorder, align, font, fontSize, isOverlay, icon);
     }

   // Cambiamos el tipo de retorno a ushort
   int               GetClickedButton(int mX, int mY)
     {
      int lX = mX - m_panelX;
      int lY = mY - m_panelY;
      for(int i = ArraySize(m_buttons) - 1; i >= 0; i--)
        {
         if(m_buttons[i].HitTest(lX, lY))
            return m_buttons[i].m_id; // Devuelve el número instantáneamente
        }
      return 0; // OP_NONE si no tocó nada
     }

   void              Render()
     {
      m_canvas.Erase(Theme.bg);
      m_canvas.Rectangle(0, 0, m_panelW-1, m_panelH-1, Theme.border); // Borde global

      // 1. DIBUJAR PANELES NORMALES
      for(int i=0; i<ArraySize(m_panels); i++)
        {
         if(m_panels[i].isOverlay)
            continue; // Saltar overlays
         m_canvas.FillRectangle(m_panels[i].x, m_panels[i].y, m_panels[i].x + m_panels[i].w-1, m_panels[i].y + m_panels[i].h, m_panels[i].bgCol);
         if(m_panels[i].borderCol != 0)
            m_canvas.Rectangle(m_panels[i].x, m_panels[i].y, m_panels[i].x + m_panels[i].w-1, m_panels[i].y + m_panels[i].h-1, m_panels[i].borderCol);
        }

      // DIBUJAR LÍNEAS (Para el Mini-Gráfico)
      for(int i=0; i<ArraySize(m_lines); i++)
        {
         m_canvas.LineAA(m_lines[i].x1, m_lines[i].y1, m_lines[i].x2, m_lines[i].y2, m_lines[i].clr);
        }

      // 2. DIBUJAR BOTONES NORMALES
      for(int i=0; i<ArraySize(m_buttons); i++)
        {
         if(m_buttons[i].m_isOverlay)
            continue; // Saltar overlays
         uint bg = m_buttons[i].m_colorNormal;
         if(m_buttons[i].m_state == STATE_HOVER)
            bg = m_buttons[i].m_colorHover;
         if(m_buttons[i].m_state == STATE_PRESSED)
            bg = m_buttons[i].m_colorPressed;
         m_canvas.FillRectangle(m_buttons[i].m_x, m_buttons[i].m_y, m_buttons[i].m_x + m_buttons[i].m_w, m_buttons[i].m_y + m_buttons[i].m_h, bg);
         m_canvas.Rectangle(m_buttons[i].m_x, m_buttons[i].m_y, m_buttons[i].m_x + m_buttons[i].m_w, m_buttons[i].m_y + m_buttons[i].m_h, m_buttons[i].m_borderColor);
         // ==============================================================
         // RENDERIZADO INTELIGENTE DE TEXTO + ÍCONO VECTORIAL
         // ==============================================================
         m_canvas.FontSet(m_buttons[i].m_font, m_buttons[i].m_fontSize, FW_BOLD);
         int txtW = 0, txtH = 0;
         m_canvas.TextSize(m_buttons[i].m_text, txtW, txtH);

         int iconSize = 12; // Tamaño base del ícono en píxeles
         int gap = 6;       // Separación entre ícono y texto

         bool hasIcon = (m_buttons[i].m_icon != VICON_NONE);
         bool hasText = (m_buttons[i].m_text != "");

         // 1. Calcular el ancho total del contenido
         int contentW = 0;
         if(hasIcon && hasText)
            contentW = iconSize + gap + txtW;
         else
            if(hasIcon)
               contentW = iconSize;
            else
               if(hasText)
                  contentW = txtW;

         // 2. Calcular punto de inicio X para que el bloque quede centrado
         int startX = m_buttons[i].m_x + (m_buttons[i].m_w - contentW) / 2;
         if((m_buttons[i].m_align & TA_CENTER) != TA_CENTER)
            startX = m_buttons[i].m_x + 10; // Si está alineado a la izquierda

         // 3. Dibujar Ícono Vectorial (Si existe)
         if(hasIcon)
           {
            int ix = startX + (iconSize / 2); // Centro X del ícono
            int iy = m_buttons[i].m_y + (m_buttons[i].m_h / 2); // Centro Y del ícono
            uint iCol = m_buttons[i].m_textColor;
            uint bg   = bg; // Color de fondo del botón actual

            switch(m_buttons[i].m_icon)
              {
               case VICON_GEAR: // ⚙️ (Tuerquita Vectorial)
                  m_canvas.FillCircle(ix, iy, 5, iCol); // Cuerpo macizo
                  m_canvas.FillCircle(ix, iy, 2, bg);   // Agujero central
                  m_canvas.LineAA(ix-6, iy, ix+6, iy, iCol); // Dientes horizontales
                  m_canvas.LineAA(ix, iy-6, ix, iy+6, iCol); // Dientes verticales
                  m_canvas.LineAA(ix-4, iy-4, ix+4, iy+4, iCol); // Dientes diagonales
                  m_canvas.LineAA(ix-4, iy+4, ix+4, iy-4, iCol); // Dientes diagonales
                  m_canvas.FillCircle(ix, iy, 2, bg); // Limpiar agujero nuevamente para nitidez
                  break;
               case VICON_CAMERA: // 📷 (Cámara Vectorial)
                  m_canvas.FillRectangle(ix-6, iy-3, ix+6, iy+4, iCol); // Cuerpo de la cámara
                  m_canvas.FillRectangle(ix-2, iy-5, ix+2, iy-3, iCol); // Flash/Botón superior
                  m_canvas.FillCircle(ix, iy+1, 2, bg); // Lente (Agujero transparente)
                  break;
               case VICON_NEWS: // 📰 (Periódico)
                  m_canvas.FillRectangle(ix-6, iy-5, ix+6, iy+5, iCol); // Hoja base
                  m_canvas.FillRectangle(ix-5, iy-4, ix+5, iy+4, bg);   // Fondo interior
                  m_canvas.FillRectangle(ix-3, iy-2, ix+3, iy-1, iCol); // Línea 1
                  m_canvas.FillRectangle(ix-3, iy+1, ix+3, iy+2, iCol); // Línea 2
                  m_canvas.FillTriangle(ix+3, iy-5, ix+6, iy-5, ix+6, iy-2, bg); // Esquina doblada
                  break;

               case VICON_TIME: // 🕒 (Reloj)
                  m_canvas.FillCircle(ix, iy, 5, iCol); // Aro exterior
                  m_canvas.FillCircle(ix, iy, 4, bg);   // Fondo interior
                  m_canvas.FillCircle(ix, iy, 1, iCol); // Centro
                  m_canvas.LineAA(ix, iy, ix, iy-3, iCol); // Manecilla Hora
                  m_canvas.LineAA(ix, iy, ix+2, iy+2, iCol); // Manecilla Minuto
                  break;

               case VICON_SHIELD: // ⬡ (Modern Defender)
                  // Barra superior gruesa
                  m_canvas.FillRectangle(ix-4, iy-5, ix+4, iy-4, iCol);
                  // Paredes laterales
                  m_canvas.FillRectangle(ix-4, iy-4, ix-3, iy+1, iCol);
                  m_canvas.FillRectangle(ix+3, iy-4, ix+4, iy+1, iCol);
                  // Curvas inferiores simétricas con Anti-Aliasing
                  m_canvas.LineAA(ix-4, iy+1, ix, iy+5, iCol);
                  m_canvas.LineAA(ix-3, iy+1, ix, iy+4, iCol); // Grosor interno izq
                  m_canvas.LineAA(ix+4, iy+1, ix, iy+5, iCol);
                  m_canvas.LineAA(ix+3, iy+1, ix, iy+4, iCol); // Grosor interno der

                  // Núcleo central
                  m_canvas.FillCircle(ix, iy-1, 1, iCol);
                  break;

               case VICON_EYE: // 👁️ (Ojo Minimalista)
                  // Párpado superior (Líneas anti-aliasing para suavidad)
                  m_canvas.LineAA(ix-6, iy, ix, iy-4, iCol);
                  m_canvas.LineAA(ix, iy-4, ix+6, iy, iCol);
                  // Párpado inferior
                  m_canvas.LineAA(ix-6, iy, ix, iy+4, iCol);
                  m_canvas.LineAA(ix, iy+4, ix+6, iy, iCol);
                  // Pupila central
                  m_canvas.FillCircle(ix, iy, 2, iCol);
                  break;

               case VICON_LINES: // 📉 (Niveles TP / Entry / SL)
                  // TP (Línea arriba con nodo izquierdo)
                  m_canvas.LineAA(ix-4, iy-4, ix+5, iy-4, iCol);
                  m_canvas.FillCircle(ix-4, iy-4, 1, iCol);
                  // Entry (Línea central punteada simulada)
                  m_canvas.LineAA(ix-6, iy, ix-2, iy, iCol);
                  m_canvas.LineAA(ix+2, iy, ix+6, iy, iCol);
                  // SL (Línea abajo con nodo derecho)
                  m_canvas.LineAA(ix-5, iy+4, ix+4, iy+4, iCol);
                  m_canvas.FillCircle(ix+4, iy+4, 1, iCol);
                  break;

               case VICON_BELL: // 🔔 (Campana de Alarma)
                  // Cúpula superior
                  m_canvas.FillCircle(ix, iy+1, 3, iCol);
                  // Cuerpo recto
                  m_canvas.FillRectangle(ix-3, iy+1, ix+3, iy+4, iCol);
                  // Base ensanchada
                  m_canvas.LineAA(ix-5, iy+4, ix+5, iy+4, iCol);
                  m_canvas.LineAA(ix-4, iy+3, ix+4, iy+3, iCol); // Grosor base
                  // Badajo (Puntito abajo)
                  m_canvas.FillCircle(ix, iy+6, 1, iCol);
                  // Enganche superior
                  m_canvas.FillCircle(ix, iy-3, 1, iCol);
                  break;

               case VICON_DROP_DOWN: // ▼ (Flecha)
                  m_canvas.FillTriangle(ix-4, iy-2, ix+4, iy-2, ix, iy+3, iCol);
                  break;

               case VICON_MENU_DOTS: // ... (Vertical)
                  m_canvas.FillCircle(ix, iy-4, 1, iCol);
                  m_canvas.FillCircle(ix, iy,   1, iCol);
                  m_canvas.FillCircle(ix, iy+4, 1, iCol);
                  break;

               case VICON_CLOSE: // X gruesa
                  m_canvas.LineAA(ix-4, iy-4, ix+4, iy+4, iCol);
                  m_canvas.LineAA(ix-4, iy+4, ix+4, iy-4, iCol);
                  m_canvas.LineAA(ix-3, iy-4, ix+5, iy+4, iCol); // Grosor
                  m_canvas.LineAA(ix-3, iy+4, ix+5, iy-4, iCol); // Grosor
                  break;
              }
           }

         // 4. Dibujar Texto (Si existe)
         if(hasText)
           {
            int tX = startX + (hasIcon ? (iconSize + gap) : 0);
            int tY = m_buttons[i].m_y + (m_buttons[i].m_h - txtH) / 2;
            m_canvas.TextOut(tX, tY, m_buttons[i].m_text, m_buttons[i].m_textColor, TA_LEFT|TA_TOP);
           }
        }

      // 3. Textos libres
      for(int i=0; i<ArraySize(m_labels); i++)
        {
         m_canvas.FontSet(m_labels[i].font, m_labels[i].size, FW_NORMAL);
         m_canvas.TextOut(m_labels[i].x, m_labels[i].y, m_labels[i].text, m_labels[i].clr, m_labels[i].align);
        }

      // 4. DIBUJAR OVERLAYS (Menús desplegables encima de todo)
      for(int i=0; i<ArraySize(m_panels); i++)
        {
         if(!m_panels[i].isOverlay)
            continue;
         m_canvas.FillRectangle(m_panels[i].x, m_panels[i].y, m_panels[i].x + m_panels[i].w, m_panels[i].y + m_panels[i].h, m_panels[i].bgCol);
         if(m_panels[i].borderCol != 0)
            m_canvas.Rectangle(m_panels[i].x, m_panels[i].y, m_panels[i].x + m_panels[i].w, m_panels[i].y + m_panels[i].h, m_panels[i].borderCol);
        }
      for(int i=0; i<ArraySize(m_buttons); i++)
        {
         if(!m_buttons[i].m_isOverlay)
            continue;
         uint bg = m_buttons[i].m_colorNormal;
         if(m_buttons[i].m_state == STATE_HOVER)
            bg = m_buttons[i].m_colorHover;
         if(m_buttons[i].m_state == STATE_PRESSED)
            bg = m_buttons[i].m_colorPressed;
         m_canvas.FillRectangle(m_buttons[i].m_x, m_buttons[i].m_y, m_buttons[i].m_x + m_buttons[i].m_w, m_buttons[i].m_y + m_buttons[i].m_h, bg);
         m_canvas.Rectangle(m_buttons[i].m_x, m_buttons[i].m_y, m_buttons[i].m_x + m_buttons[i].m_w, m_buttons[i].m_y + m_buttons[i].m_h, m_buttons[i].m_borderColor);
         m_canvas.FontSet(m_buttons[i].m_font, m_buttons[i].m_fontSize, FW_BOLD);
         int txtW = 0, txtH = 0;
         m_canvas.TextSize(m_buttons[i].m_text, txtW, txtH);
         int tX = m_buttons[i].m_x + (m_buttons[i].m_w - txtW) / 2;
         int tY = m_buttons[i].m_y + (m_buttons[i].m_h - txtH) / 2;
         if((m_buttons[i].m_align & TA_CENTER) != TA_CENTER)
            tX = m_buttons[i].m_x + 10;
         m_canvas.TextOut(tX, tY, m_buttons[i].m_text, m_buttons[i].m_textColor, TA_LEFT|TA_TOP);
        }

      // 5. DIBUJAR TEXTOS FANTASMA (Justo detrás de los inputs nativos)
      // AJUSTE MILIMÉTRICO: Cambia estos valores si necesitas corregir el salto
      int offsetX = -1; // Mueve el texto del Canvas a la izquierda
      int offsetY = 0;  // Mueve el texto del Canvas hacia abajo

      for(int i=0; i<ArraySize(m_inputText); i++)
        {
         m_canvas.FontSet("Arial", 15, FW_NORMAL);
         m_canvas.TextOut(m_inputText[i].x + offsetX, m_inputText[i].y + offsetY, m_inputText[i].text, m_inputText[i].clr, TA_CENTER|TA_VCENTER);
        }

      // ==============================================================
      // 4.5 DIBUJAR STICKERS (Círculos huecos para el Manual)
      // ==============================================================
      for(int i=0; i<ArraySize(m_stickers); i++)
        {
         // Dibujamos dos círculos con Anti-Aliasing para darle un grosor de 2 píxeles al borde
         m_canvas.CircleAA(m_stickers[i].x, m_stickers[i].y, m_stickers[i].r, m_stickers[i].clr);
         m_canvas.CircleAA(m_stickers[i].x, m_stickers[i].y, m_stickers[i].r - 1, m_stickers[i].clr);

         // Dibujamos el número exactamente en el centro matemático del círculo
         m_canvas.FontSet(m_stickers[i].font, m_stickers[i].fontSize, FW_BOLD);
         m_canvas.TextOut(m_stickers[i].x, m_stickers[i].y, m_stickers[i].text, m_stickers[i].clr, TA_CENTER|TA_VCENTER);
        }
      m_canvas.Update();
     }

   void              OnEvent(const int id, const long &lparam, const double &dparam, const string &sparam)
     {
      if(id == CHARTEVENT_MOUSE_MOVE)
        {
         int mX = (int)lparam - m_panelX;
         int mY = (int)dparam - m_panelY;
         int state = (int)StringToInteger(sparam);
         bool redraw = false;

         // BUCLE INVERTIDO: Detecta el hover/presionado correctamente
         for(int i = ArraySize(m_buttons) - 1; i >= 0; i--)
           {
            ENUM_UI_STATE old = m_buttons[i].m_state;
            if(m_buttons[i].HitTest(mX, mY))
               m_buttons[i].m_state = (state == 1) ? STATE_PRESSED : STATE_HOVER;
            else
               m_buttons[i].m_state = STATE_NORMAL;

            if(old != m_buttons[i].m_state)
               redraw = true;
           }
         if(redraw)
            Render();
        }
     }
   // --- FUNCIONES ACTUALIZADAS A USHORT (IDs NUMÉRICOS) ---


   // --- NUEVA FUNCIÓN: Rectángulos Redondeados con Transparencia ---
   void              FillRoundRect(int x1, int y1, int x2, int y2, int r, uint clr)
     {
      // 1. Dibujar la cruz central (dos rectángulos superpuestos)
      m_canvas.FillRectangle(x1 + r, y1, x2 - r, y2, clr);
      m_canvas.FillRectangle(x1, y1 + r, x2, y2 - r, clr);

      // 2. Dibujar los 4 círculos en las esquinas para suavizar
      m_canvas.FillCircle(x1 + r, y1 + r, r, clr);
      m_canvas.FillCircle(x2 - r, y1 + r, r, clr);
      m_canvas.FillCircle(x1 + r, y2 - r, r, clr);
      m_canvas.FillCircle(x2 - r, y2 - r, r, clr);
     }

   void              ToggleDropdown(int id, string &options[])
     {
      if(m_openDropdown == id)
        {
         ClearDrop();
        }
      else
        {
         int bx=0, by=0, bw=0, bh=0;
         if(GetButtonCoords(id, bx, by, bw, bh))
           {
            ClearDrop();
            m_openDropdown = id;
            m_dropHoverIndex = -1;

            int items = ArraySize(options);
            ArrayResize(m_dropdownOptions, items);
            ArrayCopy(m_dropdownOptions, options);

            // 1. OBTENER DIMENSIONES DE PANTALLA Y BOTÓN
            int chartH = (int)ChartGetInteger(0, CHART_HEIGHT_IN_PIXELS);
            int chartW = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);

            int btnAbsX = m_panelX + bx;
            int btnAbsY = m_panelY + by;

            // 2. CÁLCULO DE ESPACIO DISPONIBLE (Dejando 10px de margen de seguridad)
            int spaceDown = chartH - (btnAbsY + bh) - 10;
            int spaceUp   = btnAbsY - 10;

            m_dropItemH = bh;
            if(m_dropItemH <= 0)
               m_dropItemH = 20; // Fallback

            // 3. ¿CUÁNTAS FILAS CABEN COMO MÁXIMO?
            int maxRowsDown = spaceDown / m_dropItemH;
            int maxRowsUp   = spaceUp / m_dropItemH;

            int maxRowsPossible = MathMax(maxRowsDown, maxRowsUp);
            if(maxRowsPossible < 1)
               maxRowsPossible = 1;

            // 4. CALCULAR COLUMNAS NECESARIAS
            // Si hay 100 items y solo caben 20 filas, necesitamos 5 columnas.
            m_dropCols = (int)MathCeil((double)items / maxRowsPossible);
            if(m_dropCols < 1)
               m_dropCols = 1;

            // 5. ANCHO DINÁMICO POR COLUMNA
            int baseColW = bw;

            // --- INYECCIÓN: EL TIME TRADER AHORA USA EL ANCHO INSTITUCIONAL (220px) ---
            if(id == OP_DROP_APPLY_MAN || id == OP_DROP_APPLY_AUTO || id == OP_TIME_INP_TICKET)
               baseColW = 220;
            else
               if(id == OP_BTN_SYMBOL)
                  baseColW = 160;
            if(baseColW < 80)
               baseColW = 80;

            m_dropW = baseColW * m_dropCols;

            // 6. ESCUDO ANTI-COLISIÓN HORIZONTAL (Borde Derecho)
            if(btnAbsX + m_dropW > chartW)
               m_dropX = chartW - m_dropW - 5; // Lo pegamos a la izquierda
            else
               m_dropX = btnAbsX;

            m_dropOffsetX = m_dropX - btnAbsX; // <--- GUARDAMOS LA MEMORIA X

            // 7. CALCULAR ALTURA FINAL EXACTA
            int rows = (int)MathCeil((double)items / m_dropCols);
            m_dropH = rows * m_dropItemH;

            // 8. DECISIÓN INTELIGENTE: ¿ARRIBA O ABAJO?
            if(m_dropH <= spaceDown || spaceDown >= spaceUp)
               m_dropY = btnAbsY + bh;      // Abre hacia ABAJO (Prioridad)
            else
               m_dropY = btnAbsY - m_dropH; // Abre hacia ARRIBA

            m_dropOffsetY = m_dropY - btnAbsY; // <--- GUARDAMOS LA MEMORIA Y

            // 9. RENDERIZADO
            string dropName = "CanvasDropEngine_" + m_canvasName;
            bool created = m_canvasDrop.CreateBitmapLabel(0, 0, dropName, m_dropX, m_dropY, m_dropW, m_dropH, COLOR_FORMAT_ARGB_NORMALIZE);

            if(created)
              {
               ObjectSetInteger(0, dropName, OBJPROP_ZORDER, 5000);
               RenderDrop();
               ChartRedraw();
              }
           }
        }
     }

   void              SyncDropdownPosition()
     {
      if(m_openDropdown != 0)
        {
         int bx=0, by=0, bw=0, bh=0;
         if(GetButtonCoords(m_openDropdown, bx, by, bw, bh))
           {
            // 1. Obtener la posición actual del botón en la pantalla
            int btnAbsX = m_panelX + bx;
            int btnAbsY = m_panelY + by;

            // 2. Aplicar los Offsets Inteligentes guardados en RAM
            m_dropX = btnAbsX + m_dropOffsetX;
            m_dropY = btnAbsY + m_dropOffsetY;

            // 3. Actualizar el motor gráfico nativo de MT5 sin parpadeos
            string dropName = "CanvasDropEngine_" + m_canvasName;
            ObjectSetInteger(0, dropName, OBJPROP_XDISTANCE, m_dropX);
            ObjectSetInteger(0, dropName, OBJPROP_YDISTANCE, m_dropY);
           }
        }
     }

   void              ClearDrop()
     {
      m_openDropdown = 0; // Ahora se usa 0 en vez de ""
      m_dropHoverIndex = -1;
      m_canvasDrop.Destroy();
      ObjectDelete(0, "CanvasDropEngine_" + m_canvasName); // Dinámico

      ChartRedraw();
     }

   void              RenderDrop()
     {
      // ADIÓS AL BUG DEL STRING: Comparamos contra 0 (OP_NONE)
      if(m_openDropdown == 0)
         return;

      m_canvasDrop.Erase(Theme.surface);
      int items = ArraySize(m_dropdownOptions);
      int itemW = m_dropW / m_dropCols;

      for(int i=0; i<items; i++)
        {
         int c = i % m_dropCols;
         int r = i / m_dropCols;
         int itemX = c * itemW;
         int itemY = r * m_dropItemH;

         uint bgCol = (i == m_dropHoverIndex) ? Theme.border : Theme.surface;
         m_canvasDrop.FillRectangle(itemX + 1, itemY + (r==0?1:0), itemX + itemW - 1, itemY + m_dropItemH - 1, bgCol);

         if(r < (items/m_dropCols))
            m_canvasDrop.Line(itemX, itemY + m_dropItemH - 1, itemX + itemW, itemY + m_dropItemH - 1, Theme.border);
         if(c > 0)
            m_canvasDrop.Line(itemX, itemY, itemX, itemY + m_dropItemH, Theme.border);

         m_canvasDrop.FontSet("Arial", 12, FW_NORMAL);
         int centerY = itemY + (m_dropItemH / 2);

         // --- INYECCIÓN: PROTOCOLO DE DELIMITADOR '|' PARA DOBLE COLOR ---
         string optText = m_dropdownOptions[i];
         int splitPos = StringFind(optText, "|");

         if(splitPos > 0)
           {
            // Partimos la cadena en dos
            string leftTxt  = StringSubstr(optText, 0, splitPos);
            string rightTxt = StringSubstr(optText, splitPos + 1);

            // 1. Dibujamos el Símbolo a la Izquierda
            m_canvasDrop.TextOut(itemX + 10, centerY, leftTxt, Theme.textMain, TA_LEFT|TA_VCENTER);

            // 2. Dibujamos el Dinero a la Derecha con color dinámico
            uint plCol = (StringFind(rightTxt, "+") >= 0) ? Theme.buy : Theme.sell;
            m_canvasDrop.TextOut(itemX + itemW - 10, centerY, rightTxt, plCol, TA_RIGHT|TA_VCENTER);
           }
         else
           {
            // Comportamiento Clásico (Texto Normal Centrado)
            int centerX = itemX + (itemW / 2);
            m_canvasDrop.TextOut(centerX, centerY, optText, Theme.textMain, TA_CENTER|TA_VCENTER);
           }
        }
      m_canvasDrop.Rectangle(0, 0, m_dropW-1, m_dropH-1, Theme.border);
      m_canvasDrop.Update();
     }

   // ¡OJO AQUÍ! Ahora devuelve un INT (El índice de la opción tocada) en vez de un string
   int               CheckDropdownClick(int absX, int absY)
     {
      if(m_openDropdown != 0)
        {
         if(absX >= m_dropX && absX <= m_dropX + m_dropW && absY >= m_dropY && absY <= m_dropY + m_dropH)
           {
            int itemW = m_dropW / m_dropCols;
            int c = (absX - m_dropX) / itemW;
            int r = (absY - m_dropY) / m_dropItemH;
            int idx = r * m_dropCols + c;

            if(idx >= 0 && idx < ArraySize(m_dropdownOptions))
               return idx; // Devuelve la opción 0, 1, 2, etc. ¡Súper rápido!
           }
        }
      return -1; // -1 significa que no tocó nada
     }


   bool              GetButtonCoords(int id, int &x, int &y, int &w, int &h)
     {
      for(int i=0; i<ArraySize(m_buttons); i++)
        {
         if(m_buttons[i].m_id == id)
           {
            x = m_buttons[i].m_x;
            y = m_buttons[i].m_y;
            w = m_buttons[i].m_w;
            h = m_buttons[i].m_h;
            return true;
           }
        }
      return false;
     }

   string            GetButtonText(int id)
     {
      for(int i=0; i<ArraySize(m_buttons); i++)
         if(m_buttons[i].m_id == id)
            return m_buttons[i].m_text;
      return "";
     }

   void              SetButtonText(int id, string text)
     {
      for(int i=0; i<ArraySize(m_buttons); i++)
         if(m_buttons[i].m_id == id)
           {
            m_buttons[i].m_text = text;
            return;
           }
     }

   void              SpawnGhostInput(int id)
     {
      for(int i=0; i<ArraySize(m_buttons); i++)
        {
         if(m_buttons[i].m_id == id)
           {
            // --- MAGIA: NOMBRAMIENTO INTELIGENTE Y SÚPER RÁPIDO ---
            string ghostName = "";
            if(m_engineType == ENGINE_EA2_SUBMENU)
              {
               ghostName = "GhostInput_EA2_" + IntegerToString(m_ownerTicket) + "_" + IntegerToString(id);
              }
            else
              {
               ghostName = "GhostInput_" + IntegerToString(id);
              }

            // =========================================================
            // MICRO-AJUSTE GEOMÉTRICO
            // =========================================================
            // Le quitamos 2 píxeles de ancho y alto, y lo desplazamos 1 px
            // para que la caja nativa encaje DENTRO del borde del CCanvas
            int absX = m_panelX + m_buttons[i].m_x + 1;
            int absY = m_panelY + m_buttons[i].m_y + 1;
            int ghostW = m_buttons[i].m_w - 2;
            int ghostH = m_buttons[i].m_h - 2;

            if(ObjectFind(0, ghostName) < 0)
               ObjectCreate(0, ghostName, OBJ_EDIT, 0, 0, 0);

            ObjectSetInteger(0, ghostName, OBJPROP_XDISTANCE, absX);
            ObjectSetInteger(0, ghostName, OBJPROP_YDISTANCE, absY);
            ObjectSetInteger(0, ghostName, OBJPROP_XSIZE, ghostW);
            ObjectSetInteger(0, ghostName, OBJPROP_YSIZE, ghostH);

            // =========================================================
            // EFECTO CAMALEÓN (Camuflaje de colores ARGB a COLOR nativo)
            // =========================================================
            color bgColor = ARGBToColor(m_buttons[i].m_colorNormal);
            color txtColor = ARGBToColor(m_buttons[i].m_textColor);

            ObjectSetInteger(0, ghostName, OBJPROP_BGCOLOR, bgColor);
            ObjectSetInteger(0, ghostName, OBJPROP_COLOR, txtColor);

            // TRUCO: Pintamos el borde del MISMO color que el fondo.
            // MT5 dibujará su borde redondeado, pero será 100% invisible.
            ObjectSetInteger(0, ghostName, OBJPROP_BORDER_COLOR, bgColor);
            ObjectSetInteger(0, ghostName, OBJPROP_BORDER_TYPE, BORDER_FLAT);

            ObjectSetInteger(0, ghostName, OBJPROP_ALIGN, ALIGN_CENTER);
            ObjectSetInteger(0, ghostName, OBJPROP_FONTSIZE, 10);
            ObjectSetString(0, ghostName, OBJPROP_FONT, "Arial");
            ObjectSetString(0, ghostName, OBJPROP_TEXT, m_buttons[i].m_text);
            ObjectSetInteger(0, ghostName, OBJPROP_ZORDER, 5000);

            m_activeGhostID = id;

            // --- REGISTRO EN EL ÁRBITRO (Para evitar StringSplit luego) ---
            DWM.m_activeGhostEngine = GetPointer(this);
            DWM.m_activeGhostTicket = m_ownerTicket;
            DWM.m_activeGhostOpCode = id;
            DWM.m_activeGhostName   = ghostName;

            ChartSetInteger(0, CHART_SHOW_OBJECT_DESCR, false);
            ChartRedraw();
            return;
           }
        }
     }

   void              KillGhostInput(string ghostObjName)
     {
      string newText = ObjectGetString(0, ghostObjName, OBJPROP_TEXT);
      // Extraemos el ID del nombre "GhostInput_105"
      ushort targetId = (ushort)StringToInteger(StringSubstr(ghostObjName, 11));

      for(int i=0; i<ArraySize(m_buttons); i++)
        {
         if(m_buttons[i].m_id == targetId)
           {
            m_buttons[i].m_text = newText;
            break;
           }
        }
      ObjectDelete(0, ghostObjName);
      Render();
     }

  };

