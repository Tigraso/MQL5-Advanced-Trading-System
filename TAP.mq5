//+------------------------------------------------------------------+
//| SUB-VENTANA: TRAILING STOP EN CCANVAS (Dinámica)                 |
//+------------------------------------------------------------------+
   void              DrawCanvasSubMenu_TS(CUIEngine &subEngine, ulong ticket, int finalMenuX, int btnY)
     {
      CTradeState *mem = TradeRAM.Get(ticket);
      if(mem == NULL)
         return;

      int tsMode = mem.ts.mode;
      bool tsActive = mem.ts.isActive;

      // Extraer la misma lógica dinámica de filas
      TSRowConfig rows[6];
      int activeRows = 0;
      // ... (Reutilizamos la asignación del Switch que ya tenías en DrawSubMenu_TrailingStop)
      switch(tsMode)
        {
         case 0:
            rows[0].Set(true, "Start:", "Pips", GetMemVal(ticket, 0, "20"), true, IN_EDIT, "");
            rows[1].Set(true, "Dist:",  "Pips", GetMemVal(ticket, 1, "20"), true, IN_EDIT, "");
            rows[2].Set(true, "Step:",  "Pips", GetMemVal(ticket, 2, "5"),  true, IN_EDIT, "");
            activeRows = 3;
            break;
         case 1:
            rows[0].Set(true, "Start:",    "Pips", GetMemVal(ticket, 0, "20"), true,  IN_EDIT, "");
            rows[1].Set(true, "Timeframe:","",     "M1", false, IN_DROP, "TF");
            rows[2].Set(true, "Scan Bar:", "",     GetMemVal(ticket, 2, "2"),  false, IN_EDIT, "");
            rows[3].Set(true, "Indent:",   "Pips", GetMemVal(ticket, 3, "2"),  false, IN_EDIT, "");
            activeRows = 4;
            break;
         case 2:
            rows[0].Set(true, "Start:",    "Pips", GetMemVal(ticket, 0, "20"),   true,  IN_EDIT, "");
            rows[1].Set(true, "Timeframe:","",     "M1",   false, IN_DROP, "TF");
            rows[2].Set(true, "Period:",   "",     GetMemVal(ticket, 2, "50"),   false, IN_EDIT, "");
            rows[3].Set(true, "Method:",   "",     "SMA",  false, IN_DROP, "METHOD");
            rows[4].Set(true, "Apply:",    "",     "Close",false, IN_DROP, "PRICE");
            rows[5].Set(true, "Indent:",   "Pips", GetMemVal(ticket, 5, "0"),    false, IN_EDIT, "");
            activeRows = 6;
            break;
         case 3:
            rows[0].Set(true, "Start:",    "Pips", GetMemVal(ticket, 0, "20"),   true,  IN_EDIT, "");
            rows[1].Set(true, "Timeframe:","",     "M1",   false, IN_DROP, "TF");
            rows[2].Set(true, "Step:",     "",     GetMemVal(ticket, 2, "0.02"), false, IN_EDIT, "");
            rows[3].Set(true, "Max:",      "",     GetMemVal(ticket, 3, "0.2"),  false, IN_EDIT, "");
            rows[4].Set(true, "Indent:",   "Pips", GetMemVal(ticket, 4, "5"),    false, IN_EDIT, "");
            activeRows = 5;
            break;
         case 4:
            rows[0].Set(true, "Start:",    "Pips", GetMemVal(ticket, 0, "20"),  true,  IN_EDIT, "");
            rows[1].Set(true, "Timeframe:","",     "M1",  false, IN_DROP, "TF");
            rows[2].Set(true, "Period:",   "",     GetMemVal(ticket, 2, "14"),  false, IN_EDIT, "");
            rows[3].Set(true, "Coeff:",    "",     GetMemVal(ticket, 3, "1.5"), false, IN_EDIT, "");
            rows[4].Set(true, "High/Low:", "OFF",  "",    true,  IN_NONE, "");
            rows[5].Set(true, "SL=ATR*:",  "OFF",  "",    true,  IN_NONE, "");
            activeRows = 6;
            break;
         case 5:
            rows[0].Set(true, "TP1 Modify:","OFF", "",    true,  IN_NONE, "");
            activeRows = 1;
            break;
         case 6:
            rows[0].Set(true, "Start:",    "Pips", GetMemVal(ticket, 0, "20"),  true,  IN_EDIT, "");
            rows[1].Set(true, "Timeframe:","",     "M15", false, IN_DROP, "TF");
            rows[2].Set(true, "Length:",   "",     GetMemVal(ticket, 2, "5"),   false, IN_EDIT, "");
            rows[3].Set(true, "Indent:",   "Pips", GetMemVal(ticket, 3, "2"),   false, IN_EDIT, "");
            activeRows = 4;
            break;
        }

      int subW = 250;
      int subH = 35 + (activeRows * 25) + 5;
      int subX = GetSmartSubMenuX(finalMenuX, subW);
      string canvasName = "CanvasSubMenu_" + IntegerToString(ticket);

      if(ObjectFind(0, canvasName) < 0)
        {
         subEngine.Init(ENGINE_EA2_SUBMENU, canvasName, subX, btnY, subW, subH, ticket);
         DWM.RegisterWindow(GetPointer(subEngine));
         ObjectSetInteger(0, canvasName, OBJPROP_ZORDER, Z_SUB_MENU);
         ObjectSetInteger(0, canvasName, OBJPROP_BACK, false);
        }
      else
        {
         subEngine.Resize(subW, subH);
         ObjectSetInteger(0, canvasName, OBJPROP_XDISTANCE, subX);
         ObjectSetInteger(0, canvasName, OBJPROP_YDISTANCE, btnY);
         subEngine.m_panelX = subX;
         subEngine.m_panelY = btnY;
        }
      subEngine.Clear();

      subEngine.AddPanel(0, 0, subW, subH, Theme.bg, Theme.border); // <-- TEMA

      int btnW = (subW - 15) / 2;
      uint colMain  = tsActive ? Theme.accent : Theme.surface; // <-- TEMA (Cambiado a Accent para consistencia con BE)

      subEngine.AddButton(OP_TM_TS_EXEC, 5, 5, btnW, 20, "Trailing: " + (tsActive ? "ON" : "OFF"), colMain, Theme.border, colMain, (tsActive?Theme.bg:Theme.textMain), colMain, TA_CENTER|TA_VCENTER, "Arial", 12);
      subEngine.AddButton(OP_TM_TS_MODE_DROP, 10 + btnW, 5, btnW, 20, g_tsModes[tsMode] + " ▼", Theme.surface, Theme.border, Theme.surface, Theme.textMain, Theme.accent, TA_CENTER|TA_VCENTER, "Arial", 12); // <-- TEMA

      int startY = 32;
      string sT = IntegerToString(ticket);

      for(int k=0; k<6; k++)
        {
         string sRow = IntegerToString(k);
         int curY = startY + (k * 25);

         // --- SOLUCIÓN: LA LLAVE DEBE ABARCAR TODA LA FILA ---
         if(k < activeRows && rows[k].visible)
           {
            subEngine.AddLabel(rows[k].label, 10, curY + 3, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);

            if(rows[k].showCenter)
              {
               int unitMode = mem.ts.units[k];
               if((tsMode == 4 && (k == 4 || k == 5)) || (tsMode == 5 && k == 0))
                  rows[k].centerTxt = (unitMode == 1) ? "ON" : "OFF";
               else
                 {
                  if(unitMode < 0 || unitMode >= ArraySize(g_tsUnitOpts))
                     unitMode = 0;
                  rows[k].centerTxt = g_tsUnitOpts[unitMode];
                 }
               uint bgUnit = (rows[k].centerTxt == "ON") ? Theme.buy : Theme.surface; // Ajustado a Tema
               subEngine.AddButton((ushort)(OP_TM_TS_UNIT_0 + k), 100, curY, 50, 20, rows[k].centerTxt, bgUnit, Theme.border, bgUnit, (rows[k].centerTxt=="ON"?Theme.bg:Theme.textMain), bgUnit, TA_CENTER|TA_VCENTER, "Arial", 12);
              }

            int rightX = 155;
            int rightW = 85;

            if(rows[k].inputType == IN_EDIT)
              {
               // --- SOLUCIÓN: DECIMALES INTELIGENTES (Cero Bugs Visuales) ---
               int decTS = 0;
               if(rows[k].showCenter)
                 {
                  // Si tiene selector de unidades (Pips=0, RR/%Price/%TP=2)
                  decTS = (mem.ts.units[k] == 0) ? 0 : 2;
                 }
               else
                 {
                  // Es un parámetro puro (Period, Step, Coeff, etc.) sin selector
                  if(tsMode == 3 && (k == 2 || k == 3))
                     decTS = 3; // PSAR Step/Max (Ej: 0.020)
                  else
                     if(tsMode == 4 && k == 3)
                        decTS = 2; // ATR Coeff (Ej: 1.50)
                     else
                        decTS = 0; // Periods, Scan Bars (Enteros)
                 }

               string strVal = DoubleToString(mem.ts.inputs[k], decTS);
               subEngine.AddButton((ushort)(OP_INP_TS_0 + k), rightX, curY, rightW, 20, strVal, Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
              }
            else
               if(rows[k].inputType == IN_DROP)
                 {
                  string currentVal = rows[k].defVal;
                  int idx = mem.ts.dropIdx[k];

                  string src = rows[k].dropSource;
                  if(src == "TF" && idx >= 0 && idx < ArraySize(g_tsTFs))
                     currentVal = g_tsTFs[idx];
                  else
                     if(src == "METHOD" && idx >= 0 && idx < ArraySize(g_maMethods))
                        currentVal = g_maMethods[idx];
                     else
                        if(src == "PRICE" && idx >= 0 && idx < ArraySize(g_maPrices))
                           currentVal = g_maPrices[idx];

                  // Dibujado como Dropdown del Tema
                  subEngine.AddButton((ushort)(OP_TM_TS_DROP_0 + k), rightX, curY, rightW, 20, currentVal + " ▼", Theme.surface, Theme.border, Theme.surface, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
                 }
           } // <--- ¡AQUÍ SE CIERRA AHORA EL IF! (Evita pintar inputs fantasmas)
        }
      subEngine.Render();
     }

//+------------------------------------------------------------------+
//| INTERRUPTOR UNIVERSAL DE INPUTS NATIVOS (Para Arrastre Fluido)   |
//| state: true = ENCENDER (OBJ_ALL_PERIODS), false = APAGAR         |
//+------------------------------------------------------------------+
   void              ToggleOrderInputs(ulong ticket, bool state)
     {
      long targetTF = state ? OBJ_ALL_PERIODS : OBJ_NO_PERIODS;
      string sT = IntegerToString(ticket);
      string prefix = "TM_UI_" + sT; // Todos los inputs de EA2 empiezan así

      int total = ObjectsTotal(0, -1, OBJ_EDIT); // Buscamos SOLO cajas de texto

      for(int i = 0; i < total; i++)
        {
         string objName = ObjectName(0, i, -1, OBJ_EDIT);

         // Si el input pertenece a la orden que estamos arrastrando
         if(StringFind(objName, prefix) == 0)
           {
            // Para evitar parpadeos innecesarios, solo cambiamos si el estado es diferente
            if(ObjectGetInteger(0, objName, OBJPROP_TIMEFRAMES) != targetTF)
              {
               // Opcional: Si vamos a apagar (false), podríamos copiar el texto al Canvas aquí.
               // Pero como la subventana ya dibuja los números detrás, basta con volverlo invisible.
               ObjectSetInteger(0, objName, OBJPROP_TIMEFRAMES, targetTF);
              }
           }
        }
     }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
   void              DrawGridLineTV(string name, double price, color clr, string text, int xPos, int mainWidth, bool isAbove)
     {
      string nameLine = name + "_Line";
      string nameBtn  = name + "_Btn";

      int xDummy, yLine;
      if(!ChartTimePriceToXY(0, 0, TimeCurrent(), price, xDummy, yLine))
         return;

      int gridW = mainWidth;
      int gridX = xPos;

      // 1. LÍNEA DEL GRID
      if(ObjectFind(0, nameLine) < 0)
        {
         ObjectCreate(0, nameLine, OBJ_RECTANGLE_LABEL, 0, 0, 0);
         // --- PROPIEDADES ESTÁTICAS (Solo al nacer) ---
         SmartSetInteger(nameLine, OBJPROP_CORNER, CORNER_LEFT_UPPER);
         SmartSetInteger(nameLine, OBJPROP_YSIZE, 1);
         SmartSetInteger(nameLine, OBJPROP_BACK, false);
         SmartSetInteger(nameLine, OBJPROP_ZORDER, 10);
         SmartSetInteger(nameLine, OBJPROP_BORDER_TYPE, BORDER_FLAT);
         SmartSetInteger(nameLine, OBJPROP_BGCOLOR, clrNONE);
         SmartSetInteger(nameLine, OBJPROP_STYLE, STYLE_DOT);
        }

      // --- PROPIEDADES DINÁMICAS (A 120 FPS) ---
      SmartSetInteger(nameLine, OBJPROP_COLOR, clr);
      SmartSetInteger(nameLine, OBJPROP_XSIZE, gridW);
      SmartSetInteger(nameLine, OBJPROP_XDISTANCE, gridX);
      SmartSetInteger(nameLine, OBJPROP_YDISTANCE, yLine);


      // 2. ETIQUETA DE TEXTO
      int btnW = 170;
      int btnH = 16;
      int btnX = gridX + (gridW / 2) - (btnW / 2);
      int btnY = isAbove ? (yLine - btnH) : (yLine + 1);

      if(ObjectFind(0, nameBtn) < 0)
        {
         ObjectCreate(0, nameBtn, OBJ_EDIT, 0, 0, 0);
         // --- PROPIEDADES ESTÁTICAS (Solo al nacer) ---
         SmartSetInteger(nameBtn, OBJPROP_CORNER, CORNER_LEFT_UPPER);
         SmartSetInteger(nameBtn, OBJPROP_FONTSIZE, 8);
         ObjectSetString(0, nameBtn, OBJPROP_FONT, "Arial");
         SmartSetInteger(nameBtn, OBJPROP_ALIGN, ALIGN_CENTER);
         SmartSetInteger(nameBtn, OBJPROP_READONLY, true);
         SmartSetInteger(nameBtn, OBJPROP_SELECTABLE, false);
         SmartSetInteger(nameBtn, OBJPROP_ZORDER, 11);
         SmartSetInteger(nameBtn, OBJPROP_COLOR, clrWhite);
        }

      // --- PROPIEDADES DINÁMICAS (A 120 FPS) ---
      SmartSetInteger(nameBtn, OBJPROP_XSIZE, btnW);
      SmartSetInteger(nameBtn, OBJPROP_YSIZE, btnH);
      SmartSetInteger(nameBtn, OBJPROP_XDISTANCE, btnX);
      SmartSetInteger(nameBtn, OBJPROP_YDISTANCE, btnY);

      SmartSetInteger(nameBtn, OBJPROP_BGCOLOR, clr);
      color borderC = isAbove ? C'204,236,204' : C'255,204,204';
      SmartSetInteger(nameBtn, OBJPROP_BORDER_COLOR, borderC);
      ObjectSetString(0, nameBtn, OBJPROP_TEXT, text);
     }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
   void              DrawAdvancedLineTV(string name, double price, color clr, string text, int xPos, int mainWidth, bool isAbove)
     {
      string nameLine = name + "_Line";
      string nameBtn  = name + "_Btn";

      int xDummy, yLine;
      if(!ChartTimePriceToXY(0, 0, TimeCurrent(), price, xDummy, yLine))
         return;

      int drawW = mainWidth;
      int drawX = xPos;

      // 1. LÍNEA
      if(ObjectFind(0, nameLine) < 0)
        {
         ObjectCreate(0, nameLine, OBJ_RECTANGLE_LABEL, 0, 0, 0);
         // --- PROPIEDADES ESTÁTICAS ---
         SmartSetInteger(nameLine, OBJPROP_CORNER, CORNER_LEFT_UPPER);
         SmartSetInteger(nameLine, OBJPROP_YSIZE, 1);
         SmartSetInteger(nameLine, OBJPROP_BACK, false);
         SmartSetInteger(nameLine, OBJPROP_ZORDER, 10);
         SmartSetInteger(nameLine, OBJPROP_BORDER_TYPE, BORDER_FLAT);
         SmartSetInteger(nameLine, OBJPROP_BGCOLOR, clrNONE);
         SmartSetInteger(nameLine, OBJPROP_STYLE, STYLE_DOT);
        }

      // --- DINÁMICO ---
      SmartSetInteger(nameLine, OBJPROP_XSIZE, drawW);
      SmartSetInteger(nameLine, OBJPROP_XDISTANCE, drawX);
      SmartSetInteger(nameLine, OBJPROP_COLOR, clr);
      SmartSetInteger(nameLine, OBJPROP_YDISTANCE, yLine);

      // 2. ETIQUETA
      int btnW = 140;
      int btnH = 16;
      int btnX = drawX + (drawW / 2) - (btnW / 2);
      int btnY = isAbove ? (yLine - btnH) : (yLine + 1);

      if(ObjectFind(0, nameBtn) < 0)
        {
         ObjectCreate(0, nameBtn, OBJ_EDIT, 0, 0, 0);
         // --- PROPIEDADES ESTÁTICAS ---
         SmartSetInteger(nameBtn, OBJPROP_CORNER, CORNER_LEFT_UPPER);
         SmartSetInteger(nameBtn, OBJPROP_FONTSIZE, 8);
         ObjectSetString(0, nameBtn, OBJPROP_FONT, "Arial");
         SmartSetInteger(nameBtn, OBJPROP_ALIGN, ALIGN_CENTER);
         SmartSetInteger(nameBtn, OBJPROP_READONLY, true);
         SmartSetInteger(nameBtn, OBJPROP_SELECTABLE, false);
         SmartSetInteger(nameBtn, OBJPROP_ZORDER, 11);
         SmartSetInteger(nameBtn, OBJPROP_COLOR, clrWhite);
        }

      // --- DINÁMICO ---
      SmartSetInteger(nameBtn, OBJPROP_XSIZE, btnW);
      SmartSetInteger(nameBtn, OBJPROP_YSIZE, btnH);
      SmartSetInteger(nameBtn, OBJPROP_XDISTANCE, btnX);
      SmartSetInteger(nameBtn, OBJPROP_YDISTANCE, btnY);

      SmartSetInteger(nameBtn, OBJPROP_BGCOLOR, clr);
      color borderC = isAbove ? C'204,236,204' : C'255,204,204';
      SmartSetInteger(nameBtn, OBJPROP_BORDER_COLOR, borderC);
      ObjectSetString(0, nameBtn, OBJPROP_TEXT, text);
     }

//+------------------------------------------------------------------+
//| Aclara un color sumando un valor (brightness) a los canales RGB  |
//+------------------------------------------------------------------+
   color             LighterColor(color baseColor, int brightnessOffset)
     {
      // 1. Extraer los canales individuales (R, G, B) usando Bitwise Shift
      int r = (baseColor >> 16) & 0xFF;
      int g = (baseColor >> 8) & 0xFF;
      int b = baseColor & 0xFF;

      // 2. Sumar el brillo asegurándose de que no pase de 255 (Blanco puro)
      r = MathMin(255, r + brightnessOffset);
      g = MathMin(255, g + brightnessOffset);
      b = MathMin(255, b + brightnessOffset);

      // 3. Volver a ensamblar el color (B G R en MQL5 interno)
      return (color)((r << 16) | (g << 8) | b);
     }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
   void              BuildConfirmUI(ENUM_ORDER_TYPE type, double lot, double bal, double rMoney, double rPct, double margin, double price, double sl, double tp)
     {
      int chartW = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);
      int chartH = (int)ChartGetInteger(0, CHART_HEIGHT_IN_PIXELS);

      int mW = 250;
      int mH = 340;

      // 1. CALCULAR EL CENTRO POR DEFECTO
      int defX = (chartW / 2) - (mW / 2);
      int defY = (chartH / 2) - (mH / 2);
      if(defY < 10)
         defY = 10;

      // 2. LEER MEMORIA RAM (Evita saltos si ya está abierta)
      int mX, mY;
      if(ObjectFind(0, "CanvasConfirm") >= 0)
        {
         // Si la ventana ya existe, usamos su posición actual en la RAM
         mX = ConfirmWin.m_panelX;
         mY = ConfirmWin.m_panelY;
        }
      else
        {
         // Si es la primera vez que se abre, leemos el disco duro o usamos el centro
         mX = (g_panelDisk[0].confX > 0) ? g_panelDisk[0].confX : defX;
         mY = (g_panelDisk[0].confY > 0) ? g_panelDisk[0].confY : defY;
        }

      // 3. APLICAR LÍMITES DE SEGURIDAD (Física fluida)
      if(mX + (mW / 2) > chartW)
         mX = chartW - (mW / 2);
      if(mY + 40 > chartH)
         mY = chartH - 40;
      if(mX < 0)
         mX = 0;
      if(mY < 0)
         mY = 0;

      // 4. CREAR O ACTUALIZAR
      ConfirmWin.Clear();
      if(ObjectFind(0, "CanvasConfirm") < 0)
        {
         ConfirmWin.Init(ENGINE_CONFIRM, "CanvasConfirm", mX, mY, mW, mH);
         DWM.RegisterWindow(GetPointer(ConfirmWin)); // REGISTRO EN EL ÁRBITRO
        }
      else
        {
         ConfirmWin.Resize(mW, mH);
         ObjectSetInteger(0, "CanvasConfirm", OBJPROP_XDISTANCE, mX);
         ObjectSetInteger(0, "CanvasConfirm", OBJPROP_YDISTANCE, mY);
         ConfirmWin.m_panelX = mX;
         ConfirmWin.m_panelY = mY;
        }

      // --- A. FONDO Y CABECERA ---
      // Fondo principal con borde del color de tu marca (Naranja/Accent)
      ConfirmWin.AddPanel(0, 0, mW, mH, Theme.surface, Theme.border);

      // Cabecera más oscura
      ConfirmWin.AddPanel(0, 0, mW, 32, Theme.bg, 0);
      ConfirmWin.AddLabel("NEW ORDER", mW / 2, 8, "Arial", 12, Theme.textMain, TA_CENTER|TA_TOP);

      // 2. TIPO DE ORDEN DINÁMICO
      bool isBuy = (type == ORDER_TYPE_BUY || type == ORDER_TYPE_BUY_LIMIT || type == ORDER_TYPE_BUY_STOP || type == ORDER_TYPE_BUY_STOP_LIMIT);
      string typeTxt = isBuy ? "BUY ORDER" : "SELL ORDER";
      uint typeClr   = isBuy ? Theme.buy : Theme.sell;

      ConfirmWin.AddLabel(typeTxt, mW / 2, 42, "Arial", 13, typeClr, TA_CENTER|TA_TOP);
      ConfirmWin.AddPanel(20, 68, mW - 40, 1, Theme.border, 0);

      // 3. REEMPLAZA TU ARRAY "vals" FALSO POR ESTO:
      string lbls[7] = {"Lot:", "Balance:", "Risk:", "Margin:", "Price:", "Stop Loss:", "Take Profit:"};

      string riskTxt = DoubleToString(rMoney, 2) + " (" + DoubleToString(rPct, 1) + "%)";
      string slTxt   = (sl > 0) ? DoubleToString(sl, _Digits) : "None";
      string tpTxt   = (tp > 0) ? DoubleToString(tp, _Digits) : "None";

      string vals[7] =
        {
         DoubleToString(lot, 2),
         DoubleToString(bal, 2),
         riskTxt,
         DoubleToString(margin, 2),
         DoubleToString(price, _Digits),
         slTxt,
         tpTxt
        };

      uint valColors[7] =
        {
         Theme.textMain, Theme.textMain,
         (rPct > 5.0) ? Theme.sell : Theme.textMain, // Se pone rojo si arriesgas más del 5%
         Theme.textMain, Theme.textMain,
         Theme.sell, Theme.buy
        };


      int startY = 85;
      int rowH = 22; // Separación entre filas

      for(int i=0; i<7; i++)
        {
         int currY = startY + (i * rowH);

         // Etiqueta Izquierda (Alineación Izquierda)
         ConfirmWin.AddLabel(lbls[i], 20, currY, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);

         // Valor Derecha (Alineación Derecha: Ocupa todo el ancho menos 20px de margen)
         ConfirmWin.AddLabel(vals[i], mW - 20, currY, "Arial", 12, valColors[i], TA_RIGHT|TA_TOP);
        }

      // 4. CHECKBOX DINÁMICO CON LA MEMORIA DEL EA
      int yCheck = 85 + (7 * 22) + 12;
      uint checkBg  = m_confirm_Silence ? Theme.accent : Theme.bg;
      uint checkTxt = m_confirm_Silence ? Theme.bg : Theme.textMain;
      string checkStr = m_confirm_Silence ? "Don't Ask Again: ON" : "Don't Ask Again";

      ConfirmWin.AddButton(OP_CONF_CHECK, 20, yCheck, mW - 40, 26, checkStr, checkBg, Theme.surface, Theme.accent, checkTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      // --- E. BOTONES DE ACCIÓN (Confirm / Cancel) ---
      int yBtn = mH - 45;
      int wBtn = (mW - 50) / 2; // Dos botones iguales con separación

      // Botón YES (Naranja brillante)
      ConfirmWin.AddButton(OP_CONF_YES, 20, yBtn, wBtn, 30, "CONFIRM", Theme.accent, ColorToARGB(C'255,180,50',255), Theme.accent, Theme.bg, Theme.accent, TA_CENTER|TA_VCENTER, "Arial", 12);

      // Botón NO (Gris/Oscuro)
      ConfirmWin.AddButton(OP_CONF_NO, 30 + wBtn, yBtn, wBtn, 30, "CANCEL", Theme.bg, Theme.surface, Theme.bg, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      // 3. Renderizamos el lienzo
      ConfirmWin.Render();

      // 4. Forzamos a MT5 a mostrar el lienzo nativo en todos los timeframes
      ObjectSetInteger(0, "CanvasConfirm", OBJPROP_HIDDEN, false);
      ObjectSetInteger(0, "CanvasConfirm", OBJPROP_TIMEFRAMES, OBJ_ALL_PERIODS);
     }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
   void              ProcessConfirmClick(ushort opcode)
     {
      if(opcode == OP_CONF_YES)
        {
         if(m_confirm_PendingType != -1)
            ExecuteOrder(m_confirm_PendingType);

         ManageConfirmWindow(false);

         ChartRedraw();

        }
      else
         if(opcode == OP_CONF_NO)
           {
            ManageConfirmWindow(false);
            ChartRedraw();

           }
         else
            if(opcode == OP_CONF_CHECK)
              {
               m_confirm_Silence = !m_confirm_Silence; // Invertir memoria
               // Refrescar al instante para ver la cajita iluminarse
               ManageConfirmWindow(true, m_confirm_PendingType);

              }
     }
//+------------------------------------------------------------------+

//+------------------------------------------------------------------+
//| EXTRACTOR DE TEXTO: GRID (TP y SL Parciales)                     |
//+------------------------------------------------------------------+
   string            GetGridLabelText(ulong ticket, int row, bool isTP, double linePrice)
     {
      double entry, sl, tp, vol;
      long type;
      CTradeState *mem;

      if(!GetUnifiedTradeInfo(ticket, entry, sl, tp, vol, type, mem))
         return "";

      string sym = (ticket == 0) ? _Symbol : mem.symbol;
      double point    = Market.point;
      //int digits      = Market.digits;
      double mul      = Market.multiplier;
      double tickVal  = Market.tickValue;
      double tickSize = Market.tickSize;
      string cur      = AccountInfoString(ACCOUNT_CURRENCY);

      // Distancia en Pips
      double distPips = MathAbs(entry - linePrice) / mul;

      // Lote (Usamos tu propia función para que sea 100% consistente)
      double baseVol = (ticket == 0) ? vol : (PositionSelectByTicket(ticket) ? PositionGetDouble(POSITION_VOLUME) : OrderGetDouble(ORDER_VOLUME_CURRENT));
      if(baseVol <= 0)
         baseVol = vol; // Respaldo
      double finalLot = CalculateGridVolume(ticket, row, isTP ? 1 : 2, mem.grid.lotMode, baseVol);

      // Dinero Estimado
      double moneyEst = (tickSize > 0) ? (MathAbs(entry - linePrice) / tickSize) * tickVal * finalLot : 0;

      // Risk Ratio (RR)
      double rr = 0;
      string sI = IntegerToString(row);

      if(isTP)
        {
         if(sl > 0 && MathAbs(entry - sl) > point)
            rr = MathAbs(entry - linePrice) / MathAbs(entry - sl);

         return StringFormat("TP%s %.0f | %.2f | RR %.2f | %.2f %s", sI, distPips, finalLot, rr, moneyEst, cur);
        }
      else
        {
         if(tp > 0 && MathAbs(entry - tp) > point)
            rr = MathAbs(entry - linePrice) / MathAbs(entry - tp);

         return StringFormat("SL%s %.0f | %.2f | RR %.2f | -%.2f %s", sI, distPips, finalLot, rr, moneyEst, cur);
        }
     }

//+------------------------------------------------------------------+
//| EXTRACTOR DE TEXTO: TRAILING STOP                                |
//+------------------------------------------------------------------+
   string            GetTSLabelText(ulong ticket, bool isStartLine, double linePrice)
     {
      double entry, sl, tp, vol;
      long type;
      CTradeState *mem;

      if(!GetUnifiedTradeInfo(ticket, entry, sl, tp, vol, type, mem))
         return "";

      string sym = (ticket == 0) ? _Symbol : mem.symbol;
      double point    = Market.point;
      //int digits      = Market.digits;
      double mul      = Market.multiplier;
      double tickVal  = Market.tickValue;
      double tickSize = Market.tickSize;
      string cur      = AccountInfoString(ACCOUNT_CURRENCY);

      int tsMode = mem.ts.mode;
      string modeStr = g_tsModes[tsMode];

      if(isStartLine)
        {
         double distStart = MathAbs(linePrice - entry) / mul;
         return StringFormat("TS %.0f | %s", distStart, modeStr);
        }
      else
        {
         double distTarget = MathAbs(linePrice - entry) / mul;
         double moneyEst = (tickSize > 0) ? (MathAbs(entry - linePrice) / tickSize) * tickVal * vol : 0;
         return StringFormat("TS %.0f | %.2f %s | %s", distTarget, moneyEst, cur, modeStr);
        }
     }

//+------------------------------------------------------------------+
//| EXTRACTOR DE TEXTO: BREAK EVEN                                   |
//+------------------------------------------------------------------+
   string            GetBELabelText(ulong ticket, bool isStartLine, double linePrice)
     {
      double entry, sl, tp, vol;
      long type;
      CTradeState *mem;

      if(!GetUnifiedTradeInfo(ticket, entry, sl, tp, vol, type, mem))
         return "";

      string sym = (ticket == 0) ? _Symbol : mem.symbol;
      double point    = Market.point;
      //int digits      = Market.digits;
      double mul      = Market.multiplier;
      double tickVal  = Market.tickValue;
      double tickSize = Market.tickSize;
      string cur      = AccountInfoString(ACCOUNT_CURRENCY);

      if(isStartLine)
        {
         double distStart = MathAbs(linePrice - entry) / mul;
         double rr = (sl > 0 && MathAbs(entry - sl) > point) ? MathAbs(entry - linePrice) / MathAbs(entry - sl) : 0;
         return StringFormat("BE %.0f | RR %.2f", distStart, rr);
        }
      else
        {
         double distOff = MathAbs(linePrice - entry) / mul;
         double moneyEst = (tickSize > 0) ? (MathAbs(entry - linePrice) / tickSize) * tickVal * vol : 0;
         return StringFormat("SL %.0f | %.2f %s", distOff, moneyEst, cur);
        }
     }

//+------------------------------------------------------------------+
//| EXTRACTOR DE TEXTO: MENÚ MODIFY (Líneas Fantasmas)               |
//+------------------------------------------------------------------+
   string            GetModifyLabelText(ulong ticket, int modifyType, double linePrice)
     {
      double entry, sl, tp, vol;
      long type;
      CTradeState *mem;

      if(!GetUnifiedTradeInfo(ticket, entry, sl, tp, vol, type, mem))
         return "";

      string sym = (ticket == 0) ? _Symbol : mem.symbol;
      double point    = Market.point;
      int dig      = Market.digits;
      double mul      = Market.multiplier;
      double tickVal  = Market.tickValue;
      double tickSize = Market.tickSize;
      string cur      = AccountInfoString(ACCOUNT_CURRENCY);

      if(modifyType == 50) // TP Fantasma
        {
         double distTP = MathAbs(linePrice - entry) / mul;
         double moneyTP = (tickSize > 0) ? (MathAbs(entry - linePrice) / tickSize) * tickVal * vol : 0;
         return StringFormat("[Prev] TP %.0f | %.2f %s", distTP, moneyTP, cur);
        }
      else
         if(modifyType == 51) // SL Fantasma
           {
            double distSL = MathAbs(entry - linePrice) / mul;
            double moneySL = (tickSize > 0) ? (MathAbs(entry - linePrice) / tickSize) * tickVal * vol : 0;
            return StringFormat("[Prev] SL %.0f | -%.2f %s", distSL, moneySL, cur);
           }
         else
            if(modifyType == 52) // Price Fantasma
              {
               return "New Entry: " + DoubleToString(linePrice, dig);
              }

      return "";
     }

//+------------------------------------------------------------------+
//| REGLA DE ORO: ¿Tiene permiso el Gestor (EA2) para dibujarse?     |
//+------------------------------------------------------------------+
   bool              CanDrawManager()
     {
      // Solo se dibuja si la Figura Pre-Op está APAGADA y el botón Hide está APAGADO
      return (!m_linesActive && !m_isManagerHidden);
     }

//+------------------------------------------------------------------+
//| BORRADOR UNIVERSAL: Aniquila el EA2 visualmente sin dejar rastro |
//+------------------------------------------------------------------+
   void              EraseManagerVisuals()
     {
      int memTotal = TradeRAM.Total();
      for(int i=0; i<memTotal; i++)
        {
         if(CheckPointer(TradeRAM.GetByIndex(i)) != POINTER_INVALID)
           {
            ulong t = TradeRAM.GetByIndex(i).ticket;
            // Forzar colapso y cerrar menús en RAM
            TradeRAM.GetByIndex(i).isCollapsed = true;
            TradeRAM.GetByIndex(i).isMenuOpen = false;
            TradeRAM.GetByIndex(i).activeSubMenu = 0;
            TradeRAM.GetByIndex(i).menuCanvas.DestroyCanvas();
            TradeRAM.GetByIndex(i).subMenuCanvas.DestroyCanvas();
            // Borrar toda la estructura visual del ticket al instante

            DWM.UnregisterWindow(GetPointer(TradeRAM.GetByIndex(i).menuCanvas));
            DWM.UnregisterWindow(GetPointer(TradeRAM.GetByIndex(i).subMenuCanvas));
            TradeRAM.GetByIndex(i).menuCanvas.DestroyCanvas();
            TradeRAM.GetByIndex(i).subMenuCanvas.DestroyCanvas();

            DeleteAllTradeVisuals(t);
           }
        }
     }

//+------------------------------------------------------------------+
//| SINCRONIZADOR DE TRADE LEVELS NATIVOS DE MT5                     |
//+------------------------------------------------------------------+
   void              UpdateTradeLevelsVisibility()
     {
      // Si el Gestor NO tiene permiso de dibujarse (por la Figura o por el botón Hide)
      if(!CanDrawManager())
         ChartSetInteger(m_chartId, CHART_SHOW_TRADE_LEVELS, false); // Los apagamos
      else
         ChartSetInteger(m_chartId, CHART_SHOW_TRADE_LEVELS, m_chartTradeLevelsWasOn); // Restauramos la preferencia del usuario
     }

//+------------------------------------------------------------------+
//| PROCESADOR DE GUARDADO Y REACCIONES (STATE-DRIVEN)               |
//+------------------------------------------------------------------+
   void              ProcessGhostInputSave(int id, string text)
     {
      // =================================================================
      // 🕵️‍♂️ EASTER EGG: EL MODO DIOS (Firma del Desarrollador)
      // =================================================================
      if(id == OP_INP_LOT && text == "IDDQD")
        {
         Print("\n");
         Print("   ██████████ ███████ ██████   ██████   ██████  ");
         Print("      ██      ██   ██ ██   ██ ██    ██ ██    ██ ");
         Print("      ██      ███████ ██████  ██    ██ ██    ██ ");
         Print("      ██      ██      ██   ██ ██    ██ ██    ██ ");
         Print("      ██      ██      ██████   ██████   ██████  ");
         Print("                                                ");
         Print("==========================================================");
         Print(">>> TAP - CORE ENGINE v1.0");
         Print(">>> DEVELOPED & ARCHITECTED BY: [Leonardo and Dayana Cubillas Massana]");
         Print(">>> 'Code is Poetry. Zero Patches. Pure Performance.'");
         Print("==========================================================\n");

         PlaySound("expert.wav"); // Un sonido de victoria

         // Restauramos el texto de la cajita al lote que ya estaba en la RAM
         // para que el EA no intente calcular lotes con letras.
         Engine.FastUpdateText(OP_INP_LOT, DoubleToString(PanelState.GetLot(), 2));
         return; // Cortamos la ejecución aquí. El EA sigue intacto.
        }
      // 1. Convertimos a número limpiando cualquier texto basura
      double val = StringToDouble(text);

      // 2. Guardamos en RAM y ejecutamos las REACCIONES
      switch(id)
        {
         case OP_INP_STOPLIMIT:
            if(m_linesActive && m_isStopLimitMode)
              {
               double entryP = ObjectGetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE);
               double slP = ObjectGetDouble(m_chartId, m_lineSL, OBJPROP_PRICE);
               bool isBuy = (slP < entryP);

               double newSlimPrice = 0;
               if(m_isPriceMode)
                  newSlimPrice = val;
               else
                  newSlimPrice = isBuy ? (entryP + (val * Market.multiplier)) : (entryP - (val * Market.multiplier));

               if(newSlimPrice > 0)
                 {
                  UpdateInvisibleLine(m_lineStopLimit, newSlimPrice, ARGBToColor(Theme.accent), 8);
                  UpdateInputsFromLines(); // Actualiza visuales y panel
                 }
              }
            break;
         case OP_SET_PRESET_INP:
            // Sanitizamos el texto para que no tenga caracteres prohibidos en Windows
            StringReplace(text, "\\", "");
            StringReplace(text, "/", "");
            StringReplace(text, ":", "");
            StringReplace(text, "*", "");
            StringReplace(text, "?", "");
            StringReplace(text, "\"", "");
            StringReplace(text, "<", "");
            StringReplace(text, ">", "");
            StringReplace(text, "|", "");
            if(text != "")
               g_presetName = text;
            BuildSettingsUI();
            break;
         case OP_SET_INP_SPREAD: // <--- AÑADIR
            g_maxSpread = (int)val;
            BuildSettingsUI();
            break;
         case OP_INP_RISK:
            PanelState.SetRisk(val);
            CalculateLot();
            if(m_linesActive)
               UpdateInputsFromLines(); // Actualiza el dinero flotante en las líneas
            break;

         case OP_INP_LOT:
            PanelState.SetLot(val);
            if(m_linesActive)
               UpdateInputsFromLines();
            break;

         case OP_INP_PRICE:
            PanelState.SetPrice(val);
            if(m_linesActive && m_isPriceMode)
              {
               // Movemos la línea verde de entrada al nuevo precio
               UpdateLinesFromInputs();
               if(m_isRRActive)
                 {
                  SyncRR(false, false);
                  SyncRR(true, false);
                 }
               CalculateLot();
               UpdateInputsFromLines();
              }
            break;

         case OP_INP_SL:
            PanelState.SetSL(val);
            if(m_linesActive)
              {
               // 1. Movemos la línea en el gráfico al instante
               UpdateLinesFromInputs();

               // 2. Si el Risk/Reward está activo, movemos también el TP automáticamente
               if(m_isRRActive)
                  SyncRR(true, false);

               // 3. Recalculamos el Lotaje y refrescamos etiquetas
               CalculateLot();
               UpdateInputsFromLines();
              }
            break;

         case OP_INP_TP:
            PanelState.SetTP(val);
            if(m_linesActive)
              {
               UpdateLinesFromInputs();
               if(m_isRRActive)
                  SyncRR(false, false);
               CalculateLot();
               UpdateInputsFromLines();
              }
            break;

         case OP_INP_RR_REWARD:
            PanelState.SetRR_Reward(val);
            // Si editamos el RR, movemos la línea del TP
            if(m_linesActive && m_isRRActive)
               SyncRR(true, true);
            break;

         case OP_INP_RR_RISK:
            PanelState.SetRR_Risk(val);
            // Si editamos el RR, movemos la línea del SL
            if(m_linesActive && m_isRRActive)
               SyncRR(false, true);
            break;

         case OP_INP_PANEL_COMM: // <--- NUEVO CASO
            // Limitamos estrictamente a 15 caracteres (Corta el exceso)
            if(StringLen(text) > 15)
               text = StringSubstr(text, 0, 15);

            // Si el usuario lo deja vacío, ponemos un default
            if(text == "")
               text = "Comment";

            PanelState.SetComment(text);
            break;

         // ... (Tus casos anteriores OP_INP_RISK, etc. se quedan igual)

         // --- GUARDADO DEL GRID (MANAGE) ---
         case OP_INP_GRID_TP_P_1:
         case OP_INP_GRID_TP_P_2:
         case OP_INP_GRID_TP_P_3:
         case OP_INP_GRID_TP_P_4:
         case OP_INP_GRID_TP_P_5:
            TemplateState.grid.rows[id - OP_INP_GRID_TP_P_1].valTP_Price = val;
            if(m_linesActive)
               UpdateInputsFromLines();
            break;
         case OP_INP_GRID_TP_V_1:
         case OP_INP_GRID_TP_V_2:
         case OP_INP_GRID_TP_V_3:
         case OP_INP_GRID_TP_V_4:
         case OP_INP_GRID_TP_V_5:
            TemplateState.grid.rows[id - OP_INP_GRID_TP_V_1].valTP_Vol = val;
            if(m_linesActive)
               UpdateInputsFromLines();
            break;
         case OP_INP_GRID_SL_P_1:
         case OP_INP_GRID_SL_P_2:
         case OP_INP_GRID_SL_P_3:
         case OP_INP_GRID_SL_P_4:
         case OP_INP_GRID_SL_P_5:
            TemplateState.grid.rows[id - OP_INP_GRID_SL_P_1].valSL_Price = val;
            if(m_linesActive)
               UpdateInputsFromLines();
            break;
         case OP_INP_GRID_SL_V_1:
         case OP_INP_GRID_SL_V_2:
         case OP_INP_GRID_SL_V_3:
         case OP_INP_GRID_SL_V_4:
         case OP_INP_GRID_SL_V_5:
            TemplateState.grid.rows[id - OP_INP_GRID_SL_V_1].valSL_Vol = val;
            if(m_linesActive)
               UpdateInputsFromLines();
            break;

         // --- GUARDADO DE AUTO (TS & BE) ---
         case OP_INP_TS_0:
         case OP_INP_TS_1:
         case OP_INP_TS_2:
         case OP_INP_TS_3:
         case OP_INP_TS_4:
         case OP_INP_TS_5:
           {
            int tsIdx = id - OP_INP_TS_0;

            // 1. SI EDITAMOS EL START (inputs[0])
            if(tsIdx == 0 && m_linesActive)
              {
               // Necesitamos saber dónde estaba la línea Dist (Target) ANTES de cambiar el Start
               double oldStartPrice = ObjectGetDouble(0, MakeTMName(0, OP_HLINE_TS_START), OBJPROP_PRICE);
               double currentDistPrice = ObjectGetDouble(0, MakeTMName(0, OP_HLINE_TS_DIST), OBJPROP_PRICE);

               // Guardamos el nuevo Start
               TemplateState.ts.inputs[0] = val;

               // Si la línea Dist existe en el gráfico, recalculamos su valor para que no salte
               if(currentDistPrice > 0)
                 {
                  double entry = ObjectGetDouble(0, m_lineEntry, OBJPROP_PRICE);
                  double sl    = ObjectGetDouble(0, m_lineSL, OBJPROP_PRICE);
                  double tp    = ObjectGetDouble(0, m_lineTP, OBJPROP_PRICE);

                  double point = Market.point;
                  double mul   = Market.multiplier;
                  int modeDist = TemplateState.ts.units[1];

                  // Calculamos dónde va a nacer la nueva línea Start con el valor recién escrito
                  double newStartPrice = GetTSLevelPrice(0, 0, TemplateState.ts.units[0], val, entry, sl, tp);

                  // Medimos la distancia absoluta entre el NUEVO Start y el VIEJO Dist
                  double distTargetAbs = MathAbs(currentDistPrice - newStartPrice);
                  double newDistVal = 0;

                  if(modeDist == 0)
                     newDistVal = distTargetAbs / mul;
                  else
                     if(modeDist == 1)
                       {
                        double r = MathAbs(entry - sl);
                        if(r < point)
                           r = 50*mul;
                        newDistVal = distTargetAbs / r;
                       }
                     else
                        if(modeDist == 2)
                           newDistVal = (distTargetAbs / entry) * 100.0;
                        else
                           if(modeDist == 3)
                             {
                              if(tp > 0)
                                 newDistVal = (distTargetAbs / MathAbs(tp - entry)) * 100.0;
                              else
                                 newDistVal = 20;
                             }

                  TemplateState.ts.inputs[1] = newDistVal; // Compensamos el Dist en la RAM
                 }
              }
            else
              {
               // Si editamos cualquier otra cajita (Dist, Step, Period, etc.)
               TemplateState.ts.inputs[tsIdx] = val;
              }

            if(m_linesActive)
               UpdateInputsFromLines(); // Esto redibujará las líneas en su sitio
            break;
           }

         case OP_INP_BE_START:
            TemplateState.be.valStart = val;
            if(m_linesActive)
               UpdateInputsFromLines();
            break;
         case OP_INP_BE_OFFSET:
            TemplateState.be.valOffset = val;
            if(m_linesActive)
               UpdateInputsFromLines();
            break;
        }

      // 3. Finalmente, repintamos el CCanvas para que coincida con la RAM
      BuildCanvasUI();
      ChartRedraw();
     }

//+------------------------------------------------------------------+
//| PROCESA Y GUARDA LOS FANTASMAS DEL GESTOR (EA2)                  |
//+------------------------------------------------------------------+
   void              TM_ProcessGhostInputSave(ulong ticket, int opcode, string text)
     {
      CTradeState *mem = TradeRAM.Get(ticket);
      if(mem == NULL)
         return;

      string sT = IntegerToString(ticket);

      // Si es un comentario, lo guardamos directo en la RAM de la orden (1 ciclo de reloj)
      if(opcode == OP_TM_INP_COMM)
        {
         mem.customComment = text;
         SaveTradesToBin(); // <--- Dispara la escritura asíncrona al disco
         UpdateOpenTradesVisuals();
         ChartRedraw();
         return;
        }

      // Para todos los demás, es matemática pura
      double val = StringToDouble(text);

      switch(opcode)
        {
         // --- BORRADORES TEMPORALES (Modify y Partial) ---
         case OP_TM_INP_PARTIAL_VOL:
            mem.draftPart = val;
            break;
         case OP_TM_INP_EDIT_PR:
            mem.draftPr = val;
            break;
         case OP_TM_INP_EDIT_TRIG: // <--- NUEVO CASO
            mem.draftTrig = val;
            break;
         case OP_TM_INP_EDIT_TP:
            mem.draftTP = val;
            break;
         case OP_TM_INP_EDIT_SL:
            mem.draftSL = val;
            break;

         // --- TRAILING LIMIT ---
         case OP_TM_INP_TRLIM_DIST:
            mem.trailLimitDist = val;
            break;

         // --- GRID TP ---
         case OP_INP_GRID_TP_P_1:
         case OP_INP_GRID_TP_P_2:
         case OP_INP_GRID_TP_P_3:
         case OP_INP_GRID_TP_P_4:
         case OP_INP_GRID_TP_P_5:
            mem.grid.rows[opcode - OP_INP_GRID_TP_P_1].valTP_Price = val;
            break;
         case OP_INP_GRID_TP_V_1:
         case OP_INP_GRID_TP_V_2:
         case OP_INP_GRID_TP_V_3:
         case OP_INP_GRID_TP_V_4:
         case OP_INP_GRID_TP_V_5:
            mem.grid.rows[opcode - OP_INP_GRID_TP_V_1].valTP_Vol = val;
            break;

         // --- GRID SL ---
         case OP_INP_GRID_SL_P_1:
         case OP_INP_GRID_SL_P_2:
         case OP_INP_GRID_SL_P_3:
         case OP_INP_GRID_SL_P_4:
         case OP_INP_GRID_SL_P_5:
            mem.grid.rows[opcode - OP_INP_GRID_SL_P_1].valSL_Price = val;
            break;
         case OP_INP_GRID_SL_V_1:
         case OP_INP_GRID_SL_V_2:
         case OP_INP_GRID_SL_V_3:
         case OP_INP_GRID_SL_V_4:
         case OP_INP_GRID_SL_V_5:
            mem.grid.rows[opcode - OP_INP_GRID_SL_V_1].valSL_Vol = val;
            break;

         // --- TRAILING STOP ---
         case OP_INP_TS_0:
         case OP_INP_TS_1:
         case OP_INP_TS_2:
         case OP_INP_TS_3:
         case OP_INP_TS_4:
         case OP_INP_TS_5:
           {
            int tsIdx = opcode - OP_INP_TS_0;

            // 1. SI EDITAMOS EL START (inputs[0])
            if(tsIdx == 0 && ticket > 0)
              {
               string distLineName = MakeTMName(ticket, OP_HLINE_TS_DIST);
               double currentDistPrice = ObjectGetDouble(0, distLineName, OBJPROP_PRICE);

               // Guardamos el nuevo Start
               mem.ts.inputs[0] = val;

               // Si la línea Dist está viva en el gráfico, la compensamos
               if(currentDistPrice > 0)
                 {
                  double entry, sl, tp, vol;
                  long type;
                  CTradeState *dummyMem;
                  if(GetUnifiedTradeInfo(ticket, entry, sl, tp, vol, type, dummyMem))
                    {
                     double point = SymbolInfoDouble(mem.symbol, SYMBOL_POINT);
                     double mul   = (SymbolInfoInteger(mem.symbol, SYMBOL_DIGITS)%2!=0) ? 10 * point : point;
                     int modeDist = mem.ts.units[1];

                     // Dónde nace el nuevo Start
                     double newStartPrice = GetTSLevelPrice(ticket, 0, mem.ts.units[0], val, entry, sl, tp);

                     // Distancia absoluta entre NUEVO Start y VIEJO Dist
                     double distTargetAbs = MathAbs(currentDistPrice - newStartPrice);
                     double newDistVal = 0;

                     if(modeDist == 0)
                        newDistVal = distTargetAbs / mul;
                     else
                        if(modeDist == 1)
                          {
                           double r = MathAbs(entry - sl);
                           if(r < point)
                              r = 50*mul;
                           newDistVal = distTargetAbs / r;
                          }
                        else
                           if(modeDist == 2)
                              newDistVal = (distTargetAbs / entry) * 100.0;
                           else
                              if(modeDist == 3)
                                {
                                 if(tp > 0)
                                    newDistVal = (distTargetAbs / MathAbs(tp - entry)) * 100.0;
                                 else
                                    newDistVal = 20;
                                }

                     mem.ts.inputs[1] = newDistVal; // Compensamos el Dist en la RAM
                    }
                 }
              }
            else
              {
               // Si editamos cualquier otra cajita
               mem.ts.inputs[tsIdx] = val;
              }
            break;
           }

         // --- BREAK EVEN ---
         case OP_INP_BE_START:
            mem.be.valStart = val;
            break;
         case OP_INP_BE_OFFSET:
            mem.be.valOffset = val;
            break;
        }

      // 1. VOLCADO ASESINO: Guardamos todos los cambios al disco en 1 microsegundo.
      SaveTradesToBin();

      UpdateOpenTradesVisuals();
      ChartRedraw();
     }

//+------------------------------------------------------------------+
//| PROCESA Y GUARDA LOS FANTASMAS DEL TIME TRADER                   |
//+------------------------------------------------------------------+
   void              Time_ProcessGhostInputSave(int id, string text)
     {
      // 1. Actualizar el texto visual en el CCanvas
      TimeWin.SetButtonText(id, text);

      // (Nota: TimeTrader lee sus valores de la UI al presionar "ADD TASK",
      // así que con actualizar el botón es suficiente por ahora).

      TimeWin.Render();
      ChartRedraw();
     }

//+------------------------------------------------------------------+
//| PROCESA, VALIDA Y GUARDA LOS FANTASMAS DEL EQUITY PROTECT        |
//+------------------------------------------------------------------+
   void              Protect_ProcessGhostInputSave(int id, string text)
     {
      if(id >= OP_PROT_INP_0 && id <= OP_PROT_INP_0 + 12)
        {
         int idx = id - OP_PROT_INP_0;
         string cleanText = text;
         bool isValid = true;

         // =========================================================
         // 1. VALIDAR NÚMEROS (Índices 0 al 8: Dinero, Porcentajes)
         // =========================================================
         if(idx <= 8)
           {
            // Sanitización: Quitamos símbolos comunes que el usuario suele escribir
            StringReplace(cleanText, "$", "");
            StringReplace(cleanText, "%", "");
            StringReplace(cleanText, " ", "");

            double val = StringToDouble(cleanText);

            // Inyectamos a la memoria RAM el número puro y duro
            g_protect.f[idx].configNum = val;

            // Formateamos elegantemente a 2 decimales para la UI
            cleanText = DoubleToString(val, 2);
           }

         // =========================================================
         // 2. VALIDAR TIEMPOS DIARIOS (Índices 9, 10, 12) -> Formato HH:MM
         // =========================================================
         else
            if(idx == 9 || idx == 10 || idx == 12)
              {
               string parts[];
               if(StringSplit(cleanText, ':', parts) >= 2)
                 {
                  int h = (int)StringToInteger(parts[0]);
                  int m = (int)StringToInteger(parts[1]);

                  // ¿Es una hora humana real?
                  if(h >= 0 && h <= 23 && m >= 0 && m <= 59)
                    {
                     g_protect.f[idx].configHour = h;
                     g_protect.f[idx].configMin  = m;

                     // Forzamos el formato perfecto de 2 dígitos (ej: "09:05")
                     cleanText = StringFormat("%02d:%02d", h, m);
                    }
                  else
                    {
                     isValid = false;
                    }
                 }
               else
                 {
                  isValid = false;
                 }
              }

            // =========================================================
            // 3. VALIDAR FECHA EXACTA (Índice 11) -> Formato YYYY.MM.DD HH:MM
            // =========================================================
            else
               if(idx == 11)
                 {
                  datetime parsedTime = StringToTime(cleanText);
                  // Si la fecha es válida y es en el futuro...
                  if(parsedTime > TimeCurrent())
                    {
                     g_protect.f[idx].configTime = parsedTime;
                     cleanText = TimeToString(parsedTime, TIME_DATE|TIME_MINUTES);
                    }
                  else
                    {
                     isValid = false;
                    }
                 }

         // =========================================================
         // VEREDICTO FINAL (RECHAZO O ACEPTACIÓN)
         // =========================================================
         if(!isValid)
           {
            // RECHAZADO: Tocamos error y NO guardamos nada.
            // La UI volverá automáticamente al último valor seguro que teníamos en memoria.

            //Print(">>> [EQUITY PROTECT] Input inválido rechazado: ", text);
            ProtectWin.SetButtonText(id, g_protect.f[idx].configStr);
           }
         else
           {
            // ACEPTADO: Guardamos el texto limpio en la memoria visual y actualizamos la UI
            g_protect.f[idx].configStr = cleanText;
            ProtectWin.SetButtonText(id, cleanText);

           }
        }

      // Redibujamos la ventana para aplicar los cambios o la restauración
      ProtectWin.Render();
      ChartRedraw();
      // Guardamos cualquier cambio del Equity Protect
      SaveProtectToBin();
     }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
   void              DeleteTradeGlobalVariables(ulong ticket)
     {
      return;
      string sTk = IntegerToString(ticket);
      string matchMid = "_" + sTk + "_"; // Busca patrones como "TM_Grid_12345_Btn"
      string matchEnd = "_" + sTk;       // Busca patrones como "TM_TSMode_12345"

      int total = GlobalVariablesTotal();
      // Recorremos hacia atrás porque vamos a eliminar elementos de la lista
      for(int i = total - 1; i >= 0; i--)
        {
         string vName = GlobalVariableName(i);

         // Comprobación de seguridad: Evitar que al borrar "123" se borre "12345"
         bool containsMid = (StringFind(vName, matchMid) >= 0);
         bool endsWithTicket = (StringLen(vName) >= StringLen(matchEnd) && StringSubstr(vName, StringLen(vName) - StringLen(matchEnd)) == matchEnd);


        }
     }

//+------------------------------------------------------------------+
//| DEGRADA TODAS LAS VENTANAS A Z-ORDER 10 (ESTADO INACTIVO)        |
//+------------------------------------------------------------------+
   void              DowngradeOtherWindows()
     {
      if(ObjectFind(0, "CanvasProEngine") >= 0)
         ObjectSetInteger(0, "CanvasProEngine", OBJPROP_ZORDER, 10);
      if(ObjectFind(0, "CanvasTimeTrader") >= 0)
         ObjectSetInteger(0, "CanvasTimeTrader", OBJPROP_ZORDER, 10);
      if(ObjectFind(0, "CanvasProtectPro") >= 0)
         ObjectSetInteger(0, "CanvasProtectPro", OBJPROP_ZORDER, 10);
      if(ObjectFind(0, "CanvasNewsFilter") >= 0)
         ObjectSetInteger(0, "CanvasNewsFilter", OBJPROP_ZORDER, 10);
      if(ObjectFind(0, "CanvasModalInfo") >= 0)
         ObjectSetInteger(0, "CanvasModalInfo", OBJPROP_ZORDER, 10);
      if(ObjectFind(0, "CanvasConfirm") >= 0)
         ObjectSetInteger(0, "CanvasConfirm", OBJPROP_ZORDER, 10);
     }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
   void              UpdateDailyProfitCache()
     {
      MqlDateTime dt;
      TimeCore.NowStruct(dt);
      int today = dt.day_of_year;

      // Si cambiamos de día calendario, reseteamos la memoria
      if(today != g_lastCalculatedDay)
        {
         g_cachedDailyProfit = 0.0;
         g_lastCalculatedDay = today;
        }

      double tempProfit = 0.0;

      // MAGIA MATEMÁTICA: Usamos el inicio del día exacto del TimeCore
      datetime startOfDay = TimeCore.TodayStart();

      // Consultamos la base de datos del broker con el reloj sintético
      if(HistorySelect(startOfDay, TimeCore.Now()))
        {
         int deals = HistoryDealsTotal();
         for(int i = 0; i < deals; i++)
           {
            ulong dTk = HistoryDealGetTicket(i);
            if(HistoryDealGetInteger(dTk, DEAL_ENTRY) == DEAL_ENTRY_OUT)
              {
               tempProfit += HistoryDealGetDouble(dTk, DEAL_PROFIT) +
                             HistoryDealGetDouble(dTk, DEAL_SWAP) +
                             HistoryDealGetDouble(dTk, DEAL_COMMISSION);
              }
           }
        }

      // Inyectamos el resultado en la RAM
      g_cachedDailyProfit = tempProfit;
     }

// ====================================================================
// HFT CORE ENGINE: EL BUCLE MAESTRO DE 4TA DIMENSIÓN
// ====================================================================
   void              ProcessHFT_Engine()
     {
      ulong start_time = GetMicrosecondCount();
      int memTotal = TradeRAM.Total();
      if(memTotal == 0)
         return;

      bool isAccountLocked = (g_protect.accountLockedUntil > TimeCurrent());

      // ==============================================================
      // 🧠 EL ORÁCULO 2.0: BARRIDO DE API (1 SOLA VEZ POR CICLO)
      // ==============================================================
      UpdateAllMarkets();

      // Traducimos el símbolo del gráfico actual a un número para el Modo Dios
      ushort current_chart_sym_id = GetSymbolID(_Symbol);

      // ==============================================================
      // RADAR DE ALARMAS DE ALTA FRECUENCIA
      // ==============================================================
      if(ArraySize(m_activeAlerts) > 0)
         CheckAlertsFast();

      // ==============================================================
      // ZONA NUCLEAR: EQUITY PROTECT (Evaluación Matemática a 20ms)
      // ==============================================================
      if(g_protect.masterSwitch && !isAccountLocked)
        {
         double floatingPL = AccountInfoDouble(ACCOUNT_PROFIT);
         double sigmaPL    = g_cachedDailyProfit + floatingPL;
         double currentEq  = AccountInfoDouble(ACCOUNT_EQUITY);
         double dropPct    = (g_protect.peakEquity > 0) ? ((g_protect.peakEquity - currentEq) / g_protect.peakEquity) * 100.0 : 0;
         double fltPct     = (g_protect.startBalance > 0) ? (floatingPL / g_protect.startBalance) * 100.0 : 0;

         // Evaluamos pura matemática. Si toca, disparamos la bengala (int) y abortamos el HFT para ganar tiempo.
         if(g_protect.f[0].enabled && currentEq <= g_protect.f[0].configNum)
            g_hft_nuke_signal = 0;
         else
            if(g_protect.f[1].enabled && currentEq >= g_protect.f[1].configNum && g_protect.f[1].configNum > 0)
               g_hft_nuke_signal = 1;
            else
               if(g_protect.f[2].enabled && (g_protect.peakEquity - currentEq) >= g_protect.f[2].configNum && g_protect.f[2].configNum > 0)
                  g_hft_nuke_signal = 2;
               else
                  if(g_protect.f[3].enabled && dropPct >= g_protect.f[3].configNum && g_protect.f[3].configNum > 0)
                     g_hft_nuke_signal = 3;
                  else
                     if(g_protect.f[4].enabled && floatingPL <= g_protect.f[4].configNum && g_protect.f[4].configNum < 0)
                        g_hft_nuke_signal = 4;
                     else
                        if(g_protect.f[5].enabled && fltPct <= g_protect.f[5].configNum && g_protect.f[5].configNum < 0)
                           g_hft_nuke_signal = 5;
                        else
                           if(g_protect.f[6].enabled && floatingPL >= g_protect.f[6].configNum && g_protect.f[6].configNum > 0)
                              g_hft_nuke_signal = 6;
                           else
                              if(g_protect.f[7].enabled && fltPct >= g_protect.f[7].configNum && g_protect.f[7].configNum > 0)
                                 g_hft_nuke_signal = 7;
                              else
                                 if(g_protect.f[8].enabled && sigmaPL >= g_protect.f[8].configNum && g_protect.f[8].configNum > 0)
                                    g_hft_nuke_signal = 8;

         if(g_hft_nuke_signal >= 0)
            return; // 🛑 CORTA EL MOTOR HFT AL INSTANTE. Cero Strings. Cero I/O.
        }


      // ==============================================================
      // ANÁLISIS INDIVIDUAL POR TICKET
      // ==============================================================
      for(int i = 0; i < memTotal; i++)
        {

         CTradeState *mem = TradeRAM.GetByIndex(i);
         if(CheckPointer(mem) == POINTER_INVALID || mem.ticket == 0)
            continue;

         ulong tk = mem.ticket;
         ushort s_id = mem.sym_id; // <--- SACAMOS EL DNI DEL SÍMBOLO

         // 🛡️ EL ESCUDO MULTI-SÍMBOLO: Cero Strings, pura matemática entera (O(1))
         if(!m_manageAllSymbols && s_id != current_chart_sym_id)
            continue;

         // 🛡️ EL ESCUDO MAGIC NUMBER (NUEVO)
         if(!mem.isVirtual && !g_manageAllMagics)
           {
            long t_magic = 0;
            if(PositionSelectByTicket(tk))
               t_magic = PositionGetInteger(POSITION_MAGIC);
            else
               if(OrderSelect(tk))
                  t_magic = OrderGetInteger(ORDER_MAGIC);

            if(t_magic != MAGIC_NUM)
               continue; // Pertenece a otro, ignorar en HFT
           }

         // ==============================================================
         // 1. EL RADAR (FILTRO DE NANOSEGUNDOS EN RAM)
         // ==============================================================
         // Leemos de la RAM del Oráculo, sin tocar SymbolInfoTick ni SymbolSelect
         long tick_time = g_marketDB[s_id].time_msc;

         // Si ESTE trade ya procesó este milisegundo exacto, lo saltamos
         if(tick_time == mem.last_time_msc)
            continue;

         mem.last_time_msc = tick_time; // Actualizamos la memoria

         double bid = g_marketDB[s_id].bid;
         double ask = g_marketDB[s_id].ask;

         double point  = g_marketDB[s_id].point;
         int dig       = g_marketDB[s_id].digits;
         double mul    = g_marketDB[s_id].multiplier;
         double stpLvl = g_marketDB[s_id].stopsLevel;

         g_telemetry_ticks++;

         // 2. RESET DEL COMMAND BUFFER
         mem.cmd_flags = CMD_NONE;

         // --- NUEVO ESCUDO ANTI-BUCLE ---
         // Si la orden virtual ya se disparó y estamos esperando al bróker, la ignoramos.
         if(mem.is_firing)
            continue;

         // 3. OBTENER DATOS 100% DESDE LA RAM (0 Llamadas de red, 0 Lag)
         double entry = 0, sl = 0, tp = 0, vol = 0;
         long type = mem.type;

         if(mem.isVirtual)
           {
            entry = mem.virtEntry;
            sl    = mem.virtSL;
            tp    = mem.virtTP;
            vol   = mem.virtLot;
            type  = mem.virtType;
           }
         else
           {
            // Si es real pero el Oráculo aún no la ha leído, esperamos al próximo tick
            if(mem.openPrice == 0 && mem.currentVol == 0)
               continue;

            entry = mem.openPrice;
            sl    = mem.slPrice;
            tp    = mem.tpPrice;
            vol   = mem.currentVol;
           }

         // Respetamos el modo Oculto en RAM sin usar condicionales pesados
         if(mem.isHiddenActive)
           {
            sl = mem.virtualSL;
            tp = mem.virtualTP;
           }

         if(isAccountLocked)
            continue;

         // ==============================================================
         // A.0 VIRTUAL EXPIRATION (El Francotirador de Tiempo)
         // ==============================================================
         if(mem.isVirtual && mem.virtExpiration > 0)
           {
            // 1 ciclo de reloj para comparar enteros de 64 bits. Cero Lag.
            if(TimeCurrent() >= mem.virtExpiration)
              {
               // Marcamos para aniquilación y dejamos que el bloque Z (Ejecutor) haga su trabajo.
               mem.cmd_flags |= CMD_CLOSE_FULL;
              }
           }

         // ==============================================================
         // A. PRICE CANCELLATION
         // ==============================================================
         if(mem.cancelPrice > 0)
           {
            double cp = mem.cancelPrice;
            bool hitCancel = false;
            if(type == ORDER_TYPE_BUY_LIMIT && ask >= cp)
               hitCancel = true;
            if(type == ORDER_TYPE_SELL_LIMIT && bid <= cp)
               hitCancel = true;
            if(type == ORDER_TYPE_BUY_STOP && bid <= cp)
               hitCancel = true;
            if(type == ORDER_TYPE_SELL_STOP && ask >= cp)
               hitCancel = true;
            if(type == ORDER_TYPE_BUY_STOP_LIMIT && ask >= cp)
               hitCancel = true;
            if(type == ORDER_TYPE_SELL_STOP_LIMIT && bid <= cp)
               hitCancel = true;

            if(hitCancel)
               mem.cmd_flags |= CMD_CLOSE_FULL;
           }

         // ==============================================================
         // B. VIRTUAL TRIGGERS (Virtual Orders & Stop Limits)
         // ==============================================================
         if(mem.isVirtual && (type == ORDER_TYPE_BUY_STOP || type == ORDER_TYPE_SELL_STOP || type == ORDER_TYPE_BUY_LIMIT || type == ORDER_TYPE_SELL_LIMIT || type == ORDER_TYPE_BUY_STOP_LIMIT || type == ORDER_TYPE_SELL_STOP_LIMIT))
           {
            double triggerPrice = 0;
            int pMode = mem.virtPriceMode;
            if(pMode == 0)
               triggerPrice = (type == ORDER_TYPE_BUY_STOP || type == ORDER_TYPE_BUY_LIMIT || type == ORDER_TYPE_BUY_STOP_LIMIT) ? ask : bid;
            else
               if(pMode == 1)
                  triggerPrice = ask;
               else
                  if(pMode == 2)
                     triggerPrice = bid;

            bool triggered = false;
            double triggerTarget = mem.virtStopLimit;

            if(type == ORDER_TYPE_BUY_STOP && triggerPrice >= entry)
               triggered = true;
            if(type == ORDER_TYPE_SELL_STOP && triggerPrice <= entry)
               triggered = true;
            if(type == ORDER_TYPE_BUY_LIMIT && triggerPrice <= entry)
               triggered = true;
            if(type == ORDER_TYPE_SELL_LIMIT && triggerPrice >= entry)
               triggered = true;
            if(type == ORDER_TYPE_BUY_STOP_LIMIT && triggerPrice >= triggerTarget)
               triggered = true;
            if(type == ORDER_TYPE_SELL_STOP_LIMIT && triggerPrice <= triggerTarget)
               triggered = true;

            if(triggered)
              {
               mem.cmd_flags |= CMD_FIRE_VIRTUAL;
               // --- LOG & SOUND: VIRTUAL EXECUTION ---
               PrintFormat("[Virtual Engine] Pending order #%I64u triggered at %.5f. Sending market order to broker...", tk, triggerPrice);
               PlaySound("expert.wav");
               // --------------------------------------
              }
           }

         // ==============================================================
         // C. GRID (Cierres Parciales - El Espejismo del Spread aplicado)
         // ==============================================================
         if((type == POSITION_TYPE_BUY || type == POSITION_TYPE_SELL) && vol > 0)
           {
            int activeTP = 0, activeSL = 0;
            if(mem.grid.distMode == 3)
              {
               for(int k=0; k<5; k++)
                 {
                  if(mem.grid.rows[k].isActiveTP)
                     activeTP++;
                  if(mem.grid.rows[k].isActiveSL)
                     activeSL++;
                 }
              }

            int rankTP = 0, rankSL = 0;
            for(int k=0; k<5; k++)
              {
               // Evaluar TPs
               if(mem.grid.rows[k].isActiveTP)
                 {
                  rankTP++;
                  double target = GetGridLevelPrice(tk, k+1, 1, mem.grid.distMode, entry, sl, tp, activeTP, rankTP);
                  bool hit = false;
                  if(target > 0)
                    {
                     if(type == POSITION_TYPE_BUY && bid >= target)
                        hit = true;
                     if(type == POSITION_TYPE_SELL && ask <= target) // <--- CORRECCIÓN ASK
                        hit = true;
                    }
                  if(hit)
                    {
                     mem.cmd_target_vol = CalculateGridVolume(tk, k+1, 1, mem.grid.lotMode, vol);
                     if(mem.cmd_target_vol >= vol - 0.001)
                        mem.cmd_flags |= CMD_CLOSE_FULL;
                     else
                        mem.cmd_flags |= CMD_CLOSE_PART;

                     mem.cmd_comment = "TP_" + IntegerToString(k+1); // Pasamos el ID para borrarlo luego
                     break; // 1 disparo por tick
                    }
                 }
               // Evaluar SLs
               if(mem.grid.rows[k].isActiveSL)
                 {
                  rankSL++;
                  double target = GetGridLevelPrice(tk, k+1, 2, mem.grid.distMode, entry, sl, tp, activeSL, rankSL);
                  bool hit = false;
                  if(target > 0)
                    {
                     if(type == POSITION_TYPE_BUY && bid <= target)
                        hit = true;
                     if(type == POSITION_TYPE_SELL && ask >= target)
                        hit = true;
                    }
                  if(hit)
                    {
                     mem.cmd_target_vol = CalculateGridVolume(tk, k+1, 2, mem.grid.lotMode, vol);
                     if(mem.cmd_target_vol >= vol - 0.001)
                        mem.cmd_flags |= CMD_CLOSE_FULL;
                     else
                        mem.cmd_flags |= CMD_CLOSE_PART;

                     mem.cmd_comment = "SL_" + IntegerToString(k+1); // Pasamos el ID
                     break; // 1 disparo por tick
                    }
                 }
              }
           }

         // ==============================================================
         // D. TRAILING ORDER LIMIT (Persiguiendo el precio - Nivel Institucional)
         // ==============================================================
         if(mem.isTrailLimitActive && (type >= ORDER_TYPE_BUY_LIMIT && type <= ORDER_TYPE_SELL_STOP))
           {
            // 1. Calculamos la distancia segura mínima (100% RAM Driven)
            double currentSpreadPrice = ask - bid;
            double min_safe_dist = 0;

            // Si la orden es Real y está en el bróker, nos regimos por sus reglas
            if(!mem.isVirtual)
              {
               min_safe_dist = MathMax(stpLvl, currentSpreadPrice); // CERO Pips forzados, puro límite matemático
              }

            // 2. Tomamos la distancia que eligió el usuario, auto-corregida al límite físico
            double user_dist = mem.trailLimitDist * mul;
            double final_dist = MathMax(user_dist, min_safe_dist);

            double watchPrice = mem.isVirtual ? ask : ((type == ORDER_TYPE_BUY_LIMIT || type == ORDER_TYPE_BUY_STOP) ? ask : bid);
            double newPrice = 0;
            bool moveLimit = false;

            // 3. UMBRAL ANTI-SPAM
            double spam_threshold = MathMax(stpLvl, 10 * point);

            if(type == ORDER_TYPE_BUY_LIMIT)
              {
               double target = watchPrice - final_dist;
               if(target > entry && (target - entry) >= spam_threshold)
                 {
                  newPrice = target;
                  moveLimit = true;
                 }
              }
            else
               if(type == ORDER_TYPE_SELL_LIMIT)
                 {
                  double target = watchPrice + final_dist;
                  if(target < entry && (entry - target) >= spam_threshold)
                    {
                     newPrice = target;
                     moveLimit = true;
                    }
                 }
               else
                  if(type == ORDER_TYPE_BUY_STOP)
                    {
                     double target = watchPrice + final_dist;
                     if(target < entry && (entry - target) >= spam_threshold)
                       {
                        newPrice = target;
                        moveLimit = true;
                       }
                    }
                  else
                     if(type == ORDER_TYPE_SELL_STOP)
                       {
                        double target = watchPrice - final_dist;
                        if(target > entry && (target - entry) >= spam_threshold)
                          {
                           newPrice = target;
                           moveLimit = true;
                          }
                       }

            // 4. Inyección al Motor de Comandos
            if(moveLimit)
              {
               mem.cmd_flags |= CMD_MODIFY_PRICE;
               mem.cmd_target_price = NormalizeDouble(newPrice, dig);
              }
           }

         // ==============================================================
         // E. TRAILING STOP & BREAK EVEN (Lógica Institucional Preventiva)
         // ==============================================================
         if(mem.ts.isActive && (type == POSITION_TYPE_BUY || type == POSITION_TYPE_SELL))
           {
            double old_anchor = mem.ts.anchorPrice; // 1. Guardamos memoria del ancla

            TS_Calculation tsCalc = CalculateTSLevels(tk);

            // 2. Si el precio empujó el ancla del TS, avisamos al pintor de inmediato
            if(mem.ts.anchorPrice != old_anchor)
              {
               SaveTradesToBin(); // Persistimos en disco
               g_needsRedraw = true; // ¡Bandera sucia encendida!
              }

            if(tsCalc.isValid && tsCalc.isActive && tsCalc.targetPrice > 0)
              {
               double finalSL = NormalizeDouble(tsCalc.targetPrice, dig);
               bool isBuy = (type == POSITION_TYPE_BUY);
               double currentPrice = isBuy ? bid : ask;
               bool shouldMove = false;

               // 🛡️ EL ESCUDO DE MANIOBRA PREVENTIVO
               if(!mem.isHiddenActive) // SI ES REAL (El bróker manda)
                 {
                  double currentSpreadPrice = ask - bid;
                  // Distancia segura estricta (Sin "10 * point" de lag visual)
                  double safe_distance = MathMax(stpLvl, currentSpreadPrice);

                  if(isBuy)
                    {
                     double max_allowed_sl = currentPrice - safe_distance;
                     // Si la línea azul choca con la pared del bróker, nos pegamos a la pared
                     if(finalSL > max_allowed_sl)
                       {
                        finalSL = NormalizeDouble(max_allowed_sl, dig);
                       }
                    }
                  else // SELL
                    {
                     double min_allowed_sl = currentPrice + safe_distance;
                     // Si la línea azul choca con la pared del bróker, nos pegamos a la pared
                     if(finalSL < min_allowed_sl)
                       {
                        finalSL = NormalizeDouble(min_allowed_sl, dig);
                       }
                    }
                 }
               // Si es Virtual (isHiddenActive == true), ignoramos el escudo y finalSL se queda exactamente en la línea azul.

               // 2. Regla de Oro: JAMÁS alejar el SL. Y debe mejorar al menos 1 punto para no hacer spam.
               if(isBuy)
                 {
                  if((sl == 0 || finalSL > sl) && MathAbs(finalSL - sl) >= point)
                     shouldMove = true;
                 }
               else
                 {
                  if((sl == 0 || finalSL < sl) && MathAbs(finalSL - sl) >= point)
                     shouldMove = true;
                 }

               if(shouldMove)
                 {
                  mem.cmd_flags |= CMD_MODIFY_SL;
                  mem.cmd_target_sl = finalSL;
                  mem.cmd_target_tp = tp;
                 }
              }
           }

         // ==============================================================
         // E.2 BREAK EVEN (Lógica Institucional Preventiva y Persistente)
         // ==============================================================
         if(mem.be.isActive && (type == POSITION_TYPE_BUY || type == POSITION_TYPE_SELL))
           {
            double currentPrice = (type == POSITION_TYPE_BUY) ? bid : ask;
            double startPrice = GetBELevelPrice(tk, 0, entry);

            bool beTriggered = false;
            if(type == POSITION_TYPE_BUY && currentPrice >= startPrice)
               beTriggered = true;
            if(type == POSITION_TYPE_SELL && currentPrice <= startPrice)
               beTriggered = true;

            // 🔬 MICROSCOPIO 1: Estado Inicial
            if(MathAbs(currentPrice - startPrice) < (20 * point))
              {
               //PrintFormat(">>> [BE DEBUG 1] Tk: %d | Tipo: %s | Entry: %f | Precio Actual: %f | Gatillo (Start): %f | ¿Tocado?: %s",
               //tk, (type == POSITION_TYPE_BUY) ? "BUY" : "SELL", entry, currentPrice, startPrice, beTriggered ? "SI" : "NO");
              }

            // ⚠️ CAMBIO CRÍTICO: Eliminamos el MathAbs defectuoso
            if(beTriggered && startPrice > 0)
              {
               // 1. Calculamos la Meta Final del Break Even
               double targetBE = mem.be.isAuto ? ((type == POSITION_TYPE_BUY) ? entry + GetAutoBEPoints(tk) : entry - GetAutoBEPoints(tk)) : CalculateBEOffset(tk, type, entry);
               targetBE = NormalizeDouble(targetBE, dig);

               bool isBuy = (type == POSITION_TYPE_BUY);
               double finalSL = targetBE;
               bool isBetter = false;
               bool fullyReached = true;

               double safe_distance = 0;
               double limit_allowed_sl = 0;

               // 🛡️ EL ESCUDO DE MANIOBRA PARA BREAK EVEN
               if(!mem.isHiddenActive) // SI ES REAL
                 {
                  double currentSpreadPrice = ask - bid;
                  safe_distance = MathMax(stpLvl, currentSpreadPrice);

                  if(isBuy)
                    {
                     limit_allowed_sl = currentPrice - safe_distance;
                     if(finalSL > limit_allowed_sl)
                       {
                        finalSL = NormalizeDouble(limit_allowed_sl, dig);
                        fullyReached = false;
                       }
                     isBetter = (sl == 0 || finalSL > sl);
                    }
                  else // SELL
                    {
                     limit_allowed_sl = currentPrice + safe_distance;
                     if(finalSL < limit_allowed_sl)
                       {
                        finalSL = NormalizeDouble(limit_allowed_sl, dig);
                        fullyReached = false;
                       }
                     isBetter = (sl == 0 || finalSL < sl);
                    }
                 }
               else // SI ES VIRTUAL
                 {
                  if(isBuy)
                     isBetter = (sl == 0 || finalSL > sl);
                  else
                     isBetter = (sl == 0 || finalSL < sl);
                  fullyReached = true;
                 }

               // 🔬 MICROSCOPIO 2: Evaluación Matemática
               //PrintFormat(">>> [BE DEBUG 2] Meta BE: %f | Límite Broker: %f | SL Final Recortado: %f",
               //targetBE, limit_allowed_sl, finalSL);

               //PrintFormat(">>> [BE DEBUG 3] isBetter: %s | fullyReached: %s | Distancia al SL actual: %f pts",
               // isBetter ? "TRUE" : "FALSE", fullyReached ? "TRUE" : "FALSE", MathAbs(finalSL - sl)/point);

               // 2. Ejecutar si la mejora es de al menos 1 punto
               if(isBetter && MathAbs(finalSL - sl) >= point)
                 {
                  if(!(mem.cmd_flags & CMD_MODIFY_SL))
                    {
                     //Print(">>> [BE DEBUG 4] ¡Gatillo accionado! Enviando nuevo SL: ", finalSL);
                     mem.cmd_flags |= CMD_MODIFY_SL;
                     mem.cmd_target_sl = finalSL;
                     mem.cmd_target_tp = tp;

                     if(fullyReached)
                       {
                        mem.be.isActive = false;
                        SaveTradesToBin();    // ¡CRÍTICO! Guardar que se apagó
                        g_needsRedraw = true; // Avisar al pintor que borre la línea naranja
                       }
                    }
                  else
                    {
                     //Print(">>> [BE DEBUG 4.1] Modificación ignorada. El Trailing Stop u otra función ya había pedido mover el SL en este tick.");
                    }
                 }
               else
                 {
                  //Print(">>> [BE DEBUG 6] ABORTADO. isBetter = false, o el SL no mejora lo suficiente.");
                 }
              }
           }

         // ==============================================================
         // F. HIDDEN TP/SL (Ceguera del Bróker: Posiciones Reales)
         // ==============================================================
         if(mem.isHiddenActive && !mem.isVirtual && (type == POSITION_TYPE_BUY || type == POSITION_TYPE_SELL))
           {
            bool hitHidden = false;

            // Las COMPRAS se cierran mirando el BID. Las VENTAS mirando el ASK.
            if(mem.virtualTP > 0)
              {
               if(type == POSITION_TYPE_BUY && bid >= mem.virtualTP)
                  hitHidden = true;
               if(type == POSITION_TYPE_SELL && ask <= mem.virtualTP)
                  hitHidden = true;
              }
            if(mem.virtualSL > 0)
              {
               if(type == POSITION_TYPE_BUY && bid <= mem.virtualSL)
                  hitHidden = true;
               if(type == POSITION_TYPE_SELL && ask >= mem.virtualSL)
                  hitHidden = true;
              }

            if(hitHidden)
               mem.cmd_flags |= CMD_CLOSE_FULL;
           }

         // ==============================================================
         // Z. EL FRANCOTIRADOR (Ejecutor Final Asíncrono)
         // ==============================================================
         if(mem.cmd_flags != CMD_NONE)
           {
            ExecuteHFTCommands(mem);
           }
        }
      DispatchAsyncQueue();

      ulong end_time = GetMicrosecondCount();   // ⏱️ DETIENE EL CRONÓMETRO

      // Sumamos el tiempo que tardó y contamos una vuelta más
      g_hft_total_micro_time += (end_time - start_time);
      g_hft_loops_count++;
     }

// ====================================================================
// MOTOR HFT: EL EJECUTOR ASÍNCRONO (Escudo Implacable Corrección MT5)
// ====================================================================
   struct SAntiSpam { ulong ticket; double sl; double tp; uint last_time; };
   SAntiSpam         g_spamShield[];

// ====================================================================
// MOTOR HFT: EL EJECUTOR ASÍNCRONO (Escudo Implacable)
// ====================================================================
   void              ExecuteHFTCommands(CTradeState *mem)
     {
      if(mem == NULL)
         return;
      ulong tk = mem.ticket;

      // --- EL PERRO GUARDIÁN (WATCHDOG & ANTI-SPAM) ---
      uint now = GetTickCount();
      if(mem.async_is_waiting)
        {
         // Si llevamos más de 2000ms (2 segundos) esperando al bróker... ¡Se cayó la conexión o perdimos el paquete!
         if(now - mem.async_last_time > 2000)
           {
            //Print(">>> [WATCHDOG] Timeout superado para el Ticket #", tk, ". Forzando desbloqueo asíncrono.");
            mem.async_is_waiting = false;
           }
         else
           {
            // Si llevamos menos de 2 segundos, seguimos esperando. ¡No dispares, sería Spam!
            return;
           }
        }

      // Llenar variables básicas
      string sym = mem.symbol;
      int dig = g_marketDB[mem.sym_id].digits;
      double point = g_marketDB[mem.sym_id].point;

      // 1. CIERRE TOTAL O CANCELACIÓN DE PRECIO
      if((mem.cmd_flags & CMD_CLOSE_FULL) != 0)
        {
         if(mem.isVirtual)
           {
            mem.isVirtual = false;
            mem.cancelPrice = 0.0;
            DeleteVirtualOrderData(tk);

           }
         else
           {
            // --- DISPARO ASÍNCRONO ---
            if(OrderSelect(tk))
              {
               // Es una orden pendiente
               MqlTradeRequest req;
               MqlTradeResult res;
               ZeroMemory(req);
               ZeroMemory(res);
               req.action = TRADE_ACTION_REMOVE;
               req.order = tk;

               PushAsyncRequest(req, tk);
              }
            else
               if(PositionSelectByTicket(tk))
                 {
                  // Es una posición abierta
                  MqlTradeRequest req;
                  MqlTradeResult res;
                  ZeroMemory(req);
                  ZeroMemory(res);
                  req.action = TRADE_ACTION_DEAL;
                  req.position = tk;
                  req.symbol = sym;
                  req.volume = PositionGetDouble(POSITION_VOLUME);
                  req.type = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY) ? ORDER_TYPE_SELL : ORDER_TYPE_BUY;
                  req.price = (req.type == ORDER_TYPE_SELL) ? SymbolInfoDouble(sym, SYMBOL_BID) : SymbolInfoDouble(sym, SYMBOL_ASK);
                  req.deviation = 20;
                  req.magic = MAGIC_NUM;
                  
                  long fill = SymbolInfoInteger(sym, SYMBOL_FILLING_MODE);
                  req.type_filling = ((fill & SYMBOL_FILLING_FOK) != 0) ? ORDER_FILLING_FOK : (((fill & SYMBOL_FILLING_IOC) != 0) ? ORDER_FILLING_IOC : ORDER_FILLING_RETURN);

                  PushAsyncRequest(req, tk);
                 }

            mem.cancelPrice = 0.0;
            SaveTradesToBin();
           }
         return;
        }

      // 2. CIERRE PARCIAL (GRID)
      if((mem.cmd_flags & CMD_CLOSE_PART) != 0)
        {
         if(!mem.isVirtual && PositionSelectByTicket(tk))
           {
            MqlTradeRequest req;
            MqlTradeResult res;
            ZeroMemory(req);
            ZeroMemory(res);
            req.action = TRADE_ACTION_DEAL;
            req.position = tk;
            req.symbol = sym;
            req.volume = mem.cmd_target_vol; // El volumen parcial que calculó el HFT
            req.type = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY) ? ORDER_TYPE_SELL : ORDER_TYPE_BUY;
            req.price = (req.type == ORDER_TYPE_SELL) ? SymbolInfoDouble(sym, SYMBOL_BID) : SymbolInfoDouble(sym, SYMBOL_ASK);
            req.deviation = 20;
            req.magic = MAGIC_NUM;
            
            long fill = SymbolInfoInteger(sym, SYMBOL_FILLING_MODE);
            req.type_filling = ((fill & SYMBOL_FILLING_FOK) != 0) ? ORDER_FILLING_FOK : (((fill & SYMBOL_FILLING_IOC) != 0) ? ORDER_FILLING_IOC : ORDER_FILLING_RETURN);

            // --- DISPARO ENCOLADO (ASÍNCRONO) ---
            PushAsyncRequest(req, tk);

            // Predicción de Estado (Optimistic UI): Actualizamos la RAM al instante
            string rowID = StringSubstr(mem.cmd_comment, 3);
            int rIdx = (int)StringToInteger(rowID) - 1;
            if(rIdx >= 0 && rIdx < 5)
              {
               if(StringFind(mem.cmd_comment, "TP") == 0)
                  mem.grid.rows[rIdx].isActiveTP = false;
               else
                  mem.grid.rows[rIdx].isActiveSL = false;
               SaveTradesToBin();
               g_needsRedraw = true;
              }
           }
         return;
        }

      // 3. MOVER PRECIO DE ENTRADA (Trailing Order Limit)
      if((mem.cmd_flags & CMD_MODIFY_PRICE) != 0)
        {
         if(mem.isVirtual)
           {
            // Delta para órdenes Virtuales (100% RAM)
            double delta = mem.cmd_target_price - mem.virtEntry;
            mem.virtEntry = mem.cmd_target_price;

            if(mem.virtSL > 0)
               mem.virtSL = NormalizeDouble(mem.virtSL + delta, dig);
            if(mem.virtTP > 0)
               mem.virtTP = NormalizeDouble(mem.virtTP + delta, dig);

            if(mem.isHiddenActive)
              {
               if(mem.virtualSL > 0)
                  mem.virtualSL = NormalizeDouble(mem.virtualSL + delta, dig);
               if(mem.virtualTP > 0)
                  mem.virtualTP = NormalizeDouble(mem.virtualTP + delta, dig);
              }
            SaveVirtualOrder(tk);
           }
         else
           {
            // Delta para órdenes Reales
            if(OrderSelect(tk))
              {
               double oldEntry = OrderGetDouble(ORDER_PRICE_OPEN);
               double delta = mem.cmd_target_price - oldEntry; // ¡Cálculo correcto!

               double oldSL = OrderGetDouble(ORDER_SL);
               double oldTP = OrderGetDouble(ORDER_TP);

               MqlTradeRequest req;
               MqlTradeResult res;
               ZeroMemory(req);
               ZeroMemory(res);

               req.action       = TRADE_ACTION_MODIFY;
               req.order        = tk;
               req.price        = mem.cmd_target_price;
               req.sl           = (oldSL > 0) ? NormalizeDouble(oldSL + delta, dig) : 0;
               req.tp           = (oldTP > 0) ? NormalizeDouble(oldTP + delta, dig) : 0;
               req.stoplimit    = OrderGetDouble(ORDER_PRICE_STOPLIMIT);
               req.type_time    = (ENUM_ORDER_TYPE_TIME)OrderGetInteger(ORDER_TYPE_TIME);
               req.expiration   = (datetime)OrderGetInteger(ORDER_TIME_EXPIRATION);

               PushAsyncRequest(req, tk); // Enviar a la cola asíncrona

               // --- INYECCIÓN OPTIMISTIC UI ---
               mem.openPrice = mem.cmd_target_price;
               g_needsRedraw = true;
              }
           }
         return;
        }

      // ==============================================================
      // 4. DISPARO DE ÓRDENES VIRTUALES A MERCADO
      // ==============================================================
      if((mem.cmd_flags & CMD_FIRE_VIRTUAL) != 0)
        {
         mem.is_firing = true; // El candado original

         if(mem.virtType == ORDER_TYPE_BUY_STOP_LIMIT || mem.virtType == ORDER_TYPE_SELL_STOP_LIMIT)
           {
            // MUTACIÓN: De Stop Limit a Limit
            mem.virtType = (mem.virtType == ORDER_TYPE_BUY_STOP_LIMIT) ? ORDER_TYPE_BUY_LIMIT : ORDER_TYPE_SELL_LIMIT;
            mem.virtStopLimit = 0; // Se consumió el gatillo

            mem.is_firing = false; // Liberar el candado para que el HFT la lea como Limit en el próximo tick

            SaveVirtualOrder(tk);


            // --- CORRECCIÓN ARQUITECTÓNICA 1: ELIMINADO EL OCO AQUÍ ---
            // La orden virtual retiene mem.isOCO = true en su RAM automáticamente.
            // El OCO se disparará de verdad cuando esta nueva Limit toque el precio y se vuelva posición a mercado.

            // --- CORRECCIÓN ARQUITECTÓNICA 2: DELEGACIÓN DE UI (ANTI-CRASH) ---
            // Prohibido llamar a UpdateOpenTradesVisuals() o ChartRedraw() dentro del bucle HFT.
            // Delegamos el trabajo de repintado y limpieza al OnTimer encendiendo la bandera "sucia".
            g_needsRedraw = true;
           }
         else
           {
            double v_sl = mem.isHiddenActive ? 0 : mem.virtSL;
            double v_tp = mem.isHiddenActive ? 0 : mem.virtTP;

            MqlTradeRequest req;
            MqlTradeResult res;
            ZeroMemory(req);
            ZeroMemory(res);
            req.action = TRADE_ACTION_DEAL;
            req.symbol = sym;
            req.volume = mem.virtLot;
            req.type = (mem.virtType == ORDER_TYPE_BUY_STOP || mem.virtType == ORDER_TYPE_BUY_LIMIT) ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
            req.price = (req.type == ORDER_TYPE_BUY) ? SymbolInfoDouble(sym, SYMBOL_ASK) : SymbolInfoDouble(sym, SYMBOL_BID);
            req.sl = v_sl;
            req.tp = v_tp;
            req.deviation = 20;
            req.magic = MAGIC_NUM;
            req.comment = mem.virtComment;
            
            long fill = SymbolInfoInteger(sym, SYMBOL_FILLING_MODE);
            req.type_filling = ((fill & SYMBOL_FILLING_FOK) != 0) ? ORDER_FILLING_FOK : (((fill & SYMBOL_FILLING_IOC) != 0) ? ORDER_FILLING_IOC : ORDER_FILLING_RETURN);

            // --- CORRECCIÓN DEL MAPEO ASÍNCRONO ---
            PushAsyncRequest(req, 0, tk, ASYNC_PLACE_BASE);
           }
         return;
        }

      /// 5. MODIFICACIÓN DE SL/TP (TRAILING STOP & BREAK EVEN)
      if((mem.cmd_flags & CMD_MODIFY_SL) != 0 || (mem.cmd_flags & CMD_MODIFY_TP) != 0)
        {
         // --- DEBUG 2: EJECUCIÓN ---
         //PrintFormat(">>> [DEBUG TS 2] Ejecutando CMD_MODIFY_SL Tk: %d | async_waiting: %s | Hide: %s",
         //tk, mem.async_is_waiting ? "TRUE" : "FALSE", mem.isHiddenActive ? "ON" : "OFF");
         if(mem.isHiddenActive)
           {
            if((mem.cmd_flags & CMD_MODIFY_SL) != 0)
               mem.virtualSL = mem.cmd_target_sl;
            if((mem.cmd_flags & CMD_MODIFY_TP) != 0)
               mem.virtualTP = mem.cmd_target_tp;

            // --- INYECCIÓN: SINCRONIZACIÓN VISUAL Y DISCO (CERO LAG) ---
            SaveTradesToBin();

            g_needsRedraw = true; // <--- ENCENDEMOS LA BANDERA (El OnTimer se encargará)
           }
         else
           {
            // --- DISPARO ASÍNCRONO REAL ---
            // --- DISPARO ASÍNCRONO ---
            if(PositionSelectByTicket(tk))
              {
               MqlTradeRequest req;
               MqlTradeResult res;
               ZeroMemory(req);
               ZeroMemory(res);
               req.action = TRADE_ACTION_SLTP;
               req.position = tk;
               req.sl = mem.cmd_target_sl;
               req.tp = mem.cmd_target_tp;

               PushAsyncRequest(req, tk);
               // --- INYECCIÓN OPTIMISTIC UI: MENTIR A LA RAM AL INSTANTE ---
               if((mem.cmd_flags & CMD_MODIFY_SL) != 0)
                  mem.slPrice = mem.cmd_target_sl;
               if((mem.cmd_flags & CMD_MODIFY_TP) != 0)
                  mem.tpPrice = mem.cmd_target_tp;
               g_needsRedraw = true; // Fuerzo el repintado a 120 FPS
              }
            else
               if(OrderSelect(tk))
                 {
                  MqlTradeRequest req;
                  MqlTradeResult res;
                  ZeroMemory(req);
                  ZeroMemory(res);
                  // ... (tu código prepara la petición)
                  req.expiration = (datetime)OrderGetInteger(ORDER_TIME_EXPIRATION);

                  PushAsyncRequest(req, tk);

                  // --- INYECCIÓN OPTIMISTIC UI ---
                  if((mem.cmd_flags & CMD_MODIFY_SL) != 0)
                     mem.slPrice = mem.cmd_target_sl;
                  if((mem.cmd_flags & CMD_MODIFY_TP) != 0)
                     mem.tpPrice = mem.cmd_target_tp;
                  g_needsRedraw = true;
                 }
           }
        }
     }

//+------------------------------------------------------------------+
//| NUEVO: HUD DE ESTADOS INSTITUCIONAL (Cero Carga)                 |
//+------------------------------------------------------------------+
   void DrawStatusHUD(CUIEngine &eng, int w, int startY)
     {
      // Línea separadora sutil superior
      eng.AddPanel(10, startY, w - 20, 1, Theme.border, 0);

      int yRow1 = startY + 7;
      int yRow2 = startY + 25;

      // Determinamos el estado del Grid leyendo directo de la memoria RAM
      bool isGrid = false;
      if(TemplateState != NULL)
        {
         for(int i=0; i<5; i++)
           {
            if(TemplateState.grid.rows[i].isActiveTP || TemplateState.grid.rows[i].isActiveSL)
              {
               isGrid = true;
               break;
              }
           }
        }

      // Mapeo lógico de los 8 estados (ON/OFF)
      bool st[8] = { m_isTSActive, m_isBEActive, isGrid, m_isSplitActive,
                     m_isHideActive, m_isOCOActive, m_isVirtActive, g_protect.masterSwitch
                   };

      // Textos limpios y abreviados
      string txt[8] = { "TS", "BE", "GRID", "SPLIT",
                        "HIDE", "OCO", "VIRT", "PROT"
                      };

      // Coordenadas X para 4 columnas perfectamente centradas (Ancho 280px)
      int cX[4] = { 45, 105, 175, 235 };

      // --- FILA 1: TS | BE | GRID | SPLIT ---
      for(int i=0; i<4; i++)
        {
         uint colorTxt = st[i] ? Theme.accent : Theme.textDim;
         eng.AddLabel(txt[i], cX[i], yRow1, "Arial Black", 13, colorTxt, TA_CENTER|TA_TOP);
        }

      // --- FILA 2: HIDE | OCO | VIRT | PROT ---
      for(int i=4; i<8; i++)
        {
         uint colorTxt = Theme.textDim;
         if(st[i])
           {
            // Si es el índice 7 (PROT), usamos rojo (Theme.sell), si no, naranja (Theme.accent)
            colorTxt = (i == 7) ? Theme.sell : Theme.accent;
           }
         eng.AddLabel(txt[i], cX[i-4], yRow2, "Arial Black", 13, colorTxt, TA_CENTER|TA_TOP);
        }

      // El detalle visual elegante: Separador entre GRID y SPLIT
      eng.AddLabel("|", 205, yRow1 - 1, "Arial", 12, Theme.border, TA_CENTER|TA_TOP);
     }

//+------------------------------------------------------------------+
//| ORÁCULO: Sincroniza la RAM con la base de datos del Bróker       |
//+------------------------------------------------------------------+
   void              SyncAccountToMemory()
     {
      bool hasNewOrphans = false;

      // 1. Escanear todas las Posiciones Abiertas en toda la cuenta
      for(int i = 0; i < PositionsTotal(); i++)
        {
         ulong tk = PositionGetTicket(i);
         if(tk > 0)
           {
            // Al llamar a GetTradeMemory, si el ticket no existe en nuestra RAM,
            // la función lo crea, le pregunta el símbolo al broker y lo guarda.
            CTradeState *mem = TradeRAM.Get(tk);
            if(mem != NULL && mem.panelX == -1) // Si es totalmente nuevo y no tiene posición X
               hasNewOrphans = true;
           }
        }

      // 2. Escanear todas las Órdenes Pendientes en toda la cuenta
      for(int i = 0; i < OrdersTotal(); i++)
        {
         ulong tk = OrderGetTicket(i);
         if(tk > 0)
           {
            CTradeState *mem = TradeRAM.Get(tk);
            if(mem != NULL && mem.panelX == -1)
               hasNewOrphans = true;
           }
        }

      // 3. Si descubrimos operaciones nuevas (ej: abiertas desde el celular),
      // forzamos un volcado al disco duro para asegurar que no se pierdan.
      if(hasNewOrphans)
         SaveTradesToBin();
     }

//+------------------------------------------------------------------+
//| EL ORÁCULO: Sincroniza la RAM con la realidad del Bróker         |
//+------------------------------------------------------------------+
   void              SyncTradeWithBroker(CTradeState *mem)
     {
      if(CheckPointer(mem) == POINTER_INVALID || mem.ticket == 0 || mem.isVirtual)
         return;

      if(PositionSelectByTicket(mem.ticket))
        {
         mem.openPrice  = PositionGetDouble(POSITION_PRICE_OPEN);
         mem.slPrice    = PositionGetDouble(POSITION_SL);
         mem.tpPrice    = PositionGetDouble(POSITION_TP);
         mem.currentVol = PositionGetDouble(POSITION_VOLUME);
         mem.type       = PositionGetInteger(POSITION_TYPE);

         // --- CÁLCULO PESADO SOLO CUANDO EL ORÁCULO SE ACTUALIZA ---
         long pos_id = PositionGetInteger(POSITION_IDENTIFIER);
         double total_comm = 0.0;
         if(HistorySelectByPosition(pos_id))
           {
            int deals = HistoryDealsTotal();
            for(int i = 0; i < deals; i++)
              {
               ulong deal_ticket = HistoryDealGetTicket(i);
               if(deal_ticket > 0)
                  total_comm += HistoryDealGetDouble(deal_ticket, DEAL_COMMISSION);
              }
           }
         mem.currentComm = total_comm; // Guardamos en la RAM
        }
      else
         if(OrderSelect(mem.ticket))
           {
            mem.type = OrderGetInteger(ORDER_TYPE);

            // La magia inversa para Stop Limits
            if(mem.type == ORDER_TYPE_BUY_STOP_LIMIT || mem.type == ORDER_TYPE_SELL_STOP_LIMIT)
               mem.openPrice = OrderGetDouble(ORDER_PRICE_STOPLIMIT);
            else
               mem.openPrice = OrderGetDouble(ORDER_PRICE_OPEN);

            mem.slPrice    = OrderGetDouble(ORDER_SL);
            mem.tpPrice    = OrderGetDouble(ORDER_TP);
            mem.currentVol = OrderGetDouble(ORDER_VOLUME_CURRENT);
           }
     }


   ulong g_hft_total_micro_time = 0; // Tiempo total acumulado
   ulong g_hft_loops_count      = 0; // Cuántas vueltas dio el motor
//+------------------------------------------------------------------+
//| 📊 TELEMETRÍA HFT: Monitor de Signos Vitales (Solo Debug)        |
//+------------------------------------------------------------------+
   void              PrintTelemetry()
     {
      int memTotal = TradeRAM.Total();
      int realCount = 0, virtCount = 0, syncedCount = 0;

      for(int i = 0; i < memTotal; i++)
        {
         CTradeState *mem = TradeRAM.GetByIndex(i);
         if(CheckPointer(mem) == POINTER_INVALID || mem.ticket == 0)
            continue;

         if(mem.isVirtual)
            virtCount++;
         else
            realCount++;
         if(mem.openPrice > 0 || mem.isVirtual)
            syncedCount++;
        }

      int brokerPos = PositionsTotal();
      int brokerOrd = OrdersTotal();

      // --- MATEMÁTICAS DEL ODÓMETRO ---
      double avg_micro_per_loop = 0;
      if(g_hft_loops_count > 0)
         avg_micro_per_loop = (double)g_hft_total_micro_time / (double)g_hft_loops_count;

      //3. Imprimir el Reporte con Rendimiento
      Print("=================================================");
      PrintFormat("[RENDIMIENTO]  Tiempo Medio/Vuelta: %.2f µs | (Microsegundos) Vueltas HFT: %d", avg_micro_per_loop, g_hft_loops_count);
      PrintFormat("[HFT ENGINE] Ticks interceptados: %d", g_telemetry_ticks);
      PrintFormat("[RAM STATE] Pool: %d | Reales: %d | Virtuales: %d", memTotal, realCount, virtCount);
      PrintFormat("[BROKER] Posiciones: %d | Órdenes: %d", brokerPos, brokerOrd);

      if(realCount > (brokerPos + brokerOrd))
         //Print("⚠️ [ALERTA] ¡Fantasmas en RAM! Hay más trades en memoria que en el Bróker.");
         if(syncedCount < (realCount + virtCount))
            //Print("⏳ [INFO] Esperando que el Oráculo sincronice algunos trades...");

            //Print("=================================================\n");

            // 4. Resetear los odómetros para el próximo segundo
            g_telemetry_ticks = 0;
      g_hft_total_micro_time = 0;
      g_hft_loops_count = 0;
     }

//+------------------------------------------------------------------+
//| PROCESAR CLICS DE HOTKEYS UI                                     |
//+------------------------------------------------------------------+
   void ProcessHotkeyClick(int id)
     {
      if(id == OP_HK_CLOSE)
        {
         g_isHotkeyOpen = false;
         BuildHotkeyUI();

         return;
        }

      if(id == OP_HK_MASTER)
        {
         g_hotkeyDisk[0].masterSwitch = !g_hotkeyDisk[0].masterSwitch;
         SavePanelToBin();
         BuildHotkeyUI();

         return;
        }

      // Toggles (ON/OFF)
      if(id >= OP_HK_EN_0 && id <= OP_HK_EN_0 + 8)
        {
         int idx = id - OP_HK_EN_0;
         g_hotkeyDisk[0].keys[idx].enabled = !g_hotkeyDisk[0].keys[idx].enabled;
         SavePanelToBin();
         BuildHotkeyUI();

         return;
        }

      // Botones de Asignación (Modo Escucha)
      if(id >= OP_HK_BTN_0 && id <= OP_HK_BTN_0 + 8)
        {
         g_listeningHotkeyIdx = id - OP_HK_BTN_0;
         BuildHotkeyUI();

         return;
        }
     }

//+------------------------------------------------------------------+
//| PROCESADOR DEL CUARTO DE MÁQUINAS (SETTINGS & PRESETS)           |
//+------------------------------------------------------------------+
   void              ProcessSettingsClick(int id)
     {
      switch(id)
        {
         case OP_SET_OPEN_HOTKEYS:
            g_isHotkeyOpen = true;
            BuildHotkeyUI();

            break;
         case OP_SET_CLOSE:
            g_isSettingsOpen = false;
            BuildSettingsUI();
            break;

         case OP_BTN_HELP:
            g_isHelpOpen = true;
            BuildHelpUI(); // Llamamos al constructor del manual
            break;

         case OP_SET_PRESET_SAVE:
           {
            if(g_presetName == "")
               return;
            SyncPanelToTemplateState();
            WritePanelToDisk(); // Actualiza la RAM

            string path = "TradeAssistantPro\\Presets\\" + g_presetName + ".bin";
            int file = FileOpen(path, FILE_WRITE|FILE_BIN);
            if(file != INVALID_HANDLE)
              {
               FileWriteArray(file, g_panelDisk);
               FileClose(file);
               //Alert("Preset[", g_presetName, "] Saved Successfully!");
              }
            PrintFormat("[System] Preset '%s' saved successfully.", g_presetName);
            PlaySound("ok.wav");
            BuildSettingsUI();
            break;
           }

         case OP_SET_PRESET_LOAD:
           {
            if(g_presetName == "" || g_presetName == "Default")
               return;
            string path = "TradeAssistantPro\\Presets\\" + g_presetName + ".bin";
            if(!FileIsExist(path))
               return;

            LoadPresetSettings(g_presetName);

            // ¡MAGIA! Un solo llamado actualiza todo el universo
            RefreshGlobalThemeAndUI();

            PrintFormat("[System] Preset '%s' loaded successfully.", g_presetName);
            PlaySound("ok.wav");

            break;
           }

         case OP_SET_PRESET_DEL:
           {
            if(g_presetName == "" || g_presetName == "Default")
               return;
            string path = "TradeAssistantPro\\Presets\\" + g_presetName + ".bin";
            if(FileIsExist(path))
              {
               FileDelete(path);
               //Alert("Preset [", g_presetName, "] Deleted!");
               g_presetName = "Default";
               ScanPresets();
               BuildSettingsUI();
              }
            break;
           }

         case OP_SET_THEME_0:
         case OP_SET_THEME_1:
         case OP_SET_THEME_2:
         case OP_SET_THEME_3:
         case OP_SET_THEME_4: // <--- AÑADIDO
            g_currentTheme = id - OP_SET_THEME_0;

            // ¡MAGIA! El Director se encarga de llamar a InitTheme() y redibujar todo
            RefreshGlobalThemeAndUI();

            break;

         case OP_SET_TOG_HIST:
           {
            bool histOn = (bool)ChartGetInteger(0, CHART_SHOW_TRADE_HISTORY);
            ChartSetInteger(0, CHART_SHOW_TRADE_HISTORY, !histOn);
            BuildSettingsUI();
           }
         break;

         case OP_SET_TOG_SHOT:
            g_autoScreenshot = !g_autoScreenshot;
            BuildSettingsUI();
            break;

         case OP_SET_TOG_MAGIC: // <--- NUEVO TOGGLE
            g_manageAllMagics = !g_manageAllMagics;
            BuildSettingsUI();
            UpdateOpenTradesVisuals(); // Refresca los paneles instantáneamente
            break;

         case OP_SET_PRESET_DROP:
            ScanPresets();
            SettingsWin.ToggleDropdown(id, g_presetsList);
            break;

         case OP_SET_PRESET_INP:
         case OP_SET_INP_SPREAD:
            SettingsWin.SpawnGhostInput(id);
            break;
        }
     }

//+------------------------------------------------------------------+
//| MOTOR DE SCREENSHOTS: Toma foto en Full HD y la guarda limpia    |
//+------------------------------------------------------------------+
   void              TakeScreenshot(string prefix)
     {
      string folder = "TradeAssistantPro\\Screenshots\\";

      // Formateamos la hora para que sea un nombre de archivo válido en Windows
      string timeStr = TimeToString(TimeCurrent(), TIME_DATE|TIME_MINUTES|TIME_SECONDS);
      StringReplace(timeStr, ".", "-");
      StringReplace(timeStr, ":", "-");

      string fileName = folder + prefix + "_" + _Symbol + "_" + timeStr + ".png";

      // Tomamos la foto a 1920x1080, alineada a la derecha para ver el precio actual
      if(ChartScreenShot(0, fileName, 1920, 1080, ALIGN_RIGHT))
        {
         PrintFormat("[System] Screenshot saved successfully: %s", fileName);
         PlaySound("tick.wav"); // Sonido de cámara

        }
     }

//+------------------------------------------------------------------+
//| ESCÁNER DE PRESETS GLOBALES (Lee los archivos .bin de la carpeta)|
//+------------------------------------------------------------------+
   void              ScanPresets()
     {
      ArrayResize(g_presetsList, 0); // Vaciamos la memoria
      string folder = "TradeAssistantPro\\Presets\\";
      string file_name;

      // Buscamos cualquier archivo que termine en .bin
      long search_handle = FileFindFirst(folder + "*.bin", file_name);

      if(search_handle != INVALID_HANDLE)
        {
         do
           {
            // Limpiamos el ".bin" para que en el menú solo se vea el nombre limpio
            string cleanName = file_name;
            StringReplace(cleanName, ".bin", "");

            int s = ArraySize(g_presetsList);
            ArrayResize(g_presetsList, s + 1);
            g_presetsList[s] = cleanName;
           }
         while(FileFindNext(search_handle, file_name));

         FileFindClose(search_handle);
        }

      // Si la carpeta está vacía, ponemos uno por defecto para que no se rompa la UI
      if(ArraySize(g_presetsList) == 0)
        {
         ArrayResize(g_presetsList, 1);
         g_presetsList[0] = "Default";
        }
     }

//+------------------------------------------------------------------+
//| TRADUCTOR DE EVENTOS: Procesa la señal del Motor HFT             |
//+------------------------------------------------------------------+
   void              TranslateAndExecuteNuke()
     {
      // 1. Apagamos la señal al entrar para no entrar en un bucle infinito
      int triggerSrc = g_hft_nuke_signal;
      g_hft_nuke_signal = -1;

      if(triggerSrc < 0 || triggerSrc > 8)
         return;

      // 2. Traducción de Número a Texto
      string reason = "";
      switch(triggerSrc)
        {
         case 0:
            reason = "Hard Money Limit: Lower Equity";
            break;
         case 1:
            reason = "Hard Money Limit: Upper Equity";
            break;
         case 2:
            reason = "Hard Money Limit: Trailing Drop ($)";
            break;
         case 3:
            reason = "Hard Money Limit: Trailing Drop (%)";
            break;
         case 4:
            reason = "Hard Money Limit: Floating Loss ($)";
            break;
         case 5:
            reason = "Hard Money Limit: Floating Loss (%)";
            break;
         case 6:
            reason = "Hard Money Limit: Floating Profit ($)";
            break;
         case 7:
            reason = "Hard Money Limit: Floating Profit (%)";
            break;
         case 8:
            reason = "Hard Money Limit: Sigma Profit";
            break;
        }

      // 3. Leemos de la RAM si esta regla en específico tiene permiso para cerrar gráficos
      bool canCloseCharts = g_protect.f[triggerSrc].closeEAs;

      //Print(">>> [PROTECTOR] Señal HFT recibida: ", triggerSrc, " | Traducción: ", reason, " | Cerrar Gráficos: ", canCloseCharts ? "ON" : "OFF");

      // 4. Invocamos el trabajo pesado (que ahora correrá fuera del HFT)
      ExecuteNuclearOption(reason, canCloseCharts);
     }

//+------------------------------------------------------------------+
//| MOTOR MATEMÁTICO: Conversión Precio a Pixel Y (Cero Latencia)    |
//+------------------------------------------------------------------+
   int PriceToY(double price)
     {
      double maxP = ChartGetDouble(0, CHART_PRICE_MAX);
      double minP = ChartGetDouble(0, CHART_PRICE_MIN);
      if(maxP <= minP)
         return 0; // Protección contra división por cero

      int height = (int)ChartGetInteger(0, CHART_HEIGHT_IN_PIXELS);

      // Álgebra de interpolación lineal pura
      double pct = (maxP - price) / (maxP - minP);
      return (int)MathRound(height * pct);
     }

//+------------------------------------------------------------------+
//| ENCOLA EL CIERRE DE UNA POSICIÓN AL INSTANTE (O(1))              |
//+------------------------------------------------------------------+
   bool QueueClosePosition(ulong ticket)
     {
      if(!PositionSelectByTicket(ticket))
         return false;
      string sym = PositionGetString(POSITION_SYMBOL);

      MqlTradeRequest req;
      ZeroMemory(req);
      req.action = TRADE_ACTION_DEAL;
      req.position = ticket;
      req.symbol = sym;
      req.volume = PositionGetDouble(POSITION_VOLUME);
      req.type = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY) ? ORDER_TYPE_SELL : ORDER_TYPE_BUY;
      req.price = (req.type == ORDER_TYPE_SELL) ? SymbolInfoDouble(sym, SYMBOL_BID) : SymbolInfoDouble(sym, SYMBOL_ASK);
      req.deviation = 20;
      req.magic = MAGIC_NUM;

      long fill = SymbolInfoInteger(sym, SYMBOL_FILLING_MODE);
      req.type_filling = ((fill & SYMBOL_FILLING_FOK) != 0) ? ORDER_FILLING_FOK : (((fill & SYMBOL_FILLING_IOC) != 0) ? ORDER_FILLING_IOC : ORDER_FILLING_RETURN);

      PushAsyncRequest(req, ticket);
      return true;
     }

//+------------------------------------------------------------------+
//| ENCOLA EL BORRADO DE UNA ORDEN PENDIENTE AL INSTANTE (O(1))      |
//+------------------------------------------------------------------+
   bool QueueDeleteOrder(ulong ticket)
     {
      if(!OrderSelect(ticket))
         return false;

      MqlTradeRequest req;
      ZeroMemory(req);
      req.action = TRADE_ACTION_REMOVE;
      req.order  = ticket;

      PushAsyncRequest(req, ticket);
      return true;
     }

//+------------------------------------------------------------------+
//| EL BRÓKER VIRTUAL: Valida la geometría física de una orden       |
//+------------------------------------------------------------------+
   bool IsVirtualGeometryValid(long type, double entry, double sl, double tp, double trigger)
     {
      double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);

      bool isBuy = (type == ORDER_TYPE_BUY || type == ORDER_TYPE_BUY_LIMIT || type == ORDER_TYPE_BUY_STOP || type == ORDER_TYPE_BUY_STOP_LIMIT);

      if(isBuy)
        {
         // Compras: SL abajo, TP arriba. Limit abajo del Trigger.
         if(sl > 0 && sl >= entry - point)
            return false;
         if(tp > 0 && tp <= entry + point)
            return false;
         if(type == ORDER_TYPE_BUY_STOP_LIMIT && trigger > 0 && entry >= trigger - point)
            return false;
        }
      else
        {
         // Ventas: SL arriba, TP abajo. Limit arriba del Trigger.
         if(sl > 0 && sl <= entry + point)
            return false;
         if(tp > 0 && tp >= entry - point)
            return false;
         if(type == ORDER_TYPE_SELL_STOP_LIMIT && trigger > 0 && entry <= trigger + point)
            return false;
        }

      return true;
     }

//+------------------------------------------------------------------+
//| DIRECTOR DE ORQUESTA: Refresca toda la UI basada en el Tema/RAM  |
//+------------------------------------------------------------------+
   void RefreshGlobalThemeAndUI()
     {
      // 1. Recargar los colores maestros a la memoria
      InitTheme();

      // 2. Reconstruir las ventanas CCanvas (Solo las que estén visibles)
      BuildCanvasUI(); // El panel principal siempre se redibuja

      if(g_isSettingsOpen)
         BuildSettingsUI();
      if(g_isModalOpen)
         BuildModalUI();
      if(m_isTimeOpen)
         BuildTimeUI();
      if(m_isProtectOpen)
         BuildProtectUI();
      if(m_isNewsOpen)
         BuildNewsUI();
      if(g_isHotkeyOpen)
         BuildHotkeyUI();

      // 3. Forzar limpieza de los Menús vivos del Gestor (EA2)
      int memTotal = TradeRAM.Total();
      for(int i = 0; i < memTotal; i++)
        {
         if(CheckPointer(TradeRAM.GetByIndex(i)) != POINTER_INVALID)
           {
            // Al vaciar los canvas, la próxima vez que UpdateOpenTradesVisuals los dibuje,
            // absorberán los nuevos colores de Theme.bg, Theme.accent, etc.
            if(TradeRAM.GetByIndex(i).isMenuOpen)
               TradeRAM.GetByIndex(i).menuCanvas.Clear();

            if(TradeRAM.GetByIndex(i).activeSubMenu != 0)
               TradeRAM.GetByIndex(i).subMenuCanvas.Clear();
           }
        }

      // 4. Repintar elementos nativos de MT5
      if(m_linesActive)
         UpdateInputsFromLines(); // Reposiciona y colorea las líneas de pre-operación

      UpdateOpenTradesVisuals();  // Reposiciona y colorea las líneas del Gestor

      // 5. El brochazo final en pantalla
      ChartRedraw();
     }

//+------------------------------------------------------------------+
//| CONSTRUIR VENTANA DE DIÁLOGO UNIVERSAL (EXIT EA / MANAGE ALL)    |
//+------------------------------------------------------------------+
   void BuildExitUI()
     {
      ExitWin.Clear();
      if(!g_isExitOpen)
        {
         ExitWin.DestroyCanvas();
         DWM.UnregisterWindow(GetPointer(ExitWin));
         return;
        }

      int chartW = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);
      int chartH = (int)ChartGetInteger(0, CHART_HEIGHT_IN_PIXELS);

      int mW = 280;
      int mH = 130;
      int mX = (chartW / 2) - (mW / 2);
      int mY = (chartH / 2) - (mH / 2);

      if(ObjectFind(0, "CanvasExitEA") < 0)
        {
         ExitWin.Init(ENGINE_EXIT, "CanvasExitEA", mX, mY, mW, mH);
         DWM.RegisterWindow(GetPointer(ExitWin));
        }

      // FONDO Y CABECERA
      ExitWin.AddPanel(0, 0, mW, mH, Theme.bg, Theme.border);
      ExitWin.AddPanel(0, 0, mW, 32, Theme.surface, Theme.border);

      int btnW = 100;

      // --- ENRUTADOR DE CONTEXTO UNIVERSAL ---
      if(g_dialogContext == 0) // CASO 0: SALIR DEL EA
        {
         ExitWin.AddLabel("SYSTEM WARNING", mW / 2, 8, "Arial Bold", 12, Theme.sell, TA_CENTER|TA_TOP);
         ExitWin.AddLabel("Are you sure you want to close the EA?", mW / 2, 50, "Arial", 12, Theme.textMain, TA_CENTER|TA_TOP);
         ExitWin.AddLabel("All automated management will stop.", mW / 2, 68, "Arial", 10, Theme.textDim, TA_CENTER|TA_TOP);

         ExitWin.AddButton(OP_EXIT_YES, 30, 90, btnW, 28, "YES, CLOSE", Theme.sell, ColorToARGB(C'255,100,100', 255), Theme.sell, Theme.textMain, Theme.sell, TA_CENTER|TA_VCENTER, "Arial Bold", 11);
        }
      else
         if(g_dialogContext == 1) // CASO 1: ACTIVAR MANAGE ALL SYMBOLS
           {
            ExitWin.AddLabel("ACTION REQUIRED", mW / 2, 8, "Arial Bold", 12, Theme.accent, TA_CENTER|TA_TOP);
            ExitWin.AddLabel("Enable 'Manage All' to change charts?", mW / 2, 50, "Arial", 12, Theme.textMain, TA_CENTER|TA_TOP);
            ExitWin.AddLabel("The EA will monitor all symbols.", mW / 2, 68, "Arial", 10, Theme.textDim, TA_CENTER|TA_TOP);

            ExitWin.AddButton(OP_EXIT_YES, 30, 90, btnW, 28, "YES, ENABLE", Theme.buy, ColorToARGB(C'100,255,100', 255), Theme.buy, Theme.bg, Theme.buy, TA_CENTER|TA_VCENTER, "Arial Bold", 11);
           }

      // BOTÓN CANCELAR (Universal para ambos casos)
      ExitWin.AddButton(OP_EXIT_NO, mW - 30 - btnW, 90, btnW, 28, "CANCEL", Theme.surface, Theme.border, Theme.surface, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial Bold", 11);

      ExitWin.Render();
     }

//+------------------------------------------------------------------+
//| PROCESAR CLICS DE LA VENTANA DE DIÁLOGO UNIVERSAL                |
//+------------------------------------------------------------------+
   void ProcessExitClick(int id)
     {
      if(id == OP_EXIT_YES)
        {
         if(g_dialogContext == 0) // SALIR DEL EA
           {
            PlaySound("timeout.wav");
            ExpertRemove(); // Aniquilación del EA
           }
         else
            if(g_dialogContext == 1) // ACTIVAR MODO Y SALTAR
              {
               PlaySound("ok.wav"); // Feedback positivo

               // 1. Encendemos el modo de gestión multi-símbolo
               m_manageAllSymbols = true;

               // 2. Apagamos y destruimos la ventana de diálogo
               g_isExitOpen = false;
               BuildExitUI();

               // 3. Repintamos el Panel para que el botón muestre "[ MANAGE ALL SYMBOLS: ON ]"
               BuildCanvasUI();
               if(g_activeTab == 3)
                  UpdateToolData(true); // Refrescar métricas del Portfolio

               // 4. ¡El Salto Mágico!
               if(g_pending_symbol_change != _Symbol && g_pending_symbol_change != "")
                  ChartSetSymbolPeriod(m_chartId, g_pending_symbol_change, _Period);
              }
        }
      else
         if(id == OP_EXIT_NO)
           {
            g_isExitOpen = false;
            BuildExitUI(); // Se auto-destruye limpiamente
            PlaySound("click.wav");
           }
     }

// ====================================================================
// ⏱️ RELOJ CENTRALIZADO (CORE TIME ENGINE - HFT OPTIMIZED)
// ====================================================================
   class CTimeCore
     {
   private:
      long              m_offset;
      datetime          m_last_broker_time;

   public:
                     CTimeCore() : m_offset(0), m_last_broker_time(0) {}

      // 1. Nace con el EA
      void              Init()
        {
         datetime tc = TimeCurrent();
         if(tc > 0)
           {
            m_offset = (long)tc - (long)TimeLocal();
            m_last_broker_time = tc;
           }
        }

      // 2. Sincronizador de Alta Frecuencia (Cero Lag)
      void              Sync()
        {
         datetime tc = TimeCurrent();
         if(tc > m_last_broker_time)
           {
            m_offset = (long)tc - (long)TimeLocal();
            m_last_broker_time = tc;
           }
        }

      // 3. El Nuevo "TimeCurrent()" Universal (A prueba de fines de semana)
      datetime          Now()
        {
         return (datetime)((long)TimeLocal() + m_offset);
        }

      // 4. Extractor rápido de estructura (Para Días, Horas, Minutos)
      void              NowStruct(MqlDateTime &dt)
        {
         TimeToStruct(Now(), dt);
        }

      // 5. Inicio del Día del Broker (00:00:00) - Matemáticas puras, sin Strings
      datetime          TodayStart()
        {
         datetime now = Now();
         return now - (now % 86400); // 86400 segundos = 1 día
        }
     };

// Instancia Global Única
   CTimeCore TimeCore;

//+------------------------------------------------------------------+
//| REDONDEA PRECIOS AL TICK SIZE EXACTO DEL BRÓKER (CERO ERRORES)   |
//+------------------------------------------------------------------+
   double SanitizePrice(double price, string symbol)
     {
      if(price <= 0)
         return 0.0;

      // 1. Preguntamos las reglas físicas de este símbolo al bróker
      double tickSize = SymbolInfoDouble(symbol, SYMBOL_TRADE_TICK_SIZE);
      int digits      = (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS);

      if(tickSize <= 0)
         return NormalizeDouble(price, digits); // Respaldo tradicional

      // 2. Aplicamos la magia matemática de redondeo al múltiplo del tick
      double roundedPrice = MathRound(price / tickSize) * tickSize;

      return NormalizeDouble(roundedPrice, digits);
     }

