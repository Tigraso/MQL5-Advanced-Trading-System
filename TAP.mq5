//| MOCKUP: PÁGINA 7 - NEWS FILTER                                   |
//+------------------------------------------------------------------+
   void DrawMockup_NewsFilter(CUIEngine &eng, int x, int y, int w)
     {
      int modH = 420;
      eng.AddPanel(x, y, w, modH, Theme.bg, Theme.border);

      eng.AddPanel(x, y, w, 35, Theme.surface, Theme.border);
      eng.AddLabel("ECONOMIC CALENDAR (AUTO-FILTERED)", x + 15, y + 8, "Arial", 13, Theme.accent, TA_LEFT|TA_TOP);
      eng.AddButton(0, x + w - 35, y + 5, 25, 25, "X", Theme.surface, Theme.sell, Theme.sell, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 13);

      int fY = y + 45;
      uint cHighBg = ColorToARGB(C'255,50,50', 255);
      uint cMedBg  = ColorToARGB(C'255,160,0', 255);

      eng.AddButton(0, x + 15,  fY, 60, 26, "HIGH", cHighBg, Theme.border, cHighBg, Theme.bg, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      eng.AddButton(0, x + 80,  fY, 60, 26, "MED",  cMedBg,  Theme.border, cMedBg,  Theme.bg, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      eng.AddButton(0, x + 145, fY, 60, 26, "LOW",  Theme.surface,  Theme.border, Theme.surface, Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);

      eng.AddButton(0, x + w - 165, fY, 150, 26, "SHOW ALL LINES", Theme.accent, Theme.border, Theme.accent, Theme.bg, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);

      int boxY = y + 85;
      eng.AddPanel(x + 15, boxY, w - 30, 288, Theme.surface, Theme.border);
      eng.AddPanel(x + 16, boxY + 1, w - 32, 30, Theme.bg, 0);

      int cX[5] = {x + 25, x + 130, x + 180, x + 240, x + w - 85};

      eng.AddLabel("DATE / TIME", cX[0], boxY + 6, "Arial", 11, Theme.textMain, TA_LEFT|TA_TOP);
      eng.AddLabel("CUR",         cX[1], boxY + 6, "Arial", 11, Theme.textMain, TA_LEFT|TA_TOP);
      eng.AddLabel("IMP",         cX[2], boxY + 6, "Arial", 11, Theme.textMain, TA_LEFT|TA_TOP);
      eng.AddLabel("EVENT NAME",  cX[3], boxY + 6, "Arial", 11, Theme.textMain, TA_LEFT|TA_TOP);
      eng.AddLabel("CHART",       cX[4], boxY + 6, "Arial", 11, Theme.textMain, TA_LEFT|TA_TOP);

      int rY = boxY + 31;

      // Fila 1 (Alta Importancia, ON)
      eng.AddPanel(x + 16, rY, w - 32, 32, Theme.surface, 0);
      eng.AddLabel("2025-10-24 14:30", cX[0], rY + 8, "Arial", 11, Theme.textDim, TA_LEFT|TA_TOP);
      eng.AddLabel("USD", cX[1], rY + 8, "Arial", 11, Theme.textMain, TA_LEFT|TA_TOP);
      eng.AddLabel("HIGH", cX[2], rY + 8, "Arial", 11, cHighBg, TA_LEFT|TA_TOP);
      eng.AddLabel("Nonfarm Payrolls (NFP)", cX[3], rY + 8, "Arial", 11, Theme.textMain, TA_LEFT|TA_TOP);
      eng.AddButton(0, cX[4], rY + 4, 50, 24, "ON", Theme.accent, Theme.surface, Theme.accent, Theme.bg, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);

      // Fila 2 (Media Importancia, OFF)
      rY += 32;
      eng.AddPanel(x + 16, rY, w - 32, 32, Theme.bg, 0);
      eng.AddLabel("2025-10-24 16:00", cX[0], rY + 8, "Arial", 11, Theme.textDim, TA_LEFT|TA_TOP);
      eng.AddLabel("EUR", cX[1], rY + 8, "Arial", 11, Theme.textMain, TA_LEFT|TA_TOP);
      eng.AddLabel("MED", cX[2], rY + 8, "Arial", 11, cMedBg, TA_LEFT|TA_TOP);
      eng.AddLabel("ECB President Speaks", cX[3], rY + 8, "Arial", 11, Theme.textMain, TA_LEFT|TA_TOP);
      eng.AddButton(0, cX[4], rY + 4, 50, 24, "OFF", Theme.bg, Theme.surface, Theme.accent, Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);

      DrawHelpSticker(eng, x + 70, fY - 10, "1");        // Impact Filters
      DrawHelpSticker(eng, x + w - 100, fY - 10, "2");   // Master Toggle
      DrawHelpSticker(eng, cX[0] + 15, rY + 12, "3");    // Date/Time
      DrawHelpSticker(eng, cX[1] - 10, rY + 12, "4");    // Currency
      DrawHelpSticker(eng, cX[3] + 25, rY + 12, "5");    // Event Name
      DrawHelpSticker(eng, cX[4] + 15, rY + 12, "6");    // Chart Line Toggle
     }

