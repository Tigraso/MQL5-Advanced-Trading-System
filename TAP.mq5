// ====================================================================
// 🧠 MARKET CONTEXT: Caché de Entorno Ultra-Rápida
// ====================================================================
struct SMarketContext
  {
   // 1. INMUTABLES (Se calculan 1 sola vez en OnInit)
   double            point;
   int               digits;
   double            tickSize;
   double            volStep;
   double            volMin;
   double            volMax;
   double            multiplier;

   // 2. DINÁMICOS (Se actualizan 1 vez por Tick / Timer)
   double            tickValue;  // <--- MOVIDO AQUÍ (Protege el Lotaje)
   double            stopsLevel; // <--- MOVIDO AQUÍ (Protege del Error 10016)
   double            bid;
   double            ask;

   void              UpdateStatic(string sym)
     {
      point      = SymbolInfoDouble(sym, SYMBOL_POINT);
      digits     = (int)SymbolInfoInteger(sym, SYMBOL_DIGITS);
      tickSize   = SymbolInfoDouble(sym, SYMBOL_TRADE_TICK_SIZE);
      volStep    = SymbolInfoDouble(sym, SYMBOL_VOLUME_STEP);
      volMin     = SymbolInfoDouble(sym, SYMBOL_VOLUME_MIN);
      volMax     = SymbolInfoDouble(sym, SYMBOL_VOLUME_MAX);
      multiplier = (digits == 3 || digits == 5) ? 10 * point : point;
     }

   void              UpdateDynamic(string sym)
     {
      bid = SymbolInfoDouble(sym, SYMBOL_BID);
      ask = SymbolInfoDouble(sym, SYMBOL_ASK);

      // Actualización en tiempo real para evitar rechazos y descuadres
      tickValue  = SymbolInfoDouble(sym, SYMBOL_TRADE_TICK_VALUE);
      stopsLevel = SymbolInfoInteger(sym, SYMBOL_TRADE_STOPS_LEVEL) * point;
      if(stopsLevel == 0)
         stopsLevel = 20 * point;
     }
  };

SMarketContext Market;


