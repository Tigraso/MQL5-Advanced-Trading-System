// ====================================================================
// 🛡️ ESCUDO DE ASINCRONÍA: COMMAND QUEUE & RATE LIMITER
// ====================================================================
#define MAX_REQ_PER_SEC   10   // Límite del Bróker (Peticiones por Segundo)
#define MAX_REQ_PER_BURST 2    // Límite del Bróker (Peticiones por Ráfaga/Milisegundo)

// Catálogo de Acciones Asíncronas
enum ENUM_ASYNC_ACTION
  {
   ASYNC_PLACE_BASE = 0,
   ASYNC_PLACE_SPLIT,
   ASYNC_MODIFY_SL,
   ASYNC_MODIFY_TP,
   ASYNC_MODIFY_PRICE,
   ASYNC_MODIFY_TRIGGER, // <-- Se usa para mover la Línea Morada (Stop Limit)
   ASYNC_CLOSE_FULL,
   ASYNC_CLOSE_PARTIAL,
   ASYNC_TOGGLE_HIDE,    // <--- NUEVO: Ocultar/Mostrar SL y TP
   ASYNC_MODIFY_TIME     // <--- NUEVO: Mover Flecha de Expiración
  };

struct SAsyncRequest
  {
   MqlTradeRequest   req;
   ulong             ticket;      // Ticket Real (0 si es una orden nueva)
   ulong             vTicket;     // Ticket Virtual/Fantasma (Portador del ADN)
   ENUM_ASYNC_ACTION action;
   // --- MEMORIA DE ROLLBACK PARA VIAJES EN EL TIEMPO ---
   double            old_sl;
   double            old_tp;
   double            old_price;
   datetime          old_expiration; // <--- NUEVO
   bool              old_hide_state; // <--- NUEVO
  };

struct SReqMap
  {
   uint              request_id;  // El ID que nos devuelve MT5 al enviar
   ulong             ticket;
   ulong             vTicket;
   ENUM_ASYNC_ACTION action;
   double            old_sl;
   double            old_tp;
   double            old_price;
   datetime          old_expiration; // <--- NUEVO
   bool              old_hide_state; // <--- NUEVO
  };

SAsyncRequest     g_async_queue[];
SReqMap           g_req_map[];
uint              g_rate_current_sec   = 0;
int               g_rate_reqs_this_sec = 0;

//+------------------------------------------------------------------+
//| PONE LA PETICIÓN EN COLA CON MEMORIA DE ROLLBACK (O(1))          |
//+------------------------------------------------------------------+
void PushAsyncRequest(MqlTradeRequest &request, ulong ticket, ulong vTicket = 0, ENUM_ASYNC_ACTION action = ASYNC_PLACE_BASE, double oldSL = 0, double oldTP = 0, double oldPrice = 0, datetime oldExpiration = 0, bool oldHideState = false)
  {
// ====================================================================
// 🛡️ ADUANA UNIVERSAL: SANITIZACIÓN DE PRECIOS (CERO RECHAZOS MT5)
// ====================================================================
// 1. Identificamos el símbolo al que va dirigida la orden
   CTradeState *mem = TradeRAM.Get(ticket > 0 ? ticket : vTicket);
   string sym = (mem != NULL && mem.symbol != "") ? mem.symbol : _Symbol;

// Si la petición no traía símbolo (ej. modificaciones), se lo inyectamos por si el sanitizador lo necesita
   if(request.symbol == "")
      request.symbol = sym;

// 2. Sanitizamos todos los precios de la petición antes de encolarla
   if(request.price > 0)
      request.price     = SanitizePrice(request.price, sym);
   if(request.sl > 0)
      request.sl        = SanitizePrice(request.sl, sym);
   if(request.tp > 0)
      request.tp        = SanitizePrice(request.tp, sym);
   if(request.stoplimit > 0)
      request.stoplimit = SanitizePrice(request.stoplimit, sym);
// ====================================================================

   int size = ArraySize(g_async_queue);
   ArrayResize(g_async_queue, size + 1, 50);

// Aseguramos que el Magic Number NUNCA se pierda
   request.magic = MAGIC_NUM;

   g_async_queue[size].req            = request;
   g_async_queue[size].ticket         = ticket;
   g_async_queue[size].vTicket        = vTicket;
   g_async_queue[size].action         = action;
   g_async_queue[size].old_sl         = oldSL;
   g_async_queue[size].old_tp         = oldTP;
   g_async_queue[size].old_price      = oldPrice;
   g_async_queue[size].old_expiration = oldExpiration; // <--- GUARDADO
   g_async_queue[size].old_hide_state = oldHideState;  // <--- GUARDADO

// Si estamos modificando un ticket existente, le ponemos el candado
   if(mem != NULL)
     {
      mem.async_is_waiting = true;
      mem.async_last_time = GetTickCount();
     }
  }

//+------------------------------------------------------------------+
//| EL DESPACHADOR: Dispara y Mapea en la RAM                        |
//+------------------------------------------------------------------+
void DispatchAsyncQueue()
  {
   int size = ArraySize(g_async_queue);
   if(size == 0)
      return;

   uint current_time = GetTickCount();
   uint current_sec = current_time / 1000;

   if(current_sec != g_rate_current_sec)
     {
      g_rate_current_sec = current_sec;
      g_rate_reqs_this_sec = 0;
     }


// --- DEBUG 3: ESTADO DE LA COLA ---
   if(size > 0)
     {
      ////PrintFormat(">>> [DEBUG QUEUE 3] Tareas en cola: %d | Enviadas este seg: %d/%d",
      //size, g_rate_reqs_this_sec, MAX_REQ_PER_SEC);
     }

   if(g_rate_reqs_this_sec >= MAX_REQ_PER_SEC)
      return;

   int dispatched_this_burst = 0;
   MqlTradeResult res;

   while(size > 0 && dispatched_this_burst < MAX_REQ_PER_BURST && g_rate_reqs_this_sec < MAX_REQ_PER_SEC)
     {
      ZeroMemory(res);

      // Disparamos la petición de forma 100% Asíncrona
      if(!OrderSendAsync(g_async_queue[0].req, res))
        {
         int err = GetLastError();

         // --- LOG & SOUND: BROKER REJECTION ---
         ulong errTk = g_async_queue[0].ticket > 0 ? g_async_queue[0].ticket : g_async_queue[0].vTicket;
         PrintFormat("[Async Error] Broker rejected request for ticket #%I64u. Error code: %d", errTk, err);
         PlaySound("stops.wav"); // Sonido característico de error de trading
         // -------------------------------------

         ulong tk = g_async_queue[0].ticket > 0 ? g_async_queue[0].ticket : g_async_queue[0].vTicket;
         CTradeState *mem = TradeRAM.Get(tk);

         if(mem != NULL)
           {
            mem.async_is_waiting = false;
            mem.is_firing = false;

            /// --- 🚑 ROLLBACK INSTANTÁNEO (Viaje en el tiempo para la UI) ---
            ENUM_ASYNC_ACTION act = g_async_queue[0].action;

            if(act == ASYNC_MODIFY_SL)
              {
               mem.slPrice = g_async_queue[0].old_sl;
               mem.cmd_flags &= ~CMD_MODIFY_SL;
              }

            else
               if(act == ASYNC_TOGGLE_HIDE)
                 {
                  mem.isHiddenActive = g_async_queue[0].old_hide_state;
                 }
               else
                  if(act == ASYNC_MODIFY_TIME)
                    {
                     mem.virtExpiration = g_async_queue[0].old_expiration;
                    }
                  else

                     // --- MAGIA: GESTIÓN DE LA FIGURA PRE-OP (ERROR LOCAL) ---
                     if(act == ASYNC_PLACE_BASE || act == ASYNC_PLACE_SPLIT)
                       {
                        // --- 1. ANIQUILACIÓN DEL FANTASMA (Anti-Amnesia) ---
                        ulong ghostTkToKill = g_async_queue[0].vTicket;
                        if(ghostTkToKill > 0)
                          {
                           CTradeState *vMemKill = TradeRAM.Get(ghostTkToKill);
                           if(vMemKill != NULL)
                              vMemKill.isVirtual = false; // Lo matamos en la RAM
                           DeleteVirtualOrderData(ghostTkToKill); // Lo purgamos del disco (.bin)
                          }

                        // --- 2. RESTAURAR UI ---
                        if(g_pending_preop_orders > 0)
                          {
                           g_failed_preop_orders++;
                           g_pending_preop_orders--;
                           if(g_pending_preop_orders == 0) // Si ya terminaron de fallar todas
                             {
                              FastUpdateFigureVisuals(); // Restaura el texto original (Lote/Precio)
                              ChartRedraw();
                             }
                          }
                       }
                     else
                        if(act == ASYNC_MODIFY_TP)
                          {
                           mem.tpPrice = g_async_queue[0].old_tp;
                           mem.cmd_flags &= ~CMD_MODIFY_TP;
                          }
                        else
                           if(act == ASYNC_MODIFY_PRICE) // SI FALLA EL CENTRO
                             {
                              mem.openPrice = g_async_queue[0].old_price;
                              // ¡CRÍTICO! Restaurar también el TP y SL porque se movieron con el centro
                              if(g_async_queue[0].old_sl > 0)
                                 mem.slPrice = g_async_queue[0].old_sl;
                              if(g_async_queue[0].old_tp > 0)
                                 mem.tpPrice = g_async_queue[0].old_tp;
                              mem.cmd_flags &= ~CMD_MODIFY_PRICE;
                             }
                           else
                              if(act == ASYNC_MODIFY_TRIGGER) // SI FALLA EL GATILLO MORADO
                                {
                                 // Solo restauramos la memoria del gatillo, NO tocamos el openPrice
                                 mem.virtStopLimit = g_async_queue[0].old_price;
                                }
                              else
                                 if(act == ASYNC_CLOSE_PARTIAL)
                                   {
                                    mem.cmd_flags &= ~CMD_CLOSE_PART;
                                   }

            // 🎨 RE-PINTAR INSTANTÁNEAMENTE EL GRÁFICO Y ALERTAR

            UpdateOpenTradesVisuals();
            ChartRedraw();
           }
        }
      else
        {
         ////PrintFormat(">>> [VIRTUAL TRACE 4 - SEND SUCCESS] OrderSendAsync ENVIADO AL BROKER. Request ID asignado: %u", res.request_id);

         // --- ÉXITO: GUARDAMOS EL MAPEO PARA LA SECRETARIA ---
         int sMap = ArraySize(g_req_map);
         ArrayResize(g_req_map, sMap + 1, 50);
         g_req_map[sMap].request_id = res.request_id;
         g_req_map[sMap].ticket     = g_async_queue[0].ticket;
         g_req_map[sMap].vTicket    = g_async_queue[0].vTicket;
         g_req_map[sMap].action     = g_async_queue[0].action;
         g_req_map[sMap].old_sl     = g_async_queue[0].old_sl;
         g_req_map[sMap].old_tp     = g_async_queue[0].old_tp;
         g_req_map[sMap].old_price  = g_async_queue[0].old_price;
         g_req_map[sMap].old_expiration = g_async_queue[0].old_expiration;
         g_req_map[sMap].old_hide_state = g_async_queue[0].old_hide_state;
        }



      dispatched_this_burst++;
      g_rate_reqs_this_sec++;

      ArrayRemove(g_async_queue, 0, 1);
      size--;
     }
  }

// ====================================================================
// 🧠 ORÁCULO 2.0: DICCIONARIO DE SÍMBOLOS EN RAM (O(1) Lookups)
// ====================================================================
struct SSymbolDict
  {
   string            name;
   ushort            id;
  };

struct SMarketData
  {
   // Estáticos (No cambian nunca en la vida del EA)
   double            point;
   int               digits;
   double            tickSize;
   double            volStep;
   double            volMin;
   double            volMax;
   double            multiplier;

   // Semi-Dinámicos (Cambian muy lento, Ej: TickValue, StopsLevel)
   double            tickValue;
   double            stopsLevel;
   uint              last_semi_dynamic_update; // Cronómetro O(1)

   // Hyper-Dinámicos (Cambian cada milisegundo)
   double            bid;
   double            ask;
   long              time_msc; // Memoria celular del tick

   void              UpdateStatic(string sym)
     {
      point      = SymbolInfoDouble(sym, SYMBOL_POINT);
      digits     = (int)SymbolInfoInteger(sym, SYMBOL_DIGITS);
      tickSize   = SymbolInfoDouble(sym, SYMBOL_TRADE_TICK_SIZE);
      volStep    = SymbolInfoDouble(sym, SYMBOL_VOLUME_STEP);
      volMin     = SymbolInfoDouble(sym, SYMBOL_VOLUME_MIN);
      volMax     = SymbolInfoDouble(sym, SYMBOL_VOLUME_MAX);
      multiplier = (digits == 3 || digits == 5) ? 10 * point : point;

      last_semi_dynamic_update = 0; // Inicializamos el cronómetro
     }

   bool              UpdateDynamic(string sym)
     {
      MqlTick tick;
      if(!SymbolInfoTick(sym, tick))
         return false;

      // 1. EL ESCUDO ANTI-LAG ORIGINAL: Si el precio no se movió, abortamos
      if(tick.time_msc == time_msc)
         return true;

      // 2. ACTUALIZACIÓN HYPER-DINÁMICA (Instantánea, pura RAM)
      bid = tick.bid;
      ask = tick.ask;
      time_msc = tick.time_msc;

      // 3. LA MAGIA: THROTTLING DE DATOS SEMI-DINÁMICOS (1 vez por segundo)
      uint current_time = GetTickCount(); // Tiempo de PC en 1 ciclo de reloj

      if(current_time - last_semi_dynamic_update >= 1000 || last_semi_dynamic_update == 0)
        {
         // Solo cruzamos el puente a la API 1 vez cada 1000ms
         tickValue  = SymbolInfoDouble(sym, SYMBOL_TRADE_TICK_VALUE);
         stopsLevel = SymbolInfoInteger(sym, SYMBOL_TRADE_STOPS_LEVEL) * point;
         if(stopsLevel == 0)
            stopsLevel = 20 * point;

         last_semi_dynamic_update = current_time; // Reseteamos el cronómetro
        }

      return true;
     }
  };

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
SSymbolDict       g_symDict[];   // El índice (Nombres a IDs)
SMarketData       g_marketDB[];  // La base de datos viva (Datos por ID)

//+------------------------------------------------------------------+
//| OBTIENE O CREA EL ID NUMÉRICO DE UN SÍMBOLO (String Interning)   |
//+------------------------------------------------------------------+
ushort GetSymbolID(string sym)
  {
   int total = ArraySize(g_symDict);
   for(int i=0; i<total; i++)
     {
      if(g_symDict[i].name == sym)
         return g_symDict[i].id; // ¡Lo encontró! Retorna en O(1)
     }

// Si no existe, lo inscribe en el registro oficial (Pre-asignando RAM)
   ArrayResize(g_symDict, total + 1, 20);
   g_symDict[total].name = sym;
   g_symDict[total].id = (ushort)total;

// Preparamos su espacio en la Base de Datos del Oráculo
   ArrayResize(g_marketDB, total + 1, 20);
   g_marketDB[total].UpdateStatic(sym);
   g_marketDB[total].UpdateDynamic(sym);

   return (ushort)total;
  }

//+------------------------------------------------------------------+
//| BARRIDO ÚNICO: Actualiza todos los símbolos vivos en 1 pasada    |
//+------------------------------------------------------------------+
void UpdateAllMarkets()
  {
   int total = ArraySize(g_symDict);
   for(int i=0; i<total; i++)
     {
      g_marketDB[i].UpdateDynamic(g_symDict[i].name);
     }
  }

//+------------------------------------------------------------------+
//| CREADOR DE NOMBRES (Empaqueta Ticket + OpCode en 1 ciclo)        |
//+------------------------------------------------------------------+
string            MakeTMName(ulong ticket, int opcode)
  {
// Desplaza el ticket 12 bits a la izquierda y le pega el OpCode.
// 100% MATEMÁTICO. Sin letras, sin prefijos.
   ulong id = (ticket << 12) | (opcode & 0xFFF);
   return IntegerToString(id); // Solo convierte el número final a texto para MT5
  }

//+------------------------------------------------------------------+
//| PARSER ULTRARRÁPIDO: Extrae Ticket y OpCode a la velocidad de la luz |
//+------------------------------------------------------------------+
ushort            ParseTMObject(const string objName, ulong &outTicket)
  {
   outTicket = 0;

// 1. Conversión directa. Si el nombre es "Fibo 123", esto da 0 instantáneamente.
   ulong id = StringToInteger(objName);
   if(id == 0)
      return OP_NONE; // Ignora cualquier objeto nativo de MT5, textos basura, etc.

// 2. Desempaquetado Bitwise (1 ciclo de reloj)
   outTicket = id >> 12;            // Recupera el ticket gigante
   return (ushort)(id & 0xFFF);     // Extrae los últimos 12 bits (OpCode)
  }

CTradeState *TemplateState = NULL; // El ADN de nuestro Panel


// ====================================================================
// ESTRUCTURA DEL EQUITY PROTECT PRO (El Mega-Guardián)
// ====================================================================
// Nombres de los índices para no perdernos
enum ENUM_PROT_TYPE
  {
   P_LOWER = 0, P_UPPER, P_TRAIL_USD, P_TRAIL_PCT,
   P_LOSS_USD, P_LOSS_PCT, P_PROFIT_USD, P_PROFIT_PCT,
   P_PROFIT_SIGMA, P_TIME_DAILY, P_TIME_FRIDAY, P_TIME_DATE,
   P_RESTORE, P_REMOTE
  };

struct SProtFeature
  {
   bool              enabled;      // Columna: ENABLE (ON/OFF)
   double            statusVal;    // Columna: STATUS (Valor interno calculado)
   string            statusStr;    // Columna: STATUS (Texto a mostrar, ej: "10500.50")
   string            configStr;    // Columna: CONFIG (Lo que dibuja el CCanvas)

   // --- MEMORIA RAM PURA (Para que el OnTimer vuele) ---
   double            configNum;    // Para Loss, Profit, Trail, etc.
   int               configHour;   // Hora (Para tiempos diarios)
   int               configMin;    // Minuto (Para tiempos diarios)
   datetime          configTime;   // Solo para Datetime exacto (índice 11)
   // ----------------------------------------------------

   bool              closeEAs;     // Columna: CLOSE EAs (ON/OFF)
  };

