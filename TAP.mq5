//+------------------------------------------------------------------+
//| MOCKUP: PÁGINA 10 - EQUITY PROTECT (Headers & Drawdown Limits)   |
//+------------------------------------------------------------------+
   void DrawMockup_Prot_Drawdown(CUIEngine &eng, int x, int y, int w)
     {
      int modH = 260;
      eng.AddPanel(x, y, w, modH, Theme.bg, Theme.border);

      int boxY = y + 15;
      eng.AddPanel(x + 15, boxY, w - 30, 230, Theme.surface, Theme.border);
      eng.AddPanel(x + 16, boxY + 1, w - 32, 30, Theme.bg, 0);

      int cX[5] = {x + 25, x + 115, x + 195, x + 285, x + 385};
      eng.AddLabel("FUNCTION",   cX[0], boxY + 6, "Arial", 11, Theme.textMain, TA_LEFT|TA_TOP);
      eng.AddLabel("ENABLE",     cX[1], boxY + 6, "Arial", 11, Theme.textMain, TA_LEFT|TA_TOP);
      eng.AddLabel("STATUS",     cX[2], boxY + 6, "Arial", 11, Theme.textMain, TA_LEFT|TA_TOP);
      eng.AddLabel("CONFIG",     cX[3], boxY + 6, "Arial", 11, Theme.textMain, TA_LEFT|TA_TOP);
      eng.AddLabel("CLOSE EAs",  cX[4], boxY + 6, "Arial", 11, Theme.textMain, TA_LEFT|TA_TOP);

      // Stickers para las Cabeceras (1 al 5)
      DrawHelpSticker(eng, cX[0] + 15, boxY - 10, "1");
      DrawHelpSticker(eng, cX[1] + 5,  boxY - 10, "2");
      DrawHelpSticker(eng, cX[2] + 5,  boxY - 10, "3");
      DrawHelpSticker(eng, cX[3] + 5,  boxY - 10, "4");
      DrawHelpSticker(eng, cX[4] + 15, boxY - 10, "5");

      int rY = boxY + 31, rowH = 32;

      string fNames[4] = {"Lower ($)", "Upper ($)", "Trailing ($)", "Trailing (%)"};
      string fStat[4]  = {"10500.50", "10500.50", "100.50", "0.94%"};
      string fConf[4]  = {"10000.0", "20000.0", "500.0", "5.0"};
      bool   fEn[4]    = {false, false, true, true};

      for(int i=0; i<4; i++)
        {
         uint rowBg = (i % 2 == 0) ? Theme.surface : Theme.bg;
         eng.AddPanel(x + 16, rY, w - 32, rowH, rowBg, 0);
         eng.AddLabel(fNames[i], cX[0], rY + 8, "Arial", 11, Theme.textDim, TA_LEFT|TA_TOP);

         uint cEnBg = fEn[i] ? Theme.accent : Theme.bg;
         uint cEnTxt = fEn[i] ? Theme.bg : Theme.textDim;
         eng.AddButton(0, cX[1], rY + 4, 55, 24, fEn[i]?"ON":"OFF", cEnBg, Theme.surface, Theme.accent, cEnTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);

         eng.AddLabel(fStat[i], cX[2], rY + 8, "Arial", 11, Theme.textMain, TA_LEFT|TA_TOP);
         eng.AddButton(0, cX[3], rY + 4, 80, 24, fConf[i], Theme.inputBg, Theme.surface, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);

         uint cCeBg = (i==3) ? Theme.bg : Theme.sell;
         uint cCeTxt = (i==3) ? Theme.textDim : Theme.textMain;
         eng.AddButton(0, cX[4], rY + 4, 55, 24, (i==3)?"OFF":"ON", cCeBg, Theme.surface, Theme.sell, cCeTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);

         // Stickers para las Filas (6 al 9)
         DrawHelpSticker(eng, x + 5, rY, IntegerToString(i+6));
         rY += rowH;
        }
     }

//+------------------------------------------------------------------+
//| MOCKUP: PÁGINA 11 - EQUITY PROTECT (Floating, Time & Remote)     |
//+------------------------------------------------------------------+
   void DrawMockup_Prot_Merged(CUIEngine &eng, int x, int y, int w)
     {
      int modH = 460; // Más alto para albergar las 10 filas
      eng.AddPanel(x, y, w, modH, Theme.bg, Theme.border);

      int boxY = y + 15;
      eng.AddPanel(x + 15, boxY, w - 30, 430, Theme.surface, Theme.border);
      eng.AddPanel(x + 16, boxY + 1, w - 32, 30, Theme.bg, 0);

      int cX[5] = {x + 25, x + 130, x + 195, x + 285, x + 385}; // cX[1] desplazado por textos largos
      eng.AddLabel("FUNCTION",   cX[0], boxY + 6, "Arial", 11, Theme.textMain, TA_LEFT|TA_TOP);
      eng.AddLabel("EN.",        cX[1], boxY + 6, "Arial", 11, Theme.textMain, TA_LEFT|TA_TOP);
      eng.AddLabel("STATUS",     cX[2], boxY + 6, "Arial", 11, Theme.textMain, TA_LEFT|TA_TOP);
      eng.AddLabel("CONFIG",     cX[3], boxY + 6, "Arial", 11, Theme.textMain, TA_LEFT|TA_TOP);
      eng.AddLabel("CLOSE EAs",  cX[4], boxY + 6, "Arial", 11, Theme.textMain, TA_LEFT|TA_TOP);

      int rY = boxY + 31, rowH = 32;

      string funcNames[10] = {"Loss ($)", "Loss (%)", "Profit ($)", "Profit (%)", "Profit (Σ)", "Everyday", "Friday", "Datetime", "Restore", "Remote"};
      string statVals[10]  = {"-50.00", "-0.47%", "+150.00", "+1.42%", "+250.00", "23:50", "23:00", "2025.10.24...", "01:00", "Scan: AUDNZD"};
      string confVals[10]  = {"-200.0", "-2.0", "300.0", "3.0", "400.0", "23:50", "23:00", "2025.10.24 15:30", "01:00", "AUDNZD ▼"};

      for(int i=0; i<10; i++)
        {
         uint rowBg = (i % 2 == 0) ? Theme.surface : Theme.bg;
         eng.AddPanel(x + 16, rY, w - 32, rowH, rowBg, 0);
         eng.AddLabel(funcNames[i], cX[0], rY + 8, "Arial", 11, Theme.textDim, TA_LEFT|TA_TOP);

         bool isEn = (i%2 == 0); // Intercalamos ON/OFF para que se vea dinámico
         uint cEnBg = isEn ? Theme.accent : Theme.bg;
         uint cEnTxt = isEn ? Theme.bg : Theme.textDim;
         eng.AddButton(0, cX[1], rY + 4, 50, 24, isEn?"ON":"OFF", cEnBg, Theme.surface, Theme.accent, cEnTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);

         eng.AddLabel(statVals[i], cX[2], rY + 8, "Arial", 11, Theme.textMain, TA_LEFT|TA_TOP);

         if(i == 9) // Dropdown para el Remote
            eng.AddButton(0, cX[3], rY + 4, 85, 24, confVals[i], Theme.surface, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
         else
            eng.AddButton(0, cX[3], rY + 4, 85, 24, confVals[i], Theme.inputBg, Theme.surface, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);

         uint cCeBg = isEn ? Theme.sell : Theme.bg;
         uint cCeTxt = isEn ? Theme.textMain : Theme.textDim;
         eng.AddButton(0, cX[4], rY + 4, 55, 24, isEn?"ON":"OFF", cCeBg, Theme.surface, Theme.sell, cCeTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);

         // Stickers (1 al 10)
         DrawHelpSticker(eng, x + 5, rY, IntegerToString(i+1));
         rY += rowH;
        }
     }

//+------------------------------------------------------------------+
//| MOCKUP: PÁGINA 12 - EXPERT SETTINGS (Cuarto de Máquinas)         |
//+------------------------------------------------------------------+
   void DrawMockup_Settings(CUIEngine &eng, int x, int y, int w)
     {
      int modH = 450;
      // Simulamos una ventana centrada un poco más estrecha, como la real
      int sW = 380;
      int sX = x + (w / 2) - (sW / 2);

      eng.AddPanel(sX, y, sW, modH, Theme.bg, Theme.border);
      eng.AddPanel(sX, y, sW, 40, Theme.surface, Theme.border);
      eng.AddLabel("EXPERT SETTINGS & PRESETS", sX + 15, y + 12, "Arial", 13, Theme.accent, TA_LEFT|TA_TOP);
      eng.AddButton(0, sX + sW - 40, y + 5, 30, 30, "X", Theme.surface, Theme.sell, Theme.sell, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 14);

      int wY = y + 50;
      int pW = sW - 30;

      // --- 1. PRESETS ---
      eng.AddLabel("PANEL PRESETS (Global Folder)", sX + 15, wY, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      wY += 20;
      eng.AddPanel(sX + 15, wY, pW, 80, Theme.surface, Theme.border);

      eng.AddButton(0, sX + 25, wY + 10, pW - 145, 24, "MyStrategy_EURUSD", Theme.inputBg, Theme.inputBg, Theme.inputBg, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      eng.AddButton(0, sX + pW - 100, wY + 10, 50, 24, "SAVE", Theme.surface, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      eng.AddButton(0, sX + pW - 45, wY + 10, 50, 24, "LOAD", Theme.accent, Theme.border, Theme.accent, Theme.bg, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);

      eng.AddButton(0, sX + 25, wY + 42, pW - 85, 24, "MyStrategy_EURUSD ▼", Theme.bg, Theme.border, Theme.surface, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      eng.AddButton(0, sX + pW - 45, wY + 42, 50, 24, "DEL", Theme.surface, Theme.border, Theme.sell, Theme.sell, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);

      DrawHelpSticker(eng, sX - 5, wY + 25, "1");

      wY += 95;

      // --- 2. TEMAS DE COLOR ---
      eng.AddLabel("COLOR THEME", sX + 15, wY, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      wY += 20;
      int thW = (pW - 20) / 5;
      eng.AddButton(0, sX + 15, wY, thW, 30, "Cyber", Theme.surface, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      eng.AddButton(0, sX + 15+(thW+5), wY, thW, 30, "Gold", Theme.surface, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      eng.AddButton(0, sX + 15+(thW+5)*2, wY, thW, 30, "Mid", Theme.accent, Theme.border, Theme.accent, Theme.bg, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      eng.AddButton(0, sX + 15+(thW+5)*3, wY, thW, 30, "Light", Theme.surface, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      eng.AddButton(0, sX + 15+(thW+5)*4, wY, thW, 30, "Rose", Theme.surface, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);

      DrawHelpSticker(eng, sX - 5, wY + 5, "2");

      wY += 45;

      // --- 3. UX TOGGLES ---
      eng.AddLabel("EXPERIENCE & UX", sX + 15, wY, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      wY += 20;
      int btnW = (pW - 10) / 2;
      eng.AddButton(0, sX + 15, wY, btnW, 30, "MT5 History: SHOW", Theme.accent, Theme.border, Theme.accent, Theme.bg, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      eng.AddButton(0, sX + 25 + btnW, wY, btnW, 30, "Auto-Shot: ON", Theme.accent, Theme.border, Theme.accent, Theme.bg, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      DrawHelpSticker(eng, sX + 35, wY + 15, "3");
      DrawHelpSticker(eng, sX + 45 + btnW, wY + 15, "4");
      wY += 35;

      eng.AddButton(0, sX + 15, wY, pW, 30, "Manage All Magic IDs: OFF (EA only)", Theme.surface, Theme.border, Theme.accent, Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      DrawHelpSticker(eng, sX - 5, wY + 5, "5");
      wY += 45;

      // --- 4. MAX SPREAD ---
      eng.AddLabel("SAFETY: MAX SPREAD LIMIT", sX + 15, wY, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      wY += 20;
      eng.AddPanel(sX + 15, wY, pW, 40, Theme.surface, Theme.border);
      eng.AddLabel("Block entries if spread is greater than (Points):", sX + 25, wY + 12, "Arial", 12, Theme.textMain, TA_LEFT|TA_TOP);
      eng.AddButton(0, sX + sW - 95, wY + 7, 70, 26, "20", Theme.inputBg, Theme.inputBg, Theme.inputBg, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      DrawHelpSticker(eng, sX - 5, wY + 10, "6");

      wY += 50;
      eng.AddPanel(sX + 15, wY, pW, 1, Theme.border, 0);
      wY += 10;

      eng.AddButton(0, sX + 15, wY, pW, 30, "CONFIGURE HOTKEYS", Theme.surface, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      DrawHelpSticker(eng, sX - 5, wY + 5, "7");
     }

//+------------------------------------------------------------------+
//| MOCKUP: PÁGINA 13 - HOTKEYS CONFIGURATION                        |
//+------------------------------------------------------------------+
   void DrawMockup_Hotkeys(CUIEngine &eng, int x, int y, int w)
     {
      int modH = 280;
      int sW = 420;
      // Centramos el mockup en la columna izquierda
      int sX = x + (w / 2) - (sW / 2);

      eng.AddPanel(sX, y, sW, modH, Theme.bg, Theme.border);
      eng.AddPanel(sX, y, sW, 40, Theme.surface, Theme.border);
      eng.AddLabel("HOTKEYS CONFIGURATION", sX + 15, y + 12, "Arial", 13, Theme.accent, TA_LEFT|TA_TOP);
      eng.AddButton(0, sX + sW - 40, y + 5, 30, 30, "X", Theme.surface, Theme.sell, Theme.sell, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 14);

      int wY = y + 50;

      // MASTER SWITCH
      eng.AddButton(0, sX + 15, wY, sW - 30, 30, "HOTKEYS: ENABLED", Theme.accent, Theme.border, Theme.accent, Theme.bg, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      DrawHelpSticker(eng, sX + 5, wY - 5, "1");
      wY += 45;

      // MATRIZ DE ACCIONES (Mostramos 5 representativas para no saturar)
      string hkNames[5] = {"Show/Hide Pre-Op Lines", "Execute [GO]", "BUY (Direct)", "Close All Positions", "Close & Delete All & Save"};
      string hkKeys[5]  = {"TAB", "ENTER", "[ PRESS KEY ]", "CTRL + BACKSPACE", "CTRL + 0"};
      bool hkEn[5]      = {true, true, false, true, true};

      for(int i=0; i<5; i++)
        {
         int rY = wY + (i * 32);
         uint rowBg = (i % 2 == 0) ? Theme.surface : Theme.bg;
         eng.AddPanel(sX + 15, rY, sW - 30, 30, rowBg, 0);

         // 1. Etiqueta (Action)
         eng.AddLabel(hkNames[i], sX + 25, rY + 7, "Arial", 12, Theme.textMain, TA_LEFT|TA_TOP);

         // 2. Botón ON/OFF
         uint cEnBg = hkEn[i] ? Theme.buy : Theme.surface;
         eng.AddButton(0, sX + sW - 200, rY + 4, 50, 22, hkEn[i] ? "ON" : "OFF", cEnBg, Theme.border, Theme.buy, hkEn[i]?Theme.bg:Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);

         // 3. Botón de Tecla (El índice 2 simula el modo escucha en rojo)
         uint cKeyBg = (i == 2) ? Theme.sell : Theme.inputBg;
         uint cKeyTxt = (i == 2) ? Theme.textMain : Theme.accent;
         eng.AddButton(0, sX + sW - 140, rY + 4, 115, 22, hkKeys[i], cKeyBg, Theme.border, cKeyBg, cKeyTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);

         // Stickers solo en la primera fila para no ensuciar
         if(i == 0)
           {
            DrawHelpSticker(eng, sX + 15, rY + 10, "2");
            DrawHelpSticker(eng, sX + sW - 210, rY + 10, "3");
            DrawHelpSticker(eng, sX + sW - 150, rY + 10, "4");
           }
        }
     }

//+------------------------------------------------------------------+
//| HELPER: Dibuja un Sticker circular hueco en el Manual            |
//+------------------------------------------------------------------+
   void DrawHelpSticker(CUIEngine &eng, int x, int y, string num)
     {
      // Usamos un Amarillo Eléctrico universal (High Contrast) para que destaque siempre
      uint stickerColor = Theme.textMain;
      eng.AddSticker(x + 8, y + 8, 8, num, "Arial", 10, stickerColor);
     }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
   string GetHelpText(int page, int item)
     {
      if(page == 0) // PÁGINA 1: Pestaña Execute (Setup & Control)
        {
         switch(item)
           {
            case 1:
               return "1. Target Asset: Click to switch to another symbol instantly.";
            case 2:
               return "2. Quick Actions: Toggle Auto-Screenshot and Open Global Settings.";
            case 3:
               return "3. Navigation Tabs: Switch between Trade, Manage, Auto, and Portfolio.";
            case 4:
               return "4. Risk Mode: Choose between % of Balance, Fixed Cash ($), or Fixed Lots.";
            case 5:
               return "5. Lot Size: Displays the calculated lot based on your risk and Stop Loss.";
            case 6:
               return "6. Price Mode: Toggle ON to enter a specific entry price (Limit/Stops).";
            case 7:
               return "7. PSL (Trigger): Stop Limit trigger price. 'Price' becomes the execution level.";
            case 8:
               return "8. RR Mode: Risk/Reward lock. Moving the SL will auto-adjust the TP.";
            case 9:
               return "9. Custom Comment: Type a custom comment for your next trade.";
            case 10:
               return "10. Alarm: Set visual/audio alerts for price crossing horizontal or trend lines.";
            case 11:
               return "11. Hide: Stealth mode. Hides real TP/SL from the broker using virtual lines.";
            case 12:
               return "12. News Filter: Opens the Economic Calendar to filter high/medium events.";
            case 13:
               return "13. Virtual Mode: Converts your pending orders into virtual lines.";
            case 14:
               return "14. Time Trader: Schedule automatic executions, closures, or EA shutdowns.";
            case 15:
               return "15. Protect: Equity Guardian. Set daily loss limits or trailing drawdowns.";
            case 16:
               return "16. Manage All: Allows the EA to monitor and manage trades from other symbols.";
           }
        }
      else
         if(page == 1) // PÁGINA 2: Execution & Status HUD
           {
            switch(item)
              {
               case 1:
                  return "1. Lines Toggle: Hides the Pre-Operation lines (Entry, SL, TP) and cancels the pending setup.";
               case 2:
                  return "2. Reverse (REV): Instantly flips the trade direction (Buy <-> Sell) and recalculates the SL/TP targets.";
               case 3:
                  return "3. Market Mode (M): Snaps the Entry line to the current Bid/Ask price like a magnet.";
               case 4:
                  return "4. Execution Button: One-click send. Dynamically displays the Order Type, Lot Size, and Entry Price.";
               case 5:
                  return "5. Top HUD: Monitors active management modules (Trailing Stop, Break Even, Grid, Split).";
               case 6:
                  return "6. Bottom HUD: Monitors stealth & safety modules (Hide TP/SL, OCO, Virtual Mode, Equity Protect).";
              }
           }
         else
            if(page == 2) // PÁGINA 3: Manage Tab (Grid Trading)
              {
               switch(item)
                 {
                  case 1:
                     return "1. Grid Distance Mode: Choose how to calculate TP/SL levels (Pips, Price, Risk Ratio, or Auto).";
                  case 2:
                     return "2. Grid Lot Mode: Choose how to divide the volume (% of Total, % of Remaining, or Fixed).";
                  case 3:
                     return "3. TP Levels (1-5): Click to activate partial Take Profit targets.";
                  case 4:
                     return "4. TP Distance Input: Set the target distance based on your chosen Distance Mode.";
                  case 5:
                     return "5. TP Volume Input: Set the lot size to close based on your chosen Lot Mode.";
                  case 6:
                     return "6. SL Levels (1-5): Click to activate partial Stop Loss (Scale-Out) targets.";
                  case 7:
                     return "7. SL Distance Input: Set the stop distance based on your chosen Distance Mode.";
                  case 8:
                     return "8. SL Volume Input: Set the lot size to close based on your chosen Lot Mode.";
                  case 9:
                     return "9. Trade Splitting: When ON, the EA sends separate orders to the broker for each Grid level.";
                  case 10:
                     return "10. Hide TP/SL: Stealth mode. Hides real stops from the broker using virtual lines.";
                  case 11:
                     return "11. OCO Order: One Cancels Other. If one pending order triggers, the opposite is deleted.";
                  case 12:
                     return "12. Apply To: Select target trades and click APPLY to inject these settings instantly.";
                 }
              }
            else
               if(page == 3) // PÁGINA 4: Auto Tab (TS & BE)
                 {
                  switch(item)
                    {
                     case 1:
                        return "1. Master Toggle (TS): Enables the Trailing Stop engine for new trades.";
                     case 2:
                        return "2. Operation Mode: Normal (fixed distance), Fractals/Hi-Lo (follows price extremes), MA/PSAR/ATR (follows indicator curves), or Partial (moves SL to Entry after TP1 is hit).";
                     case 3:
                        return "3. Dynamic Parameters: Defines the Start (Trigger point) and specific settings for the chosen mode (e.g. Timeframe, Period). 'Indent' adds extra padding to the trailing line.";
                     case 4:
                        return "4. Master Toggle (BE): Enables the Break Even engine to secure your trades automatically.";
                     case 5:
                        return "5. BE Trigger: The exact distance in profit the price must reach to activate the Break Even.";
                     case 6:
                        return "6. Auto Offset (Smart BE): When ON, the EA calculates your broker's exact spread and live commissions, placing the SL precisely at your mathematical zero-loss point.";
                     case 7:
                        return "7. Apply To: Select target trades (Real, Virtual, or All) to inject these Auto settings instantly.";
                    }
                 }
               else
                  if(page == 4) // PÁGINA 5: Portfolio Tab
                    {
                     switch(item)
                       {
                        case 1:
                           return "1. Advanced Terminal: Opens a floating window with deep Statistics, Account Data, and Multi-Symbol Performance Curves.";
                        case 2:
                           return "2. Group Closures: Categorizes open trades by direction (Buy/Sell) or profitability (Winners/Losers). Click to liquidate entire blocks instantly.";
                        case 3:
                           return "3. Panic Button: The ultimate 'GET ME OUT'. Closes every single active position on your filtered radar.";
                        case 4:
                           return "4. Pending Cleanup: Groups resting orders by type (Stops, Limits, StopLimits). Delete specific sets without touching the rest.";
                        case 5:
                           return "5. Wipe Pending: Instantly deletes all resting orders from the market.";
                        case 6:
                           return "6. All Symbols Toggle: When ON, the Portfolio tab reads and manages every open symbol in your broker simultaneously.";
                        case 7:
                           return "7. All IDs Toggle: When ON, the EA ignores Magic Numbers and manages manual trades placed from your phone or other robots.";
                       }
                    }
                  else
                     if(page == 5) // PÁGINA 6: Advanced Terminal
                       {
                        switch(item)
                          {
                           case 1:
                              return "1. Data Tabs: Switch between Account details, trading Statistics, or current Symbol specifications.";
                           case 2:
                              return "2. Performance Curve: A live, multi-symbol equity curve based on your closed trades history. The line color adapts automatically.";
                           case 3:
                              return "3. Symbol Filter: Filter the entire statistics matrix and the performance chart to show data for a specific asset only.";
                           case 4:
                              return "4. Data Matrix: Displays deep metrics like Profit Factor, Win Rate by direction, Total Net Profit, Margins, and daily/monthly returns.";
                          }
                       }
                     else
                        if(page == 6) // PÁGINA 7: Time Trader
                          {
                           switch(item)
                             {
                              case 1:
                                 return "1. Action Dropdown: Select the order to place (Buy/Sell/Limits) or the action to execute (Close Winners, Delete All, Close specific ID).";
                              case 2:
                                 return "2. Date & Time: Input the exact execution time. Click the top Cyan numbers to instantly sync the inputs to your current broker time.";
                              case 3:
                                 return "3. Active Days (Loop): Toggle specific weekdays. If selected, the task becomes a loop and will reschedule itself automatically for the next active day.";
                              case 4:
                                 return "4. Add Task: Schedules the task. It will secretly clone your current Grid, Break Even, TS, and Risk settings from the main panel.";
                              case 5:
                                 return "5. Task List: Displays your pending schedule. Click the red 'X' to cancel a task.";
                             }
                          }
                        else
                           if(page == 7) // PÁGINA 8: News Filter
                             {
                              switch(item)
                                {
                                 case 1:
                                    return "1. Impact Filters: Toggle High, Medium, or Low impact news to clean the calendar. Only selected impacts are shown.";
                                 case 2:
                                    return "2. Master Toggle: Show or Hide all active news lines on your chart instantly without losing individual settings.";
                                 case 3:
                                    return "3. Date & Time: The exact moment the fundamental event will be released. Past events are hidden automatically.";
                                 case 4:
                                    return "4. Currency: The currency affected by the event. Automatically filtered for your chart's symbol.";
                                 case 5:
                                    return "5. Event Name: The official name of the economic report (e.g., NFP, CPI, FOMC).";
                                 case 6:
                                    return "6. Chart Line Toggle: Turn ON to draw a vertical warning line directly on your MT5 chart for this specific event.";
                                }
                             }
                           else
                              if(page == 8) // PÁGINA 9: Equity Protect (Global)
                                {
                                 switch(item)
                                   {
                                    case 1:
                                       return "1. Account Equity: Your live equity and the highest peak reached today. The peak resets every day at midnight.";
                                    case 2:
                                       return "2. Protect Status: Shows if the EA is SAFE or LOCKED due to a triggered rule. If locked, the EA will block all new trades.";
                                    case 3:
                                       return "3. Server Time: The broker's exact time. This synthetic clock is used for scheduled time detonators, immune to latency.";
                                    case 4:
                                       return "4. Master Switch: Enables or disables the entire protection module. Turn OFF to unlock an account manually.";
                                    case 5:
                                       return "5. Restore Charts: If the 'Close EAs' rule triggered and closed your other charts, click here to reopen them with their original templates.";
                                   }
                                }
                              else
                                 if(page == 9) // PÁGINA 10: Headers & Drawdown
                                   {
                                    switch(item)
                                      {
                                       case 1:
                                          return "1. Function: The name of the protective rule.";
                                       case 2:
                                          return "2. Enable: Toggle the rule ON/OFF individually.";
                                       case 3:
                                          return "3. Status: Live tracking of your current drawdown, profit, or time remaining. Updates even if the rule is disabled.";
                                       case 4:
                                          return "4. Config: Set your threshold. Click to input the limit (e.g., 5.0 for 5%) or time (e.g., 23:50).";
                                       case 5:
                                          return "5. Close EAs: If triggered, the EA will gracefully save the templates of all open MT5 charts and close them to prevent other robots from trading (Fénix Protocol).";
                                       case 6:
                                          return "6. Lower ($): Locks the EA and closes all trades instantly if your Account Equity drops below this exact monetary value.";
                                       case 7:
                                          return "7. Upper ($): Secures your account by locking the EA and closing everything once your Equity reaches this target.";
                                       case 8:
                                          return "8. Trailing Drop ($): A dynamic Stop Loss for your whole account. It trails your Peak Equity. If your equity falls by this amount from the peak, it detonates.";
                                       case 9:
                                          return "9. Trailing Drop (%): Same as above, but measures the drop as a percentage from your Peak Equity.";
                                      }
                                   }
                                 else
                                    if(page == 10) // PÁGINA 11: P/L & Tiempos (10 Filas Juntas)
                                      {
                                       switch(item)
                                         {
                                          case 1:
                                             return "1. Loss ($): Triggers if the combined floating loss of all open trades hits this negative monetary amount.";
                                          case 2:
                                             return "2. Loss (%): Triggers if your floating loss hits this percentage of your starting balance.";
                                          case 3:
                                             return "3. Profit ($): Locks in gains by closing everything when your floating profit reaches this exact amount.";
                                          case 4:
                                             return "4. Profit (%): Same as above, but based on a percentage of your starting balance.";
                                          case 5:
                                             return "5. Profit (Σ) [Sigma]: The ultimate daily goal. Adds your closed profit of the day + your current floating profit. If the sum hits this target, it secures your day.";
                                          case 6:
                                             return "6. Everyday (Time): Closes all trades and locks the EA at this exact time every single day (e.g., 23:50 to avoid swap charges).";
                                          case 7:
                                             return "7. Friday (Time): Triggers only on Fridays at the specified time to prevent holding trades over the weekend.";
                                          case 8:
                                             return "8. Datetime: A one-time scheduled detonation at a specific date and time (e.g., right before a major election).";
                                          case 9:
                                             return "9. Restore (Time): The Auto-Unlocker. If the EA was locked, it will automatically unlock and restore your charts (Fénix Protocol) at this time.";
                                          case 10:
                                             return "10. Remote (Symbol): The Panic Button. Scans a dummy symbol (e.g., AUDNZD). If you open a manual trade on that symbol from your phone, the EA detonates immediately.";
                                         }
                                      }
                                    else
                                       if(page == 11) // PÁGINA 12: EXPERT SETTINGS
                                         {
                                          switch(item)
                                            {
                                             case 1:
                                                return "1. Presets Management: Save your exact panel configuration (Risk, Grid, BE, TS) to a file. These presets are global and can be loaded instantly on any chart or symbol.";
                                             case 2:
                                                return "2. Color Theme: Switch between 5 carefully designed palettes (Cyberpunk, Gold, Midnight, Light, Dreamcore Rose). The interface re-renders instantly at 120fps.";
                                             case 3:
                                                return "3. MT5 History: Toggles the native MetaTrader arrows and dotted lines that show your past trades on the chart. Turn it off to keep your chart completely clean.";
                                             case 4:
                                                return "4. Auto-Shot: When ON, the EA will automatically take a high-resolution screenshot (1920x1080) of your chart the exact millisecond a trade is executed, saving it in the EA's data folder.";
                                             case 5:
                                                return "5. Manage All Magic IDs: By default, the EA only manages trades placed by itself. Turn this ON to allow the EA to manage trades placed manually from your phone, or by other robots (Magic Number 0).";
                                             case 6:
                                                return "6. Max Spread Limit: Safety block. If the broker's current spread exceeds this value (in Points), the EA will block new trade executions and alert you. Set to 0 to disable.";
                                             case 7:
                                                return "7. Configure Hotkeys: Opens the dedicated macro panel to map your physical keyboard to instant EA actions (e.g. Buy, Sell, Close All, Hide Lines).";
                                            }
                                         }
                                       else
                                          if(page == 12) // PÁGINA 13: HOTKEYS
                                            {
                                             switch(item)
                                               {
                                                case 1:
                                                   return "1. Master Switch: Enables or disables the entire hotkeys engine. If disabled, your keyboard presses will not trigger any EA actions.";
                                                case 2:
                                                   return "2. Macro Action: The predefined action the EA will execute. Includes opening trades, closing positions, deleting pending orders, or activating the Nuclear Protect (Save & Close).";
                                                case 3:
                                                   return "3. Enable Toggle: Allows you to turn OFF specific macros you don't use, preventing accidental executions while keeping your favorite hotkeys active.";
                                                case 4:
                                                   return "4. Key Assignment: Click this button to enter 'Listen Mode' (the button will turn red). Then, press any key (or CTRL + Key) on your physical keyboard to bind it. Press ESC to cancel the assignment.";
                                               }
                                            }
                                          else
                                             if(page == 13) // PÁGINA 14: TRADE MANAGER (EA2)
                                               {
                                                switch(item)
                                                  {
                                                   case 1:
                                                      return "1. Base Block: The heart of the EA. Click and hold to drag the order anywhere on the screen. Click the '...' button to open this management menu.";
                                                   case 2:
                                                      return "2. Close / Delete: Instantly liquidates an open position at market price, or removes a pending order from the broker.";
                                                   case 3:
                                                      return "3. Close Partial: (Positions Only). Opens a sub-menu to close a specific percentage (e.g. 50%) of your current active volume.";
                                                   case 4:
                                                      return "4. Reverse: (Positions Only). Closes your current trade and instantly opens a new one in the opposite direction, preserving your Risk settings.";
                                                   case 5:
                                                      return "5. Modify: Opens the manual editing tool. Allows you to input exact prices for Entry, TP, and SL, or adjust the Stop Limit trigger.";
                                                   case 6:
                                                      return "6. TP/SL Grid: Opens the Scale-Out engine. Allows you to set up to 5 partial Take Profits and 5 partial Stop Losses independently.";
                                                   case 7:
                                                      return "7. Trailing Stop: Opens the dynamic TS engine. You can trail by fixed pips, Moving Averages, Fractals, PSAR, or ATR.";
                                                   case 8:
                                                      return "8. Break Even: Opens the BE engine. Secures your trade at entry price (plus auto-calculated spread/commissions) once it reaches your profit target.";
                                                   case 9:
                                                      return "9. Hide TP/SL: STEALTH MODE. When ON, the EA deletes the real TP/SL from the broker. The EA manages the levels securely in your RAM. If used with TS or BE, the virtual lines will trail flawlessly while the broker remains completely blind.";
                                                   case 10:
                                                      return "10. OCO Order: (Pending Only). 'One Cancels Other'. If you have multiple OCO orders on the same symbol, when one triggers, the EA instantly deletes the others.";
                                                   case 11:
                                                      return "11. Expiration: (Pending Only). Spawns a draggable arrow on your chart. Drop the arrow on a specific candle to tell the EA exactly when to delete the pending order if not triggered.";
                                                   case 12:
                                                      return "12. Trailing Order: (Pending Only). Makes your Limit/Stop order chase the current market price at a fixed distance. Perfect for catching pullbacks dynamically.";
                                                  }
                                               }
                                             else
                                                if(page == 14) // PÁGINA 15: MODIFICATION, AUTO & TIME
                                                  {
                                                   switch(item)
                                                     {
                                                      case 1:
                                                         return "1. Modify Menu: Exact price inputs for Entry (or Trigger), TP, and SL. Press APPLY to update the broker instantly. Dragging ghost lines on the chart updates these inputs automatically.";
                                                      case 2:
                                                         return "2. Trailing Order: (Pending Only). Forces your Limit/Stop order to trail the market price at a fixed distance. Perfect for catching pullbacks dynamically.";
                                                      case 3:
                                                         return "3. Expiration Arrow: (Pending Only). Spawns a horizontal timeline with a red arrow. Drag the arrow to anchor it to a specific time. If the order isn't triggered by then, it gets deleted. Drop it in the present to set it as GTC.";
                                                      case 4:
                                                         return "4. Break Even: Secures your trade at entry price once the 'Start' target is reached. If 'AUTO OFFSET' is ON, it calculates spread+commissions and places the SL at the absolute mathematical zero-loss point.";
                                                      case 5:
                                                         return "5. Trailing Stop: 7 dynamic algorithms (Pips, MA, Fractals, PSAR, ATR, Partial TP, Hi-Lo). Defines when to activate (Start) and how far behind the curve to trail (Dist/Indent).";
                                                     }
                                                  }
                                                else
                                                   if(page == 15) // PÁGINA 16: GRID TRADING (Modal)
                                                     {
                                                      switch(item)
                                                        {
                                                         case 1:
                                                            return "1. Distance & Volume Modes: Defines how to calculate TP/SL targets (Pips, Price, Risk Ratio, Auto-Split) and how to divide the volume (% Total, % Remain, Fixed Lots).";
                                                         case 2:
                                                            return "2. TP Scale-Out: Click 'TP1' to activate the level. Input the distance (left) and the volume to close (right). The EA will execute a partial close when price hits this level.";
                                                         case 3:
                                                            return "3. SL Scale-Out: Works exactly like the TP Grid, but for Stop Losses. Allows you to cut your losses gradually instead of closing the entire position at once.";
                                                        }
                                                     }
                                                   else
                                                      if(page == 16) // PÁGINA 17: ARCHITECTURE & PERFORMANCE
                                                        {
                                                         switch(item)
                                                           {
                                                            case 1:
                                                               return "As a solo developer, I built this Expert Advisor with a clear philosophy: zero latency, zero patches, and pure performance. MetaTrader 5 is a powerful platform, but standard API calls can create severe bottlenecks during high volatility. To solve this, TAP bypasses conventional object handling entirely.";
                                                            case 2:
                                                               return "Every UI element is mapped using Bitwise OpCodes packed into 64-bit integers, allowing the engine to recognize clicks and interactions in a single CPU clock cycle (O(1) complexity). There is no slow string parsing; everything is pure, instantaneous math.";
                                                            case 3:
                                                               return "Under the hood, the system runs on a 100% RAM-driven architecture. Market data, grid targets, and trailing algorithms are cached in your PC's memory, shielding the terminal from overload. When you interact with the UI, you are experiencing an 'Optimistic UI'—the interface updates seamlessly at 120 FPS while a background Asynchronous Engine negotiates with the broker.";
                                                            case 4:
                                                               return "Finally, to meet the strict anti-spam rules of modern Prop Firms and institutional A-Book brokers, the core includes a hard-coded Rate Limiter. It strictly throttles outbound requests to a maximum of 2 per millisecond and 10 per second, ensuring your account remains compliant and safe from penalties while delivering high-frequency trading precision.";
                                                           }
                                                        }
      return "";
     }

//+------------------------------------------------------------------+
//| MOTOR PRINCIPAL DE DIBUJO DEL CCANVAS                            |
//+------------------------------------------------------------------+
   void              BuildCanvasUI()
     {
      Engine.Clear();


      int w = 280;
      int h = 545;

      // --- MAGIA DEL MINIMIZADO (WIDGET FLOTANTE) ---
      if(m_isMinimized)
        {
         h = 115; // <--- Aumentamos la altura para hacerle espacio al HUD inferior
        }
      else
         if(Engine.m_openDropdown != 0)
           {
            int pX=0, pY=0, pW=0, pH=0;
            if(Engine.GetButtonCoords(Engine.m_openDropdown, pX, pY, pW, pH))
              {
               int optCount = ArraySize(Engine.m_dropdownOptions);
               int dropBottomY = pY + pH + (optCount * pH) + 5;
               if(dropBottomY > h)
                  h = dropBottomY;
              }
           }

      Engine.Resize(w, h);
      //DrawHeaderGlobal(w);

      DrawHeaderGlobal(Engine, w);

      // --- ENRUTADOR DE ESTADOS ---
      if(m_isMinimized)
        {
         DrawMinimizedWidget(Engine, w, 40);
         DrawStatusHUD(Engine, w, 75);
        }
      else
        {
         DrawNavigationTabs(Engine, w);
         int startY = 80;

         if(g_activeTab == 0)
            DrawTabExecute(Engine, w, h, startY);
         if(g_activeTab == 1)
            DrawTabManage(Engine, w, h, startY);
         if(g_activeTab == 2)
            DrawTabAuto(Engine, w, h, startY);
         if(g_activeTab == 3)
            DrawTabPortfolio(Engine, w, startY);

         if(g_activeTab != 3)
           {
            DrawStickyBottom(Engine, w, 500, m_linesActive);
            DrawStatusHUD(Engine, w, 500);
           }
        }

      Engine.Render();
     }

//+------------------------------------------------------------------+
//| CONSTRUIR VENTANA DE AYUDA (MANUAL INTERACTIVO AISLADO)          |
//+------------------------------------------------------------------+
   void BuildHelpUI()
     {
      HelpWin.Clear();
      if(!g_isHelpOpen)
        {
         HelpWin.DestroyCanvas();
         DWM.UnregisterWindow(GetPointer(HelpWin));
         return;
        }

      int chartW = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);
      int chartH = (int)ChartGetInteger(0, CHART_HEIGHT_IN_PIXELS);

      // --- 1. DIMENSIONES DORADAS ---
      int mW = 880;
      int mH = 600;
      int mX = (chartW / 2) - (mW / 2);
      int mY = (chartH / 2) - (mH / 2);
      if(mY < 10)
         mY = 10;

      if(ObjectFind(0, "CanvasHelp") < 0)
        {
         HelpWin.Init(ENGINE_HELP, "CanvasHelp", mX, mY, mW, mH);
         DWM.RegisterWindow(GetPointer(HelpWin));
        }

      // --- 2. CABECERA Y FONDO PRINCIPAL ---
      HelpWin.AddPanel(0, 0, mW, mH, Theme.bg, Theme.border);
      HelpWin.AddPanel(0, 0, mW, 40, Theme.surface, Theme.border);
      HelpWin.AddLabel("PROYECT PRO - INTERACTIVE USER MANUAL", 15, 12, "Arial", 13, Theme.accent, TA_LEFT|TA_TOP);
      HelpWin.AddButton(OP_HELP_CLOSE, mW - 40, 5, 30, 30, "X", Theme.surface, Theme.sell, Theme.sell, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 14);

      // --- 3. LÓGICA DE LAYOUT INTELIGENTE (Modales vs Panel) ---
      int totalPages = 17; // <--- ACTUALIZADO A 17 PÁGINAS

      // Si estamos en las páginas de Modales (5 a 12), o en el Grid (15) o Arquitectura (16), el área gráfica crece y el texto usa 1 columna.
      bool isModalPage = (g_helpPage >= 5 && g_helpPage <= 12) || g_helpPage >= 15; // <--- BUG DEL GRID ARREGLADO
      int eaX = 15;
      int eaY = 45;
      int eaW = isModalPage ? 480 : 280; // <--- Dinámico
      int eaH = 545;

      int textX = eaX + eaW + 25;
      int textY = eaY;
      int textW = mW - textX - 20;

      string titleStr = "";

      // ENRUTADOR PRINCIPAL (Switch Cero Lag)
      switch(g_helpPage)
        {
         case 0:
            titleStr = "EXECUTE TAB (Pre-Operation & Risk)";
            DrawMockup_ExecuteTab(HelpWin, eaX, eaY, eaW, eaH);
            break;
         case 1:
            titleStr = "EXECUTION & STATUS HUD";
            DrawMockup_BottomZone(HelpWin, eaX, eaY + 120, eaW);
            break;
         case 2:
            titleStr = "MANAGE TAB (Grid Trading & Safety)";
            DrawMockup_ManageTab(HelpWin, eaX, eaY, eaW, eaH);
            break;
         case 3:
            titleStr = "AUTO TAB (Trailing Stop & Break Even)";
            DrawMockup_AutoTab(HelpWin, eaX, eaY, eaW, eaH);
            break;
         case 4:
            titleStr = "PORTFOLIO TAB (Global Management)";
            DrawMockup_PortfolioTab(HelpWin, eaX, eaY, eaW, eaH);
            break;
         case 5:
            titleStr = "ADVANCED PORTFOLIO TERMINAL";
            DrawMockup_AdvancedTerminal(HelpWin, eaX, eaY, eaW, eaH);
            break;
         case 6:
            titleStr = "TIME TRADER SCHEDULER";
            DrawMockup_TimeTrader(HelpWin, eaX, eaY + 30, eaW);
            break;
         case 7:
            titleStr = "ECONOMIC CALENDAR (News Filter)";
            DrawMockup_NewsFilter(HelpWin, eaX, eaY + 30, eaW);
            break;
         case 8:
            titleStr = "EQUITY PROTECT (Global Status)";
            DrawMockup_EquityProtectGlobal(HelpWin, eaX, eaY + 50, eaW);
            break;
         case 9:
            titleStr = "EQUITY PROTECT (Matrix & Drawdown Limits)";
            DrawMockup_Prot_Drawdown(HelpWin, eaX, eaY + 30, eaW);
            break;
         case 10:
            titleStr = "EQUITY PROTECT (Floating P/L, Time & Remote)";
            DrawMockup_Prot_Merged(HelpWin, eaX, eaY + 10, eaW);
            break;
         case 11:
            titleStr = "EXPERT SETTINGS & PRESETS";
            DrawMockup_Settings(HelpWin, eaX, eaY + 20, eaW);
            break;
         case 12:
            titleStr = "HOTKEYS CONFIGURATION";
            DrawMockup_Hotkeys(HelpWin, eaX, eaY + 40, eaW);
            break;
         case 13:
            titleStr = "TRADE MANAGER (Interactive Chart Menu)";
            DrawMockup_EA2_MainMenu(HelpWin, eaX, eaY, eaW);
            break;
         case 14:
            titleStr = "MANAGER: Modification, Auto & Time";
            DrawMockup_EA2_SubModAutoTime(HelpWin, eaX, eaY, eaW);
            break;
         case 15:
            titleStr = "MANAGER: TP/SL Grid (Scale-Out)";
            DrawMockup_EA2_SubGrid(HelpWin, eaX, eaY, eaW);
            break;
         case 16: // <--- NUEVA PÁGINA (Arquitectura HFT)
            titleStr = "UNDER THE HOOD (Engine Architecture)";
            DrawMockup_Architecture(HelpWin, eaX, eaY + 30, eaW);
            break;

         default:
            titleStr = "WORK IN PROGRESS...";
            break;
        }

      // --- 4. DIBUJAR TEXTOS EXPLICATIVOS (Dinámico: 1 o 2 Columnas) ---
      HelpWin.AddLabel(titleStr, textX, textY, "Arial", 14, Theme.accent, TA_LEFT|TA_TOP);
      HelpWin.AddPanel(textX, textY + 25, textW, 1, Theme.border, 0);

      int startY = textY + 40;

      // Si es un modal, usamos el 100% del ancho (1 columna). Si no, dividimos en 2.
      int colWidth  = isModalPage ? textW : ((textW / 2) - 15);
      int col2X     = textX + colWidth + 20;

      int totalItems = 0;
      for(int i = 1; i <= 20; i++)
         if(GetHelpText(g_helpPage, i) != "")
            totalItems = i;

      // Si es un modal, todos los ítems van a la columna 1.
      int halfItems = isModalPage ? totalItems : (int)MathCeil(totalItems / 2.0);

      int currentY1 = startY;
      int currentY2 = startY;

      for(int i = 1; i <= totalItems; i++)
        {
         string lineText = GetHelpText(g_helpPage, i);
         if(lineText != "")
           {
            if(i <= halfItems)
               currentY1 = HelpWin.AddParagraph(lineText, textX, currentY1, colWidth, "Arial", 12, Theme.textMain) + 8;
            else
               currentY2 = HelpWin.AddParagraph(lineText, col2X, currentY2, colWidth, "Arial", 12, Theme.textMain) + 8;
           }
        }

      // --- 5. PIE DE PÁGINA: PAGINACIÓN ---
      int botY = mH - 45;
      HelpWin.AddPanel(textX, botY - 15, textW, 1, Theme.border, 0);

      HelpWin.AddButton(OP_HELP_PREV, textX, botY, 100, 28, "< PREV PAGE", Theme.surface, Theme.border, Theme.surface, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      HelpWin.AddButton(OP_HELP_NEXT, mW - 120, botY, 100, 28, "NEXT PAGE >", Theme.surface, Theme.border, Theme.surface, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);

      string pageTxt = "Page " + IntegerToString(g_helpPage + 1) + " / " + IntegerToString(totalPages);
      HelpWin.AddLabel(pageTxt, textX + (textW / 2), botY + 7, "Arial", 12, Theme.textDim, TA_CENTER|TA_TOP);

      HelpWin.Render();
     }

//+------------------------------------------------------------------+
//| PROCESAR CLICS DEL MANUAL DE AYUDA                               |
//+------------------------------------------------------------------+
   void ProcessHelpClick(int id)
     {
      if(id == OP_HELP_CLOSE)
        {
         g_isHelpOpen = false;
         BuildHelpUI();
        }
      else
         if(id == OP_HELP_PREV)
           {
            g_helpPage--;
            if(g_helpPage < 0)
               g_helpPage = 0;
            BuildHelpUI();
           }
         else
            if(id == OP_HELP_NEXT)
              {
               g_helpPage++;
               int maxPages = 16; // 0 a 12 = 13 páginas totales
               if(g_helpPage > maxPages)
                  g_helpPage = maxPages;
               BuildHelpUI();
              }

     }

//+------------------------------------------------------------------+
//| HELPER: Convierte color ARGB (CCanvas) a color estándar (MT5)    |
//+------------------------------------------------------------------+
   color             ConvertARGBtoColor(uint argb_color)
     {
      // Elimina el canal de transparencia para que MT5 entienda el color nativo
      return (color)(argb_color & 0x00FFFFFF);
     }

// ====================================================================
// MÓDULOS DE DIBUJO (Las Funciones "Obreras")
// ====================================================================


// --------------------------------------------------------------------
// PESTAÑA AUTO (Trailing Stop, Break Even, Apply)
// --------------------------------------------------------------------
   void DrawTabAuto(CUIEngine &eng, int w, int h, int wY)
     {
      int colLeft = 15, usableW = w - 30, rightEdge = colLeft + usableW, halfW = (usableW - 10) / 2;

      uint cTSBg  = m_isTSActive ? Theme.accent : Theme.surface;
      eng.AddButton(OP_TOG_TS, colLeft, wY, halfW, 24, m_isTSActive ? "TRAILING STOP: ON" : "TRAILING STOP: OFF", cTSBg, Theme.border, Theme.accent, m_isTSActive?Theme.bg:Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      eng.AddButton(OP_DROP_TSMODE, colLeft + halfW + 10, wY, halfW, 24, m_tsOptionNames[m_tsMode] + " ▼", Theme.bg, Theme.surface, Theme.surface, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      wY += 30;

      // ==========================================
      // 2. FILAS DINÁMICAS DEL TRAILING STOP
      // ==========================================
      int activeRows = 0;
      string tsLabels[6];
      string tsVals[6];
      int tsTypes[6];
      string tsDrops[6];
      // tsTypes: 1 = Input + Rotativo, 2 = Dropdown, 3 = Solo Input, 4 = Rotativo ON/OFF

      switch(m_tsMode)
        {
         case TS_NORMAL:
            tsLabels[0]="Start:";
            tsVals[0]=GetMemVal(0,0,"20");
            tsTypes[0]=1;
            tsDrops[0]=g_tsUnitOpts[TemplateState.ts.units[0]]+" ▼";
            tsLabels[1]="Dist:";
            tsVals[1]=GetMemVal(0,1,"20");
            tsTypes[1]=1;
            tsDrops[1]=g_tsUnitOpts[TemplateState.ts.units[1]]+" ▼";
            tsLabels[2]="Step:";
            tsVals[2]=GetMemVal(0,2,"5");
            tsTypes[2]=1;
            tsDrops[2]=g_tsUnitOpts[TemplateState.ts.units[2]]+" ▼";
            activeRows=3;
            break;
         case TS_FRACTALS:
            tsLabels[0]="Start:";
            tsVals[0]=GetMemVal(0,0,"20");
            tsTypes[0]=1;
            tsDrops[0]=g_tsUnitOpts[TemplateState.ts.units[0]]+" ▼";
            tsLabels[1]="Timeframe:";
            tsVals[1]="";
            tsTypes[1]=2;
            tsDrops[1]=m_tfOptions[TemplateState.ts.dropIdx[1]]+" ▼";
            tsLabels[2]="Scan Bar:";
            tsVals[2]=GetMemVal(0,2,"2");
            tsTypes[2]=3;
            tsDrops[2]="";
            tsLabels[3]="Indent:";
            tsVals[3]=GetMemVal(0,3,"2");
            tsTypes[3]=1;
            tsDrops[3]=g_tsUnitOpts[TemplateState.ts.units[3]]+" ▼";
            activeRows=4;
            break;
         case TS_MA:
            tsLabels[0]="Start:";
            tsVals[0]=GetMemVal(0,0,"20");
            tsTypes[0]=1;
            tsDrops[0]=g_tsUnitOpts[TemplateState.ts.units[0]]+" ▼";
            tsLabels[1]="Timeframe:";
            tsVals[1]="";
            tsTypes[1]=2;
            tsDrops[1]=m_tfOptions[TemplateState.ts.dropIdx[1]]+" ▼";
            tsLabels[2]="Period:";
            tsVals[2]=GetMemVal(0,2,"50");
            tsTypes[2]=3;
            tsDrops[2]="";
            tsLabels[3]="Method:";
            tsVals[3]="";
            tsTypes[3]=2;
            tsDrops[3]=m_maMethods[TemplateState.ts.dropIdx[3]]+" ▼";
            tsLabels[4]="Apply:";
            tsVals[4]="";
            tsTypes[4]=2;
            tsDrops[4]=m_maPrices[TemplateState.ts.dropIdx[4]]+" ▼";
            tsLabels[5]="Indent:";
            tsVals[5]=GetMemVal(0,5,"0");
            tsTypes[5]=1;
            tsDrops[5]=g_tsUnitOpts[TemplateState.ts.units[5]]+" ▼";
            activeRows=6;
            break;
         case TS_PSAR:
            tsLabels[0]="Start:";
            tsVals[0]=GetMemVal(0,0,"20");
            tsTypes[0]=1;
            tsDrops[0]=g_tsUnitOpts[TemplateState.ts.units[0]]+" ▼";
            tsLabels[1]="Timeframe:";
            tsVals[1]="";
            tsTypes[1]=2;
            tsDrops[1]=m_tfOptions[TemplateState.ts.dropIdx[1]]+" ▼";
            tsLabels[2]="Step:";
            tsVals[2]=GetMemVal(0,2,"0.02");
            tsTypes[2]=3;
            tsDrops[2]="";
            tsLabels[3]="Max:";
            tsVals[3]=GetMemVal(0,3,"0.2");
            tsTypes[3]=3;
            tsDrops[3]="";
            tsLabels[4]="Indent:";
            tsVals[4]=GetMemVal(0,4,"5");
            tsTypes[4]=1;
            tsDrops[4]=g_tsUnitOpts[TemplateState.ts.units[4]]+" ▼";
            activeRows=5;
            break;
         case TS_ATR:
            tsLabels[0]="Start:";
            tsVals[0]=GetMemVal(0,0,"20");
            tsTypes[0]=1;
            tsDrops[0]=g_tsUnitOpts[TemplateState.ts.units[0]]+" ▼";
            tsLabels[1]="Timeframe:";
            tsVals[1]="";
            tsTypes[1]=2;
            tsDrops[1]=m_tfOptions[TemplateState.ts.dropIdx[1]]+" ▼";
            tsLabels[2]="Period:";
            tsVals[2]=GetMemVal(0,2,"14");
            tsTypes[2]=3;
            tsDrops[2]="";
            tsLabels[3]="Coeff:";
            tsVals[3]=GetMemVal(0,3,"1.5");
            tsTypes[3]=3;
            tsDrops[3]="";
            tsLabels[4]="High/Low:";
            tsVals[4]="";
            tsTypes[4]=4;
            tsDrops[4]=(TemplateState.ts.units[4]==1)?"ON":"OFF";
            tsLabels[5]="SL=ATR*:";
            tsVals[5]="";
            tsTypes[5]=4;
            tsDrops[5]=(TemplateState.ts.units[5]==1)?"ON":"OFF";
            activeRows=6;
            break;
         case TS_PARTIAL:
            tsLabels[0]="TP1 Modify:";
            tsVals[0]="";
            tsTypes[0]=4;
            tsDrops[0]=(TemplateState.ts.units[0]==1)?"ON":"OFF";
            activeRows=1;
            break;
         case TS_HILO:
            tsLabels[0]="Start:";
            tsVals[0]=GetMemVal(0,0,"20");
            tsTypes[0]=1;
            tsDrops[0]=g_tsUnitOpts[TemplateState.ts.units[0]]+" ▼";
            tsLabels[1]="Timeframe:";
            tsVals[1]="";
            tsTypes[1]=2;
            tsDrops[1]=m_tfOptions[TemplateState.ts.dropIdx[1]]+" ▼";
            tsLabels[2]="Length:";
            tsVals[2]=GetMemVal(0,2,"5");
            tsTypes[2]=3;
            tsDrops[2]="";
            tsLabels[3]="Indent:";
            tsVals[3]=GetMemVal(0,3,"2");
            tsTypes[3]=1;
            tsDrops[3]=g_tsUnitOpts[TemplateState.ts.units[3]]+" ▼";
            activeRows=4;
            break;
        }

      int rowH = 20;
      int gap = 2;
      for(int i=0; i<activeRows; i++)
        {
         int rY = wY + (i * (rowH + gap));
         eng.AddLabel(tsLabels[i], colLeft, rY+3, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
         string id = IntegerToString(i);

         if(tsTypes[i] == 1) // Input + Unidad Rotativa (Ej: Start, Dist)
           {
            int inpX = rightEdge - 115;
            int inpW = 50;
            string strTsVal = DoubleToString(TemplateState.ts.inputs[i], (TemplateState.ts.units[i]==0)?0:2);
            eng.AddButton((ushort)(OP_INP_TS_0 + i), inpX, rY, inpW, rowH, strTsVal, Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

            eng.AddButton(OP_TS_U_0 + i, rightEdge - 60, rY, 60, rowH, tsDrops[i], Theme.surface, Theme.border, Theme.accent, Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
           }
         else
            if(tsTypes[i] == 3) // Solo Input (Ej: Periodo, Paso)
              {
               int inpX = rightEdge - 115;
               int inpW = 115;
               string strTsVal = DoubleToString(TemplateState.ts.inputs[i], 2);
               eng.AddButton((ushort)(OP_INP_TS_0 + i), inpX, rY, inpW, rowH, strTsVal, Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
              }
            else
               if(tsTypes[i] == 2) // Dropdown Completo (TF, Método...)
                 {
                  // CORRECCIÓN: Usar OpCode matemático en lugar de string
                  eng.AddButton(OP_TS_DROP_0 + i, rightEdge - 115, rY, 115, rowH, tsDrops[i], Theme.bg, Theme.surface, Theme.surface, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

                 }

               else
                  if(tsTypes[i] == 4) // Toggle Rotativo ON/OFF
                    {
                     uint cTog = (tsDrops[i] == "ON") ? Theme.buy : Theme.surface;
                     uint cTogTxt = (tsDrops[i] == "ON") ? Theme.bg : Theme.textDim;

                     // CORRECCIÓN: Usar OpCode matemático en lugar de string
                     eng.AddButton(OP_TS_U_0 + i, rightEdge - 115, rY, 115, rowH, tsDrops[i], cTog, Theme.border, Theme.accent, cTogTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

                    }
        }

      wY += (6 * 22) + 6; // Asumiendo altura promedio

      eng.AddPanel(colLeft, wY, usableW, 1, Theme.border, 0);
      wY += 8;

      uint cBEBg  = m_isBEActive ? Theme.accent : Theme.surface;
      eng.AddButton(OP_TOG_BE, colLeft, wY, usableW, 24, m_isBEActive ? "BREAK EVEN: ON" : "BREAK EVEN: OFF", cBEBg, Theme.border, Theme.accent, m_isBEActive?Theme.bg:Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      wY += 28;

      // --- TRIGGER ---
      int beInpX = rightEdge - 115;
      eng.AddLabel("Trigger:", colLeft, wY+3, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);

      string strBeSt = DoubleToString(TemplateState.be.valStart, (TemplateState.be.modeStart==0)?0:2);
      eng.AddButton(OP_INP_BE_START, beInpX, wY, 50, 20, strBeSt, Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      eng.AddButton(OP_BE_U_1, rightEdge - 60, wY, 60, 20, g_beModes[TemplateState.be.modeStart] + " ▼", Theme.surface, Theme.border, Theme.accent, Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      wY += 22;

      // --- OFFSET ---
      eng.AddLabel("Offset:", colLeft, wY+3, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      uint cOffBg = m_isBE_AutoOffset ? Theme.bg : Theme.inputBg;

      string strBeOff = m_isBE_AutoOffset ? "AUTO" : DoubleToString(TemplateState.be.valOffset, (TemplateState.be.modeOffset==0)?0:2);
      eng.AddButton(OP_INP_BE_OFFSET, beInpX, wY, 50, 20, strBeOff, cOffBg, Theme.border, Theme.accent, m_isBE_AutoOffset?Theme.textDim:Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      eng.AddButton(OP_BE_U_2, rightEdge - 60, wY, 60, 20, g_beModes[TemplateState.be.modeOffset] + " ▼", Theme.surface, Theme.border, Theme.accent, Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      wY += 22;

      uint cAutoBg  = m_isBE_AutoOffset ? Theme.accent : Theme.surface;
      eng.AddButton(OP_TOG_BEAUTO, rightEdge - 115, wY, 115, 20, "AUTO OFFSET", cAutoBg, Theme.border, Theme.accent, m_isBE_AutoOffset?Theme.bg:Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      int applyY = h - 180;
      eng.AddPanel(colLeft, applyY - 7, usableW, 1, Theme.border, 0);
      //eng.AddLabel("Apply To:", colLeft, applyY + 4, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      eng.AddButton(OP_DROP_APPLY_AUTO, colLeft, applyY, usableW - 66, 22, g_applyTargetAuto, Theme.bg, Theme.surface, Theme.surface, Theme.textMain, Theme.border, TA_LEFT|TA_VCENTER, "Arial", 11);
      eng.AddButton(OP_BTN_APPLY_AUTO, colLeft + usableW - 60, applyY, 60, 22, "APPLY", Theme.surface, Theme.border, Theme.accent, Theme.accent, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
     }

//+------------------------------------------------------------------+
//| DIBUJO DE PESTAÑA PORTFOLIO (FILTROS INDEPENDIENTES Y CONTADORES)|
//+------------------------------------------------------------------+
   void DrawTabPortfolio(CUIEngine &eng, int w, int wY)
     {
      // --- CÁLCULO DE DATOS REALES ---
      double sumBuy=0, sumSell=0, sumWin=0, sumLoss=0;
      int cntBuy=0, cntSell=0, cntWin=0, cntLoss=0;
      int cBS=0, cBL=0, cSS=0, cSL=0, cBSL=0, cSSL=0;

      // 1. FIX: USAR g_portAllSymbols EN VEZ DE m_manageAllSymbols
      for(int i=0; i<PositionsTotal(); i++)
        {
         ulong tk = PositionGetTicket(i);
         if(tk > 0 && (g_portAllSymbols || PositionGetString(POSITION_SYMBOL) == _Symbol))
           {
            // 🛡️ FILTRO MAGIC NUMBER (PORTFOLIO)
            if(!g_portAllMagics && PositionGetInteger(POSITION_MAGIC) != MAGIC_NUM)
               continue;

            double prof = PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP) + GetPositionCommission(tk);
            long type = PositionGetInteger(POSITION_TYPE);
            if(type == POSITION_TYPE_BUY)
              {
               sumBuy += prof;
               cntBuy++;
              }
            if(type == POSITION_TYPE_SELL)
              {
               sumSell += prof;
               cntSell++;
              }
            if(prof >= 0)
              {
               sumWin += prof;
               cntWin++;
              }
            else
              {
               sumLoss += prof;
               cntLoss++;
              }
           }
        }
      // 3. NUEVO: CONTAR ÓRDENES VIRTUALES DESDE LA RAM
      int memTotal = TradeRAM.Total();
      for(int i = 0; i < memTotal; i++)
        {
         CTradeState *mem = TradeRAM.GetByIndex(i);

         // Solo nos importan los tickets válidos que sean 100% Virtuales
         if(CheckPointer(mem) == POINTER_INVALID || !mem.isVirtual || mem.ticket == 0)
            continue;

         // Respetar el Filtro de "This Symbol" o "All Symbols"
         if(!g_portAllSymbols && mem.symbol != _Symbol)
            continue;

         // Nota: No filtramos por MagicNumber porque las virtuales son creadas por este EA por definición.

         long type = mem.virtType;

         if(type == ORDER_TYPE_BUY_STOP)
            cBS++;
         else
            if(type == ORDER_TYPE_BUY_LIMIT)
               cBL++;
            else
               if(type == ORDER_TYPE_SELL_STOP)
                  cSS++;
               else
                  if(type == ORDER_TYPE_SELL_LIMIT)
                     cSL++;
                  else
                     if(type == ORDER_TYPE_BUY_STOP_LIMIT)
                        cBSL++;
                     else
                        if(type == ORDER_TYPE_SELL_STOP_LIMIT)
                           cSSL++;
        }

      // 2. FIX: USAR g_portAllSymbols EN VEZ DE m_manageAllSymbols
      for(int i=0; i<OrdersTotal(); i++)
        {
         ulong tk = OrderGetTicket(i);
         if(tk > 0 && (g_portAllSymbols || OrderGetString(ORDER_SYMBOL) == _Symbol))
           {
            // 🛡️ FILTRO MAGIC NUMBER BLINDADO PARA PORTFOLIO
            if(!g_portAllMagics && OrderGetInteger(ORDER_MAGIC) != MAGIC_NUM)
               continue;

            long type = OrderGetInteger(ORDER_TYPE);
            if(type == ORDER_TYPE_BUY_STOP)
               cBS++;
            else
               if(type == ORDER_TYPE_BUY_LIMIT)
                  cBL++;
               else
                  if(type == ORDER_TYPE_SELL_STOP)
                     cSS++;
                  else
                     if(type == ORDER_TYPE_SELL_LIMIT)
                        cSL++;
                     else
                        if(type == ORDER_TYPE_BUY_STOP_LIMIT)
                           cBSL++;
                        else
                           if(type == ORDER_TYPE_SELL_STOP_LIMIT)
                              cSSL++;
           }

        }

      string cur = AccountInfoString(ACCOUNT_CURRENCY);
      eng.AddLabel("Balance:", 15, wY, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      eng.AddLabel(DoubleToString(AccountInfoDouble(ACCOUNT_BALANCE), 2) + " " + cur, w-15, wY, "Arial", 14, Theme.textMain, TA_RIGHT|TA_TOP);
      wY += 22;
      uint mutedRed = ColorToARGB(C'140,40,45', 255);

      double floatPL = AccountInfoDouble(ACCOUNT_PROFIT);
      eng.AddLabel("Floating P/L:", 15, wY, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      eng.AddLabel((floatPL >= 0 ? "+" : "") + DoubleToString(floatPL, 2) + " " + cur, w-15, wY, "Arial", 14, (floatPL >= 0 ? Theme.buy : Theme.sell), TA_RIGHT|TA_TOP);
      wY += 26;

      eng.AddButton(OP_PORT_MORE_INFO, 15, wY, w-30, 24, "More Info (Account, Stats) >", Theme.bg, Theme.surface, Theme.surface, Theme.accent, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      wY += 32;

      int cardW = (w - 40) / 2, cardH = 72, col1 = 15, col2 = 15 + cardW + 10;

      // BUY
      eng.AddPanel(col1, wY, cardW, cardH, Theme.surface, Theme.border);
      eng.AddLabel("BUY ("+IntegerToString(cntBuy)+")", col1+10, wY+8, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      eng.AddLabel((sumBuy>=0?"+":"")+DoubleToString(sumBuy,2), col1+10, wY+22, "Arial", 14, (sumBuy>=0?Theme.buy:Theme.sell), TA_LEFT|TA_TOP);
      eng.AddButton(OP_PORT_CB, col1+10, wY+42, cardW-20, 22, "CLOSE BUYS", Theme.bg, Theme.border, Theme.accent, Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      // SELL
      eng.AddPanel(col2, wY, cardW, cardH, Theme.surface, Theme.border);
      eng.AddLabel("SELL ("+IntegerToString(cntSell)+")", col2+10, wY+8, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      eng.AddLabel((sumSell>=0?"+":"")+DoubleToString(sumSell,2), col2+10, wY+22, "Arial", 14, (sumSell>=0?Theme.buy:Theme.sell), TA_LEFT|TA_TOP);
      eng.AddButton(OP_PORT_CS, col2+10, wY+42, cardW-20, 22, "CLOSE SELLS", Theme.bg, Theme.border, Theme.accent, Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      wY += cardH + 8;

      // WINNERS
      eng.AddPanel(col1, wY, cardW, cardH, Theme.surface, Theme.border);
      eng.AddLabel("WINNERS ("+IntegerToString(cntWin)+")", col1+10, wY+8, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      eng.AddLabel("+"+DoubleToString(sumWin,2), col1+10, wY+22, "Arial", 14, Theme.buy, TA_LEFT|TA_TOP);
      eng.AddButton(OP_PORT_CW, col1+10, wY+42, cardW-20, 22, "CLOSE WINNERS", Theme.bg, Theme.border, Theme.accent, Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      // LOSERS
      eng.AddPanel(col2, wY, cardW, cardH, Theme.surface, Theme.border);
      eng.AddLabel("LOSERS ("+IntegerToString(cntLoss)+")", col2+10, wY+8, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      eng.AddLabel(DoubleToString(sumLoss,2), col2+10, wY+22, "Arial", 14, Theme.sell, TA_LEFT|TA_TOP);
      eng.AddButton(OP_PORT_CL, col2+10, wY+42, cardW-20, 22, "CLOSE LOSERS", Theme.bg, Theme.border, Theme.accent, Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      // =======================================================================
      // GEOMETRÍA COMPRIMIDA PARA HACER ESPACIO A LOS STOP LIMITS
      // =======================================================================
      wY += cardH + 12; // Gap reducido
      eng.AddButton(OP_PORT_CLOSE_ALL, 15, wY, w-30, 26, "CLOSE ALL OPEN POSITIONS", mutedRed, Theme.border, Theme.sell, Theme.textMain, mutedRed, TA_CENTER|TA_VCENTER, "Arial", 13);

      wY += 34; // Gap reducido
      eng.AddPanel(15, wY, w-30, 1, Theme.border, 0);
      wY += 8;  // Gap reducido

      // Medidas de botones a 2 columnas
      int pBtnW = (w - 40) / 2, pBtnH = 22, pGap  = 25; // Botones más bajos, gaps más apretados

      // --- FILA 1: STOPS ---
      eng.AddButton(OP_PORT_D_BSTOP, 15, wY, pBtnW, pBtnH, "Buy Stops (" + IntegerToString(cBS) + ")", Theme.bg, Theme.surface, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      eng.AddButton(OP_PORT_D_SSTOP, 25+pBtnW, wY, pBtnW, pBtnH, "Sell Stops (" + IntegerToString(cSS) + ")", Theme.bg, Theme.surface, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      wY += pGap;

      // --- FILA 2: LIMITS ---
      eng.AddButton(OP_PORT_D_BLIM, 15, wY, pBtnW, pBtnH, "Buy Limits (" + IntegerToString(cBL) + ")", Theme.bg, Theme.surface, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      eng.AddButton(OP_PORT_D_SLIM, 25+pBtnW, wY, pBtnW, pBtnH, "Sell Limits (" + IntegerToString(cSL) + ")", Theme.bg, Theme.surface, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      wY += pGap;

      // --- FILA 3: STOP LIMITS (NUEVOS) ---
      eng.AddButton(OP_PORT_D_BSLIM, 15, wY, pBtnW, pBtnH, "Buy StpLims (" + IntegerToString(cBSL) + ")", Theme.bg, Theme.surface, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      eng.AddButton(OP_PORT_D_SSLIM, 25+pBtnW, wY, pBtnW, pBtnH, "Sell StpLims (" + IntegerToString(cSSL) + ")", Theme.bg, Theme.surface, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      wY += pGap;

      // --- FILA 4: DELETE ALL BY CATEGORY (3 COLUMNAS) ---
      int pBtnW3 = (w - 45) / 3; // 3 botones simétricos
      eng.AddButton(OP_PORT_D_ALLSTOPS, 15, wY, pBtnW3, pBtnH, "Del Stops", Theme.surface, Theme.border, Theme.accent, Theme.accent, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      eng.AddButton(OP_PORT_D_ALLLIMITS, 15+pBtnW3+7, wY, pBtnW3, pBtnH, "Del Limits", Theme.surface, Theme.border, Theme.accent, Theme.accent, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      eng.AddButton(OP_PORT_D_ALLSLIMS, 15+(pBtnW3*2)+14, wY, pBtnW3, pBtnH, "Del S-Lims", Theme.surface, Theme.border, Theme.accent, Theme.accent, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      wY += pGap + 4; // Un extra de respiro antes del botón gigante

      // --- FILA 5: DELETE ALL PENDING ---
      eng.AddButton(OP_PORT_DEL_ALL, 15, wY, w-30, 26, "DELETE ALL PENDING", Theme.surface, Theme.border, Theme.sell, mutedRed, mutedRed, TA_CENTER|TA_VCENTER, "Arial", 13);
      wY += 34; // Gap reducido

      eng.AddPanel(15, wY, w-30, 1, Theme.border, 0);
      wY += 6;

      // --- TOGGLES GLOBALES ---
      uint cSymBg = g_portAllSymbols ? Theme.accent : Theme.surface;
      eng.AddButton(OP_PORT_TOG_SYM, 15, wY, pBtnW, 24, "All Symbols", cSymBg, Theme.border, Theme.accent, g_portAllSymbols?Theme.bg:Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      uint cIdBg = g_portAllMagics ? Theme.accent : Theme.surface;
      eng.AddButton(OP_PORT_TOG_ID, 25+pBtnW, wY, pBtnW, 24, "All IDs", cIdBg, Theme.border, Theme.accent, g_portAllMagics?Theme.bg:Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
     }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
   void DrawHeaderGlobal(CUIEngine &eng, int w)
     {
      eng.AddPanel(1, 1, w-2, 38, Theme.surface, 0);

      // Botón Símbolo (Reducido a 65px)
      eng.AddButton(OP_BTN_SYMBOL, 7, 8, 65, 20, _Symbol + "▼", Theme.surface, Theme.border, Theme.inputBg, Theme.textMain, 0, TA_LEFT|TA_VCENTER, "Arial", 12);

      // Botón Cámara (Nuevo - 18x18px)
      eng.AddButton(OP_BTN_SCREENSHOT, 77, 8, 20, 20, "", Theme.surface, Theme.border, Theme.border, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 14, false, VICON_CAMERA);

      eng.AddLabel("TAP", 150, 10, "Rockwell", 20, Theme.textDim, TA_CENTER|TA_TOP);

      // Botón Ajustes (La Tuerca) - ID 190
      eng.AddButton(OP_BTN_SETTINGS, w - 75, 8, 20, 20, "", Theme.surface, Theme.border, Theme.border, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 14, false, VICON_GEAR);

      // Botones Minimizar y Cerrar
      eng.AddButton(19, w - 50, 8, 20, 20, m_isMinimized ? "□" : "_", Theme.surface, Theme.border, Theme.border, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 14);
      eng.AddButton(OP_BTN_CLOSE_EA, w - 25, 8, 20, 20, "✕", Theme.surface, Theme.sell, Theme.sell, Theme.sell, 0, TA_CENTER|TA_VCENTER, "Arial", 14);
     }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
   void DrawNavigationTabs(CUIEngine &eng, int w)
     {
      int tY = 40;
      int wTrade  = (w * 22) / 100;
      int wManage = (w * 25) / 100;
      int wAuto   = (w * 20) / 100;
      int wPort   = w - wTrade - wManage - wAuto - 1;

      uint cTab0 = (g_activeTab == 0) ? Theme.accent : Theme.textDim;
      uint cTab1 = (g_activeTab == 1) ? Theme.accent : Theme.textDim;
      uint cTab2 = (g_activeTab == 2) ? Theme.accent : Theme.textDim;
      uint cTab3 = (g_activeTab == 3) ? Theme.accent : Theme.textDim;

      int xT = 0;
      eng.AddButton(OP_TAB_EXEC,   xT, tY, wTrade,  30, "TRADE",     Theme.bg, Theme.surface, Theme.surface, cTab0, 0, TA_CENTER|TA_VCENTER, "Arial", 12);
      xT += wTrade;
      eng.AddButton(OP_TAB_MANAGE, xT, tY, wManage, 30, "MANAGE",    Theme.bg, Theme.surface, Theme.surface, cTab1, 0, TA_CENTER|TA_VCENTER, "Arial", 12);
      xT += wManage;
      eng.AddButton(OP_TAB_AUTO,   xT, tY, wAuto,   30, "AUTO",      Theme.bg, Theme.surface, Theme.surface, cTab2, 0, TA_CENTER|TA_VCENTER, "Arial", 12);
      xT += wAuto;
      eng.AddButton(OP_TAB_PORT,   xT, tY, wPort,   30, "PORTFOLIO", Theme.bg, Theme.surface, Theme.surface, cTab3, 0, TA_CENTER|TA_VCENTER, "Arial", 12);

      eng.AddPanel(1, tY+29, w-2, 1, Theme.border, 0);
     }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
   void DrawTabExecute(CUIEngine &eng, int w, int h, int wY)
     {
      int colLeft  = 15;
      int usableW  = w - 30;
      int halfW    = (usableW - 10) / 2; // 120px exactos por columna
      int colRight = colLeft + halfW + 10; // 145px inicio columna derecha

      // =========================================================
      // BLOQUE 1: GESTIÓN DE DINERO (Risk & Lot Size)
      // =========================================================
      string txtRisk = (m_riskMode == RISK_PERCENT) ? "Risk (%) ▼" : (m_riskMode == RISK_MONEY) ? "Cash ($) ▼" : "Fix Lot ▼";

      // Labels/Dropdowns (Tamaño 12, Centrados matemáticamente)
      eng.AddButton(OP_DROP_RISK, colLeft, wY, halfW, 22, txtRisk, Theme.bg, Theme.surface, Theme.surface, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 12);
      eng.AddLabel("Lot Size:", colRight + (halfW / 2), wY + 3, "Arial", 12, Theme.textDim, TA_CENTER|TA_TOP);
      wY += 24;

      // Fondos y Textos dinámicos
      uint cRiskBg  = (m_riskMode == FIXED_LOT) ? Theme.bg : Theme.inputBg;
      uint cLotBg   = (m_riskMode == FIXED_LOT) ? Theme.inputBg : Theme.bg;
      uint cRiskTxt = (m_riskMode == FIXED_LOT) ? Theme.textDim : Theme.textMain;
      uint cLotTxt  = (m_riskMode == FIXED_LOT) ? Theme.textMain : Theme.textDim;

      // Inputs
      //eng.AddPanel(colLeft, wY, halfW, 24, cRiskBg, Theme.border);
      string strRisk = DoubleToString(PanelState.GetRisk(), 2);
      eng.AddButton(OP_INP_RISK, colLeft, wY, halfW, 24, strRisk, cRiskBg, Theme.border, Theme.accent, cRiskTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      eng.AddPanel(colRight, wY, halfW, 24, cLotBg, Theme.border);
      string strLot = DoubleToString(PanelState.GetLot(), 2);
      eng.AddButton(OP_INP_LOT, colRight, wY, halfW, 24, strLot, cLotBg, Theme.border, Theme.accent, cLotTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      wY += 32;

      // LÍNEA SEPARADORA Y EMPUJE
      eng.AddPanel(colLeft, wY, usableW, 1, Theme.border, 0);
      wY += 12;

      // =========================================================
      // BLOQUE 2: PARÁMETROS DEL TRADE (Doble Tabla Simétrica)
      // =========================================================
      // Dimensiones internas de las columnas (Total = 120px)
      int lblW = 65; // Ancho para botones/textos
      int gap  = 5;  // Espacio en medio
      int inpW = halfW - lblW - gap; // 50px para los inputs

      uint cPriceBg    = m_isPriceMode ? Theme.accent : Theme.bg;
      uint cPriceTxt   = m_isPriceMode ? Theme.bg : Theme.textDim;
      uint cInpPriceBg = m_isPriceMode ? Theme.inputBg : Theme.bg;
      uint cInpPriceTxt= m_isPriceMode ? Theme.textMain : Theme.textDim;

      uint cRRBg  = m_isRRActive ? Theme.accent : Theme.surface;
      uint cRRTxt = m_isRRActive ? Theme.bg : Theme.textDim;

      // --- FILA 1 ---
      // Izquierda: Botón Price + Input
      eng.AddButton(OP_TOG_PRICE, colLeft, wY, lblW, 24, m_isPriceMode ? "Price: ON" : "Price: OFF", cPriceBg, Theme.surface, Theme.surface, cPriceTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      string strPrice = (PanelState.GetPrice() == 0.0) ? "---" : DoubleToString(PanelState.GetPrice(), _Digits);
      eng.AddButton(OP_INP_PRICE, colLeft + lblW + gap, wY, inpW, 24, strPrice, cInpPriceBg, Theme.border, Theme.accent, cInpPriceTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      // Derecha: Dinámica (Efecto Tetris para Stop Limit)
      if(!m_isStopLimitMode)
        {
         // Normal: RR ocupa todo el ancho
         eng.AddButton(OP_TOG_RR, colRight, wY, halfW, 24, m_isRRActive ? "RR: ON" : "RR: OFF", cRRBg, Theme.border, Theme.accent, cRRTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
        }
      else
        {
         // Stop Limit ON: Encogemos RR y mostramos input PSL
         int lblPslW = 15;
         int inpPslW = 45;
         int btnRRW  = halfW - lblPslW - inpPslW - (gap * 2); // Espacio sobrante para el botón RR (aprox 30px)

         eng.AddLabel("PSL:", colRight-4, wY + 7, "Arial", 11, Theme.textDim, TA_LEFT|TA_TOP);

         // Calcular el valor a mostrar (Precio o Pips)
         double slimPrice = ObjectGetDouble(m_chartId, m_lineStopLimit, OBJPROP_PRICE);
         double entryP    = ObjectGetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE);
         string strSLim   = "---";

         if(slimPrice > 0 && entryP > 0)
           {
            if(m_isPriceMode)
               strSLim = DoubleToString(slimPrice, _Digits);
            else
               strSLim = DoubleToString(MathAbs(slimPrice - entryP) / Market.multiplier, 1);
           }

         eng.AddButton(OP_INP_STOPLIMIT, colRight + lblPslW, wY, inpW, 24, strSLim, Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
         eng.AddButton(OP_TOG_RR, colRight + lblW + gap, wY, inpW, 24, m_isRRActive ? "RR: OFF" : "RR: ON", cRRBg, Theme.border, Theme.accent, cRRTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
        }
      wY += 30;

      // --- FILA 2 ---
      // Izquierda: TP Principal
      eng.AddLabel("TP:", colLeft + (lblW / 2), wY + 4, "Arial", 12, Theme.textDim, TA_CENTER|TA_TOP);
      string strTP = DoubleToString(PanelState.GetTP(), m_isPriceMode ? _Digits : 1);
      eng.AddButton(OP_INP_TP, colLeft + lblW + gap, wY, inpW, 24, strTP, Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      eng.AddLabel("TP:", colRight + (lblW / 2), wY + 4, "Arial", 12, Theme.textDim, TA_CENTER|TA_TOP);
      string strRkRw = DoubleToString(PanelState.GetRR_Reward(), 2);
      eng.AddButton(OP_INP_RR_REWARD, colRight + lblW + gap, wY, inpW, 24, strRkRw, Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      wY += 30;

      // --- FILA 3 ---
      // Izquierda: SL Principal
      eng.AddLabel("SL:", colLeft + (lblW / 2), wY + 4, "Arial", 12, Theme.textDim, TA_CENTER|TA_TOP);
      string strSL = DoubleToString(PanelState.GetSL(), m_isPriceMode ? _Digits : 1);
      eng.AddButton(OP_INP_SL, colLeft + lblW + gap, wY, inpW, 24, strSL, Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      eng.AddLabel("SL:", colRight + (lblW / 2), wY + 4, "Arial", 12, Theme.textDim, TA_CENTER|TA_TOP);
      string strRkRs = DoubleToString(PanelState.GetRR_Risk(), 2);
      eng.AddButton(OP_INP_RR_RISK, colRight + lblW + gap, wY, inpW, 24, strRkRs, Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      wY += 32;

      // --- FILA 4: CUSTOM COMMENT ---
      //eng.AddLabel("Comment:", colLeft + (lblW / 2), wY + 4, "Arial", 11, Theme.textDim, TA_CENTER|TA_TOP);

      // Dibujamos el botón a lo ancho de toda la zona derecha sobrante
      int commX = colLeft + lblW + gap;
      int commW = usableW - lblW - gap;

      eng.AddButton(OP_INP_PANEL_COMM, colLeft, wY, usableW, 20, PanelState.GetComment(), Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      wY += 15;
      // =========================================================
      // BLOQUE 3: ESCAPARATE DE HERRAMIENTAS (CONTROL CENTER)
      // =========================================================
      eng.AddPanel(colLeft, wY+10, usableW, 1, Theme.border, 0);
      wY +=20;

      int btnH = 26;

      // Fila 1: Alarmas y Modo Focus (Hide)
      // Inyectado VICON_BELL
      eng.AddButton(OP_BTN_ALARM, colLeft, wY, halfW+2, btnH-2, " Alarm ▼", Theme.surface, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12, false, VICON_BELL);

      uint cHideBg  = m_isManagerHidden ? Theme.sell : Theme.surface;
      uint cHideTxt = m_isManagerHidden ? Theme.textMain : Theme.textDim;
      // Inyectado VICON_EYE
      eng.AddButton(OP_TOG_MANAGER_UI, colRight-2, wY, halfW+2, btnH-2, m_isManagerHidden ? "Hide: ON" : "Hide: OFF", cHideBg, Theme.border, Theme.sell, cHideTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12, false, VICON_EYE);
      wY += btnH + 4;

      // Fila 2: News y Virtual
      eng.AddButton(OP_BTN_NEWS, colLeft, wY, halfW+2, btnH-2, "News >", Theme.surface, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12, false, VICON_NEWS);

      uint cVirtBg  = m_isVirtActive ? Theme.accent : Theme.surface;
      uint cVirtTxt = m_isVirtActive ? Theme.bg : Theme.textDim;
      eng.AddButton(OP_TOG_VIRT, colRight-2, wY, halfW+2, btnH-2, m_isVirtActive ? "Virtual: ON" : "Virtual: OFF", cVirtBg, Theme.border, Theme.accent, cVirtTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      wY += btnH + 4;

      // Fila 3: Time Trader y Equity Protect
      eng.AddButton(OP_BTN_TIME, colLeft, wY, halfW+2, btnH-2, "Time >", Theme.surface, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12, false, VICON_TIME);
      eng.AddButton(OP_BTN_SHIELD, colRight-2, wY, halfW+2, btnH-2, "Protect >", Theme.surface, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12, false, VICON_SHIELD);
      wY += btnH + 4;

      // Fila 4: Manage All Symbols (Ancho Completo)
      uint cAllBg  = m_manageAllSymbols ? Theme.accent : Theme.surface;
      uint cAllTxt = m_manageAllSymbols ? Theme.bg : Theme.textMain;
      eng.AddButton(OP_BTN_MANAGE_ALL, colLeft, wY, usableW, btnH-2, m_manageAllSymbols ? "[ MANAGE ALL SYMBOLS: ON ]" : "[ MANAGE ALL SYMBOLS: OFF ]", cAllBg, Theme.border, Theme.accent, cAllTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
     }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
   void DrawStickyBottom(CUIEngine &eng, int w, int h, bool linesActive)
     {
      int bY = h - 105;
      eng.AddPanel(1, bY, w-2, 1, Theme.border, 0);
      bY += 12;

      // 1. BARRA DE HERRAMIENTAS DE LÍNEAS
      if(!linesActive)
        {
         // Inyectado VICON_LINES
         eng.AddButton(OP_BTN_SHOWLINES, 10, bY, w-20, 28, " SHOW LINES", Theme.surface, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12, false, VICON_LINES);
        }
      else
        {
         int btnMktW = 30, btnRevW = 45, gap = 6;
         int btnShowW = w - 20 - btnMktW - btnRevW - (gap * 2);
         int xShow = 10, xRev = xShow + btnShowW + gap, xMkt = xRev  + btnRevW  + gap;

         // Inyectado VICON_LINES
         eng.AddButton(OP_BTN_SHOWLINES, xShow, bY, btnShowW, 28, " HIDE LINES", Theme.surface, Theme.border, Theme.accent, Theme.accent, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12, false, VICON_LINES);
         eng.AddButton(OP_BTN_FLIP, xRev, bY, btnRevW, 28, "REV", Theme.surface, Theme.border, Theme.accent, Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 10);

         uint cMktBg  = m_isMarketMode ? Theme.accent : Theme.surface;
         uint cMktTxt = m_isMarketMode ? Theme.bg : Theme.accent;
         eng.AddButton(OP_BTN_MKT, xMkt, bY, btnMktW, 28, "M", cMktBg, Theme.border, Theme.accent, cMktTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
        }

      bY += 38;

      // 2. BOTONES DE EJECUCIÓN (BUY / SELL)

      // --- LEEMOS EL LOTAJE DIRECTO DE LA RAM (Cero Lag) ---
      string lotStr = DoubleToString(PanelState.GetLot(), 2);

      if(!linesActive)
        {
         // FIGURA APAGADA: Mostrar los 2 botones clásicos con el Lotaje dinámico
         int btnW = (w - 30) / 2;
         string buyTxt = "BUY | " + lotStr;
         string sellTxt = "SELL | " + lotStr;

         // Ajustamos la fuente de 18 a 15 para que el texto (Ej: "BUY (0.50)") quepa elegante
         eng.AddButton(OP_BTN_BUY, 10, bY, btnW, 45, buyTxt, Theme.buy, ColorToARGB(C'60,195,90', 255), ColorToARGB(C'20,130,40', 255), ColorToARGB(clrWhite,255), 0, TA_CENTER|TA_VCENTER, "Arial Bold", 15);
         eng.AddButton(OP_BTN_SELL, 20+btnW, bY, btnW, 45, sellTxt, Theme.sell, ColorToARGB(C'255,80,90', 255), ColorToARGB(C'180,30,40', 255), ColorToARGB(clrWhite,255), 0, TA_CENTER|TA_VCENTER, "Arial Bold", 15);
        }
      else
        {
         // FIGURA ENCENDIDA: Mostrar 1 solo botón gigante y dinámico
         int fullW = w - 20;
         double entry = ObjectGetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE);
         double sl    = ObjectGetDouble(m_chartId, m_lineSL, OBJPROP_PRICE);

         // Fallback por seguridad si recién se activan las líneas
         if(entry <= 0)
            entry = SymbolInfoDouble(_Symbol, SYMBOL_BID);

         // Construir la cadena de texto con la información
         string typeStr  = GetOrderTypeLabel(entry, sl);
         int dig         = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
         string priceStr = DoubleToString(entry, dig);

         // --- OPTIMIZACIÓN DE ESPACIO Y AUMENTO DE FUENTE ---
         // Acortamos "Lot:" a "L:" para darle respiro al botón y aumentamos el texto a Arial Bold 15
         string btnText = StringFormat("%s | L: %s | %s", typeStr, lotStr, priceStr);

         // Determinar si es Compra o Venta basándose en el SL
         bool isBuyDir = (sl < entry);
         if(sl == 0)
            isBuyDir = (ObjectGetDouble(m_chartId, m_lineTP, OBJPROP_PRICE) > entry);

         if(isBuyDir)
           {
            // Subimos la fuente de 13 a 15 y pasamos a Arial Bold
            eng.AddButton(OP_BTN_BUY, 10, bY, fullW, 45, btnText, Theme.buy, ColorToARGB(C'60,195,90', 255), ColorToARGB(C'20,130,40', 255), ColorToARGB(clrWhite,255), 0, TA_CENTER|TA_VCENTER, "Arial Bold", 15);
           }
         else
           {
            // Subimos la fuente de 13 a 15 y pasamos a Arial Bold
            eng.AddButton(OP_BTN_SELL, 10, bY, fullW, 45, btnText, Theme.sell, ColorToARGB(C'255,80,90', 255), ColorToARGB(C'180,30,40', 255), ColorToARGB(clrWhite,255), 0, TA_CENTER|TA_VCENTER, "Arial Bold", 15);
           }
        }
     } // <--- Fin de la función DrawStickyBottom

// --------------------------------------------------------------------
   void DrawTabManage(CUIEngine &eng, int w, int h, int wY)
     {
      int colLeft = 15, usableW = w - 30, halfW = (usableW - 10) / 2, colRight = colLeft + halfW + 10;

      string distTxt = (m_distMode == MODE_PIPS) ? "Pips ▼" : (m_distMode == MODE_PRICE) ? "Price ▼" : (m_distMode == MODE_RR) ? "Risk Ratio ▼" : "Auto ▼";
      string lotTxt = (m_lotMode == LOT_PCT_TOTAL) ? "% Total ▼" : (m_lotMode == LOT_PCT_REMAIN) ? "% Remain ▼" : "Fixed Lot ▼";

      eng.AddButton(OP_DROP_DIST, colLeft, wY, halfW, 26, distTxt, Theme.bg, Theme.surface, Theme.surface, Theme.textDim, Theme.border, TA_LEFT|TA_VCENTER, "Arial", 12);
      eng.AddButton(OP_DROP_LOT, colRight, wY, halfW, 26, lotTxt, Theme.bg, Theme.surface, Theme.surface, Theme.textDim, Theme.border, TA_LEFT|TA_VCENTER, "Arial", 12);
      wY += 32;

      int btnW = 32, gap = 3, inpW = 41;
      eng.AddLabel("Dist", colLeft + btnW + gap + (inpW / 2), wY, "Arial", 12, Theme.textDim, TA_CENTER|TA_TOP);
      eng.AddLabel("%Lot", colLeft + btnW + gap + inpW + gap + (inpW / 2), wY, "Arial", 12, Theme.textDim, TA_CENTER|TA_TOP);
      eng.AddLabel("Dist", colRight + btnW + gap + (inpW / 2), wY, "Arial", 12, Theme.textDim, TA_CENTER|TA_TOP);
      eng.AddLabel("%Lot", colRight + btnW + gap + inpW + gap + (inpW / 2), wY, "Arial", 12, Theme.textDim, TA_CENTER|TA_TOP);
      wY += 16;

      bool isAutoDist = (m_distMode == MODE_AUTO);
      uint cDistBg  = isAutoDist ? Theme.bg : Theme.inputBg;
      uint cDistTxt = isAutoDist ? Theme.textDim : Theme.textMain;

      for(int i=0; i<5; i++)
        {
         int rowY = wY + (i * 28);
         string id = IntegerToString(i+1);

         bool isTP = TemplateState.grid.rows[i].isActiveTP;
         uint cTP  = isTP ? Theme.buy : Theme.surface;
         eng.AddButton((ushort)(OP_GRID_TP_1 + i), colLeft, rowY, btnW, 24, "TP"+id, cTP, Theme.border, cTP, isTP?ColorToARGB(C'0,0,0',255):Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

         // INPUTS TP
         int tpX_Val = colLeft + btnW + gap;
         string strTpP = DoubleToString(TemplateState.grid.rows[i].valTP_Price, (m_distMode == MODE_PRICE) ? _Digits : 1);
         eng.AddButton((ushort)(OP_INP_GRID_TP_P_1 + i), tpX_Val, rowY, inpW, 24, strTpP, cDistBg, Theme.border, Theme.accent, cDistTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

         int tpX_Pct = tpX_Val + inpW + gap;
         string strTpV = DoubleToString(TemplateState.grid.rows[i].valTP_Vol, 2);
         eng.AddButton((ushort)(OP_INP_GRID_TP_V_1 + i), tpX_Pct, rowY, inpW, 24, strTpV, Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
         bool isSL = TemplateState.grid.rows[i].isActiveSL;
         uint cSL  = isSL ? Theme.sell : Theme.surface;
         eng.AddButton((ushort)(OP_GRID_SL_1 + i), colRight, rowY, btnW, 24, "SL"+id, cSL, Theme.border, cSL, isSL?ColorToARGB(C'0,0,0',255):Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

         // INPUTS SL
         int slX_Val = colRight + btnW + gap;
         string strSlP = DoubleToString(TemplateState.grid.rows[i].valSL_Price, (m_distMode == MODE_PRICE) ? _Digits : 1);
         eng.AddButton((ushort)(OP_INP_GRID_SL_P_1 + i), slX_Val, rowY, inpW, 24, strSlP, cDistBg, Theme.border, Theme.accent, cDistTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

         int slX_Pct = slX_Val + inpW + gap;
         string strSlV = DoubleToString(TemplateState.grid.rows[i].valSL_Vol, 2);
         eng.AddButton((ushort)(OP_INP_GRID_SL_V_1 + i), slX_Pct, rowY, inpW, 24, strSlV, Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
        }
      wY += (5 * 28) + 8;

      uint cSplitBg  = m_isSplitActive ? Theme.accent : Theme.surface;
      eng.AddButton(OP_TOG_SPLIT, colLeft, wY, usableW, 26, m_isSplitActive ? "TRADE SPLITTING: ON" : "TRADE SPLITTING: OFF", cSplitBg, Theme.border, Theme.accent, m_isSplitActive?Theme.bg:Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      wY += 32;

      uint cHideBg  = m_isHideActive ? Theme.sell : Theme.surface;
      uint cOcoBg   = m_isOCOActive ? Theme.accent : Theme.surface;
      eng.AddButton(OP_TOG_HIDE, colLeft, wY, halfW, 26, m_isHideActive ? "HIDE TP/SL: ON" : "HIDE TP/SL: OFF", cHideBg, Theme.border, Theme.sell, m_isHideActive?Theme.textMain:Theme.sell, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      eng.AddButton(OP_TOG_OCO, colRight, wY, halfW, 26, m_isOCOActive ? "OCO ORDER: ON" : "OCO ORDER: OFF", cOcoBg, Theme.border, Theme.accent, m_isOCOActive?Theme.bg:Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      int applyY = h - 180;
      eng.AddPanel(colLeft, applyY - 7, usableW, 1, Theme.border, 0);
      //eng.AddLabel("Apply To:", colLeft, applyY + 4, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      eng.AddButton(OP_DROP_APPLY_MAN, colLeft, applyY, usableW - 66, 22, g_applyTargetManage, Theme.bg, Theme.surface, Theme.surface, Theme.textMain, Theme.border, TA_LEFT|TA_VCENTER, "Arial", 11);
      eng.AddButton(OP_BTN_APPLY_MAN, colLeft + usableW - 60, applyY, 60, 22, "APPLY", Theme.surface, Theme.border, Theme.accent, Theme.accent, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
     }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
   void              ProcessCanvasClick(int id)
     {
      // ===================================================================
      // 🛡️ EL PORTERO (GATEKEEPER): Captura los clics de los Inputs de Texto
      // ===================================================================

      // 1. Rango de Inputs: Pestaña Manage (Grid TP / SL)
      if(id >= OP_INP_GRID_TP_P_1 && id <= OP_INP_GRID_SL_V_5)
        {
         // Bloqueamos la edición de la distancia si estamos en modo AUTO
         bool isDistInput = (id >= OP_INP_GRID_TP_P_1 && id <= OP_INP_GRID_TP_P_5) ||
                            (id >= OP_INP_GRID_SL_P_1 && id <= OP_INP_GRID_SL_P_5);

         if(isDistInput && m_distMode == MODE_AUTO)
            return; // No hace nada

         Engine.SpawnGhostInput(id);

         return; // <-- CRÍTICO: Corta la ejecución, nunca entra al switch
        }

      // 2. Rango de Inputs: Pestaña Auto (Trailing Stop & Break Even)
      if(id >= OP_INP_TS_0 && id <= OP_INP_BE_OFFSET)
        {
         // Bloqueamos la edición del Offset si el BE Auto está encendido
         if(id == OP_INP_BE_OFFSET && m_isBE_AutoOffset)
            return;

         Engine.SpawnGhostInput(id);

         return; // <-- CRÍTICO: Corta la ejecución
        }

      // ===================================================================
      // EL ÚNICO Y VERDADERO DEFAULT (Para los botones que usan matemáticas)
      // ===================================================================
      switch(id)
        {
         case OP_BTN_SCREENSHOT: // <--- AÑADIR
            TakeScreenshot("MANUAL");
            break;
         case OP_BTN_SETTINGS: // <--- AÑADIR DENTRO DEL SWITCH
            g_isSettingsOpen = !g_isSettingsOpen;
            BuildSettingsUI();

            break;
         // --- TRIGGERS PARA GHOST INPUTS ---
         case OP_INP_RISK:
            if(m_riskMode != FIXED_LOT)
               Engine.SpawnGhostInput(id);

            break;
         case OP_INP_LOT:
            if(m_riskMode == FIXED_LOT)
               Engine.SpawnGhostInput(id);

            break;
         case OP_INP_PRICE:
            if(m_isPriceMode)
               Engine.SpawnGhostInput(id);

            break;

         case OP_INP_STOPLIMIT:
         case OP_INP_TP:
         case OP_INP_SL:
         case OP_INP_RR_REWARD:
         case OP_INP_RR_RISK:
         case OP_INP_PANEL_COMM:
            Engine.SpawnGhostInput(id);

            break;

         case 19: // BOTÓN MINIMIZAR
            m_isMinimized = !m_isMinimized;
            BuildCanvasUI();

            break;
         case OP_TAB_EXEC:
            g_activeTab = 0;
            BuildCanvasUI();

            break;
         case OP_TAB_MANAGE:
            g_activeTab = 1;
            BuildCanvasUI();

            break;
         case OP_TAB_AUTO:
            g_activeTab = 2;
            BuildCanvasUI();

            break;
         case OP_TAB_PORT:
            g_activeTab = 3;
            BuildCanvasUI();

            break;
         case OP_BTN_TIME:
            m_isTimeOpen = !m_isTimeOpen;
            BuildTimeUI();

            break;
         case OP_BTN_SHIELD:
            m_isProtectOpen = !m_isProtectOpen;
            BuildProtectUI();

            break;
         case OP_BTN_NEWS:
            m_isNewsOpen = !m_isNewsOpen;
            BuildNewsUI();

            break;
         case OP_BTN_CLOSE_EA:
            g_dialogContext = 0; // Contexto: Confirmar Salida del EA
            g_isExitOpen = true;
            BuildExitUI();
            break;
         case OP_BTN_FLIP:
            if(m_linesActive)
               FlipOrderMode();

            break;
         case OP_BTN_MKT:
            if(m_linesActive)
              {
               SetMarketMode(!m_isMarketMode);
               if(m_isMarketMode)
                  ResetLinesToMarket();
               BuildCanvasUI();
              }

            break;

         // DROPDOWNS
         case OP_DROP_RISK:
           {
            string opts[]= {"Risk (%)", "Cash ($)", "Fix Lot"};
            Engine.ToggleDropdown(id, opts);
           }
         break;
         case OP_DROP_DIST:
           {
            string opts[]= {"Pips", "Price", "Risk Ratio", "Auto"};
            Engine.ToggleDropdown(id, opts);
           }

         break;
         case OP_DROP_LOT:
           {
            string opts[]= {"% Total", "% Remain", "Fixed Lot"};
            Engine.ToggleDropdown(id, opts);
           }

         break;
         case OP_BTN_ALARM:
            Engine.ToggleDropdown(id, m_alertNames);

            break;
         case OP_DROP_TSMODE:
            Engine.ToggleDropdown(id, m_tsOptionNames);

            break;

         case OP_BTN_SYMBOL:
            // ELIMINADO EL ALERT() DE MT5. AHORA SIEMPRE ABRE EL DESPLEGABLE.
           {
            int totalSym = MathMin(SymbolsTotal(true), 30);
            string symOpts[];
            ArrayResize(symOpts, totalSym);

            // --- INYECCIÓN: ESCÁNER DE P/L EN TIEMPO REAL ---
            string cur = AccountInfoString(ACCOUNT_CURRENCY);
            // ... (el resto del código de esta sección se queda exactamente igual)

            for(int i=0; i<totalSym; i++)
              {
               string sName = SymbolName(i, true);
               double symPL = 0.0;

               // Buscamos si hay operaciones abiertas de este símbolo
               for(int p = PositionsTotal() - 1; p >= 0; p--)
                 {
                  ulong t = PositionGetTicket(p);
                  if(PositionGetString(POSITION_SYMBOL) == sName)
                    {
                     // Calculamos el P/L Neto (Profit + Swap + Comisiones)
                     symPL += PositionGetDouble(POSITION_PROFIT) +
                              PositionGetDouble(POSITION_SWAP) +
                              GetPositionCommission(t);
                    }
                 }

               // Si tiene ganancias o pérdidas, lo empaquetamos con nuestro delimitador '|'
               if(symPL != 0)
                 {
                  string sign = (symPL > 0) ? "+" : ""; // El negativo se pone solo
                  string moneyStr = sign + DoubleToString(symPL, 2) + " " + cur;
                  symOpts[i] = sName + "|" + moneyStr;
                 }
               else
                 {
                  // Símbolo limpio (Cero operaciones)
                  symOpts[i] = sName;
                 }
              }

            Engine.ToggleDropdown(id, symOpts);

           }
         break;

         case OP_DROP_APPLY_MAN:
         case OP_DROP_APPLY_AUTO:
           {
            string opts[];
            ArrayResize(opts, 4);
            opts[0] = "This Symbol";
            opts[1] = "All Symbols";
            opts[2] = "Virtuals Only";
            opts[3] = "Reals Only";
            int memTotal = TradeRAM.Total();
            for(int i=0; i<memTotal; i++)
              {
               if(CheckPointer(TradeRAM.GetByIndex(i)) != POINTER_INVALID && TradeRAM.GetByIndex(i).ticket > 0)
                 {
                  int s = ArraySize(opts);
                  ArrayResize(opts, s+1);
                  double entry, sl, tp, vol;
                  long type;
                  CTradeState *dummyMem;
                  string extraInfo = "";
                  if(GetUnifiedTradeInfo(TradeRAM.GetByIndex(i).ticket, entry, sl, tp, vol, type, dummyMem))
                    {
                     string typeStr = (type == POSITION_TYPE_BUY || type == ORDER_TYPE_BUY_LIMIT || type == ORDER_TYPE_BUY_STOP || type == ORDER_TYPE_BUY_STOP_LIMIT) ? "BUY" : "SELL";
                     extraInfo = " " + TradeRAM.GetByIndex(i).symbol + " " + typeStr + " " + DoubleToString(vol, 2);
                    }
                  string tType = TradeRAM.GetByIndex(i).isVirtual ? "[V]" : "[R]";
                  opts[s] = tType + " #" + IntegerToString(TradeRAM.GetByIndex(i).ticket) + extraInfo;
                 }
              }
            Engine.ToggleDropdown(id, opts);

           }
         break;

         case OP_TOG_PRICE:
            m_isPriceMode = !m_isPriceMode;
            BuildCanvasUI();
            if(m_linesActive)
               UpdateInputsFromLines(); // <-- Actualiza los números de inmediato

            break;

         case OP_TOG_RR:
            m_isRRActive = !m_isRRActive;
            BuildCanvasUI();
            if(m_linesActive)
              {
               if(m_isRRActive)
                  SyncRR(true, true); // <-- Si lo prendes, ajusta la figura y los inputs
               else
                  UpdateInputsFromLines(); // <-- Si lo apagas, refresca los inputs
              }

            break;
         case OP_TOG_VIRT:
            m_isVirtActive = !m_isVirtActive;
            BuildCanvasUI();

            break;
         case OP_BTN_SHOWLINES:
            m_linesActive = !m_linesActive;
            ToggleLines(m_linesActive);
            BuildCanvasUI();

            break;
         case OP_TOG_SPLIT:
            m_isSplitActive = !m_isSplitActive;
            BuildCanvasUI();

            break;
         case OP_TOG_HIDE:
            m_isHideActive = !m_isHideActive;
            BuildCanvasUI();

            break;
         case OP_TOG_OCO:
            m_isOCOActive = !m_isOCOActive;
            BuildCanvasUI();

            break;
         case OP_TOG_MANAGER_UI:
            m_isManagerHidden = !m_isManagerHidden;
            if(m_isManagerHidden)
               EraseManagerVisuals();
            else
               UpdateOpenTradesVisuals();

            UpdateTradeLevelsVisibility(); // <--- AÑADIDO: Sincroniza los niveles nativos de MT5
            BuildCanvasUI();

            break;
         case OP_TOG_TS:
            m_isTSActive = !m_isTSActive;
            BuildCanvasUI();
            UpdateInputsFromLines();

            break;
         case OP_TOG_BE:
            m_isBEActive = !m_isBEActive;
            SyncPanelToTemplateState(); // <--- FUNDAMENTAL
            BuildCanvasUI();
            UpdateInputsFromLines();
            // --- SENSOR 1 ---
            //Print(">>> [TRACK BE 1] Clic en Panel. m_isBEActive: ", m_isBEActive, " | TemplateState BE: ", TemplateState.be.isActive);
            break;

         case OP_TOG_BEAUTO:
            m_isBE_AutoOffset = !m_isBE_AutoOffset;

            // 1. Guardamos la decisión en la memoria RAM del panel
            SyncPanelToTemplateState();

            // 2. Si las líneas están encendidas, las obligamos a recalcular su posición
            if(m_linesActive)
               UpdateInputsFromLines();

            // 3. Repintamos el botón del panel para que diga "AUTO OFFSET: ON/OFF"
            BuildCanvasUI();
            ChartRedraw();
            break;

         case OP_BTN_MANAGE_ALL:
            m_manageAllSymbols = !m_manageAllSymbols;
            BuildCanvasUI();
            if(g_activeTab==3)
               UpdateToolData(true);

            break;
         case OP_PORT_TOG_SYM:
            g_portAllSymbols = !g_portAllSymbols;
            BuildCanvasUI();

            break;
         case OP_PORT_TOG_ID:
            g_portAllMagics = !g_portAllMagics;
            BuildCanvasUI();

            break;

         // ACTIONS
         case OP_BTN_APPLY_MAN:
            ExecuteApplyTo(1, g_applyTargetManage);

            break;
         case OP_BTN_APPLY_AUTO:
            ExecuteApplyTo(2, g_applyTargetAuto);

            break;
         case OP_PORT_MORE_INFO:
            g_isModalOpen = !g_isModalOpen; // <-- AHORA INVIERTE EL ESTADO
            BuildModalUI();

            break;
         case OP_BTN_BUY:
            if(m_confirm_Silence)
               ExecuteOrder(ORDER_TYPE_BUY);
            else
               ManageConfirmWindow(true, ORDER_TYPE_BUY);

            break;
         case OP_BTN_SELL:
            if(m_confirm_Silence)
               ExecuteOrder(ORDER_TYPE_SELL);
            else
               ManageConfirmWindow(true, ORDER_TYPE_SELL);

            break;

         case OP_PORT_CLOSE_ALL:
            ProcessToolAction(0);
            BuildCanvasUI();

            break;
         case OP_PORT_CW:
            ProcessToolAction(1);
            BuildCanvasUI();

            break;
         case OP_PORT_CL:
            ProcessToolAction(2);
            BuildCanvasUI();

            break;
         case OP_PORT_CB:
            ProcessToolAction(3);
            BuildCanvasUI();

            break;
         case OP_PORT_CS:
            ProcessToolAction(4);
            BuildCanvasUI();

            break;
         case OP_PORT_D_BSTOP:
            ProcessToolAction(10);
            BuildCanvasUI();

            break;
         case OP_PORT_D_BLIM:
            ProcessToolAction(11);
            BuildCanvasUI();

            break;
         case OP_PORT_D_SSTOP:
            ProcessToolAction(12);
            BuildCanvasUI();

            break;
         case OP_PORT_D_SLIM:
            ProcessToolAction(13);
            BuildCanvasUI();

            break;
         // --- NUEVOS BOTONES INYECTADOS AQUÍ ---
         case OP_PORT_D_BSLIM:
            ProcessToolAction(16);
            BuildCanvasUI();

            break; // 16 = Buy Stop Limit
         case OP_PORT_D_SSLIM:
            ProcessToolAction(17);
            BuildCanvasUI();

            break; // 17 = Sell Stop Limit
         case OP_PORT_D_ALLSLIMS:
            ProcessToolAction(19);
            BuildCanvasUI();

            break; // 19 = Delete Both
         // ------------------------------------
         case OP_PORT_D_ALLSTOPS:
            ProcessToolAction(14);
            BuildCanvasUI();

            break;
         case OP_PORT_D_ALLLIMITS:
            ProcessToolAction(15);
            BuildCanvasUI();

            break;
         case OP_PORT_DEL_ALL:
            ProcessToolAction(18);
            BuildCanvasUI();

            break;

         case OP_BE_U_1:
            TemplateState.be.modeStart++;
            if(TemplateState.be.modeStart > 3)
               TemplateState.be.modeStart = 0;
            BuildCanvasUI();
            if(m_linesActive)
               UpdateInputsFromLines();

            break;
         case OP_BE_U_2:
            TemplateState.be.modeOffset++;
            if(TemplateState.be.modeOffset > 3)
               TemplateState.be.modeOffset = 0;
            BuildCanvasUI();
            if(m_linesActive)
               UpdateInputsFromLines();

            break;

         default:
            // MAGIA MATEMÁTICA: Identificando series de botones (Ej: Grid TP 1 a 5)
            if(id >= OP_GRID_TP_1 && id <= OP_GRID_TP_5)
              {
               int row = id - OP_GRID_TP_1;
               TemplateState.grid.rows[row].isActiveTP ^= true;
               BuildCanvasUI();
               UpdateInputsFromLines();

              }
            else
               if(id >= OP_GRID_SL_1 && id <= OP_GRID_SL_5)
                 {
                  int row = id - OP_GRID_SL_1;
                  TemplateState.grid.rows[row].isActiveSL ^= true;
                  BuildCanvasUI();
                  UpdateInputsFromLines();

                 }
               else
                  if(id >= OP_TS_U_0 && id <= OP_TS_U_5)
                    {
                     int r = id - OP_TS_U_0;
                     if((m_tsMode == TS_ATR && (r==4 || r==5)) || (m_tsMode == TS_PARTIAL && r==0))
                        TemplateState.ts.units[r] ^= 1;
                     else
                       {
                        TemplateState.ts.units[r]++;
                        if(TemplateState.ts.units[r] > 3)
                           TemplateState.ts.units[r] = 0;
                       }
                     BuildCanvasUI();
                     if(m_linesActive)
                        UpdateInputsFromLines();

                    }
                  else
                     if(id >= OP_TS_DROP_0 && id <= OP_TS_DROP_5)
                       {
                        int r = id - OP_TS_DROP_0;
                        if(m_tsMode == TS_FRACTALS && r==1)
                           Engine.ToggleDropdown(id, m_tfOptions);
                        else
                           if(m_tsMode == TS_MA && r==1)
                              Engine.ToggleDropdown(id, m_tfOptions);
                           else
                              if(m_tsMode == TS_MA && r==3)
                                 Engine.ToggleDropdown(id, m_maMethods);
                              else
                                 if(m_tsMode == TS_MA && r==4)
                                    Engine.ToggleDropdown(id, m_maPrices);
                                 else
                                    if(m_tsMode == TS_PSAR && r==1)
                                       Engine.ToggleDropdown(id, m_tfOptions);
                                    else
                                       if(m_tsMode == TS_ATR && r==1)
                                          Engine.ToggleDropdown(id, m_tfOptions);
                                       else
                                          if(m_tsMode == TS_HILO && r==1)
                                             Engine.ToggleDropdown(id, m_tfOptions);

                        // Guardamos cualquier cambio que el usuario haya hecho en el panel
                        SavePanelToBin();
                       }
            break;
        }
     }

//+------------------------------------------------------------------+
//| PROCESA LAS OPCIONES SELECCIONADAS EN CUALQUIER DESPLEGABLE      |
//+------------------------------------------------------------------+
   void              ProcessDropdownSelection(ushort dropId, int optionIdx)
     {
      switch(dropId)
        {
         case OP_SET_PRESET_DROP:
            g_presetName = SettingsWin.m_dropdownOptions[optionIdx];
            BuildSettingsUI(); // Actualiza la caja de texto
            break;
         case OP_PROT_DROP_SYM:
            g_protect.f[13].configStr = ProtectWin.m_dropdownOptions[optionIdx];
            BuildProtectUI(); // <-- CORRECCIÓN: Reconstruye la UI para inyectar el nuevo texto
            break;

         case OP_TIME_ACTION_DROP:
            m_time_selectedAction = optionIdx;
            BuildTimeUI();
            break;

         case OP_TIME_INP_TICKET:
           {
            // Extraer el número del ticket del nuevo formato: "[R] #12345 EURUSD BUY 0.10"
            string selected = TimeWin.m_dropdownOptions[optionIdx];
            string parts[];
            StringSplit(selected, ' ', parts);

            string cleanTk = "";

            // Como ahora añadimos "[R]" o "[V]" al inicio, el ticket con el '#' está en la posición 1
            if(ArraySize(parts) >= 2)
               cleanTk = parts[1];
            else
               cleanTk = parts[0]; // Fallback de seguridad por si el usuario escribe algo raro

            // Limpiamos el símbolo '#' para quedarnos solo con los números puros
            StringReplace(cleanTk, "#", "");

            // Inyectamos el número limpio en la caja de texto del Time Trader (Ej: "12345")
            TimeWin.SetButtonText(OP_TIME_INP_TICKET, cleanTk);
            TimeWin.Render(); // Refresco visual inmediato
            break;
           }

         case OP_MODAL_STAT_DROP:
            g_modalStatsSym = Modal.m_dropdownOptions[optionIdx];
            BuildModalUI(); // <-- FIX: Redibujar el Modal con los nuevos Stats
            break;

         case OP_MODAL_SYM_DROP:
            g_modalViewSym = Modal.m_dropdownOptions[optionIdx];
            BuildModalUI(); // <-- FIX: Redibujar el Modal con la nueva Info del Símbolo
            break;

         case OP_BTN_ALARM:
            CreateAlertLine(optionIdx);
            break;

         case OP_DROP_TSMODE:
            m_tsMode = (ENUM_TS_MODE)optionIdx;
            SyncPanelToTemplateState(); // Sincroniza la nueva configuración a la memoria RAM
            if(m_linesActive)
               UpdateInputsFromLines(); // Obliga a las líneas a recalcularse con el nuevo modo
            BuildCanvasUI();
            break;

         case OP_DROP_RISK:
            m_riskMode = (ENUM_RISK_MODE)optionIdx;
            CalculateLot(); // El modo de riesgo afecta directamente al cálculo del lote
            if(m_linesActive)
               UpdateInputsFromLines();
            BuildCanvasUI();
            break;

         case OP_DROP_DIST:
            m_distMode = (ENUM_DIST_MODE)optionIdx;
            SyncPanelToTemplateState(); // Sincroniza la nueva configuración a la memoria RAM
            if(m_linesActive)
               UpdateInputsFromLines(); // Mueve las líneas del Grid a su nueva posición matemática
            BuildCanvasUI();
            break;

         case OP_DROP_LOT:
            m_lotMode = (ENUM_LOT_MODE)optionIdx;
            SyncPanelToTemplateState();
            CalculateManageLots();
            if(m_linesActive)
               UpdateInputsFromLines(); // Actualiza las etiquetas de volumen en las líneas del Grid
            BuildCanvasUI();
            break;

         case OP_BTN_SYMBOL:
           {
            string rawOpt = Engine.m_dropdownOptions[optionIdx];

            // --- DECODIFICACIÓN DEL PROTOCOLO '|' ---
            string nSym = rawOpt;
            int splitPos = StringFind(rawOpt, "|");

            if(splitPos > 0)
              {
               // Extraemos únicamente el texto puro del símbolo (ej: "EURUSD")
               nSym = StringSubstr(rawOpt, 0, splitPos);
              }

            // --- LA MAGIA: EVALUACIÓN JUST-IN-TIME ---
            if(!m_manageAllSymbols)
              {
               g_pending_symbol_change = nSym; // Guardamos en RAM a dónde quería ir
               g_dialogContext = 1;            // Contexto 1 = Activar Manage All
               g_isExitOpen = true;            // Encendemos el motor del Diálogo Universal
               BuildExitUI();                  // Construimos la ventana con el nuevo contexto
              }
            else
              {
               // Si ya tenía el permiso, saltamos de gráfico directo sin preguntar
               if(nSym != _Symbol)
                  ChartSetSymbolPeriod(m_chartId, nSym, _Period);
              }
           }
         break;

         case OP_DROP_APPLY_MAN:
            g_applyTargetManage = Engine.m_dropdownOptions[optionIdx] + " ▼";
            BuildCanvasUI(); // <-- FIX: Mostrar el nuevo texto seleccionado
            break;

         case OP_DROP_APPLY_AUTO:
            g_applyTargetAuto = Engine.m_dropdownOptions[optionIdx] + " ▼";
            BuildCanvasUI(); // <-- FIX: Mostrar el nuevo texto seleccionado
            break;

         default:
            if(dropId >= OP_TS_DROP_0 && dropId <= OP_TS_DROP_5)
              {
               int r = dropId - OP_TS_DROP_0;
               TemplateState.ts.dropIdx[r] = optionIdx;

               SyncPanelToTemplateState();
               if(m_linesActive)
                  UpdateInputsFromLines(); // Si cambiaste de M1 a H1, la línea TS debe saltar inmediatamente

               BuildCanvasUI();
              }
            break;
        }

      // Forzamos a MT5 a pintar el nuevo lienzo en la pantalla
      ChartRedraw();

      // Disparamos un guardado maestro rápido por si cambió algo en cualquier dropdown
      SavePanelToBin();
      SaveTradesToBin();
      SaveProtectToBin();
     }
//+------------------------------------------------------------------+
//| DIBUJA EL GRÁFICO MULTI-SÍMBOLO (EJES, PAGINACIÓN Y COMPRESIÓN)  |
//+------------------------------------------------------------------+
   void              DrawMultiChart(CUIEngine &eng, int x, int y, int w, int h)
     {
      int rightPanelW = 145; // Ancho para botones
      int chartAreaW  = w - rightPanelW;
      int btnX        = x + chartAreaW + 5;

      eng.AddPanel(x, y, chartAreaW, h, Theme.inputBg, Theme.border);
      eng.AddLabel("PERFORMANCE CURVE", x + 10, y + 5, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      eng.AddLabel("SYMBOLS:", btnX, y + 5, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);

      // --- 1. PAGINACIÓN DE BOTONES ---
      int totalSyms = ArraySize(g_perfData);
      int rowsPerPage = 6;
      int totalPages = (totalSyms == 0) ? 1 : (int)MathCeil((double)totalSyms / rowsPerPage);

      if(g_perfPage >= totalPages)
         g_perfPage = totalPages - 1;
      if(g_perfPage < 0)
         g_perfPage = 0;

      int startIdx = g_perfPage * rowsPerPage;
      int bY = y + 25;
      int btnH = 22;

      for(int i = 0; i < rowsPerPage; i++)
        {
         int realIdx = startIdx + i;
         if(realIdx >= totalSyms)
            break;

         uint btnBg  = g_perfData[realIdx].isActive ? Theme.surface : Theme.bg;
         uint txtCol = g_perfData[realIdx].isActive ? Theme.textMain : Theme.textDim;
         uint boxCol = g_perfData[realIdx].isActive ? g_perfData[realIdx].colorLine : Theme.border;

         eng.AddButton(OP_MODAL_SYM_TOGGLE_0 + realIdx, btnX, bY, rightPanelW - 5, btnH, "       " + g_perfData[realIdx].sym, btnBg, Theme.surface, Theme.border, txtCol, Theme.border, TA_LEFT|TA_VCENTER, "Arial", 11);
         eng.AddPanel(btnX + 6, bY + 5, 12, 12, boxCol, boxCol, true);
         bY += (btnH + 2);
        }

      // Botones Prev/Next si hay más de una página
      if(totalPages > 1)
        {
         eng.AddButton(OP_MODAL_PERF_PREV, btnX, y + h - 25, 60, 22, "<", Theme.surface, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
         eng.AddButton(OP_MODAL_PERF_NEXT, btnX + 65, y + h - 25, 60, 22, ">", Theme.surface, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
        }

      // --- 2. PREPARACIÓN DE EJES ---
      double maxV = -999999, minV = 999999;
      bool hasActive = false;

      for(int i=0; i<totalSyms; i++)
        {
         if(!g_perfData[i].isActive)
            continue;
         hasActive = true;
         for(int j=0; j<ArraySize(g_perfData[i].history); j++)
           {
            if(g_perfData[i].history[j] > maxV)
               maxV = g_perfData[i].history[j];
            if(g_perfData[i].history[j] < minV)
               minV = g_perfData[i].history[j];
           }
        }

      if(!hasActive)
         return;
      if(maxV == minV)
        {
         maxV += 1;
         minV -= 1;
        }

      int drawX = x + 5;
      int drawY = y + 25;
      int drawW = chartAreaW - 60; // Dejamos 50px a la derecha para textos del Eje Y
      int drawH = h - 50;          // Dejamos 25px abajo para el Eje X
      double range = maxV - minV;

      // --- 3. DIBUJO DE EJES (GRID Y TEXTOS) ---
      // Línea Cero
      if(maxV > 0 && minV < 0)
        {
         int zeroY = drawY + drawH - (int)(((0 - minV) / range) * drawH);
         eng.AddLine(drawX, zeroY, drawX + drawW + 5, zeroY, ColorToARGB(C'60,60,65', 255));
         eng.AddLabel("$0.0", drawX + drawW + 8, zeroY - 6, "Arial", 10, Theme.textDim, TA_LEFT|TA_TOP);
        }

      // Textos de Max y Min (Eje Y)
      eng.AddLabel(DoubleToString(maxV, 1), drawX + drawW + 8, drawY - 4, "Arial", 12, Theme.buy, TA_LEFT|TA_TOP);
      eng.AddLabel(DoubleToString(minV, 1), drawX + drawW + 8, drawY + drawH - 10, "Arial", 12, Theme.sell, TA_LEFT|TA_TOP);

      // Textos de Fechas (Eje X)
      if(g_perfStartTime > 0)
        {
         eng.AddLabel(TimeToString(g_perfStartTime, TIME_DATE), drawX, drawY + drawH + 5, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
         eng.AddLabel(TimeToString(g_perfEndTime, TIME_DATE), drawX + drawW, drawY + drawH + 5, "Arial", 12, Theme.textDim, TA_RIGHT|TA_TOP);
        }

      // --- 4. DIBUJO DE CURVAS (COMPRESIÓN ANTI-LAG) ---
      for(int i=0; i<totalSyms; i++)
        {
         if(!g_perfData[i].isActive)
            continue;
         int count = ArraySize(g_perfData[i].history);
         if(count < 2)
            continue;

         double stepX = (double)drawW / (count - 1);
         uint lineCol = g_perfData[i].colorLine;

         int prev_x = drawX;
         int prev_y = drawY + drawH - (int)(((g_perfData[i].history[0] - minV) / range) * drawH);

         for(int j=1; j<count; j++)
           {
            int curr_x = drawX + (int)(j * stepX);
            int curr_y = drawY + drawH - (int)(((g_perfData[i].history[j] - minV) / range) * drawH);

            // MAGIA ANTI-LAG: Solo dibuja si avanzamos 1 píxel, o si es el último punto.
            if(curr_x > prev_x || j == count - 1)
              {
               eng.AddLine(prev_x, prev_y, curr_x, curr_y, lineCol);
               prev_x = curr_x;
               prev_y = curr_y;
              }
           }
         // Dibujar punto final
         eng.AddPanel(prev_x-3, prev_y-3, 6, 6, Theme.bg, lineCol, true);
        }
     }

//+------------------------------------------------------------------+
//| CONSTRUIR VENTANA DE CONFIGURACIÓN Y PRESETS (CUARTO DE MÁQUINAS)|
//+------------------------------------------------------------------+
   void              BuildSettingsUI()
     {
      SettingsWin.Clear();
      if(!g_isSettingsOpen)
        {
         SettingsWin.DestroyCanvas();
         DWM.UnregisterWindow(GetPointer(SettingsWin));
         return;
        }

      int chartW = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);
      int chartH = (int)ChartGetInteger(0, CHART_HEIGHT_IN_PIXELS);
      int mW = 380, mH = 455;
      int mX = (chartW / 2) - (mW / 2);
      int mY = (chartH / 2) - (mH / 2);

      if(ObjectFind(0, "CanvasSettings") < 0)
        {
         SettingsWin.Init(ENGINE_SETTINGS, "CanvasSettings", mX, mY, mW, mH);
         DWM.RegisterWindow(GetPointer(SettingsWin));
        }
      else
        {
         mX = SettingsWin.m_panelX;
         mY = SettingsWin.m_panelY;
        }

      // HEADER
      SettingsWin.AddPanel(0, 0, mW, 40, Theme.surface, Theme.border);
      SettingsWin.AddLabel("EXPERT SETTINGS & PRESETS", 15, 12, "Arial", 13, Theme.accent, TA_LEFT|TA_TOP);
      SettingsWin.AddButton(OP_SET_CLOSE, mW - 40, 5, 30, 30, "X", Theme.surface, Theme.sell, Theme.sell, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 14);

      // --- BOTÓN DE AYUDA INYECTADO ---
      SettingsWin.AddButton(OP_BTN_HELP, mW - 75, 5, 30, 30, "?", Theme.surface, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 14);


      int wY = 50;
      int pW = mW - 30; // Usable width

      // --- SECCIÓN 1: GESTOR DE PRESETS (GLOBAL) ---
      SettingsWin.AddLabel("PANEL PRESETS (Global Folder)", 15, wY, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      wY += 20;
      SettingsWin.AddPanel(15, wY, pW, 80, Theme.surface, Theme.border);

      ScanPresets();

      // FILA 1: Input (CERO PARPADEO) + Botones
      SettingsWin.AddButton(OP_SET_PRESET_INP, 25, wY + 10, pW - 145, 24, g_presetName, Theme.inputBg, Theme.inputBg, Theme.inputBg, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      SettingsWin.AddButton(OP_SET_PRESET_SAVE, pW - 100, wY + 10, 50, 24, "SAVE", Theme.surface, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      SettingsWin.AddButton(OP_SET_PRESET_LOAD, pW - 45,  wY + 10, 50, 24, "LOAD", Theme.accent, Theme.border, Theme.accent, Theme.bg, Theme.accent, TA_CENTER|TA_VCENTER, "Arial", 11);

      // FILA 2: Dropdown + Delete
      SettingsWin.AddButton(OP_SET_PRESET_DROP, 25, wY + 42, pW - 85, 24, g_presetName + " ▼", Theme.bg, Theme.border, Theme.surface, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      SettingsWin.AddButton(OP_SET_PRESET_DEL, pW - 45, wY + 42, 50, 24, "DEL", Theme.surface, Theme.border, Theme.sell, Theme.sell, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);

      wY += 95;

      // --- SECCIÓN 2: TEMAS DE COLOR ---
      SettingsWin.AddLabel("COLOR THEME", 15, wY, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      wY += 20;

      // MAGIA MATEMÁTICA: 5 botones implican 4 espacios (gaps) de 5px cada uno.
      int thW = (pW - 20) / 5;

      uint cTh0 = (g_currentTheme == 0) ? Theme.accent : Theme.surface;
      uint cTh1 = (g_currentTheme == 1) ? Theme.accent : Theme.surface;
      uint cTh2 = (g_currentTheme == 2) ? Theme.accent : Theme.surface;
      uint cTh3 = (g_currentTheme == 3) ? Theme.accent : Theme.surface;
      uint cTh4 = (g_currentTheme == 4) ? Theme.accent : Theme.surface; // <--- NUEVO

      SettingsWin.AddButton(OP_SET_THEME_0, 15, wY, thW, 30, "Cyber", cTh0, Theme.border, Theme.accent, (g_currentTheme==0?Theme.bg:Theme.textMain), Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      SettingsWin.AddButton(OP_SET_THEME_1, 15+(thW+5), wY, thW, 30, "Gold", cTh1, Theme.border, Theme.accent, (g_currentTheme==1?Theme.bg:Theme.textMain), Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      SettingsWin.AddButton(OP_SET_THEME_2, 15+(thW+5)*2, wY, thW, 30, "Mid", cTh2, Theme.border, Theme.accent, (g_currentTheme==2?Theme.bg:Theme.textMain), Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      SettingsWin.AddButton(OP_SET_THEME_3, 15+(thW+5)*3, wY, thW, 30, "Light", cTh3, Theme.border, Theme.accent, (g_currentTheme==3?Theme.bg:Theme.textMain), Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      SettingsWin.AddButton(OP_SET_THEME_4, 15+(thW+5)*4, wY, thW, 30, "Rose", cTh4, Theme.border, Theme.accent, (g_currentTheme==4?Theme.bg:Theme.textMain), Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11); // <--- NUEVO
      wY += 45;

      // --- SECCIÓN 3: UX TOGGLES ---
      SettingsWin.AddLabel("EXPERIENCE & UX", 15, wY, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      wY += 20;
      int btnW = (pW - 10) / 2;

      bool histOn = (bool)ChartGetInteger(0, CHART_SHOW_TRADE_HISTORY);
      uint cHist = histOn ? Theme.accent : Theme.surface;
      uint cShot = g_autoScreenshot ? Theme.accent : Theme.surface;
      uint cMag  = g_manageAllMagics ? Theme.accent : Theme.surface;

      // Fila 1 de Toggles
      SettingsWin.AddButton(OP_SET_TOG_HIST, 15, wY, btnW, 30, histOn ? "MT5 History: SHOW" : "MT5 History: HIDE", cHist, Theme.border, cHist, (histOn?Theme.bg:Theme.textDim), Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      SettingsWin.AddButton(OP_SET_TOG_SHOT, 25 + btnW, wY, btnW, 30, g_autoScreenshot ? "Auto-Shot: ON" : "Auto-Shot: OFF", cShot, Theme.border, cShot, (g_autoScreenshot?Theme.bg:Theme.textDim), Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      wY += 35;

      // Fila 2 de Toggles (Magic Number)
      SettingsWin.AddButton(OP_SET_TOG_MAGIC, 15, wY, pW, 30, g_manageAllMagics ? "Manage All Magic IDs: ON" : "Manage All Magic IDs: OFF (EA only)", cMag, Theme.border, cMag, (g_manageAllMagics?Theme.bg:Theme.textDim), Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      wY += 45;

      // --- SECCIÓN 4: SPREAD LIMIT (SEGURIDAD) ---
      SettingsWin.AddLabel("SAFETY: MAX SPREAD LIMIT", 15, wY, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      wY += 20;
      SettingsWin.AddPanel(15, wY, pW, 40, Theme.surface, Theme.border);
      SettingsWin.AddLabel("Block entries if spread is greater than (Points):", 25, wY + 12, "Arial", 12, Theme.textMain, TA_LEFT|TA_TOP);

      string spreadTxt = (g_maxSpread == 0) ? "0 (OFF)" : IntegerToString(g_maxSpread);

      // FIX INPUT (CERO PARPADEO)
      SettingsWin.AddButton(OP_SET_INP_SPREAD, mW - 95, wY + 7, 70, 26, spreadTxt, Theme.inputBg, Theme.inputBg, Theme.inputBg, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      // --- EN BuildSettingsUI() AÑADE ESTO ANTES DEL RENDER ---
      wY += 50;
      SettingsWin.AddPanel(15, wY, pW, 1, Theme.border, 0);
      wY += 10;
      SettingsWin.AddButton(OP_SET_OPEN_HOTKEYS, 15, wY, pW, 30, "CONFIGURE HOTKEYS", Theme.surface, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      SettingsWin.Render();
     }

//+------------------------------------------------------------------+
//| CONSTRUIR VENTANA DE HOTKEYS                                     |
//+------------------------------------------------------------------+
   void BuildHotkeyUI()
     {
      HotkeyWin.Clear();
      if(!g_isHotkeyOpen)
        {
         HotkeyWin.DestroyCanvas();
         DWM.UnregisterWindow(GetPointer(HotkeyWin));
         g_listeningHotkeyIdx = -1; // Apagar modo escucha al cerrar
         return;
        }

      int chartW = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);
      int chartH = (int)ChartGetInteger(0, CHART_HEIGHT_IN_PIXELS);
      int mW = 420, mH = 400;
      int mX = (chartW / 2) - (mW / 2);
      int mY = (chartH / 2) - (mH / 2);

      if(ObjectFind(0, "CanvasHotkeys") < 0)
        {
         HotkeyWin.Init(ENGINE_HOTKEYS, "CanvasHotkeys", mX, mY, mW, mH);
         DWM.RegisterWindow(GetPointer(HotkeyWin));
        }

      // HEADER
      HotkeyWin.AddPanel(0, 0, mW, 40, Theme.surface, Theme.border);
      HotkeyWin.AddLabel("HOTKEYS CONFIGURATION", 15, 12, "Arial", 13, Theme.accent, TA_LEFT|TA_TOP);
      HotkeyWin.AddButton(OP_HK_CLOSE, mW - 40, 5, 30, 30, "X", Theme.surface, Theme.sell, Theme.sell, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 14);

      int wY = 50;

      // MASTER SWITCH
      uint cMasterBg = g_hotkeyDisk[0].masterSwitch ? Theme.accent : Theme.surface;
      uint cMasterTxt = g_hotkeyDisk[0].masterSwitch ? Theme.bg : Theme.textDim;
      HotkeyWin.AddButton(OP_HK_MASTER, 15, wY, mW - 30, 30, g_hotkeyDisk[0].masterSwitch ? "HOTKEYS: ENABLED" : "HOTKEYS: DISABLED", cMasterBg, Theme.border, Theme.accent, cMasterTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      wY += 45;

      // MATRIZ DE ACCIONES
      for(int i=0; i<9; i++)
        {
         int rY = wY + (i * 32);
         uint rowBg = (i % 2 == 0) ? Theme.surface : Theme.bg;
         HotkeyWin.AddPanel(15, rY, mW - 30, 30, rowBg, 0);

         // Etiqueta
         HotkeyWin.AddLabel(g_hkNames[i], 25, rY + 7, "Arial", 12, Theme.textMain, TA_LEFT|TA_TOP);

         // Botón Enable/Disable
         bool isEn = g_hotkeyDisk[0].keys[i].enabled;
         uint cEnBg = isEn ? Theme.buy : Theme.surface;
         HotkeyWin.AddButton(OP_HK_EN_0 + i, mW - 200, rY + 4, 50, 22, isEn ? "ON" : "OFF", cEnBg, Theme.border, Theme.buy, isEn?Theme.bg:Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);

         // Botón de Asignación de Tecla
         string keyTxt = CharArrayToString(g_hotkeyDisk[0].keys[i].keyName);
         if(g_hotkeyDisk[0].keys[i].requireCtrl)
            keyTxt = "CTRL + " + keyTxt;

         uint cKeyBg = Theme.inputBg;
         uint cKeyTxt = Theme.accent;

         // Si está en modo escucha, cambiar visuales
         if(g_listeningHotkeyIdx == i)
           {
            keyTxt = "[ PRESS KEY ]";
            cKeyBg = Theme.sell;
            cKeyTxt = Theme.textMain;
           }

         HotkeyWin.AddButton(OP_HK_BTN_0 + i, mW - 140, rY + 4, 115, 22, keyTxt, cKeyBg, Theme.border, cKeyBg, cKeyTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
        }

      HotkeyWin.Render();
     }

//+------------------------------------------------------------------+
//| CONSTRUYE LA MEGA-VENTANA FLOTANTE (REFINADA Y COMPACTA)         |
//+------------------------------------------------------------------+
   void              BuildModalUI()
     {
      Modal.Clear();
      if(!g_isModalOpen)
        {
         Modal.DestroyCanvas();
         DWM.UnregisterWindow(GetPointer(Modal));
         g_perfLoaded = false;
         return;
        }

      LoadPerformanceData();

      int chartW = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);
      int chartH = (int)ChartGetInteger(0, CHART_HEIGHT_IN_PIXELS);

      // 1. REDUCCIÓN DE TAMAÑO (De 660 a 530)
      int mW = 540;
      int mH = 530;
      int defX = (chartW / 2) - (mW / 2);
      int defY = (chartH / 2) - (mH / 2);
      if(defY < 10)
         defY = 10;

      int mX, mY;
      if(ObjectFind(0, "CanvasModalInfo") >= 0)
        {
         mX = Modal.m_panelX;
         mY = Modal.m_panelY;
        }
      else
        {
         mX = (g_panelDisk[0].modalX > 0) ? g_panelDisk[0].modalX : defX;
         mY = (g_panelDisk[0].modalY > 0) ? g_panelDisk[0].modalY : defY;
        }

      Modal.Init(ENGINE_MODAL_INFO, "CanvasModalInfo", mX, mY, mW, mH);
      DWM.RegisterWindow(GetPointer(Modal));

      // HEADER
      Modal.AddPanel(0, 0, mW, 40, Theme.surface, Theme.border);
      Modal.AddLabel("ADVANCED PORTFOLIO TERMINAL", 15, 12, "Arial", 13, Theme.accent, TA_LEFT|TA_TOP);
      Modal.AddButton(OP_MODAL_CLOSE, mW - 40, 5, 30, 30, "X", Theme.surface, Theme.sell, Theme.sell, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 14);

      // PESTAÑAS (TABS)
      int tabW = (mW - 30) / 3;
      uint cTab0 = (g_infoSubTab == 0) ? Theme.accent : Theme.surface;
      uint cTab1 = (g_infoSubTab == 1) ? Theme.accent : Theme.surface;
      uint cTab2 = (g_infoSubTab == 2) ? Theme.accent : Theme.surface;

      Modal.AddButton(OP_MODAL_TAB_ACC,  15, 50, tabW, 30, "ACCOUNT", cTab0, Theme.border, Theme.accent, (g_infoSubTab==0?Theme.bg:Theme.textMain), Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      Modal.AddButton(OP_MODAL_TAB_STAT, 15+tabW, 50, tabW, 30, "STATISTICS", cTab1, Theme.border, Theme.accent, (g_infoSubTab==1?Theme.bg:Theme.textMain), Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      Modal.AddButton(OP_MODAL_TAB_SYM,  15+tabW*2, 50, tabW, 30, "SYMBOL", cTab2, Theme.border, Theme.accent, (g_infoSubTab==2?Theme.bg:Theme.textMain), Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      // GRÁFICO MULTI-SÍMBOLO
      DrawMultiChart(Modal, 15, 90, mW - 30, 200);

      // SEPARADOR Y BARRA DE CONTROL DINÁMICA
      int infoY = 300;
      Modal.AddPanel(15, infoY, mW - 30, 1, Theme.border, 0);

      string titleData = "ACCOUNT METRICS";

      // 2. UNIFICACIÓN DE BOTONES DESPLEGABLES
      if(g_infoSubTab == 1)
        {
         titleData = "TRADING STATISTICS";
         Modal.AddButton(OP_MODAL_STAT_DROP, mW - 175, infoY + 8, 160, 24, "DATA: " + g_modalStatsSym + " ▼", Theme.surface, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
        }
      else
         if(g_infoSubTab == 2)
           {
            titleData = "CURRENT SYMBOL DATA";
            Modal.AddButton(OP_MODAL_SYM_DROP, mW - 175, infoY + 8, 160, 24, "DATA: " + g_modalViewSym + " ▼", Theme.surface, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
           }

      Modal.AddLabel(titleData, 15, infoY + 10, "Arial", 13, Theme.accent, TA_LEFT|TA_TOP);

      // EXTRACCIÓN DE DATOS
      string lbls[12];
      string vals[12];
      uint vCols[12];
      for(int i=0; i<12; i++)
         vCols[i] = Theme.textMain;

      if(g_infoSubTab == 0) // ACCOUNT
        {
         lbls[0]="Balance";
         vals[0]=DoubleToString(AccountInfoDouble(ACCOUNT_BALANCE), 2);
         lbls[1]="Equity";
         vals[1]=DoubleToString(AccountInfoDouble(ACCOUNT_EQUITY), 2);
         double flt = AccountInfoDouble(ACCOUNT_PROFIT);
         lbls[2]="Floating P/L";
         vals[2]=DoubleToString(flt, 2);
         vCols[2]=(flt>=0)?Theme.buy:Theme.sell;
         double mrgLvl = AccountInfoDouble(ACCOUNT_MARGIN_LEVEL);
         lbls[3]="Margin Level";
         vals[3]=DoubleToString(mrgLvl, 2) + "%";
         if(mrgLvl>0 && mrgLvl<100)
            vCols[3]=Theme.sell;
         lbls[4]="Used Margin";
         vals[4]=DoubleToString(AccountInfoDouble(ACCOUNT_MARGIN), 2);
         lbls[5]="Free Margin";
         vals[5]=DoubleToString(AccountInfoDouble(ACCOUNT_MARGIN_FREE), 2);
         lbls[6]="Leverage";
         vals[6]="1:" + IntegerToString(AccountInfoInteger(ACCOUNT_LEVERAGE));
         lbls[7]="Stop Out";
         vals[7]=DoubleToString(AccountInfoDouble(ACCOUNT_MARGIN_SO_SO), 0);

         // 3. CAMBIO "TYPE" POR "ACCOUNT MODE"
         lbls[8]="Account Mode";
         ENUM_ACCOUNT_TRADE_MODE modeAcc = (ENUM_ACCOUNT_TRADE_MODE)AccountInfoInteger(ACCOUNT_TRADE_MODE);
         vals[8]=(modeAcc==ACCOUNT_TRADE_MODE_DEMO)?"Demo":(modeAcc==ACCOUNT_TRADE_MODE_REAL)?"Real":"Contest";

         lbls[9]="Type";
         vals[9]=(AccountInfoInteger(ACCOUNT_MARGIN_MODE)==ACCOUNT_MARGIN_MODE_RETAIL_HEDGING)?"Hedging":"Netting";
         bool algo = AccountInfoInteger(ACCOUNT_TRADE_EXPERT);
         lbls[10]="Algo Trading";
         vals[10]=algo?"Allowed":"Disabled";
         if(!algo)
            vCols[10]=Theme.sell;
         lbls[11]="Server Time";
         vals[11]=TimeToString(TimeCurrent(), TIME_MINUTES);
        }
      else
         if(g_infoSubTab == 1) // STATS
           {
            double netProfit=0, grossProfit=0, grossLoss=0;
            int totalTrades=0, wins=0, losses=0, longWins=0, totalLong=0, shortWins=0, totalShort=0;
            double profitDay=0, profitMonth=0, profitYear=0;

            datetime today = iTime(_Symbol, PERIOD_D1, 0);
            datetime month = iTime(_Symbol, PERIOD_MN1, 0);
            MqlDateTime dt;
            TimeCurrent(dt);
            dt.mon=1;
            dt.day=1;
            dt.hour=0;
            dt.min=0;
            dt.sec=0;
            datetime year = StructToTime(dt);

            if(HistorySelect(0, TimeCurrent()))
              {
               int deals = HistoryDealsTotal();
               for(int i=0; i<deals; i++)
                 {
                  ulong tk = HistoryDealGetTicket(i);
                  if(tk <= 0 || HistoryDealGetInteger(tk, DEAL_ENTRY) != DEAL_ENTRY_OUT)
                     continue;

                  // FILTRO DEL DESPLEGABLE
                  string dealSym = HistoryDealGetString(tk, DEAL_SYMBOL);
                  if(g_modalStatsSym != "ALL SYMBOLS" && dealSym != g_modalStatsSym)
                     continue;

                  double prof = HistoryDealGetDouble(tk, DEAL_PROFIT) + HistoryDealGetDouble(tk, DEAL_SWAP) + HistoryDealGetDouble(tk, DEAL_COMMISSION);
                  long type = HistoryDealGetInteger(tk, DEAL_TYPE);
                  datetime time = (datetime)HistoryDealGetInteger(tk, DEAL_TIME);

                  netProfit += prof;
                  if(prof >= 0)
                    {
                     grossProfit += prof;
                     wins++;
                    }
                  else
                    {
                     grossLoss += prof;
                     losses++;
                    }
                  totalTrades++;
                  if(type == DEAL_TYPE_BUY)
                    {
                     totalLong++;
                     if(prof >= 0)
                        longWins++;
                    }
                  if(type == DEAL_TYPE_SELL)
                    {
                     totalShort++;
                     if(prof >= 0)
                        shortWins++;
                    }
                  if(time >= today)
                     profitDay += prof;
                  if(time >= month)
                     profitMonth += prof;
                  if(time >= year)
                     profitYear += prof;
                 }
              }

            double profitFactor = (grossLoss != 0) ? grossProfit / MathAbs(grossLoss) : grossProfit;
            double shortWonPct  = (totalShort > 0) ? ((double)shortWins / totalShort) * 100.0 : 0;
            double longWonPct   = (totalLong > 0)  ? ((double)longWins  / totalLong) * 100.0 : 0;
            double winPct       = (totalTrades > 0) ? ((double)wins / totalTrades) * 100.0 : 0;
            double lossPct      = (totalTrades > 0) ? ((double)losses / totalTrades) * 100.0 : 0;

            lbls[0]="Total Net Profit";
            vals[0]=DoubleToString(netProfit, 2);
            vCols[0]=(netProfit>=0)?Theme.buy:Theme.sell;
            lbls[1]="Gross Profit";
            vals[1]=DoubleToString(grossProfit, 2);
            vCols[1]=Theme.buy;
            lbls[2]="Gross Loss";
            vals[2]=DoubleToString(grossLoss, 2);
            vCols[2]=Theme.sell;
            lbls[3]="Profit Factor";
            vals[3]=DoubleToString(profitFactor, 2);
            lbls[4]="Total Trades";
            vals[4]=IntegerToString(totalTrades);
            lbls[5]="Short (won %)";
            vals[5]=DoubleToString(shortWonPct, 1) + "%";
            lbls[6]="Long (won %)";
            vals[6]=DoubleToString(longWonPct, 1) + "%";
            lbls[7]="Profit Trades %";
            vals[7]=DoubleToString(winPct, 1) + "%";
            vCols[7]=Theme.buy;
            lbls[8]="Loss Trades %";
            vals[8]=DoubleToString(lossPct, 1) + "%";
            vCols[8]=Theme.sell;
            lbls[9]="Profit Today";
            vals[9]=DoubleToString(profitDay, 2);
            lbls[10]="Profit Month";
            vals[10]=DoubleToString(profitMonth, 2);
            lbls[11]="Profit Year";
            vals[11]=DoubleToString(profitYear, 2);
           }
         else // SYMBOL
           {
            int spread = (int)SymbolInfoInteger(g_modalViewSym, SYMBOL_SPREAD);
            lbls[0]="Spread (pts)";
            vals[0]=IntegerToString(spread);
            if(spread>50)
               vCols[0]=Theme.accent;
            lbls[1]="Tick Value";
            vals[1]=DoubleToString(SymbolInfoDouble(g_modalViewSym, SYMBOL_TRADE_TICK_VALUE), 2);
            lbls[2]="Swap Long";
            vals[2]=DoubleToString(SymbolInfoDouble(g_modalViewSym, SYMBOL_SWAP_LONG), 2);
            lbls[3]="Swap Short";
            vals[3]=DoubleToString(SymbolInfoDouble(g_modalViewSym, SYMBOL_SWAP_SHORT), 2);

            // 4. AÑADIDO: 3-DAY SWAP
            ENUM_DAY_OF_WEEK day3 = (ENUM_DAY_OF_WEEK)SymbolInfoInteger(g_modalViewSym, SYMBOL_SWAP_ROLLOVER3DAYS);
            string dayTxt = EnumToString(day3);
            if(StringLen(dayTxt) > 4)
               dayTxt = StringSubstr(dayTxt, 4); // Borra el "DAY_"
            lbls[4]="3-Day Swap";
            vals[4]=dayTxt;

            lbls[5]="Min Lot";
            vals[5]=DoubleToString(SymbolInfoDouble(g_modalViewSym, SYMBOL_VOLUME_MIN), 2);
            lbls[6]="Max Lot";
            vals[6]=DoubleToString(SymbolInfoDouble(g_modalViewSym, SYMBOL_VOLUME_MAX), 2);
            lbls[7]="Lot Step";
            vals[7]=DoubleToString(SymbolInfoDouble(g_modalViewSym, SYMBOL_VOLUME_STEP), 2);
            lbls[8]="Stops Level";
            vals[8]=IntegerToString((int)SymbolInfoInteger(g_modalViewSym, SYMBOL_TRADE_STOPS_LEVEL)) + " pts";
            lbls[9]="Contract Size";
            vals[9]=DoubleToString(SymbolInfoDouble(g_modalViewSym, SYMBOL_TRADE_CONTRACT_SIZE), 0);

            long trMode = SymbolInfoInteger(g_modalViewSym, SYMBOL_TRADE_MODE);
            lbls[10]="Trade Mode";
            vals[10]=(trMode==SYMBOL_TRADE_MODE_FULL)?"Full Access":"Restricted";
            if(trMode!=SYMBOL_TRADE_MODE_FULL)
               vCols[10]=Theme.sell;

            double h = SymbolInfoDouble(g_modalViewSym, SYMBOL_BIDHIGH);
            double l = SymbolInfoDouble(g_modalViewSym, SYMBOL_BIDLOW);
            double p = SymbolInfoDouble(g_modalViewSym, SYMBOL_POINT);
            lbls[11]="Daily Range";
            vals[11]=(p>0)?DoubleToString((h-l)/p, 0)+" pts":"0";
           }

      // DIBUJAR A DOS COLUMNAS CON LETRAS GRANDES
      int startY = infoY + 40;
      int rowH = 26;
      int col1X = 15;
      int col2X = 15 + (mW - 30) / 2 + 10;
      int colW = ((mW - 30) / 2) - 5;

      for(int i=0; i<6; i++)
        {
         int rY = startY + (i * (rowH + 2));
         uint rowBg = (i % 2 == 0) ? Theme.bg : Theme.surface;

         // Izquierda (0 a 5)
         Modal.AddPanel(col1X, rY, colW, rowH, rowBg, 0);
         Modal.AddLabel(lbls[i], col1X + 5, rY + 4, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
         Modal.AddLabel(vals[i], col1X + colW - 5, rY + 4, "Arial", 13, vCols[i], TA_RIGHT|TA_TOP);

         // Derecha (6 a 11)
         Modal.AddPanel(col2X, rY, colW, rowH, rowBg, 0);
         Modal.AddLabel(lbls[i+6], col2X + 5, rY + 4, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
         Modal.AddLabel(vals[i+6], col2X + colW - 5, rY + 4, "Arial", 13, vCols[i+6], TA_RIGHT|TA_TOP);
        }

      Modal.Render();
     }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
   void              ProcessModalClick(int id)
     {
      switch(id)
        {
         case OP_MODAL_CLOSE:
            g_isModalOpen = false;
            g_perfLoaded = false;
            BuildModalUI();

            break;

         case OP_MODAL_TAB_ACC:
            g_infoSubTab = 0;
            BuildModalUI();

            break;

         case OP_MODAL_TAB_STAT:
            g_infoSubTab = 1;
            BuildModalUI();

            break;

         case OP_MODAL_TAB_SYM:
            g_infoSubTab = 2;
            BuildModalUI();

            break;

         case OP_MODAL_STAT_DROP:
           {
            int totalSym = MathMin(SymbolsTotal(true), 30);
            string symOpts[];
            ArrayResize(symOpts, totalSym + 1);
            symOpts[0] = "ALL SYMBOLS";
            for(int i=0; i<totalSym; i++)
               symOpts[i+1] = SymbolName(i, true);

            Modal.ToggleDropdown(id, symOpts);

            break;
           }

         case OP_MODAL_SYM_DROP:
           {
            int totalSym = MathMin(SymbolsTotal(true), 30);
            string symOpts[];
            ArrayResize(symOpts, totalSym);
            for(int i=0; i<totalSym; i++)
               symOpts[i] = SymbolName(i, true);

            Modal.ToggleDropdown(id, symOpts);

            break;
           }

         case OP_MODAL_PERF_PREV:
            g_perfPage--;
            BuildModalUI();

            break;

         case OP_MODAL_PERF_NEXT:
            g_perfPage++;
            BuildModalUI();

            break;


         default:
            // MAGIA MATEMÁTICA: Toggles del gráfico multi-símbolo (Rango 510 a 539)
            if(id >= OP_MODAL_SYM_TOGGLE_0 && id <= OP_MODAL_SYM_TOGGLE_0 + 29)
              {
               int idx = id - OP_MODAL_SYM_TOGGLE_0;
               if(idx >= 0 && idx < ArraySize(g_perfData))
                 {
                  g_perfData[idx].isActive = !g_perfData[idx].isActive;
                  BuildModalUI();

                 }
              }
            break;
        }
     }
//+------------------------------------------------------------------+
//| CARGA EL RENDIMIENTO HISTÓRICO SEPARADO POR SÍMBOLOS             |
//+------------------------------------------------------------------+
   void              LoadPerformanceData()
     {
      if(g_perfLoaded)
         return; // Solo cargar 1 vez al abrir para no dar lag

      ArrayResize(g_perfData, 0); // Limpiar

      // Añadimos una línea "Global" (Total Account) siempre de primera
      ArrayResize(g_perfData, 1);
      g_perfData[0].sym = "ALL (TOTAL)";
      g_perfData[0].colorLine = Theme.textMain; // Por defecto blanco, lo cambiaremos al final
      g_perfData[0].isActive = true;
      ArrayResize(g_perfData[0].history, 1);
      g_perfData[0].history[0] = 0.0;

      g_perfStartTime = 0;
      g_perfEndTime   = 0;

      if(!HistorySelect(0, TimeCurrent()))
         return;

      int deals = HistoryDealsTotal();
      int colorIdx = 0;
      double totalAcum = 0;

      // ELIMINADO EL LÍMITE DE 100. AHORA LEE TODA LA CUENTA DESDE EL CERO.
      for(int i = 0; i < deals; i++)
        {
         ulong tk = HistoryDealGetTicket(i);
         if(HistoryDealGetInteger(tk, DEAL_ENTRY) == DEAL_ENTRY_OUT)
           {
            string dSym = HistoryDealGetString(tk, DEAL_SYMBOL);
            double prof = HistoryDealGetDouble(tk, DEAL_PROFIT) + HistoryDealGetDouble(tk, DEAL_SWAP) + HistoryDealGetDouble(tk, DEAL_COMMISSION);
            datetime dTime = (datetime)HistoryDealGetInteger(tk, DEAL_TIME);

            // Capturamos fechas extremas para el Eje X
            if(g_perfStartTime == 0)
               g_perfStartTime = dTime;
            g_perfEndTime = dTime;

            // 1. Actualizar Total Global
            totalAcum += prof;
            int sGlobal = ArraySize(g_perfData[0].history);
            ArrayResize(g_perfData[0].history, sGlobal + 1);
            g_perfData[0].history[sGlobal] = totalAcum;

            // 2. Buscar si el símbolo ya existe en nuestra matriz
            int symIndex = -1;
            for(int j=1; j<ArraySize(g_perfData); j++)
              {
               if(g_perfData[j].sym == dSym)
                 {
                  symIndex = j;
                  break;
                 }
              }

            // Si no existe, lo creamos
            if(symIndex == -1)
              {
               symIndex = ArraySize(g_perfData);
               ArrayResize(g_perfData, symIndex + 1, 20);
               g_perfData[symIndex].sym = dSym;
               g_perfData[symIndex].colorLine = g_neonPalette[colorIdx % 8];
               g_perfData[symIndex].isActive = false; // Por defecto apagados

               // Inicializar con 0
               ArrayResize(g_perfData[symIndex].history, 1, 500);
               g_perfData[symIndex].history[0] = 0.0;
               colorIdx++;
              }

            // Actualizar el acumulado de este símbolo específico
            int sSym = ArraySize(g_perfData[symIndex].history);
            double lastProf = g_perfData[symIndex].history[sSym - 1];
            ArrayResize(g_perfData[symIndex].history, sSym + 1, 500);
            g_perfData[symIndex].history[sSym] = lastProf + prof;
           }
        }

      // --- MAGIA UX: COLOR DINÁMICO PARA EL TOTAL ---
      g_perfData[0].colorLine = (totalAcum >= 0) ? Theme.buy : Theme.sell;

      g_perfLoaded = true;
     }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
   void              BuildTimeUI()
     {
      if(!m_isTimeOpen)
        {
         TimeWin.DestroyCanvas();
         DWM.UnregisterWindow(GetPointer(TimeWin));
         return; // CERO variables que resetear
        }

      int chartW = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);
      int chartH = (int)ChartGetInteger(0, CHART_HEIGHT_IN_PIXELS);

      // =================================================================
      // 1. LÓGICA DE EXPANSIÓN INTELIGENTE (DYNAMIC SIZING)
      // =================================================================
      int totalTasks = ArraySize(m_taskList);
      int visibleRows = (totalTasks == 0) ? 1 : (int)MathMin(totalTasks, 6);
      bool showPagination = (totalTasks > 6);

      int mW = 520;
      int listY = 136;
      int rowH = 28;
      int listPanelH = 28 + (visibleRows * rowH);
      int bottomPadding = showPagination ? 45 : 15;
      int mH = listY + listPanelH + bottomPadding;

      int defX = (chartW / 2) - (mW / 2);
      int defY = (chartH / 2) - (mH / 2);
      if(defY < 10)
         defY = 10;

      int mX, mY;
      if(ObjectFind(0, "CanvasTimeTrader") >= 0)
        {
         mX = TimeWin.m_panelX;
         mY = TimeWin.m_panelY;
        }
      else
        {
         mX = (g_panelDisk[0].timeX > 0) ? g_panelDisk[0].timeX : defX;
         mY = (g_panelDisk[0].timeY > 0) ? g_panelDisk[0].timeY : defY;
        }

      // =================================================================
      // 2. LEER MEMORIA VISUAL (¡ANTES DE LIMPIAR EL CANVAS!)
      // =================================================================
      // --- MAGIA: Lectura instantánea del Reloj Central ---
      datetime now = TimeCore.Now();

      string dVal = TimeWin.GetButtonText(OP_TIME_INP_DATE);
      if(dVal == "")
        {
         dVal = TimeToString(now, TIME_DATE);
         StringReplace(dVal, ".", "-");
        }

      string tVal = TimeWin.GetButtonText(OP_TIME_INP_TIME);
      if(tVal == "")
        {
         tVal = TimeToString(now, TIME_MINUTES|TIME_SECONDS);
        }

      // --- INYECCIÓN DE TELEMETRÍA 1 ---
      //Print(">>> [TIME TRADER DEBUG] BuildTimeUI ejecutado. Valor rescatado del Input (tVal): ", tVal);

      string tkVal = TimeWin.GetButtonText(OP_TIME_INP_TICKET);
      if(tkVal == "")
         tkVal = "Ticket #";

      // =================================================================
      // 3. AHORA SÍ: LIMPIAR Y REDIMENSIONAR (Anti-Parpadeo)
      // =================================================================
      TimeWin.Clear(); // Limpiamos los botones viejos

      // ... (el código de Init y el Header se quedan igual) ...
      // ... baja hasta donde dice "COLUMNA 2: RELOJ" ...



      if(ObjectFind(0, "CanvasTimeTrader") < 0)
        {
         TimeWin.Init(ENGINE_TIME_TRADER, "CanvasTimeTrader", mX, mY, mW, mH);
         DWM.RegisterWindow(GetPointer(TimeWin));
        }
      else
        {
         TimeWin.Resize(mW, mH);
         ObjectSetInteger(0, "CanvasTimeTrader", OBJPROP_XDISTANCE, mX);
         ObjectSetInteger(0, "CanvasTimeTrader", OBJPROP_YDISTANCE, mY);
         TimeWin.m_panelX = mX;
         TimeWin.m_panelY = mY;
        }

      // --- HEADER ---

      // --- HEADER ---
      TimeWin.AddPanel(0, 0, mW, 35, Theme.surface, Theme.border);
      TimeWin.AddLabel("TIME TRADER SCHEDULER", 15, 8, "Arial", 13, Theme.accent, TA_LEFT|TA_TOP);
      TimeWin.AddButton(OP_TIME_CLOSE, mW - 35, 5, 25, 25, "X", Theme.surface, Theme.sell, Theme.sell, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 13);

      // --- COORDENADAS MAESTRAS ---
      int xCol1 = 20;
      int xCol2 = 195;
      int startY = 60;
      int hBtn = 26;

      // --- COLUMNA 1: ACCIÓN Y BOTÓN ADD ---
      TimeWin.AddButton(OP_TIME_ACTION_DROP, xCol1, startY, 160, hBtn, m_time_actionNames[m_time_selectedAction] + " ▼", Theme.surface, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      TimeWin.AddButton(OP_TIME_BTN_ADD, xCol1, startY + hBtn + 10, 160, 28, "+ ADD TASK", Theme.accent, ColorToARGB(C'60,195,90', 255), ColorToARGB(C'20,130,40', 255), ColorToARGB(clrWhite,255), 0, TA_CENTER|TA_VCENTER, "Arial", 12);

      // --- COLUMNA 2: RELOJ ---
      // --- CORRECCIÓN: Usamos 'now' (que ya es sintético) en vez de TimeCurrent() ---
      string sDate = TimeToString(now, TIME_DATE);
      StringReplace(sDate, ".", "-");
      string sTime = TimeToString(now, TIME_MINUTES|TIME_SECONDS);

      TimeWin.AddButton(OP_TIME_SYNC_DATE, xCol2, 40, 105, 18, sDate, Theme.bg, Theme.surface, Theme.bg, ColorToARGB(C'0,240,240',255), Theme.bg, TA_CENTER|TA_VCENTER, "Arial", 12);
      TimeWin.AddButton(OP_TIME_SYNC_TIME, xCol2 + 110, 40, 90, 18, sTime, Theme.bg, Theme.surface, Theme.bg, ColorToARGB(C'0,240,240',255), Theme.bg, TA_CENTER|TA_VCENTER, "Arial", 12);

      // --- INPUTS ---
      TimeWin.AddButton(OP_TIME_INP_DATE, xCol2, startY, 105, hBtn, dVal, Theme.inputBg, Theme.surface, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      TimeWin.AddButton(OP_TIME_INP_TIME, xCol2 + 110, startY, 90, hBtn, tVal, Theme.inputBg, Theme.surface, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      uint tkBg  = (m_time_selectedAction == 13) ? Theme.inputBg : Theme.surface;
      uint tkTxt = (m_time_selectedAction == 13) ? Theme.textMain : Theme.textDim;
      TimeWin.AddButton(OP_TIME_INP_TICKET, xCol2 + 205, startY, 100, hBtn, tkVal, tkBg, Theme.surface, Theme.accent, tkTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      // --- DÍAS DE LA SEMANA ---
      int dayX = xCol2;
      int dayY = startY + hBtn + 10;
      for(int i=0; i<7; i++)
        {
         uint dayBg = m_time_daysActive[i] ? Theme.accent : Theme.surface;
         uint dayTxt = m_time_daysActive[i] ? Theme.bg : Theme.textDim;
         TimeWin.AddButton(OP_TIME_DAY_0 + i, dayX, dayY, 42, 28, m_time_dayNames[i], dayBg, Theme.border, Theme.accent, dayTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
         dayX += 45;
        }

      // --- 4. ZONA DE LISTA DE TAREAS (DINÁMICA) ---
      // El listPanelH lo calculamos dinámicamente arriba
      TimeWin.AddPanel(15, listY, mW - 30, listPanelH, Theme.surface, Theme.border);
      TimeWin.AddPanel(16, listY + 1, mW - 32, 26, Theme.bg, 0);
      TimeWin.AddLabel("SCHEDULED TASKS", 25, listY + 5, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);

      int rowsPerPage = 6;
      int totalPages = (totalTasks == 0) ? 1 : (int)MathCeil((double)totalTasks / rowsPerPage);

      if(g_timeTaskPage >= totalPages)
         g_timeTaskPage = totalPages - 1;
      if(g_timeTaskPage < 0)
         g_timeTaskPage = 0;

      int startIndex = g_timeTaskPage * rowsPerPage;
      int taskY = listY + 27;

      // Iteramos usando nuestra variable visibleRows (que maximo llega a 6)
      for(int i = 0; i < visibleRows; i++)
        {
         int realIdx = startIndex + i;
         uint rowBg = (i % 2 == 0) ? Theme.surface : Theme.bg;

         TimeWin.AddPanel(16, taskY, mW - 32, rowH, rowBg, 0);

         // Si hay una tarea en este índice, la dibujamos
         if(realIdx < totalTasks)
           {
            TimeWin.AddLabel(m_taskList[realIdx].description, 25, taskY + 5, "Arial", 12, Theme.textMain, TA_LEFT|TA_TOP);
            TimeWin.AddButton(OP_TIME_DEL_0 + realIdx, mW - 45, taskY + 3, 22, 22, "X", Theme.bg, Theme.sell, Theme.sell, ColorToARGB(C'255,100,100',255), Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
           }
         taskY += rowH;
        }

      // --- 5. CONTROLES DE PAGINACIÓN (SÓLO SI ES NECESARIO) ---
      if(showPagination)
        {
         int botY = mH - 35;
         TimeWin.AddButton(OP_TIME_PREV, 15, botY, 70, 24, "< PREV", Theme.surface, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
         TimeWin.AddButton(OP_TIME_NEXT, mW - 85, botY, 70, 24, "NEXT >", Theme.surface, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

         string pageTxt = "Page " + IntegerToString(g_timeTaskPage + 1) + " / " + IntegerToString(totalPages);
         TimeWin.AddLabel(pageTxt, mW / 2, botY + 3, "Arial", 12, Theme.textDim, TA_CENTER|TA_TOP);
        }

      TimeWin.Render();
     }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
   void              ProcessTimeClick(int id)
     {
      switch(id)
        {
         case OP_TIME_CLOSE:
            m_isTimeOpen = false;
            BuildTimeUI();

            break;

         case OP_TIME_SYNC_DATE:
         case OP_TIME_SYNC_TIME:
           {
            // 100% WYSIWYG: Leemos exactamente lo que el usuario está viendo en el reloj sintético
            string d = TimeWin.GetButtonText(OP_TIME_SYNC_DATE);
            string t = TimeWin.GetButtonText(OP_TIME_SYNC_TIME);

            // Inyectamos a los inputs usando la actualización rápida (cero lag)
            TimeWin.FastUpdateText(OP_TIME_INP_DATE, d);
            TimeWin.FastUpdateText(OP_TIME_INP_TIME, t);

            // No necesitamos Render(), FastUpdateText ya actualizó la RAM y la pantalla

            break;
           }

         case OP_TIME_PREV:
            g_timeTaskPage--;
            BuildTimeUI();

            break;

         case OP_TIME_NEXT:
            g_timeTaskPage++;
            BuildTimeUI();

            break;

         case OP_TIME_ACTION_DROP:
            TimeWin.ToggleDropdown(id, m_time_actionNames);

            break;

         case OP_TIME_INP_TICKET:
            if(m_time_selectedAction == 13) // CLOSE BY TICKET
              {
               string tkOpts[];
               int count = 0;
               int memTotal = TradeRAM.Total();

               // --- INYECCIÓN: LEER EL ADN DIRECTO DESDE EL CEREBRO EN RAM ---
               for(int i = 0; i < memTotal; i++)
                 {
                  CTradeState *mem = TradeRAM.GetByIndex(i);

                  // Filtramos solo tickets vivos (Reales o Virtuales)
                  if(CheckPointer(mem) != POINTER_INVALID && mem.ticket > 0)
                    {
                     ArrayResize(tkOpts, count + 1);

                     double entry, sl, tp, vol;
                     long type;
                     CTradeState *dummyMem;
                     string extraInfo = "";

                     // El Oráculo nos da todo digerido (Sea posición, orden o virtual)
                     if(GetUnifiedTradeInfo(mem.ticket, entry, sl, tp, vol, type, dummyMem))
                       {
                        // Mapeamos el tipo de orden
                        string typeStr = (type == POSITION_TYPE_BUY || type == ORDER_TYPE_BUY_LIMIT || type == ORDER_TYPE_BUY_STOP || type == ORDER_TYPE_BUY_STOP_LIMIT) ? "BUY" : "SELL";

                        // Formateamos la información enriquecida (Igual que el Apply To)
                        extraInfo = " " + mem.symbol + " " + typeStr + " " + DoubleToString(vol, 2);
                       }

                     // ¿Es Virtual [V] o Real [R]?
                     string tType = mem.isVirtual ? "[V]" : "[R]";

                     // Lo empaquetamos
                     tkOpts[count] = tType + " #" + IntegerToString(mem.ticket) + extraInfo;
                     count++;
                    }
                 }

               // Si hay tickets, abrimos el menú. Si no, no hace nada.
               if(count > 0)
                 {
                  TimeWin.ToggleDropdown(id, tkOpts);
                 }
              }
            break;

         case OP_TIME_INP_DATE:
         case OP_TIME_INP_TIME:
            TimeWin.SpawnGhostInput(id);
            break;

         case OP_TIME_BTN_ADD:
           {
            string d = TimeWin.GetButtonText(OP_TIME_INP_DATE);
            string t = TimeWin.GetButtonText(OP_TIME_INP_TIME);
            datetime targetTime = StringToTime(d + " " + t);

            // --- PROTECCIÓN 1: Tiempo pasado (Usando Reloj Sintético) ---
            datetime syntheticNow = TimeCore.Now();
            if(targetTime <= syntheticNow)
              {
               Alert("Error: Cannot schedule a task in the past!");

               return;
              }

            int size = ArraySize(m_taskList);
            ArrayResize(m_taskList, size + 1, 20);

            // --- 1. IDENTIDAD Y TIEMPO ---
            m_taskList[size].taskId      = (ulong)GetMicrosecondCount(); // ID Único de alta precisión
            m_taskList[size].actionId    = m_time_selectedAction;
            m_taskList[size].execTime    = targetTime;
            m_taskList[size].symbol      = _Symbol;
            m_taskList[size].completed   = false;
            m_taskList[size].retryCount  = 0;

            // Identificación de ticket (Para Acción 13: Close by Ticket)
            if(m_time_selectedAction == 13)
               m_taskList[size].ticket = (long)StringToInteger(TimeWin.GetButtonText(OP_TIME_INP_TICKET));
            else
               m_taskList[size].ticket = 0;

            // Configuración de Bucle (Días)
            bool anyDayActive = false;
            string daysStr = "";
            for(int k=0; k<7; k++)
              {
               m_taskList[size].days[k] = m_time_daysActive[k];
               if(m_time_daysActive[k])
                 {
                  anyDayActive = true;
                  daysStr += m_time_dayNames[k] + ",";
                 }
              }
            m_taskList[size].isLoop = anyDayActive;

            // --- 2. EXTRACCIÓN INTELIGENTE DE PRECIO Y LOTE ---
            m_taskList[size].isPriceMode = m_isPriceMode;

            double rawLot   = PanelState.GetLot();
            m_taskList[size].lots = (rawLot > 0) ? rawLot : 0.01;

            double finalEntry = 0.0;
            double finalTrigger = 0.0;

            // A) ÓRDENES A MERCADO (BUY/SELL)
            if(m_time_selectedAction == 0 || m_time_selectedAction == 1)
              {
               finalEntry = 0.0; // Se calculará en vivo al ejecutarse
              }
            // B) ÓRDENES PENDIENTES (LIMITS Y STOPS NORMALES)
            else
               if(m_time_selectedAction >= 2 && m_time_selectedAction <= 5)
                 {
                  if(m_linesActive)
                    {
                     finalEntry = ObjectGetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE);
                    }
                  else
                     if(m_isPriceMode)
                       {
                        finalEntry = PanelState.GetPrice();
                       }

                  // ESCUDO: Si no hay líneas ni precio manual, bloqueamos
                  if(finalEntry <= 0)
                    {
                     Print("[Time Trader] ERROR: Cannot schedule a Pending Order without a defined price. Turn ON 'Price Mode' or 'Show Lines'.");
                     PlaySound("error.wav");
                     return; // Cortamos la ejecución. La tarea no nace.
                    }
                 }
               // C) ÓRDENES STOP LIMIT (Requieren DOS precios)
               else
                  if(m_time_selectedAction == 6 || m_time_selectedAction == 7)
                    {
                     if(m_linesActive)
                       {
                        finalEntry = ObjectGetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE);
                        if(ObjectFind(m_chartId, m_lineStopLimit) >= 0)
                           finalTrigger = ObjectGetDouble(m_chartId, m_lineStopLimit, OBJPROP_PRICE);
                       }
                     else
                        if(m_isPriceMode)
                          {
                           finalEntry = PanelState.GetPrice();

                           // Extraemos el valor del input OP_INP_STOPLIMIT (El PSL)
                           string pslText = Engine.GetButtonText(OP_INP_STOPLIMIT);
                           finalTrigger = StringToDouble(pslText);
                          }

                     // ESCUDO DOBLE: Si falta la entrada O falta el gatillo, bloqueamos
                     if(finalEntry <= 0 || finalTrigger <= 0)
                       {
                        Print("[Time Trader] ERROR: Stop Limit orders require BOTH an Entry Price and a Trigger Price (PSL).");
                        PlaySound("error.wav");
                        return;
                       }
                    }

            // Guardamos los precios validados en la tarea
            m_taskList[size].entryPrice = finalEntry;
            m_taskList[size].stopLimitPrice = finalTrigger;

            // Valores exactos de TP y SL
            m_taskList[size].sl_value = PanelState.GetSL();
            m_taskList[size].tp_value = PanelState.GetTP();

            // --- 3. EL CLON DEL GESTOR (MAGIA PURA) ---
            m_taskList[size].isVirtual = m_isVirtActive;
            m_taskList[size].isSplit   = m_isSplitActive;
            m_taskList[size].isHide    = m_isHideActive;
            m_taskList[size].isOCO     = m_isOCOActive;

            // Sincronizamos la RAM del Template antes de clonar para asegurarnos
            SyncPanelToTemplateState();

            // Clonamos las estructuras complejas
            m_taskList[size].ts   = TemplateState.ts;
            m_taskList[size].be   = TemplateState.be;
            m_taskList[size].grid = TemplateState.grid;

            // --- 4. CONSTRUCCIÓN DE DESCRIPCIÓN VISUAL ---
            string timeStr = TimeToString(targetTime, TIME_DATE|TIME_MINUTES);
            StringReplace(timeStr, ".", "-");
            string actName = m_time_actionNames[m_time_selectedAction];
            string desc = _Symbol + " | " + timeStr + " | " + actName;

            if(m_time_selectedAction >= 0 && m_time_selectedAction <= 7)
              {
               desc += " | L:" + DoubleToString(m_taskList[size].lots, 2);
               if(m_time_selectedAction >= 2 && m_time_selectedAction <= 7)
                  desc += " | E:" + DoubleToString(m_taskList[size].entryPrice, _Digits);

               string unit = m_isPriceMode ? "" : "p";
               string tpStr = (m_taskList[size].tp_value > 0) ? DoubleToString(m_taskList[size].tp_value, m_isPriceMode?_Digits:1) : "0";
               string slStr = (m_taskList[size].sl_value > 0) ? DoubleToString(m_taskList[size].sl_value, m_isPriceMode?_Digits:1) : "0";

               if(m_taskList[size].tp_value > 0 || m_taskList[size].sl_value > 0)
                  desc += " | TP:" + tpStr + unit + " SL:" + slStr + unit;
              }
            else
               if(m_time_selectedAction == 13)
                 {
                  desc += " | Tkt: #" + IntegerToString(m_taskList[size].ticket);
                 }

            if(anyDayActive)
              {
               if(StringLen(daysStr) > 0 && StringSubstr(daysStr, StringLen(daysStr)-1, 1) == ",")
                  daysStr = StringSubstr(daysStr, 0, StringLen(daysStr)-1);
               desc += " [" + daysStr + "]";
              }

            m_taskList[size].description = desc;

            SaveTasksToBin();

            //
            BuildTimeUI();
            break;
           }

         default:
            if(id >= OP_TIME_DAY_0 && id <= OP_TIME_DAY_0 + 6)
              {
               int idx = id - OP_TIME_DAY_0;
               m_time_daysActive[idx] = !m_time_daysActive[idx];
               BuildTimeUI();
               //
              }
            else
               if(id >= OP_TIME_DEL_0 && id <= OP_TIME_DEL_0 + 99)
                 {
                  int realIdx = id - OP_TIME_DEL_0;
                  RemoveTaskFromArray(realIdx);

                  int total = ArraySize(m_taskList);
                  int maxPage = (total == 0) ? 0 : (int)MathCeil((double)total / 6.0) - 1;
                  if(g_timeTaskPage > maxPage)
                     g_timeTaskPage = maxPage;

                  BuildTimeUI();

                 }
            break;
        }
     }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
   void              ProcessProtectClick(int id)
     {
      switch(id)
        {
         case OP_PROT_RESTORE_BTN:
            // --- FIX 1: Usar la ruta correcta con g_dataPath ---
            if(FileIsExist(g_dataPath + "TM_Recovery.bin"))
              {
               RestoreWorkspace();

               // --- FIX 2: ¡Liberar el candado al restaurar! ---
               g_protect.accountLockedUntil = 0;
               g_protect.peakEquity = AccountInfoDouble(ACCOUNT_EQUITY); // Resetear el pico histórico

               SaveProtectToBin(); // Guardar el desbloqueo en disco
               BuildProtectUI();   // Redibujar para que el botón se apague
              }
            else
              {
               //
              }
            break;
         case OP_PROT_CLOSE:
            m_isProtectOpen = false;
            BuildProtectUI();

            break;

         case OP_PROT_MASTER:
            g_protect.masterSwitch = !g_protect.masterSwitch;

            // --- Lógica inteligente de Encendido/Apagado ---
            if(!g_protect.masterSwitch)
              {
               // Si el usuario lo APAGA, quitamos el castigo/bloqueo de la cuenta
               g_protect.accountLockedUntil = 0;
              }
            else
              {
               // Si el usuario lo ENCIENDE, reseteamos la memoria base
               g_protect.peakEquity   = AccountInfoDouble(ACCOUNT_EQUITY);
               g_protect.startBalance = AccountInfoDouble(ACCOUNT_BALANCE);

               // --- ¡MAGIA! RECARGAMOS TODOS LOS CARTUCHOS DE TIEMPO ---
               g_protect.restoredToday  = false;
               g_protect.trigEveryday   = false;
               g_protect.trigFriday     = false;
               g_protect.trigDatetime   = false;
               //Print(">>> [PROTECTOR] Master Switch ON. Todos los detonadores de tiempo han sido rearmados.");
              }

            BuildProtectUI();
            BuildCanvasUI();
            SaveProtectToBin(); // Guardamos el cambio de estado
            break;

         case OP_PROT_DROP_SYM:
           {
            int totalSym = MathMin(SymbolsTotal(true), 30);
            string symOpts[];
            ArrayResize(symOpts, totalSym);
            for(int i=0; i<totalSym; i++)
               symOpts[i] = SymbolName(i, true);
            ProtectWin.ToggleDropdown(id, symOpts);

            break;
           }

         default:
            // 1. RANGO DE BOTONES "ENABLE"
            if(id >= OP_PROT_EN_0 && id <= OP_PROT_EN_0 + 13)
              {
               int idx = id - OP_PROT_EN_0;
               g_protect.f[idx].enabled = !g_protect.f[idx].enabled;
               SaveProtectToBin(); // <--- INYECTAR ESTO AQUÍ
               BuildProtectUI();

              }
            // 2. RANGO DE BOTONES "CLOSE EAs"
            else
               if(id >= OP_PROT_CEA_0 && id <= OP_PROT_CEA_0 + 13)
                 {
                  int idx = id - OP_PROT_CEA_0;
                  g_protect.f[idx].closeEAs = !g_protect.f[idx].closeEAs;

                  // INYECCIÓN 1: Forzamos guardado al disco
                  SaveProtectToBin();

                  // INYECCIÓN 2: Registro balístico en el Log
                  //Print(">>> [DEBUG UI] Clic en CLOSE EAs (Fila ", idx, "). Estado en RAM ahora es: ", g_protect.f[idx].closeEAs ? "ON (TRUE)" : "OFF (FALSE)");

                  BuildProtectUI();

                 }
               // 3. RANGO DE CAJAS DE TEXTO (Ghost Inputs)
               else
                  if(id >= OP_PROT_INP_0 && id <= OP_PROT_INP_0 + 12) // (El 13 es el dropdown)
                    {
                     ProtectWin.SpawnGhostInput(id);
                    }
            break;
        }
     }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
   void              BuildNewsUI()
     {
      if(!m_isNewsOpen)
        {
         NewsWin.DestroyCanvas();
         DWM.UnregisterWindow(GetPointer(NewsWin));
         return;
        }

      int chartW = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);
      int chartH = (int)ChartGetInteger(0, CHART_HEIGHT_IN_PIXELS);

      // --- 1. DIMENSIONES (Anchas para albergar eventos largos y fuente 12+) ---
      int mW = 620;
      int mH = 420;
      int defX = (chartW / 2) - (mW / 2);
      int defY = (chartH / 2) - (mH / 2);
      if(defY < 10)
         defY = 10;

      int mX, mY;
      if(ObjectFind(0, "CanvasNewsFilter") >= 0)
        {
         mX = NewsWin.m_panelX;
         mY = NewsWin.m_panelY;
        }
      else
        {
         mX = (g_panelDisk[0].newsX > 0) ? g_panelDisk[0].newsX : defX;
         mY = (g_panelDisk[0].newsY > 0) ? g_panelDisk[0].newsY : defY;
        }

      NewsWin.Clear();
      NewsWin.Init(ENGINE_NEWS, "CanvasNewsFilter", mX, mY, mW, mH);
      DWM.RegisterWindow(GetPointer(NewsWin));

      // --- 2. HEADER ---
      NewsWin.AddPanel(0, 0, mW, 35, Theme.surface, Theme.border);
      NewsWin.AddLabel("ECONOMIC CALENDAR (AUTO-FILTERED)", 15, 8, "Arial", 13, Theme.accent, TA_LEFT|TA_TOP);
      NewsWin.AddButton(OP_NEWS_CLOSE, mW - 35, 5, 25, 25, "X", Theme.surface, Theme.sell, Theme.sell, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 13);

      // --- 3. FILTROS Y BOTÓN MAESTRO (Y = 45) ---
      int fY = 45;
      uint cHighBg = g_newsFltHigh ? ColorToARGB(C'255,50,50', 255) : Theme.surface;
      uint cMedBg  = g_newsFltMed  ? ColorToARGB(C'255,160,0', 255) : Theme.surface;
      uint cLowBg  = g_newsFltLow  ? Theme.textDim : Theme.surface;

      uint cHighTxt= g_newsFltHigh ? Theme.bg : Theme.textDim;
      uint cMedTxt = g_newsFltMed  ? Theme.bg : Theme.textDim;
      uint cLowTxt = g_newsFltLow  ? Theme.bg : Theme.textDim;

      NewsWin.AddButton(OP_NEWS_FLT_HIGH, 15,  fY, 70, 26, "HIGH", cHighBg, Theme.border, cHighBg, cHighTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      NewsWin.AddButton(OP_NEWS_FLT_MED,  95,  fY, 70, 26, "MED",  cMedBg,  Theme.border, cMedBg,  cMedTxt,  Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      NewsWin.AddButton(OP_NEWS_FLT_LOW,  175, fY, 70, 26, "LOW",  cLowBg,  Theme.border, cLowBg,  cLowTxt,  Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      uint cMasterBg = g_showNewsLines ? Theme.accent : Theme.surface;
      uint cMasterTxt = g_showNewsLines ? Theme.bg : Theme.textDim;
      string txtMaster = g_showNewsLines ? "HIDE ALL LINES" : "SHOW ALL LINES";
      NewsWin.AddButton(OP_NEWS_TOG_ALL, mW - 165, fY, 150, 26, txtMaster, cMasterBg, Theme.border, Theme.accent, cMasterTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      // --- 4. PREPARAR DATOS (Filtro en RAM instantáneo) ---
      ArrayResize(g_newsFilteredIdx, 0);
      int count = 0;
      for(int i=0; i<ArraySize(g_newsList); i++)
        {
         int imp = g_newsList[i].importance;
         if(imp == CALENDAR_IMPORTANCE_HIGH && !g_newsFltHigh)
            continue;
         if(imp == CALENDAR_IMPORTANCE_MODERATE && !g_newsFltMed)
            continue;
         if(imp == CALENDAR_IMPORTANCE_LOW && !g_newsFltLow)
            continue;

         ArrayResize(g_newsFilteredIdx, count+1, 200);
         g_newsFilteredIdx[count] = i;
         count++;
        }

      int rowsPerPage = 8;
      int totalPages = (count == 0) ? 1 : (int)MathCeil((double)count / rowsPerPage);
      if(g_newsPage >= totalPages)
         g_newsPage = totalPages - 1;
      if(g_newsPage < 0)
         g_newsPage = 0;

      // --- 5. CAJA CONTENEDORA DE LA TABLA (Y = 85) ---
      int boxY = 85;
      int rowH = 32;
      int boxH = 32 + (8 * rowH); // Cabecera(32) + 8 filas(256) = 288px

      NewsWin.AddPanel(15, boxY, mW - 30, boxH, Theme.surface, Theme.border);
      NewsWin.AddPanel(16, boxY + 1, mW - 32, 30, Theme.bg, 0); // Cabecera interna

      int cX[5] = {25, 140, 205, 275, 540}; // Coordenadas de las columnas

      NewsWin.AddLabel("DATE / TIME", cX[0], boxY + 6, "Arial", 12, Theme.textMain, TA_LEFT|TA_TOP);
      NewsWin.AddLabel("CUR",         cX[1], boxY + 6, "Arial", 12, Theme.textMain, TA_LEFT|TA_TOP);
      NewsWin.AddLabel("IMP",         cX[2], boxY + 6, "Arial", 12, Theme.textMain, TA_LEFT|TA_TOP);
      NewsWin.AddLabel("EVENT NAME",  cX[3], boxY + 6, "Arial", 12, Theme.textMain, TA_LEFT|TA_TOP);
      NewsWin.AddLabel("CHART",       cX[4], boxY + 6, "Arial", 12, Theme.textMain, TA_LEFT|TA_TOP);

      // --- 6. DIBUJAR LAS 8 FILAS ---
      int startY = boxY + 31;
      int startIndex = g_newsPage * rowsPerPage;

      for(int i=0; i<8; i++)
        {
         int realIdx = startIndex + i;
         int currY = startY + (i * rowH);
         string sI = IntegerToString(i);
         uint rowBg = (i % 2 == 0) ? Theme.surface : Theme.bg; // Cebra invertida

         NewsWin.AddPanel(16, currY, mW - 32, rowH, rowBg, 0);

         if(realIdx < count)
           {
            int origIdx = g_newsFilteredIdx[realIdx];

            // Fecha/Hora
            string tStr = TimeToString(g_newsList[origIdx].time, TIME_DATE|TIME_MINUTES);
            StringReplace(tStr, ".", "-");
            NewsWin.AddLabel(tStr, cX[0], currY + 8, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);

            // Moneda
            NewsWin.AddLabel(g_newsList[origIdx].currency, cX[1], currY + 8, "Arial", 12, Theme.textMain, TA_LEFT|TA_TOP);

            // Impacto
            int imp = g_newsList[origIdx].importance;
            string impStr = (imp == 3) ? "HIGH" : (imp == 2) ? "MED" : "LOW";
            uint impCol = (imp == 3) ? ColorToARGB(C'255,50,50', 255) : (imp == 2) ? ColorToARGB(C'255,160,0', 255) : Theme.textDim;
            NewsWin.AddLabel(impStr, cX[2], currY + 8, "Arial", 12, impCol, TA_LEFT|TA_TOP);

            // Nombre del Evento (Trunco inteligentemente si es muy largo)
            string evName = g_newsList[origIdx].name;
            if(StringLen(evName) > 60)
               evName = StringSubstr(evName, 0, 60) + "...";
            NewsWin.AddLabel(evName, cX[3], currY + 8, "Arial", 13, Theme.textMain, TA_LEFT|TA_TOP);

            // Botón Chart (SHOW/OFF)
            bool isShown = g_newsList[origIdx].showLine;
            uint cBtnBg = isShown ? Theme.accent : Theme.bg;
            uint cBtnTxt = isShown ? Theme.bg : Theme.textDim;
            NewsWin.AddButton(OP_NEWS_SHOW_0 + i, cX[4], currY + 4, 60, 24, isShown ? "ON" : "OFF", cBtnBg, Theme.surface, Theme.accent, cBtnTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
           }
        }

      // --- 7. PAGINACIÓN ---
      int botY = mH - 35;
      NewsWin.AddButton(OP_NEWS_PREV, 15, botY, 80, 24, "< PREV", Theme.surface, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      NewsWin.AddButton(OP_NEWS_NEXT, mW - 95, botY, 80, 24, "NEXT >", Theme.surface, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      string pageTxt = "Page " + IntegerToString(g_newsPage + 1) + " / " + IntegerToString(totalPages);
      NewsWin.AddLabel(pageTxt, mW / 2, botY + 3, "Arial", 12, Theme.textDim, TA_CENTER|TA_TOP);

      NewsWin.Render();
     }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
   void              ProcessNewsClick(int id)
     {
      switch(id)
        {
         case OP_NEWS_CLOSE:
            m_isNewsOpen = false;
            BuildNewsUI();

            break;

         case OP_NEWS_FLT_HIGH:
            g_newsFltHigh = !g_newsFltHigh;
            BuildNewsUI();
            DrawNewsLines();

            break;

         case OP_NEWS_FLT_MED:
            g_newsFltMed  = !g_newsFltMed;
            BuildNewsUI();
            DrawNewsLines();

            break;

         case OP_NEWS_FLT_LOW:
            g_newsFltLow  = !g_newsFltLow;
            BuildNewsUI();
            DrawNewsLines();

            break;

         case OP_NEWS_TOG_ALL:
            g_showNewsLines = !g_showNewsLines;
            for(int i=0; i<ArraySize(g_newsList); i++)
               g_newsList[i].showLine = g_showNewsLines;
            BuildNewsUI();
            DrawNewsLines();
            ChartRedraw();

            break;

         case OP_NEWS_PREV:
            g_newsPage--;
            BuildNewsUI();

            break;

         case OP_NEWS_NEXT:
            g_newsPage++;
            BuildNewsUI();

            break;

         default:
            // MAGIA MATEMÁTICA: Detecta qué botón individual de las 8 filas fue pulsado (Rango 810 a 817)
            if(id >= OP_NEWS_SHOW_0 && id <= OP_NEWS_SHOW_0 + 7)
              {
               int row = id - OP_NEWS_SHOW_0; // Obtiene la fila visual (0 a 7)
               int realIdx = (g_newsPage * 8) + row; // Obtiene el índice real en base a la página actual

               if(realIdx < ArraySize(g_newsFilteredIdx))
                 {
                  int origIdx = g_newsFilteredIdx[realIdx]; // Recupera el evento original de la RAM
                  g_newsList[origIdx].showLine = !g_newsList[origIdx].showLine;

                  BuildNewsUI();
                  DrawNewsLines();
                  ChartRedraw();

                 }
              }
            break;
        }
     }

//+------------------------------------------------------------------+
//| HELPER: Convierte color ARGB (CCanvas) a color estándar (MT5)    |
//+------------------------------------------------------------------+
   color ARGBToColor(uint argb_color)
     {
      // Extraemos los canales individuales del formato ARGB (CCanvas)
      int r = (int)(argb_color >> 16) & 0xFF;
      int g = (int)(argb_color >> 8) & 0xFF;
      int b = (int)argb_color & 0xFF;

      // Re-ensamblamos en formato BGR (El nativo que usa MT5 para el tipo 'color')
      return (color)((b << 16) | (g << 8) | r);
     }


//+------------------------------------------------------------------+
//| APAGAR INPUTS: Capturar textos actuales y preparar arrastre      |
//+------------------------------------------------------------------+
   void              PreparePanelDrag()
     {
      // 1. Recorremos la memoria del Canvas para actualizar los textos
      for(int i = 0; i < ArraySize(Engine.m_inputText); i++)
        {
         string objName = Engine.m_inputText[i].name;

         if(ObjectFind(0, objName) >= 0)
           {
            // Leemos el texto REAL que tiene la cajita en este exacto milisegundo
            string currentText = ObjectGetString(0, objName, OBJPROP_TEXT);

            // Se lo inyectamos al texto fantasma del Canvas
            Engine.m_inputText[i].text = currentText;

            // Apagamos la luz de la cajita nativa
            ObjectSetInteger(0, objName, OBJPROP_TIMEFRAMES, OBJ_NO_PERIODS);
           }
        }

      // 2. Forzamos un renderizado para que el Canvas pinte los números nuevos
      Engine.Render();
     }

//+------------------------------------------------------------------+
//| ENCENDER INPUTS: Restaurar tras el arrastre                      |
//+------------------------------------------------------------------+
   void              EndPanelDrag()
     {
      // La magia de tu función BuildCanvasUI es que ya lee m_panelX y m_panelY,
      // recalcula la posición de todos los inputs nativos, los mueve y
      // les vuelve a poner OBJ_ALL_PERIODS. ¡Hace todo el trabajo sucio!
      BuildCanvasUI();
     }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
   void              DrawCanvasOrderMenu(CUIEngine &menuEngine, ulong ticket, int nativeX, int nativeY, long type, double vol, bool esPosicion)
     {

      // --- ¡SOLUCIÓN BUG VISUAL! Calculamos altura exacta al principio ---
      int mH = esPosicion ? 259 : 281;
      int mW = 140;

      int canvasX = nativeX;
      int canvasY = nativeY;

      string menuName = "CanvasOrderMenu_" + IntegerToString(ticket);

      if(ObjectFind(0, menuName) < 0)
        {
         menuEngine.Init(ENGINE_EA2_MENU, menuName, canvasX, canvasY, mW, mH, ticket);
         DWM.RegisterWindow(GetPointer(menuEngine));
         ObjectSetInteger(0, menuName, OBJPROP_ZORDER, 2000);
         ObjectSetInteger(0, menuName, OBJPROP_BACK, false);
        }
      else
        {
         ObjectSetInteger(0, menuName, OBJPROP_XDISTANCE, canvasX);
         ObjectSetInteger(0, menuName, OBJPROP_YDISTANCE, canvasY);
         menuEngine.m_panelX = canvasX;
         menuEngine.m_panelY = canvasY;
        }

      menuEngine.Clear();

      uint bgMenu    = Theme.bg;
      uint colBorder = Theme.border;
      uint textWhite = Theme.textMain;
      uint textDim   = Theme.textDim;
      uint btnNormal = Theme.bg;
      uint btnHover  = Theme.surface;
      uint mutedRed  = Theme.sell;
      uint mutedBlue = Theme.accent;
      uint bgHeader  = Theme.surface;

      // Al usar la mH correcta desde el inicio, el fondo cubrirá todo perfectamente.
      menuEngine.AddPanel(0, 0, mW, mH, bgMenu, 0);

      bool isBuy = (type == POSITION_TYPE_BUY || type == ORDER_TYPE_BUY_LIMIT || type == ORDER_TYPE_BUY_STOP || type == ORDER_TYPE_BUY_STOP_LIMIT);
      string typeStr = isBuy ? "BUY" : "SELL";
      string titleText = "#" + IntegerToString(ticket) + " " + typeStr;

      menuEngine.AddPanel(0, 0, mW, 20, bgHeader, colBorder);
      menuEngine.AddLabel(titleText, mW/2, 10, "Arial", 12, isBuy ? Theme.buy : Theme.sell, TA_CENTER|TA_VCENTER);
      menuEngine.AddButton(OP_TM_MENU_CLOSE, mW - 19, 1, 17, 17, "X", bgMenu, mutedRed, mutedRed, textDim, bgMenu, TA_CENTER|TA_VCENTER, "Arial", 10);

      int y = 30;
      int x = 3;
      int btnW = mW - 6;
      int hBtn = 20;
      int gap = 2;
      string font = "Arial";
      int fs = 12;

      // PARA SABER QUÉ BOTÓN ESTÁ "PRESIONADO" (Abierto)
      CTradeState *mem = TradeRAM.Get(ticket);
      ushort actSub = (mem != NULL) ? mem.activeSubMenu : 0;

      if(esPosicion)
        {
         uint colC = (actSub == OP_TM_M_CLOSE) ? mutedRed : btnNormal;
         menuEngine.AddButton(OP_TM_M_CLOSE, x, y, btnW, hBtn, "Close Order", colC, mutedRed, colC, textWhite, colC, TA_CENTER|TA_VCENTER, font, fs);
         y += hBtn + gap;

         uint colP = (actSub == OP_TM_M_PART) ? btnHover : btnNormal;
         menuEngine.AddButton(OP_TM_M_PART, x, y, btnW, hBtn, "Close Partial >", colP, btnHover, colP, textWhite, colP, TA_CENTER|TA_VCENTER, font, fs);
         y += hBtn + gap;

         string revTxt = isBuy ? "Close & Sell" : "Close & Buy";
         uint colR = (actSub == OP_TM_M_REV) ? mutedBlue : btnNormal;
         menuEngine.AddButton(OP_TM_M_REV, x, y, btnW, hBtn, revTxt, colR, mutedBlue, colR, textWhite, colR, TA_CENTER|TA_VCENTER, font, fs);

         y += hBtn + 4;
         menuEngine.AddPanel(10, y, mW - 20, 1, ColorToARGB(C'50,50,55', 255), 0);
         y += 5;
        }
      else
        {
         uint colC = (actSub == OP_TM_M_CLOSE) ? mutedRed : btnNormal;
         menuEngine.AddButton(OP_TM_M_CLOSE, x, y, btnW, hBtn, "Delete Order", colC, mutedRed, colC, textWhite, colC, TA_CENTER|TA_VCENTER, font, fs);
         y += hBtn + gap;

         bool isExpVisualOn = mem.isExpVisualOn;
         uint colExp = isExpVisualOn ? mutedBlue : btnNormal;
         menuEngine.AddButton(OP_TM_M_EXP, x, y, btnW, hBtn, isExpVisualOn ? "Expiration: SHOW" : "Expiration: HIDE", colExp, btnHover, colExp, textWhite, colExp, TA_CENTER|TA_VCENTER, font, fs);
         y += hBtn + gap;

         bool isOCOActive = mem.isOCO;
         uint colOCO = isOCOActive ? mutedBlue : btnNormal;
         menuEngine.AddButton(OP_TM_M_OCO, x, y, btnW, hBtn, isOCOActive ? "OCO Mode: ON" : "OCO Order >", colOCO, btnHover, colOCO, textWhite, colOCO, TA_CENTER|TA_VCENTER, font, fs);
         y += hBtn + gap;

         uint colTL = (actSub == OP_TM_M_TRLIM) ? btnHover : btnNormal;
         menuEngine.AddButton(OP_TM_M_TRLIM, x, y, btnW, hBtn, "Trailing Order >", colTL, btnHover, colTL, textWhite, colTL, TA_CENTER|TA_VCENTER, font, fs);

         y += hBtn + 4;
         menuEngine.AddPanel(10, y, mW - 20, 1, ColorToARGB(C'50,50,55', 255), 0);
         y += 5;
        }

      uint colE = (actSub == OP_TM_M_EDIT) ? btnHover : btnNormal;
      menuEngine.AddButton(OP_TM_M_EDIT, x, y, btnW, hBtn, "Modify >", colE, btnHover, colE, textWhite, colE, TA_CENTER|TA_VCENTER, font, fs);
      y += hBtn + gap;

      uint colG = (actSub == OP_TM_M_GRID) ? btnHover : btnNormal;
      menuEngine.AddButton(OP_TM_M_GRID, x, y, btnW, hBtn, "TP/SL Grid >", colG, btnHover, colG, textWhite, colG, TA_CENTER|TA_VCENTER, font, fs);
      y += hBtn + gap;

      uint colTS = (actSub == OP_TM_M_TS) ? btnHover : btnNormal;
      menuEngine.AddButton(OP_TM_M_TS, x, y, btnW, hBtn, "Trailing Stop >", colTS, btnHover, colTS, textWhite, colTS, TA_CENTER|TA_VCENTER, font, fs);
      y += hBtn + gap;

      uint colBE = (actSub == OP_TM_M_BE) ? btnHover : btnNormal;
      menuEngine.AddButton(OP_TM_M_BE, x, y, btnW, hBtn, "Break Even >", colBE, btnHover, colBE, textWhite, colBE, TA_CENTER|TA_VCENTER, font, fs);
      y += hBtn + gap;

      bool levelsHidden = mem.isHiddenActive;
      uint colHide = levelsHidden ? mutedRed : btnNormal;
      menuEngine.AddButton(OP_TM_M_HIDE, x, y, btnW, hBtn, levelsHidden ? "Hide TP/SL: ON" : "Hide TP/SL: OFF", colHide, btnHover, colHide, textWhite, colHide, TA_CENTER|TA_VCENTER, font, fs);
      y += hBtn + gap;

      // LECTURA 100% RAM: Cero latencia
      string commText = (mem.customComment != "") ? mem.customComment : "Comment";

      uint colComm = (actSub == OP_TM_M_COMM) ? btnHover : btnNormal;
      menuEngine.AddButton(OP_TM_M_COMM, x, y, btnW, hBtn, commText, colComm, btnHover, colComm, textWhite, colComm, TA_CENTER|TA_VCENTER, font, fs);
      y += hBtn + gap;

      uint colColor = (actSub == OP_TM_M_COLOR) ? btnHover : btnNormal;
      menuEngine.AddButton(OP_TM_M_COLOR, x, y, btnW, hBtn, "Color", colColor, btnHover, colColor, textWhite, colColor, TA_CENTER|TA_VCENTER, font, fs);

      menuEngine.Render();
     }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
   void              DrawCanvasSubMenu_Close(CUIEngine &subEngine, ulong ticket, int finalMenuX, int btnY)
     {
      int subW = 130;
      int subH = 55;
      int subX = GetSmartSubMenuX(finalMenuX, subW);

      string canvasName = "CanvasSubMenu_" + IntegerToString(ticket);

      if(ObjectFind(0, canvasName) < 0)
        {
         subEngine.Init(ENGINE_EA2_SUBMENU, canvasName, subX, btnY, subW, subH, ticket);
         DWM.RegisterWindow(GetPointer(subEngine));
         ObjectSetInteger(0, canvasName, OBJPROP_ZORDER, 2000);
         ObjectSetInteger(0, canvasName, OBJPROP_BACK, false);
        }
      else
        {
         ObjectSetInteger(0, canvasName, OBJPROP_XDISTANCE, subX);
         ObjectSetInteger(0, canvasName, OBJPROP_YDISTANCE, btnY);
         subEngine.m_panelX = subX;
         subEngine.m_panelY = btnY;
        }

      subEngine.Clear();

      uint bgMenu    = Theme.bg;
      uint colBorder = Theme.border;
      uint btnRed    = Theme.sell;
      uint btnGrey   = Theme.surface;

      subEngine.AddPanel(0, 0, subW, subH, bgMenu, colBorder);
      subEngine.AddLabel("Confirm Close?", subW/2, 10, "Arial", 12, Theme.textMain, TA_CENTER|TA_VCENTER);

      subEngine.AddButton(OP_TM_M_CLOSE_YES, 5, 25, 58, 22, "YES", btnRed, ColorToARGB(C'255,100,100',255), btnRed, Theme.textMain, btnRed, TA_CENTER|TA_VCENTER, "Arial", 11);
      subEngine.AddButton(OP_TM_M_CLOSE_NO, 67, 25, 58, 22, "NO", btnGrey, ColorToARGB(C'100,100,100', 255), btnGrey, Theme.textMain, btnGrey, TA_CENTER|TA_VCENTER, "Arial", 11);

      subEngine.Render();
     }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
   void              ProcessOrderMenuClick(ulong ticket, int opcode)
     {
      CTradeState *mem = TradeRAM.Get(ticket);
      if(mem == NULL)
         return;

      // ===================================================================
      // 0. INTERCEPTOR DE FANTASMAS (GHOST INPUTS EA2)
      // ===================================================================
      if(opcode == OP_TM_INP_PARTIAL_VOL || opcode == OP_TM_INP_EDIT_PR || opcode == OP_TM_INP_EDIT_TP ||
         opcode == OP_TM_INP_EDIT_SL || opcode == OP_TM_INP_COMM || opcode == OP_TM_INP_TRLIM_DIST ||
         opcode == OP_TM_INP_EDIT_TRIG ||
         (opcode >= OP_INP_GRID_TP_P_1 && opcode <= OP_INP_GRID_SL_V_5) ||
         (opcode >= OP_INP_TS_0 && opcode <= OP_INP_BE_OFFSET))
        {
         // Bloqueos condicionales si los modos AUTO están encendidos
         bool isDistInput = (opcode >= OP_INP_GRID_TP_P_1 && opcode <= OP_INP_GRID_TP_P_5) ||
                            (opcode >= OP_INP_GRID_SL_P_1 && opcode <= OP_INP_GRID_SL_P_5);
         if(isDistInput && mem.grid.distMode == MODE_AUTO)
            return;
         if(opcode == OP_INP_BE_OFFSET && mem.be.isAuto)
            return;

         // Despertar al fantasma de esta sub-ventana
         mem.subMenuCanvas.SpawnGhostInput(opcode);

         return; // Cortar ejecución
        }
      // ===================================================================
      // --- ABRIR DESPLEGABLE MODO TRAILING STOP ---
      // ===================================================================
      if(opcode == OP_TM_TS_MODE_DROP)
        {
         string opts[];
         ArrayCopy(opts, g_tsModes);
         mem.subMenuCanvas.ToggleDropdown(opcode, opts);
         return;
        }

      // ===================================================================
      // --. ¡AQUÍ! LÓGICA DE DROPDOWNS DE LAS SUB-VENTANAS (GRID) <---
      // ===================================================================
      if(opcode == OP_TM_GRID_DIST_DROP)
        {
         //////Print(">>> [TRAMPA 2] ABRIENDO DROPDOWN DISTANCIA...");
         string opts[];
         ArrayCopy(opts, g_gridDistOpts);
         mem.subMenuCanvas.ToggleDropdown(opcode, opts);
         return; // <-- CRÍTICO: Cortar aquí
        }

      if(opcode == OP_TM_GRID_LOT_DROP)
        {
         //////Print(">>> [TRAMPA 2] ABRIENDO DROPDOWN LOTES...");
         string opts[];
         ArrayCopy(opts, g_gridLotOpts);
         mem.subMenuCanvas.ToggleDropdown(opcode, opts);
         return; // <-- CRÍTICO: Cortar aquí
        }

      // ===================================================================
      // --- ABRIR DESPLEGABLES DEL TRAILING STOP ---
      // ===================================================================
      if(opcode >= OP_TM_TS_DROP_0 && opcode <= OP_TM_TS_DROP_5)
        {
         int r = opcode - OP_TM_TS_DROP_0;
         string opts[];
         int tsMode = mem.ts.mode;

         // Determinamos qué lista de opciones enviar según el Modo del TS y la Fila
         if((tsMode == 1 || tsMode == 2 || tsMode == 3 || tsMode == 4 || tsMode == 6) && r == 1)
            ArrayCopy(opts, g_tsTFs);
         else
            if(tsMode == 2 && r == 3)
               ArrayCopy(opts, g_maMethods);
            else
               if(tsMode == 2 && r == 4)
                  ArrayCopy(opts, g_maPrices);

         if(ArraySize(opts) > 0)
            mem.subMenuCanvas.ToggleDropdown(opcode, opts);

         return; // Cortar aquí
        }

      // ===================================================================
      // --- BOTONES ROTATIVOS DEL BREAK EVEN ---
      // ===================================================================
      if(opcode == OP_TM_BE_START_DROP)
        {
         mem.be.modeStart++;
         if(mem.be.modeStart > 3)
            mem.be.modeStart = 0;
         SaveTradesToBin();

         // Actualizamos las líneas del gráfico al instante
         int px = (mem.panelX > -1) ? mem.panelX : ((int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS) - 300);
         UpdateBELogic(ticket, px);

         UpdateOpenTradesVisuals();
         ChartRedraw();

         return;
        }

      if(opcode == OP_TM_BE_OFF_DROP)
        {
         mem.be.modeOffset++;
         if(mem.be.modeOffset > 3)
            mem.be.modeOffset = 0;
         SaveTradesToBin();

         // Actualizamos las líneas del gráfico al instante
         int px = (mem.panelX > -1) ? mem.panelX : ((int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS) - 300);
         UpdateBELogic(ticket, px);

         UpdateOpenTradesVisuals();
         ChartRedraw();

         return;
        }

      // 1. CERRAR EL MENÚ PRINCIPAL
      if(opcode == OP_TM_MENU_CLOSE)
        {
         mem.isMenuOpen = false;
         mem.activeSubMenu = 0;             // <-- SOLUCIÓN
         mem.subMenuCanvas.DestroyCanvas();
         CloseAllSubMenus(ticket); // <-- SOLUCIÓN
         UpdateOpenTradesVisuals();
         ChartRedraw();
         return;
        }

      // ===================================================================
      // TRAMO NUEVO: RECONECTANDO LOS INTERRUPTORES (TOGGLES)
      // ===================================================================

      // --- 1. OCO ORDER ---
      if(opcode == OP_TM_M_OCO)
        {
         mem.isOCO = !mem.isOCO;
         SaveTradesToBin();

         UpdateOpenTradesVisuals();
         ChartRedraw();
         return;
        }

      // --- 2. EXPIRATION ---
      if(opcode == OP_TM_M_EXP)
        {
         mem.isExpVisualOn = !mem.isExpVisualOn;
         if(!mem.isExpVisualOn)
            DeleteExpirationVisuals(ticket);
         SaveTradesToBin();

         UpdateOpenTradesVisuals();
         ChartRedraw();
         return;
        }
      // ===================================================================
      // 3. HIDE TP/SL (Cegando al Bróker - 100% RAM DRIVEN)
      // ===================================================================
      if(opcode == OP_TM_M_HIDE)
        {
         // --- MAGIA: LÓGICA PARA ÓRDENES VIRTUALES ---
         if(ticket >= VIRTUAL_TICKET_BASE)
           {
            if(mem.isHiddenActive)
              {
               // APAGAR HIDE VIRTUAL
               mem.isHiddenActive = false;

              }
            else
              {
               // ENCENDER HIDE VIRTUAL
               if(mem.virtTP > 0 || mem.virtSL > 0)
                 {
                  mem.virtualTP = mem.virtTP;
                  mem.virtualSL = mem.virtSL;
                  mem.isHiddenActive = true;
                 }
              }

            SaveTradesToBin(); // <--- UN SOLO GUARDADO AL FINAL
           }
         // --- LÓGICA PARA ÓRDENES Y POSICIONES REALES (100% ASÍNCRONO & LIBERADO) ---
         else
           {
            MqlTradeRequest req;
            ZeroMemory(req);
            req.magic = MAGIC_NUM;

            bool isPos = PositionSelectByTicket(ticket);
            bool isOrder = (!isPos && OrderSelect(ticket));

            if(mem.isHiddenActive)
              {
               // --- 1. OPTIMISTIC UI: Apagamos el Hide en RAM al instante ---
               mem.isHiddenActive = false;
               SaveTradesToBin();

               // --- 2. ESCUDO ANTI-BUCLE: ¿Hay algo que restaurar realmente? ---
               // Si ambos son 0, el bróker ya tiene 0. Enviar la petición causaría un
               // TRADE_RETCODE_NO_CHANGES, disparando un Rollback erróneo. ¡Así que lo ignoramos!
               if(mem.virtualSL > 0 || mem.virtualTP > 0)
                 {
                  if(isPos)
                    {
                     req.action   = TRADE_ACTION_SLTP;
                     req.position = ticket;
                     req.sl       = mem.virtualSL;
                     req.tp       = mem.virtualTP;
                    }
                  else
                     if(isOrder)
                       {
                        req.action       = TRADE_ACTION_MODIFY;
                        req.order        = ticket;
                        req.price        = OrderGetDouble(ORDER_PRICE_OPEN);
                        req.sl           = mem.virtualSL;
                        req.tp           = mem.virtualTP;
                        req.stoplimit    = OrderGetDouble(ORDER_PRICE_STOPLIMIT);
                        req.type_time    = (ENUM_ORDER_TYPE_TIME)OrderGetInteger(ORDER_TYPE_TIME);
                        req.expiration   = (datetime)OrderGetInteger(ORDER_TIME_EXPIRATION);
                       }

                  // Disparo asíncrono para restaurar los valores en el bróker
                  PushAsyncRequest(req, ticket, 0, ASYNC_TOGGLE_HIDE, 0, 0, 0, 0, true);
                 }
              }
            else
              {
               // 2. ENCENDER HIDE (Modo Fantasma Liberado)
               double realTP = isPos ? PositionGetDouble(POSITION_TP) : (isOrder ? OrderGetDouble(ORDER_TP) : 0);
               double realSL = isPos ? PositionGetDouble(POSITION_SL) : (isOrder ? OrderGetDouble(ORDER_SL) : 0);

               // --- MAGIA: SIEMPRE ENCENDEMOS EL HIDE EN RAM (Incluso si están en 0) ---
               mem.virtualTP = realTP;
               mem.virtualSL = realSL;
               mem.isHiddenActive = true;

               // ¿Hay que avisarle al bróker para que borre las reales?
               if((realTP > 0 || realSL > 0) && (isPos || isOrder))
                 {
                  if(isPos)
                    {
                     req.action   = TRADE_ACTION_SLTP;
                     req.position = ticket;
                     req.sl       = 0;
                     req.tp       = 0;
                    }
                  else
                     if(isOrder)
                       {
                        req.action       = TRADE_ACTION_MODIFY;
                        req.order        = ticket;
                        req.price        = OrderGetDouble(ORDER_PRICE_OPEN);
                        req.sl           = 0;
                        req.tp           = 0;
                        req.stoplimit    = OrderGetDouble(ORDER_PRICE_STOPLIMIT);
                        req.type_time    = (ENUM_ORDER_TYPE_TIME)OrderGetInteger(ORDER_TYPE_TIME);
                        req.expiration   = (datetime)OrderGetInteger(ORDER_TIME_EXPIRATION);
                       }

                  // Disparo asíncrono para limpiar el bróker (Con rollback visual por si falla)
                  PushAsyncRequest(req, ticket, 0, ASYNC_TOGGLE_HIDE, realSL, realTP, 0, 0, false);
                 }

               // Guardamos la nueva dimensión oculta
               SaveTradesToBin();

              }
           }

         UpdateOpenTradesVisuals();
         ChartRedraw();
         return;
        }

      // 2. LÓGICA DE SUB-VENTANAS (Toggle Acordeón)
      if(opcode == OP_TM_M_CLOSE || opcode == OP_TM_M_EDIT || opcode == OP_TM_M_PART ||
         opcode == OP_TM_M_REV || opcode == OP_TM_M_GRID || opcode == OP_TM_M_TS ||
         opcode == OP_TM_M_BE || opcode == OP_TM_M_COLOR || opcode == OP_TM_M_COMM ||
         opcode == OP_TM_M_TRLIM)
        {
         // --- MAGIA: PRE-LLENAR INPUTS DE MODIFY ---
         if(opcode == OP_TM_M_EDIT && mem.activeSubMenu != OP_TM_M_EDIT)
           {
            double e=0, s=0, t=0, v=0;
            long type=-1;
            CTradeState *dummy;
            if(GetUnifiedTradeInfo(ticket, e, s, t, v, type, dummy))
              {
               mem.draftPr = e;
               mem.draftSL = s;
               mem.draftTP = t;

               // Si es Stop Limit, rescatamos el gatillo
               if(type == ORDER_TYPE_BUY_STOP_LIMIT || type == ORDER_TYPE_SELL_STOP_LIMIT)
                  mem.draftTrig = mem.isVirtual ? mem.virtStopLimit : OrderGetDouble(ORDER_PRICE_OPEN);
               else
                  mem.draftTrig = 0;
              }
           }

         // --- LA CURA DEL CUADRO NEGRO: DESTRUCCIÓN TOTAL ANTES DE CAMBIAR ---
         if(mem.activeSubMenu == opcode)
           {
            mem.activeSubMenu = 0;
            mem.subMenuCanvas.DestroyCanvas();
           }
         else
           {
            mem.subMenuCanvas.DestroyCanvas(); // Esto ahora cerrará automáticamente el Dropdown por el cambio de arriba
            mem.activeSubMenu = (ushort)opcode;
           }

         UpdateOpenTradesVisuals();
         ChartRedraw();
         return;
        }

      // ===================================================================
      // 3. RESPUESTAS DE LA SUB-VENTANA DE CONFIRMACIÓN DE CIERRE
      // ===================================================================
      if(opcode == OP_TM_M_CLOSE_YES)
        {
         // (LÓGICA EXACTA COPIADA DE TU SISTEMA VIEJO)
         if(ticket >= VIRTUAL_TICKET_BASE)
           {
            mem.isVirtual = false;
            DeleteVirtualOrderData(ticket);
           }
         else
            if(PositionSelectByTicket(ticket))
              {
               if(QueueClosePosition(ticket))
                  TradeRAM.GarbageCollect();
              }
            else
               if(OrderSelect(ticket))
                 {
                  if(QueueDeleteOrder(ticket))
                     TradeRAM.GarbageCollect();
                 }

         // NO tocamos 'mem' aquí porque la operación pudo haber muerto
         UpdateOpenTradesVisuals();
         ChartRedraw();
         return;
        }

      if(opcode == OP_TM_M_CLOSE_NO)
        {
         mem.activeSubMenu = 0;
         UpdateOpenTradesVisuals();
         ChartRedraw();
         return;
        }

      // ===================================================================
      // 4. ACCIONES DE CIERRE PARCIAL
      // ===================================================================
      // ===================================================================
      // 4. ACCIONES DE CIERRE PARCIAL (MODO DIOS BLINDADO)
      // ===================================================================
      if(opcode == OP_TM_M_PART_OK)
        {
         double percent = (mem.draftPart > 0) ? mem.draftPart : 50.0; // LEEMOS DE LA RAM

         if(percent > 0 && percent <= 100 && PositionSelectByTicket(ticket))
           {
            double currentVol = PositionGetDouble(POSITION_VOLUME);

            // 🛡️ BUG CORREGIDO: Usamos mem.symbol en lugar de _Symbol
            double stepVol    = SymbolInfoDouble(mem.symbol, SYMBOL_VOLUME_STEP);
            double minVol     = SymbolInfoDouble(mem.symbol, SYMBOL_VOLUME_MIN);
            double closeVol   = currentVol * (percent / 100.0);

            closeVol = MathFloor(closeVol / stepVol) * stepVol;
            if(closeVol < minVol)
               closeVol = minVol;
            if(closeVol > currentVol)
               closeVol = currentVol;

            // 1. PREPARAR PETICIÓN
            MqlTradeRequest req;
            ZeroMemory(req);
            req.action       = TRADE_ACTION_DEAL;
            req.position     = ticket;
            req.symbol       = mem.symbol;
            req.volume       = closeVol;
            req.type         = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY) ? ORDER_TYPE_SELL : ORDER_TYPE_BUY;
            req.price        = (req.type == ORDER_TYPE_SELL) ? SymbolInfoDouble(mem.symbol, SYMBOL_BID) : SymbolInfoDouble(mem.symbol, SYMBOL_ASK);
            req.deviation    = 20;
            req.magic        = MAGIC_NUM;

            long fill = SymbolInfoInteger(mem.symbol, SYMBOL_FILLING_MODE);
            req.type_filling = ((fill & SYMBOL_FILLING_FOK) != 0) ? ORDER_FILLING_FOK : (((fill & SYMBOL_FILLING_IOC) != 0) ? ORDER_FILLING_IOC : ORDER_FILLING_RETURN);

            // 2. DISPARO ASÍNCRONO Y UI OPTIMISTA
            PushAsyncRequest(req, ticket, 0, ASYNC_CLOSE_PARTIAL);

            mem.activeSubMenu = 0;
            // OJO: No reseteamos mem.draftPart aquí. Lo hace la Secretaria en OnTradeTransaction si hay éxito.
            // Así, si falla, el borrador sigue ahí para que el usuario sepa que porcentaje intentó cerrar.
            SaveTradesToBin();     // FOTOGRAFÍA AL DISCO
            UpdateOpenTradesVisuals();
           }

         return;
        }

      // ===================================================================
      // 5. ACCIONES DE REVERSE (100% ASÍNCRONAS CON GHOST TICKETS)
      // ===================================================================
      if(opcode == OP_TM_M_REV_YES)
        {
         if(PositionSelectByTicket(ticket))
           {
            double entry, sl, tp, vol;
            long pType;
            CTradeState *dummyMem;

            if(GetUnifiedTradeInfo(ticket, entry, sl, tp, vol, pType, dummyMem))
              {
               // 1. Armamos la trampa temporal en la memoria
               mem.pending_reverse = true;
               mem.reverse_vol = vol;
               mem.reverse_sl_dist = (sl > 0) ? MathAbs(entry - sl) : 0;
               mem.reverse_tp_dist = (tp > 0) ? MathAbs(entry - tp) : 0;

               // 2. Encolamos el Cierre de la posición actual (Asíncrono)
               QueueClosePosition(ticket);

               // 3. Cerramos el menú visualmente
               mem.activeSubMenu = 0;
               g_needsRedraw = true;
              }
           }
         else
           {
            mem.activeSubMenu = 0;
            g_needsRedraw = true;
           }
         return;
        }

      if(opcode == OP_TM_M_REV_NO)
        {
         mem.activeSubMenu = 0;
         UpdateOpenTradesVisuals();
         ChartRedraw();
         return;
        }

      // ===================================================================
      // 7. ACCIÓN: APLICAR MODIFY (TP / SL / PRICE / TRIG)
      // ===================================================================
      if(opcode == OP_TM_M_EDIT_APPLY)
        {
         // Leer valores de nuestros borradores en la RAM
         double newTP    = mem.draftTP;
         double newSL    = mem.draftSL;
         double newPrice = mem.draftPr;
         double newTrig  = mem.draftTrig;

         // --- ÓRDENES VIRTUALES ---
         if(ticket >= VIRTUAL_TICKET_BASE)
           {
            if(newPrice > 0)
               mem.virtEntry = newPrice;
            if(newTrig > 0 && (mem.virtType == ORDER_TYPE_BUY_STOP_LIMIT || mem.virtType == ORDER_TYPE_SELL_STOP_LIMIT))
               mem.virtStopLimit = newTrig; // Gatillo

            mem.virtTP = newTP;
            mem.virtSL = newSL;

            if(mem.isHiddenActive)
              {
               mem.virtualTP = newTP;
               mem.virtualSL = newSL;
              }

            mem.draftTP = -1;
            mem.draftSL = -1;
            mem.draftPr = -1;
            mem.draftTrig = -1;
            SaveVirtualOrder(ticket);

            mem.activeSubMenu = 0;
           }
         // --- ÓRDENES REALES ---
         else
           {
            if(mem.isHiddenActive)
              {
               mem.virtualTP = newTP;
               mem.virtualSL = newSL;

               mem.draftTP = -1;
               mem.draftSL = -1;
               mem.draftPr = -1;
               mem.draftTrig = -1;
               SaveTradesToBin();

               mem.activeSubMenu = 0;
              }
            else
              {
               if(OrderSelect(ticket)) // Si es Orden Pendiente
                 {
                  long oType = OrderGetInteger(ORDER_TYPE);

                  // OBTENER VALORES VIEJOS (Para Rollback)
                  double oldTrigger = OrderGetDouble(ORDER_PRICE_OPEN);
                  double oldSL      = OrderGetDouble(ORDER_SL);
                  double oldTP      = OrderGetDouble(ORDER_TP);
                  double oldLimit   = OrderGetDouble(ORDER_PRICE_STOPLIMIT);

                  // LA CURA DEL SALTO: Mapeo correcto para MT5
                  double finalTrigger   = oldTrigger; // req.price
                  double finalExecution = 0;          // req.stoplimit

                  if(oType == ORDER_TYPE_BUY_STOP_LIMIT || oType == ORDER_TYPE_SELL_STOP_LIMIT)
                    {
                     finalTrigger   = (newTrig > 0) ? newTrig : oldTrigger;       // El Gatillo (Línea Morada)
                     finalExecution = (newPrice > 0) ? newPrice : oldLimit;       // La Entrada (Línea Central)
                    }
                  else
                    {
                     finalTrigger = (newPrice > 0) ? newPrice : oldTrigger;       // La Entrada (Órdenes normales)
                    }

                  // PREPARAR PETICIÓN
                  MqlTradeRequest request;
                  ZeroMemory(request);
                  request.action       = TRADE_ACTION_MODIFY;
                  request.order        = ticket;
                  request.price        = finalTrigger;    // <--- Gatillo para Stop Limits
                  request.stoplimit    = finalExecution;  // <--- Entrada para Stop Limits
                  request.sl           = newSL;
                  request.tp           = newTP;
                  request.type_time    = (ENUM_ORDER_TYPE_TIME)OrderGetInteger(ORDER_TYPE_TIME);
                  request.expiration   = (datetime)OrderGetInteger(ORDER_TIME_EXPIRATION);

                  // UI OPTIMISTA: MENTIR A LA RAM AL INSTANTE SIN CRUZAR VARIABLES
                  if(oType == ORDER_TYPE_BUY_STOP_LIMIT || oType == ORDER_TYPE_SELL_STOP_LIMIT)
                    {
                     mem.openPrice     = finalExecution; // <--- LA CURA: Aquí va la entrada real
                     mem.virtStopLimit = finalTrigger;   // <--- LA CURA: Y aquí guardamos el gatillo
                    }
                  else
                    {
                     mem.openPrice = finalTrigger;
                    }

                  if(newSL > 0)
                     mem.slPrice = newSL;
                  if(newTP > 0)
                     mem.tpPrice = newTP;

                  mem.draftTP = -1;
                  mem.draftSL = -1;
                  mem.draftPr = -1;
                  mem.draftTrig = -1;

                  // DISPARO ASÍNCRONO
                  PushAsyncRequest(request, ticket, 0, ASYNC_MODIFY_PRICE, oldSL, oldTP, oldTrigger);

                  mem.activeSubMenu = 0;
                 }
               else
                  if(PositionSelectByTicket(ticket)) // Si es Posición Activa
                    {
                     // ... (Este bloque queda exactamente igual a como lo tenías, gestionando SL y TP)
                     double oldSL = PositionGetDouble(POSITION_SL);
                     double oldTP = PositionGetDouble(POSITION_TP);

                     MqlTradeRequest request;
                     ZeroMemory(request);
                     request.action   = TRADE_ACTION_SLTP;
                     request.position = ticket;
                     request.sl       = newSL;
                     request.tp       = newTP;

                     if(newSL > 0)
                        mem.slPrice = newSL;
                     if(newTP > 0)
                        mem.tpPrice = newTP;

                     mem.draftTP = -1;
                     mem.draftSL = -1;
                     mem.draftPr = -1;

                     PushAsyncRequest(request, ticket, 0, ASYNC_MODIFY_SL, oldSL, oldTP, 0);
                     mem.activeSubMenu = 0;
                    }
              }
           }

         UpdateOpenTradesVisuals();
         ChartRedraw();
         return;
        }

      // ===================================================================
      // 7.1 ACCIONES CCANVAS: COLOR, COMMENT, TRLIM, BREAK EVEN Y TRAILING
      // ===================================================================

      // --- COLOR ---
      if(opcode >= OP_TM_COLOR_0 && opcode <= OP_TM_COLOR_9)
        {
         int colorIdx = opcode - OP_TM_COLOR_0;
         color pal[10] = { C'0,120,215', C'40,167,69', C'220,53,69', C'255,160,0', C'180,80,255', C'0,240,240', C'255,20,110', C'255,200,0', C'150,150,150', clrNONE };
         mem.customColor = pal[colorIdx];

         SaveTradesToBin(); // <-- Cero parches
         mem.activeSubMenu = 0; // Cierra el menú tras elegir
         UpdateOpenTradesVisuals();
         ChartRedraw();

         return;
        }

      // --- COMMENT ---
      if(opcode == OP_TM_COMM_SAVE)
        {
         // 100% RAM DRIVEN: El texto YA fue guardado en mem.customComment por el Ghost Input.
         // El botón "SAVE" ahora solo actúa como confirmación UX para cerrar la ventana.

         mem.activeSubMenu = 0; // Cerramos el submenú

         UpdateOpenTradesVisuals();
         ChartRedraw();

         return;
        }

      // --- TRAILING LIMIT ---
      if(opcode == OP_TM_TRLIM_EXEC)
        {
         mem.isTrailLimitActive = !mem.isTrailLimitActive;
         SaveTradesToBin(); // <-- Cero parches
         UpdateOpenTradesVisuals();
         ChartRedraw();

         return;
        }

      // --- BREAK EVEN ---
      if(opcode == OP_TM_BE_EXEC)
        {
         mem.be.isActive = !mem.be.isActive;
         SaveTradesToBin();
         UpdateOpenTradesVisuals();
         ChartRedraw();

         return;
        }
      //+------------------------------------------------------------------+
      //|                                                                  |
      //+------------------------------------------------------------------+
      if(opcode == OP_TM_BE_AUTO)
        {
         mem.be.isAuto = !mem.be.isAuto;
         SaveTradesToBin();
         UpdateOpenTradesVisuals();
         ChartRedraw();

         return;
        }

      // --- TRAILING STOP ---
      if(opcode == OP_TM_TS_EXEC)
        {
         mem.ts.isActive = !mem.ts.isActive;
         mem.ts.anchorPrice = 0; // Resetear ancla
         SaveTradesToBin();

         int px = (mem.panelX > -1) ? mem.panelX : ((int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS) - 300);
         TS_Calculation tsCalc = CalculateTSLevels(ticket);
         DrawTSVisuals(ticket, tsCalc, px);
         UpdateOpenTradesVisuals();
         ChartRedraw();

         return;
        }

      if(opcode >= OP_TM_TS_UNIT_0 && opcode <= OP_TM_TS_UNIT_5)
        {
         int r = opcode - OP_TM_TS_UNIT_0;
         if((mem.ts.mode == TS_ATR && (r==4 || r==5)) || (mem.ts.mode == TS_PARTIAL && r==0))
            mem.ts.units[r] ^= 1; // Alternar entre 0 y 1 (ON/OFF)
         else
           {
            mem.ts.units[r]++;
            if(mem.ts.units[r] > 3)
               mem.ts.units[r] = 0; // Rotativo
           }

         SaveTradesToBin(); // <-- Guardado asíncrono

         int px = (mem.panelX > -1) ? mem.panelX : ((int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS) - 300);
         TS_Calculation tsCalc = CalculateTSLevels(ticket);
         DrawTSVisuals(ticket, tsCalc, px);
         UpdateOpenTradesVisuals();
         ChartRedraw();

         return;
        }

      // ===================================================================
      // 8. ACCIONES DEL GRID (LÓGICA CCANVAS)
      // ===================================================================

      // B. Selección de los Menús Desplegables
      if(opcode >= OP_TM_GRID_DIST_SET_0 && opcode <= OP_TM_GRID_DIST_SET_3)
        {
         mem.grid.distMode = opcode - OP_TM_GRID_DIST_SET_0;
         mem.grid.isDistOpen = false;
         SaveTradesToBin();
         UpdateOpenTradesVisuals();
         ChartRedraw();
         return;
        }
      if(opcode >= OP_TM_GRID_LOT_SET_0 && opcode <= OP_TM_GRID_LOT_SET_2)
        {
         mem.grid.lotMode = opcode - OP_TM_GRID_LOT_SET_0;
         mem.grid.isLotOpen = false;
         SaveTradesToBin();
         UpdateOpenTradesVisuals();
         ChartRedraw();
         return;
        }

      // C. Activar/Desactivar niveles del Grid (TP)
      if(opcode >= OP_TM_GRID_TP_1 && opcode <= OP_TM_GRID_TP_5)
        {
         int row = opcode - OP_TM_GRID_TP_1;
         mem.grid.rows[row].isActiveTP = !mem.grid.rows[row].isActiveTP;
         SaveTradesToBin();
         UpdateOpenTradesVisuals();
         ChartRedraw();
         return;
        }

      // D. Activar/Desactivar niveles del Grid (SL)
      if(opcode >= OP_TM_GRID_SL_1 && opcode <= OP_TM_GRID_SL_5)
        {
         int row = opcode - OP_TM_GRID_SL_1;
         mem.grid.rows[row].isActiveSL = !mem.grid.rows[row].isActiveSL;
         SaveTradesToBin();
         UpdateOpenTradesVisuals();
         ChartRedraw();
         return;
        }
      //+------------------------------------------------------------------+
      //|                                                                  |
      //+------------------------------------------------------------------+
      SaveTradesToBin();
     }

