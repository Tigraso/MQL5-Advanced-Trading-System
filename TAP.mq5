//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
class CTradeState
  {
public:
   ulong             ticket;
   string            symbol;
   long              type;
   ushort            sym_id;
   int               panelX;
   bool              isCollapsed;
   bool              isMenuOpen;
   string            activeTab;
   bool              isHiddenActive;
   double            virtualTP;
   double            virtualSL;
   bool              isOCO;
   bool              isExpVisualOn;
   double            dragTime;
   bool              isTrailLimitActive;
   double            trailLimitDist;
   double            cancelPrice;
   SBreakEven        be;
   STrailingStop     ts;
   SGridManager      grid;
   color             customColor;

   // --- CACHÉ DEL BRÓKER (Para HFT Cero-Latencia) ---
   double            openPrice;
   double            slPrice;
   double            tpPrice;
   double            currentVol;
   double            currentComm; // <--- AÑADIR ESTO

   string            customComment; // <-- NUEVO

   // --- ESTADOS DE RENDERIZADO (PUSH-ONLY) ---
   bool              vis_base_spawned;  // Botón Entry, Move, Menu
   bool              vis_tp_spawned;    // Botón y Línea TP
   bool              vis_sl_spawned;    // Botón y Línea SL
   bool              vis_sec_spawned;   // Botón y Línea StopLimit
   bool              vis_canc_spawned;  // Botón y Línea Cancel

   long              last_time_msc; // <--- NUEVO: Memoria celular del Tick

   // --- BORRADORES PARA MENÚS CCANVAS ---
   double            draftTP;
   double            draftSL;
   double            draftPr;
   double            draftTrig; // <--- NUEVO: Borrador del Stop Limit
   double            draftPart;

   // --- MOTOR HFT: BÚFER DE COMANDOS (MEMORIA DE ACCIONES) ---
   uint              cmd_flags;       // Acumula los bits encendidos (1, 2, 4...)
   bool              is_firing;
   double            cmd_target_sl;   // SL matemático calculado
   double            cmd_target_tp;   // TP matemático calculado
   double            cmd_target_price;// Precio de entrada matemático calculado
   double            cmd_target_vol;  // Lote a cerrar (si hay cierre parcial)
   string            cmd_comment;     // Comentario para el broker

   // --- CACHÉ DE NOMBRES BITWISE (Cero String Allocation en Bucles) ---
   string            obj_btnEntry;
   string            obj_btnMove;
   string            obj_btnMenu;
   string            obj_btnTP;
   string            obj_btnCancToggle;
   string            obj_rectTP;
   string            obj_hlineTP;
   string            obj_btnSL;
   string            obj_rectSL;
   string            obj_hlineSL;
   string            obj_btnSec;
   string            obj_visSec;   // Línea punteada visual StopLimit
   string            obj_btnCanc;
   string            obj_visCanc;  // Línea punteada visual Cancel
   // -------------------------------------------------------------------

   // ====================================================================
   // ⏳ MOTOR ASÍNCRONO (HFT ASYNC LOCK & RETRY SYSTEM)
   // ====================================================================
   bool              async_is_waiting;  // ¿Estamos esperando respuesta del bróker?
   uint              async_last_time;   // Cronómetro del disparo (Para el Timeout)
   uint              async_retry_count; // Contador de intentos fallidos

   // --- NUEVO: MEMORIA TEMPORAL PARA REVERSE ASÍNCRONO ---
   bool              pending_reverse;
   double            reverse_vol;
   double            reverse_sl_dist;
   double            reverse_tp_dist;

   // --- NUEVO: MOTORES CCANVAS POR OPERACIÓN ---
   CUIEngine         menuCanvas;    // Lienzo para el Menú Principal
   CUIEngine         subMenuCanvas; // Lienzo para la Sub-ventana (Modify, Partial, etc.)

   ushort            activeSubMenu; // Guarda qué sub-menú está abierto (Ej: OP_TM_M_CLOSE)

   // --- NUEVO: DATOS EXCLUSIVOS PARA ÓRDENES VIRTUALES ---
   bool              isVirtual;
   ENUM_ORDER_TYPE   virtType;
   double            virtEntry;
   double            virtSL;
   double            virtTP;
   double            virtLot;
   string            virtComment;
   int               virtPriceMode; // 0=Ask/Bid, 1=Ask, 2=Bid, etc.
   double            virtStopLimit; // <--- NUEVO: Memoria para la línea morada
   datetime          virtExpiration; // <--- NUEVO: Memoria de caducidad

                     CTradeState(ulong t, string sym)
     {
      draftTrig = 0;
      currentComm = 0;
      sym_id = GetSymbolID(sym); // <--- REGISTRO AUTOMÁTICO AL NACER
      is_firing = false;

      pending_reverse = false;
      reverse_vol = 0;
      reverse_sl_dist = 0;
      reverse_tp_dist = 0;


      async_is_waiting  = false;
      async_last_time   = 0;
      async_retry_count = 0;

      ticket = t;
      symbol = sym;
      isCollapsed = false;
      isMenuOpen = false;
      activeTab = "None";
      isOCO = false;
      isExpVisualOn = false;
      dragTime = 0;
      isTrailLimitActive = false;
      customComment = "";
      draftTP = 0;
      draftSL = 0;
      draftPr = 0;
      draftPart = 50.0; // 50% por defecto para el cierre parcial
      trailLimitDist = 20;

      vis_base_spawned = false;
      vis_tp_spawned   = false;
      vis_sl_spawned   = false;
      vis_sec_spawned  = false;
      vis_canc_spawned = false;

      last_time_msc = 0;

      openPrice = 0;
      slPrice = 0;
      tpPrice = 0;
      currentVol = 0;

      cmd_flags = CMD_NONE;
      cmd_target_sl = 0;
      cmd_target_tp = 0;
      cmd_target_price = 0;
      cmd_target_vol = 0;
      cmd_comment = "";


      cancelPrice = 0.0;
      activeSubMenu = 0;

      isVirtual = false;
      virtType = 0;
      virtEntry = 0;
      virtSL = 0;
      virtTP = 0;
      virtLot = 0;
      virtPriceMode = 0;
      virtStopLimit = 0;
      virtExpiration = 0;
      virtComment = "";

      panelX = -1;
      customColor = clrNONE;
      isHiddenActive = false;
      virtualTP = 0;
      virtualSL = 0;

      be.Init();
      ts.Init();
      grid.Init();

      // ====================================================================
      // PRE-CÁLCULO DE NOMBRES BITWISE (1 Sola vez en la vida de la orden)
      // ====================================================================
      if(ticket > 0)
        {
         obj_btnEntry = MakeTMName(ticket, OP_TM_ENTRY);
         obj_btnMove  = MakeTMName(ticket, OP_TM_MOVE);
         obj_btnCancToggle = MakeTMName(ticket, OP_TM_CANCEL_TOGGLE);
         obj_btnMenu  = MakeTMName(ticket, OP_TM_MENU);
         obj_btnTP    = MakeTMName(ticket, OP_TM_TP);
         obj_rectTP   = MakeTMName(ticket, OP_TM_RECT_TP);
         obj_hlineTP  = MakeTMName(ticket, OP_HLINE_TP);
         obj_btnSL    = MakeTMName(ticket, OP_TM_SL);
         obj_rectSL   = MakeTMName(ticket, OP_TM_RECT_SL);
         obj_hlineSL  = MakeTMName(ticket, OP_HLINE_SL);
         obj_btnSec   = MakeTMName(ticket, OP_TM_SEC);
         obj_visSec   = obj_btnSec + "_VisLine";
         obj_btnCanc  = MakeTMName(ticket, OP_TM_CANCEL_LBL);
         obj_visCanc  = obj_btnCanc + "_VisLine";
        }

      // ====================================================================
      // LECTURA DESDE EL DISCO DURO VIRTUAL EN RAM (Cero Variables Globales)
      // ====================================================================
      int diskTotal = ArraySize(g_tradeDisk);
      for(int i = 0; i < diskTotal; i++)
        {
         if(g_tradeDisk[i].ticket == ticket)
           {
            panelX             = g_tradeDisk[i].panelX;
            isCollapsed        = g_tradeDisk[i].isCollapsed;
            isHiddenActive     = g_tradeDisk[i].isHiddenActive;
            virtualTP          = g_tradeDisk[i].virtualTP;
            virtualSL          = g_tradeDisk[i].virtualSL;
            isOCO              = g_tradeDisk[i].isOCO;
            isExpVisualOn      = g_tradeDisk[i].isExpVisualOn;
            isTrailLimitActive = g_tradeDisk[i].isTrailLimitActive;
            trailLimitDist     = g_tradeDisk[i].trailLimitDist;
            cancelPrice        = g_tradeDisk[i].cancelPrice;
            customColor        = g_tradeDisk[i].customColor;
            customComment      = CharArrayToString(g_tradeDisk[i].customComment); // <--- INYECCIÓN: Leer del disco a la RAM


            isVirtual          = g_tradeDisk[i].isVirtual;
            virtType           = (ENUM_ORDER_TYPE)g_tradeDisk[i].virtType;
            virtEntry          = g_tradeDisk[i].virtEntry;
            virtSL             = g_tradeDisk[i].virtSL;
            virtTP             = g_tradeDisk[i].virtTP;
            virtLot            = g_tradeDisk[i].virtLot;
            virtPriceMode      = g_tradeDisk[i].virtPriceMode;
            virtStopLimit      = g_tradeDisk[i].virtStopLimit;
            virtExpiration     = g_tradeDisk[i].virtExpiration;
            virtComment        = CharArrayToString(g_tradeDisk[i].virtComment);

            be.isActive        = g_tradeDisk[i].be_isActive;
            be.isAuto          = g_tradeDisk[i].be_isAuto;
            be.modeStart       = g_tradeDisk[i].be_modeStart;
            be.modeOffset      = g_tradeDisk[i].be_modeOffset;
            be.valStart        = g_tradeDisk[i].be_valStart;
            be.valOffset       = g_tradeDisk[i].be_valOffset;

            ts.isActive        = g_tradeDisk[i].ts_isActive;
            ts.mode            = g_tradeDisk[i].ts_mode;
            ts.anchorPrice     = g_tradeDisk[i].ts_anchorPrice;
            ArrayCopy(ts.inputs,  g_tradeDisk[i].ts_inputs);
            ArrayCopy(ts.units,   g_tradeDisk[i].ts_units);
            ArrayCopy(ts.dropIdx, g_tradeDisk[i].ts_dropIdx);

            grid.distMode      = g_tradeDisk[i].grid_distMode;
            grid.lotMode       = g_tradeDisk[i].grid_lotMode;

            for(int r = 0; r < 5; r++)
              {
               grid.rows[r].isActiveTP  = g_tradeDisk[i].grid_rows[r].isActiveTP;
               grid.rows[r].isActiveSL  = g_tradeDisk[i].grid_rows[r].isActiveSL;
               grid.rows[r].valTP_Price = g_tradeDisk[i].grid_rows[r].valTP_Price;
               grid.rows[r].valTP_Vol   = g_tradeDisk[i].grid_rows[r].valTP_Vol;
               grid.rows[r].valSL_Price = g_tradeDisk[i].grid_rows[r].valSL_Price;
               grid.rows[r].valSL_Vol   = g_tradeDisk[i].grid_rows[r].valSL_Vol;
              }
            break;
           }
        }
     }
                    ~CTradeState()
     {
      // --- SOLUCIÓN ARQUITECTÓNICA: Darnos de baja del Árbitro ANTES de morir ---
      DWM.UnregisterWindow(GetPointer(menuCanvas));
      DWM.UnregisterWindow(GetPointer(subMenuCanvas));

      // Destruimos sus lienzos físicos y liberamos la RAM
      menuCanvas.DestroyCanvas();
      subMenuCanvas.DestroyCanvas();

      // --- MAGIA DETERMINISTA: Autodestrucción de objetos visuales nativos ---
      // Al ser destruido en la RAM, el objeto aniquila sus propios gráficos en MT5
      DeleteAllTradeVisuals(ticket);
     }

  };

//+------------------------------------------------------------------+
//| GESTOR DE MEMORIA RAM (SINGLETON) - ESCUDO ANTI FUGAS            |
//+------------------------------------------------------------------+
class CTradeMemoryManager
  {
private:
   CTradeState       *m_pool[]; // 🛡️ PRIVADO: Nadie puede tocarlo ni redimensionarlo desde fuera

public:
                     CTradeMemoryManager() {}
                    ~CTradeMemoryManager() { PurgeAll(); } // Autodestrucción garantizada

   // --- 1. LECTOR SEGURO PARA BUCLES ---
   int               Total() { return ArraySize(m_pool); }
   CTradeState*      GetByIndex(int index) { return m_pool[index]; }

   // --- 2. OBTENER O CREAR (El antiguo GetTradeMemory) ---
   CTradeState*      Get(ulong ticket, string force_sym = "")
     {
      int total = ArraySize(m_pool);
      for(int i=0; i<total; i++)
        {
         if(CheckPointer(m_pool[i]) != POINTER_INVALID && m_pool[i].ticket == ticket)
            return m_pool[i]; // Retorno ultra-rápido si ya existe
        }

      // --- Lógica original de búsqueda de Símbolo ---
      string sym = "";
      if(force_sym != "")
         sym = force_sym;
      else
         if(ticket >= VIRTUAL_TICKET_BASE)
           {
            bool found = false;
            int diskTotal = ArraySize(g_tradeDisk);
            for(int i=0; i<diskTotal; i++)
              {
               if(g_tradeDisk[i].ticket == ticket)
                 {
                  sym = CharArrayToString(g_tradeDisk[i].symbol);
                  found = true;
                  break;
                 }
              }
            if(!found)
               sym = _Symbol;
           }
         else
           {
            if(PositionSelectByTicket(ticket))
               sym = PositionGetString(POSITION_SYMBOL);
            else
               if(OrderSelect(ticket))
                  sym = OrderGetString(ORDER_SYMBOL);
               else
                  return NULL;
           }

      // 🛡️ CREACIÓN SEGURA (Con Buffer de Capacidad)
      ArrayResize(m_pool, total + 1, 100);
      m_pool[total] = new CTradeState(ticket, sym);
      return m_pool[total];
     }

   // --- 3. RECOLECTOR DE BASURA (El antiguo GarbageCollectMemory) ---
   bool              GarbageCollect()
     {
      bool hasRemoved = false;
      int total = ArraySize(m_pool);

      for(int k = total - 1; k >= 0; k--)
        {
         if(CheckPointer(m_pool[k]) != POINTER_INVALID)
           {
            ulong t = m_pool[k].ticket;
            if(t == 0)
               continue; // El panel base (Ticket 0) es inmortal

            bool isDead = false;
            if(t >= VIRTUAL_TICKET_BASE)
              {
               if(!m_pool[k].isVirtual)
                  isDead = true;
              }
            else
              {
               if(!PositionSelectByTicket(t) && !OrderSelect(t))
                  isDead = true;
              }

            // ANIQUILACIÓN QUIRÚRGICA
            if(isDead)
              {
               DeleteAllTradeVisuals(t);
               DWM.UnregisterWindow(GetPointer(m_pool[k].menuCanvas));
               DWM.UnregisterWindow(GetPointer(m_pool[k].subMenuCanvas));

               delete m_pool[k]; // Destruye el objeto en RAM
               m_pool[k] = NULL;
               ArrayRemove(m_pool, k, 1); // Cierra el hueco en el array
               hasRemoved = true;
              }
           }
        }
      if(hasRemoved)
         SaveTradesToBin();
      return hasRemoved;
     }

   // --- 4. PURGA TOTAL (Para OnDeinit o Nuclear Option) ---
   void              PurgeAll()
     {
      int total = ArraySize(m_pool);
      for(int i = 0; i < total; i++)
        {
         if(CheckPointer(m_pool[i]) != POINTER_INVALID)
           {
            delete m_pool[i];
            m_pool[i] = NULL;
           }
        }
      ArrayResize(m_pool, 0);
     }
  };

// 🌟 LA ÚNICA INSTANCIA GLOBAL PERMITIDA EN TODO EL EA
CTradeMemoryManager TradeRAM;


// ====================================================================
// 🏦 EL BANCO CENTRAL DE INDICADORES (THE POOL) - HFT OPTIMIZED
// ====================================================================
enum ENUM_IND_TYPE
  {
   POOL_IND_NONE = 0,
   POOL_IND_MA,
   POOL_IND_PSAR,
   POOL_IND_ATR,
   POOL_IND_FRACTALS
  };

struct SIndicatorNode
  {
   ushort            sym_id;
   ENUM_TIMEFRAMES   tf;
   ENUM_IND_TYPE     type;

   int               p_int1; // MA_Period, ATR_Period, Frac_ScanBars
   int               p_int2; // MA_Shift
   int               p_int3; // MA_Method
   int               p_int4; // MA_AppliedPrice
   double            p_dbl1; // PSAR_Step
   double            p_dbl2; // PSAR_Max

   int               handle;
   uint              last_used_time;
   uint              last_calc_time;

   double            cache_0; // Main Buffer (o UP para Fractals)
   double            cache_1; // DOWN (Solo Fractals)
  };

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
class CIndicatorPool
  {
private:
   SIndicatorNode    m_pool[];

   // 🔍 BUSCADOR O(N) ULTRARRÁPIDO (Cero Strings, Pura Matemática)
   int               GetNodeIndex(ushort s_id, ENUM_TIMEFRAMES tf, ENUM_IND_TYPE type, int i1, int i2, int i3, int i4, double d1, double d2)
     {
      int size = ArraySize(m_pool);
      int free_idx = -1;

      for(int i=0; i<size; i++)
        {
         if(m_pool[i].handle == INVALID_HANDLE)
           {
            if(free_idx == -1)
               free_idx = i;
            continue;
           }

         if(m_pool[i].type == type && m_pool[i].sym_id == s_id && m_pool[i].tf == tf &&
            m_pool[i].p_int1 == i1 && m_pool[i].p_int2 == i2 && m_pool[i].p_int3 == i3 && m_pool[i].p_int4 == i4 &&
            m_pool[i].p_dbl1 == d1 && m_pool[i].p_dbl2 == d2)
           {
            return i; // ¡Encontrado!
           }
        }

      // Si no existe, usamos un espacio libre o agrandamos el array
      if(free_idx == -1)
        {
         free_idx = size;
         ArrayResize(m_pool, size + 1, 10);
        }

      // Inicializamos el nuevo expediente
      m_pool[free_idx].sym_id = s_id;
      m_pool[free_idx].tf     = tf;
      m_pool[free_idx].type   = type;
      m_pool[free_idx].p_int1 = i1;
      m_pool[free_idx].p_int2 = i2;
      m_pool[free_idx].p_int3 = i3;
      m_pool[free_idx].p_int4 = i4;
      m_pool[free_idx].p_dbl1 = d1;
      m_pool[free_idx].p_dbl2 = d2;
      m_pool[free_idx].handle = INVALID_HANDLE;
      m_pool[free_idx].last_calc_time = 0;
      m_pool[free_idx].cache_0 = 0;
      m_pool[free_idx].cache_1 = 0;



      return free_idx;
     }

public:
   // 1. Nace con 10 espacios pre-alojados
   void              Init()
     {
      ArrayResize(m_pool, 10, 10);
      for(int i=0; i<10; i++)
         m_pool[i].handle = INVALID_HANDLE;
     }

   // 2. Aniquilación total para el OnDeinit
   void              PurgeAll()
     {
      int size = ArraySize(m_pool);
      for(int i=0; i<size; i++)
        {
         if(m_pool[i].handle != INVALID_HANDLE)
           {
            // --- 🕵️‍♂️ INYECCIÓN DE TELEMETRÍA: APAGADO DEL EA ---
            //Print(">>> [THE POOL 🧹] PURGA DE CIERRE. Destruyendo indicador en índice: ", i);
            // -------------------------------------------------
            IndicatorRelease(m_pool[i].handle);
            m_pool[i].handle = INVALID_HANDLE;
           }
        }
     }

   // 3. El Recolector de Basura (Mata Zombis tras 1 Hora de abandono)
   void              GarbageCollect()
     {
      uint now = GetTickCount();
      int size = ArraySize(m_pool);
      for(int i=0; i<size; i++)
        {
         if(m_pool[i].handle != INVALID_HANDLE)
           {
            if(now - m_pool[i].last_used_time > 3600000) // 3,600,000 ms = 1 Hora
              {
               // --- 🕵️‍♂️ INYECCIÓN DE TELEMETRÍA: LIMPIEZA ---
               //Print(">>> [THE POOL 💀] ZOMBI ANIQUILADO por inactividad (>1h). Liberando RAM del índice: ", i);
               // -------------------------------------------------
               IndicatorRelease(m_pool[i].handle);
               m_pool[i].handle = INVALID_HANDLE;
               //Print(">>> [THE POOL] Zombi Aniquilado. RAM Liberada.");
              }
           }
        }
     }

   // ==========================================
   // WRAPPERS DE INDICADORES (Cero Lag)
   // ==========================================
   double            GetMA(string sym, ENUM_TIMEFRAMES tf, int period, int shift, ENUM_MA_METHOD method, ENUM_APPLIED_PRICE price)
     {
      ushort s_id = GetSymbolID(sym);
      int idx = GetNodeIndex(s_id, tf, POOL_IND_MA, period, shift, method, price, 0.0, 0.0);
      uint now = GetTickCount();

      if(m_pool[idx].handle == INVALID_HANDLE)
         m_pool[idx].handle = iMA(sym, tf, period, shift, method, price);

      if(m_pool[idx].handle == INVALID_HANDLE)
         return 0;

      m_pool[idx].last_used_time = now; // Mantenemos vivo el indicador

      if(now - m_pool[idx].last_calc_time < 50 && m_pool[idx].last_calc_time != 0)
         return m_pool[idx].cache_0; // Throttle de 50ms

      double buf[1];
      if(CopyBuffer(m_pool[idx].handle, 0, 0, 1, buf) > 0)
        {
         m_pool[idx].cache_0 = buf[0];
         m_pool[idx].last_calc_time = now;
        }
      return m_pool[idx].cache_0;
     }

   double            GetPSAR(string sym, ENUM_TIMEFRAMES tf, double step, double max)
     {
      ushort s_id = GetSymbolID(sym);
      int idx = GetNodeIndex(s_id, tf, POOL_IND_PSAR, 0, 0, 0, 0, step, max);
      uint now = GetTickCount();

      if(m_pool[idx].handle == INVALID_HANDLE)
         m_pool[idx].handle = iSAR(sym, tf, step, max);

      if(m_pool[idx].handle == INVALID_HANDLE)
         return 0;

      m_pool[idx].last_used_time = now;

      if(now - m_pool[idx].last_calc_time < 50 && m_pool[idx].last_calc_time != 0)
         return m_pool[idx].cache_0;

      double buf[1];
      if(CopyBuffer(m_pool[idx].handle, 0, 0, 1, buf) > 0)
        {
         m_pool[idx].cache_0 = buf[0];
         m_pool[idx].last_calc_time = now;
        }
      return m_pool[idx].cache_0;
     }

   double            GetATR(string sym, ENUM_TIMEFRAMES tf, int period)
     {
      ushort s_id = GetSymbolID(sym);
      int idx = GetNodeIndex(s_id, tf, POOL_IND_ATR, period, 0, 0, 0, 0.0, 0.0);
      uint now = GetTickCount();

      if(m_pool[idx].handle == INVALID_HANDLE)
         m_pool[idx].handle = iATR(sym, tf, period);

      if(m_pool[idx].handle == INVALID_HANDLE)
         return 0;

      m_pool[idx].last_used_time = now;

      if(now - m_pool[idx].last_calc_time < 50 && m_pool[idx].last_calc_time != 0)
         return m_pool[idx].cache_0;

      double buf[1];
      if(CopyBuffer(m_pool[idx].handle, 0, 1, 1, buf) > 0) // Vela 1 para ATR (cerrada)
        {
         m_pool[idx].cache_0 = buf[0];
         m_pool[idx].last_calc_time = now;
        }
      return m_pool[idx].cache_0;
     }

   double            GetFractal(string sym, ENUM_TIMEFRAMES tf, bool findUp, int scanBars)
     {
      ushort s_id = GetSymbolID(sym);
      int idx = GetNodeIndex(s_id, tf, POOL_IND_FRACTALS, scanBars, 0, 0, 0, 0.0, 0.0);
      uint now = GetTickCount();

      if(m_pool[idx].handle == INVALID_HANDLE)
         m_pool[idx].handle = iFractals(sym, tf);

      if(m_pool[idx].handle == INVALID_HANDLE)
         return 0;

      m_pool[idx].last_used_time = now;

      if(now - m_pool[idx].last_calc_time < 50 && m_pool[idx].last_calc_time != 0)
         return findUp ? m_pool[idx].cache_0 : m_pool[idx].cache_1;

      double buf[];
      ArraySetAsSeries(buf, true);

      // Magia Fractal: Llenamos los dos cachés (UP y DOWN) en la misma llamada para ganar tiempo
      if(CopyBuffer(m_pool[idx].handle, 0, 1, scanBars, buf) > 0)
        {
         double bestUP = 0;
         for(int i=0; i<scanBars; i++)
           {
            if(buf[i] > 0 && buf[i] < DBL_MAX)
              {
               if(bestUP == 0 || buf[i] > bestUP)
                  bestUP = buf[i];
              }
           }
         m_pool[idx].cache_0 = bestUP;
        }

      if(CopyBuffer(m_pool[idx].handle, 1, 1, scanBars, buf) > 0)
        {
         double bestDOWN = 0;
         for(int i=0; i<scanBars; i++)
           {
            if(buf[i] > 0 && buf[i] < DBL_MAX)
              {
               if(bestDOWN == 0 || buf[i] < bestDOWN)
                  bestDOWN = buf[i];
              }
           }
         m_pool[idx].cache_1 = bestDOWN;
        }

      m_pool[idx].last_calc_time = now;
      return findUp ? m_pool[idx].cache_0 : m_pool[idx].cache_1;
     }
  };

CIndicatorPool IndPool; // Instancia Maestra
// ====================================================================
// 5. VARIABLES GLOBALES DEL TRADE ASSISTANT (EA 1)
// ====================================================================
long                  m_chartId;
ENUM_TABS             m_currentTab = TAB_Trade;
ENUM_RISK_MODE        m_riskMode   = RISK_PERCENT;
ENUM_LOT_MODE         m_lotMode = LOT_PCT_TOTAL;
ENUM_DIST_MODE        m_distMode = MODE_AUTO;
ENUM_TS_MODE          m_tsMode = TS_NORMAL;
ENUM_INFO_MODE        m_currentInfoMode = INFO_STAT;
ENUM_DRAG_STATE       m_dragState = DRAG_NONE;

//int      m_timeX = 350, m_timeY = 150;
//bool     m_isDraggingTime = false;
//int      m_dragTimeOffsetX = 0, m_dragTimeOffsetY = 0;
bool     m_isSplitActive = false;
bool     m_time_daysActive[7] = {false, false, false, false, false, false, false};

int      m_time_selectedAction  = 0;


bool     m_isTimeOpen = false;
bool     m_isStopLimitMode = false;
bool     m_isMenuAlertOpen = false;
bool     m_linesActive = false;

// ====================================================================
// VARIABLES DE POSICIÓN Y ARRASTRE DE VENTANAS (MODALES)
// ====================================================================


// ====================================================================

bool m_chartTradeLevelsWasOn = true; // Memoria del estado nativo de MT5

bool     m_manualEntry = false;
bool     m_draggingCenter = false;
bool     m_isDragging   = false;
bool     m_isDraggingPanel = false;
bool     m_isSLLocked     = false;
bool     m_isTPLocked     = false;
bool     m_isMarketMode = true;


bool     m_isTSActive = false;


bool     m_isBE_AutoOffset = false;
bool     m_isBEActive = false;
bool     m_isPriceMode = false;
bool     m_isRRActive = false;
bool     m_isOCOActive = false;
bool     m_isHideActive = false;

bool     m_isManagerHidden = false; // <--- NUEVO: Estado visual del Gestor (EA2)
bool     m_isVirtActive = false;

bool     m_isPreOpCollapsed = false; // Estado del Stealth Mode de la figura
int      m_clickStartX_EA1  = 0;     // Memoria X del clic para tolerancia
int      m_clickStartY_EA1  = 0;     // Memoria Y del clic para tolerancia

bool     m_isConfirmOpen = false;
bool     m_confirm_Silence = false;
bool     m_isMinimized = false;
