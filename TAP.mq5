//+------------------------------------------------------------------+
//| GESTIÓN CENTRALIZADA DE VENTANA DE CONFIRMACIÓN (CCANVAS)        |
//+------------------------------------------------------------------+
void              ManageConfirmWindow(bool open, ENUM_ORDER_TYPE type = -1)
  {
   m_isConfirmOpen = open;

// 1. SI CERRAMOS, DESTRUIMOS EL LIENZO (Cero Carga)
   if(!open)
     {
      ConfirmWin.DestroyCanvas();
      DWM.UnregisterWindow(GetPointer(ConfirmWin));
      m_confirm_PendingType = -1;
      ChartRedraw();
      return;
     }

   if(type != -1)
      m_confirm_PendingType = type;

// 2. CÁLCULO DE DATOS (100% RAM DRIVEN)
   double entryPrice, sl, tp;
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);

   if(m_linesActive)
     {
      entryPrice = ObjectGetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE);
      sl         = ObjectGetDouble(m_chartId, m_lineSL, OBJPROP_PRICE);
      tp         = ObjectGetDouble(m_chartId, m_lineTP, OBJPROP_PRICE);
     }
   else
     {
      double point    = Market.point;
      int digits      = Market.digits;
      double mul      = Market.multiplier;

      if(m_isPriceMode)
        {
         entryPrice = (PanelState.GetPrice() > 0) ? PanelState.GetPrice() : ((m_confirm_PendingType == ORDER_TYPE_BUY) ? ask : bid);
         sl = PanelState.GetSL();
         tp = PanelState.GetTP();
        }
      else
        {
         entryPrice = (m_confirm_PendingType == ORDER_TYPE_BUY) ? ask : bid;
         double slPips = PanelState.GetSL();
         double tpPips = PanelState.GetTP();

         sl = (slPips > 0) ? ((m_confirm_PendingType == ORDER_TYPE_BUY) ? entryPrice - (slPips * mul) : entryPrice + (slPips * mul)) : 0;
         tp = (tpPips > 0) ? ((m_confirm_PendingType == ORDER_TYPE_BUY) ? entryPrice + (tpPips * mul) : entryPrice - (tpPips * mul)) : 0;
        }
     }

   double lot = PanelState.GetLot(); // <--- LECTURA DIRECTA DE RAM
   double accountBalance = AccountInfoDouble(ACCOUNT_BALANCE);

   double marginRequired = 0.0;
   if(!OrderCalcMargin((m_confirm_PendingType == ORDER_TYPE_BUY ? ORDER_TYPE_BUY : ORDER_TYPE_SELL), _Symbol, lot, entryPrice, marginRequired))
      marginRequired = 0.0;

   double riskMoney = 0.0;
   double riskPct   = 0.0;
   if(sl > 0)
     {

      double tickVal  = Market.tickValue;
      double tickSize = Market.tickSize;
      if(tickSize > 0)
        {
         double distSL = MathAbs(entryPrice - sl);
         riskMoney = (distSL / tickSize) * tickVal * lot;
        }
     }
   if(accountBalance > 0)
      riskPct = (riskMoney / accountBalance) * 100.0;

// 3. CONSTRUIR EL LIENZO NUEVO CON DATOS
   BuildConfirmUI(m_confirm_PendingType, lot, accountBalance, riskMoney, riskPct, marginRequired, entryPrice, sl, tp);
   ChartRedraw();
  }

//+------------------------------------------------------------------+
//| CREAR LÍNEA DE ALERTA (100% OPCode y RAM Driven)                 |
//+------------------------------------------------------------------+
void              CreateAlertLine(int modeIndex)
  {
   if(modeIndex < 0 || modeIndex >= 8)
      return;

   g_alarmCounter++;
   ulong currentId = g_alarmCounter;
   string name = MakeTMName(currentId, OP_ALARM_LINE);

   double price = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double point    = Market.point;
   int offsetPts = 50;
   bool isUpper = (StringFind(m_alertCodes[modeIndex], "GT") >= 0);

   price += isUpper ? (offsetPts * point) : -(offsetPts * point);

   bool isTrend = (modeIndex >= 4);
   bool created = false;
   datetime t1 = TimeCurrent();
   datetime t2 = t1 + (PeriodSeconds() * 20);

   if(isTrend)
     {
      created = ObjectCreate(m_chartId, name, OBJ_TREND, 0, t1, price, t2, price);
      if(created)
         ObjectSetInteger(m_chartId, name, OBJPROP_RAY_RIGHT, true);
     }
   else
     {
      created = ObjectCreate(m_chartId, name, OBJ_HLINE, 0, 0, price);
     }

   if(created)
     {
      ObjectSetInteger(m_chartId, name, OBJPROP_COLOR, clrRed);
      ObjectSetInteger(m_chartId, name, OBJPROP_STYLE, STYLE_DASHDOT);
      ObjectSetInteger(m_chartId, name, OBJPROP_WIDTH, 1);
      ObjectSetInteger(m_chartId, name, OBJPROP_SELECTABLE, true);
      ObjectSetInteger(m_chartId, name, OBJPROP_SELECTED, true);

      string tf = EnumToString(_Period);
      StringReplace(tf, "PERIOD_", "");
      string shortDesc = m_alertNames[modeIndex];
      StringReplace(shortDesc, "H-Line", "Line");
      StringReplace(shortDesc, "Trend", "Line");
      string textOnLine = "Alert " + shortDesc + " [" + tf + "]";

      ObjectSetString(m_chartId, name, OBJPROP_TEXT, textOnLine);
      ObjectSetString(m_chartId, name, OBJPROP_TOOLTIP, textOnLine);

      // --- GUARDAR EN LA RAM MATEMÁTICA ---
      int size = ArraySize(m_activeAlerts);
      ArrayResize(m_activeAlerts, size + 1, 10);
      m_activeAlerts[size].id         = currentId;
      m_activeAlerts[size].modeIndex  = modeIndex;
      m_activeAlerts[size].isActive   = true;
      m_activeAlerts[size].isTrend    = isTrend;
      m_activeAlerts[size].symbol     = _Symbol;
      m_activeAlerts[size].last_time_msc = 0;
      m_activeAlerts[size].last_trigger_time = 0; // <--- NUEVO
      m_activeAlerts[size].fixedPrice = price;
      m_activeAlerts[size].t1         = t1;
      m_activeAlerts[size].p1         = price;
      m_activeAlerts[size].t2         = t2;
      m_activeAlerts[size].p2         = price;

      SaveAlertsToBin();
      ChartRedraw();
     }
  }

//+------------------------------------------------------------------+
//| VERIFICAR ALERTAS (MOTOR HFT - MULTI-SÍMBOLO CERO LAG)           |
//+------------------------------------------------------------------+
void              CheckAlertsFast()
  {
   int totalAlerts = ArraySize(m_activeAlerts);
   if(totalAlerts == 0)
      return;

   double nowTime = (double)TimeCurrent(); // Usamos double para la ecuación Y = mX + b

   for(int i = 0; i < totalAlerts; i++)
     {
      // 1. Obtener el tick real del símbolo de la alarma (funciona en cualquier gráfico)
      MqlTick tick;
      if(!SymbolInfoTick(m_activeAlerts[i].symbol, tick))
         continue;

      // 2. El anti-spam: Si el precio no ha cambiado un milisegundo, ni nos molestamos en calcular
      if(tick.time_msc == m_activeAlerts[i].last_time_msc)
         continue;
      m_activeAlerts[i].last_time_msc = tick.time_msc; // Actualizamos la memoria

      double bid = tick.bid;
      double ask = tick.ask;
      double linePrice = m_activeAlerts[i].fixedPrice;

      // 3. SI ES DIAGONAL: Álgebra lineal
      if(m_activeAlerts[i].isTrend)
        {
         double t1 = (double)m_activeAlerts[i].t1;
         double p1 = m_activeAlerts[i].p1;
         double t2 = (double)m_activeAlerts[i].t2;
         double p2 = m_activeAlerts[i].p2;

         if(t2 == t1)
            continue; // Protección div/0
         double m = (p2 - p1) / (t2 - t1);
         double b = p1 - (m * t1);
         linePrice = (m * nowTime) + b;
        }

      // 4. Lógica de Disparo
      bool triggered = false;
      int mode = m_activeAlerts[i].modeIndex;

      if((mode == 0 || mode == 4) && bid >= linePrice)
         triggered = true;
      else
         if((mode == 1 || mode == 5) && bid <= linePrice)
            triggered = true;
         else
            if((mode == 2 || mode == 6) && ask >= linePrice)
               triggered = true;
            else
               if((mode == 3 || mode == 7) && ask <= linePrice)
                  triggered = true;

      // 5. ¡BEEP CONTINUO Y CAMBIO DE COLOR!
      if(triggered)
        {
         uint now_ms = GetTickCount();

         // --- A) BEEP CONTINUO CON COOLDOWN DE 2 SEGUNDOS ---
         // Si es la primera vez (0) o pasaron 2000ms desde el último beep
         if(m_activeAlerts[i].last_trigger_time == 0 || now_ms - m_activeAlerts[i].last_trigger_time >= 2000)
           {
            m_activeAlerts[i].last_trigger_time = now_ms; // Actualizamos el reloj en RAM

            // Log Institucional y Sonido
            string tf = EnumToString(_Period);
            StringReplace(tf, "PERIOD_", "");
            string shortDesc = m_alertNames[m_activeAlerts[i].modeIndex];

            PrintFormat("[Smart Alert] %s: %s condition met at price %.5f (TF: %s)", m_activeAlerts[i].symbol, shortDesc, bid, tf);
            PlaySound("alert.wav");
           }

         // --- B) CAMBIO DE COLOR VISUAL (Solo la primera vez) ---
         if(m_activeAlerts[i].isActive)
           {
            m_activeAlerts[i].isActive = false; // La marcamos como cruzada (Pasa a Azul)
            SaveAlertsToBin();                  // Guardamos el estado en el disco

            // Si estamos mirando el gráfico de esa moneda, la pintamos de inmediato
            if(m_activeAlerts[i].symbol == _Symbol)
              {
               string name = MakeTMName(m_activeAlerts[i].id, OP_ALARM_LINE);
               ObjectSetInteger(m_chartId, name, OBJPROP_COLOR, clrBlue);
               ChartRedraw();
              }
           }
        }
     }
  }

//+------------------------------------------------------------------+
//| DETERMINAR EL TIPO DE ORDEN SEGÚN POSICIÓN DE LÍNEAS             |
//+------------------------------------------------------------------+
string            GetOrderTypeLabel(double entry, double sl)
  {
// 1. Si estamos en Modo Market (Imán), siempre es Market
   if(m_isMarketMode)
     {
      return (sl < entry) ? "BUY" : "SELL";
     }

// 2. Datos de Mercado
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);

// Determinar dirección (Long o Short) basado en el SL
   bool isLong = (sl < entry);

   string typeStr = "";

// --- LÓGICA DE COMPRA (LONG) ---
   if(isLong)
     {
      // Si el botón "L" está activo . BUY STOP LIMIT
      if(m_isStopLimitMode)
         return "BUY STOP LIMIT";

      // Si la entrada está ARRIBA del precio Ask . BUY STOP
      if(entry > ask)
         return "BUY STOP";

      // Si la entrada está ABAJO del precio Ask . BUY LIMIT
      else
         return "BUY LIMIT";
     }

// --- LÓGICA DE VENTA (SHORT) ---
   else
     {
      // Si el botón "L" está activo . SELL STOP LIMIT
      if(m_isStopLimitMode)
         return "SELL STOP LIMIT";

      // Si la entrada está ABAJO del precio Bid . SELL STOP
      if(entry < bid)
         return "SELL STOP";

      // Si la entrada está ARRIBA del precio Bid . SELL LIMIT
      else
         return "SELL LIMIT";
     }
  }

//+------------------------------------------------------------------+
//| ENCENDER/APAGAR LÍNEA STOP LIMIT (LÓGICA VISUAL CORREGIDA)       |
//+------------------------------------------------------------------+
void              ToggleStopLimitLine(bool enable)
  {
   if(!enable)
     {
      ObjectDelete(m_chartId, m_lineStopLimit);
      ObjectDelete(m_chartId, m_btnSec_Name); // Usamos la variable Bitwise unificada
      ObjectDelete(m_chartId, m_btnSec_Name + "_VisLine");
      m_isStopLimitMode = false;
      UpdateInputsFromLines();
      return;
     }

   double entryPrice = ObjectGetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE);
   if(entryPrice == 0)
      entryPrice = SymbolInfoDouble(_Symbol, SYMBOL_BID);

   double point    = Market.point;
   double mul   = (SymbolInfoInteger(_Symbol, SYMBOL_DIGITS)%2!=0) ? 10 * point : point;

// Deducimos la dirección mirando dónde está el SL actual
   double slPrice = ObjectGetDouble(m_chartId, m_lineSL, OBJPROP_PRICE);
   bool isBuy = (slPrice < entryPrice);

   double triggerPrice = 0.0;

// Siempre estará a la vista y lista para ser arrastrada.
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double currentSpread = ask - bid;
   double safeGap = MathMax(10 * mul, currentSpread * 2); // Mínimo 10 pips o el doble del spread

   if(isBuy)
      triggerPrice = ask + safeGap; // Nace un poquito por encima del precio actual
   else
      triggerPrice = bid - safeGap; // Nace un poquito por debajo del precio actual

// Creamos la línea invisible que detectará el arrastre
   UpdateInvisibleLine(m_lineStopLimit, triggerPrice, ARGBToColor(Theme.accent), 8); // <--- TEMA APLICADO
   UpdateInputsFromLines();
  }

//+------------------------------------------------------------------+
//| CREAR VISUALES DE ORDEN VIRTUAL (Persistentes)                   |
//+------------------------------------------------------------------+
void              CreateVirtualVisuals(double entry, double sl, double tp, ENUM_ORDER_TYPE type, double lot)
  {
// 1. Definir Colores y Textos
   color entryColor = (type == ORDER_TYPE_BUY) ? clrBlue : clrRed; // O clrGold si prefieres
   string typeTxt   = (type == ORDER_TYPE_BUY) ? "Virt BUY" : "Virt SELL";

// 2. Crear Línea de ENTRADA
   if(ObjectCreate(m_chartId, m_virtLineEntry, OBJ_HLINE, 0, 0, entry))
     {
      ObjectSetInteger(m_chartId, m_virtLineEntry, OBJPROP_COLOR, clrGold); // Dorado para diferenciar de real
      ObjectSetInteger(m_chartId, m_virtLineEntry, OBJPROP_STYLE, STYLE_SOLID);
      ObjectSetInteger(m_chartId, m_virtLineEntry, OBJPROP_WIDTH, 2);
      ObjectSetString(m_chartId,  m_virtLineEntry, OBJPROP_TEXT, typeTxt + " " + DoubleToString(lot, 2) + " (Pending)");
      ObjectSetInteger(m_chartId, m_virtLineEntry, OBJPROP_SELECTABLE, true); // Permite seleccionarla
     }

// 3. Crear Línea de STOP LOSS
   if(sl > 0)
     {
      ObjectCreate(m_chartId, m_virtLineSL, OBJ_HLINE, 0, 0, sl);
      ObjectSetInteger(m_chartId, m_virtLineSL, OBJPROP_COLOR, clrRed);
      ObjectSetInteger(m_chartId, m_virtLineSL, OBJPROP_STYLE, STYLE_DASH);
      ObjectSetString(m_chartId,  m_virtLineSL, OBJPROP_TEXT, "Virt SL");
     }

// 4. Crear Línea de TAKE PROFIT
   if(tp > 0)
     {
      ObjectCreate(m_chartId, m_virtLineTP, OBJ_HLINE, 0, 0, tp);
      ObjectSetInteger(m_chartId, m_virtLineTP, OBJPROP_COLOR, clrGreen);
      ObjectSetInteger(m_chartId, m_virtLineTP, OBJPROP_STYLE, STYLE_DASH);
      ObjectSetString(m_chartId,  m_virtLineTP, OBJPROP_TEXT, "Virt TP");
     }

   ChartRedraw();
  }

//+------------------------------------------------------------------+
//| BORRAR VISUALES VIRTUALES                                        |
//+------------------------------------------------------------------+
void              DeleteVirtualVisuals()
  {
   ObjectDelete(m_chartId, m_virtLineEntry);
   ObjectDelete(m_chartId, m_virtLineSL);
   ObjectDelete(m_chartId, m_virtLineTP);
   ChartRedraw();
  }


//+------------------------------------------------------------------+
//| Timer function: El Corazón del Motor HFT                         |
//+------------------------------------------------------------------+
void              OnTimer()
  {
   DispatchAsyncQueue();

// =========================================================
// 1. MODO DIOS: HFT MULTI-SÍMBOLO (Cada 20ms)
// =========================================================
   if(m_manageAllSymbols)
     {
      ProcessHFT_Engine();
      if(g_hft_nuke_signal >= 0)
        {
         TranslateAndExecuteNuke();
        }
     }

   static int frameCount = 0;
   static int secCount   = 0;
   bool localNeedsRedraw = false; // Bandera local para eventos de este mismo milisegundo

// =========================================================
// REAPER DE ALARMAS (Recolector de Basura O(1) Swap & Pop)
// =========================================================
   bool alertsChanged = false;
   int totalAlerts = ArraySize(m_activeAlerts);
   for(int k = totalAlerts - 1; k >= 0; k--)
     {
      // Ya no usamos ObjectFind. Si el usuario borró la línea,
      // el OnChartEvent ya puso el id en 0 (Patrón Lápida).
      if(m_activeAlerts[k].id == 0)
        {
         // Magia O(1): Swap and Pop
         if(k != totalAlerts - 1)
           {
            m_activeAlerts[k] = m_activeAlerts[totalAlerts - 1]; // Movemos el último a este hueco
           }

         totalAlerts--;
         ArrayResize(m_activeAlerts, totalAlerts); // Aniquilamos el último espacio
         alertsChanged = true;
        }
     }

   if(alertsChanged)
      SaveAlertsToBin();

   frameCount++;
// =========================================================
// 2. CICLO DE 1 SEGUNDO (Baja Frecuencia)
// =========================================================
   if(frameCount >= 50)
     {
      frameCount = 0;
      secCount++;

// ---> ¡INYECCIÓN: ESCUDO DE REDUNDANCIA! <---
      if(g_protect.accountLockedUntil > TimeCore.Now())
        {
         EnforceAccountLock();
        }

      // DISK I/O MANAGER: VACIADO AGRUPADO (1 VEZ POR SEGUNDO)
      if(g_needsTradeSave)
        {
         WriteTradesToDisk();
         g_needsTradeSave = false;
        }
      if(g_needsPanelSave)
        {
         WritePanelToDisk();
         g_needsPanelSave = false;
        }
      if(g_needsTaskSave)
        {
         WriteTasksToDisk();
         g_needsTaskSave  = false;
        }
      if(g_needsProtectSave)
        {
         WriteProtectToDisk();
         g_needsProtectSave = false;
        }
      if(g_needsAlertSave)
        {
         WriteAlertsToDisk();
         g_needsAlertSave = false;
        }

      if(TradeRAM.GarbageCollect())
         g_needsRedraw = true;
      // A. Actualizar HUD y Estadísticas en vivo (Dinero flotante, luces TS/BE)
      if(UpdateLiveStats())
         g_needsRedraw = true; // Si el profit cambió visualmente, pedimos repintar

      // B. Actualización Visual del Portfolio si estamos en esa pestaña
      if(g_activeTab == 3)
        {
         BuildCanvasUI();
         g_needsRedraw = true;
        }

      // SANITY CHECK: Sincronización lenta con el Bróker
      int memTotal = TradeRAM.Total();
      for(int i = 0; i < memTotal; i++)
        {
         SyncTradeWithBroker(TradeRAM.GetByIndex(i));
        }

      //if(m_manageAllSymbols)
      //   PrintTelemetry();

      // Tareas Programadas y Escudo
      CheckScheduledTasks();
      CheckEquityProtection();
      UpdateProtectUI();

      // Reloj del TimeTrader (CERO LAG & SINTÉTICO)
      if(m_isTimeOpen)
        {
         // RELOJ SINTÉTICO: Conectado al nuevo motor central (TimeCore)
         datetime syntheticTime = TimeCore.Now();
         string sDate = TimeToString(syntheticTime, TIME_DATE);
         StringReplace(sDate, ".", "-");
         string sTime = TimeToString(syntheticTime, TIME_MINUTES|TIME_SECONDS);

         if(TimeWin.GetButtonText(OP_TIME_SYNC_TIME) != sTime)
           {
            // Usamos la actualización quirúrgica. No borra la UI ni afecta el Hover del Mouse.
            TimeWin.FastUpdateText(OP_TIME_SYNC_DATE, sDate);
            TimeWin.FastUpdateText(OP_TIME_SYNC_TIME, sTime);

            // ELIMINAMOS TimeWin.Render() y localNeedsRedraw = true.
            // FastUpdate ya hizo el m_canvas.Update() internamente en 1 microsegundo.
           }
        }

      // =========================================================
      // 3. CICLO DE 1 MINUTO (Operaciones Pesadas)
      // =========================================================
      if(secCount >= 60)
        {
         secCount = 0;
         IndPool.GarbageCollect(); // <--- AÑADE ESTO AQUÍ
         if(TerminalInfoInteger(TERMINAL_CONNECTED))
            FetchCalendarNews();

         DrawNewsLines();
         localNeedsRedraw = true;
        }
     }
// ========================================================
// 4. EL VEREDICTO FINAL: EL PINTOR (Smart FPS Limiter)
// ========================================================
   if(g_needsRedraw || localNeedsRedraw)
     {
      UpdateOpenTradesVisuals(); // El cerebro calcula dónde va cada caja a 50 FPS

      // --- ESCUDO GRÁFICO PARA HARDWARE (30 FPS MAX) ---
      static uint last_redraw_time = 0;
      uint now_ms = GetTickCount();

      // Solo mandamos la orden a la tarjeta gráfica si han pasado más de 33 milisegundos
      if(now_ms - last_redraw_time > 33)
        {
         ChartRedraw();             // MT5 plasma todo en la pantalla
         last_redraw_time = now_ms;
        }

      g_needsRedraw = false; // Limpiamos la bandera para el próximo tick
     }
  }
//+------------------------------------------------------------------+
//| ELIMINAR TAREA DEL ARRAY Y DEL DISCO DURO (MÉTODO O(1))          |
//+------------------------------------------------------------------+
void              RemoveTaskFromArray(int index)
  {
   int size = ArraySize(m_taskList);
   if(index < 0 || index >= size)
      return;

// --- MAGIA O(1): SWAP AND POP ---
   if(index != size - 1)
     {
      // Copiamos la última tarea exacta en el hueco que queremos borrar
      m_taskList[index] = m_taskList[size - 1];
     }

// Destruimos el último espacio de la memoria (implosión instantánea)
   ArrayResize(m_taskList, size - 1);

// Volcamos la matriz limpia al disco duro virtual
   SaveTasksToBin();
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              CheckScheduledTasks()
  {
   int total = ArraySize(m_taskList);
   if(total == 0)
      return;

// ==================================================================
// ESCUDO EQUITY PROTECT
// ==================================================================
   if(g_protect.accountLockedUntil > 0)
     {
      if(TimeCurrent() < g_protect.accountLockedUntil)
        {
         Alert("TRADE BLOCKED: Account is protected/locked until tomorrow.");

         return;
        }
      else
        {
         g_protect.accountLockedUntil = 0; // Desbloqueo automático al pasar el día
         SaveProtectToBin();
        }
     }

   datetime serverTime = TimeCore.Now();
   bool listChanged = false;

// Iteramos al revés
   for(int i=total-1; i>=0; i--)
     {
      // 1. CHEQUEO DE HORA
      if(serverTime >= m_taskList[i].execTime)
        {
         // 2. CHEQUEO DE DÍA (Solo si es bucle)
         bool canExecute = true;

         if(m_taskList[i].isLoop)
           {
            MqlDateTime dt;
            TimeToStruct(serverTime, dt);

            // Convertimos la numeración de MT5 a la tuya (0=Lunes... 6=Domingo)
            int todayIdx = (dt.day_of_week == 0) ? 6 : dt.day_of_week - 1;

            // Si el día de hoy NO está marcado en la tarea...
            if(!m_taskList[i].days[todayIdx])
              {
               canExecute = false; // Hoy no toca disparar

               // ¡MAGIA! Reprogramamos silenciosamente para el próximo día válido
               datetime nextTime = GetNextExecutionTime(m_taskList[i].execTime, m_taskList[i].days);
               m_taskList[i].execTime = nextTime;
               SaveTasksToBin(); // Actualizamos el disco duro
               listChanged = true;
              }
           }

         // 3. EJECUTAR
         if(canExecute)
           {
            bool success = ExecuteTask(m_taskList[i]);

            if(success)
              {

               // --- LOG & SOUND: TIME TRADER ---
               PrintFormat("[Time Trader] Task executed successfully: %s", m_taskList[i].description);
               PlaySound("expert.wav");
               // --------------------------------

               // --- LÓGICA DE DECISIÓN: ¿BORRAR O REPROGRAMAR? ---
               if(m_taskList[i].isLoop)
                 {
                  // ES BUCLE: No borramos. Calculamos la próxima fecha.
                  datetime nextTime = GetNextExecutionTime(m_taskList[i].execTime, m_taskList[i].days);

                  m_taskList[i].execTime = nextTime;

                  //(">>> Loop Task Reprogrammed for: ", TimeToString(nextTime));

                  // No ponemos listChanged=true para no redibujar toda la lista parpadeando,
                  // a menos que quieras actualizar la hora visualmente.
                  // Si quieres ver la nueva hora en la lista:
                  listChanged = true;
                 }
               else
                 {
                  // NO ES BUCLE: Borrar de la lista (Comportamiento normal)
                  RemoveTaskFromArray(i);
                  listChanged = true;
                 }
              }
           }
        }
     }

   if(listChanged)
     {
      // Si hubo cambios (se borró o reprogramó una tarea) y la ventana está abierta,
      // actualizamos el lienzo (CCanvas). Si está cerrada, no gastamos recursos.
      if(m_isTimeOpen)
        {
         BuildTimeUI();
        }
     }
  }

//+------------------------------------------------------------------+
//| EJECUTAR TAREA (MARKET + PENDING ORDERS + CLOSE)                 |
//+------------------------------------------------------------------+
bool              ExecuteTask(ScheduledTask &task)
  {
// =================================================================
// GRUPOS 0 A 7: EJECUCIÓN (INYECCIÓN DE DEPENDENCIAS)
// =================================================================
   if(task.actionId >= 0 && task.actionId <= 7)
     {
      // Delegamos el 100% de la magia al Motor Core Universal
      return ExecuteOrderCore(ORDER_TYPE_BUY, true, task);
     }

// =================================================================
// GRUPO 3: CIERRE DE POSICIONES (8 al 13)
// =================================================================
   if(task.actionId >= 8 && task.actionId <= 13)
     {
      // CASO ESPECIAL: CLOSE BY TICKET (13)
      // CASO ESPECIAL: CLOSE BY TICKET (13)
      if(task.actionId == 13)
        {
         ulong ticketToClose = (ulong)task.ticket;
         if(PositionSelectByTicket(ticketToClose))
           {
            if(PositionGetInteger(POSITION_MAGIC) == MAGIC_NUM)
               return QueueClosePosition(ticketToClose); // <--- 100% ASÍNCRONO
           }
         return true;
        }

      // CASO GENERAL: CLOSE ALL / BUY / SELL / PROFIT / LOSS
      int closedCount = 0;
      for(int i = PositionsTotal() - 1; i >= 0; i--)
        {
         ulong ticket = PositionGetTicket(i);
         if(ticket <= 0 || PositionGetString(POSITION_SYMBOL) != task.symbol || PositionGetInteger(POSITION_MAGIC) != MAGIC_NUM)
            continue;

         long type     = PositionGetInteger(POSITION_TYPE);
         double profit = PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP) + GetPositionCommission(ticket);
         bool shouldClose = false;

         switch(task.actionId)
           {
            case 8:
               if(type == POSITION_TYPE_BUY)
                  shouldClose = true;
               break;
            case 9:
               if(type == POSITION_TYPE_SELL)
                  shouldClose = true;
               break;
            case 10:
               if(profit > 0)
                  shouldClose = true;
               break;
            case 11:
               if(profit < 0)
                  shouldClose = true;
               break;
            case 12:
               shouldClose = true;
               break;
           }

         if(shouldClose)
            if(QueueClosePosition(ticket))
               closedCount++;
        }
      return true;
     }
// =================================================================
// GRUPO 5: ACCIONES CRÍTICAS DEL SISTEMA (23 y 24)
// =================================================================
   if(task.actionId == 23 || task.actionId == 24)
     {
      ////Print(">>> [TIME TRADER] Ejecutando acción de sistema programada: ", task.actionId);


      // --- ESCENARIO B (ANTI-AMNESIA) ---
      // Como ExpertRemove() genera REASON_REMOVE y el OnDeinit ignoraría el guardado,
      // forzamos el volcado síncrono al disco duro de TODA la RAM en este instante.
      WritePanelToDisk();
      WriteTradesToDisk();
      WriteTasksToDisk();
      WriteProtectToDisk();
      WriteAlertsToDisk();

      if(task.actionId == 23)
        {
         ////Print(">>> [TIME TRADER] Desvinculando el EA (ExpertRemove)...");
         ExpertRemove();
        }
      else
         if(task.actionId == 24)
           {
            ////Print(">>> [TIME TRADER] Cerrando el Terminal de MetaTrader...");
            TerminalClose(0); // 0 indica cierre normal sin código de error
           }

      return true;
     }

// =================================================================
// GRUPO 4: ELIMINAR ÓRDENES PENDIENTES (14 al 22)
// =================================================================
   if(task.actionId >= 14 && task.actionId <= 22)
     {
      int deletedCount = 0;
      for(int i = OrdersTotal() - 1; i >= 0; i--)
        {
         ulong ticket = OrderGetTicket(i);
         if(ticket <= 0 || OrderGetString(ORDER_SYMBOL) != task.symbol || OrderGetInteger(ORDER_MAGIC) != MAGIC_NUM)
            continue;

         long type = OrderGetInteger(ORDER_TYPE);
         bool shouldDelete = false;

         switch(task.actionId)
           {
            case 14:
               if(type == ORDER_TYPE_BUY_STOP)
                  shouldDelete = true;
               break;
            case 15:
               if(type == ORDER_TYPE_SELL_STOP)
                  shouldDelete = true;
               break;
            case 16:
               if(type == ORDER_TYPE_BUY_LIMIT)
                  shouldDelete = true;
               break;
            case 17:
               if(type == ORDER_TYPE_SELL_LIMIT)
                  shouldDelete = true;
               break;
            case 18:
               if(type == ORDER_TYPE_BUY_STOP_LIMIT)
                  shouldDelete = true;
               break;
            case 19:
               if(type == ORDER_TYPE_SELL_STOP_LIMIT)
                  shouldDelete = true;
               break;
            case 20:
               if(type == ORDER_TYPE_BUY_STOP || type == ORDER_TYPE_SELL_STOP)
                  shouldDelete = true;
               break;
            case 21:
               if(type == ORDER_TYPE_BUY_LIMIT || type == ORDER_TYPE_SELL_LIMIT)
                  shouldDelete = true;
               break;
            case 22:
               shouldDelete = true;
               break;
           }

         if(shouldDelete)
            if(QueueDeleteOrder(ticket))
               deletedCount++;
        }

      return true;
     }

   return true;
  }

//+------------------------------------------------------------------+
//| CALCULAR PRÓXIMA EJECUCIÓN (MODO BUCLE)                          |
//+------------------------------------------------------------------+
datetime          GetNextExecutionTime(datetime lastRunTime, bool &activeDays[])
  {
   MqlDateTime dt;
   TimeToStruct(lastRunTime, dt); // Desglosamos la fecha de la última ejecución

// Empezamos a buscar desde "mañana" (sumando 1 día a la vez)
   datetime nextRun = lastRunTime;

   for(int i=1; i<=7; i++) // Probamos hasta 7 días en el futuro
     {
      // Sumar 1 día (86400 segundos)
      nextRun += 86400;

      // Ver qué día de la semana cae (0=Dom, 1=Lun, ..., 6=Sab)
      TimeToStruct(nextRun, dt);

      int arrayIndex = -1;
      if(dt.day_of_week == 0)
         arrayIndex = 6; // Domingo es el último en tu array
      else
         arrayIndex = dt.day_of_week - 1;   // Lunes(1).0, Martes(2).1...

      // Si este día está marcado como activo, ¡LO ENCONTRAMOS!
      if(activeDays[arrayIndex])
        {
         return nextRun;
        }
     }

// Si no encuentra nada (raro si isLoop es true), devuelve el mismo tiempo + 24h
   return lastRunTime + 86400;
  }


//+------------------------------------------------------------------+
//| ACTUALIZAR FIGURA PRE-OP (EA1) A 120 FPS                         |
//+------------------------------------------------------------------+
void              FastUpdateFigureVisuals()
  {
   double entryPrice = ObjectGetDouble(0, m_lineEntry, OBJPROP_PRICE);
   double slPrice    = ObjectGetDouble(0, m_lineSL, OBJPROP_PRICE);
   double tpPrice    = ObjectGetDouble(0, m_lineTP, OBJPROP_PRICE);

   if(entryPrice == 0)
      return;

// --- MAGIA MATEMÁTICA: Cero latencia de API ---
   int yEntry = PriceToY(entryPrice);
   int ySL    = PriceToY(slPrice);
   int yTP    = PriceToY(tpPrice);

   int xStart = m_currentFixedX;
   
   // 1. MOVER RECTÁNGULOS DE COLOR (SIEMPRE VISIBLES)
   int yMinProfit = MathMin(yEntry, yTP);
   int hProfit    = MathAbs(yEntry - yTP);
   SmartSetInteger(m_rectProfit, OBJPROP_XDISTANCE, xStart);
   SmartSetInteger(m_rectProfit, OBJPROP_YDISTANCE, yMinProfit);
   SmartSetInteger(m_rectProfit, OBJPROP_YSIZE, hProfit);
   SmartSetInteger(m_rectProfit, OBJPROP_XSIZE, FIGURE_WIDTH);

   int yMinLoss = MathMin(yEntry, ySL);
   int hLoss    = MathAbs(yEntry - ySL);
   SmartSetInteger(m_rectLoss, OBJPROP_XDISTANCE, xStart);
   SmartSetInteger(m_rectLoss, OBJPROP_YDISTANCE, yMinLoss);
   SmartSetInteger(m_rectLoss, OBJPROP_YSIZE, hLoss);
   SmartSetInteger(m_rectLoss, OBJPROP_XSIZE, FIGURE_WIDTH);

// 🛡️ CORTOCIRCUITO ANTI-LAG: Si está colapsado, no pintamos nada más
   if(m_isPreOpCollapsed)
      return;
   
   int h = 18;
   bool isBuyDir = (slPrice < entryPrice);

// =============================================================
// --. FASE 3: CÁLCULOS EN VIVO (100% RAM DRIVEN) <---
// =============================================================
   double point    = Market.point;
   int digits      = Market.digits;
   double mul      = Market.multiplier;
   double tickVal  = Market.tickValue;
   double tickSize = Market.tickSize;
   string cur = AccountInfoString(ACCOUNT_CURRENCY);

   double lot = PanelState.GetLot();

// Cálculos matemáticos Pips / Dinero
   double slDist = MathAbs(entryPrice - slPrice) / mul;
   double tpDist = MathAbs(entryPrice - tpPrice) / mul;

   double moneySL = 0.0, moneyTP = 0.0;
   if(tickSize > 0 && lot > 0)
     {
      moneySL = (MathAbs(entryPrice - slPrice) / tickSize) * tickVal * lot;
      moneyTP = (MathAbs(entryPrice - tpPrice) / tickSize) * tickVal * lot;
     }

   string orderTypeStr = GetOrderTypeLabel(entryPrice, slPrice);
   string txtSL = StringFormat("SL %.0f | -%.2f %s | %s", slDist, moneySL, cur, DoubleToString(slPrice, digits));
   string txtTP = StringFormat("TP %.0f | +%.2f %s | %s", tpDist, moneyTP, cur, DoubleToString(tpPrice, digits));
   string lotStr = DoubleToString(PanelState.GetLot(), 2);
   string txtEntry = StringFormat("%s | L:%s | %s", orderTypeStr, lotStr, DoubleToString(entryPrice, digits));

// Aplicar los nuevos textos a las etiquetas (Magia en Vivo)
   ObjectSetString(0, m_btnCenter_Name, OBJPROP_TEXT, txtEntry);
   ObjectSetString(0, m_btnSL_Name, OBJPROP_TEXT, txtSL);
   ObjectSetString(0, m_btnTP_Name, OBJPROP_TEXT, txtTP);
// =============================================================

   int yCommon = isBuyDir ? yEntry : (yEntry - h);
   int yTPVis  = isBuyDir ? (yTP - h) : yTP;
   int ySLVis  = isBuyDir ? ySL : (ySL - h);

// 1. MOVER RECTÁNGULOS DE COLOR
   SmartSetInteger(m_rectProfit, OBJPROP_XDISTANCE, xStart);
   SmartSetInteger(m_rectProfit, OBJPROP_YDISTANCE, yMinProfit);
   SmartSetInteger(m_rectProfit, OBJPROP_YSIZE, hProfit);
   SmartSetInteger(m_rectProfit, OBJPROP_XSIZE, FIGURE_WIDTH);

   SmartSetInteger(m_rectLoss, OBJPROP_XDISTANCE, xStart);
   SmartSetInteger(m_rectLoss, OBJPROP_YDISTANCE, yMinLoss);
   SmartSetInteger(m_rectLoss, OBJPROP_YSIZE, hLoss);
   SmartSetInteger(m_rectLoss, OBJPROP_XSIZE, FIGURE_WIDTH);

// 2. MOVER BOTONES CENTRALES
   int btnW = BTN_CHART_W;
   int leftGroupW  = btnW * 3;
   int rightGroupW = btnW * 2;

   SmartSetInteger(m_btnMKT_Chart_Name, OBJPROP_XDISTANCE, xStart);
   SmartSetInteger(m_btnMKT_Chart_Name, OBJPROP_YDISTANCE, yCommon);
   SmartSetInteger(m_btnREV_Chart_Name, OBJPROP_XDISTANCE, xStart + btnW);
   SmartSetInteger(m_btnREV_Chart_Name, OBJPROP_YDISTANCE, yCommon);
   SmartSetInteger(m_btnSLim_Chart_Name, OBJPROP_XDISTANCE, xStart + (btnW * 2));
   SmartSetInteger(m_btnSLim_Chart_Name, OBJPROP_YDISTANCE, yCommon);

   SmartSetInteger(m_btnCenter_Name, OBJPROP_XDISTANCE, xStart + leftGroupW);
   SmartSetInteger(m_btnCenter_Name, OBJPROP_YDISTANCE, yCommon);

   SmartSetInteger(m_btnOpen_Chart_Name, OBJPROP_XDISTANCE, xStart + FIGURE_WIDTH - rightGroupW);
   SmartSetInteger(m_btnOpen_Chart_Name, OBJPROP_YDISTANCE, yCommon);
   SmartSetInteger(m_btnClose_Chart_Name, OBJPROP_XDISTANCE, xStart + FIGURE_WIDTH - btnW);
   SmartSetInteger(m_btnClose_Chart_Name, OBJPROP_YDISTANCE, yCommon);

// 3. MOVER CANDADOS Y TEXTOS DE SL/TP
   SmartSetInteger(m_btnLockSL_Name, OBJPROP_XDISTANCE, xStart);
   SmartSetInteger(m_btnLockSL_Name, OBJPROP_YDISTANCE, ySLVis);
   SmartSetInteger(m_btnSL_Name, OBJPROP_XDISTANCE, xStart + LOCK_WIDTH);
   SmartSetInteger(m_btnSL_Name, OBJPROP_YDISTANCE, ySLVis);

   SmartSetInteger(m_btnLockTP_Name, OBJPROP_XDISTANCE, xStart);
   SmartSetInteger(m_btnLockTP_Name, OBJPROP_YDISTANCE, yTPVis);
   SmartSetInteger(m_btnTP_Name, OBJPROP_XDISTANCE, xStart + LOCK_WIDTH);
   SmartSetInteger(m_btnTP_Name, OBJPROP_YDISTANCE, yTPVis);

// // 4. MOVER GRID Y EXTRAS (Sincronización Total EA1 y EA2)
   ulong t = 0; // El ticket 0 representa al panel EA1
   string bStart = MakeTMName(t, OP_HLINE_BE_START);
   string bOff   = MakeTMName(t, OP_HLINE_BE_OFF);
   string tStart = MakeTMName(t, OP_HLINE_TS_START);
   string tDist  = MakeTMName(t, OP_HLINE_TS_DIST);

// TS y BE se comportan como "Take Profit" visualmente (están arriba si es BUY)
   FastSyncUnifiedLine(bStart, bStart, xStart, FIGURE_WIDTH, isBuyDir);
   FastSyncUnifiedLine(bOff,   bOff,   xStart, FIGURE_WIDTH, isBuyDir);
   FastSyncUnifiedLine(tStart, tStart, xStart, FIGURE_WIDTH, isBuyDir);
   FastSyncUnifiedLine(tDist,  tDist,  xStart, FIGURE_WIDTH, isBuyDir);

   for(int i=1; i<=5; i++)
     {
      string gTP = MakeTMName(t, OP_HLINE_GRID_TP_1 + i - 1);
      string gSL = MakeTMName(t, OP_HLINE_GRID_SL_1 + i - 1);
      // El TP está arriba si es BUY, el SL está abajo si es BUY
      FastSyncUnifiedLine(gTP, gTP, xStart, FIGURE_WIDTH, isBuyDir);
      FastSyncUnifiedLine(gSL, gSL, xStart, FIGURE_WIDTH, !isBuyDir);
     }

   if(m_isStopLimitMode && ObjectFind(0, m_lineStopLimit) >= 0)
     {
      double p = ObjectGetDouble(0, m_lineStopLimit, OBJPROP_PRICE);

      // MAGIA: Convertimos el precio a Píxeles Y a la velocidad de la luz
      int py = PriceToY(p);

      bool isAboveSec = (p > entryPrice);
      int pyVis = isAboveSec ? (py - BTN_HEIGHT) : (py + 1);

      SmartSetInteger(m_btnSec_Name, OBJPROP_XDISTANCE, xStart);
      SmartSetInteger(m_btnSec_Name, OBJPROP_YDISTANCE, pyVis);

      string visLineSec = m_btnSec_Name + "_VisLine";
      SmartSetInteger(visLineSec, OBJPROP_XDISTANCE, xStart);
      SmartSetInteger(visLineSec, OBJPROP_YDISTANCE, py);
      SmartSetInteger(visLineSec, OBJPROP_XSIZE, FIGURE_WIDTH);
     }

   m_btnCenter_X = xStart + leftGroupW;
   m_btnCenter_Y = yCommon;
   m_btnSL_X = xStart + LOCK_WIDTH;
   m_btnSL_Y = ySL - (h/2);
   m_btnTP_X = xStart + LOCK_WIDTH;
   m_btnTP_Y = yTP - (h/2);
  }
//+------------------------------------------------------------------+

//+------------------------------------------------------------------+
//| FILOSOFÍA CERO CARGA: Oculta/Muestra líneas complejas            |
//+------------------------------------------------------------------+
void              HideAdvancedLinesForZeroLoad(ulong ticket)
  {
   int opcodes[] = { OP_HLINE_BE_START, OP_HLINE_BE_OFF, OP_HLINE_TS_START, OP_HLINE_TS_DIST,
                     OP_HLINE_GRID_TP_1, OP_HLINE_GRID_TP_2, OP_HLINE_GRID_TP_3, OP_HLINE_GRID_TP_4, OP_HLINE_GRID_TP_5,
                     OP_HLINE_GRID_SL_1, OP_HLINE_GRID_SL_2, OP_HLINE_GRID_SL_3, OP_HLINE_GRID_SL_4, OP_HLINE_GRID_SL_5
                   };

   for(int i=0; i<14; i++)
     {
      string base = MakeTMName(ticket, opcodes[i]);
      ObjectSetInteger(0, base + "_Line", OBJPROP_TIMEFRAMES, OBJ_NO_PERIODS);
      ObjectSetInteger(0, base + "_Btn", OBJPROP_TIMEFRAMES, OBJ_NO_PERIODS);
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              ShowAdvancedLinesAfterZeroLoad(ulong ticket)
  {
   int opcodes[] = { OP_HLINE_BE_START, OP_HLINE_BE_OFF, OP_HLINE_TS_START, OP_HLINE_TS_DIST,
                     OP_HLINE_GRID_TP_1, OP_HLINE_GRID_TP_2, OP_HLINE_GRID_TP_3, OP_HLINE_GRID_TP_4, OP_HLINE_GRID_TP_5,
                     OP_HLINE_GRID_SL_1, OP_HLINE_GRID_SL_2, OP_HLINE_GRID_SL_3, OP_HLINE_GRID_SL_4, OP_HLINE_GRID_SL_5
                   };

   for(int i=0; i<14; i++)
     {
      string base = MakeTMName(ticket, opcodes[i]);
      ObjectSetInteger(0, base + "_Line", OBJPROP_TIMEFRAMES, OBJ_ALL_PERIODS);
      ObjectSetInteger(0, base + "_Btn", OBJPROP_TIMEFRAMES, OBJ_ALL_PERIODS);
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              TM_HandleMouseMove(int mouseX, int mouseY, int mouseState)
  {
// ----------------------------------------------------------------
// A. MOUSE DOWN (INICIO DE CLIC)
// ----------------------------------------------------------------
   if(mouseState == 1 && g_lastMouseState == 0)
     {
      // 1. ¿Tocó una flecha de expiración? (Prioridad absoluta)
      ulong expTicket = GetExpArrowTicketAt(mouseX, mouseY);
      if(expTicket > 0)
        {
         if(m_linesActive)
            return; // ESCUDO: Ignorar si estamos en Pre-op

         ////Print(">>>[EXPIRACIÓN] Flecha tocada. Ticket: ", expTicket);
         g_dragType = 8;
         g_isDragging = true;
         g_dragTicket = expTicket;
         ChartSetInteger(0, CHART_MOUSE_SCROLL, false);
         g_lastMouseState = mouseState;
         return;
        }

      string objName = GetObjectAt(mouseX, mouseY);

      // 💣 MINA DE //Print 1:
      ////Print(">>> [RADAR CLIC] X:", mouseX, " Y:", mouseY, " | ObjName: '", objName, "'");

      if(objName == "")
        {
         ////Print(">>> [RADAR CLIC] Fondo vacío detectado. Liberando el gráfico...");
         ChartSetInteger(0, CHART_MOUSE_SCROLL, true); // Forzamos la liberación por seguridad
         g_lastMouseState = mouseState;
         return;
        }

      g_clickStartX = mouseX;
      g_clickStartY = mouseY;


      ChartSetInteger(0, CHART_MOUSE_SCROLL, false);


      // --- ESCUDO MODO ENFOQUE PARA ARRASTRE ---
      ulong checkTicket = 0;
      int dummyRow = 0;
      string dummyName = "";

      // Verificamos si el objeto es una línea o un botón válido, y extraemos su ticket
      if(DetectLineDrag(objName, checkTicket, dummyRow, dummyName) > 0 || ParseTMObject(objName, checkTicket) != OP_NONE)
        {
         // Si es un ticket vivo (EA2) y estamos en Modo Enfoque, abortamos y permitimos mover el gráfico
         if(m_linesActive && checkTicket > 0)
           {
            g_isPanningChart = true;
            g_lastMouseState = mouseState;
            return;
           }
        }

      ulong ticket = 0;

      // --- LA SOLUCIÓN DEL ARRASTRE DE LÍNEAS ---
      int dragRow = 0;
      string hlineName = "";
      int advDragType = DetectLineDrag(objName, ticket, dragRow, hlineName);

      if(advDragType > 0)
        {
         g_dragType = advDragType;
         g_isDragging = true;
         g_dragTicket = ticket;
         g_dragGridRow = dragRow;

         double lPrice = ObjectGetDouble(0, hlineName, OBJPROP_PRICE);
         int dummyX = 0, lineY = 0;
         if(ChartTimePriceToXY(0, 0, TimeCurrent(), lPrice, dummyX, lineY))
            g_dragOffsetY = mouseY - lineY;
         else
            g_dragOffsetY = 0;

         g_prevMouseY = mouseY;
         ChartSetInteger(0, CHART_MOUSE_SCROLL, false);
         g_lastMouseState = mouseState;
         return; // Cortamos aquí, ¡ya la agarramos!
        }

      // Si no es una línea, seguimos con la lógica de los OpCodes...
      int opcode = ParseTMObject(objName, ticket);

      // Escudo Z-Order
      if(StringFind(objName, "MenuBG") > 0 || StringFind(objName, "_M_Sub") > 0)
        {
         g_lastMouseState = mouseState;
         return;
        }

      // Detección con OP CODE MATEMÁTICO
      if(opcode != OP_NONE)
        {
         switch(opcode)
           {
            // --. NUEVO: REACCIÓN INMEDIATA AL PRESIONAR EL BOTÓN [C] <---
            case OP_TM_CANCEL_TOGGLE:
              {
               CTradeState *mem1 = TradeRAM.Get(ticket);
               bool isPendingReal = OrderSelect(ticket);
               bool isPendingVirtual = (ticket >= VIRTUAL_TICKET_BASE && mem1 != NULL && mem1.isVirtual);

               if(mem1 != NULL && (isPendingReal || isPendingVirtual))
                 {
                  if(mem1.cancelPrice > 0)
                    {
                     // APAGAR CANCELACIÓN
                     mem1.cancelPrice = 0.0;

                    }
                  else
                    {
                     // ENCENDER CANCELACIÓN
                     long oType = -1;
                     double openPrice = 0;

                     if(isPendingVirtual)
                       {
                        oType = mem1.virtType;
                        // --- FIX: Usar el Gatillo para calcular dónde nace la línea Cancel ---
                        if(oType == ORDER_TYPE_BUY_STOP_LIMIT || oType == ORDER_TYPE_SELL_STOP_LIMIT)
                           openPrice = mem1.virtStopLimit;
                        else
                           openPrice = mem1.virtEntry;
                       }
                     else
                       {
                        oType = OrderGetInteger(ORDER_TYPE);
                        openPrice = OrderGetDouble(ORDER_PRICE_OPEN);
                       }

                     double currentAsk = SymbolInfoDouble(mem1.symbol, SYMBOL_ASK);
                     double currentBid = SymbolInfoDouble(mem1.symbol, SYMBOL_BID);
                     double point = SymbolInfoDouble(mem1.symbol, SYMBOL_POINT);
                     double mul = (SymbolInfoInteger(mem1.symbol, SYMBOL_DIGITS)%2!=0) ? 10 * point : point;
                     double offset = 20 * mul;

                     if(oType == ORDER_TYPE_BUY_LIMIT)
                        mem1.cancelPrice = currentAsk + offset;
                     else
                        if(oType == ORDER_TYPE_SELL_LIMIT)
                           mem1.cancelPrice = currentBid - offset;
                        else
                           if(oType == ORDER_TYPE_BUY_STOP)
                              mem1.cancelPrice = currentBid - offset;
                           else
                              if(oType == ORDER_TYPE_SELL_STOP)
                                 mem1.cancelPrice = currentAsk + offset;
                              else
                                 if(oType == ORDER_TYPE_BUY_STOP_LIMIT)
                                    mem1.cancelPrice = openPrice + offset;
                                 else
                                    if(oType == ORDER_TYPE_SELL_STOP_LIMIT)
                                       mem1.cancelPrice = openPrice - offset;


                    }

                  SaveTradesToBin(); // <--- FOTOGRAFÍA AL DISCO
                  UpdateOpenTradesVisuals();
                  ChartRedraw();
                 }
               g_lastMouseState = mouseState;
               return;
              }

            // --. NUEVO: REACCIÓN INMEDIATA AL PRESIONAR EL BOTÓN MENU [...] Y CERRAR [X] <---
            case OP_TM_MENU:
            case OP_TM_MENU_CLOSE:
              {
               CTradeState *mem1 = TradeRAM.Get(ticket);
               if(mem1 != NULL)
                 {
                  if(opcode == OP_TM_MENU)
                    {
                     mem1.isMenuOpen = !mem1.isMenuOpen;
                     if(!mem1.isMenuOpen)
                       {
                        CloseOtherMenus(ticket, OP_NONE);
                        int dummy = -1;
                        UpdateMenuPos(ticket, dummy, dummy, true);
                       }
                    }
                  else
                    {
                     CloseOtherMenus(ticket, OP_NONE);
                     mem1.isMenuOpen = false;
                     int dummy = -1;
                     UpdateMenuPos(ticket, dummy, dummy, true);
                    }
                  // Usamos objName en lugar de sparam porque estamos en MouseMove
                  ObjectSetInteger(0, objName, OBJPROP_STATE, false);
                  // <--- Feedback de sonido inmediato
                  UpdateOpenTradesVisuals();
                  ChartRedraw();
                 }
               g_lastMouseState = mouseState;
               return; // <-- CRÍTICO: Cortar aquí para no iniciar un arrastre del gráfico
              }
            // =======================================================
            // BOTONES DE LA FIGURA PRE-OPERACIÓN (EA1)
            // =======================================================
            case OP_EA1_BTN_GO:
              {
               if(!m_linesActive)
                  return;
               double entry = ObjectGetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE);
               double sl    = ObjectGetDouble(m_chartId, m_lineSL, OBJPROP_PRICE);
               ENUM_ORDER_TYPE orderType = (sl < entry) ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
               if(!m_isMarketMode)
                  m_manualEntry = true;

               if(m_confirm_Silence)
                  ExecuteOrder(orderType);
               else
                  ManageConfirmWindow(true, orderType);

               ChartRedraw();
               g_lastMouseState = mouseState; // Bloquea el arrastre
               return;
              }
            case OP_EA1_BTN_REV:
              {
               FlipOrderMode();
               g_lastMouseState = mouseState;
               return;
              }
            case OP_EA1_BTN_MKT:
              {
               SetMarketMode(!m_isMarketMode);
               if(m_isMarketMode)
                  ResetLinesToMarket();
               BuildCanvasUI();
               g_lastMouseState = mouseState;
               return;
              }
            case OP_EA1_BTN_CLOSE:
              {
               m_linesActive = false;
               ToggleLines(false);
               g_lastMouseState = mouseState;
               return;
              }
            case OP_EA1_LOCK_SL:
              {
               m_isSLLocked = !m_isSLLocked;
               color c = m_isSLLocked ? clrDarkRed : clrRed;
               ObjectSetInteger(0, MakeTMName(0, OP_EA1_LOCK_SL), OBJPROP_BGCOLOR, c);
               ObjectSetInteger(0, MakeTMName(0, OP_EA1_LOCK_SL), OBJPROP_BORDER_COLOR, c);
               ChartRedraw();
               g_lastMouseState = mouseState;
               return;
              }
            case OP_EA1_LOCK_TP:
              {
               m_isTPLocked = !m_isTPLocked;
               color c = m_isTPLocked ? clrDarkGreen : clrGreen;
               ObjectSetInteger(0, MakeTMName(0, OP_EA1_LOCK_TP), OBJPROP_BGCOLOR, c);
               ObjectSetInteger(0, MakeTMName(0, OP_EA1_LOCK_TP), OBJPROP_BORDER_COLOR, c);
               ChartRedraw();
               g_lastMouseState = mouseState;
               return;
              }
            case OP_EA1_BTN_SLIM:
              {
               m_isStopLimitMode = !m_isStopLimitMode;
               string slim = MakeTMName(0, OP_EA1_BTN_SLIM);
               if(m_isStopLimitMode)
                 {
                  color cAcc = ARGBToColor(Theme.accent);
                  ObjectSetInteger(0, slim, OBJPROP_BGCOLOR, cAcc);
                  ObjectSetInteger(0, slim, OBJPROP_BORDER_COLOR, cAcc);
                  ObjectSetInteger(0, slim, OBJPROP_COLOR, ARGBToColor(Theme.bg)); // Texto oscuro para contraste
                 }
               else
                 {
                  ObjectSetInteger(0, slim, OBJPROP_BGCOLOR, ARGBToColor(Theme.surface));
                  ObjectSetInteger(0, slim, OBJPROP_BORDER_COLOR, ARGBToColor(Theme.border));
                  ObjectSetInteger(0, slim, OBJPROP_COLOR, ARGBToColor(Theme.textMain));
                 }
               ToggleStopLimitLine(m_isStopLimitMode);
               ChartRedraw();
               g_lastMouseState = mouseState;
               return;
              }
            case OP_TM_ENTRY:
              {
               g_dragType = 1;
               g_isDragging = true;
               g_dragTicket = ticket;
               g_hasMoved = false;
               BuildDragCache(ticket, 1);
               CTradeState *mem1 = TradeRAM.Get(g_dragTicket);
               if(mem1 != NULL)
                 {
                  int myX = mem1.panelX;
                  if(myX == -1)
                     myX = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS) - 300;
                  g_dragOffsetX = mouseX - myX;
                 }

               // --- SOLUCIÓN 3: Ocultar líneas extra (Cero Carga Horizontal) ---
               HideAdvancedLinesForZeroLoad(ticket);
               break;
              }

            case OP_TM_MENU_TITLE:
              {
               g_dragType = 5;
               g_isDragging = true;
               g_dragTicket = ticket;
               g_prevMouseX = mouseX;
               g_prevMouseY = mouseY;
               BuildDragCache(ticket, 5);
               break;
              }

            case OP_TM_MOVE:
              {
               g_dragType = 6;
               g_isDragging = true;
               g_dragTicket = ticket;
               g_prevMouseY = mouseY;
               BuildDragCache(ticket, 6);

               // --- ILUMINAR LÍNEAS AL ARRASTRAR VERTICALMENTE ---
               long entryColor = ObjectGetInteger(0, MakeTMName(ticket, OP_TM_ENTRY), OBJPROP_BORDER_COLOR);
               string hlEntry = MakeTMName(ticket, OP_HLINE_ENTRY);
               string hlTP    = MakeTMName(ticket, OP_HLINE_TP);
               string hlSL    = MakeTMName(ticket, OP_HLINE_SL);
               string hlSec   = MakeTMName(ticket, OP_HLINE_SEC);

               // Pintamos las líneas maestras
               ObjectSetInteger(0, hlEntry, OBJPROP_COLOR, entryColor);
               ObjectSetInteger(0, hlTP, OBJPROP_COLOR, COLOR_NEON_CYAN);     // TP = Cyan
               ObjectSetInteger(0, hlSL, OBJPROP_COLOR, COLOR_NEON_MAGENTA);  // SL = Magenta
               ObjectSetInteger(0, hlSec, OBJPROP_COLOR, entryColor);

               // Las hacemos visibles durante el arrastre
               ObjectSetInteger(0, hlEntry, OBJPROP_TIMEFRAMES, OBJ_ALL_PERIODS);
               if(ObjectFind(0, hlTP) >= 0)
                  ObjectSetInteger(0, hlTP, OBJPROP_TIMEFRAMES, OBJ_ALL_PERIODS);
               if(ObjectFind(0, hlSL) >= 0)
                  ObjectSetInteger(0, hlSL, OBJPROP_TIMEFRAMES, OBJ_ALL_PERIODS);
               if(ObjectFind(0, hlSec) >= 0)
                  ObjectSetInteger(0, hlSec, OBJPROP_TIMEFRAMES, OBJ_ALL_PERIODS);

               // Cero Carga: Ocultamos las complejas (Grid, TS, BE)
               HideAdvancedLinesForZeroLoad(ticket);

               break;
              }

            case OP_TM_SEC:
              {
               g_dragType = 7;
               g_isDragging = true;
               g_dragTicket = ticket;
               g_hasMoved = false;
               string lineName = MakeTMName(ticket, OP_HLINE_SEC);

               // --- ENCENDER UNA SOLA VEZ AL HACER CLIC ---
               long dynColorSec = ObjectGetInteger(0, MakeTMName(ticket, OP_TM_ENTRY), OBJPROP_BORDER_COLOR);
               ObjectSetInteger(0, lineName, OBJPROP_COLOR, dynColorSec);
               ObjectSetInteger(0, lineName, OBJPROP_TIMEFRAMES, OBJ_ALL_PERIODS);

               double linePrice = ObjectGetDouble(0, lineName, OBJPROP_PRICE);
               int dummyX = 0, lineY = 0;
               if(ChartTimePriceToXY(0, 0, TimeCurrent(), linePrice, dummyX, lineY))
                  g_dragOffsetY = mouseY - lineY;
               else
                  g_dragOffsetY = 0;
               g_prevMouseY = mouseY;
               break;
              }

            case OP_TM_CANCEL_LBL:
              {
               g_dragType = 9;
               g_isDragging = true;
               g_dragTicket = ticket;
               g_hasMoved = false;
               string lineName = MakeTMName(ticket, OP_HLINE_CANCEL);

               // ENCENDER LA LÍNEA INVISIBLE PARA QUE SE ILUMINE AL ARRASTRAR
               long dynColorCanc = ObjectGetInteger(0, MakeTMName(ticket, OP_TM_ENTRY), OBJPROP_BORDER_COLOR);
               ObjectSetInteger(0, lineName, OBJPROP_COLOR, dynColorCanc);
               ObjectSetInteger(0, lineName, OBJPROP_TIMEFRAMES, OBJ_ALL_PERIODS);

               double linePrice = ObjectGetDouble(0, lineName, OBJPROP_PRICE);
               int dummyX = 0, lineY = 0;
               if(ChartTimePriceToXY(0, 0, TimeCurrent(), linePrice, dummyX, lineY))
                  g_dragOffsetY = mouseY - lineY;
               else
                  g_dragOffsetY = 0;
               g_prevMouseY = mouseY;

               HideAdvancedLinesForZeroLoad(ticket); // Ocultar basura para fluidez
               break;
              }

            case OP_TM_TP:
            case OP_TM_SL:
              {
               g_dragType = (opcode == OP_TM_TP) ? 2 : 3;
               g_isDragging = true;
               g_dragTicket = ticket;
               g_hasMoved = false;

               string lName = (g_dragType == 2) ? MakeTMName(ticket, OP_HLINE_TP) : MakeTMName(ticket, OP_HLINE_SL);

               if(ObjectFind(0, lName) >= 0)
                 {
                  // --- ILUMINAR LÍNEA AL ARRASTRAR INDIVIDUALMENTE ---
                  color lineColor = (g_dragType == 2) ? COLOR_NEON_CYAN : COLOR_NEON_MAGENTA;
                  ObjectSetInteger(0, lName, OBJPROP_COLOR, lineColor);
                  ObjectSetInteger(0, lName, OBJPROP_TIMEFRAMES, OBJ_ALL_PERIODS);

                  double lPrice = ObjectGetDouble(0, lName, OBJPROP_PRICE);
                  int dX = 0, lY = 0;
                  if(ChartTimePriceToXY(0, 0, TimeCurrent(), lPrice, dX, lY))
                    {
                     g_dragOffsetY = mouseY - lY;
                    }
                  else
                    {
                     g_dragOffsetY = 0;
                    }
                 }
               else
                 {
                  g_dragOffsetY = 0;
                 }

               g_prevMouseY = mouseY;

               // Cero Carga: Ocultamos las complejas al arrastrar un TP/SL individual
               HideAdvancedLinesForZeroLoad(ticket);

               break;
              }
           }

         if(g_isDragging)
           {
            ChartSetInteger(0, CHART_MOUSE_SCROLL, false);
            g_lastMouseState = mouseState;
            return;
           }
        }
     }

// ----------------------------------------------------------------
// B. MOUSE MOVE (DURANTE EL ARRASTRE)
// ----------------------------------------------------------------
   if(mouseState == 1)
     {
      //// --- NUEVO: PANNING FLUIDO (CERO TEXTOS, 100% MATEMÁTICA) ---
      //if(g_isPanningChart)
      // {
      //   TM_UpdatePanVisualsFast(); // Tu función matemática de 120fps
      ///   g_lastMouseState = mouseState;
      //   return;
      // }
      if(g_isDragging)
        {

         // --- SOLUCIÓN: LÓGICA DE MOVIMIENTO DE LA VENTANA ---
         if(g_dragType == 5)
           {
            // Usamos la coordenada inicial real (g_clickStartX) en vez del previo constante
            int totalDeltaX = mouseX - g_clickStartX;
            int totalDeltaY = mouseY - g_clickStartY;
            MoveMenuVisualsFast(g_dragTicket, totalDeltaX, totalDeltaY);
            return;
           }

         if(g_dragType == 8)
           {
            int subWindow = 0;
            datetime newTime;
            double dummyPrice;
            if(ChartXYToTimePrice(0, mouseX, mouseY, subWindow, newTime, dummyPrice))
              {
               if(newTime < TimeCurrent())
                  newTime = TimeCurrent();

               CTradeState *memDrag = TradeRAM.Get(g_dragTicket);
               if(memDrag != NULL)
                  memDrag.dragTime = (double)newTime; // GUARDA EN RAM

               string arrowName = "TM_Exp_Arrow_" + IntegerToString(g_dragTicket);
               string textName  = "TM_Exp_Text_" + IntegerToString(g_dragTicket);
               ObjectSetInteger(0, arrowName, OBJPROP_TIME, newTime);
               ObjectSetInteger(0, textName, OBJPROP_TIME, newTime);
               string label = (newTime <= TimeCurrent() + 60) ? "GTC (Off)" : TimeToString(newTime, TIME_DATE|TIME_MINUTES);
               ObjectSetString(0, textName, OBJPROP_TEXT, label);
               ChartRedraw();
              }
            return;
           }
         if(g_dragType == 1)
           {
            // 1. CÁLCULO BÁSICO DE LÍMITES
            int newX = mouseX - g_dragOffsetX;
            int chartW = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);
            int maxW = chartW - TM_FIGURE_WIDTH;
            if(newX < 0)
               newX = 0;
            if(newX > maxW)
               newX = maxW;

            CTradeState *mem = TradeRAM.Get(g_dragTicket);
            if(mem == NULL)
               return;

            int currentMemX = mem.panelX;
            int deltaX = newX - currentMemX;

            if(deltaX != 0)
              {
               g_hasMoved = true;
               mem.panelX = newX; // RAM actualizada al instante

               // 2. CARRIL DE ALTA VELOCIDAD (Caché Nativa)
               // Movemos las cajas en pantalla sumando el deltaX.
               // Cero cálculos pesados. 144 FPS asegurados.
               int totalCache = ArraySize(g_dragCache);
               for(int i = 0; i < totalCache; i++)
                 {
                  int oldX = (int)ObjectGetInteger(0, g_dragCache[i], OBJPROP_XDISTANCE);
                  ObjectSetInteger(0, g_dragCache[i], OBJPROP_XDISTANCE, oldX + deltaX);
                 }
               ChartRedraw();
              }
            return; // Cortamos ejecución. Nada de DibujarPanelUnico aquí.
           }

         if(g_dragType == 6)
           {
            // Calculamos ambos deltas
            int totalDeltaY = mouseY - g_clickStartY; // Distancia absoluta desde el clic inicial
            int deltaY = mouseY - g_prevMouseY;       // Distancia relativa del último milisegundo

            // Le pasamos ambos a la función
            MoveOrderVisualsY(g_dragTicket, totalDeltaY, deltaY);

            g_prevMouseY = mouseY;
            return;
           }
         if(g_dragType == 2 || g_dragType == 3 || g_dragType == 7 || g_dragType == 9)
           {
            if(mouseY != g_prevMouseY)
              {
               g_hasMoved = true;

              }

            MoveTPSLVisuals(g_dragTicket, g_dragType, mouseY);
            g_prevMouseY = mouseY;
            return;
           }
         if(g_dragType >= 10)
           {
            MoveAdvancedLineVisuals(g_dragTicket, g_dragType, g_dragGridRow, mouseY);
            g_prevMouseY = mouseY;
            return;
           }
        }
      g_lastMouseState = mouseState;
      return;
     }

// ----------------------------------------------------------------
// C. MOUSE UP (SOLTAR)
// ----------------------------------------------------------------
   if(mouseState == 0 && g_lastMouseState == 1)
     {
      //// --- NUEVO: FIN DEL PANNING ---
      if(g_isPanningChart)
        {
         g_isPanningChart = false;
         UpdateOpenTradesVisuals(); // Refresco final de seguridad al soltar
         ChartRedraw();
        }

      if(g_isDragging)
        {

         if(g_dragType == 8)
           {
            CTradeState *memDrag = TradeRAM.Get(g_dragTicket);
            if(memDrag == NULL)
               return;

            datetime finalTime = (datetime)memDrag.dragTime; // LEE DE RAM
            datetime nowTime = TimeCurrent();

            // --- MAGIA: EXPIRACIÓN VIRTUAL ---
            if(g_dragTicket >= VIRTUAL_TICKET_BASE)
              {
               // Si lo suelta en el pasado o en este mismo segundo, se APAGA (0). Si no, guarda la fecha.
               memDrag.virtExpiration = (finalTime <= nowTime) ? 0 : finalTime;
              }
            // --- EXPIRACIÓN REAL (100% ASÍNCRONO) ---
            else
               if(OrderSelect(g_dragTicket))
                 {
                  datetime oldExp = (datetime)OrderGetInteger(ORDER_TIME_EXPIRATION);

                  MqlTradeRequest req;
                  ZeroMemory(req);
                  req.action     = TRADE_ACTION_MODIFY;
                  req.order      = g_dragTicket;
                  req.price      = OrderGetDouble(ORDER_PRICE_OPEN);
                  req.sl         = OrderGetDouble(ORDER_SL);
                  req.tp         = OrderGetDouble(ORDER_TP);
                  req.stoplimit  = OrderGetDouble(ORDER_PRICE_STOPLIMIT);

                  if(finalTime <= nowTime)
                    {
                     req.type_time = ORDER_TIME_GTC;
                     req.expiration = 0;
                    }
                  else
                    {
                     req.type_time = ORDER_TIME_SPECIFIED;
                     req.expiration = finalTime;
                    }

                  // --- OPTIMISTIC UI: Usamos virtExpiration como caché del arrastre ---
                  memDrag.virtExpiration = req.expiration;

                  // --- DISPARO ASÍNCRONO ---
                  PushAsyncRequest(req, g_dragTicket, 0, ASYNC_MODIFY_TIME, 0, 0, 0, oldExp, false);
                 }

            memDrag.dragTime = 0; // Reseteamos la memoria temporal del arrastre
            SaveTradesToBin();    // FOTOGRAFÍA AL DISCO

            g_isDragging = false;
            g_dragType = 0;
            g_dragTicket = 0;
            ChartSetInteger(0, CHART_MOUSE_SCROLL, true);
            UpdateOpenTradesVisuals();
            ChartRedraw();
           }
         if(g_dragType == 1)
           {
            if(!g_hasMoved)
              {
               // Si no se movió, es que querían colapsar/expandir el panel
               CTradeState *mem = TradeRAM.Get(g_dragTicket);
               if(mem != NULL)
                  mem.isCollapsed = !mem.isCollapsed;
              }
            // Si SÍ se movió, ya la RAM (mem.panelX) tiene la posición final.

            ulong draggedTk = g_dragTicket;
            g_isDragging = false;
            g_dragType = 0;
            g_dragTicket = 0;
            ChartSetInteger(0, CHART_MOUSE_SCROLL, true);

            // AHORA SÍ: Reconstruimos la matemática pesada (Líneas extra, etc.)
            ShowAdvancedLinesAfterZeroLoad(draggedTk);
            UpdateOpenTradesVisuals();
            ChartRedraw();
           }
         // --- SOLUCIÓN: GUARDAR POSICIÓN DE LA VENTANA AL SOLTAR ---
         if(g_dragType == 5)
           {
            string canvasName = "CanvasOrderMenu_" + IntegerToString(g_dragTicket);
            CTradeState *mem = TradeRAM.Get(g_dragTicket);

            if(ObjectFind(0, canvasName) >= 0)
              {
               int finalX = (int)ObjectGetInteger(0, canvasName, OBJPROP_XDISTANCE);
               int finalY = (int)ObjectGetInteger(0, canvasName, OBJPROP_YDISTANCE);
               UpdateMenuPos(g_dragTicket, finalX, finalY, true);

               if(mem != NULL)
                 {
                  mem.menuCanvas.m_panelX = finalX;
                  mem.menuCanvas.m_panelY = finalY;
                 }
              }

            // --- FILOSOFÍA CERO CARGA: RESTAURACIÓN AL SOLTAR ---
            if(mem != NULL && g_dragRestoreSubMenu != 0)
              {
               mem.activeSubMenu = g_dragRestoreSubMenu; // Le devolvemos la memoria
               g_dragRestoreSubMenu = 0;                 // Limpiamos
              }

            g_isDragging = false;
            g_dragType = 0;
            g_dragTicket = 0;
            ChartSetInteger(0, CHART_MOUSE_SCROLL, true);

            // ESTO reconstruirá la subventana y los inputs instantáneamente en la nueva X/Y
            UpdateOpenTradesVisuals();
            ChartRedraw();
           }

         else
            if(g_dragType == 6)  // <----- ¡ESTE ES EL IF SALVADOR!
              {
               ulong draggedTicketBackup = g_dragTicket; // Guardar ticket

               // --- Usamos el nombre matemático actualizado ---
               string btnName = MakeTMName(g_dragTicket, OP_TM_MOVE);

               // Fallback por si agarró la entrada directamente
               if(ObjectFind(0, btnName) < 0)
                  btnName = MakeTMName(g_dragTicket, OP_TM_ENTRY);

               int finalY = (int)ObjectGetInteger(0, btnName, OBJPROP_YDISTANCE);
               int finalX = (int)ObjectGetInteger(0, btnName, OBJPROP_XDISTANCE);

               // --- CALCULAR LA LÍNEA REAL SEGÚN EL TIPO (BUY/SELL Y VIRTUAL) ---
               long type = -1;
               if(g_dragTicket >= VIRTUAL_TICKET_BASE)
                 {
                  CTradeState *vMem = TradeRAM.Get(g_dragTicket);
                  if(vMem != NULL)
                     type = vMem.virtType;
                 }
               else
                  if(OrderSelect(g_dragTicket))
                    {
                     type = OrderGetInteger(ORDER_TYPE);
                    }

               bool isBuyDir = (type == POSITION_TYPE_BUY || type == ORDER_TYPE_BUY_LIMIT || type == ORDER_TYPE_BUY_STOP || type == ORDER_TYPE_BUY_STOP_LIMIT);
               int realLineY = isBuyDir ? finalY : (finalY + BTN_HEIGHT);
               // ----------------------------------------------------------------------

               datetime t;
               double newPrice;
               int subWindow = 0;
               if(ChartXYToTimePrice(0, finalX, realLineY, subWindow, t, newPrice))
                 {
                  newPrice = NormalizeDouble(newPrice, _Digits);

                  // --- MAGIA: ARRASTRAR ORDEN VIRTUAL ---
                  if(draggedTicketBackup >= VIRTUAL_TICKET_BASE)
                    {
                     CTradeState *vMem = TradeRAM.Get(draggedTicketBackup);
                     if(vMem != NULL)
                       {
                        double delta = newPrice - vMem.virtEntry;
                        double tempEntry = newPrice;
                        double tempSL = (vMem.virtSL > 0) ? NormalizeDouble(vMem.virtSL + delta, _Digits) : 0;
                        double tempTP = (vMem.virtTP > 0) ? NormalizeDouble(vMem.virtTP + delta, _Digits) : 0;

                        // Evaluamos todo el bloque junto (Por si cruzó el gatillo morado)
                        if(IsVirtualGeometryValid(vMem.virtType, tempEntry, tempSL, tempTP, vMem.virtStopLimit))
                          {
                           vMem.virtEntry = tempEntry;
                           if(vMem.virtSL > 0)
                              vMem.virtSL = tempSL;
                           if(vMem.virtTP > 0)
                              vMem.virtTP = tempTP;

                           if(vMem.isHiddenActive)
                             {
                              if(vMem.virtualSL > 0)
                                 vMem.virtualSL = tempSL;
                              if(vMem.virtualTP > 0)
                                 vMem.virtualTP = tempTP;
                             }
                           SaveVirtualOrder(draggedTicketBackup);

                          }
                        else
                          {

                           ////Print(">>> [VIRTUAL BROKER] Movimiento de Bloque Central rechazado.");
                          }
                       }
                    }
                  // --- ARRASTRAR ORDEN REAL ---
                  else
                     if(OrderSelect(draggedTicketBackup))
                       {
                        long oType = OrderGetInteger(ORDER_TYPE);
                        double oldPrice = (oType == ORDER_TYPE_BUY_STOP_LIMIT || oType == ORDER_TYPE_SELL_STOP_LIMIT) ?
                                          OrderGetDouble(ORDER_PRICE_STOPLIMIT) : OrderGetDouble(ORDER_PRICE_OPEN);

                        double delta = newPrice - oldPrice;

                        if(MathAbs(delta) >= Point())
                          {
                           double oldTrigger = OrderGetDouble(ORDER_PRICE_OPEN);
                           double finalTrigger = oldTrigger;
                           double finalStopLimit = 0;

                           if(oType == ORDER_TYPE_BUY_STOP_LIMIT || oType == ORDER_TYPE_SELL_STOP_LIMIT)
                             {
                              finalTrigger = oldTrigger; // SE QUEDA FIJO
                              finalStopLimit = newPrice; // SE MUEVE LA EJECUCIÓN (Línea Central)
                             }
                           else
                             {
                              finalTrigger = newPrice;
                             }

                           double finalSL = (OrderGetDouble(ORDER_SL) > 0) ? NormalizeDouble(OrderGetDouble(ORDER_SL) + delta, _Digits) : 0;
                           double finalTP = (OrderGetDouble(ORDER_TP) > 0) ? NormalizeDouble(OrderGetDouble(ORDER_TP) + delta, _Digits) : 0;

                           MqlTradeRequest request;
                           ZeroMemory(request);
                           request.action       = TRADE_ACTION_MODIFY;
                           request.order        = draggedTicketBackup;
                           request.price        = finalTrigger;
                           request.stoplimit    = finalStopLimit;
                           request.sl           = finalSL;
                           request.tp           = finalTP;
                           request.type_time    = (ENUM_ORDER_TYPE_TIME)OrderGetInteger(ORDER_TYPE_TIME);
                           request.expiration   = (datetime)OrderGetInteger(ORDER_TIME_EXPIRATION);

                           // --- OPTIMISTIC UI: MENTIR A LA RAM ---
                           CTradeState *memReal = TradeRAM.Get(draggedTicketBackup);
                           if(memReal != NULL)
                             {
                              memReal.openPrice = newPrice;
                              if(finalSL > 0)
                                 memReal.slPrice = finalSL;
                              if(finalTP > 0)
                                 memReal.tpPrice = finalTP;
                             }

                           // --- DISPARO ASÍNCRONO ---
                           PushAsyncRequest(request, draggedTicketBackup, 0, ASYNC_MODIFY_PRICE, OrderGetDouble(ORDER_SL), OrderGetDouble(ORDER_TP), oldPrice);
                          }
                       }
                 }
               g_isDragging = false;
               g_dragType = 0;
               g_dragTicket = 0;
               ChartSetInteger(0, CHART_MOUSE_SCROLL, true);

               // --- SOLUCIÓN 2: Restaurar líneas complejas y recalcular sus precios ---
               ShowAdvancedLinesAfterZeroLoad(draggedTicketBackup);

               UpdateOpenTradesVisuals();
               ChartRedraw();
              }
         if(g_dragType == 2 || g_dragType == 3)
           {
            ulong draggedTicketBackup = g_dragTicket; // Guardar el ticket
            // --- FIX BITWISE: Buscar el precio en el nombre correcto ---
            string lineName = (g_dragType == 2) ? MakeTMName(g_dragTicket, OP_HLINE_TP) : MakeTMName(g_dragTicket, OP_HLINE_SL);
            double newPrice = 0.0;

            if(ObjectFind(0, lineName) >= 0)
              {
               // Fue arrastre. Leemos donde quedó la línea.
               newPrice = ObjectGetDouble(0, lineName, OBJPROP_PRICE);
              }

            ObjectSetInteger(0, lineName, OBJPROP_COLOR, clrNONE); // Apagamos la línea
            ObjectSetInteger(0, lineName, OBJPROP_TIMEFRAMES, OBJ_NO_PERIODS); // Filosofía Cero Carga

            if(newPrice > 0)
              {
               newPrice = NormalizeDouble(newPrice, _Digits);

               // --- MAGIA: TP/SL VIRTUAL ---
               if(g_dragTicket >= VIRTUAL_TICKET_BASE)
                 {
                  CTradeState *vMem = TradeRAM.Get(g_dragTicket);
                  if(vMem != NULL)
                    {
                     // Simulamos el movimiento
                     double tempTP = (g_dragType == 2) ? newPrice : vMem.virtTP;
                     double tempSL = (g_dragType == 3) ? newPrice : vMem.virtSL;

                     // El Bróker Virtual evalúa
                     if(IsVirtualGeometryValid(vMem.virtType, vMem.virtEntry, tempSL, tempTP, vMem.virtStopLimit))
                       {
                        vMem.virtTP = tempTP;
                        vMem.virtSL = tempSL;
                        if(vMem.isHiddenActive)
                          {
                           if(g_dragType == 2)
                              vMem.virtualTP = newPrice;
                           else
                              vMem.virtualSL = newPrice;
                          }
                        SaveVirtualOrder(g_dragTicket); // Guardar

                       }
                     else
                       {
                        // Si es inválido, no guardamos. Rebotará visualmente.

                        ////Print(">>> [VIRTUAL BROKER] TP/SL Inválido rechazado.");
                       }
                    }
                 }
               // --- TP/SL REALES ---
               else
                 {
                  CTradeState *mem = TradeRAM.Get(g_dragTicket);
                  bool isHidden = (mem != NULL && mem.isHiddenActive);

                  if(isHidden)
                    {
                     if(g_dragType == 2)
                        mem.virtualTP = newPrice;
                     else
                        mem.virtualSL = newPrice;
                    }
                  else
                    {
                     // 1. Definimos qué acción es para el Mapa en RAM
                     ENUM_ASYNC_ACTION actionType = (g_dragType == 2) ? ASYNC_MODIFY_TP : ASYNC_MODIFY_SL;

                     if(PositionSelectByTicket(g_dragTicket))
                       {
                        // 2. Extraer memoria vieja para el Rollback
                        double oldSL = PositionGetDouble(POSITION_SL);
                        double oldTP = PositionGetDouble(POSITION_TP);

                        MqlTradeRequest req;
                        ZeroMemory(req);
                        req.action   = TRADE_ACTION_SLTP;
                        req.position = g_dragTicket;
                        req.sl       = (g_dragType == 3) ? newPrice : oldSL;
                        req.tp       = (g_dragType == 2) ? newPrice : oldTP;

                        // 3. OPTIMISTIC UI: Mentimos a la RAM al instante
                        if(mem != NULL)
                          {
                           if(g_dragType == 2)
                              mem.tpPrice = newPrice;
                           else
                              mem.slPrice = newPrice;
                          }

                        // 4. Disparamos y encolamos
                        PushAsyncRequest(req, g_dragTicket, 0, actionType, oldSL, oldTP, 0);
                       }
                     else
                        if(OrderSelect(g_dragTicket))
                          {
                           // 2. Extraer memoria vieja para el Rollback
                           double oldEntry = OrderGetDouble(ORDER_PRICE_OPEN);
                           double oldSL    = OrderGetDouble(ORDER_SL);
                           double oldTP    = OrderGetDouble(ORDER_TP);
                           double oldLimit = OrderGetDouble(ORDER_PRICE_STOPLIMIT);

                           MqlTradeRequest req;
                           ZeroMemory(req);
                           req.action       = TRADE_ACTION_MODIFY;
                           req.order        = g_dragTicket;
                           req.price        = oldEntry;
                           req.sl           = (g_dragType == 3) ? newPrice : oldSL;
                           req.tp           = (g_dragType == 2) ? newPrice : oldTP;
                           req.stoplimit    = oldLimit;
                           req.type_time    = (ENUM_ORDER_TYPE_TIME)OrderGetInteger(ORDER_TYPE_TIME);
                           req.expiration   = (datetime)OrderGetInteger(ORDER_TIME_EXPIRATION);

                           // 3. OPTIMISTIC UI: Mentimos a la RAM al instante
                           if(mem != NULL)
                             {
                              if(g_dragType == 2)
                                 mem.tpPrice = newPrice;
                              else
                                 mem.slPrice = newPrice;
                             }

                           // 4. Disparamos y encolamos
                           PushAsyncRequest(req, g_dragTicket, 0, actionType, oldSL, oldTP, oldEntry);
                          }
                    }
                 }
              }
            g_isDragging = false;
            g_dragType = 0;
            g_dragTicket = 0;
            ChartSetInteger(0, CHART_MOUSE_SCROLL, true);
            // --- RESTAURAR LÍNEAS AVANZADAS TRAS SOLTAR EL TP/SL ---
            ShowAdvancedLinesAfterZeroLoad(draggedTicketBackup);
            UpdateOpenTradesVisuals();
            ChartRedraw();
           }
         // --- SOLUCIÓN: GUARDADO DE LÍNEAS AVANZADAS AL SOLTAR ---
         if(g_dragType >= 10)
           {
            int opcode = 0;
            if(g_dragType == 10)
               opcode = OP_HLINE_GRID_TP_1 + g_dragGridRow - 1;
            if(g_dragType == 20)
               opcode = OP_HLINE_GRID_SL_1 + g_dragGridRow - 1;
            if(g_dragType == 30)
               opcode = OP_HLINE_BE_START;
            if(g_dragType == 31)
               opcode = OP_HLINE_BE_OFF;
            if(g_dragType == 40)
               opcode = OP_HLINE_TS_START;
            if(g_dragType == 41)
               opcode = OP_HLINE_TS_DIST;
            if(g_dragType == 50)
               opcode = OP_HLINE_EDIT_TP;
            if(g_dragType == 51)
               opcode = OP_HLINE_EDIT_SL;
            if(g_dragType == 52)
               opcode = OP_HLINE_EDIT_PR;

            if(opcode != 0)
              {
               string hLineName = MakeTMName(g_dragTicket, opcode);
               double finalPrice = ObjectGetDouble(0, hLineName, OBJPROP_PRICE);

               if(finalPrice > 0)
                 {
                  if(g_dragType == 10)
                     UpdateInputFromGridDrag(g_dragTicket, g_dragGridRow, 1, finalPrice);
                  if(g_dragType == 20)
                     UpdateInputFromGridDrag(g_dragTicket, g_dragGridRow, 2, finalPrice);
                  if(g_dragType == 30 || g_dragType == 31)
                     UpdateInputFromBEDrag(g_dragTicket, g_dragType, finalPrice);
                  if(g_dragType == 40 || g_dragType == 41)
                     UpdateInputFromTSDrag(g_dragTicket, g_dragType, finalPrice);

                  // --. ¡LA CURA DEL REBOTE! Modo Modify (Edit) 100% RAM <---// --. ¡LA CURA DEL REBOTE! Modo Modify (Edit) 100% RAM <---
                  if(g_dragType >= 50 && g_dragType <= 52)
                    {
                     finalPrice = NormalizeDouble(finalPrice, _Digits);
                     CTradeState *pMem = TradeRAM.Get(g_dragTicket);
                     if(pMem != NULL)
                       {
                        if(g_dragType == 50)
                           pMem.draftTP = finalPrice;
                        if(g_dragType == 51)
                           pMem.draftSL = finalPrice;
                        if(g_dragType == 52)
                           pMem.draftPr = finalPrice;
                       }
                    }
                 }

               // APAGAR LA LÍNEA
               ObjectSetInteger(0, hLineName, OBJPROP_COLOR, clrNONE);
               ObjectSetInteger(0, hLineName, OBJPROP_TIMEFRAMES, OBJ_NO_PERIODS);
              }

            ulong draggedTk = g_dragTicket; // Guardar antes de limpiar
            g_isDragging  = false;
            g_dragType = 0;
            g_dragTicket = 0;
            g_dragGridRow = 0;
            ChartSetInteger(0, CHART_MOUSE_SCROLL, true);

            // ACTUALIZACIÓN INTELIGENTE (0 = Panel EA1, >0 = Gestor EA2)
            if(draggedTk == 0)
               UpdateInputsFromLines();
            else
               UpdateOpenTradesVisuals(); // <--- Esto lee los Drafts y actualiza el CCanvas

            ChartRedraw();
           }
         // --. GUARDAR LA LÍNEA DE CANCELACIÓN <---
         // --. GUARDAR LA LÍNEA DE CANCELACIÓN <---
         if(g_dragType == 9)
           {
            string lineName = MakeTMName(g_dragTicket, OP_HLINE_CANCEL);
            double newPrice = 0.0;
            if(ObjectFind(0, lineName) >= 0)
              {
               newPrice = ObjectGetDouble(0, lineName, OBJPROP_PRICE);
               ObjectSetInteger(0, lineName, OBJPROP_COLOR, clrNONE); // Apagar línea al soltar
              }

            if(newPrice > 0)
              {
               newPrice = NormalizeDouble(newPrice, _Digits);
               CTradeState *mem1 = TradeRAM.Get(g_dragTicket);
               if(mem1 != NULL)
                 {
                  mem1.cancelPrice = newPrice;
                  SaveTradesToBin(); // <-- GUARDADO PURO

                 }
              }
            // ... (el resto del bloque queda igual)

            ulong draggedTicketBackup = g_dragTicket;
            g_isDragging = false;
            g_dragType = 0;
            g_dragTicket = 0;
            ChartSetInteger(0, CHART_MOUSE_SCROLL, true);
            ShowAdvancedLinesAfterZeroLoad(draggedTicketBackup);
            UpdateOpenTradesVisuals();
            ChartRedraw();
           }

         if(g_dragType == 7)
           {
            string lineName = MakeTMName(g_dragTicket, OP_HLINE_SEC);
            double newPrice = 0.0;
            if(ObjectFind(0, lineName) >= 0)
              {
               newPrice = ObjectGetDouble(0, lineName, OBJPROP_PRICE);
               ObjectSetInteger(0, lineName, OBJPROP_COLOR, clrNONE);
              }

            if(newPrice > 0)
              {
               double tickSize = Market.tickSize;
               newPrice = NormalizeDouble(newPrice, _Digits);
               if(tickSize > 0)
                  newPrice = MathRound(newPrice / tickSize) * tickSize;

               // --- MAGIA: STOP LIMIT VIRTUAL ---
               if(g_dragTicket >= VIRTUAL_TICKET_BASE)
                 {
                  CTradeState *vMem = TradeRAM.Get(g_dragTicket);
                  if(vMem != NULL)
                    {
                     // El Bróker Virtual evalúa si el gatillo morado choca con el bloque central
                     if(IsVirtualGeometryValid(vMem.virtType, vMem.virtEntry, vMem.virtSL, vMem.virtTP, newPrice))
                       {
                        vMem.virtStopLimit = newPrice;
                        SaveVirtualOrder(g_dragTicket);

                       }
                     else
                       {

                        ////Print(">>> [VIRTUAL BROKER] Gatillo Inválido rechazado.");
                       }
                    }
                 }
               // --- STOP LIMIT REAL ---
               else
                  if(OrderSelect(g_dragTicket))
                    {
                     double finalEntry = newPrice; // TRIGGER (Línea Morada)
                     double finalStopLimit = OrderGetDouble(ORDER_PRICE_STOPLIMIT); // EXECUTION (Línea Central)
                     double oldTrigger = OrderGetDouble(ORDER_PRICE_OPEN);

                     MqlTradeRequest req;
                     ZeroMemory(req);
                     req.action     = TRADE_ACTION_MODIFY;
                     req.order      = g_dragTicket;
                     req.price      = finalEntry;
                     req.stoplimit  = finalStopLimit;
                     req.sl         = OrderGetDouble(ORDER_SL);
                     req.tp         = OrderGetDouble(ORDER_TP);
                     req.type_time  = (ENUM_ORDER_TYPE_TIME)OrderGetInteger(ORDER_TYPE_TIME);
                     req.expiration = (datetime)OrderGetInteger(ORDER_TIME_EXPIRATION);

                     // --- OPTIMISTIC UI: MENTIR A LA RAM ---
                     CTradeState *memReal = TradeRAM.Get(g_dragTicket);
                     if(memReal != NULL)
                       {
                        memReal.virtStopLimit = newPrice; // Usamos esta variable como caché optimista del gatillo
                       }

                     // --- DISPARO ASÍNCRONO ---
                     PushAsyncRequest(req, g_dragTicket, 0, ASYNC_MODIFY_TRIGGER, 0, 0, oldTrigger);
                    }
              }
            g_isDragging = false;
            g_dragType = 0;
            g_dragTicket = 0;
            ChartSetInteger(0, CHART_MOUSE_SCROLL, true);
            UpdateOpenTradesVisuals();
            ChartRedraw();
           }

         g_isDragging = false;
         g_dragType = 0;
         g_dragTicket = 0;
         g_hasMoved = false;
         ChartSetInteger(0, CHART_MOUSE_SCROLL, true);

         // --- NUEVO: FOTO FINAL AL DISCO TRAS MOVER CUALQUIER COSA DEL EA2 ---
         ChartRedraw();
        }
     }
   g_lastMouseState = mouseState;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              TM_HandleClick(string sparam)
  {
   ulong ticket = 0;
   int opcode = ParseTMObject(sparam, ticket);

   if(opcode == OP_NONE)
      return;

// --- ESCUDO MODO ENFOQUE ---
   if(m_linesActive && ticket > 0)
      return;

   CTradeState *mem = TradeRAM.Get(ticket);
   if(mem == NULL)
      return;

// Enrutador Bitwise Directo
   switch(opcode)
     {
      case OP_TM_M_CLOSE:
      case OP_TM_M_PART:
      case OP_TM_M_REV:
      case OP_TM_M_EDIT:
      case OP_TM_M_BE:
      case OP_TM_M_GRID:
      case OP_TM_M_TS:
      case OP_TM_M_COLOR:
      case OP_TM_M_COMM:
      case OP_TM_M_TRLIM:
        {
         // Lógica Toggle de Menús
         bool isPressed = (bool)ObjectGetInteger(0, sparam, OBJPROP_STATE);
         if(isPressed)
            CloseOtherMenus(ticket, (ushort)opcode); // Cierra hermanos

         UpdateOpenTradesVisuals();
         ChartRedraw();
         break;
        }

      case OP_TM_M_HIDE:
        {
         // La lógica de Hide principal ocurre en ProcessOrderMenuClick
         break;
        }

      case OP_TM_M_OCO:
        {
         mem.isOCO = !mem.isOCO; // Invertimos estado en RAM
         SaveTradesToBin();      // Volcamos al disco en 1 ciclo


         UpdateOpenTradesVisuals();
         ChartRedraw();
         break;
        }

      case OP_TM_M_EXP:
        {
         mem.isExpVisualOn = !mem.isExpVisualOn; // Invertimos estado en RAM
         if(!mem.isExpVisualOn)
            DeleteExpirationVisuals(ticket); // Limpiamos la pantalla si se apaga

         SaveTradesToBin(); // Volcamos al disco en 1 ciclo

         UpdateOpenTradesVisuals();
         ChartRedraw();
         break;
        }
     }
  }

//+------------------------------------------------------------------+
//| EL PINTOR VISUAL (100% DEPENDIENTE DE LA RAM)                    |
//+------------------------------------------------------------------+
void              UpdateOpenTradesVisuals()
  {
   TradeRAM.GarbageCollect(); // Limpiamos la basura primero para no dibujar fantasmas

// --- LA REGLA DE ORO ---
   if(!CanDrawManager())
      return;

// UN SOLO BUCLE MAESTRO: Recorremos nuestra RAM (MemoryPool)
   int memTotal = TradeRAM.Total();
   for(int i = 0; i < memTotal; i++)
     {
      CTradeState *mem = TradeRAM.GetByIndex(i);

      // Escudos de seguridad (Ignoramos punteros nulos y el Panel Base de pre-operación)
      if(CheckPointer(mem) == POINTER_INVALID || mem.ticket == 0)
         continue;

      // EL FILTRO MÁGICO: El pintor es ciego a otras monedas.
      if(mem.symbol == _Symbol)
        {

         // 🛡️ EL ESCUDO MAGIC NUMBER PARA LA UI (BLINDADO)
         if(!mem.isVirtual && !g_manageAllMagics)
           {
            long t_magic = 0;
            bool found = false;

            if(PositionSelectByTicket(mem.ticket))
              {
               t_magic = PositionGetInteger(POSITION_MAGIC);
               found = true;
              }
            else
               if(OrderSelect(mem.ticket))
                 {
                  t_magic = OrderGetInteger(ORDER_MAGIC);
                  found = true;
                 }

            if(found && t_magic != MAGIC_NUM)
              {
               DWM.UnregisterWindow(GetPointer(mem.menuCanvas));
               DWM.UnregisterWindow(GetPointer(mem.subMenuCanvas));
               mem.menuCanvas.DestroyCanvas();
               mem.subMenuCanvas.DestroyCanvas();
               DeleteAllTradeVisuals(mem.ticket);

               mem.isMenuOpen = false;
               mem.activeSubMenu = 0;
               continue; // Salta al siguiente y no dibuja
              }
           }

         // Determinamos si es posición viva...
         bool esPosicion = (!mem.isVirtual && PositionSelectByTicket(mem.ticket));

         DibujarPanelUnico(mem.ticket, esPosicion);
        }
     }

   ChartRedraw();
  }

//+------------------------------------------------------------------+
//| BORRADOR MATEMÁTICO: Aniquila objetos usando OpCodes puros       |
//+------------------------------------------------------------------+
void              DeleteAllTradeVisuals(ulong ticket)
  {
// ==================================================================
// 1. LIMPIEZA DE LA FIGURA PRE-OPERACIÓN (EA1 - TICKET 0)
// ==================================================================
   if(ticket == 0)
     {
      int ea1Opcodes[] =
        {
         OP_EA1_LINE_ENTRY, OP_EA1_LINE_SL, OP_EA1_LINE_TP, OP_EA1_LINE_SLIM,
         OP_EA1_RECT_PROFIT, OP_EA1_RECT_LOSS, OP_EA1_BTN_CENTER, OP_EA1_BTN_TEXT_TP,
         OP_EA1_BTN_TEXT_SL, OP_EA1_BTN_SEC, OP_EA1_BTN_MKT, OP_EA1_BTN_REV,
         OP_EA1_BTN_SLIM, OP_EA1_BTN_CLOSE, OP_EA1_BTN_GO, OP_EA1_LOCK_TP, OP_EA1_LOCK_SL
        };

      for(int i=0; i<ArraySize(ea1Opcodes); i++)
         ObjectDelete(0, MakeTMName(0, ea1Opcodes[i]));

      // Limpiar rastro visual secundario
      ObjectDelete(0, MakeTMName(0, OP_EA1_BTN_SEC) + "_VisLine");
     }
// ==================================================================
// 2. LIMPIEZA DE UNA ORDEN DEL GESTOR (EA2 - TICKET > 0)
// ==================================================================
   else
     {
      // A. Panel Base, Botones Nativos y Rectángulos
      int ea2BasicOpcodes[] =
        {
         OP_TM_ENTRY, OP_TM_MOVE, OP_TM_MENU, OP_TM_SEC, OP_TM_TP, OP_TM_RECT_TP,
         OP_TM_SL, OP_TM_RECT_SL, OP_HLINE_ENTRY, OP_HLINE_TP, OP_HLINE_SL,
         OP_HLINE_SEC, OP_TM_CANCEL_TOGGLE, OP_TM_CANCEL_LBL, OP_HLINE_CANCEL
        };

      for(int i=0; i<ArraySize(ea2BasicOpcodes); i++)
         ObjectDelete(0, MakeTMName(ticket, ea2BasicOpcodes[i]));

      ObjectDelete(0, MakeTMName(ticket, OP_TM_CANCEL_LBL) + "_VisLine");
      ObjectDelete(0, MakeTMName(ticket, OP_TM_SEC) + "_VisLine");

      // B. Limpieza del Menú Principal Nativo (Si existía en versión vieja)
      int menuOpcodes[] =
        {
         OP_TM_MENU_BG, OP_TM_MENU_TITLE, OP_TM_MENU_CLOSE, OP_TM_M_SEP, OP_TM_M_CLOSE,
         OP_TM_M_PART, OP_TM_M_REV, OP_TM_M_EDIT, OP_TM_M_GRID, OP_TM_M_TS, OP_TM_M_BE,
         OP_TM_M_COLOR, OP_TM_M_COMM, OP_TM_M_HIDE, OP_TM_M_OCO, OP_TM_M_EXP, OP_TM_M_TRLIM
        };

      for(int i=0; i<ArraySize(menuOpcodes); i++)
         ObjectDelete(0, MakeTMName(ticket, menuOpcodes[i]));
     }

// ==================================================================
// 3. LIMPIEZA DE LÍNEAS AVANZADAS (Aplica a EA1 y EA2)
// ==================================================================
   int advOpcodes[] =
     {
      OP_HLINE_BE_START, OP_HLINE_BE_OFF, OP_HLINE_TS_START, OP_HLINE_TS_DIST,
      OP_HLINE_GRID_TP_1, OP_HLINE_GRID_TP_2, OP_HLINE_GRID_TP_3, OP_HLINE_GRID_TP_4, OP_HLINE_GRID_TP_5,
      OP_HLINE_GRID_SL_1, OP_HLINE_GRID_SL_2, OP_HLINE_GRID_SL_3, OP_HLINE_GRID_SL_4, OP_HLINE_GRID_SL_5,
      OP_HLINE_EDIT_TP, OP_HLINE_EDIT_SL, OP_HLINE_EDIT_PR, OP_HLINE_VIRT_TP, OP_HLINE_VIRT_SL
     };

   for(int i=0; i<ArraySize(advOpcodes); i++)
     {
      string baseName = MakeTMName(ticket, advOpcodes[i]);
      ObjectDelete(0, baseName);
      ObjectDelete(0, baseName + "_Line");
      ObjectDelete(0, baseName + "_Btn");
     }

// ==================================================================
// 4. LIMPIEZA DE BASURA POR STRINGS (Exclusivo EA2)
// ==================================================================
   if(ticket > 0)
     {
      string sTk = IntegerToString(ticket);

      ObjectDelete(0, "TM_Exp_Line_" + sTk);
      ObjectDelete(0, "TM_Exp_Arrow_" + sTk);
      ObjectDelete(0, "TM_Exp_Text_" + sTk);

      ObjectDelete(0, "CanvasDropEngine_CanvasOrderMenu_" + sTk);
      ObjectDelete(0, "CanvasDropEngine_CanvasSubMenu_" + sTk);

      ObjectsDeleteAll(0, "GhostInput_EA2_CanvasSubMenu_" + sTk);
      ObjectsDeleteAll(0, "GhostInput_EA2_CanvasOrderMenu_" + sTk);
     }
  }

//+------------------------------------------------------------------+
//| DETECTAR QUÉ OBJETO ESTÁ BAJO EL MOUSE (SOLO PARA LÍNEAS DE MT5) |
//+------------------------------------------------------------------+
string            GetObjectAt(int x, int y)
  {
   string bestObject = "";
   long maxZ = -1;

   for(int i = ObjectsTotal(0, -1, -1) - 1; i >= 0; i--)
     {
      string name = ObjectName(0, i, -1, -1);
      
      // 0. ESCUDO ANTI-FANTASMAS: Si el objeto está oculto en MT5, el ratón lo atraviesa como si no existiera
      if(ObjectGetInteger(0, name, OBJPROP_TIMEFRAMES) == OBJ_NO_PERIODS)
         continue;

      // 1. ESCUDO ABSOLUTO: Si dice "Canvas", lo ignoramos completamente.
      // El DWM ya se encarga de ellos.
      if(StringFind(name, "Canvas") >= 0)
         continue;

      // 2. Filtro MT5 Nativo (Ignora basura del chart)
      if(StringFind(name, "TM_") != 0 && StringToInteger(name) == 0)
         continue;

      ulong ticket = 0;
      int opcode = ParseTMObject(name, ticket);

      if(opcode == OP_NONE && StringFind(name, "TM_Line_") < 0 && StringFind(name, "TM_UI_") < 0)
         continue;

      // Filtros de Fondos para que el clic pase a las líneas
      if(opcode == OP_TM_RECT_TP || opcode == OP_TM_RECT_SL || opcode == OP_TM_M_SEP)
         continue;

      // Obtener coordenadas
      int obX = (int)ObjectGetInteger(0, name, OBJPROP_XDISTANCE);
      int obY = (int)ObjectGetInteger(0, name, OBJPROP_YDISTANCE);
      int obW = (int)ObjectGetInteger(0, name, OBJPROP_XSIZE);
      int obH = (int)ObjectGetInteger(0, name, OBJPROP_YSIZE);

      // Chequeo de colisión
      if(x >= obX && x <= (obX + obW) && y >= obY && y <= (obY + obH))
        {
         long currentZ = ObjectGetInteger(0, name, OBJPROP_ZORDER);

         // A las líneas les damos un pequeño empuje para agarrarlas fácil
         if(StringFind(name, "TM_Line_") >= 0)
            currentZ += 5000;

         if(currentZ > maxZ)
           {
            maxZ = currentZ;
            bestObject = name;
           }
        }
     }
   return bestObject;
  }
//+------------------------------------------------------------------+
//| Función auxiliar para obtener datos de una posición U orden      |
//+------------------------------------------------------------------+
bool              GetTradeInfo(ulong ticket, double &entry, double &sl, double &tp)
  {
   double vol;
   long type;
   CTradeState *mem;

// ¡Magia! Redirigimos la vieja función al nuevo motor unificado que lee Virtuales
   return GetUnifiedTradeInfo(ticket, entry, sl, tp, vol, type, mem);
  }

//+------------------------------------------------------------------+
//| Función auxiliar para dibujar texto simple                       |
//+------------------------------------------------------------------+
void              DrawLabel(string name, int x, int y, string text, color clr)
  {
   if(ObjectFind(0, name) < 0)
     {
      ObjectCreate(0, name, OBJ_LABEL, 0, 0, 0);
      ObjectSetInteger(0, name, OBJPROP_CORNER, CORNER_LEFT_UPPER);
      ObjectSetInteger(0, name, OBJPROP_FONTSIZE, 8);
      ObjectSetString(0, name, OBJPROP_FONT, "Arial");
      ObjectSetInteger(0, name, OBJPROP_BACK, false);
      ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
     }

   SmartSetInteger(name, OBJPROP_XDISTANCE, x);
   SmartSetInteger(name, OBJPROP_YDISTANCE, y);
   SmartSetString(name, OBJPROP_TEXT, text);
   SmartSetInteger(name, OBJPROP_COLOR, clr);
  }

//+------------------------------------------------------------------+
//| DIBUJAR ETIQUETA PLANA PROFESIONAL (100% PUSH-ONLY)              |
//+------------------------------------------------------------------+
void DrawButton(string name, int x, int y, string text, color clr, color txtClr = clrNONE)
  {
// MAGIA HFT: ObjectCreate devuelve true solo la primera vez. Falla en 1 ciclo si ya existe.
   if(ObjectCreate(0, name, OBJ_EDIT, 0, 0, 0))
     {
      // --- PROPIEDADES ESTÁTICAS (Solo se aplican al nacer) ---
      ObjectSetInteger(0, name, OBJPROP_CORNER, CORNER_LEFT_UPPER);
      ObjectSetInteger(0, name, OBJPROP_FONTSIZE, 8);
      ObjectSetString(0, name, OBJPROP_FONT, "Arial");
      ObjectSetInteger(0, name, OBJPROP_ZORDER, 10);
      ObjectSetInteger(0, name, OBJPROP_ALIGN, ALIGN_CENTER);
      ObjectSetInteger(0, name, OBJPROP_READONLY, true);
      ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, name, OBJPROP_XSIZE, 50); // Fallback
      ObjectSetInteger(0, name, OBJPROP_YSIZE, 20); // Fallback
     }

// --- PROPIEDADES DINÁMICAS (Se disparan a ciegas gracias al SmartSet) ---
   ObjectSetInteger(0, name, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, name, OBJPROP_YDISTANCE, y);
   ObjectSetString(0, name, OBJPROP_TEXT, text);

   ObjectSetInteger(0, name, OBJPROP_BGCOLOR, clr);
   ObjectSetInteger(0, name, OBJPROP_BORDER_COLOR, clr);

   if(txtClr == clrNONE)
      txtClr = ARGBToColor(Theme.textMain);

   ObjectSetInteger(0, name, OBJPROP_COLOR, txtClr);
  }

//+------------------------------------------------------------------+
//| DIBUJAR RECTÁNGULO DE FONDO (100% PUSH-ONLY)                     |
//+------------------------------------------------------------------+
void DrawRect(string name, int x, int y1, int y2, color clr)
  {
   if(ObjectCreate(0, name, OBJ_RECTANGLE_LABEL, 0, 0, 0))
     {
      ObjectSetInteger(0, name, OBJPROP_CORNER, CORNER_LEFT_UPPER);
      ObjectSetInteger(0, name, OBJPROP_BORDER_TYPE, BORDER_FLAT);
      ObjectSetInteger(0, name, OBJPROP_BACK, true);
     }

   int height = MathAbs(y1 - y2);
   int yPos   = MathMin(y1, y2);

   ObjectSetInteger(0, name, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, name, OBJPROP_YDISTANCE, yPos);
   ObjectSetInteger(0, name, OBJPROP_XSIZE, TM_FIGURE_WIDTH);
   ObjectSetInteger(0, name, OBJPROP_YSIZE, height);
   ObjectSetInteger(0, name, OBJPROP_BGCOLOR, clr);
   ObjectSetInteger(0, name, OBJPROP_COLOR, clr);
  }

//+------------------------------------------------------------------+
//| CREAR/ACTUALIZAR LÍNEA INVISIBLE (100% PUSH-ONLY)                |
//+------------------------------------------------------------------+
void UpdateInvisibleLine(string name, double price, color clr, int dragTypeFilter)
  {
   if(ObjectCreate(0, name, OBJ_HLINE, 0, 0, price))
     {
      ObjectSetInteger(0, name, OBJPROP_STYLE, STYLE_DASH);
      ObjectSetInteger(0, name, OBJPROP_WIDTH, 1);
      ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, name, OBJPROP_SELECTED, false);
      ObjectSetInteger(0, name, OBJPROP_RAY_RIGHT, false);
      ObjectSetInteger(0, name, OBJPROP_BACK, true);
     }

   ulong lineTicket = 0;
   ushort lineOpcode = ParseTMObject(name, lineTicket);

   bool isMyTicket = false;
   if(lineOpcode != OP_NONE)
      if(lineTicket == g_dragTicket || (g_dragTicket == 0 && lineTicket == 0))
         isMyTicket = true;

   bool isBeingDragged = (g_isDragging && isMyTicket && (g_dragType == dragTypeFilter || g_dragType == 6));

   if(m_isDragging && m_dragTarget == 1 && lineTicket == 0)
      isBeingDragged = true;

   if(m_isDragging && m_dragTarget == 8 && name == m_lineStopLimit)
      isBeingDragged = true;

   if(!isBeingDragged)
     {
      ObjectSetDouble(0, name, OBJPROP_PRICE, price);
      ObjectSetInteger(0, name, OBJPROP_COLOR, clrNONE);
      ObjectSetInteger(0, name, OBJPROP_TIMEFRAMES, OBJ_NO_PERIODS);
     }
   else
     {
      ObjectSetInteger(0, name, OBJPROP_COLOR, clr);
      ObjectSetInteger(0, name, OBJPROP_TIMEFRAMES, OBJ_ALL_PERIODS);
     }
  }

//+------------------------------------------------------------------+
//| DIBUJAR PANEL (FONDO ESTÁTICO) (100% PUSH-ONLY)                  |
//+------------------------------------------------------------------+
void DrawPanel(string name, int x, int y, int w, int h, color bgClr, color borderClr)
  {
   if(ObjectCreate(0, name, OBJ_RECTANGLE_LABEL, 0, 0, 0))
     {
      ObjectSetInteger(0, name, OBJPROP_CORNER, CORNER_LEFT_UPPER);
      ObjectSetInteger(0, name, OBJPROP_BACK, false);
      ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
     }

   ObjectSetInteger(0, name, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, name, OBJPROP_YDISTANCE, y);
   ObjectSetInteger(0, name, OBJPROP_XSIZE, w);
   ObjectSetInteger(0, name, OBJPROP_YSIZE, h);
   ObjectSetInteger(0, name, OBJPROP_BGCOLOR, bgClr);
   ObjectSetInteger(0, name, OBJPROP_BORDER_TYPE, BORDER_FLAT);
   ObjectSetInteger(0, name, OBJPROP_BORDER_COLOR, borderClr);
  }

//+------------------------------------------------------------------+
//| LÓGICA Y DIBUJADO DE GRID (TP/SL) - 100% RAM OPTIMIZADO          |
//+------------------------------------------------------------------+
void              UpdateGridLogic(ulong ticket, string prefix, int xPos)
  {
   double entry, sl, tp, vol;
   long type;
   CTradeState *mem;

   if(!GetUnifiedTradeInfo(ticket, entry, sl, tp, vol, type, mem))
      return;


   if(CheckPointer(mem) == POINTER_INVALID)
      return; // <-- ESCUDO

// --- DATOS MONETARIOS ---

   double tickVal  = Market.tickValue;
   double tickSize = Market.tickSize;
   string cur      = AccountInfoString(ACCOUNT_CURRENCY);
   if(mem.isCollapsed && ticket > 0)
     {
      for(int i=1; i<=5; i++)
        {
         // Nombres 100% Bitwise
         string gTP = MakeTMName(ticket, OP_HLINE_GRID_TP_1 + i - 1);
         string gSL = MakeTMName(ticket, OP_HLINE_GRID_SL_1 + i - 1);

         ObjectDelete(0, gTP);
         ObjectDelete(0, gTP + "_Line");
         ObjectDelete(0, gTP + "_Btn");

         ObjectDelete(0, gSL);
         ObjectDelete(0, gSL + "_Line");
         ObjectDelete(0, gSL + "_Btn");
        }
      return;
     }

   bool isMenuOpen = false;
   if(ticket > 0)
      isMenuOpen = (mem.activeSubMenu == OP_TM_M_GRID); // <-- AHORA LEE EL ESTADO DEL CCANVAS

   int distMode = mem.grid.distMode;
   int lotMode  = mem.grid.lotMode;

   double point   = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   double mul     = (SymbolInfoInteger(_Symbol, SYMBOL_DIGITS)%2!=0) ? 10 * point : point;
   double volStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   double minLot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);

   int activeTPCount = 0, activeSLCount = 0;
   int firstInactiveTP = 0, firstInactiveSL = 0;

   for(int k=1; k<=5; k++)
     {
      if(mem.grid.rows[k-1].isActiveTP)
         activeTPCount++;
      else
         if(firstInactiveTP == 0)
            firstInactiveTP = k;

      if(mem.grid.rows[k-1].isActiveSL)
         activeSLCount++;
      else
         if(firstInactiveSL == 0)
            firstInactiveSL = k;
     }

   int rankTP = 0, rankSL = 0;
   bool isBuy = (type == POSITION_TYPE_BUY || type == ORDER_TYPE_BUY_LIMIT || type == ORDER_TYPE_BUY_STOP || type == ORDER_TYPE_BUY_STOP_LIMIT);
   double currentRemTP = vol;
   double currentRemSL = vol;

// --- MAGIA: ANCHO DINÁMICO ---
   int drawWidth = (ticket == 0) ? FIGURE_WIDTH : TM_FIGURE_WIDTH;

   for(int i=1; i<=5; i++)
     {
      string sI = IntegerToString(i);
      int rowIdx = i - 1;

      // ----------------------------------------------------------------
      // A. LADO IZQUIERDO (TAKE PROFIT)
      // ----------------------------------------------------------------
      bool isTPActive = mem.grid.rows[rowIdx].isActiveTP;
      bool isDraggingThisTP = (g_isDragging && g_dragTicket == ticket && g_dragType == 10 && g_dragGridRow == i);
      bool showPreviewTP = (ticket > 0 && !isTPActive && isMenuOpen && i == firstInactiveTP);

      if(isTPActive || showPreviewTP || isDraggingThisTP)
        {
         double valTP = mem.grid.rows[rowIdx].valTP_Price;
         double priceTP = 0.0;
         int currentRankTP = isTPActive ? ++rankTP : (activeTPCount + 1);

         if(isDraggingThisTP)
            priceTP = ObjectGetDouble(0, "TM_HLine_TP_" + IntegerToString(ticket) + "_" + sI, OBJPROP_PRICE);
         else
           {
            if(valTP == 0 && distMode != 3)
               priceTP = entry;
            else
               if(distMode == 0)
                  priceTP = isBuy ? entry + (valTP * mul) : entry - (valTP * mul);
               else
                  if(distMode == 1)
                     priceTP = valTP;
                  else
                     if(distMode == 2)
                       {
                        double risk = MathAbs(entry - sl);
                        if(sl == 0 || risk < point)
                           risk = 50 * mul;
                        double reward = risk * valTP;
                        priceTP = isBuy ? entry + reward : entry - reward;
                       }
                     else
                       {
                        if(tp > 0)
                          {
                           double totalDist = MathAbs(tp - entry);
                           double denomTP = isTPActive ? (activeTPCount + 1.0) : (activeTPCount + 2.0);
                           double stepDist = (totalDist / denomTP) * currentRankTP;
                           priceTP = isBuy ? entry + stepDist : entry - stepDist;
                          }
                        else
                           priceTP = entry;
                       }
           }

         double rawLotVal = mem.grid.rows[rowIdx].valTP_Vol;
         if(rawLotVal <= 0)
            rawLotVal = 20;

         double finalLot = 0.0;
         if(lotMode == 0)
            finalLot = vol * (rawLotVal / 100.0);
         else
            if(lotMode == 1)
               finalLot = currentRemTP * (rawLotVal / 100.0);
            else
               if(lotMode == 2)
                  finalLot = rawLotVal;

         finalLot = MathFloor(finalLot / volStep) * volStep;
         if(finalLot < minLot)
            finalLot = minLot;
         if(finalLot > currentRemTP)
            finalLot = currentRemTP;

         if(isTPActive)
           {
            currentRemTP -= finalLot;
            if(currentRemTP < 0)
               currentRemTP = 0;
           }

         // CÁLCULOS RICOS PARA EL GRID TP
         double distPips = MathAbs(entry - priceTP) / mul;
         double moneyEst = (tickSize > 0) ? (MathAbs(entry - priceTP) / tickSize) * tickVal * finalLot : 0;
         double rr = 0;
         if(sl > 0 && MathAbs(entry - sl) > point)
            rr = MathAbs(entry - priceTP) / MathAbs(entry - sl);

         string chartLabel = isTPActive ? StringFormat("TP%s %.0f | %.2f | RR %.2f | %.2f %s", sI, distPips, finalLot, rr, moneyEst, cur) : ("Prev TP " + sI);

         string objNameTP = "TM_Line_TP_" + IntegerToString(ticket) + "_" + sI;
         string realLineTP = "TM_HLine_TP_" + IntegerToString(ticket) + "_" + sI;

         // LADO IZQUIERDO (TP)
         string baseNameTP = MakeTMName(ticket, OP_HLINE_GRID_TP_1 + rowIdx);

         if(priceTP > 0)
           {
            UpdateInvisibleLine(baseNameTP, priceTP, clrNONE, 10);
            bool isAbove = isBuy;
            color drawColTP = isTPActive ? C'10,192,160' : LighterColor(C'10,192,160', 50);
            DrawGridLineTV(baseNameTP, priceTP, drawColTP, chartLabel, xPos, drawWidth, isAbove);
           }
        }
      else
        {
         string baseNameTP = MakeTMName(ticket, OP_HLINE_GRID_TP_1 + rowIdx);
         ObjectDelete(0, baseNameTP);
         ObjectDelete(0, baseNameTP + "_Line");
         ObjectDelete(0, baseNameTP + "_Btn");
        }

      // ----------------------------------------------------------------
      // B. LADO DERECHO (STOP LOSS)
      // ----------------------------------------------------------------
      bool isSLActive = mem.grid.rows[rowIdx].isActiveSL;
      bool isDraggingThisSL = (g_isDragging && g_dragTicket == ticket && g_dragType == 20 && g_dragGridRow == i);
      bool showPreviewSL = (ticket > 0 && !isSLActive && isMenuOpen && i == firstInactiveSL);

      if(isSLActive || showPreviewSL || isDraggingThisSL)
        {
         double valSL = mem.grid.rows[rowIdx].valSL_Price;
         double priceSL = 0.0;
         int currentRankSL = isSLActive ? ++rankSL : (activeSLCount + 1);

         if(isDraggingThisSL)
            priceSL = ObjectGetDouble(0, "TM_HLine_SL_" + IntegerToString(ticket) + "_" + sI, OBJPROP_PRICE);
         else
           {
            if(valSL == 0 && distMode != 3)
               priceSL = entry;
            else
               if(distMode == 0)
                  priceSL = isBuy ? entry - (valSL * mul) : entry + (valSL * mul);
               else
                  if(distMode == 1)
                     priceSL = valSL;
                  else
                     if(distMode == 2)
                       {
                        double risk = MathAbs(entry - sl);
                        if(sl == 0 || risk < point)
                           risk = 50 * mul;
                        double dist = risk * valSL;
                        priceSL = isBuy ? entry - dist : entry + dist;
                       }
                     else
                       {
                        if(sl > 0)
                          {
                           double totalDist = MathAbs(entry - sl);
                           double denomSL = isSLActive ? (activeSLCount + 1.0) : (activeSLCount + 2.0);
                           double stepDist = (totalDist / denomSL) * currentRankSL;
                           priceSL = isBuy ? entry - stepDist : entry + stepDist;
                          }
                        else
                           priceSL = entry;
                       }
           }

         double rawLotVal = mem.grid.rows[rowIdx].valSL_Vol;
         if(rawLotVal <= 0)
            rawLotVal = 20;

         double finalLot = 0.0;
         if(lotMode == 0)
            finalLot = vol * (rawLotVal / 100.0);
         else
            if(lotMode == 1)
               finalLot = currentRemSL * (rawLotVal / 100.0);
            else
               if(lotMode == 2)
                  finalLot = rawLotVal;

         finalLot = MathFloor(finalLot / volStep) * volStep;
         if(finalLot < minLot)
            finalLot = minLot;
         if(finalLot > currentRemSL)
            finalLot = currentRemSL;

         if(isSLActive)
           {
            currentRemSL -= finalLot;
            if(currentRemSL < 0)
               currentRemSL = 0;
           }

         // CÁLCULOS RICOS PARA EL GRID SL
         double distPips = MathAbs(entry - priceSL) / mul;
         double moneyEst = (tickSize > 0) ? (MathAbs(entry - priceSL) / tickSize) * tickVal * finalLot : 0;
         double rr = 0; // Para el SL usamos el riesgo vs TP principal
         if(tp > 0 && MathAbs(entry - tp) > point)
            rr = MathAbs(entry - priceSL) / MathAbs(entry - tp);

         // FORMATO: SL1 39 | 0.00 | RR 0.28 | -0.00 USD
         string chartLabel = isSLActive ? StringFormat("SL%s %.0f | %.2f | RR %.2f | -%.2f %s", sI, distPips, finalLot, rr, moneyEst, cur) : ("Prev SL " + sI);

         string objNameSL = "TM_Line_SL_" + IntegerToString(ticket) + "_" + sI;
         string realLineSL = "TM_HLine_SL_" + IntegerToString(ticket) + "_" + sI;

         // LADO DERECHO (SL)
         string baseNameSL = MakeTMName(ticket, OP_HLINE_GRID_SL_1 + rowIdx);

         if(priceSL > 0)
           {
            UpdateInvisibleLine(baseNameSL, priceSL, clrNONE, 20);
            bool isAbove = !isBuy;
            color drawColSL = isSLActive ? C'244,89,101' : LighterColor(C'244,89,101', 50);
            DrawGridLineTV(baseNameSL, priceSL, drawColSL, chartLabel, xPos, drawWidth, isAbove);
           }
        }
      else
        {
         string baseNameSL = MakeTMName(ticket, OP_HLINE_GRID_SL_1 + rowIdx);
         ObjectDelete(0, baseNameSL);
         ObjectDelete(0, baseNameSL + "_Line");
         ObjectDelete(0, baseNameSL + "_Btn");
        }
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              DeleteBELines(ulong ticket)
  {
   string baseStart = MakeTMName(ticket, OP_HLINE_BE_START);
   string baseOff   = MakeTMName(ticket, OP_HLINE_BE_OFF);
   ObjectDelete(0, baseStart);
   ObjectDelete(0, baseStart + "_Line");
   ObjectDelete(0, baseStart + "_Btn");
   ObjectDelete(0, baseOff);
   ObjectDelete(0, baseOff + "_Line");
   ObjectDelete(0, baseOff + "_Btn");
  }

//+------------------------------------------------------------------+
//| CONVERTIR STRING A TIMEFRAME (Soporte completo)                  |
//+------------------------------------------------------------------+
ENUM_TIMEFRAMES   StringToTF(string s)
  {
   if(s == "M1")
      return PERIOD_M1;
   if(s == "M2")
      return PERIOD_M2;
   if(s == "M3")
      return PERIOD_M3;
   if(s == "M4")
      return PERIOD_M4;
   if(s == "M5")
      return PERIOD_M5;
   if(s == "M6")
      return PERIOD_M6;
   if(s == "M10")
      return PERIOD_M10;
   if(s == "M12")
      return PERIOD_M12;
   if(s == "M15")
      return PERIOD_M15;
   if(s == "M20")
      return PERIOD_M20;
   if(s == "M30")
      return PERIOD_M30;
   if(s == "H1")
      return PERIOD_H1;
   if(s == "H2")
      return PERIOD_H2;
   if(s == "H3")
      return PERIOD_H3;
   if(s == "H4")
      return PERIOD_H4;
   if(s == "H6")
      return PERIOD_H6;
   if(s == "H8")
      return PERIOD_H8;
   if(s == "H12")
      return PERIOD_H12;
   if(s == "D1")
      return PERIOD_D1;
   if(s == "W1")
      return PERIOD_W1;
   if(s == "MN1")
      return PERIOD_MN1;

   return PERIOD_CURRENT; // Fallback
  }

//+------------------------------------------------------------------+
//| CONVERTIR ÍNDICE A MÉTODO DE MA                                  |
//+------------------------------------------------------------------+
ENUM_MA_METHOD    IndexToMethod(int idx)
  {
   switch(idx)
     {
      case 0:
         return MODE_SMA;  // Simple
      case 1:
         return MODE_EMA;  // Exponential
      case 2:
         return MODE_SMMA; // Smoothed
      case 3:
         return MODE_LWMA; // Linear Weighted
     }
   return MODE_SMA;
  }

//+------------------------------------------------------------------+
//| CONVERTIR ÍNDICE A PRECIO APLICADO                               |
//+------------------------------------------------------------------+
ENUM_APPLIED_PRICE IndexToPrice(int idx)
  {
   switch(idx)
     {
      case 0:
         return PRICE_CLOSE;
      case 1:
         return PRICE_OPEN;
      case 2:
         return PRICE_HIGH;
      case 3:
         return PRICE_LOW;
      case 4:
         return PRICE_MEDIAN;
      case 5:
         return PRICE_TYPICAL;
      case 6:
         return PRICE_WEIGHTED;
     }
   return PRICE_CLOSE;
  }

//+------------------------------------------------------------------+
//| OBTENER VALOR DE MEDIA MÓVIL                                     |
//+------------------------------------------------------------------+
double            GetMAValue(string symbol, ENUM_TIMEFRAMES tf, int period, int shift, ENUM_MA_METHOD method, ENUM_APPLIED_PRICE price)
  {
// 1. Crear Handle
   int handle = iMA(symbol, tf, period, shift, method, price);
   if(handle == INVALID_HANDLE)
      return 0;

// 2. Copiar Buffer
   double buffer[];
   ArraySetAsSeries(buffer, true);

// Copiamos 1 solo valor.
// Usamos índice 0 para el valor actual (en tiempo real), o 1 para vela cerrada.
// Para un visualizador de "dónde iría el SL", 0 es lo más preciso visualmente.
   if(CopyBuffer(handle, 0, 0, 1, buffer) < 0)
     {
      IndicatorRelease(handle);
      return 0;
     }

   IndicatorRelease(handle); // Liberar memoria
   return buffer[0];
  }


// Busca esta función al final de tu archivo y modifícala:
double            GetATRValue(string symbol, ENUM_TIMEFRAMES tf, int period)
  {
   int handle = iATR(symbol, tf, period);
   if(handle == INVALID_HANDLE)
      return 0;

   double buffer[];
   ArraySetAsSeries(buffer, true);

// CAMBIO AQUÍ: Usar '1' en lugar de '0' como start_pos
// Esto toma el valor de la vela anterior ya cerrada. Es mucho más estable.
   if(CopyBuffer(handle, 0, 1, 1, buffer) < 0)
     {
      IndicatorRelease(handle);
      return 0;
     }

   IndicatorRelease(handle);
   return buffer[0];
  }

//+------------------------------------------------------------------+
//| AUXILIAR: BUSCAR EXTREMO (High/Low) de N velas cerradas          |
//+------------------------------------------------------------------+
double            GetPriceExtreme(string symbol, ENUM_TIMEFRAMES tf, int period, bool findHigh)
  {
   MqlRates rates[];
   ArraySetAsSeries(rates, true);

// Copiamos desde la vela 1 (la última cerrada)
// Cantidad = period
   int copied = CopyRates(symbol, tf, 1, period, rates);

   if(copied <= 0)
      return 0;

   double extreme = 0;

   if(findHigh)
     {
      // Buscamos el Máximo más Alto
      extreme = rates[0].high;
      for(int i=1; i<copied; i++)
         if(rates[i].high > extreme)
            extreme = rates[i].high;
     }
   else
     {
      // Buscamos el Mínimo más Bajo
      extreme = rates[0].low;
      for(int i=1; i<copied; i++)
         if(rates[i].low < extreme)
            extreme = rates[i].low;
     }

   return extreme;
  }

// Función para cerrar menús hermanos excepto el actual
void              CloseOtherMenus(ulong ticket, ushort currentOpcode)
  {
   ushort allMenus[] = {OP_TM_M_PART, OP_TM_M_EDIT, OP_TM_M_BE, OP_TM_M_GRID, OP_TM_M_TS, OP_TM_M_CLOSE, OP_TM_M_REV, OP_TM_M_TRLIM, OP_TM_M_COLOR, OP_TM_M_COMM, OP_TM_M_OCO, OP_TM_M_EXP};

   for(int i=0; i<ArraySize(allMenus); i++)
     {
      if(allMenus[i] != currentOpcode)
        {
         SmartSetInteger(MakeTMName(ticket, allMenus[i]), OBJPROP_STATE, false);
        }
     }
  }

// Devuelve un ID numérico para guardar en la variable global
int               GetTabID(string tab)
  {
   if(tab == "Part")
      return 1;
   if(tab == "Edit")
      return 2;
   if(tab == "Grid")
      return 3;
   if(tab == "TS")
      return 4;
   if(tab == "BE")
      return 5;
   return 0; // Cerrado
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              CheckVirtualConditions()
  {
   for(int i = PositionsTotal() - 1; i >= 0; i--)
     {
      ulong ticket = PositionGetTicket(i);
      if(ticket <= 0)
         continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol)
         continue;

      if(PositionGetString(POSITION_SYMBOL) != _Symbol)
         continue;

      // 1. PEDIMOS LA MEMORIA RAM DEL TICKET (Velocidad de la luz)
      CTradeState *mem = TradeRAM.Get(ticket);
      if(mem == NULL)
         continue;

      // 2. SI NO ESTÁ OCULTO, SALTAR AL SIGUIENTE
      if(!mem.isHiddenActive)
         continue;

      long type = PositionGetInteger(POSITION_TYPE);
      double currentPrice = (type == POSITION_TYPE_BUY) ? SymbolInfoDouble(_Symbol, SYMBOL_BID) : SymbolInfoDouble(_Symbol, SYMBOL_ASK);

      // Lógica de Cierre TP
      if(mem.virtualTP > 0)
        {
         if((type == POSITION_TYPE_BUY && currentPrice >= mem.virtualTP) ||
            (type == POSITION_TYPE_SELL && currentPrice <= mem.virtualTP))
           {
            //////Print("VIRTUAL TP REACHED for #", ticket, ". Closing...");
            if(QueueClosePosition(ticket))
              {

               continue;
              }
           }
        }

      // Lógica de Cierre SL
      if(mem.virtualSL > 0)
        {
         if((type == POSITION_TYPE_BUY && currentPrice <= mem.virtualSL) ||
            (type == POSITION_TYPE_SELL && currentPrice >= mem.virtualSL))
           {
            //////Print("VIRTUAL SL REACHED for #", ticket, ". Closing...");
            if(QueueClosePosition(ticket))
              {

               continue;
              }
           }
        }
     }
  }

//+------------------------------------------------------------------+
//| ACTUALIZAR LÍNEAS OCULTAS / VIRTUALES (Respetando el Colapso)    |
//+------------------------------------------------------------------+
void              UpdateHiddenVisuals(ulong ticket)
  {
   CTradeState *mem = TradeRAM.Get(ticket);
   if(mem == NULL)
      return;

   string objTP = MakeTMName(ticket, OP_HLINE_VIRT_TP);
   string objSL = MakeTMName(ticket, OP_HLINE_VIRT_SL);

// 1. LÓGICA ARQUITECTÓNICA: Solo dibujamos si está activo Y NO está colapsado
   if(mem.isHiddenActive && !mem.isCollapsed)
     {
      // --- DIBUJAR TP VIRTUAL (VERDE) ---
      if(mem.virtualTP > 0)
        {
         if(ObjectFind(0, objTP) < 0)
           {
            ObjectCreate(0, objTP, OBJ_HLINE, 0, 0, mem.virtualTP);
            SmartSetInteger(objTP, OBJPROP_COLOR, C'50,220,50');
            SmartSetInteger(objTP, OBJPROP_STYLE, STYLE_DASH);
            SmartSetInteger(objTP, OBJPROP_WIDTH, 1);
            ObjectSetString(0, objTP, OBJPROP_TEXT, "Virtual TP #" + IntegerToString(ticket));
            SmartSetInteger(objTP, OBJPROP_SELECTABLE, false);
           }
         else
            ObjectSetDouble(0, objTP, OBJPROP_PRICE, mem.virtualTP);
        }

      // --- DIBUJAR SL VIRTUAL (ROJO) ---
      if(mem.virtualSL > 0)
        {
         if(ObjectFind(0, objSL) < 0)
           {
            ObjectCreate(0, objSL, OBJ_HLINE, 0, 0, mem.virtualSL);
            SmartSetInteger(objSL, OBJPROP_COLOR, C'255,50,50');
            SmartSetInteger(objSL, OBJPROP_STYLE, STYLE_DASH);
            SmartSetInteger(objSL, OBJPROP_WIDTH, 1);
            ObjectSetString(0, objSL, OBJPROP_TEXT, "Virtual SL #" + IntegerToString(ticket));
            SmartSetInteger(objSL, OBJPROP_SELECTABLE, false);
           }
         else
            ObjectSetDouble(0, objSL, OBJPROP_PRICE, mem.virtualSL);
        }
     }
// 2. SI ESTÁ INACTIVO O COLAPSADO: DESTRUIR VISUALES
   else
     {
      ObjectDelete(0, objTP);
      ObjectDelete(0, objSL);
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
double            GetGridLevelPrice(ulong ticket, int row, int type, int distMode, double entry, double sl, double tp, int activeCount, int rank)
  {
   CTradeState *mem = (ticket == 0) ? TemplateState : TradeRAM.Get(ticket);
   if(mem == NULL)
      return 0.0;

   string sym = (ticket == 0) ? _Symbol : mem.symbol;
   double val = (type == 1) ? mem.grid.rows[row - 1].valTP_Price : mem.grid.rows[row - 1].valSL_Price;

   double point = SymbolInfoDouble(sym, SYMBOL_POINT);
   double mul   = (SymbolInfoInteger(sym, SYMBOL_DIGITS)%2!=0) ? 10 * point : point;
   bool   isBuy = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY);
   double price = 0.0;

   if(distMode == 1)
      price = val;
   else
      if(distMode == 2)
        {
         double risk = MathAbs(entry - sl);
         if(sl == 0 || risk < point)
            risk = 50 * mul;
         double dist = risk * val;
         price = isBuy ? ((type == 1) ? entry + dist : entry - dist) : ((type == 1) ? entry - dist : entry + dist);
        }
      else
         if(distMode == 3)
           {
            if(type == 1 && tp > 0)
              {
               double stepDist = (MathAbs(tp - entry) / (activeCount + 1.0)) * rank;
               price = isBuy ? entry + stepDist : entry - stepDist;
              }
            else
               if(type == 2 && sl > 0)
                 {
                  double stepDist = (MathAbs(entry - sl) / (activeCount + 1.0)) * rank;
                  price = isBuy ? entry - stepDist : entry + stepDist;
                 }
               else
                  price = entry;
           }
         else
           {
            double dist = val * mul;
            price = isBuy ? ((type == 1) ? entry + dist : entry - dist) : ((type == 1) ? entry - dist : entry + dist);
           }
   return price;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
double            CalculateGridVolume(ulong ticket, int row, int type, int lotMode, double currentVol)
  {
   CTradeState *mem = (ticket == 0) ? TemplateState : TradeRAM.Get(ticket);
   if(mem == NULL)
      return 0.0;
   string sym = (ticket == 0) ? _Symbol : mem.symbol;

   double rawVal = (type == 1) ? mem.grid.rows[row - 1].valTP_Vol : mem.grid.rows[row - 1].valSL_Vol;
   if(rawVal <= 0)
      rawVal = 20;

   double calcVol = 0.0;
   if(lotMode == 0 || lotMode == 1)
      calcVol = currentVol * (rawVal / 100.0);
   else
      if(lotMode == 2)
         calcVol = rawVal;

   double step = SymbolInfoDouble(sym, SYMBOL_VOLUME_STEP);
   double min  = SymbolInfoDouble(sym, SYMBOL_VOLUME_MIN);

   calcVol = MathFloor(calcVol / step) * step;
   if(calcVol < min)
      calcVol = min;
   if(calcVol > currentVol)
      calcVol = currentVol;
   return calcVol;
  }

//+------------------------------------------------------------------+
//| CALCULAR OFFSET DEL BREAK EVEN (Manual o Auto)                   |
//+------------------------------------------------------------------+
double CalculateBEOffset(ulong ticket, long type, double entry)
  {
   CTradeState *mem = TradeRAM.Get(ticket);
   if(mem == NULL)
      return 0.0;

   string sym = mem.symbol;
   int modeOff = mem.be.modeOffset;
   double valOff = mem.be.valOffset;
   bool isAuto = mem.be.isAuto;
   bool isBuy = (type == POSITION_TYPE_BUY || type == ORDER_TYPE_BUY_LIMIT || type == ORDER_TYPE_BUY_STOP || type == ORDER_TYPE_BUY_STOP_LIMIT);

   double offsetPriceDist = 0.0;
   double point = SymbolInfoDouble(sym, SYMBOL_POINT);

   if(isAuto)
     {
      // Llamamos a nuestra nueva función matemática
      offsetPriceDist = GetAutoBEPoints(ticket);
     }
   else
     {
      // Modo manual
      double mul = (SymbolInfoInteger(sym, SYMBOL_DIGITS)%2!=0) ? 10 * point : point;
      double safeEntry=0, safeSL=0, safeTP=0;
      GetTradeInfo(ticket, safeEntry, safeSL, safeTP);

      if(modeOff == 0)
         offsetPriceDist = valOff * mul; // Pips
      else
         if(modeOff == 1) // Risk Ratio
           {
            double risk = MathAbs(entry - safeSL);
            if(risk < point)
               risk = 50 * mul;
            offsetPriceDist = risk * valOff;
           }
         else
            if(modeOff == 2) // % Price
               offsetPriceDist = entry * (valOff / 100.0);
            else
               if(modeOff == 3) // % TP
                 {
                  if(safeTP > 0)
                     offsetPriceDist = MathAbs(safeTP - entry) * (valOff / 100.0);
                  else
                     offsetPriceDist = 10 * mul;
                 }
     }

// Retornamos el precio exacto donde debe ir la línea del Break Even
   return isBuy ? entry + offsetPriceDist : entry - offsetPriceDist;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
double            GetBELevelPrice(ulong ticket, int typeLine, double entry)
  {
   double safeEntry=0, safeSL=0, safeTP=0, vol=0;
   long type = -1;
   CTradeState *mem;
   if(!GetUnifiedTradeInfo(ticket, safeEntry, safeSL, safeTP, vol, type, mem))
      return 0.0;

   string sym = (ticket == 0) ? _Symbol : mem.symbol;
   double val = (typeLine == 0) ? mem.be.valStart : mem.be.valOffset;
   int mode   = (typeLine == 0) ? mem.be.modeStart : mem.be.modeOffset;

   double point = SymbolInfoDouble(sym, SYMBOL_POINT);
   double mul   = (SymbolInfoInteger(sym, SYMBOL_DIGITS)%2!=0) ? 10 * point : point;
   bool isBuy   = (type == POSITION_TYPE_BUY || type == ORDER_TYPE_BUY_LIMIT || type == ORDER_TYPE_BUY_STOP || type == ORDER_TYPE_BUY_STOP_LIMIT);
   double dist = 0;

   if(mode == 0)
      dist = val * mul;
   else
      if(mode == 1)
        {
         double risk = MathAbs(entry - safeSL);
         if(risk < point)
            risk = 50 * mul;
         dist = risk * val;
        }
      else
         if(mode == 2)
            dist = entry * (val / 100.0);
         else
            if(mode == 3)
              {
               if(safeTP > 0)
                  dist = MathAbs(safeTP - entry) * (val / 100.0);
               else
                  dist = 20 * mul;
              }

   return isBuy ? entry + dist : entry - dist;
  }

//+------------------------------------------------------------------+
//| CÁLCULO PERFECTO DEL AUTO BREAK EVEN (Spread + Comisiones)       |
//+------------------------------------------------------------------+
double GetAutoBEPoints(ulong ticket)
  {
// Si es el panel (ticket 0) o una orden pendiente, usamos los datos globales,
// ya que aún no hay comisiones cobradas, pero SÍ hay spread.
   string sym = _Symbol;
   double comm = 0.0;
   double swap = 0.0;
   double vol  = PanelState.GetLot(); // Por defecto el lote del panel

// Si es una posición viva, sacamos sus datos reales
   if(ticket > 0 && PositionSelectByTicket(ticket))
     {
      sym  = PositionGetString(POSITION_SYMBOL);
      comm = GetPositionCommission(ticket);
      swap = PositionGetDouble(POSITION_SWAP);
      vol  = PositionGetDouble(POSITION_VOLUME);
     }
   else
      if(ticket > 0 && OrderSelect(ticket))
        {
         sym = OrderGetString(ORDER_SYMBOL);
         vol = OrderGetDouble(ORDER_VOLUME_CURRENT);
        }

   double totalCost = MathAbs(comm + swap);

// Extraemos métricas del Oráculo de MT5
   double point     = SymbolInfoDouble(sym, SYMBOL_POINT);
   double tickValue = SymbolInfoDouble(sym, SYMBOL_TRADE_TICK_VALUE);
   double tickSize  = SymbolInfoDouble(sym, SYMBOL_TRADE_TICK_SIZE);
   double spread    = SymbolInfoInteger(sym, SYMBOL_SPREAD) * point; // Spread convertido a precio

// Protección matemática
   if(tickValue <= 0 || vol <= 0 || tickSize <= 0)
      return spread + (point * 10); // Fallback: Spread + 1 pip de seguridad

// 1. ¿Cuánto dinero ganamos/perdemos por cada 'punto' de movimiento?
   double moneyPerPoint = (tickValue / tickSize) * point * vol;

   double costDistance = 0.0;
   if(moneyPerPoint > 0)
     {
      // 2. Convertimos el costo de las comisiones (dinero) a distancia en precio
      costDistance = (totalCost / moneyPerPoint) * point;
     }

// 3. LA FÓRMULA MAESTRA: Distancia de Comisiones + Spread + 1 punto (0.1 pip) de respiro
   double calculatedDistance = costDistance + spread + point;

   return calculatedDistance; // Retorna una distancia limpia en precio (Ej: 0.00035)
  }

//+------------------------------------------------------------------+
//| CALCULAR EL NIVEL OBJETIVO DEL SL (USANDO LÍNEA VISUAL)          |
//+------------------------------------------------------------------+
double            GetTrailingStopLevel(ulong ticket, int mode, long type, double currentPrice)
  {
// 1. INTENTAR LEER LA LÍNEA AZUL (YA CALCULADA POR LA VISUAL)
// --- CORRECCIÓN MATEMÁTICA ---
   string lineName = MakeTMName(ticket, OP_HLINE_TS_DIST);

   if(ObjectFind(0, lineName) >= 0)
      // ... (El resto queda igual)
     {
      double priceFromLine = ObjectGetDouble(0, lineName, OBJPROP_PRICE);

      // Validación básica: Que no sea 0
      if(priceFromLine > 0)
        {
         return priceFromLine;
        }
     }




   double point    = Market.point;
   double targetSL = 0.0;

// ... (Aquí puedes dejar tu switch original o simplemente retornar 0 para no operar)
// Por seguridad, retornamos 0 para no hacer locuras si no hay línea visual.
   return 0.0;
  }

//+------------------------------------------------------------------+
//| MODIFICAR SL (CON DEPURACIÓN DE REGLAS)                          |
//+------------------------------------------------------------------+
void              ModifyTrailingStop(ulong ticket, long type, double currentSL, double targetSL)
  {
   double point    = Market.point;
   double stopsLevel = (double)SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL) * point;
   if(stopsLevel == 0)
      stopsLevel = 20 * point; // Fallback

   bool shouldModify = false;
   double currentPrice = (type == POSITION_TYPE_BUY) ? SymbolInfoDouble(_Symbol, SYMBOL_BID) : SymbolInfoDouble(_Symbol, SYMBOL_ASK);


   if(type == POSITION_TYPE_BUY)
     {
      // Regla 1: Mejorar (Subir)
      bool improved = (currentSL == 0 || targetSL > (currentSL + point));

      // Regla 2: Estar debajo del precio
      bool belowPrice = (targetSL < currentPrice);

      // Regla 3: Distancia mínima
      double dist = currentPrice - targetSL;
      bool distOK = (dist > stopsLevel);

      if(improved && belowPrice && distOK)
         shouldModify = true;
     }
   else
     {
      // Regla 1: Mejorar (Bajar)
      bool improved = (currentSL == 0 || targetSL < (currentSL - point));

      // Regla 2: Estar encima del precio
      bool abovePrice = (targetSL > currentPrice);

      // Regla 3: Distancia mínima
      double dist = targetSL - currentPrice;
      bool distOK = (dist > stopsLevel);


      if(improved && abovePrice && distOK)
         shouldModify = true;
     }

// --- EJECUCIÓN ---
   if(shouldModify)
     {
      // Verificar Modo Oculto 100% RAM
      CTradeState *mem = TradeRAM.Get(ticket);

      if(mem != NULL && mem.isHiddenActive)
        {
         mem.virtualSL = targetSL;
         SaveTradesToBin(); // Guardamos el nuevo SL en el disco
         UpdateOpenTradesVisuals();
        }
      // ... (aquí iría el código normal si no estuviera oculto)
     }
  }

// Helper para calcular distancia en precio (Modo Normal)
double            GetTSDistInPrice(ulong ticket, int modeDist, double valDist)
  {
   double point    = Market.point;
//int digits      = Market.digits;
   double mul      = Market.multiplier;

   if(modeDist == 0) // Pips
      return valDist * mul;

// Si quieres implementar RR/%Price, necesitas datos de la posición (Entry, SL, TP)
// Por ahora devolvemos Pips como base
   return valDist * mul;
  }

//+------------------------------------------------------------------+
//| HELPER: Calcular Precio de Nivel TS (Para Start)                 |
//+------------------------------------------------------------------+
double            GetTSLevelPrice(ulong ticket, int row, int mode, double val, double entry, double sl, double tp)
  {
   double safeEntry, safeSL, safeTP, vol;
   long type = 0;
   CTradeState *mem;

   if(!GetUnifiedTradeInfo(ticket, safeEntry, safeSL, safeTP, vol, type, mem))
      return 0.0;

// 🛡️ LA CURA DEL SÍMBOLO: Usamos el ADN de la orden (mem.symbol), no el del gráfico
   string sym = (ticket == 0) ? _Symbol : mem.symbol;
   double point = SymbolInfoDouble(sym, SYMBOL_POINT);
   double mul   = (SymbolInfoInteger(sym, SYMBOL_DIGITS)%2!=0) ? 10 * point : point;

   bool isBuy = (type == POSITION_TYPE_BUY || type == ORDER_TYPE_BUY_LIMIT || type == ORDER_TYPE_BUY_STOP || type == ORDER_TYPE_BUY_STOP_LIMIT);
   double price = 0.0;

   if(val == 0)
      return 0;

   if(mode == 0)
     {
      double dist = val * mul;
      price = isBuy ? entry + dist : entry - dist;
     }
   else
      if(mode == 1)
        {
         double risk = MathAbs(entry - sl);
         if(sl == 0 || risk < point)
            risk = 50 * mul;
         double dist = risk * val;
         price = isBuy ? entry + dist : entry - dist;
        }
      else
         if(mode == 2)
           {
            double dist = entry * (val / 100.0);
            price = isBuy ? entry + dist : entry - dist;
           }
         else
            if(mode == 3)
              {
               if(tp > 0)
                 {
                  double total = MathAbs(tp - entry);
                  double dist = total * (val / 100.0);
                  price = isBuy ? entry + dist : entry - dist;
                 }
               else
                  price = entry;
              }

   return price;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
string            GetMemVal(ulong t, int r, string def)
  {
   CTradeState *mem = TradeRAM.Get(t);
   if(mem == NULL)
      return def;

   double val = mem.ts.inputs[r];
// Si no se ha configurado (es 0) usamos el default
   if(val == 0 && def != "0" && def != "0.0")
      return def;

   return DoubleToString(val, (r==2 || r==3)? 2 : 0);
  }
//+------------------------------------------------------------------+
//| MOTOR MATEMÁTICO: CÁLCULO DE TRAILING STOP (100% PURIFICADO)     |
//+------------------------------------------------------------------+
TS_Calculation    CalculateTSLevels(ulong ticket)
  {
   TS_Calculation res;
   res.isValid = false;
   res.startPrice = 0;
   res.targetPrice = 0;
   res.isActive = false;
   res.anchorPrice = 0;

   double entry, sl, tp, vol;
   long type;
   CTradeState *mem = NULL;

   if(!GetUnifiedTradeInfo(ticket, entry, sl, tp, vol, type, mem))
      return res;
   if(CheckPointer(mem) == POINTER_INVALID)
      return res;

   string sym = (ticket == 0) ? _Symbol : mem.symbol;
   bool isBuy = (type == POSITION_TYPE_BUY || type == ORDER_TYPE_BUY_LIMIT || type == ORDER_TYPE_BUY_STOP || type == ORDER_TYPE_BUY_STOP_LIMIT);
   bool isRealPosition = PositionSelectByTicket(ticket);
   double currentPrice = (isBuy) ? SymbolInfoDouble(sym, SYMBOL_BID) : SymbolInfoDouble(sym, SYMBOL_ASK);

   bool isMenuOpen = false;
   if(ticket > 0)
      isMenuOpen = (mem.activeSubMenu == OP_TM_M_TS);

   if(!mem.ts.isActive)
     {
      if(ticket == 0)
        {
         res.isValid = false;
         return res;
        }
      if(ticket != 0 && !isMenuOpen)
        {
         res.isValid = false;
         return res;
        }
      isRealPosition = false;
     }

   res.isValid = true;
   int tsMode = mem.ts.mode;
   res.anchorPrice = mem.ts.anchorPrice;
   res.isActive = (res.anchorPrice > 0 && ticket > 0);

   double point = SymbolInfoDouble(sym, SYMBOL_POINT);
   int dig = (int)SymbolInfoInteger(sym, SYMBOL_DIGITS);
   double mul = (dig%2!=0) ? 10 * point : point;

   switch(tsMode)
     {
      case 0: // NORMAL
        {
         double valStart = mem.ts.inputs[0];
         int modeStart = mem.ts.units[0];
         res.startPrice = GetTSLevelPrice(ticket, 0, modeStart, valStart, entry, sl, tp);
         double dist = GetTSDistValue(ticket, entry, sl, tp);

         if(!res.isActive)
           {
            bool triggered = false;
            if(isRealPosition)
              {
               // 🛡️ MAGIA HFT: Usamos 'currentPrice' que ya discrimina Bid/Ask correctamente arriba.
               if(isBuy)
                 {
                  if(currentPrice >= res.startPrice)
                     triggered = true;
                 }
               else
                 {
                  if(currentPrice <= res.startPrice)
                     triggered = true;
                 }
              }

            if(triggered)
              {
               res.isActive = true;
               res.anchorPrice = currentPrice;
               double immediateSL = isBuy ? currentPrice - dist : currentPrice + dist;
               res.targetPrice = immediateSL;
               // MAGIA: m_trade ELIMINADO AQUÍ. El motor HFT se encarga.
              }
            else
               res.targetPrice = isBuy ? res.startPrice - dist : res.startPrice + dist;
           }

         if(res.isActive)
           {
            bool newRecord = false;
            if(isBuy  && currentPrice > res.anchorPrice)
              {
               res.anchorPrice = currentPrice;
               newRecord = true;
              }
            if(!isBuy && currentPrice < res.anchorPrice)
              {
               res.anchorPrice = currentPrice;
               newRecord = true;
              }
            if(newRecord)
               mem.ts.anchorPrice = res.anchorPrice;
            res.targetPrice = isBuy ? res.anchorPrice - dist : res.anchorPrice + dist;
           }
         break;
        }
      case 1: // FRACTALS
        {
         double valStart = mem.ts.inputs[0];
         int modeStart = mem.ts.units[0];
         ENUM_TIMEFRAMES tf = GetTFFromIndex(mem.ts.dropIdx[1]);
         int scanBars = (mem.ts.inputs[2] > 0) ? (int)mem.ts.inputs[2] : 200;
         double indent = mem.ts.inputs[3] * mul;

         res.startPrice = GetTSLevelPrice(ticket, 0, modeStart, valStart, entry, sl, tp);
         double fractalPrice = IndPool.GetFractal(sym, tf, !isBuy, scanBars);
         if(fractalPrice == 0)
            fractalPrice = (sl > 0) ? sl : entry;

         double rawTarget = isBuy ? fractalPrice - indent : fractalPrice + indent;

         //// ---------------------------------------------------------
         //// 🕵️‍♂️ RADAR INYECTADO: REPORTE DE CÁLCULO DE FRACTALES
         //// ---------------------------------------------------------
         //if(ticket == 0) // Solo escuchamos al Panel Pre-Op para no saturar
         //  {
         //   Print(">>> [RADAR FRACTAL] Tk: 0 | Dir: ", (isBuy?"BUY":"SELL"),
         //         " | ScanBars: ", scanBars,
         //         " | Precio Fractal encontrado: ", fractalPrice,
         //         " | Target Calculado: ", rawTarget,
         //         " | SL Actual: ", sl);
         //  }

         if(!res.isActive)
           {
            bool triggered = false;
            if(isRealPosition)
              {
               // 🛡️ MAGIA HFT: Usamos 'currentPrice' que ya discrimina Bid/Ask correctamente arriba.
               if(isBuy)
                 {
                  if(currentPrice >= res.startPrice)
                     triggered = true;
                 }
               else
                 {
                  if(currentPrice <= res.startPrice)
                     triggered = true;
                 }
              }
            if(triggered)
              {
               res.isActive = true;
               res.anchorPrice = currentPrice;
               mem.ts.anchorPrice = currentPrice;
               res.targetPrice = rawTarget;
               // MAGIA: m_trade ELIMINADO AQUÍ.
              }
            else
               res.targetPrice = rawTarget;
           }
         if(res.isActive)
            res.targetPrice = rawTarget;
         break;
        }
      case 2: // MOVING AVERAGE
        {
         double valStart = mem.ts.inputs[0];
         int modeStart = mem.ts.units[0];
         ENUM_TIMEFRAMES tf = GetTFFromIndex(mem.ts.dropIdx[1]);
         int maPeriod = (mem.ts.inputs[2] > 0) ? (int)mem.ts.inputs[2] : 50;
         ENUM_MA_METHOD maMethod = IndexToMethod(mem.ts.dropIdx[3]);
         ENUM_APPLIED_PRICE maPrice = IndexToPrice(mem.ts.dropIdx[4]);
         double indentDist = mem.ts.inputs[5] * mul;

         res.startPrice = GetTSLevelPrice(ticket, 0, modeStart, valStart, entry, sl, tp);
         double maValue = IndPool.GetMA(sym, tf, maPeriod, 0, maMethod, maPrice);
         if(maValue == 0)
            maValue = (sl > 0) ? sl : entry;

         double rawTarget = isBuy ? maValue - indentDist : maValue + indentDist;

         if(!res.isActive)
           {
            bool triggered = false;
            if(isRealPosition)
              {
               // 🛡️ MAGIA HFT: Usamos 'currentPrice' que ya discrimina Bid/Ask correctamente arriba.
               if(isBuy)
                 {
                  if(currentPrice >= res.startPrice)
                     triggered = true;
                 }
               else
                 {
                  if(currentPrice <= res.startPrice)
                     triggered = true;
                 }
              }
            if(triggered)
              {
               res.isActive = true;
               res.anchorPrice = currentPrice;
               mem.ts.anchorPrice = currentPrice;
               res.targetPrice = rawTarget;
               // MAGIA: m_trade ELIMINADO AQUÍ.
              }
            else
               res.targetPrice = rawTarget;
           }
         if(res.isActive)
            res.targetPrice = rawTarget;
         break;
        }
      case 3: // PSAR
        {
         double valStart = mem.ts.inputs[0];
         int modeStart = mem.ts.units[0];
         ENUM_TIMEFRAMES tf = GetTFFromIndex(mem.ts.dropIdx[1]);
         double valStep = (mem.ts.inputs[2] > 0) ? mem.ts.inputs[2] : 0.02;
         double valMax = (mem.ts.inputs[3] > 0) ? mem.ts.inputs[3] : 0.2;
         double indentDist = mem.ts.inputs[4] * mul;

         res.startPrice = GetTSLevelPrice(ticket, 0, modeStart, valStart, entry, sl, tp);
         double psarValue = IndPool.GetPSAR(sym, tf, valStep, valMax);
         if(psarValue == 0)
            psarValue = (sl > 0) ? sl : entry;

         double rawTarget = 0.0;
         if(isBuy)
           {
            if(psarValue < currentPrice)
               rawTarget = psarValue - indentDist;
            else
               rawTarget = (sl > 0) ? sl : entry;
           }
         else
           {
            if(psarValue > currentPrice)
               rawTarget = psarValue + indentDist;
            else
               rawTarget = (sl > 0) ? sl : entry;
           }

         if(!res.isActive)
           {
            bool triggered = false;
            if(isRealPosition)
              {
               // 🛡️ MAGIA HFT: Usamos 'currentPrice' que ya discrimina Bid/Ask correctamente arriba.
               if(isBuy)
                 {
                  if(currentPrice >= res.startPrice)
                     triggered = true;
                 }
               else
                 {
                  if(currentPrice <= res.startPrice)
                     triggered = true;
                 }
              }
            if(triggered)
              {
               res.isActive = true;
               res.anchorPrice = currentPrice;
               mem.ts.anchorPrice = currentPrice;
               res.targetPrice = rawTarget;
               // MAGIA: m_trade ELIMINADO AQUÍ.
              }
            else
               res.targetPrice = rawTarget;
           }
         if(res.isActive)
            res.targetPrice = rawTarget;
         break;
        }
      case 4: // ATR
        {
         double valStart = mem.ts.inputs[0];
         int modeStart = mem.ts.units[0];
         ENUM_TIMEFRAMES tf = GetTFFromIndex(mem.ts.dropIdx[1]);
         int atrPeriod = (mem.ts.inputs[2] > 0) ? (int)mem.ts.inputs[2] : 14;
         double valCoeff = (mem.ts.inputs[3] > 0) ? mem.ts.inputs[3] : 1.5;
         int useHighLow = mem.ts.units[4];
         int forceImmediate = mem.ts.units[5];

         double atrValue = IndPool.GetATR(sym, tf, atrPeriod);
         double dist = atrValue * valCoeff;
         double basePrice = currentPrice;

         if(useHighLow == 1)
            basePrice = isBuy ? iHigh(sym, tf, 1) : iLow(sym, tf, 1);
         double rawTarget = isBuy ? basePrice - dist : basePrice + dist;
         res.targetPrice = rawTarget;

         if(forceImmediate == 0)
            res.startPrice = GetTSLevelPrice(ticket, 0, modeStart, valStart, entry, sl, tp);
         else
            res.startPrice = 0;

         if(forceImmediate == 1)
           {
            res.isActive = true;
            res.anchorPrice = currentPrice;
            mem.ts.anchorPrice = currentPrice;
           }
         else
            if(!res.isActive)
              {
               bool triggered = false;
               if(isRealPosition)
                 {
                  // 🛡️ MAGIA HFT: Usamos 'currentPrice' que ya discrimina Bid/Ask correctamente arriba.
                  if(isBuy)
                    {
                     if(currentPrice >= res.startPrice)
                        triggered = true;
                    }
                  else
                    {
                     if(currentPrice <= res.startPrice)
                        triggered = true;
                    }
                 }
               if(triggered)
                 {
                  res.isActive = true;
                  res.anchorPrice = currentPrice;
                  mem.ts.anchorPrice = currentPrice;
                  // MAGIA: m_trade ELIMINADO AQUÍ.
                 }
              }
         break;
        }
      case 5: // PARTIAL
        {
         if(mem.ts.units[0] == 0)
           {
            res.isValid = false;
            break;
           }
         int distMode = mem.grid.distMode;
         double tp1Price = GetGridLevelPrice(ticket, 1, 1, distMode, entry, sl, tp, 1, 1);
         if(tp1Price <= 0 || MathAbs(tp1Price - entry) < point)
           {
            res.isValid = false;
            break;
           }

         res.startPrice = tp1Price;
         res.targetPrice = entry;

         if(!res.isActive)
           {
            bool triggered = false;
            if(isRealPosition)
              {
               // 🛡️ MAGIA HFT: Usamos 'currentPrice' que ya discrimina Bid/Ask correctamente arriba.
               if(isBuy)
                 {
                  if(currentPrice >= res.startPrice)
                     triggered = true;
                 }
               else
                 {
                  if(currentPrice <= res.startPrice)
                     triggered = true;
                 }
              }
            if(triggered)
              {
               res.isActive = true;
               res.anchorPrice = currentPrice;
               mem.ts.anchorPrice = currentPrice;

               // MAGIA: m_trade ELIMINADO AQUÍ.
              }
           }
         if(res.isActive)
            res.targetPrice = entry;
         break;
        }
      case 6: // HI-LO
        {
         double valStart = mem.ts.inputs[0];
         int modeStart = mem.ts.units[0];
         ENUM_TIMEFRAMES tf = GetTFFromIndex(mem.ts.dropIdx[1]);
         int length = (mem.ts.inputs[2] > 0) ? (int)mem.ts.inputs[2] : 5;
         double indentDist = mem.ts.inputs[3] * mul;

         res.startPrice = GetTSLevelPrice(ticket, 0, modeStart, valStart, entry, sl, tp);
         double extremePrice = GetPriceExtreme(sym, tf, length, !isBuy);
         if(extremePrice == 0)
            extremePrice = (sl > 0) ? sl : entry;

         double rawTarget = isBuy ? extremePrice - indentDist : extremePrice + indentDist;

         if(!res.isActive)
           {
            bool triggered = false;
            if(isRealPosition)
              {
               // 🛡️ MAGIA HFT: Usamos 'currentPrice' que ya discrimina Bid/Ask correctamente arriba.
               if(isBuy)
                 {
                  if(currentPrice >= res.startPrice)
                     triggered = true;
                 }
               else
                 {
                  if(currentPrice <= res.startPrice)
                     triggered = true;
                 }
              }
            if(triggered)
              {
               res.isActive = true;
               res.anchorPrice = currentPrice;
               mem.ts.anchorPrice = currentPrice;
               res.targetPrice = rawTarget;
               // MAGIA: m_trade ELIMINADO AQUÍ.
              }
            else
               res.targetPrice = rawTarget;
           }
         if(res.isActive)
            res.targetPrice = rawTarget;
         break;
        }
     }
   return res;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
double            GetTSDistValue(ulong ticket, double entry, double sl, double tp)
  {
   CTradeState *mem = (ticket == 0) ? TemplateState : TradeRAM.Get(ticket);
   if(mem == NULL)
      return 0.0;

   string sym = (ticket == 0) ? _Symbol : mem.symbol;
   double valDist = mem.ts.inputs[1];
   int modeDist = mem.ts.units[1];
   if(valDist <= 0)
      return 0.0;

   double point = SymbolInfoDouble(sym, SYMBOL_POINT);
   double mul   = (SymbolInfoInteger(sym, SYMBOL_DIGITS)%2!=0) ? 10 * point : point;
   double distPrice = 0.0;

   if(modeDist == 0)
      distPrice = valDist * mul;
   else
      if(modeDist == 1)
        {
         double risk = MathAbs(entry - sl);
         if(risk < point)
            risk = 50 * mul;
         distPrice = risk * valDist;
        }
      else
         if(modeDist == 2)
            distPrice = entry * (valDist / 100.0);
         else
            if(modeDist == 3)
              {
               if(tp > 0)
                  distPrice = MathAbs(tp - entry) * (valDist / 100.0);
               else
                  distPrice = 20 * mul;
              }

   return distPrice;
  }


//+------------------------------------------------------------------+
//| AUXILIAR: CONVERTIR ÍNDICE VISUAL A TIMEFRAME REAL               |
//+------------------------------------------------------------------+
ENUM_TIMEFRAMES   GetTFFromIndex(int idx)
  {
// Lista basada en tu array g_tsTFs[]
   switch(idx)
     {
      case 0:
         return PERIOD_M1;
      case 1:
         return PERIOD_M2;
      case 2:
         return PERIOD_M3;
      case 3:
         return PERIOD_M4;
      case 4:
         return PERIOD_M5;
      case 5:
         return PERIOD_M6;
      case 6:
         return PERIOD_M10;
      case 7:
         return PERIOD_M12;
      case 8:
         return PERIOD_M15;
      case 9:
         return PERIOD_M20;
      case 10:
         return PERIOD_M30;
      case 11:
         return PERIOD_H1;
      case 12:
         return PERIOD_H2;
      case 13:
         return PERIOD_H3;
      case 14:
         return PERIOD_H4;
      case 15:
         return PERIOD_H6;
      case 16:
         return PERIOD_H8;
      case 17:
         return PERIOD_H12;
      case 18:
         return PERIOD_D1;
      case 19:
         return PERIOD_W1;
      case 20:
         return PERIOD_MN1;
     }
   return PERIOD_CURRENT;
  }


//+------------------------------------------------------------------+
//| OnTradeTransaction: La Secretaría (Interceptor Asíncrono)        |
//+------------------------------------------------------------------+
void              OnTradeTransaction(const MqlTradeTransaction &trans,
                                     const MqlTradeRequest &request,
                                     const MqlTradeResult &result)
  {
// ====================================================================
// 👩‍💼 LA SECRETARIA ASÍNCRONA: RECOLECTOR DE RESPUESTAS DEL BRÓKER
// ====================================================================
   if(trans.type == TRADE_TRANSACTION_REQUEST)
     {
      //PrintFormat(">>> [VIRTUAL TRACE 5 - SECRETARIA] El Bróker respondió al Request ID: %u | Retcode: %u", result.request_id, result.retcode);

      // --- 1. BUSCAR LA IDENTIDAD EN EL MAPA RAM (ADN) ---
      int map_index = -1;
      int mapSize = ArraySize(g_req_map);

      for(int i = 0; i < mapSize; i++)
        {
         if(g_req_map[i].request_id == result.request_id)
           {
            map_index = i;
            break;
           }
        }

      // --- 2. SI LA PETICIÓN ES NUESTRA (ESTABA EN EL MAPA) ---
      if(map_index >= 0)
        {
         ulong ghostTicket = g_req_map[map_index].vTicket; // Ticket Fantasma (Portador ADN)
         ulong realTicket  = g_req_map[map_index].ticket;  // Ticket Real Modificado (0 si era orden nueva)
         ENUM_ASYNC_ACTION act = g_req_map[map_index].action;

         //PrintFormat(">>> [VIRTUAL TRACE 6 - MAPEO ENCONTRADO] Acción: %d | ghostTicket: %I64u | realTicket: %I64u | MT5 Order: %I64u", act, ghostTicket, realTicket, result.order);

         // A) ÉXITO ROTUNDO O SIN CAMBIOS (El bróker aceptó la orden o modificación)
         if(result.retcode == TRADE_RETCODE_PLACED || result.retcode == TRADE_RETCODE_DONE || result.retcode == TRADE_RETCODE_NO_CHANGES)
           {
            // CASO I: Creación de Nueva Orden / Split (Trasplante de Cerebro)
            if(act == ASYNC_PLACE_BASE || act == ASYNC_PLACE_SPLIT)
              {
               ulong newMT5Ticket = result.order; // MT5 nos entrega el ticket real oficial
               if(newMT5Ticket > 0 && ghostTicket > 0)
                 {
                  CTradeState *vMem = TradeRAM.Get(ghostTicket);

                  // --- MAGIA OCO: EJECUCIÓN INMEDIATA CON ADN PERFECTO ---
                  if(vMem != NULL && vMem.isOCO)
                    {
                     ProcessOCOExecution(ghostTicket); // Usa el precio y símbolo perfectos del Fantasma
                     vMem.isOCO = false; // Lo apagamos para que no se duplique luego
                    }

                  // Inyectamos el ADN del Fantasma al Ticket Real
                  MigrateVirtualSettings(ghostTicket, newMT5Ticket);

                  // --- SENSOR 3 ---
                  CTradeState *realMem = TradeRAM.Get(newMT5Ticket);
                  //Print(">>> [TRACK BE 3] Bróker aceptó. Fantasma #", ghostTicket, " -> Real #", newMT5Ticket, " | BE en Ticket Real: ", realMem.be.isActive);

                  // Aniquilamos al Fantasma en RAM y Disco
                  if(vMem != NULL)
                     vMem.isVirtual = false;
                  DeleteVirtualOrderData(ghostTicket);

                  //Print(">>> [ASYNC] ÉXITO: Orden Nueva #", newMT5Ticket, ". ADN heredado del Fantasma #", ghostTicket);

                  // --- MAGIA: GESTIÓN DE LA FIGURA PRE-OP (ÉXITO) ---
                  if(g_pending_preop_orders > 0)
                    {
                     g_pending_preop_orders--;
                     if(g_pending_preop_orders == 0) // Ya llegaron todas las órdenes
                       {
                        if(g_failed_preop_orders == 0) // Si NINGUNA falló
                          {

                           if(m_isStopLimitMode)
                             {
                              m_isStopLimitMode = false;
                              ObjectSetInteger(m_chartId, m_btnSLim_Chart_Name, OBJPROP_BGCOLOR, C'35,35,40');
                              ObjectSetInteger(m_chartId, m_btnSLim_Chart_Name, OBJPROP_BORDER_COLOR, C'138,43,226');
                             }
                           m_linesActive = false;
                           ToggleLines(false); // AHORA SÍ, APAGAMOS LAS LÍNEAS
                           if(g_autoScreenshot)
                              TakeScreenshot("ENTRY_REAL");
                          }
                        else
                          {

                           FastUpdateFigureVisuals(); // Restaura el texto
                          }
                        ChartRedraw();
                       }
                    }
                 }
              }
            // CASO II: Modificaciones (Liberar candado HFT)
            else
               if(realTicket > 0)
                 {
                  CTradeState *mem = TradeRAM.Get(realTicket);
                  if(mem != NULL)
                    {
                     mem.async_is_waiting = false;
                     mem.async_retry_count = 0;

                     // Si era un Cierre Parcial, limpiamos el borrador
                     if(act == ASYNC_CLOSE_PARTIAL)
                        mem.draftPart = 50.0;

                     // --- ¡MAGIA! El bróker aceptó el nuevo SL/TP/Price. Pedimos repintar. ---
                     g_needsRedraw = true;
                    }
                 }
           }

         // B) RECHAZO DEL BRÓKER (Error 10016, 10004, etc.)
         else
           {
            //Print(">>> [ASYNC ERROR] El Bróker rechazó la petición. Código: ", result.retcode);


            // CASO I: Falló al crear una Orden Nueva
            if(act == ASYNC_PLACE_BASE || act == ASYNC_PLACE_SPLIT)
              {
               if(ghostTicket > 0)
                 {
                  // Si no pudo nacer, asesinar al Fantasma para que no quede basura
                  CTradeState *vMem = TradeRAM.Get(ghostTicket);
                  if(vMem != NULL)
                     vMem.isVirtual = false;
                  DeleteVirtualOrderData(ghostTicket);
                 }

               // --- MAGIA: GESTIÓN DE LA FIGURA PRE-OP (ERROR EN BRÓKER) ---
               if(g_pending_preop_orders > 0)
                 {
                  g_failed_preop_orders++;
                  g_pending_preop_orders--;
                  if(g_pending_preop_orders == 0) // Si ya terminaron de procesarse
                    {
                     FastUpdateFigureVisuals(); // Restaura el texto original
                     ChartRedraw();
                    }
                 }
              }

            // CASO II: Falló una Modificación (¡EL ROLLBACK VISUAL!)
            else
               if(realTicket > 0)
                 {
                  CTradeState *mem = TradeRAM.Get(realTicket);
                  if(mem != NULL)
                    {
                     mem.async_is_waiting = false;
                     mem.async_retry_count++;

                     // --- ROLLBACK DE INTERFAZ (Viaje en el tiempo) ---
                     if(act == ASYNC_MODIFY_SL)
                       {
                        mem.slPrice = g_req_map[map_index].old_sl;
                        mem.cmd_flags &= ~CMD_MODIFY_SL;
                       }
                     else
                        if(act == ASYNC_MODIFY_TP)
                          {
                           mem.tpPrice = g_req_map[map_index].old_tp;
                           mem.cmd_flags &= ~CMD_MODIFY_TP;
                          }
                        else
                           if(act == ASYNC_MODIFY_PRICE)
                             {
                              mem.openPrice = g_req_map[map_index].old_price;
                              // ¡CRÍTICO! Restaurar TP y SL
                              if(g_req_map[map_index].old_sl > 0)
                                 mem.slPrice = g_req_map[map_index].old_sl;
                              if(g_req_map[map_index].old_tp > 0)
                                 mem.tpPrice = g_req_map[map_index].old_tp;
                              mem.cmd_flags &= ~CMD_MODIFY_PRICE;
                             }
                           else
                              if(act == ASYNC_MODIFY_TRIGGER)
                                {
                                 mem.virtStopLimit = g_req_map[map_index].old_price;
                                }
                              else
                                 if(act == ASYNC_TOGGLE_HIDE)
                                   {
                                    mem.isHiddenActive = g_req_map[map_index].old_hide_state;
                                   }
                                 else
                                    if(act == ASYNC_MODIFY_TIME)
                                      {
                                       mem.virtExpiration = g_req_map[map_index].old_expiration;
                                      }
                                    else
                                       if(act == ASYNC_CLOSE_PARTIAL)
                                         {
                                          mem.cmd_flags &= ~CMD_CLOSE_PART;
                                         }

                     // Forzamos el refresco del gráfico para que la línea salte de vuelta
                     UpdateOpenTradesVisuals();
                     ChartRedraw();
                    }
                 }
           }

         // --- 3. LIMPIEZA DE LA RAM (Borramos la petición procesada) ---
         ArrayRemove(g_req_map, map_index, 1);
        }

      // --- 4. FALLBACK WATCHDOG (Por si algo no estaba en el mapa) ---
      ulong fallbackTicket = request.position > 0 ? request.position : request.order;
      if(fallbackTicket == 0)
         fallbackTicket = result.order;

      if(fallbackTicket > 0)
        {
         CTradeState *mem = TradeRAM.Get(fallbackTicket);
         if(mem != NULL && mem.async_is_waiting)
           {
            mem.async_is_waiting = false;
           }
        }
      return; // Cortamos ejecución. La Secretaria ya hizo su trabajo.
     }
// ... (El resto de OnTradeTransaction queda igual: ADD, UPDATE, POSITION)




// 0. RADAR DE NUEVAS OPERACIONES O CAMBIOS
   if(trans.type == TRADE_TRANSACTION_DEAL_ADD || trans.type == TRADE_TRANSACTION_ORDER_ADD ||
      trans.type == TRADE_TRANSACTION_ORDER_UPDATE || trans.type == TRADE_TRANSACTION_POSITION)
     {
      SyncAccountToMemory();
      
      // ---> ¡INYECCIÓN: ESCUDO ACTIVO INSTANTÁNEO! <---
      if(g_protect.accountLockedUntil > TimeCore.Now())
        {
         EnforceAccountLock();
        }

      // Sincronización a la velocidad de la luz
      if(trans.order > 0)
         SyncTradeWithBroker(TradeRAM.Get(trans.order));
      if(trans.position > 0)
         SyncTradeWithBroker(TradeRAM.Get(trans.position));
     }
// 1. ÓRDENES QUE SE CONVIERTEN EN POSICIÓN (Ej. Limit -> Posición)
// 1. ÓRDENES QUE SE CONVIERTEN EN POSICIÓN O POSICIONES QUE MUEREN (REVERSE)
   if(trans.type == TRADE_TRANSACTION_DEAL_ADD)
     {
      ulong dealTicket = trans.deal;
      if(HistoryDealSelect(dealTicket))
        {
         long dealEntry = HistoryDealGetInteger(dealTicket, DEAL_ENTRY);
         ulong posID = HistoryDealGetInteger(dealTicket, DEAL_POSITION_ID);
         ulong orderTk = HistoryDealGetInteger(dealTicket, DEAL_ORDER);

         // A) POSICIÓN QUE MUERE (DEAL_ENTRY_OUT) -> ¡REVERSE!
         if(dealEntry == DEAL_ENTRY_OUT)
           {
            CTradeState *deadMem = TradeRAM.Get(posID);
            if(deadMem != NULL && deadMem.pending_reverse)
              {
               deadMem.pending_reverse = false; // Consumimos la bandera
               string sym = deadMem.symbol;

               // Magia MT5: Si la posición original era BUY, el deal OUT es SELL.
               // La nueva posición Reverse debe ser SELL. ¡Usamos el mismo tipo del deal!
               long newType = HistoryDealGetInteger(dealTicket, DEAL_TYPE);

               double ask = SymbolInfoDouble(sym, SYMBOL_ASK);
               double bid = SymbolInfoDouble(sym, SYMBOL_BID);
               double newPrice = (newType == DEAL_TYPE_BUY) ? ask : bid;

               // Calculamos precios espejos (Invertidos)
               double newSL = 0, newTP = 0;
               if(deadMem.reverse_sl_dist > 0)
                  newSL = (newType == DEAL_TYPE_BUY) ? newPrice - deadMem.reverse_sl_dist : newPrice + deadMem.reverse_sl_dist;
               if(deadMem.reverse_tp_dist > 0)
                  newTP = (newType == DEAL_TYPE_BUY) ? newPrice + deadMem.reverse_tp_dist : newPrice - deadMem.reverse_tp_dist;

               int dig = (int)SymbolInfoInteger(sym, SYMBOL_DIGITS);

               // --- 1. Crear el Ticket Fantasma ---
               ulong ghostTk = VIRTUAL_TICKET_BASE + (++g_virtualCounter);
               CTradeState *ghostMem = TradeRAM.Get(ghostTk, sym);
               ghostMem.isVirtual = true;

               // --- INYECCIÓN DE IDENTIDAD REVERSE (LA CURA) ---
               ghostMem.virtType  = (ENUM_ORDER_TYPE)newType;
               ghostMem.virtEntry = newPrice;
               ghostMem.virtLot   = deadMem.reverse_vol;
               ghostMem.virtSL    = newSL;
               ghostMem.virtTP    = newTP;

               // --- 2. Clonar ADN (Colores, Grid, TS, BE, Hide) ---
               MigrateVirtualSettings(posID, ghostTk);

               // --- 2.1 REARMAR SEGUROS (MAGIA) ---
               ghostMem.ts.anchorPrice = 0; // Limpiamos la memoria de rastreo del TS
               // Revivimos el BE y TS si el panel los tenía encendidos por estrategia
               if(m_isBEActive)
                  ghostMem.be.isActive = true;
               if(m_isTSActive)
                  ghostMem.ts.isActive = true;

               // Inyectar precios espejos si estábamos en modo Hide
               if(ghostMem.isHiddenActive)
                 {
                  ghostMem.virtualSL = NormalizeDouble(newSL, dig);
                  ghostMem.virtualTP = NormalizeDouble(newTP, dig);
                 }

               // --- 3. RECONSTRUCCIÓN INTELIGENTE DEL ADN (El Espejo) ---
               // TS y BE usan medidas relativas (Pips, RR, %), por lo que el clon
               // exacto ya es simétrico y perfecto. NO los tocamos.

               // Para el GRID, evaluamos el Modo de Distancia original:
               int oldGridMode = deadMem.grid.distMode;

               if(oldGridMode == 1) // 1 = MODE_PRICE (Precios Absolutos)
                 {
                  // ¡Peligro! Si era Buy TP en 1.1550, en Sell no sirve.
                  // Convertimos las distancias absolutas a Pips y cambiamos el modo a PIPS (0)
                  ghostMem.grid.distMode = 0;

                  // Rescatamos el precio de apertura que tenía la operación muerta
                  double oldEntry = deadMem.openPrice;
                  double point = SymbolInfoDouble(sym, SYMBOL_POINT);
                  int digits_sym = (int)SymbolInfoInteger(sym, SYMBOL_DIGITS);
                  double mul = (digits_sym%2!=0) ? 10 * point : point;

                  for(int k=0; k<5; k++)
                    {
                     // Convertir TP absoluto a Pips
                     if(ghostMem.grid.rows[k].isActiveTP && ghostMem.grid.rows[k].valTP_Price > 0)
                       {
                        double oldP = ghostMem.grid.rows[k].valTP_Price;
                        ghostMem.grid.rows[k].valTP_Price = MathAbs(oldP - oldEntry) / mul;
                       }
                     // Convertir SL absoluto a Pips
                     if(ghostMem.grid.rows[k].isActiveSL && ghostMem.grid.rows[k].valSL_Price > 0)
                       {
                        double oldP = ghostMem.grid.rows[k].valSL_Price;
                        ghostMem.grid.rows[k].valSL_Price = MathAbs(oldP - oldEntry) / mul;
                       }
                    }
                 }
               else
                 {
                  // Si era AUTO (3), RR (2) o PIPS (0), se queda exactamente igual.
                  // La geometría es relativa y se adaptará sola a la nueva orden.
                  ghostMem.grid.distMode = oldGridMode;
                 }

               // --- 4. Armar y Disparar Petición Libre de Margen ---
               MqlTradeRequest req;
               ZeroMemory(req);
               req.action = TRADE_ACTION_DEAL;
               req.symbol = sym;
               req.volume = deadMem.reverse_vol;
               req.type   = (ENUM_ORDER_TYPE)newType;
               req.price  = newPrice;
               req.sl     = ghostMem.isHiddenActive ? 0 : NormalizeDouble(newSL, dig);
               req.tp     = ghostMem.isHiddenActive ? 0 : NormalizeDouble(newTP, dig);
               req.deviation = 20;
               req.magic  = MAGIC_NUM; // Mantenemos el Magic Number (Regla acordada)
               req.comment = "Rev #" + IntegerToString(posID);

               long fill = SymbolInfoInteger(sym, SYMBOL_FILLING_MODE);
               req.type_filling = ((fill & SYMBOL_FILLING_FOK) != 0) ? ORDER_FILLING_FOK : (((fill & SYMBOL_FILLING_IOC) != 0) ? ORDER_FILLING_IOC : ORDER_FILLING_RETURN);

               PushAsyncRequest(req, 0, ghostTk, ASYNC_PLACE_BASE);
               //Print(">>> [REVERSE] Posición muerta. Margen liberado. Disparando nueva orden asíncrona.");
              }
           }

         // B) ORDEN PENDIENTE QUE SE EJECUTA (DEAL_ENTRY_IN) -> Nace una Posición Viva
         else
            if(dealEntry == DEAL_ENTRY_IN)
              {
               if(orderTk > 0 && posID > 0)
                 {
                  MigrateTradeSettings(orderTk, posID);

                  // --- SENSOR 4 ---
                  CTradeState *posMem = TradeRAM.Get(posID);
                  //Print(">>> [TRACK BE 4] DEAL_IN. Orden #", orderTk, " -> Posición #", posID, " | BE en Posición: ", posMem.be.isActive);

                  CTradeState *pMem = TradeRAM.Get(posID);
                  if(pMem != NULL && pMem.isOCO)
                    {
                     ProcessOCOExecution(orderTk); // Ejecuta con el ticket de la orden original

                     pMem.isOCO = false; // Apaga el OCO en la posición viva

                     // Higiene: Apaga el OCO en el recuerdo de la orden pendiente también
                     CTradeState *oMem = TradeRAM.Get(orderTk);
                     if(oMem != NULL)
                        oMem.isOCO = false;

                     SaveTradesToBin();
                     g_needsRedraw = true;
                    }
                 }
              }
        }
     }

// 2. STOP LIMITS QUE SE CONVIERTEN EN LIMITS (El Puente Genealógico)
   if(trans.type == TRADE_TRANSACTION_ORDER_ADD)
     {
      ulong newOrderTicket = trans.order;
      if(OrderSelect(newOrderTicket))
        {
         long type = OrderGetInteger(ORDER_TYPE);

         // Si acaba de nacer un Limit, podría venir de un Stop Limit
         if(type == ORDER_TYPE_BUY_LIMIT || type == ORDER_TYPE_SELL_LIMIT)
           {
            CheckAndMigrateStopLimit(newOrderTicket); // Llamamos al buscador de ADN
           }
        }
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              CheckAndMigrateStopLimit(ulong newLimitTicket)
  {
   if(!OrderSelect(newLimitTicket))
      return;

   double newLimitPrice = NormalizeDouble(OrderGetDouble(ORDER_PRICE_OPEN), _Digits);
   int memTotal = TradeRAM.Total();

// Recorremos la RAM buscando la orden original (el Stop Limit que acaba de evolucionar)
   for(int i = 0; i < memTotal; i++)
     {
      CTradeState *mem = TradeRAM.GetByIndex(i);
      if(CheckPointer(mem) == POINTER_INVALID || mem.ticket == newLimitTicket)
         continue;

      // Si este ticket tenía un precio de ejecución guardado (DNA) que coincide con el nuevo Limit... ¡BINGO!
      if(mem.virtStopLimit > 0 && MathAbs(newLimitPrice - mem.virtStopLimit) < Point())
        {
         ulong oldTicket = mem.ticket;

         // Traspasamos toda la memoria al nuevo Limit
         MigrateTradeSettings(oldTicket, newLimitTicket);

         // Borramos la huella para no usarla dos veces
         mem.virtStopLimit = 0;
         SaveTradesToBin();
         break;
        }
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              MigrateTradeSettings(ulong oldTicket, ulong newTicket)
  {
   if(oldTicket == newTicket)
      return;

   CTradeState *oldMem = TradeRAM.Get(oldTicket);
   CTradeState *newMem = TradeRAM.Get(newTicket);

   if(oldMem == NULL || newMem == NULL)
      return;

// 1. MIGRACIÓN 100% EN RAM
   newMem.panelX         = oldMem.panelX; // <--- LA HERENCIA VISUAL INYECTADA
   newMem.customComment  = oldMem.customComment;
   newMem.isHiddenActive = oldMem.isHiddenActive;
   newMem.virtualTP      = oldMem.virtualTP;
   newMem.virtualSL      = oldMem.virtualSL;

// --- FIX: HEREDAR EL TRAILING LIMIT Y EL CANCEL ---
   newMem.cancelPrice        = oldMem.cancelPrice;
   newMem.isTrailLimitActive = oldMem.isTrailLimitActive;
   newMem.trailLimitDist     = oldMem.trailLimitDist;
   newMem.isOCO              = oldMem.isOCO; // <--- ¡AQUÍ ESTÁ LA CURA DE LA AMNESIA!

   newMem.ts             = oldMem.ts;
   newMem.be             = oldMem.be;
   newMem.grid           = oldMem.grid;
   newMem.customColor    = oldMem.customColor;

   SaveTradesToBin();
  }

//+------------------------------------------------------------------+
//| HELPER: Traductor rápido de símbolos de divisa (O(1))            |
//+------------------------------------------------------------------+
string GetCurrencySymbol(string currency)
  {
   if(currency == "USD" || currency == "AUD" || currency == "CAD" || currency == "NZD" || currency == "SGD")
      return "$";
   if(currency == "EUR")
      return "€";
   if(currency == "GBP")
      return "£";
   if(currency == "JPY")
      return "¥";
   if(currency == "CHF")
      return "₣";
   return ""; // Fallback elegante para otras divisas
  }

//+------------------------------------------------------------------+
//| ORÁCULO DE TEXTO: La única fuente de verdad para el botón Base   |
//+------------------------------------------------------------------+
string GetOrderBaseText(CTradeState *mem, bool esPosicion, long type, double vol, double entry)
  {
   if(mem == NULL)
      return "";

// 1. Determinar el Tipo en Texto
   string typeStr = "";
   if(esPosicion)
     {
      typeStr = (type == POSITION_TYPE_BUY) ? "Buy" : "Sell";
     }
   else
     {
      if(type == ORDER_TYPE_BUY_STOP_LIMIT)
         typeStr = "Buy StopLim";
      else
         if(type == ORDER_TYPE_SELL_STOP_LIMIT)
            typeStr = "Sell StopLim";
         else
            if(type == ORDER_TYPE_BUY_LIMIT)
               typeStr = "Buy Limit";
            else
               if(type == ORDER_TYPE_SELL_LIMIT)
                  typeStr = "Sell Limit";
               else
                  if(type == ORDER_TYPE_BUY_STOP)
                     typeStr = "Buy Stop";
                  else
                     if(type == ORDER_TYPE_SELL_STOP)
                        typeStr = "Sell Stop";
                     else
                        typeStr = "Order";
     }

   int dig = (int)SymbolInfoInteger(mem.symbol, SYMBOL_DIGITS);
   string baseTxt = "";

// 2. Construir el texto según el estado (Dinero fluctuante vs Estático)
   if(esPosicion && !mem.isVirtual)
     {
      // Consultamos el Profit real al bróker
      double profit = 0;
      if(PositionSelectByTicket(mem.ticket))
        {
         profit = PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP) + GetPositionCommission(mem.ticket);
        }

      string accCurrency = AccountInfoString(ACCOUNT_CURRENCY);
      string currSym     = GetCurrencySymbol(accCurrency);
      string sign        = (profit >= 0) ? "+" : "-";
      double absProf     = MathAbs(profit);

      // Formato Institucional: Buy | 0.50 | +$15.50 USD | 1.1585
      baseTxt = StringFormat("%s | %.2f | %s%s%.2f %s | %s",
                             typeStr, vol, sign, currSym, absProf, accCurrency, DoubleToString(entry, dig));
     }
   else
     {
      // Órdenes Pendientes o Virtuales (No hay P/L fluctuante aún)
      // Formato: Buy Limit | 0.50 | 1.1585
      baseTxt = StringFormat("%s | %.2f | %s", typeStr, vol, DoubleToString(entry, dig));
     }

// 3. Modificadores de Estado (Prefijos y Sufijos)
   if(mem.isVirtual)
      baseTxt = "[V] " + baseTxt;

   if(mem.isCollapsed)
      baseTxt += " [+]";

   return baseTxt;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              DibujarPanelUnico(ulong ticket, bool esPosicion)
  {
   if(m_linesActive && ticket > 0)
      return;
// --- A. VARIABLES COMUNES ---
   double entry, sl, tp, vol, profit;
   long type;
   string symbol;
   double priceForPanel = 0.0;
   double stopLimitPrice = 0.0;
   string sT = IntegerToString(ticket);


   CTradeState *mem = NULL;

   if(m_linesActive && ticket > 0)
      return;

// --- B. LLENADO DE DATOS (Usando Motor Unificado) ---
   if(!GetUnifiedTradeInfo(ticket, entry, sl, tp, vol, type, mem))
      return;

// --- ESCUDO ANTI-CRASH ---
   if(CheckPointer(mem) == POINTER_INVALID)
      return;


   symbol = mem.symbol;
   if(symbol != _Symbol)
      return;

   if(ticket > 0 && !esPosicion && (type == ORDER_TYPE_BUY_STOP_LIMIT || type == ORDER_TYPE_SELL_STOP_LIMIT))
     {
      if(mem.isVirtual)
        {
         stopLimitPrice = mem.virtStopLimit; // Gatillo Virtual
        }
      else
        {
         // --- ESCUDO OPTIMISTA ---
         // Si la orden viaja asíncronamente, leemos la mentira de la RAM para que la línea no salte.
         // En cuanto el bróker responda, async_is_waiting será false y leerá la verdad.
         if(mem.async_is_waiting && mem.virtStopLimit > 0)
           {
            stopLimitPrice = mem.virtStopLimit;
           }
         else
            if(OrderSelect(ticket))
              {
               stopLimitPrice = OrderGetDouble(ORDER_PRICE_OPEN); // Gatillo Real de MT5
              }
        }
     }
   else
      if(ticket == 0 && m_isStopLimitMode)
        {
         if(ObjectFind(0, m_lineStopLimit) >= 0)
            stopLimitPrice = ObjectGetDouble(0, m_lineStopLimit, OBJPROP_PRICE);

        }




// Configurar profit solo si es una posición viva y real
   profit = 0;
   if(esPosicion && !mem.isVirtual)
      profit = PositionGetDouble(POSITION_PROFIT);

   priceForPanel = entry;

// ====================================================================
// CÁLCULO DE POSICIÓN X INDEPENDIENTE (CON LÍMITES ESTRICTOS)
// ====================================================================
   int chartW = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);
   int defaultX = chartW - 300;
   int maxAllowableX = chartW - TM_FIGURE_WIDTH; // Límite derecho

// Si la memoria tiene una posición guardada, la usamos
   if(mem.panelX != -1) // <--- FIX: Ya no preguntamos si es > 0, sino distinto de -1
     {
      // Límites de seguridad
      if(mem.panelX > maxAllowableX)
         mem.panelX = maxAllowableX;
      if(mem.panelX < 0)
         mem.panelX = 0;
     }
   else
     {
      // Si es -1 (orden recién abierta), le asignamos el default
      mem.panelX = defaultX;
     }

   int myPanelX = mem.panelX;
// ====================================================================

// --- 1. DECLARACIÓN DE VARIABLES (ESTO SOLUCIONA LOS ERRORES) ---
   string prefix     = "TM_UI_" + IntegerToString(ticket);
   string prefixMenu = prefix; // Definimos prefixMenu aquí para que exista abajo

// --- 2. FUENTE DE LA VERDAD (SOLUCIONA 'tp' y 'sl') ---
   bool isHidden = mem.isHiddenActive;

   if(isHidden)
     {
      tp = mem.virtualTP;
      sl = mem.virtualSL;
     }

// Leemos directo de la RAM, sin tocar el disco duro
   bool isMenuOpen = mem.isMenuOpen;

// --- 4. CÁLCULO DE COORDENADAS (Usando los 'tp' y 'sl' ya procesados) ---
   int x, yEntry, ySL, yTP;
   ChartTimePriceToXY(0, 0, TimeCurrent(), entry, x, yEntry);

   if(sl > 0)
      ChartTimePriceToXY(0, 0, TimeCurrent(), sl, x, ySL);
   else
      ySL = yEntry;

   if(tp > 0)
      ChartTimePriceToXY(0, 0, TimeCurrent(), tp, x, yTP);
   else
      yTP = yEntry;

// Definimos si es tipo "Compra" (Posición u Orden)
   bool isBuyDir = (type == POSITION_TYPE_BUY ||
                    type == ORDER_TYPE_BUY_LIMIT ||
                    type == ORDER_TYPE_BUY_STOP ||
                    type == ORDER_TYPE_BUY_STOP_LIMIT);

// --- FIX: POSICIÓN INTELIGENTE DEL PANEL ---
// Si es BUY, el panel se dibuja desde la línea hacia abajo (yEntry).
// Si es SELL, el panel se dibuja desde la línea hacia arriba (yEntry - BTN_HEIGHT).
   int yEntryVis = isBuyDir ? yEntry : (yEntry - BTN_HEIGHT);

// Regla: "Hacia afuera".
// Si es Buy TP (Arriba) o Sell SL (Arriba) . Restamos altura para que el botón quede encima.
// Si es Buy SL (Abajo) o Sell TP (Abajo) . Dejamos la Y tal cual para que quede debajo.

   int yTPVis = isBuyDir ? (yTP - BTN_HEIGHT) : yTP;
   int ySLVis = isBuyDir ? ySL : (ySL - BTN_HEIGHT);

// --- 5. ESTILOS VISUALES TRADING VIEW ---
   color colorRectTP = C'206,235,230'; // Fondo TP Suave
   color colorRectSL = C'252,214,218'; // Fondo SL Suave
   color colorLineTP = C'8,153,129';   // Verde TV Fuerte
   color colorLineSL = C'242,54,69';   // Rojo TV Fuerte
   color entryColor = clrNONE;


// Borde: Si es oculto, usamos el color del área para el marco. Si no, Flat.
   color borderColTP = isHidden ? colorRectTP : clrNONE;
   color borderColSL = isHidden ? colorRectSL : clrNONE;

// --- DIBUJAR PANEL PRINCIPAL (NUEVO FORMATO TV) ---
   string typeStr = "";
   color entryBorderColor = clrNONE;

   if(esPosicion)
     {
      typeStr = (type == POSITION_TYPE_BUY) ? "Buy" : "Sell";
      entryBorderColor = (type == POSITION_TYPE_BUY) ? colorLineTP : colorLineSL;
     }
   else
     {
      if(type == ORDER_TYPE_BUY_STOP_LIMIT)
        {
         typeStr = "Buy StopLim";
         entryBorderColor = C'100,50,200';
        }
      else
         if(type == ORDER_TYPE_SELL_STOP_LIMIT)
           {
            typeStr = "Sell StopLim";
            entryBorderColor = C'200,50,150';
           }
         else
            if(type == ORDER_TYPE_BUY_LIMIT)
              {
               typeStr = "Buy Limit";
               entryBorderColor = colorLineTP;
              }
            else
               if(type == ORDER_TYPE_SELL_LIMIT)
                 {
                  typeStr = "Sell Limit";
                  entryBorderColor = colorLineSL;
                 }
               else
                  if(type == ORDER_TYPE_BUY_STOP)
                    {
                     typeStr = "Buy Stop";
                     entryBorderColor = colorLineTP;
                    }
                  else
                     if(type == ORDER_TYPE_SELL_STOP)
                       {
                        typeStr = "Sell Stop";
                        entryBorderColor = colorLineSL;
                       }
                     else
                       {
                        typeStr = "Order";
                        entryBorderColor = C'100,100,100';
                       }
     }

// --- MAGIA: EL ORÁCULO DE TEXTO (Única Fuente de Verdad) ---
   string txtEntry = GetOrderBaseText(mem, esPosicion, type, vol, entry);

   if(mem.customColor != clrNONE)
      entryBorderColor = mem.customColor;

   bool isCollapsed = mem.isCollapsed; // Mantenemos la variable porque la usas más abajo

//DrawButton(prefix + "_BtnEntry", myPanelX, yEntryVis, txtEntry, entryColor);

// Botón "..."
// --- A. CÁLCULO DE ANCHOS ---
   int widthEntry = TM_FIGURE_WIDTH;
   int xMoveBtn   = 0;
   int xCancelBtn = 0; // NUEVO
   int xMenuBtn   = myPanelX + TM_FIGURE_WIDTH - BTN_MENU_W; // Menú siempre a la derecha

   if(!esPosicion)
     {
      // Restamos ancho de menu, move y cancel
      widthEntry = TM_FIGURE_WIDTH - BTN_MENU_W - BTN_MOVE_W - BTN_CANCEL_W;
      xMoveBtn   = xMenuBtn - BTN_MOVE_W;
      xCancelBtn = xMoveBtn - BTN_CANCEL_W; // El botón C va antes del Move
     }
   else
     {
      widthEntry = TM_FIGURE_WIDTH - BTN_MENU_W;
     }

// --- B. DIBUJAR BOTÓN ENTRY (Horizontal) ---
   string nameEntry = MakeTMName(ticket, OP_TM_ENTRY);
   DrawButton(nameEntry, myPanelX, yEntryVis, txtEntry, ARGBToColor(Theme.surface));
   SmartSetInteger(nameEntry, OBJPROP_XSIZE, widthEntry);
   SmartSetInteger(nameEntry, OBJPROP_BORDER_COLOR, entryBorderColor);
   SmartSetInteger(nameEntry, OBJPROP_COLOR, ARGBToColor(Theme.textMain));

   mem.vis_base_spawned = true; // <--- INYECCIÓN FASE 2

// Línea invisible de arrastre de la Entrada
   string nameHLineEntry = MakeTMName(ticket, OP_HLINE_ENTRY);
   UpdateInvisibleLine(nameHLineEntry, priceForPanel, entryColor, 6);

// --- C. DIBUJAR BOTÓN MOVE (Vertical - Solo Órdenes) ---
   string nameMove = MakeTMName(ticket, OP_TM_MOVE);
   if(!esPosicion)
     {
      DrawButton(nameMove, xMoveBtn, yEntryVis, "↕", ARGBToColor(Theme.surface));
      SmartSetInteger(nameMove, OBJPROP_XSIZE, BTN_MOVE_W);
      SmartSetInteger(nameMove, OBJPROP_ZORDER, 15);
      SmartSetInteger(nameMove, OBJPROP_BORDER_COLOR, entryBorderColor);
     }
   else
      ObjectDelete(0, nameMove);

// --- NUEVO: BOTÓN CANCEL (Solo Órdenes Pendientes) ---
   string nameCancelTog = MakeTMName(ticket, OP_TM_CANCEL_TOGGLE);
   if(!esPosicion)
     {
      color cBg  = (mem.cancelPrice > 0) ? ARGBToColor(Theme.accent) : ARGBToColor(Theme.surface);
      color cTxt = (mem.cancelPrice > 0) ? ARGBToColor(Theme.bg) : ARGBToColor(Theme.textDim);

      DrawButton(nameCancelTog, xCancelBtn, yEntryVis, "C", cBg);
      SmartSetInteger(nameCancelTog, OBJPROP_XSIZE, BTN_CANCEL_W);
      SmartSetInteger(nameCancelTog, OBJPROP_ZORDER, 15);
      SmartSetInteger(nameCancelTog, OBJPROP_BORDER_COLOR, entryBorderColor);
      SmartSetInteger(nameCancelTog, OBJPROP_COLOR, cTxt);
     }
   else
      ObjectDelete(0, nameCancelTog);

// --- BOTÓN SECUNDARIO (STOP LIMIT) ---
   string nameSec = (ticket == 0) ? m_btnSec_Name : MakeTMName(ticket, OP_TM_SEC);
   string nameHLineSec = (ticket == 0) ? m_lineStopLimit : MakeTMName(ticket, OP_HLINE_SEC);

   bool showSec = false;
   if(ticket > 0 && !esPosicion && (type == ORDER_TYPE_BUY_STOP_LIMIT || type == ORDER_TYPE_SELL_STOP_LIMIT))
      showSec = true;
   if(ticket == 0 && m_isStopLimitMode)
      showSec = true;


// --. AÑADE ESTA REGLA PARA OCULTARLO AL COLAPSAR <---
   if(ticket > 0 && isCollapsed)
      showSec = false;

   if(showSec)
     {
      mem.vis_sec_spawned = true; // <--- INYECCIÓN FASE 2: Stop Limit Vivo
      ////Print(">>> [DEBUG DRAW] showSec = TRUE. Intentando dibujar en precio: ", stopLimitPrice);
      int xSec = 0, ySec = 0;

      if(stopLimitPrice > 0 && ChartTimePriceToXY(0, 0, TimeCurrent(), stopLimitPrice, xSec, ySec))
        {
         ////Print(">>> [DEBUG DRAW] Coordenadas en pantalla calculadas OK. Y: ", ySec);
         bool isAboveSec = (stopLimitPrice > entry);
         int ySecVis = isAboveSec ? (ySec - BTN_HEIGHT) : (ySec + 1);
         color colBorderSec = entryBorderColor; // AHORA: Hereda el color central

         // 1. Botón estilo oscuro (como los del centro)
         DrawButton(nameSec, myPanelX, ySecVis, "Stop Limit", ARGBToColor(Theme.surface));
         SmartSetInteger(nameSec, OBJPROP_XSIZE, widthEntry);
         SmartSetInteger(nameSec, OBJPROP_ZORDER, 14);
         SmartSetInteger(nameSec, OBJPROP_FONTSIZE, 8);
         SmartSetInteger(nameSec, OBJPROP_BORDER_COLOR, colBorderSec); // Borde morado

         // 2. Línea Visual Punteada
         string visLineSec = nameSec + "_VisLine";
         if(ObjectFind(0, visLineSec) < 0)
           {
            ObjectCreate(0, visLineSec, OBJ_RECTANGLE_LABEL, 0, 0, 0);
            SmartSetInteger(visLineSec, OBJPROP_CORNER, CORNER_LEFT_UPPER);
            SmartSetInteger(visLineSec, OBJPROP_YSIZE, 1);
            SmartSetInteger(visLineSec, OBJPROP_BACK, false);
            SmartSetInteger(visLineSec, OBJPROP_ZORDER, 10);
            SmartSetInteger(visLineSec, OBJPROP_BORDER_TYPE, BORDER_FLAT);
            SmartSetInteger(visLineSec, OBJPROP_STYLE, STYLE_DOT);
           }
         SmartSetInteger(visLineSec, OBJPROP_XSIZE, TM_FIGURE_WIDTH);
         SmartSetInteger(visLineSec, OBJPROP_XDISTANCE, myPanelX);
         SmartSetInteger(visLineSec, OBJPROP_YDISTANCE, ySec);
         SmartSetInteger(visLineSec, OBJPROP_BGCOLOR, clrNONE);
         SmartSetInteger(visLineSec, OBJPROP_COLOR, colBorderSec);

         // 3. Línea invisible para detectar el arrastre y que se ilumine
         UpdateInvisibleLine(nameHLineSec, stopLimitPrice, colBorderSec, 7);
        }
      else
        {
         ////Print(">>> [DEBUG DRAW] ERROR: No se pudo calcular XY o el precio es 0");
        }
     }
   else
     {
      mem.vis_sec_spawned = false;
      ObjectDelete(0, nameSec);
      ObjectDelete(0, nameHLineSec);
      ObjectDelete(0, nameSec + "_VisLine");
     }

// --- NUEVO: LÍNEA Y ETIQUETA DE CANCELACIÓN VISUAL ---
   string nameCancelLbl   = MakeTMName(ticket, OP_TM_CANCEL_LBL);
   string nameHLineCancel = MakeTMName(ticket, OP_HLINE_CANCEL);

   if(!esPosicion && !isCollapsed && mem.cancelPrice > 0)
     {
      mem.vis_canc_spawned = true;
      int xCanc=0, yCanc=0;
      if(ChartTimePriceToXY(0, 0, TimeCurrent(), mem.cancelPrice, xCanc, yCanc))
        {
         bool isAboveCanc = (mem.cancelPrice > entry);
         int yCancVis = isAboveCanc ? (yCanc - BTN_HEIGHT) : (yCanc + 1);
         color colCanc = entryBorderColor; // AHORA: Hereda el color central

         DrawButton(nameCancelLbl, myPanelX, yCancVis, "Cancel Order", ARGBToColor(Theme.surface));
         SmartSetInteger(nameCancelLbl, OBJPROP_XSIZE, widthEntry);
         SmartSetInteger(nameCancelLbl, OBJPROP_ZORDER, 14);
         SmartSetInteger(nameCancelLbl, OBJPROP_FONTSIZE, 8);
         SmartSetInteger(nameCancelLbl, OBJPROP_BORDER_COLOR, colCanc);

         string visLineCanc = nameCancelLbl + "_VisLine";
         if(ObjectFind(0, visLineCanc) < 0)
           {
            ObjectCreate(0, visLineCanc, OBJ_RECTANGLE_LABEL, 0, 0, 0);
            SmartSetInteger(visLineCanc, OBJPROP_CORNER, CORNER_LEFT_UPPER);
            SmartSetInteger(visLineCanc, OBJPROP_YSIZE, 1);
            SmartSetInteger(visLineCanc, OBJPROP_BACK, false);
            SmartSetInteger(visLineCanc, OBJPROP_ZORDER, 10);
            SmartSetInteger(visLineCanc, OBJPROP_BORDER_TYPE, BORDER_FLAT);
            SmartSetInteger(visLineCanc, OBJPROP_STYLE, STYLE_DOT);
           }
         SmartSetInteger(visLineCanc, OBJPROP_XSIZE, TM_FIGURE_WIDTH);
         SmartSetInteger(visLineCanc, OBJPROP_XDISTANCE, myPanelX);
         SmartSetInteger(visLineCanc, OBJPROP_YDISTANCE, yCanc);
         SmartSetInteger(visLineCanc, OBJPROP_BGCOLOR, clrNONE);
         SmartSetInteger(visLineCanc, OBJPROP_COLOR, colCanc);

         // Línea invisible para el futuro arrastre (Fase 2)
         UpdateInvisibleLine(nameHLineCancel, mem.cancelPrice, colCanc, 15);
        }
     }
   else
     {
      mem.vis_canc_spawned = false;
      ObjectDelete(0, nameCancelLbl);
      ObjectDelete(0, nameHLineCancel);
      ObjectDelete(0, nameCancelLbl + "_VisLine");
     }

// --- D. DIBUJAR BOTÓN MENÚ (...) ---
   string nameMenu = MakeTMName(ticket, OP_TM_MENU);
   DrawButton(nameMenu, xMenuBtn, yEntryVis, "...", ARGBToColor(Theme.surface));
   SmartSetInteger(nameMenu, OBJPROP_XSIZE, BTN_MENU_W);
   SmartSetInteger(nameMenu, OBJPROP_BORDER_COLOR, entryBorderColor);
   SmartSetInteger(nameMenu, OBJPROP_COLOR, ARGBToColor(Theme.textMain));

// --- DATOS MATEMÁTICOS PARA TEXTOS TV ---
   double point    = Market.point;
   int dig     = Market.digits;
   double mul      = Market.multiplier;
   double tickVal  = Market.tickValue;
   double tickSize = Market.tickSize;
   string cur = AccountInfoString(ACCOUNT_CURRENCY);
   double currentPrice = isBuyDir ? SymbolInfoDouble(symbol, SYMBOL_BID) : SymbolInfoDouble(symbol, SYMBOL_ASK);

// --- DIBUJAR TP/SL (LÓGICA ACTUALIZADA TRADINGVIEW) ---
   string nameBtnTP   = MakeTMName(ticket, OP_TM_TP);
   string nameRectTP  = MakeTMName(ticket, OP_TM_RECT_TP);
   string nameHLineTP = MakeTMName(ticket, OP_HLINE_TP); // <-- FIX BITWISE

   string nameBtnSL   = MakeTMName(ticket, OP_TM_SL);
   string nameRectSL  = MakeTMName(ticket, OP_TM_RECT_SL);
   string nameHLineSL = MakeTMName(ticket, OP_HLINE_SL); // <-- FIX BITWISE

   if(!isCollapsed)
     {
      // --- TAKE PROFIT ---
      if(tp > 0)
        {
         mem.vis_tp_spawned = true;
         // 1. Cálculos TP
         double distTP = MathAbs(entry - tp) / mul;
         double moneyTP = (tickSize > 0) ? (MathAbs(entry - tp) / tickSize) * tickVal * vol : 0;
         double progTP = 0;
         if(MathAbs(tp - entry) > point)
           {
            double currDist = isBuyDir ? (currentPrice - entry) : (entry - currentPrice);
            progTP = (currDist / MathAbs(tp - entry)) * 100.0;
            if(progTP < 0)
               progTP = 0;
            if(progTP > 100)
               progTP = 100;
           }
         string txtTP = StringFormat("TP %.0f | %.2f %s | %.2f%% | %s", distTP, moneyTP, cur, progTP, DoubleToString(tp, dig));

         // 2. Dibujar visuales
         UpdateInvisibleLine(nameHLineTP, tp, colorLineTP, 2);
         DrawRect(nameRectTP, myPanelX, yEntry, yTP, colorRectTP);
         SmartSetInteger(nameRectTP, OBJPROP_BGCOLOR, colorRectTP);
         SmartSetInteger(nameRectTP, OBJPROP_BORDER_COLOR, borderColTP);

         DrawButton(nameBtnTP, myPanelX, yTPVis, txtTP, colorLineTP);
         SmartSetInteger(nameBtnTP, OBJPROP_XSIZE, TM_FIGURE_WIDTH); // <--- AÑADIDO: Ancho fijo de 200px
         SmartSetInteger(nameBtnTP, OBJPROP_ALIGN, ALIGN_CENTER);
         SmartSetInteger(nameBtnTP, OBJPROP_BORDER_COLOR, C'211,211,211');

         if(isHidden)
           {
            SmartSetInteger(nameBtnTP, OBJPROP_BGCOLOR, clrNONE);
            SmartSetInteger(nameBtnTP, OBJPROP_COLOR, colorLineTP);
           }
         else
           {
            SmartSetInteger(nameBtnTP, OBJPROP_BGCOLOR, colorLineTP);
            SmartSetInteger(nameBtnTP, OBJPROP_COLOR, clrWhite); // <--- AÑADIDO: Texto siempre blanco
           }
        }

      else
        {
         mem.vis_tp_spawned = false;
         // 1. Limpieza de botones y rectángulos si está colapsado
         ObjectDelete(0, nameRectTP);
         ObjectDelete(0, nameRectSL);
         ObjectDelete(0, nameBtnTP);
         ObjectDelete(0, nameBtnSL);

         // 2. ACTUALIZACIÓN: Mantener las líneas maestras invisibles VIVAS para el arrastre vertical
         if(tp > 0)
            UpdateInvisibleLine(nameHLineTP, tp, colorLineTP, 2);
         else
            ObjectDelete(0, nameHLineTP);

         if(sl > 0)
            UpdateInvisibleLine(nameHLineSL, sl, colorLineSL, 3);
         else
            ObjectDelete(0, nameHLineSL);

         // (NOTA: He limpiado de aquí el borrado manual del Grid y el TS.
         // ¿Por qué? Porque tus funciones UpdateGridLogic y DrawTSVisuals son tan listas
         // que ellas mismas se auto-limpian al inicio si detectan que el panel está colapsado).
        }
      // --- STOP LOSS ---
      if(sl > 0)
        {
         mem.vis_sl_spawned = true; // <--- INYECCIÓN FASE 2
         // 1. Cálculos SL
         double distSL = MathAbs(entry - sl) / mul;
         double moneySL = (tickSize > 0) ? (MathAbs(entry - sl) / tickSize) * tickVal * vol : 0;
         double progSL = 0;
         if(MathAbs(entry - sl) > point)
           {
            double currDist = isBuyDir ? (entry - currentPrice) : (currentPrice - entry);
            progSL = (currDist / MathAbs(entry - sl)) * 100.0;
            if(progSL < 0)
               progSL = 0;
            if(progSL > 100)
               progSL = 100;
           }
         string txtSL = StringFormat("SL %.0f | -%.2f %s | %.2f%% | %s", distSL, moneySL, cur, progSL, DoubleToString(sl, dig));

         // 2. Dibujar visuales
         UpdateInvisibleLine(nameHLineSL, sl, colorLineSL, 3);
         DrawRect(nameRectSL, myPanelX, yEntry, ySL, colorRectSL);
         SmartSetInteger(nameRectSL, OBJPROP_BGCOLOR, colorRectSL);
         SmartSetInteger(nameRectSL, OBJPROP_BORDER_COLOR, borderColSL);

         DrawButton(nameBtnSL, myPanelX, ySLVis, txtSL, colorLineSL);
         SmartSetInteger(nameBtnSL, OBJPROP_XSIZE, TM_FIGURE_WIDTH); // <--- AÑADIDO: Ancho fijo de 200px
         SmartSetInteger(nameBtnSL, OBJPROP_ALIGN, ALIGN_CENTER);
         SmartSetInteger(nameBtnSL, OBJPROP_BORDER_COLOR, C'211,211,211');

         if(isHidden)
           {
            SmartSetInteger(nameBtnSL, OBJPROP_BGCOLOR, clrNONE);
            SmartSetInteger(nameBtnSL, OBJPROP_COLOR, colorLineSL);
           }
         else
           {
            SmartSetInteger(nameBtnSL, OBJPROP_BGCOLOR, colorLineSL);
            SmartSetInteger(nameBtnSL, OBJPROP_COLOR, clrWhite); // <--- AÑADIDO: Texto siempre blanco
           }
        }
      else
        {
         mem.vis_sl_spawned = false; // <--- INYECCIÓN FASE 2
         ObjectDelete(0, nameHLineSL);
         ObjectDelete(0, nameRectSL);
         ObjectDelete(0, nameBtnSL);
        }
     }
   else
     {
      // Limpieza si está colapsado
      ObjectDelete(0, nameRectTP);
      ObjectDelete(0, nameRectSL);
      ObjectDelete(0, nameBtnTP);
      ObjectDelete(0, nameBtnSL);
      ObjectDelete(0, nameHLineTP);
      ObjectDelete(0, nameHLineSL);

      // ... (El resto de la limpieza de Grid y TS se queda igual por ahora)


      // FIX 3: BORRAR TS Y GRID VISUALES
      string sT = IntegerToString(ticket);
      // Borrar Grid Fantasma / Activo
      for(int i=1; i<=5; i++)
        {
         string sI = IntegerToString(i);
         ObjectDelete(0, "TM_HLine_TP_" + sT + "_" + sI);
         ObjectDelete(0, "TM_Line_TP_" + sT + "_" + sI + "_Line");
         ObjectDelete(0, "TM_Line_TP_" + sT + "_" + sI + "_Btn");
         ObjectDelete(0, "TM_HLine_SL_" + sT + "_" + sI);
         ObjectDelete(0, "TM_Line_SL_" + sT + "_" + sI + "_Line");
         ObjectDelete(0, "TM_Line_SL_" + sT + "_" + sI + "_Btn");
        }
      // Borrar TS Visual
      ObjectDelete(0, "TM_Line_TS_Start_" + sT + "_Line");
      ObjectDelete(0, "TM_Line_TS_Start_" + sT + "_Btn");
      ObjectDelete(0, "TM_Line_TS_Dist_" + sT + "_Line");
      ObjectDelete(0, "TM_Line_TS_Dist_" + sT + "_Btn");
     }


   if(isMenuOpen)
     {
      string menuBgName    = MakeTMName(ticket, OP_TM_MENU_BG);
      string menuTitleName = MakeTMName(ticket, OP_TM_MENU_TITLE);
      string menuCloseName = MakeTMName(ticket, OP_TM_MENU_CLOSE);
      string sepName       = MakeTMName(ticket, OP_TM_M_SEP);
      // 1. CÁLCULO DE POSICIÓN (100% RAM / Relativo)
      int finalMenuX, finalMenuY;

      // Siempre pegado a la derecha del Panel Principal
      finalMenuX = myPanelX + TM_FIGURE_WIDTH - MENU_WIDTH;

      int screenH = (int)ChartGetInteger(0, CHART_HEIGHT_IN_PIXELS);
      int totalMenuH = 20 + MENU_HEIGHT;

      int yBelow = yEntryVis + BTN_HEIGHT;
      int yAbove = yEntryVis - totalMenuH;

      // Decisión vertical: Si cabe abajo, va abajo. Si no, va arriba.
      if((yBelow + totalMenuH) < screenH)
         finalMenuY = yBelow;
      else
         finalMenuY = (yAbove < 0) ? 0 : yAbove;

      // Si el usuario arrastró ESTE menú específicamente y lo dejó en otro lado,
      // la memoria RAM del Canvas ya tiene sus nuevas coordenadas.
      if(mem.menuCanvas.m_panelX != 0 && mem.menuCanvas.m_panelY != 0)
        {
         finalMenuX = mem.menuCanvas.m_panelX;
         finalMenuY = mem.menuCanvas.m_panelY;
        }
      // --------------------------------------------------------------

      // --- ¡AQUÍ ESTÁ LA INYECCIÓN! DIBUJAR VERSIÓN CCANVAS AL LADO ---
      DrawCanvasOrderMenu(mem.menuCanvas, ticket, finalMenuX, finalMenuY, type, vol, esPosicion);

      // ==========================================================
      // --- GESTIÓN DE SUB-VENTANA (AL ESTILO MAIN PANEL) ---
      // ==========================================================
      ushort actSub = mem.activeSubMenu;
      string subCanvasName = "CanvasSubMenu_" + IntegerToString(ticket);
      string baseInp = "TM_UI_" + IntegerToString(ticket) + "_M_Sub";

      // 1. ESCUDOS ANTI-FANTASMAS (Oculta Inputs Nativos si el menú no es el dueño)
      if(actSub != OP_TM_M_PART)
         ObjectSetInteger(0, baseInp + "Part_Input", OBJPROP_TIMEFRAMES, OBJ_NO_PERIODS);
      if(actSub != OP_TM_M_COMM)
         ObjectSetInteger(0, baseInp + "Comm_Input", OBJPROP_TIMEFRAMES, OBJ_NO_PERIODS);
      if(actSub != OP_TM_M_TRLIM)
         ObjectSetInteger(0, baseInp + "TrLim_Input", OBJPROP_TIMEFRAMES, OBJ_NO_PERIODS);

      if(actSub != OP_TM_M_EDIT)
        {
         ObjectSetInteger(0, baseInp + "Edit_Price", OBJPROP_TIMEFRAMES, OBJ_NO_PERIODS);
         ObjectSetInteger(0, baseInp + "Edit_TP", OBJPROP_TIMEFRAMES, OBJ_NO_PERIODS);
         ObjectSetInteger(0, baseInp + "Edit_SL", OBJPROP_TIMEFRAMES, OBJ_NO_PERIODS);
        }

      // --- NUEVO: ESCUDO PARA EL GRID ---
      if(actSub != OP_TM_M_GRID)
        {
         for(int k=1; k<=5; k++)
           {
            string sI = IntegerToString(k);
            ObjectSetInteger(0, baseInp + "Grid_InTP_P_" + sI, OBJPROP_TIMEFRAMES, OBJ_NO_PERIODS);
            ObjectSetInteger(0, baseInp + "Grid_InTP_V_" + sI, OBJPROP_TIMEFRAMES, OBJ_NO_PERIODS);
            ObjectSetInteger(0, baseInp + "Grid_InSL_P_" + sI, OBJPROP_TIMEFRAMES, OBJ_NO_PERIODS);
            ObjectSetInteger(0, baseInp + "Grid_InSL_V_" + sI, OBJPROP_TIMEFRAMES, OBJ_NO_PERIODS);
           }
        }

      if(actSub != OP_TM_M_BE)
        {
         ObjectSetInteger(0, baseInp + "BE_InStart", OBJPROP_TIMEFRAMES, OBJ_NO_PERIODS);
         ObjectSetInteger(0, baseInp + "BE_InOff", OBJPROP_TIMEFRAMES, OBJ_NO_PERIODS);
        }

      if(actSub != OP_TM_M_TS)
        {
         for(int k=0; k<6; k++)
            ObjectSetInteger(0, baseInp + "TS_In" + IntegerToString(k), OBJPROP_TIMEFRAMES, OBJ_NO_PERIODS);
        }

      // 2. ENRUTADOR DE DIBUJO
      if(actSub != 0)
        {
         int bX=0, bY=0, bW=0, bH=0;
         if(mem.menuCanvas.GetButtonCoords(actSub, bX, bY, bW, bH))
           {
            int absoluteY = finalMenuY + bY;
            ObjectSetInteger(0, subCanvasName, OBJPROP_TIMEFRAMES, OBJ_ALL_PERIODS);

            if(actSub == OP_TM_M_CLOSE)
               DrawCanvasSubMenu_Close(mem.subMenuCanvas, ticket, finalMenuX, absoluteY);
            else
               if(actSub == OP_TM_M_PART)
                  DrawCanvasSubMenu_Partial(mem.subMenuCanvas, ticket, finalMenuX, absoluteY);
               else
                  if(actSub == OP_TM_M_REV)
                     DrawCanvasSubMenu_Reverse(mem.subMenuCanvas, ticket, finalMenuX, absoluteY);
                  else
                     if(actSub == OP_TM_M_EDIT)
                        DrawCanvasSubMenu_Edit(mem.subMenuCanvas, ticket, finalMenuX, absoluteY, esPosicion, entry, tp, sl, isBuyDir);
                     else
                        if(actSub == OP_TM_M_GRID)
                           DrawCanvasSubMenu_Grid(mem.subMenuCanvas, ticket, finalMenuX, absoluteY, esPosicion);
                        else
                           if(actSub == OP_TM_M_BE)
                              DrawCanvasSubMenu_BE(mem.subMenuCanvas, ticket, finalMenuX, absoluteY);
                           else
                              if(actSub == OP_TM_M_TS)
                                 DrawCanvasSubMenu_TS(mem.subMenuCanvas, ticket, finalMenuX, absoluteY);
                              else
                                 if(actSub == OP_TM_M_COLOR)
                                    DrawCanvasSubMenu_Color(mem.subMenuCanvas, ticket, finalMenuX, absoluteY);
                                 else
                                    if(actSub == OP_TM_M_COMM)
                                       DrawCanvasSubMenu_Comment(mem.subMenuCanvas, ticket, finalMenuX, absoluteY);
                                    else
                                       if(actSub == OP_TM_M_TRLIM)
                                          DrawCanvasSubMenu_TrLim(mem.subMenuCanvas, ticket, finalMenuX, absoluteY);
           }
        }
      else
        {
         ObjectSetInteger(0, subCanvasName, OBJPROP_TIMEFRAMES, OBJ_NO_PERIODS);
        }




      // Nombre del botón activador
      string btnPartName = prefixMenu + "_M_Part";

      // Preguntamos: ¿Está el botón "Close Partial" presionado?

      string btnEditName = prefixMenu + "_M_Edit";


      string btnBEName = prefixMenu + "_M_BE";

      string btnGridName = prefixMenu + "_M_Grid";
      // Usamos la variable de memoria o el estado del objeto (ahora que ya arreglamos el click, el objeto es fiable)

      string btnTSName = prefixMenu + "_M_TS";

      // --- GESTIÓN SUB-MENÚ CLOSE (CONFIRMACIÓN) ---
      string btnCloseName = prefixMenu + "_M_Close";

      // --- GESTIÓN SUB-MENÚ REVERSE (CONFIRMACIÓN) ---
      string btnRevName = prefixMenu + "_M_Rev";

      // --- GESTIÓN DE SUB-MENÚS MODULARES (FASE 1) ---
      bool showPartial = (bool)ObjectGetInteger(0, MakeTMName(ticket, OP_TM_M_PART),  OBJPROP_STATE);
      bool showEdit    = (bool)ObjectGetInteger(0, MakeTMName(ticket, OP_TM_M_EDIT),  OBJPROP_STATE);
      bool showClose   = (bool)ObjectGetInteger(0, MakeTMName(ticket, OP_TM_M_CLOSE), OBJPROP_STATE);
      bool showRev     = (bool)ObjectGetInteger(0, MakeTMName(ticket, OP_TM_M_REV),   OBJPROP_STATE);
      bool showColor   = (bool)ObjectGetInteger(0, MakeTMName(ticket, OP_TM_M_COLOR), OBJPROP_STATE);
      bool showComm    = (bool)ObjectGetInteger(0, MakeTMName(ticket, OP_TM_M_COMM),  OBJPROP_STATE);
      bool showBE      = (bool)ObjectGetInteger(0, MakeTMName(ticket, OP_TM_M_BE),    OBJPROP_STATE);
      bool showGrid    = (bool)ObjectGetInteger(0, MakeTMName(ticket, OP_TM_M_GRID),  OBJPROP_STATE);
      bool showTS      = (bool)ObjectGetInteger(0, MakeTMName(ticket, OP_TM_M_TS),    OBJPROP_STATE);

      // AQUi arriba otras ventanas
     }
   else
     {
      // --- DESTRUCCIÓN LÓGICA Y DESREGISTRO (Cero Fantasmas) ---
      DWM.UnregisterWindow(GetPointer(mem.menuCanvas));    // 1. Lo sacamos del radar del láser
      mem.menuCanvas.DestroyCanvas();                      // 2. Implosionamos su RAM y visuales

      DWM.UnregisterWindow(GetPointer(mem.subMenuCanvas)); // Aseguramos redundancia para el sub-menú
      mem.subMenuCanvas.DestroyCanvas();

      mem.activeSubMenu = 0;
      CloseAllSubMenus(ticket);
      // ---------------------------------------------------------

      //mem.subMenuCanvas.DestroyCanvas(); // Destruimos también el submenú si se cierra todo
      // BORRADO DEL MENÚ PRINCIPAL (USANDO NOMBRES BITWISE)
      ObjectDelete(0, MakeTMName(ticket, OP_TM_MENU_BG));
      ObjectDelete(0, MakeTMName(ticket, OP_TM_MENU_TITLE));
      ObjectDelete(0, MakeTMName(ticket, OP_TM_MENU_CLOSE));
      ObjectDelete(0, MakeTMName(ticket, OP_TM_M_SEP));
      ObjectDelete(0, MakeTMName(ticket, OP_TM_M_CLOSE));
      ObjectDelete(0, MakeTMName(ticket, OP_TM_M_PART));
      ObjectDelete(0, MakeTMName(ticket, OP_TM_M_REV));
      ObjectDelete(0, MakeTMName(ticket, OP_TM_M_EDIT));
      ObjectDelete(0, MakeTMName(ticket, OP_TM_M_GRID));
      ObjectDelete(0, MakeTMName(ticket, OP_TM_M_TS));
      ObjectDelete(0, MakeTMName(ticket, OP_TM_M_BE));
      ObjectDelete(0, MakeTMName(ticket, OP_TM_M_COLOR));
      ObjectDelete(0, MakeTMName(ticket, OP_TM_M_COMM));
      ObjectDelete(0, MakeTMName(ticket, OP_TM_M_HIDE));
      ObjectDelete(0, MakeTMName(ticket, OP_TM_M_OCO));
      ObjectDelete(0, MakeTMName(ticket, OP_TM_M_EXP));
      ObjectDelete(0, MakeTMName(ticket, OP_TM_M_TRLIM));


     }

// 1. PRIMERO CALCULAMOS (El Cerebro)
   TS_Calculation tsCalc = CalculateTSLevels(ticket);

// 2. LUEGO DIBUJAMOS (El Artista)
   DrawTSVisuals(ticket, tsCalc, myPanelX);
   UpdateGridLogic(ticket, prefixMenu, myPanelX);
   UpdateExpirationVisuals(ticket);
   UpdateBELogic(ticket, myPanelX);
   UpdateHiddenVisuals(ticket);

// --- LÍNEAS FANTASMAS DEL MENÚ MODIFY ---
   bool showEdit = (mem.activeSubMenu == OP_TM_M_EDIT);
   DrawEditGhostLines(ticket, prefixMenu, myPanelX, showEdit, esPosicion, entry, tp, sl);
  } // <-- Fin de DibujarPanelUnico

//| DIBUJAR VISUALES DE EXPIRACIÓN (FLECHA Y LÍNEA DE TIEMPO)        |
//+------------------------------------------------------------------+
void              UpdateExpirationVisuals(ulong ticket)
  {
   CTradeState *mem = TradeRAM.Get(ticket);
   if(mem == NULL)
      return;

// 1. Verificar si el "Ojo" está abierto (Leyendo RAM)
   if(!mem.isExpVisualOn)
     {
      DeleteExpirationVisuals(ticket);
      return;
     }

// 2. Obtener datos de la Orden (UNIVERSAL)
   double price = 0.0;
   datetime expTime = 0;

   if(ticket >= VIRTUAL_TICKET_BASE)
     {
      CTradeState *vMem = TradeRAM.Get(ticket);
      if(vMem == NULL)
         return;
      price = vMem.virtEntry;
      expTime = vMem.virtExpiration;
     }
   else
     {
      if(!OrderSelect(ticket))
         return;
      price = OrderGetDouble(ORDER_PRICE_OPEN);

      // --- LA MAGIA: Si estamos esperando al bróker, leemos nuestra memoria optimista ---
      if(mem.async_is_waiting)
         expTime = mem.virtExpiration;
      else
         expTime = (datetime)OrderGetInteger(ORDER_TIME_EXPIRATION);
     }
   datetime now = TimeCurrent();

// 3. Determinar dónde dibujar
   datetime drawTime = expTime;

   bool isGTC = (expTime == 0);
   bool isDraggingThis = (g_isDragging && g_dragTicket == ticket && g_dragType == 8);

   if(isDraggingThis)
     {
      // 1. ARRASTRANDO: Usamos la memoria del drag desde la RAM
      drawTime = (datetime)mem.dragTime;
     }
   else
     {
      // 2. QUIETO (NO ARRASTRANDO)
      if(isGTC)
        {
         // LA CURA DEL CPU: Anclamos la flecha a la apertura de la vela actual.
         // El valor de iTime no cambia cada segundo, por lo que MT5 NO repintará
         // la pantalla innecesariamente, ahorrando montones de recursos.
         drawTime = iTime(mem.symbol, PERIOD_CURRENT, 0);
        }
      else
        {
         // Si tiene fecha real, usamos esa
         drawTime = expTime;
        }
     }

// 4. DIBUJAR LÍNEA DE CONEXIÓN (Trendline)
   string lineName = "TM_Exp_Line_" + IntegerToString(ticket);
   if(ObjectFind(0, lineName) < 0)
     {
      ObjectCreate(0, lineName, OBJ_TREND, 0, 0, 0);
      SmartSetInteger(lineName, OBJPROP_COLOR, C'255,255,0');  // Amarillo
      SmartSetInteger(lineName, OBJPROP_STYLE, STYLE_DOT);
      SmartSetInteger(lineName, OBJPROP_RAY_RIGHT, false);
      SmartSetInteger(lineName, OBJPROP_SELECTABLE, false);
     }

// Ancla 1 (Inicio de la línea en el tiempo actual)
   ObjectSetDouble(0, lineName, OBJPROP_PRICE, 0, price);
   ObjectSetInteger(0, lineName, OBJPROP_TIME, 0, now); // <-- Usamos la función nativa de MT5

// Ancla 2 (Fin de la línea en la fecha de expiración o vela actual)
   ObjectSetDouble(0, lineName, OBJPROP_PRICE, 1, price);
   ObjectSetInteger(0, lineName, OBJPROP_TIME, 1, drawTime); // <-- Usamos la función nativa de MT5


// 5. DIBUJAR LA FLECHA (El Manipulador)
   string arrowName = "TM_Exp_Arrow_" + IntegerToString(ticket);
   if(ObjectFind(0, arrowName) < 0)
     {
      ObjectCreate(0, arrowName, OBJ_ARROW_DOWN, 0, 0, 0);
      SmartSetInteger(arrowName, OBJPROP_ARROWCODE, 234);
      SmartSetInteger(arrowName, OBJPROP_COLOR, C'255,50,50');
      SmartSetInteger(arrowName, OBJPROP_WIDTH, 2);
      SmartSetInteger(arrowName, OBJPROP_ANCHOR, ANCHOR_BOTTOM);
      SmartSetInteger(arrowName, OBJPROP_SELECTABLE, false);
      SmartSetInteger(arrowName, OBJPROP_ZORDER, 50);
     }

   ObjectSetDouble(0, arrowName, OBJPROP_PRICE, price);
   SmartSetInteger(arrowName, OBJPROP_TIME, drawTime);

// 6. ETIQUETA DE TEXTO (Feedback visual)
   string textName = "TM_Exp_Text_" + IntegerToString(ticket);
   if(ObjectFind(0, textName) < 0)
     {
      ObjectCreate(0, textName, OBJ_TEXT, 0, 0, 0);
      SmartSetInteger(textName, OBJPROP_FONTSIZE, 8);
      SmartSetInteger(textName, OBJPROP_COLOR, C'255,255,255');
      SmartSetInteger(textName, OBJPROP_ANCHOR, ANCHOR_LOWER);
     }
   ObjectSetDouble(0, textName, OBJPROP_PRICE, price);
   SmartSetInteger(textName, OBJPROP_TIME, drawTime);

// Lógica de texto limpia y directa
   string label = "";
   if(isGTC && !isDraggingThis)
      label = "GTC (Off)";
   else
      label = TimeToString(drawTime, TIME_DATE|TIME_MINUTES);

   ObjectSetString(0, textName, OBJPROP_TEXT, label);
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              DeleteExpirationVisuals(ulong ticket)
  {
   ObjectDelete(0, "TM_Exp_Line_" + IntegerToString(ticket));
   ObjectDelete(0, "TM_Exp_Arrow_" + IntegerToString(ticket));
   ObjectDelete(0, "TM_Exp_Text_" + IntegerToString(ticket));
  }

//+------------------------------------------------------------------+
//| DETECTAR SI EL MOUSE ESTÁ SOBRE UNA FLECHA DE EXPIRACIÓN         |
//+------------------------------------------------------------------+
ulong             GetArrowTicketAt(int mouseX, int mouseY)
  {
// Recorremos todas las órdenes pendientes
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      ulong ticket = OrderGetTicket(i);
      string arrowName = "TM_Exp_Arrow_" + IntegerToString(ticket);

      // Si la flecha existe visualmente
      if(ObjectFind(0, arrowName) >= 0)
        {
         // 1. Obtener dónde está la flecha en el gráfico (Tiempo/Precio)
         datetime t = (datetime)ObjectGetInteger(0, arrowName, OBJPROP_TIME);
         double   p = ObjectGetDouble(0, arrowName, OBJPROP_PRICE);

         // 2. Convertir esa posición a Píxeles (X/Y)
         int arrowX, arrowY;
         if(ChartTimePriceToXY(0, 0, t, p, arrowX, arrowY))
           {
            // 3. Comprobar distancia (Radio de 15 píxeles alrededor de la flecha)
            // La flecha apunta abajo, así que el punto de anclaje suele estar en la punta o centro
            if(MathAbs(mouseX - arrowX) < 15 && MathAbs(mouseY - arrowY) < 15)
              {
               return ticket; // ¡ENCONTRADO!
              }
           }
        }
     }
   return 0; // No se encontró ninguna
  }

//+------------------------------------------------------------------+
//| PROCESAR EJECUCIÓN OCO (100% RAM DRIVEN - DETERMINISTA)          |
//+------------------------------------------------------------------+
void              ProcessOCOExecution(ulong triggeredTicket)
  {
   CTradeState *trigMem = TradeRAM.Get(triggeredTicket);
   if(trigMem == NULL)
      return;

// 1. Extraemos la "Intención Original" (Símbolo y Precio Planeado) directamente de la RAM
// (Cero impacto por Slippage del bróker)
   double targetPrice = trigMem.isVirtual ? trigMem.virtEntry : trigMem.openPrice;
   string targetSym   = trigMem.symbol;

   int memTotal = TradeRAM.Total();
   for(int i = memTotal - 1; i >= 0; i--)
     {
      CTradeState *mem = TradeRAM.GetByIndex(i);
      if(CheckPointer(mem) == POINTER_INVALID || mem.ticket == 0)
         continue;

      // 2. Ignoramos la orden que acaba de detonar el OCO y a las de otros símbolos
      if(mem.ticket == triggeredTicket || mem.symbol != targetSym)
         continue;

      // 3. LA REGLA DE ORO OCO (Matemática pura)
      if(mem.isOCO)
        {
         double enemyPrice = mem.isVirtual ? mem.virtEntry : mem.openPrice;

         // Si tienen precios de apertura EXACTAMENTE DISTINTOS, son la contraparte: ¡Aniquilar!
         // Si tienen precios IGUALES, son hermanos del Split: ¡Dejar vivir!
         if(enemyPrice != targetPrice)
           {
            if(mem.isVirtual)
              {
               // Asesinato Virtual Silencioso (100% RAM)
               mem.isVirtual = false;
               DeleteVirtualOrderData(mem.ticket);
              }
            else
              {
               // Asesinato Real (Encolamos la orden de destrucción a la Secretaria)
               if(QueueDeleteOrder(mem.ticket))
                  mem.isOCO = false; // Apagamos el gen para no procesarla dos veces
              }
           }
        }
     }

   SaveTradesToBin(); // GUARDADO MAESTRO FOTOGRÁFICO DE LA MATANZA
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool              IsMouseOverObject(string name, int x, int y)
  {
   if(ObjectFind(0, name) < 0)
      return false;

   int obX = (int)ObjectGetInteger(0, name, OBJPROP_XDISTANCE);
   int obY = (int)ObjectGetInteger(0, name, OBJPROP_YDISTANCE);
   int obW = (int)ObjectGetInteger(0, name, OBJPROP_XSIZE);
   int obH = (int)ObjectGetInteger(0, name, OBJPROP_YSIZE);

   return (x >= obX && x <= (obX + obW) && y >= obY && y <= (obY + obH));
  }

//+------------------------------------------------------------------+
//| MOTOR RÁPIDO: Mueve la ventana flotante (Modo 5)                 |
//+------------------------------------------------------------------+
void              MoveMenuVisualsFast(ulong ticket, int totalDeltaX, int totalDeltaY)
  {
   int total = ArraySize(g_dragCache);
   for(int i = 0; i < total; i++)
     {
      // Leemos de la RAM y disparamos a MT5. Cero lecturas de gráficos.
      ObjectSetInteger(0, g_dragCache[i], OBJPROP_XDISTANCE, g_dragCacheStartX[i] + totalDeltaX);
      ObjectSetInteger(0, g_dragCache[i], OBJPROP_YDISTANCE, g_dragCacheStartY[i] + totalDeltaY);
     }
   ChartRedraw();
  }

//+------------------------------------------------------------------+
//| SMART SETTERS: Solo envían comando si el valor cambia            |
//+------------------------------------------------------------------+
//+------------------------------------------------------------------+
//| SMART SETTERS FASE 2: Arquitectura "Push-Only" Ciega y Asíncrona |
//+------------------------------------------------------------------+
void              SmartSetInteger(string name, ENUM_OBJECT_PROPERTY_INTEGER prop, long value)
  {
// FUEGO Y OLVIDO: Cero lecturas síncronas (ObjectGetInteger).
   ObjectSetInteger(0, name, prop, value);
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              SmartSetDouble(string name, ENUM_OBJECT_PROPERTY_DOUBLE prop, double value)
  {
// FUEGO Y OLVIDO.
   ObjectSetDouble(0, name, prop, value);
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              SmartSetString(string name, ENUM_OBJECT_PROPERTY_STRING prop, string value)
  {
// FUEGO Y OLVIDO.
   ObjectSetString(0, name, prop, value);
  }



//+------------------------------------------------------------------+
//| ACTUALIZACIÓN LIGERA: Retorna TRUE si el texto cambió            |
//+------------------------------------------------------------------+
bool              UpdateLiveStats()
  {
   bool hasUpdated = false; // Bandera local

   int memTotal = TradeRAM.Total();
   for(int i = 0; i < memTotal; i++)
     {
      CTradeState *mem = TradeRAM.GetByIndex(i);

      // Solo actualizamos HUD de posiciones vivas (excluye pendientes y virtuales)
      if(CheckPointer(mem) == POINTER_INVALID || mem.ticket == 0 || mem.symbol != _Symbol || mem.isVirtual)
         continue;

      // 1. LA CURA DEL BUG: Usamos el nombre Bitwise O(1) extraído de la RAM
      string btnName = mem.obj_btnEntry;

      // Si el botón está visible en el gráfico...
      if(ObjectFind(0, btnName) >= 0)
        {
         if(PositionSelectByTicket(mem.ticket))
           {
            // Extraemos los datos rápidos de la RAM (Ya sincronizados por tu Oráculo principal)
            double vol   = mem.currentVol;
            double entry = mem.openPrice;
            long   type  = mem.type;

            // Fallback de seguridad por si el EA acaba de arrancar y la RAM está cargando
            if(vol == 0)
               vol = PositionGetDouble(POSITION_VOLUME);
            if(entry == 0)
               entry = PositionGetDouble(POSITION_PRICE_OPEN);

            // 2. EL ORÁCULO: Le pedimos el texto perfecto
            string text = GetOrderBaseText(mem, true, type, vol, entry);

            // 3. FILTRO ANTI-PARPADEO (Dirty Flag)
            string oldText = ObjectGetString(0, btnName, OBJPROP_TEXT);

            if(oldText != text)
              {
               ObjectSetString(0, btnName, OBJPROP_TEXT, text);
               hasUpdated = true; // Levantamos la bandera para que el OnTimer haga ChartRedraw()
              }
           }
        }
     }

   return hasUpdated;
  }

//+------------------------------------------------------------------+
//| FUNCIÓN MEJORADA: Cierre agresivo de sub-ventanas                |
//+------------------------------------------------------------------+
void              CloseAllSubMenus(ulong ticket)
  {
   string sTicket = IntegerToString(ticket);
   string prefix  = "TM_UI_" + sTicket + "_M_";

   CTradeState *mem = TradeRAM.Get(ticket);
   if(mem != NULL)
     {
      // Sacarlo del radar del Árbitro
      DWM.UnregisterWindow(GetPointer(mem.subMenuCanvas));
      mem.subMenuCanvas.DestroyCanvas();
     }

// 1. Apagar los interruptores (Botones del menú)
   ObjectSetInteger(0, prefix + "Part", OBJPROP_STATE, false);
   ObjectSetInteger(0, prefix + "Rev",  OBJPROP_STATE, false);
   ObjectSetInteger(0, prefix + "Edit", OBJPROP_STATE, false);
   ObjectSetInteger(0, prefix + "Grid", OBJPROP_STATE, false);
   ObjectSetInteger(0, prefix + "TS",   OBJPROP_STATE, false);
   ObjectSetInteger(0, prefix + "BE",   OBJPROP_STATE, false);

// Botones de confirmación y extras
   ObjectSetInteger(0, prefix + "Close",  OBJPROP_STATE, false);
   ObjectSetInteger(0, prefix + "OCO",    OBJPROP_STATE, false);
   ObjectSetInteger(0, prefix + "Exp",    OBJPROP_STATE, false);
   ObjectSetInteger(0, prefix + "TrLim",  OBJPROP_STATE, false);
   ObjectSetInteger(0, prefix + "Hide",   OBJPROP_STATE, false);

// 2. BORRADO FÍSICO INMEDIATO (Usando los prefijos de las sub-ventanas)
// Esto elimina cualquier rastro visual sin esperar al redibujado.
   ObjectsDeleteAll(0, prefix + "SubPart");
   ObjectsDeleteAll(0, prefix + "SubEdit");
   ObjectsDeleteAll(0, prefix + "SubGrid"); // Borra todo el grid (botones, inputs, fondo)
   ObjectsDeleteAll(0, prefix + "SubTS");   // Borra todo el TS
   ObjectsDeleteAll(0, prefix + "SubBE");   // Borra todo el Break Even
   ObjectsDeleteAll(0, prefix + "SubClose");
   ObjectsDeleteAll(0, prefix + "SubRev");
   ObjectsDeleteAll(0, prefix + "SubTrLim");

   ObjectsDeleteAll(0, prefix + "SubComm");  // <-- Añade esta si falta
   ObjectsDeleteAll(0, prefix + "SubColor"); // <-- Añade esta si falta

  }

//+------------------------------------------------------------------+
//| MOTOR VERTICAL: Mueve la orden y TODAS sus líneas (Modo 6)       |
//+------------------------------------------------------------------+
void              MoveOrderVisualsY(ulong ticket, int totalDeltaY, int deltaY) // <--- Añadimos deltaY aquí
  {
// 1. Mover los objetos visuales de la figura (Desde la RAM a velocidad luz)
   int totalCache = ArraySize(g_dragCache);
   for(int i = 0; i < totalCache; i++)
     {
      ObjectSetInteger(0, g_dragCache[i], OBJPROP_YDISTANCE, g_dragCacheStartY[i] + totalDeltaY);
     }

// 2. Mover las líneas maestras invisibles (Usando matemática relativa)
   string btnEntryName = MakeTMName(ticket, OP_TM_ENTRY);
   if(ObjectFind(0, btnEntryName) >= 0)
     {
      int currentY = (int)ObjectGetInteger(0, btnEntryName, OBJPROP_YDISTANCE);
      int realLineY = currentY + BTN_HEIGHT;

      int oldLineY  = realLineY - deltaY; // <--- ¡AQUÍ SE USA EL DELTAY QUE FALTABA!

      // ... (El resto de tu función queda exactamente igual, no toques nada más abajo)
      int dummyX = 0, subWindow = 0;
      datetime t;
      double newPrice = 0.0, oldPrice = 0.0;
      // ...

      if(ChartXYToTimePrice(0, dummyX, realLineY, subWindow, t, newPrice) &&
         ChartXYToTimePrice(0, dummyX, oldLineY, subWindow, t, oldPrice))
        {
         double deltaPrice = newPrice - oldPrice;

         // --- FIX 1: Nombres correctos (Actualizados a Bitwise) ---
         string hlEntry = MakeTMName(ticket, OP_HLINE_ENTRY);
         string hlTP    = MakeTMName(ticket, OP_HLINE_TP); // <-- CORREGIDO
         string hlSL    = MakeTMName(ticket, OP_HLINE_SL); // <-- CORREGIDO
         string hlSec   = MakeTMName(ticket, OP_HLINE_SEC);

         // Movemos matemáticamente solo las 4 líneas maestras (Cero Lag)
         if(ObjectFind(0, hlEntry) >= 0)
            ObjectSetDouble(0, hlEntry, OBJPROP_PRICE, ObjectGetDouble(0, hlEntry, OBJPROP_PRICE) + deltaPrice);
         if(ObjectFind(0, hlTP) >= 0)
            ObjectSetDouble(0, hlTP, OBJPROP_PRICE, ObjectGetDouble(0, hlTP, OBJPROP_PRICE) + deltaPrice);
         if(ObjectFind(0, hlSL) >= 0)
            ObjectSetDouble(0, hlSL, OBJPROP_PRICE, ObjectGetDouble(0, hlSL, OBJPROP_PRICE) + deltaPrice);
         //if(ObjectFind(0, hlSec) >= 0)
         //ObjectSetDouble(0, hlSec, OBJPROP_PRICE, ObjectGetDouble(0, hlSec, OBJPROP_PRICE) + deltaPrice);
        }
     }
   ChartRedraw();
  }

//+------------------------------------------------------------------+
//| MOTOR TP/SL FASE 2: Mueve la LÍNEA HORIZONTAL y ajusta visuales  |
//+------------------------------------------------------------------+
void              MoveTPSLVisuals(ulong ticket, int dragType, int mouseY)
  {
   string lineSuffix = (dragType == 2) ? "TM_HLine_TP_" : ((dragType == 3) ? "TM_HLine_SL_" : "TM_HLine_Sec_");

// --- NOMBRES BITWISE 100% MATEMÁTICOS ---
   string suffix     = (dragType == 2) ? "_BtnTP" : ((dragType == 3) ? "_BtnSL" : "_BtnSec");
   string rectSuffix = (dragType == 2) ? "_RectTP" : ((dragType == 3) ? "_RectSL" : "_RectSec");

// --- NOMBRES BITWISE 100% MATEMÁTICOS ---
   string btnName  = (dragType == 2) ? MakeTMName(ticket, OP_TM_TP) : ((dragType == 3) ? MakeTMName(ticket, OP_TM_SL) : ((dragType == 7) ? MakeTMName(ticket, OP_TM_SEC) : MakeTMName(ticket, OP_TM_CANCEL_LBL)));
   string rectName = (dragType == 2) ? MakeTMName(ticket, OP_TM_RECT_TP) : ((dragType == 3) ? MakeTMName(ticket, OP_TM_RECT_SL) : "");
   string entryName= MakeTMName(ticket, OP_TM_ENTRY);
   string lineName = (dragType == 2) ? MakeTMName(ticket, OP_HLINE_TP) : ((dragType == 3) ? MakeTMName(ticket, OP_HLINE_SL) : ((dragType == 7) ? MakeTMName(ticket, OP_HLINE_SEC) : MakeTMName(ticket, OP_HLINE_CANCEL)));

// --- FIX: RECONOCER EL TIPO INCLUSO SI ES VIRTUAL ---
   long type = -1;
   if(ticket >= VIRTUAL_TICKET_BASE)
     {
      CTradeState *vMem = TradeRAM.Get(ticket);
      if(vMem != NULL)
         type = vMem.virtType;
     }
   else
      if(PositionSelectByTicket(ticket))
        {
         type = PositionGetInteger(POSITION_TYPE);
        }
      else
         if(OrderSelect(ticket))
           {
            type = OrderGetInteger(ORDER_TYPE);
           }

   bool isBuyDir = (type == POSITION_TYPE_BUY || type == ORDER_TYPE_BUY_LIMIT ||
                    type == ORDER_TYPE_BUY_STOP || type == ORDER_TYPE_BUY_STOP_LIMIT);
// ----------------------------------------------------

   int subWindow = 0;
   datetime t;
   double newPrice = 0.0;
   int dummyX = 0;
   int targetLineY = mouseY - g_dragOffsetY;

   if(ChartXYToTimePrice(0, dummyX, targetLineY, subWindow, t, newPrice))
     {
      // --. NUEVO: TOPES MATEMÁTICOS PARA LA CANCELACIÓN (Soporta Virtuales) <---
      if(dragType == 9)
        {
         long oType = -1;
         string oSym = _Symbol;
         double openPrice = 0;

         // 1. Obtener datos si es Virtual
         if(ticket >= VIRTUAL_TICKET_BASE)
           {
            CTradeState *vMem = TradeRAM.Get(ticket);
            if(vMem != NULL && vMem.isVirtual)
              {
               oType = vMem.virtType;
               oSym  = vMem.symbol;

               // --- FIX: Si es Stop Limit, el límite lo marca el Gatillo (Línea Morada) ---
               if(oType == ORDER_TYPE_BUY_STOP_LIMIT || oType == ORDER_TYPE_SELL_STOP_LIMIT)
                  openPrice = vMem.virtStopLimit;
               else
                  openPrice = vMem.virtEntry;
              }
           }
         // 2. Obtener datos si es Real
         else
            if(OrderSelect(ticket))
              {
               oType = OrderGetInteger(ORDER_TYPE);
               oSym = OrderGetString(ORDER_SYMBOL);
               openPrice = OrderGetDouble(ORDER_PRICE_OPEN); // Gatillo
              }

         // 3. Aplicar topes geométricos
         if(oType != -1)
           {
            double cAsk = SymbolInfoDouble(oSym, SYMBOL_ASK);
            double cBid = SymbolInfoDouble(oSym, SYMBOL_BID);

            // Si intenta cruzar la zona prohibida, empujamos el precio al límite
            if(oType == ORDER_TYPE_BUY_LIMIT && newPrice < cAsk)
               newPrice = cAsk;
            if(oType == ORDER_TYPE_SELL_LIMIT && newPrice > cBid)
               newPrice = cBid;
            if(oType == ORDER_TYPE_BUY_STOP && newPrice > cBid)
               newPrice = cBid;
            if(oType == ORDER_TYPE_SELL_STOP && newPrice < cAsk)
               newPrice = cAsk;
            if(oType == ORDER_TYPE_BUY_STOP_LIMIT && newPrice < openPrice)
               newPrice = openPrice;
            if(oType == ORDER_TYPE_SELL_STOP_LIMIT && newPrice > openPrice)
               newPrice = openPrice;
           }
        }
      // A. MOVER LA LÍNEA HORIZONTAL
      if(ObjectFind(0, lineName) >= 0)
        {
         ObjectSetDouble(0, lineName, OBJPROP_PRICE, newPrice);
         color c = (dragType == 2) ? COLOR_NEON_CYAN : ((dragType == 3) ? COLOR_NEON_MAGENTA : (color)ObjectGetInteger(0, entryName, OBJPROP_BORDER_COLOR));

         ObjectSetInteger(0, lineName, OBJPROP_COLOR, c);
        }

      // B. MOVER EL BOTÓN Y RECTÁNGULO
      int lineY = 0;
      if(ChartTimePriceToXY(0, 0, t, newPrice, dummyX, lineY))
        {
         // --- EXTRACCIÓN TEMPRANA DE DATOS PARA GEOMETRÍA ---
         double entry=0, sl=0, tp=0, vol=0;
         long typeInfo=-1;
         CTradeState *mem = NULL;
         GetUnifiedTradeInfo(ticket, entry, sl, tp, vol, typeInfo, mem);

         // B. MOVER EL BOTÓN Y RECTÁNGULO
         int btnY = lineY;
         if(dragType == 2)
            btnY = isBuyDir ? (lineY - BTN_HEIGHT) : lineY;
         else
            if(dragType == 3)
               btnY = isBuyDir ? lineY : (lineY - BTN_HEIGHT);
            else
               if(dragType == 7 || dragType == 9) // Stop Limit y Cancel
                 {
                  bool isAbove = (newPrice > entry);
                  btnY = isAbove ? (lineY - BTN_HEIGHT) : (lineY + 1);
                 }

         // AÑADIDAS LAS LLAVES DE AGRUPACIÓN FALTANTES
         if(ObjectFind(0, btnName) >= 0)
           {
            // 1. MOVER EL BOTÓN (ETIQUETA) PARA QUE NO "DESAPAREZCA"
            ObjectSetInteger(0, btnName, OBJPROP_YDISTANCE, btnY);

            // --. NUEVO: MOVER LA LÍNEA PUNTEADA DEL STOP LIMIT Y CANCEL <---
            if(dragType == 7 || dragType == 9) // <--- SOLUCIÓN 2: Añadimos dragType 9 para que la línea naranja se mueva
               ObjectSetInteger(0, btnName + "_VisLine", OBJPROP_YDISTANCE, lineY);


            // Obtenemos los datos de la orden actual (sea real, virtual o del panel)
            if(GetUnifiedTradeInfo(ticket, entry, sl, tp, vol, typeInfo, mem))
              {
               string sym = (ticket == 0) ? _Symbol : mem.symbol;
               double point    = Market.point;
               int dig      = Market.digits;
               double mul      = Market.multiplier;
               double tickVal  = Market.tickValue;
               double tickSize = Market.tickSize;
               string cur = AccountInfoString(ACCOUNT_CURRENCY);
               double currentPrice = isBuyDir ? SymbolInfoDouble(sym, SYMBOL_BID) : SymbolInfoDouble(sym, SYMBOL_ASK);

               // Matemáticas en vivo
               double dist = MathAbs(entry - newPrice) / mul;
               double money = (tickSize > 0) ? (MathAbs(entry - newPrice) / tickSize) * tickVal * vol : 0;
               double prog = 0;

               if(MathAbs(entry - newPrice) > point)
                 {
                  double currDist = 0;
                  if(dragType == 2)
                     currDist = isBuyDir ? (currentPrice - entry) : (entry - currentPrice);
                  else
                     currDist = isBuyDir ? (entry - currentPrice) : (currentPrice - entry);

                  prog = (currDist / MathAbs(newPrice - entry)) * 100.0;
                  if(prog < 0)
                     prog = 0;
                  if(prog > 100)
                     prog = 100;
                 }

               // Actualizar texto del botón en tiempo real
               string newTxt = "";
               if(dragType == 2)
                  newTxt = StringFormat("TP %.0f | %.2f %s | %.2f%% | %s", dist, money, cur, prog, DoubleToString(newPrice, dig));
               else
                  if(dragType == 3)
                     newTxt = StringFormat("SL %.0f | -%.2f %s | %.2f%% | %s", dist, money, cur, prog, DoubleToString(newPrice, dig));
                  else
                     if(dragType == 7)
                        newTxt = "Stop Limit";
                     else
                        if(dragType == 9)
                           newTxt = "Cancel: " + DoubleToString(newPrice, dig);

               ObjectSetString(0, btnName, OBJPROP_TEXT, newTxt);
              }

            // 3. AJUSTAR LA ALTURA DEL RECTÁNGULO DE FONDO
            if(dragType != 7 && dragType != 9 && ObjectFind(0, rectName) >= 0 && ObjectFind(0, entryName) >= 0) // <--- SOLUCIÓN 3: Excluimos dragType 9 del fondo
              {
               int yEntryBtn = (int)ObjectGetInteger(0, entryName, OBJPROP_YDISTANCE);

               // Origen exacto de la entrada
               int yPriceEntry = isBuyDir ? yEntryBtn : (yEntryBtn + BTN_HEIGHT);
               int yPriceCurrent = lineY;

               int rectY = MathMin(yPriceEntry, yPriceCurrent);
               int rectH = MathAbs(yPriceEntry - yPriceCurrent);

               ObjectSetInteger(0, rectName, OBJPROP_YDISTANCE, rectY);
               ObjectSetInteger(0, rectName, OBJPROP_YSIZE, rectH);
              }
           }
        }
     }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
   ChartRedraw();
  }


//+------------------------------------------------------------------+
//| PARSER UNIVERSAL: Detecta qué línea avanzada estamos tocando     |
//+------------------------------------------------------------------+
int               DetectLineDrag(string objName, ulong &outTicket, int &outRow, string &outHLineName)
  {
// El truco mágico: ParseTMObject ignora los sufijos "_Btn" y "_Line" instantáneamente
   ushort opcode = ParseTMObject(objName, outTicket);
   if(opcode == OP_NONE)
      return 0;

// El nombre de la HLine invisible es exactamente el número empaquetado
   outHLineName = IntegerToString((outTicket << 12) | (opcode & 0xFFF));

   if(opcode >= OP_HLINE_GRID_TP_1 && opcode <= OP_HLINE_GRID_TP_5)
     {
      outRow = opcode - OP_HLINE_GRID_TP_1 + 1;
      return 10;
     }
   if(opcode >= OP_HLINE_GRID_SL_1 && opcode <= OP_HLINE_GRID_SL_5)
     {
      outRow = opcode - OP_HLINE_GRID_SL_1 + 1;
      return 20;
     }
   if(opcode == OP_HLINE_BE_START)
     {
      outRow = 0;
      return 30;
     }
   if(opcode == OP_HLINE_BE_OFF)
     {
      outRow = 0;
      return 31;
     }
   if(opcode == OP_HLINE_TS_START)
     {
      outRow = 0;
      return 40;
     }
   if(opcode == OP_HLINE_TS_DIST)
     {
      outRow = 0;
      return 41;
     }
   if(opcode == OP_HLINE_EDIT_TP)
     {
      outRow = 0;
      return 50;
     }
   if(opcode == OP_HLINE_EDIT_SL)
     {
      outRow = 0;
      return 51;
     }
   if(opcode == OP_HLINE_EDIT_PR)
     {
      outRow = 0;
      return 52;
     }

   return 0; // No se reconoció
  }

//+------------------------------------------------------------------+
//| MOTOR AVANZADO: Mueve cualquier línea del Grid, BE o TS          |
//+------------------------------------------------------------------+
void              MoveAdvancedLineVisuals(ulong ticket, int dragType, int row, int mouseY)
  {
   string hLineName = "";
   string btnName   = "";
   color  clr       = clrNONE;
   int opcode       = 0;

   if(dragType == 10)
     {
      opcode = OP_HLINE_GRID_TP_1 + row - 1;
      clr = COLOR_NEON_CYAN;
     }
   else
      if(dragType == 20)
        {
         opcode = OP_HLINE_GRID_SL_1 + row - 1;
         clr = C'242,54,69';
        }
      else
         if(dragType == 30)
           {
            opcode = OP_HLINE_BE_START;
            clr = C'175,108,58';
           }
         else
            if(dragType == 31)
              {
               opcode = OP_HLINE_BE_OFF;
               clr = C'198,132,83';
              }
            else
               if(dragType == 40)
                 {
                  opcode = OP_HLINE_TS_START;
                  clr = C'60,95,147';
                 }
               else
                  if(dragType == 41)
                    {
                     opcode = OP_HLINE_TS_DIST;
                     clr = C'73,117,182';
                    }
                  else
                     if(dragType == 50)
                       {
                        opcode = OP_HLINE_EDIT_TP;
                        clr = C'10,192,160';
                       }
                     else
                        if(dragType == 51)
                          {
                           opcode = OP_HLINE_EDIT_SL;
                           clr = C'244,89,101';
                          }
                        else
                           if(dragType == 52)
                             {
                              opcode = OP_HLINE_EDIT_PR;
                              clr = C'180,180,0';
                             }

   if(opcode == 0)
      return;

   hLineName = MakeTMName(ticket, opcode);
   btnName   = hLineName + "_Btn";
   string lineVisName = hLineName + "_Line";

   int targetLineY = mouseY - g_dragOffsetY;
   int dummyX = 0, subWindow = 0;
   datetime t;
   double newPrice = 0.0;

   if(ChartXYToTimePrice(0, dummyX, targetLineY, subWindow, t, newPrice))
     {
      // 1. Mover el precio real
      ObjectSetDouble(0, hLineName, OBJPROP_PRICE, newPrice);
      ObjectSetInteger(0, hLineName, OBJPROP_COLOR, clr);
      ObjectSetInteger(0, hLineName, OBJPROP_TIMEFRAMES, OBJ_ALL_PERIODS);

      // 2. Mover la línea punteada visual
      ObjectSetInteger(0, lineVisName, OBJPROP_YDISTANCE, targetLineY);

      // =============================================================
      // --. FASE 2: INYECCIÓN DE TEXTO EN TIEMPO REAL <---
      // =============================================================
      string updatedText = "";
      if(dragType == 10)
         updatedText = GetGridLabelText(ticket, row, true, newPrice);
      else
         if(dragType == 20)
            updatedText = GetGridLabelText(ticket, row, false, newPrice);
         else
            if(dragType == 30)
               updatedText = GetBELabelText(ticket, true, newPrice);
            else
               if(dragType == 31)
                  updatedText = GetBELabelText(ticket, false, newPrice);
               else
                  if(dragType == 40)
                     updatedText = GetTSLabelText(ticket, true, newPrice);
                  else
                     if(dragType == 41)
                        updatedText = GetTSLabelText(ticket, false, newPrice);
                     else
                        if(dragType >= 50 && dragType <= 52)
                           updatedText = GetModifyLabelText(ticket, dragType, newPrice);

      // Si el extractor devolvió datos, actualizamos la etiqueta al instante
      if(updatedText != "")
         ObjectSetString(0, btnName, OBJPROP_TEXT, updatedText);
      // =============================================================

      long type = -1;

      // --- Inteligencia para Pre-operación (Ticket 0) ---
      if(ticket == 0)
        {
         double sl = ObjectGetDouble(0, m_lineSL, OBJPROP_PRICE);
         double entry = ObjectGetDouble(0, m_lineEntry, OBJPROP_PRICE);
         type = (sl < entry) ? POSITION_TYPE_BUY : POSITION_TYPE_SELL;
        }
      else
         if(ticket >= VIRTUAL_TICKET_BASE)
           {
            CTradeState *vMem = TradeRAM.Get(ticket);
            if(vMem != NULL)
               type = vMem.virtType;
           }
         else
           {
            if(PositionSelectByTicket(ticket))
               type = PositionGetInteger(POSITION_TYPE);
            else
               if(OrderSelect(ticket))
                  type = OrderGetInteger(ORDER_TYPE);
           }

      bool isBuy = (type == POSITION_TYPE_BUY || type == ORDER_TYPE_BUY_LIMIT || type == ORDER_TYPE_BUY_STOP || type == ORDER_TYPE_BUY_STOP_LIMIT);

      bool isAbove = true;
      if(dragType == 10 || dragType == 30 || dragType == 31 || dragType == 40 || dragType == 41 || dragType == 50 || dragType == 52)
         isAbove = isBuy;
      if(dragType == 20 || dragType == 51)
         isAbove = !isBuy;

      int btnY = isAbove ? (targetLineY - 16) : targetLineY;
      ObjectSetInteger(0, btnName, OBJPROP_YDISTANCE, btnY);
     }
   ChartRedraw();
  }

//+------------------------------------------------------------------+
//| AUXILIAR: Calcula posición X del Sub-Menú para no salirse        |
//+------------------------------------------------------------------+
int               GetSmartSubMenuX(int finalMenuX, int subW)
  {
   int chartW = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);
   int subX = finalMenuX + MENU_WIDTH + 2; // Por defecto a la derecha

// Si choca con el borde derecho de la pantalla, lo abrimos a la izquierda
   if(subX + subW > chartW)
      subX = finalMenuX - subW - 2;

   return subX;
  }

//+------------------------------------------------------------------+
//| DIBUJAR LÍNEAS FANTASMAS DEL MENÚ MODIFY (100% RAM DRIVEN)       |
//+------------------------------------------------------------------+
void              DrawEditGhostLines(ulong ticket, string prefixMenu, int xPos, bool showEdit, bool esPosicion, double entry, double realTP, double realSL)
  {
   string baseTP = MakeTMName(ticket, OP_HLINE_EDIT_TP);
   string baseSL = MakeTMName(ticket, OP_HLINE_EDIT_SL);
   string basePr = MakeTMName(ticket, OP_HLINE_EDIT_PR);

   if(!showEdit)
     {
      ObjectDelete(0, baseTP);
      ObjectDelete(0, baseTP + "_Line");
      ObjectDelete(0, baseTP + "_Btn");
      ObjectDelete(0, baseSL);
      ObjectDelete(0, baseSL + "_Line");
      ObjectDelete(0, baseSL + "_Btn");
      ObjectDelete(0, basePr);
      ObjectDelete(0, basePr + "_Line");
      ObjectDelete(0, basePr + "_Btn");
      return;
     }

   string sT = IntegerToString(ticket);


// --- 🐛 AQUÍ ESTABA EL BUG RESUELTO 100% RAM 🐛 ---
   CTradeState *m = TradeRAM.Get(ticket);
   if(m == NULL)
      return;

   double valTP = m.draftTP;
   double valSL = m.draftSL;
   double valPr = esPosicion ? 0 : m.draftPr;



   if(g_isDragging && g_dragTicket == ticket)
     {
      if(g_dragType == 50)
         valTP = ObjectGetDouble(0, baseTP, OBJPROP_PRICE);
      if(g_dragType == 51)
         valSL = ObjectGetDouble(0, baseSL, OBJPROP_PRICE);
      if(g_dragType == 52)
         valPr = ObjectGetDouble(0, basePr, OBJPROP_PRICE);
     }

// ANCHO FIJO
   int drawWidth = TM_FIGURE_WIDTH;

   double point    = Market.point;
   int dig      = Market.digits;
   double mul      = Market.multiplier;
   double tickVal  = Market.tickValue;
   double tickSize = Market.tickSize;
   string cur      = AccountInfoString(ACCOUNT_CURRENCY);

   double vol = 0;
   long type = -1;
   GetUnifiedTradeInfo(ticket, entry, realSL, realTP, vol, type, m);
   bool isBuy = (type == POSITION_TYPE_BUY || type == ORDER_TYPE_BUY_LIMIT || type == ORDER_TYPE_BUY_STOP || type == ORDER_TYPE_BUY_STOP_LIMIT);

// --- TP FANTASMA ---
   if(realTP == 0)
     {
      double drawTP = (valTP > 0) ? valTP : entry;
      color ghostTPColor = LighterColor(C'8,153,129', 50);
      UpdateInvisibleLine(baseTP, drawTP, ghostTPColor, 50);

      double distTP = MathAbs(drawTP - entry) / mul;
      double moneyTP = (tickSize > 0) ? (MathAbs(entry - drawTP) / tickSize) * tickVal * vol : 0;
      string txtTP = StringFormat("[Prev] TP %.0f | %.2f %s", distTP, moneyTP, cur);

      DrawAdvancedLineTV(baseTP, drawTP, ghostTPColor, txtTP, xPos, drawWidth, isBuy);
     }
   else
     {
      ObjectDelete(0, baseTP);
      ObjectDelete(0, baseTP + "_Line");
      ObjectDelete(0, baseTP + "_Btn");
     }

// --- SL FANTASMA ---
   if(realSL == 0)
     {
      double drawSL = (valSL > 0) ? valSL : entry;
      color ghostSLColor = LighterColor(C'242,54,69', 50);
      UpdateInvisibleLine(baseSL, drawSL, ghostSLColor, 51);

      double distSL = MathAbs(entry - drawSL) / mul;
      double moneySL = (tickSize > 0) ? (MathAbs(entry - drawSL) / tickSize) * tickVal * vol : 0;
      string txtSL = StringFormat("[Prev] SL %.0f | -%.2f %s", distSL, moneySL, cur);

      DrawAdvancedLineTV(baseSL, drawSL, ghostSLColor, txtSL, xPos, drawWidth, !isBuy);
     }
   else
     {
      ObjectDelete(0, baseSL);
      ObjectDelete(0, baseSL + "_Line");
      ObjectDelete(0, baseSL + "_Btn");
     }

// --- PRECIO FANTASMA ---
   if(!esPosicion)
     {
      double drawPr = (valPr > 0) ? valPr : entry;
      UpdateInvisibleLine(basePr, drawPr, C'180,180,0', 52);
      string txtPr = "New Entry: " + DoubleToString(drawPr, dig);
      DrawAdvancedLineTV(basePr, drawPr, C'180,180,0', txtPr, xPos, drawWidth, isBuy);
     }
  }

//+------------------------------------------------------------------+
//| MOTOR MATEMÁTICO: Mueve paneles al arrastrar el gráfico a 120fps |
//| FASE 2: 100% PUSH-ONLY ARCHITECTURE + INTERPOLACIÓN MATEMÁTICA   |
//+------------------------------------------------------------------+
void              TM_UpdatePanVisualsFast()
  {
   int total = TradeRAM.Total();
   for(int i=0; i<total; i++)
     {
      CTradeState *mem = TradeRAM.GetByIndex(i);
      if(CheckPointer(mem) == POINTER_INVALID || mem.ticket == 0)
         continue;

      ulong ticket = mem.ticket;

      if(mem.vis_base_spawned)
        {
         double entry=0, sl=0, tp=0;
         if(GetTradeInfo(ticket, entry, sl, tp))
           {
            // --- MAGIA MATEMÁTICA ---
            int yEntry = PriceToY(entry);

            long type = 0;
            if(PositionSelectByTicket(ticket))
               type = PositionGetInteger(POSITION_TYPE);
            else
               if(OrderSelect(ticket))
                  type = OrderGetInteger(ORDER_TYPE);

            bool isBuyDir = (type == POSITION_TYPE_BUY || type == ORDER_TYPE_BUY_LIMIT || type == ORDER_TYPE_BUY_STOP || type == ORDER_TYPE_BUY_STOP_LIMIT);
            int yEntryVis = isBuyDir ? yEntry : (yEntry - BTN_HEIGHT);

            // A. Mover Cabecera (Botón Entry, Move, Menu y CANCEL)
            ObjectSetInteger(0, mem.obj_btnEntry, OBJPROP_YDISTANCE, yEntryVis);
            ObjectSetInteger(0, mem.obj_btnMove, OBJPROP_YDISTANCE, yEntryVis);
            ObjectSetInteger(0, mem.obj_btnMenu, OBJPROP_YDISTANCE, yEntryVis);
            ObjectSetInteger(0, mem.obj_btnCancToggle, OBJPROP_YDISTANCE, yEntryVis); // <--- FIX ERROR 2: El botón [C] ahora viaja con el bloque

            // B. Mover TP
            if(mem.vis_tp_spawned)
              {
               int yTP = PriceToY(tp); // Matemática
               int yTPVis = isBuyDir ? (yTP - BTN_HEIGHT) : yTP;
               ObjectSetInteger(0, mem.obj_btnTP, OBJPROP_YDISTANCE, yTPVis);
               ObjectSetInteger(0, mem.obj_rectTP, OBJPROP_YDISTANCE, MathMin(yEntry, yTP));
               ObjectSetInteger(0, mem.obj_rectTP, OBJPROP_YSIZE, MathAbs(yEntry - yTP));
               ObjectSetInteger(0, mem.obj_hlineTP, OBJPROP_YDISTANCE, yTP);
              }

            // C. Mover SL
            if(mem.vis_sl_spawned)
              {
               int ySL = PriceToY(sl); // Matemática
               int ySLVis = isBuyDir ? ySL : (ySL - BTN_HEIGHT);
               ObjectSetInteger(0, mem.obj_btnSL, OBJPROP_YDISTANCE, ySLVis);
               ObjectSetInteger(0, mem.obj_rectSL, OBJPROP_YDISTANCE, MathMin(yEntry, ySL));
               ObjectSetInteger(0, mem.obj_rectSL, OBJPROP_YSIZE, MathAbs(yEntry - ySL));
               ObjectSetInteger(0, mem.obj_hlineSL, OBJPROP_YDISTANCE, ySL);
              }

            // D. Mover el Stop Limit Secundario
            if(mem.vis_sec_spawned)
              {
               double secPrice = mem.isVirtual ? mem.virtStopLimit : OrderGetDouble(ORDER_PRICE_OPEN);
               if(secPrice > 0)
                 {
                  int ySec = PriceToY(secPrice); // Matemática
                  bool isAboveSec = (secPrice > entry);
                  int ySecVis = isAboveSec ? (ySec - BTN_HEIGHT) : (ySec + 1);
                  ObjectSetInteger(0, mem.obj_btnSec, OBJPROP_YDISTANCE, ySecVis);
                  ObjectSetInteger(0, mem.obj_visSec, OBJPROP_YDISTANCE, ySec);
                 }
              }

            // G. Mover la línea de Cancelación visual
            if(mem.vis_canc_spawned && mem.cancelPrice > 0)
              {
               int yCanc = PriceToY(mem.cancelPrice); // Matemática
               bool isAboveCanc = (mem.cancelPrice > entry);
               int yCancVis = isAboveCanc ? (yCanc - BTN_HEIGHT) : (yCanc + 1);
               ObjectSetInteger(0, mem.obj_btnCanc, OBJPROP_YDISTANCE, yCancVis);
               ObjectSetInteger(0, mem.obj_visCanc, OBJPROP_YDISTANCE, yCanc);
              }

            // E. Mover todas las líneas avanzadas (Módulos TS, BE, Grid, Edit)
            string bStart = MakeTMName(ticket, OP_HLINE_BE_START);
            string bOff   = MakeTMName(ticket, OP_HLINE_BE_OFF);
            string tStart = MakeTMName(ticket, OP_HLINE_TS_START);
            string tDist  = MakeTMName(ticket, OP_HLINE_TS_DIST);
            string eTP    = MakeTMName(ticket, OP_HLINE_EDIT_TP);
            string eSL    = MakeTMName(ticket, OP_HLINE_EDIT_SL);
            string ePr    = MakeTMName(ticket, OP_HLINE_EDIT_PR);

            FastSyncLineY(bStart, bStart, isBuyDir);
            FastSyncLineY(bOff,   bOff,   isBuyDir);
            FastSyncLineY(tStart, tStart, isBuyDir);
            FastSyncLineY(tDist,  tDist,  isBuyDir);
            FastSyncLineY(eTP,    eTP,    isBuyDir);
            FastSyncLineY(eSL,    eSL,    !isBuyDir);
            FastSyncLineY(ePr,    ePr,    isBuyDir);

            for(int k=1; k<=5; k++)
              {
               string gTP = MakeTMName(ticket, OP_HLINE_GRID_TP_1 + k - 1);
               string gSL = MakeTMName(ticket, OP_HLINE_GRID_SL_1 + k - 1);
               FastSyncLineY(gTP, gTP, isBuyDir);
               FastSyncLineY(gSL, gSL, !isBuyDir);
              }

            // --- FIX ERROR 1: ELIMINADO EL BLOQUE QUE MOVÍA LA VENTANA FLOTANTE ---
            // MT5 ahora dejará el menú (CCanvas) anclado a la pantalla perfectamente.
           }
        }
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              FastSyncUnifiedLine(string hLineName, string visNamePrefix, int xPos, int width, bool isAbove)
  {
   if(ObjectFind(0, visNamePrefix + "_Line") >= 0)
     {
      double price = ObjectGetDouble(0, hLineName, OBJPROP_PRICE);
      if(price > 0)
        {
         int dummyX = 0, y = 0;
         if(ChartTimePriceToXY(0, 0, TimeCurrent(), price, dummyX, y))
           {
            // Mover la línea visual (X, Y, Ancho)
            SmartSetInteger(visNamePrefix + "_Line", OBJPROP_XDISTANCE, xPos);
            SmartSetInteger(visNamePrefix + "_Line", OBJPROP_YDISTANCE, y);
            SmartSetInteger(visNamePrefix + "_Line", OBJPROP_XSIZE, width);

            int btnW = (int)ObjectGetInteger(0, visNamePrefix + "_Btn", OBJPROP_XSIZE);
            if(btnW == 0)
               btnW = 60; // Fallback
            int btnX = xPos + (width / 2) - (btnW / 2);
            int btnH = 16; // Altura estandar de nuestras etiquetas planas

            // --- LA SOLUCIÓN DEFINITIVA (Determinismo Puro) ---
            int btnY = isAbove ? (y - btnH) : (y + 1);

            SmartSetInteger(visNamePrefix + "_Btn", OBJPROP_XDISTANCE, btnX);
            SmartSetInteger(visNamePrefix + "_Btn", OBJPROP_YDISTANCE, btnY);
           }
        }
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              FastSyncLineY(string hLineName, string visNamePrefix, bool isAbove)
  {
// Solo hacemos la matemática si la línea visual está dibujada en pantalla
   if(ObjectFind(0, visNamePrefix + "_Line") >= 0)
     {
      double price = ObjectGetDouble(0, hLineName, OBJPROP_PRICE);
      if(price > 0)
        {
         int dummyX = 0, y = 0;
         if(ChartTimePriceToXY(0, 0, TimeCurrent(), price, dummyX, y))
           {
            int btnH = 16;

            // --- LA SOLUCIÓN DEFINITIVA (Determinismo Puro) ---
            int btnY = isAbove ? (y - btnH) : (y + 1);

            ObjectSetInteger(0, visNamePrefix + "_Line", OBJPROP_YDISTANCE, y);
            ObjectSetInteger(0, visNamePrefix + "_Btn", OBJPROP_YDISTANCE, btnY);
           }
        }
     }
  }

//+------------------------------------------------------------------+
//| INYECTAR LA CONFIGURACIÓN AL GESTOR (MOTOR UNIVERSAL)            |
//+------------------------------------------------------------------+
void              InjectSettingsToManager(ulong ticket, bool isTask, ScheduledTask &task, double executionTP = 0, double executionSL = 0)
  {
   CTradeState *mem = TradeRAM.Get(ticket);
   if(mem == NULL)
      return;

// --- NUEVO: EL PUENTE DE MEMORIA (De Panel a Gestor) ---
   string mComm = isTask ? "TimeTask" : PanelState.GetComment();
   if(mComm == "")
      mComm = "Comment";
   mem.customComment = mComm;

// 1. INYECTAR TRAILING STOP
   mem.ts.isActive = isTask ? task.ts.isActive : m_isTSActive;
   mem.ts.mode     = isTask ? task.ts.mode : m_tsMode;
   for(int i=0; i<6; i++)
     {
      mem.ts.inputs[i] = isTask ? task.ts.inputs[i] : TemplateState.ts.inputs[i];
      mem.ts.units[i]  = isTask ? task.ts.units[i] : TemplateState.ts.units[i];
      mem.ts.dropIdx[i] = isTask ? task.ts.dropIdx[i] : TemplateState.ts.dropIdx[i];
     }

// 2. INYECTAR BREAK EVEN
   mem.be.isActive  = isTask ? task.be.isActive : m_isBEActive;
   mem.be.isAuto    = isTask ? task.be.isAuto : m_isBE_AutoOffset;
   mem.be.valStart  = isTask ? task.be.valStart : TemplateState.be.valStart;
   mem.be.valOffset = isTask ? task.be.valOffset : TemplateState.be.valOffset;
   mem.be.modeStart = isTask ? task.be.modeStart : TemplateState.be.modeStart;
   mem.be.modeOffset= isTask ? task.be.modeOffset : TemplateState.be.modeOffset;

// 3. INYECTAR GRID
   mem.grid.distMode = isTask ? task.grid.distMode : m_distMode;
   mem.grid.lotMode  = isTask ? task.grid.lotMode : m_lotMode;
   for(int i=0; i<5; i++)
     {
      mem.grid.rows[i].isActiveTP  = isTask ? task.grid.rows[i].isActiveTP : TemplateState.grid.rows[i].isActiveTP;
      mem.grid.rows[i].isActiveSL  = isTask ? task.grid.rows[i].isActiveSL : TemplateState.grid.rows[i].isActiveSL;
      mem.grid.rows[i].valTP_Price = isTask ? task.grid.rows[i].valTP_Price : TemplateState.grid.rows[i].valTP_Price;
      mem.grid.rows[i].valTP_Vol   = isTask ? task.grid.rows[i].valTP_Vol : TemplateState.grid.rows[i].valTP_Vol;
      mem.grid.rows[i].valSL_Price = isTask ? task.grid.rows[i].valSL_Price : TemplateState.grid.rows[i].valSL_Price;
      mem.grid.rows[i].valSL_Vol   = isTask ? task.grid.rows[i].valSL_Vol : TemplateState.grid.rows[i].valSL_Vol;
     }

// 4. INYECTAR HIDE Y OCO
   mem.isHiddenActive = isTask ? task.isHide : m_isHideActive;
   if(mem.isHiddenActive)
     {
      mem.virtualTP = executionTP;
      mem.virtualSL = executionSL;
     }

   mem.isOCO = isTask ? task.isOCO : m_isOCOActive;

// 5. RASTRO DEL STOP LIMIT (DNA) PARA MT5
   if(OrderSelect(ticket))
     {
      long oType = OrderGetInteger(ORDER_TYPE);
      if(oType == ORDER_TYPE_BUY_STOP_LIMIT || oType == ORDER_TYPE_SELL_STOP_LIMIT)
        {
         double slimitPrice = OrderGetDouble(ORDER_PRICE_STOPLIMIT);
         if(slimitPrice > 0)
            mem.virtStopLimit = slimitPrice; // Reutilizamos esta variable como rastro DNA
        }
     }

//Print(">>> [TRACK BE 2] ADN Inyectado al Ticket #", ticket, " | ¿Es Fantasma/Virtual?: ", mem.isVirtual, " | BE Activo: ", mem.be.isActive);

// ¡MAGIA! Guardamos todo en el disco en 1 milisegundo
   SaveTradesToBin();
  }

//+------------------------------------------------------------------+
//| INYECTAR ADN A LAS FRACCIONES DEL SPLIT (MOTOR UNIVERSAL)        |
//+------------------------------------------------------------------+
void              InjectSplitOrderSettings(ulong ticket, double hiddenTP, double hiddenSL, bool isTask, ScheduledTask &task)
  {
   CTradeState *mem = TradeRAM.Get(ticket);
   if(mem == NULL)
      return;

// --- NUEVO: EL PUENTE DE MEMORIA PARA SPLITS ---
   string mComm = isTask ? "TimeTask" : PanelState.GetComment();
   if(mComm == "")
      mComm = "Comment";
   mem.customComment = mComm;
// -------------------------------------------------------

   bool srcHide = isTask ? task.isHide : m_isHideActive;
   bool srcOCO  = isTask ? task.isOCO  : m_isOCOActive; // <--- AÑADIDO: Rescatar el estado OCO del Panel/Task

// 1. APAGAR TS, BE y GRID para las porciones divididas
   mem.ts.isActive = false;
   mem.be.isActive = false;
   for(int i=0; i<5; i++)
     {
      mem.grid.rows[i].isActiveTP = false;
      mem.grid.rows[i].isActiveSL = false;
     }

// 2. APLICAR HIDE si estaba encendido en el origen
   if(srcHide)
     {
      mem.isHiddenActive = true;
      mem.virtualTP = hiddenTP;
      mem.virtualSL = hiddenSL;
     }
   else
     {
      mem.isHiddenActive = false;
     }

// 3. APLICAR OCO (El eslabón perdido)
   mem.isOCO = srcOCO; // <--- AÑADIDO: Clonar el estado OCO

   SaveTradesToBin(); // Guardamos el estado limpio
  }

//+------------------------------------------------------------------+
//| CONSTRUCTOR DE CACHÉ: Memoriza nombres y posiciones iniciales    |
//+------------------------------------------------------------------+
void              BuildDragCache(ulong target_ticket, int dragMode)
  {
   ArrayResize(g_dragCache, 0);
   ArrayResize(g_dragCacheStartX, 0); // Limpiamos memoria X
   ArrayResize(g_dragCacheStartY, 0); // Limpiamos memoria Y

   int total = ObjectsTotal(0, -1, -1);
   int count = 0;
   string sT = IntegerToString(target_ticket);

   for(int i = 0; i < total; i++)
     {
      string name = ObjectName(0, i, -1, -1);

      // 1. ARRASTRE DE VENTANA PRINCIPAL (SOLO MODO 5 Y 6)
      if((dragMode == 5) && (name == "CanvasOrderMenu_" + sT))
        {
         ArrayResize(g_dragCache, count + 1, 50);
         ArrayResize(g_dragCacheStartX, count + 1, 50);
         ArrayResize(g_dragCacheStartY, count + 1, 50);

         g_dragCache[count] = name;
         g_dragCacheStartX[count] = (int)ObjectGetInteger(0, name, OBJPROP_XDISTANCE);
         g_dragCacheStartY[count] = (int)ObjectGetInteger(0, name, OBJPROP_YDISTANCE);
         count++;
         continue;
        }

      ulong obj_id = StringToInteger(name);
      if(obj_id == 0)
         continue;

      ulong t = 0;
      int opcode = ParseTMObject(name, t);
      if(t != target_ticket)
         continue;

      // 3. ARRASTRE HORIZONTAL (Modo 1)
      if(dragMode == 1)
        {
         if((opcode >= OP_TM_ENTRY && opcode <= OP_TM_CANCEL_LBL) ||
            (opcode >= OP_TM_RECT_TP && opcode <= OP_TM_RECT_SL) ||
            opcode == OP_HLINE_CANCEL)
           {
            ArrayResize(g_dragCache, count + 1, 50);
            ArrayResize(g_dragCacheStartX, count + 1, 50);

            g_dragCache[count] = name;
            g_dragCacheStartX[count] = (int)ObjectGetInteger(0, name, OBJPROP_XDISTANCE);
            count++;
           }
        }

      // 4. ARRASTRE VERTICAL (Modo 6)
      else
         if(dragMode == 6)
           {
            if(opcode == OP_TM_SEC || opcode == OP_HLINE_SEC || opcode == OP_TM_CANCEL_LBL || opcode == OP_HLINE_CANCEL)
               continue;

            if((opcode >= OP_TM_ENTRY && opcode <= OP_TM_CANCEL_TOGGLE) ||
               (opcode >= OP_TM_RECT_TP && opcode <= OP_TM_RECT_SL) ||
               (opcode >= OP_HLINE_ENTRY && opcode <= OP_HLINE_SL))
              {
               ArrayResize(g_dragCache, count + 1, 50);
               ArrayResize(g_dragCacheStartY, count + 1, 50);

               g_dragCache[count] = name;
               g_dragCacheStartY[count] = (int)ObjectGetInteger(0, name, OBJPROP_YDISTANCE);
               count++;
              }
           }
     }
  }

// ====================================================================
// MOTOR UNIVERSAL DE INTERFAZ (UI ENGINE - DELTA DRAG)
// ====================================================================
string            g_uiCache[];
int    g_uiLastX = 0;
int    g_uiLastY = 0;


// Helper para agregar a la caché solo si el objeto está dibujado en el gráfico
void              PushToUICache(string name, int &count)
  {
   if(ObjectFind(0, name) >= 0)
     {
      // Reservamos espacio de poco a poco para no saturar
      ArrayResize(g_uiCache, count + 1, 50);
      g_uiCache[count] = name;
      count++;
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              MoveUICache(int deltaX, int deltaY)
  {
   if(deltaX == 0 && deltaY == 0)
      return;

   int total = ArraySize(g_uiCache);
   for(int i = 0; i < total; i++)
     {
      int oldX = (int)ObjectGetInteger(0, g_uiCache[i], OBJPROP_XDISTANCE);
      int oldY = (int)ObjectGetInteger(0, g_uiCache[i], OBJPROP_YDISTANCE);

      // Movemos el objeto sumando solo la diferencia del ratón (Cero lag, cero saltos)
      ObjectSetInteger(0, g_uiCache[i], OBJPROP_XDISTANCE, oldX + deltaX);
      ObjectSetInteger(0, g_uiCache[i], OBJPROP_YDISTANCE, oldY + deltaY);
     }
  }
//+------------------------------------------------------------------+
//| OBTIENE LA COMISIÓN REAL DE UNA POSICIÓN (100% RAM DRIVEN O(1))  |
//+------------------------------------------------------------------+
double            GetPositionCommission(ulong ticket)
  {
// Leemos directamente del cerebro en RAM. ¡Cero Bases de Datos!
   CTradeState *mem = TradeRAM.Get(ticket);
   if(mem != NULL)
      return mem.currentComm;

   return 0.0;
  }

//+------------------------------------------------------------------+
//| SINCRONIZA ESTADOS GLOBALES HACIA LA RAM (CERO LECTURA DE TEXTOS)|
//+------------------------------------------------------------------+
void              SyncPanelToTemplateState()
  {
   if(TemplateState == NULL)
      return;

// 1. SINCRONIZAR TRAILING STOP AL TEMPLATE
   TemplateState.ts.isActive = m_isTSActive;
   TemplateState.ts.mode = m_tsMode;

// 2. SINCRONIZAR BREAK EVEN AL TEMPLATE
   TemplateState.be.isActive = m_isBEActive;
   TemplateState.be.isAuto = m_isBE_AutoOffset;

// 3. SINCRONIZAR GRID AL TEMPLATE
   TemplateState.grid.distMode = m_distMode;
   TemplateState.grid.lotMode  = m_lotMode;

// NOTA: ¡No leemos inputs de texto aquí! La RAM ya se actualiza
// instantáneamente en ProcessGhostInputSave() al presionar Enter.
  }

//+------------------------------------------------------------------+
//| MOTOR UNIVERSAL: Obtiene datos del Panel (0), Virtual o Real(>0) |
//+------------------------------------------------------------------+
bool              GetUnifiedTradeInfo(ulong ticket, double &entry, double &sl, double &tp, double &vol, long &type, CTradeState* &mem)
  {
   if(ticket == 0) // MODO PANEL (PLANTILLA PRE-OPERACIÓN)
     {
      // --- VACUNA 1: PROTEGER EL PANEL PRINCIPAL ---
      if(CheckPointer(TemplateState) == POINTER_INVALID)
         return false;

      entry = ObjectGetDouble(0, m_lineEntry, OBJPROP_PRICE);
      if(entry <= 0)
         return false;

      sl  = ObjectGetDouble(0, m_lineSL, OBJPROP_PRICE);
      tp  = ObjectGetDouble(0, m_lineTP, OBJPROP_PRICE);
      vol = PanelState.GetLot();

      if(sl > 0)
         type = (sl < entry) ? POSITION_TYPE_BUY : POSITION_TYPE_SELL;
      else
         type = (tp > entry) ? POSITION_TYPE_BUY : POSITION_TYPE_SELL;

      mem = TemplateState;
      return true;
     }
   else
      if(ticket >= VIRTUAL_TICKET_BASE) // MODO ÓRDENES VIRTUALES
        {
         mem = TradeRAM.Get(ticket);
         // --- VACUNA 2: PROTEGER VIRTUALES ---
         if(CheckPointer(mem) == POINTER_INVALID || !mem.isVirtual)
            return false;

         entry = mem.virtEntry;
         sl    = mem.virtSL;
         tp    = mem.virtTP;
         vol   = mem.virtLot;
         type  = mem.virtType;

         if(mem.isHiddenActive)
           {
            sl = mem.virtualSL;
            tp = mem.virtualTP;
           }
         return true;
        }
      else // MODO ORDEN / POSICIÓN VIVA (REAL)
        {
         mem = TradeRAM.Get(ticket);
         // --- VACUNA 3: PROTEGER REALES ---
         if(CheckPointer(mem) == POINTER_INVALID)
            return false;

         // 🛡️ LECTURA 100% DESDE LA RAM (Oráculo Optimista)
         entry = mem.openPrice;
         sl    = mem.slPrice;
         tp    = mem.tpPrice;
         vol   = mem.currentVol;
         type  = mem.type;

         // Fallback de seguridad: Si la RAM está vacía (recién abrimos el EA y el Oráculo no ha leído)
         if(entry == 0 && vol == 0)
           {
            if(PositionSelectByTicket(ticket))
              {
               entry = PositionGetDouble(POSITION_PRICE_OPEN);
               sl    = PositionGetDouble(POSITION_SL);
               tp    = PositionGetDouble(POSITION_TP);
               vol   = PositionGetDouble(POSITION_VOLUME);
               type  = PositionGetInteger(POSITION_TYPE);
              }
            else
               if(OrderSelect(ticket))
                 {
                  type  = OrderGetInteger(ORDER_TYPE);
                  if(type == ORDER_TYPE_BUY_STOP_LIMIT || type == ORDER_TYPE_SELL_STOP_LIMIT)
                     entry = OrderGetDouble(ORDER_PRICE_STOPLIMIT);
                  else
                     entry = OrderGetDouble(ORDER_PRICE_OPEN);

                  sl    = OrderGetDouble(ORDER_SL);
                  tp    = OrderGetDouble(ORDER_TP);
                  vol   = OrderGetDouble(ORDER_VOLUME_CURRENT);
                 }
               else
                  return false;
           }

         if(mem.isHiddenActive)
           {
            sl = mem.virtualSL;
            tp = mem.virtualTP;
           }
         return true;
        }
  }
//+------------------------------------------------------------------+

//+------------------------------------------------------------------+
//| DIBUJAR LÍNEA BE/TS EN POSICIÓN X ESPECÍFICA (ANCHO DINÁMICO)    |
//+------------------------------------------------------------------+
void              DrawChartLineBE(string name, double price, color clr, string text, int xPos, int width)
  {
   string nameLine = name + "_Line";
   string nameBtn  = name + "_Btn";

   int xDummy, yLine;
   if(!ChartTimePriceToXY(0, 0, TimeCurrent(), price, xDummy, yLine))
      return;

// 1. LÍNEA
   if(ObjectFind(0, nameLine) < 0)
     {
      ObjectCreate(0, nameLine, OBJ_RECTANGLE_LABEL, 0, 0, 0);
      SmartSetInteger(nameLine, OBJPROP_YSIZE, 1);
      SmartSetInteger(nameLine, OBJPROP_BORDER_TYPE, BORDER_FLAT);
     }
   SmartSetInteger(nameLine, OBJPROP_XSIZE, width);
   SmartSetInteger(nameLine, OBJPROP_XDISTANCE, xPos);
   SmartSetInteger(nameLine, OBJPROP_YDISTANCE, yLine);
   SmartSetInteger(nameLine, OBJPROP_BGCOLOR, clr);

// 2. ETIQUETA PLANA
   int btnW = 65;
   int btnH = 16;
   int btnX = xPos + (width / 2) - (btnW / 2);

   if(ObjectFind(0, nameBtn) < 0)
     {
      ObjectCreate(0, nameBtn, OBJ_EDIT, 0, 0, 0);
      SmartSetInteger(nameBtn, OBJPROP_FONTSIZE, 8);
      ObjectSetString(0, nameBtn, OBJPROP_FONT, "Arial");
      SmartSetInteger(nameBtn, OBJPROP_ALIGN, ALIGN_CENTER);
      SmartSetInteger(nameBtn, OBJPROP_READONLY, true);
      SmartSetInteger(nameBtn, OBJPROP_SELECTABLE, false);
      SmartSetInteger(nameBtn, OBJPROP_ZORDER, 12);
     }

   SmartSetInteger(nameBtn, OBJPROP_XSIZE, btnW);
   SmartSetInteger(nameBtn, OBJPROP_YSIZE, btnH);
   SmartSetInteger(nameBtn, OBJPROP_XDISTANCE, btnX);
   SmartSetInteger(nameBtn, OBJPROP_YDISTANCE, yLine - (btnH/2));

   SmartSetInteger(nameBtn, OBJPROP_BGCOLOR, clr);
   SmartSetInteger(nameBtn, OBJPROP_BORDER_COLOR, clr);
   SmartSetInteger(nameBtn, OBJPROP_COLOR, clrWhite);
   ObjectSetString(0, nameBtn, OBJPROP_TEXT, text);
  }

//+------------------------------------------------------------------+
//| DIBUJAR LÍNEA GRID EN POSICIÓN X ESPECÍFICA (ANCHO DINÁMICO)     |
//+------------------------------------------------------------------+
void              DrawChartLineWithLabel(string name, double price, color clr, string text, int xPos, int width)
  {
   string nameLine = name + "_Line";
   string nameBtn  = name + "_Btn";

   int xDummy, yLine;
   if(!ChartTimePriceToXY(0, 0, TimeCurrent(), price, xDummy, yLine))
      return;

// 1. LÍNEA SÓLIDA (Riel visual)
   if(ObjectFind(0, nameLine) < 0)
     {
      ObjectCreate(0, nameLine, OBJ_RECTANGLE_LABEL, 0, 0, 0);
      SmartSetInteger(nameLine, OBJPROP_CORNER, CORNER_LEFT_UPPER);
      SmartSetInteger(nameLine, OBJPROP_YSIZE, 1);
      SmartSetInteger(nameLine, OBJPROP_BACK, false);
      SmartSetInteger(nameLine, OBJPROP_ZORDER, 10);
      SmartSetInteger(nameLine, OBJPROP_BORDER_TYPE, BORDER_FLAT);
     }
   SmartSetInteger(nameLine, OBJPROP_XSIZE, width);
   SmartSetInteger(nameLine, OBJPROP_XDISTANCE, xPos);
   SmartSetInteger(nameLine, OBJPROP_YDISTANCE, yLine);
   SmartSetInteger(nameLine, OBJPROP_BGCOLOR, clr);

// 2. ETIQUETA PLANA (Reemplaza al botón viejo)
   int btnW = 85; // Un poco más ancho para que respire el texto
   int btnH = 16; // Altura elegante
   int btnX = xPos + (width / 2) - (btnW / 2);
   int btnY = yLine - (btnH / 2); // Centrado exacto en la línea

   if(ObjectFind(0, nameBtn) < 0)
     {
      ObjectCreate(0, nameBtn, OBJ_EDIT, 0, 0, 0); // <--- OBJ_EDIT
      SmartSetInteger(nameBtn, OBJPROP_CORNER, CORNER_LEFT_UPPER);
      SmartSetInteger(nameBtn, OBJPROP_FONTSIZE, 8);
      ObjectSetString(0, nameBtn, OBJPROP_FONT, "Arial");
      SmartSetInteger(nameBtn, OBJPROP_ALIGN, ALIGN_CENTER);
      SmartSetInteger(nameBtn, OBJPROP_READONLY, true);
      SmartSetInteger(nameBtn, OBJPROP_SELECTABLE, false);
      SmartSetInteger(nameBtn, OBJPROP_ZORDER, 11); // Encima de la línea
     }

   SmartSetInteger(nameBtn, OBJPROP_XSIZE, btnW);
   SmartSetInteger(nameBtn, OBJPROP_YSIZE, btnH);
   SmartSetInteger(nameBtn, OBJPROP_XDISTANCE, btnX);
   SmartSetInteger(nameBtn, OBJPROP_YDISTANCE, btnY);

   SmartSetInteger(nameBtn, OBJPROP_BGCOLOR, clr);
   SmartSetInteger(nameBtn, OBJPROP_BORDER_COLOR, clr); // Borde invisible
   SmartSetInteger(nameBtn, OBJPROP_COLOR, clrWhite);
   ObjectSetString(0, nameBtn, OBJPROP_TEXT, text);
  }

//+------------------------------------------------------------------+
//| LÓGICA BREAK EVEN VISUAL UNIVERSAL                               |
//+------------------------------------------------------------------+
void              UpdateBELogic(ulong ticket, int xPos)
  {
   double entry, sl, tp, vol;
   long type;
   CTradeState *mem;

   if(!GetUnifiedTradeInfo(ticket, entry, sl, tp, vol, type, mem))
      return;

   if(CheckPointer(mem) == POINTER_INVALID)
      return; // <-- ESCUDO
   if(mem.isCollapsed && ticket > 0)
     {
      DeleteBELines(ticket);
      return;
     }

   bool isActive = mem.be.isActive;
   bool isMenuOpen = false;
   if(ticket > 0)
      isMenuOpen = (mem.activeSubMenu == OP_TM_M_BE); // <-- AHORA LEE EL ESTADO DEL CCANVAS

   bool showLines = (isActive || isMenuOpen || (g_isDragging && g_dragTicket == ticket && (g_dragType == 30 || g_dragType == 31)));
   if(ticket == 0)
      showLines = isActive; // Para el panel no hay fantasmas

   if(!showLines)
     {
      DeleteBELines(ticket);
      return;
     }

   bool isBuy = (type == POSITION_TYPE_BUY || type == ORDER_TYPE_BUY_LIMIT || type == ORDER_TYPE_BUY_STOP || type == ORDER_TYPE_BUY_STOP_LIMIT);

   double point    = Market.point;
//int digits      = Market.digits;
   double mul      = Market.multiplier;
   double tickVal  = Market.tickValue;
   double tickSize = Market.tickSize;
   string cur      = AccountInfoString(ACCOUNT_CURRENCY);
   int drawWidth = (ticket == 0) ? FIGURE_WIDTH : TM_FIGURE_WIDTH;

// --- A. DIBUJAR LÍNEA START (Gatillo) ---
   string baseBEStart = MakeTMName(ticket, OP_HLINE_BE_START);
   bool isDraggingStart = (g_isDragging && g_dragTicket == ticket && g_dragType == 30);
   double priceStart = isDraggingStart ? ObjectGetDouble(0, baseBEStart, OBJPROP_PRICE) : GetBELevelPrice(ticket, 0, entry);

   if(priceStart > 0)
     {
      UpdateInvisibleLine(baseBEStart, priceStart, clrNONE, 30);
      string txtStart = StringFormat("BE %.0f | RR %.2f", MathAbs(priceStart - entry) / mul, (sl > 0 && MathAbs(entry - sl) > point) ? MathAbs(entry - priceStart) / MathAbs(entry - sl) : 0);
      color drawColBEStart = isActive ? C'175,108,58' : LighterColor(C'175,108,58', 50);
      DrawAdvancedLineTV(baseBEStart, priceStart, drawColBEStart, txtStart, xPos, drawWidth, isBuy);
     }

// // --- B. DIBUJAR LÍNEA OFFSET (Donde quedará el SL) ---
   string baseBEOff = MakeTMName(ticket, OP_HLINE_BE_OFF);
   bool isDraggingOff = (g_isDragging && g_dragTicket == ticket && g_dragType == 31);
   double priceOff = 0;

   if(isDraggingOff)
      priceOff = ObjectGetDouble(0, baseBEOff, OBJPROP_PRICE);
   else
      if(mem.be.isAuto) // <--- ¡ELIMINAMOS EL "&& ticket > 0"!
         priceOff = isBuy ? entry + GetAutoBEPoints(ticket) : entry - GetAutoBEPoints(ticket);
      else
         priceOff = GetBELevelPrice(ticket, 1, entry);

   if(priceOff > 0)
     {
      UpdateInvisibleLine(baseBEOff, priceOff, clrNONE, 31);
      string txtOff = StringFormat("SL %.0f | %.2f %s", MathAbs(priceOff - entry) / mul, (tickSize > 0) ? (MathAbs(entry - priceOff) / tickSize) * tickVal * vol : 0, cur);
      color drawColBEOff = isActive ? C'198,132,83' : LighterColor(C'198,132,83', 50);
      DrawAdvancedLineTV(baseBEOff, priceOff, drawColBEOff, txtOff, xPos, drawWidth, isBuy);
     }
  }

//+------------------------------------------------------------------+
//| 2. DIBUJAR VISUALES TS - (AMBAS LÍNEAS PARA EL PANEL)            |
//+------------------------------------------------------------------+
void              DrawTSVisuals(ulong ticket, TS_Calculation &calc, int xPos)
  {
   CTradeState *mem = TradeRAM.Get(ticket);
   if(ticket == 0)
      mem = TemplateState;

   if(CheckPointer(mem) == POINTER_INVALID)
     {
      calc.isValid = false;
      return;
     }
   if(mem.isCollapsed && ticket > 0)
      calc.isValid = false;

   string baseStart = MakeTMName(ticket, OP_HLINE_TS_START);
   string baseDist  = MakeTMName(ticket, OP_HLINE_TS_DIST);

   if(!calc.isValid)
     {
      ObjectDelete(0, baseStart);
      ObjectDelete(0, baseStart + "_Line");
      ObjectDelete(0, baseStart + "_Btn");
      ObjectDelete(0, baseDist);
      ObjectDelete(0, baseDist + "_Line");
      ObjectDelete(0, baseDist + "_Btn");
      return;
     }

   bool isSystemTurnedOn = (mem != NULL && mem.ts.isActive);
   int drawWidth  = (ticket == 0) ? FIGURE_WIDTH : TM_FIGURE_WIDTH;

   double point    = Market.point;
   int dig      = Market.digits;
   double mul      = Market.multiplier;
   double tickVal  = Market.tickValue;
   double tickSize = Market.tickSize;
   string cur      = AccountInfoString(ACCOUNT_CURRENCY);

   double entry, sl, tp, vol;
   long type;
   CTradeState *dummyMem;
   GetUnifiedTradeInfo(ticket, entry, sl, tp, vol, type, dummyMem);
   bool isBuy = (type == POSITION_TYPE_BUY || type == ORDER_TYPE_BUY_LIMIT || type == ORDER_TYPE_BUY_STOP || type == ORDER_TYPE_BUY_STOP_LIMIT);

   string modeStr = g_tsModes[mem.ts.mode];

// --- A. LÍNEA START (Gatillo) ---
   bool draggingStart = (g_isDragging && g_dragTicket == ticket && g_dragType == 40);

   if(!calc.isActive || draggingStart || ticket == 0)
     {
      double pDraw = draggingStart ? ObjectGetDouble(0, baseStart, OBJPROP_PRICE) : calc.startPrice;
      if(pDraw > 0)
        {
         UpdateInvisibleLine(baseStart, pDraw, clrNONE, 40);
         double distStart = MathAbs(pDraw - entry) / mul;
         string txtStart = StringFormat("TS %.0f | %s", distStart, modeStr);
         color drawColTSStart = isSystemTurnedOn ? C'60,95,147' : LighterColor(C'60,95,147', 50);

         DrawAdvancedLineTV(baseStart, pDraw, drawColTSStart, txtStart, xPos, drawWidth, isBuy);
        }
     }
   else
     {
      ObjectDelete(0, baseStart);
      ObjectDelete(0, baseStart + "_Line");
      ObjectDelete(0, baseStart + "_Btn");
     }

// --- B. LÍNEA DIST/TARGET (Donde quedará el SL) ---
   bool draggingDist = (g_isDragging && g_dragTicket == ticket && g_dragType == 41);
   double pTarget = draggingDist ? ObjectGetDouble(0, baseDist, OBJPROP_PRICE) : calc.targetPrice;

   if(pTarget > 0)
     {
      UpdateInvisibleLine(baseDist, pTarget, clrNONE, 41);
      double distTarget = MathAbs(pTarget - entry) / mul;
      double moneyEst = (tickSize > 0) ? (MathAbs(entry - pTarget) / tickSize) * tickVal * vol : 0;
      string txtDist = StringFormat("TS %.0f | %.2f %s | %s", distTarget, moneyEst, cur, modeStr);
      color drawColTSDist = isSystemTurnedOn ? C'73,117,182' : LighterColor(C'73,117,182', 50);

      DrawAdvancedLineTV(baseDist, pTarget, drawColTSDist, txtDist, xPos, drawWidth, isBuy);
     }
   else
     {
      ObjectDelete(0, baseDist);
      ObjectDelete(0, baseDist + "_Line");
      ObjectDelete(0, baseDist + "_Btn");
     }
  }
//+------------------------------------------------------------------+
//| CÁLCULO INVERSO PARA BREAK EVEN (Unificado)                      |
//+------------------------------------------------------------------+
void              UpdateInputFromBEDrag(ulong ticket, int dragType, double newPrice)
  {
   double entry, sl, tp, vol;
   long type;
   CTradeState *mem;
   if(!GetUnifiedTradeInfo(ticket, entry, sl, tp, vol, type, mem))
      return;

   double point    = Market.point;
//int digits      = Market.digits;
   double mul      = Market.multiplier;
   int mode = (dragType == 30) ? mem.be.modeStart : mem.be.modeOffset;
   double newVal = 0;
   double distPrice = MathAbs(newPrice - entry);

   if(mode == 0)
      newVal = distPrice / mul;
   else
      if(mode == 1)
         newVal = (dragType == 31 && mode == 1) ? newPrice : (distPrice / mul);

// ACTUALIZAR RAM, DISCO Y UI (Panel)
   string sT = IntegerToString(ticket);
   if(dragType == 30)
     {
      mem.be.valStart = newVal;



     }
   else
     {



      mem.be.valOffset = newVal;
      if(ticket > 0)
        {

         string inName = "TM_UI_" + sT + "_M_SubBE_InOff";
         if(ObjectFind(0, inName) >= 0)
           {
            if(mem.be.isAuto)
               ObjectSetString(0, inName, OBJPROP_TEXT, "AUTO");
            else
               ObjectSetString(0, inName, OBJPROP_TEXT, DoubleToString(newVal, (mode==0)?0:2));
           }
        }


     }
  }

//+------------------------------------------------------------------+
//| CÁLCULO INVERSO PARA TRAILING STOP (Unificado e Independiente)   |
//+------------------------------------------------------------------+
void              UpdateInputFromTSDrag(ulong ticket, int dragType, double newPrice)
  {
   double entry, sl, tp, vol;
   long type;
   CTradeState *mem;
   if(!GetUnifiedTradeInfo(ticket, entry, sl, tp, vol, type, mem))
      return;

   double point    = Market.point;
   double mul      = Market.multiplier;

// =========================================================
// 1. SI MOVEMOS LA LÍNEA START (Gatillo)
// =========================================================
   if(dragType == 40)
     {
      // A. Actualizamos la memoria del Start (inputs[0])
      int modeStart = mem.ts.units[0];
      double distStartAbs = MathAbs(newPrice - entry);
      double newStartVal = 0;

      if(modeStart == 0)
         newStartVal = distStartAbs / mul;
      else
         if(modeStart == 1)
           {
            double r = MathAbs(entry - sl);
            if(r < point)
               r = 50*mul;
            newStartVal = distStartAbs / r;
           }
         else
            if(modeStart == 2)
               newStartVal = (distStartAbs / entry) * 100.0;
            else
               if(modeStart == 3)
                 {
                  if(tp > 0)
                     newStartVal = (distStartAbs / MathAbs(tp - entry)) * 100.0;
                  else
                     newStartVal = 20;
                 }

      mem.ts.inputs[0] = newStartVal; // Guardamos en RAM

      // B. ¡LA MAGIA! Compensamos la distancia (inputs[1]) para que la línea Dist no salte
      string distLineName = MakeTMName(ticket, OP_HLINE_TS_DIST);
      if(ObjectFind(0, distLineName) >= 0)
        {
         double currentDistPrice = ObjectGetDouble(0, distLineName, OBJPROP_PRICE);
         if(currentDistPrice > 0)
           {
            int modeDist = mem.ts.units[1];
            double distTargetAbs = MathAbs(currentDistPrice - newPrice); // Diferencia entre la NUEVA start y la VIEJA dist
            double newDistVal = 0;

            if(modeDist == 0)
               newDistVal = distTargetAbs / mul;
            else
               if(modeDist == 1)
                 {
                  double r = MathAbs(entry - sl);
                  if(r < point)
                     r = 50*mul;
                  newDistVal = distTargetAbs / r;
                 }
               else
                  if(modeDist == 2)
                     newDistVal = (distTargetAbs / entry) * 100.0;
                  else
                     if(modeDist == 3)
                       {
                        if(tp > 0)
                           newDistVal = (distTargetAbs / MathAbs(tp - entry)) * 100.0;
                        else
                           newDistVal = 20;
                       }

            mem.ts.inputs[1] = newDistVal; // Guardamos el valor compensado en la RAM

            // Actualizamos visualmente el texto del input "Dist" en el submenú si está abierto (Gestor EA2)
            if(ticket > 0)
              {
               string inNameDist = "TM_UI_" + IntegerToString(ticket) + "_M_SubTS_In1";
               if(ObjectFind(0, inNameDist) >= 0)
                  ObjectSetString(0, inNameDist, OBJPROP_TEXT, DoubleToString(newDistVal, (modeDist==0)?0:2));
              }
           }
        }

      // C. Actualizamos visualmente el texto del input "Start" en el submenú (Gestor EA2)
      if(ticket > 0)
        {
         string inNameStart = "TM_UI_" + IntegerToString(ticket) + "_M_SubTS_In0";
         if(ObjectFind(0, inNameStart) >= 0)
            ObjectSetString(0, inNameStart, OBJPROP_TEXT, DoubleToString(newStartVal, (modeStart==0)?0:2));
        }
     }

// =========================================================
// 2. SI MOVEMOS LA LÍNEA DIST (Target/SL)
// =========================================================
   else
      if(dragType == 41)
        {
         int modeDist = mem.ts.units[1];

         // Buscamos dónde está la línea Start en este momento
         string startLineName = MakeTMName(ticket, OP_HLINE_TS_START);
         double startPrice = ObjectGetDouble(0, startLineName, OBJPROP_PRICE);

         // Si la línea Start ya desapareció (porque el TS ya se activó y está persiguiendo), usamos el Ancla
         if(startPrice <= 0)
           {
            if(mem.ts.isActive && mem.ts.anchorPrice > 0)
               startPrice = mem.ts.anchorPrice;
            else
               startPrice = entry;
           }

         // Calculamos la distancia desde el nuevo punto que soltamos hasta el Start/Ancla
         double distAbs = MathAbs(newPrice - startPrice);
         double newDistVal = 0;

         if(modeDist == 0)
            newDistVal = distAbs / mul;
         else
            if(modeDist == 1)
              {
               double r = MathAbs(entry - sl);
               if(r < point)
                  r = 50*mul;
               newDistVal = distAbs / r;
              }
            else
               if(modeDist == 2)
                  newDistVal = (distAbs / entry) * 100.0;
               else
                  if(modeDist == 3)
                    {
                     if(tp > 0)
                        newDistVal = (distAbs / MathAbs(tp - entry)) * 100.0;
                     else
                        newDistVal = 20;
                    }

         mem.ts.inputs[1] = newDistVal; // Guardamos en RAM

         // Actualizamos visualmente el texto del input "Dist" en el submenú
         if(ticket > 0)
           {
            string inNameDist = "TM_UI_" + IntegerToString(ticket) + "_M_SubTS_In1";
            if(ObjectFind(0, inNameDist) >= 0)
               ObjectSetString(0, inNameDist, OBJPROP_TEXT, DoubleToString(newDistVal, (modeDist==0)?0:2));
           }
        }
  }

//+------------------------------------------------------------------+
//| CÁLCULO INVERSO PARA GRID (Unificado)                            |
//+------------------------------------------------------------------+
void              UpdateInputFromGridDrag(ulong ticket, int row, int dragType, double newPrice)
  {
   double entry, sl, tp, vol;
   long type;
   CTradeState *mem;
   if(!GetUnifiedTradeInfo(ticket, entry, sl, tp, vol, type, mem))
      return;

   double point    = Market.point;
   int digits      = Market.digits;
   double mul      = Market.multiplier;

   int distMode = mem.grid.distMode;
   double newVal = 0.0;
   int showDigits = 1;

   if(distMode == 1)
     {
      newVal = newPrice;
      showDigits = digits;
     }
   else
      if(distMode == 2)
        {
         double riskDist = MathAbs(entry - sl);
         if(riskDist < point)
            riskDist = 50 * mul;
         newVal = MathAbs(newPrice - entry) / riskDist;
         showDigits = 2;
        }
      else
        {
         newVal = MathAbs(newPrice - entry) / mul;
         showDigits = 1;
        }

   int rowIdx = row - 1;
   if(dragType == 1)
      mem.grid.rows[rowIdx].valTP_Price = newVal;
   else
      mem.grid.rows[rowIdx].valSL_Price = newVal;

   if(ticket > 0)
     {
      string typeStr = (dragType == 1) ? "TP" : "SL";
      string objName = "TM_UI_" + IntegerToString(ticket) + "_M_SubGrid_In" + typeStr + "_P_" + IntegerToString(row);
      ObjectSetString(0, objName, OBJPROP_TEXT, DoubleToString(newVal, showDigits));
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              MoveUnifiedLineByDelta(string name, double delta)
  {
   double p = ObjectGetDouble(0, name, OBJPROP_PRICE);
   if(p > 0)
      ObjectSetDouble(0, name, OBJPROP_PRICE, p + delta);
  }


//+------------------------------------------------------------------+
//| FUNCIÓN DE TRASPLANTE DE CEREBRO (Virtual . Real)               |
//+------------------------------------------------------------------+
void              MigrateVirtualSettings(ulong vTicket, ulong realTicket)
  {
   CTradeState *vMem = TradeRAM.Get(vTicket);
   CTradeState *rMem = TradeRAM.Get(realTicket); // Esto crea la memoria para el nuevo ticket real

   if(vMem == NULL || rMem == NULL)
      return;

// 1. Heredar configuraciones críticas
   rMem.isHiddenActive = vMem.isHiddenActive;
   rMem.virtualTP      = vMem.virtualTP;
   rMem.virtualSL      = vMem.virtualSL;

   rMem.ts             = vMem.ts;
   rMem.be             = vMem.be;
   rMem.grid           = vMem.grid;
   rMem.customColor    = vMem.customColor;

// 2. Migrar las variables globales en el disco (Tú ya tienes esta función hecha)
   MigrateTradeSettings(vTicket, realTicket);
  }


