//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void WriteAlertsToDisk()
  {
   int total = ArraySize(m_activeAlerts);
   ArrayResize(g_alertsDisk, total);

   for(int i = 0; i < total; i++)
     {
      g_alertsDisk[i].id         = m_activeAlerts[i].id;
      g_alertsDisk[i].modeIndex  = m_activeAlerts[i].modeIndex;
      g_alertsDisk[i].isActive   = m_activeAlerts[i].isActive;
      g_alertsDisk[i].isTrend    = m_activeAlerts[i].isTrend;
      g_alertsDisk[i].fixedPrice = m_activeAlerts[i].fixedPrice;
      g_alertsDisk[i].t1         = m_activeAlerts[i].t1;
      g_alertsDisk[i].p1         = m_activeAlerts[i].p1;
      g_alertsDisk[i].t2         = m_activeAlerts[i].t2;
      g_alertsDisk[i].p2         = m_activeAlerts[i].p2;
      StringToCharArray(m_activeAlerts[i].symbol, g_alertsDisk[i].symbol);
     }

   string filePath = g_dataPath + "TM_Alerts.bin";
   int file = FileOpen(filePath, FILE_WRITE|FILE_BIN);
   if(file != INVALID_HANDLE)
     {
      FileWriteArray(file, g_alertsDisk);
      FileClose(file);
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void LoadAlertsFromBin()
  {
   string filePath = g_dataPath + "TM_Alerts.bin";
   if(!FileIsExist(filePath))
      return;

   int file = FileOpen(filePath, FILE_READ|FILE_BIN);
   if(file != INVALID_HANDLE)
     {
      FileReadArray(file, g_alertsDisk);
      FileClose(file);

      int total = ArraySize(g_alertsDisk);
      ArrayResize(m_activeAlerts, total);
      ulong maxId = 0;

      for(int i = 0; i < total; i++)
        {
         m_activeAlerts[i].id         = g_alertsDisk[i].id;
         m_activeAlerts[i].modeIndex  = g_alertsDisk[i].modeIndex;
         m_activeAlerts[i].isActive   = g_alertsDisk[i].isActive;
         m_activeAlerts[i].isTrend    = g_alertsDisk[i].isTrend;
         m_activeAlerts[i].fixedPrice = g_alertsDisk[i].fixedPrice;
         m_activeAlerts[i].t1         = g_alertsDisk[i].t1;
         m_activeAlerts[i].p1         = g_alertsDisk[i].p1;
         m_activeAlerts[i].t2         = g_alertsDisk[i].t2;
         m_activeAlerts[i].p2         = g_alertsDisk[i].p2;
         m_activeAlerts[i].symbol     = CharArrayToString(g_alertsDisk[i].symbol);
         m_activeAlerts[i].last_time_msc = 0; // Reset para que evalúe de inmediat
         m_activeAlerts[i].last_trigger_time = 0; // <--- NUEVO

         if(m_activeAlerts[i].id > maxId)
            maxId = m_activeAlerts[i].id;
        }
      g_alarmCounter = maxId; // Restauramos el último ID usado
     }
  }

//+------------------------------------------------------------------+
//| EL PINTOR FANTASMA: Revive las alarmas al cambiar de gráfico     |
//+------------------------------------------------------------------+
void RestoreAlertVisuals()
  {
   int total = ArraySize(m_activeAlerts);
   for(int i = 0; i < total; i++)
     {
      // Solo dibujamos las que pertenecen al gráfico actual
      if(m_activeAlerts[i].symbol != _Symbol)
         continue;

      string name = MakeTMName(m_activeAlerts[i].id, OP_ALARM_LINE);

      if(ObjectFind(m_chartId, name) < 0)
        {
         bool created = false;
         if(m_activeAlerts[i].isTrend)
           {
            created = ObjectCreate(m_chartId, name, OBJ_TREND, 0, m_activeAlerts[i].t1, m_activeAlerts[i].p1, m_activeAlerts[i].t2, m_activeAlerts[i].p2);
            if(created)
               ObjectSetInteger(m_chartId, name, OBJPROP_RAY_RIGHT, true);
           }
         else
           {
            created = ObjectCreate(m_chartId, name, OBJ_HLINE, 0, 0, m_activeAlerts[i].fixedPrice);
           }

         if(created)
           {
            // Rojo si está esperando, Azul si ya cruzó
            color c = m_activeAlerts[i].isActive ? clrRed : clrBlue;
            ObjectSetInteger(m_chartId, name, OBJPROP_COLOR, c);
            ObjectSetInteger(m_chartId, name, OBJPROP_STYLE, STYLE_DASHDOT);
            ObjectSetInteger(m_chartId, name, OBJPROP_WIDTH, 1);
            ObjectSetInteger(m_chartId, name, OBJPROP_SELECTABLE, true);
            ObjectSetInteger(m_chartId, name, OBJPROP_SELECTED, false); // Por defecto deseleccionada

            string tf = EnumToString(_Period);
            StringReplace(tf, "PERIOD_", "");
            string shortDesc = m_alertNames[m_activeAlerts[i].modeIndex];
            StringReplace(shortDesc, "H-Line", "Line");
            StringReplace(shortDesc, "Trend", "Line");
            string textOnLine = "Alert " + shortDesc + " [" + tf + "]";

            ObjectSetString(m_chartId, name, OBJPROP_TEXT, textOnLine);
            ObjectSetString(m_chartId, name, OBJPROP_TOOLTIP, textOnLine);
           }
        }
     }
  }

// --- 2. MOTORES REALES DE ESCRITURA AL DISCO ---
// Renombra tus funciones originales agregando el sufijo "Write...ToDisk"
void              WriteTradesToDisk()
  {
   int memTotal = TradeRAM.Total();
   int count = 0;
   ArrayResize(g_tradeDisk, memTotal);

   for(int i = 0; i < memTotal; i++)
     {
      if(CheckPointer(TradeRAM.GetByIndex(i)) != POINTER_INVALID && TradeRAM.GetByIndex(i).ticket > 0)
        {
         CTradeState *mem = TradeRAM.GetByIndex(i);

         // 1. Datos Base
         g_tradeDisk[count].ticket = mem.ticket;
         StringToCharArray(mem.symbol, g_tradeDisk[count].symbol); // Conversión ultrarrápida String -> Char[]
         g_tradeDisk[count].panelX = mem.panelX;
         g_tradeDisk[count].isCollapsed = mem.isCollapsed;
         g_tradeDisk[count].isHiddenActive = mem.isHiddenActive;
         g_tradeDisk[count].virtualTP = mem.virtualTP;
         g_tradeDisk[count].virtualSL = mem.virtualSL;
         g_tradeDisk[count].isOCO = mem.isOCO;
         g_tradeDisk[count].isExpVisualOn = mem.isExpVisualOn;
         g_tradeDisk[count].isTrailLimitActive = mem.isTrailLimitActive;
         g_tradeDisk[count].trailLimitDist = mem.trailLimitDist;
         g_tradeDisk[count].cancelPrice = mem.cancelPrice;
         g_tradeDisk[count].customColor = mem.customColor;
         StringToCharArray(mem.customComment, g_tradeDisk[count].customComment);

         // 2. Órdenes Virtuales
         g_tradeDisk[count].isVirtual = mem.isVirtual;
         g_tradeDisk[count].virtType = mem.virtType;
         g_tradeDisk[count].virtEntry = mem.virtEntry;
         g_tradeDisk[count].virtSL = mem.virtSL;
         g_tradeDisk[count].virtTP = mem.virtTP;
         g_tradeDisk[count].virtLot = mem.virtLot;
         g_tradeDisk[count].virtPriceMode = mem.virtPriceMode;
         g_tradeDisk[count].virtStopLimit = mem.virtStopLimit;
         g_tradeDisk[count].virtExpiration = mem.virtExpiration;
         StringToCharArray(mem.virtComment, g_tradeDisk[count].virtComment);

         // 3. Break Even
         g_tradeDisk[count].be_isActive = mem.be.isActive;
         g_tradeDisk[count].be_isAuto = mem.be.isAuto;
         g_tradeDisk[count].be_modeStart = mem.be.modeStart;
         g_tradeDisk[count].be_modeOffset = mem.be.modeOffset;
         g_tradeDisk[count].be_valStart = mem.be.valStart;
         g_tradeDisk[count].be_valOffset = mem.be.valOffset;

         // 4. Trailing Stop
         g_tradeDisk[count].ts_isActive = mem.ts.isActive;
         g_tradeDisk[count].ts_mode = mem.ts.mode;
         g_tradeDisk[count].ts_anchorPrice = mem.ts.anchorPrice;
         ArrayCopy(g_tradeDisk[count].ts_inputs, mem.ts.inputs);
         ArrayCopy(g_tradeDisk[count].ts_units, mem.ts.units);
         ArrayCopy(g_tradeDisk[count].ts_dropIdx, mem.ts.dropIdx);

         // 5. Grid
         g_tradeDisk[count].grid_distMode = mem.grid.distMode;
         g_tradeDisk[count].grid_lotMode = mem.grid.lotMode;

         for(int r = 0; r < 5; r++)
           {
            g_tradeDisk[count].grid_rows[r].isActiveTP = mem.grid.rows[r].isActiveTP;
            g_tradeDisk[count].grid_rows[r].isActiveSL = mem.grid.rows[r].isActiveSL;
            g_tradeDisk[count].grid_rows[r].valTP_Price = mem.grid.rows[r].valTP_Price;
            g_tradeDisk[count].grid_rows[r].valTP_Vol = mem.grid.rows[r].valTP_Vol;
            g_tradeDisk[count].grid_rows[r].valSL_Price = mem.grid.rows[r].valSL_Price;
            g_tradeDisk[count].grid_rows[r].valSL_Vol = mem.grid.rows[r].valSL_Vol;
           }
         count++;
        }
     }
   ArrayResize(g_tradeDisk, count);

   string filePath = g_dataPath + "TM_Trades.bin";
   int file = FileOpen(filePath, FILE_WRITE|FILE_BIN);
   if(file != INVALID_HANDLE)
     {
      FileWriteArray(file, g_tradeDisk);
      FileClose(file);
      ////Print(">>> [I/O ENGINE] ", filePath, " actualizado. Órdenes: ", count);
     }
// ... Pega aquí tu código original que estaba dentro de SaveTradesToBin() ...
  }

