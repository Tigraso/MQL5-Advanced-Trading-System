//|                                                                  |
//+------------------------------------------------------------------+
void              WriteProtectToDisk()
  {
   g_protectDisk[0].masterSwitch       = g_protect.masterSwitch;
   g_protectDisk[0].peakEquity         = g_protect.peakEquity;
   g_protectDisk[0].startBalance       = g_protect.startBalance;

// --- NUEVAS VARIABLES ANTI-GLOBALES ---
   g_protectDisk[0].currentDay         = g_protect.currentDay;
   g_protectDisk[0].accountLockedUntil = g_protect.accountLockedUntil;
   g_protectDisk[0].trigEveryday       = g_protect.trigEveryday;
   g_protectDisk[0].trigFriday         = g_protect.trigFriday;
   g_protectDisk[0].trigDatetime       = g_protect.trigDatetime;
   g_protectDisk[0].restoredToday      = g_protect.restoredToday;

   for(int i=0; i<14; i++)
     {
      g_protectDisk[0].features[i].enabled    = g_protect.f[i].enabled;
      g_protectDisk[0].features[i].closeEAs   = g_protect.f[i].closeEAs;
      g_protectDisk[0].features[i].configNum  = g_protect.f[i].configNum;
      g_protectDisk[0].features[i].configHour = g_protect.f[i].configHour;
      g_protectDisk[0].features[i].configMin  = g_protect.f[i].configMin;
      g_protectDisk[0].features[i].configTime = g_protect.f[i].configTime;
      StringToCharArray(g_protect.f[i].configStr, g_protectDisk[0].features[i].configStr);
     }

   string filePath = g_dataPath + "TM_Protect.bin";
   int file = FileOpen(filePath, FILE_WRITE|FILE_BIN);
   if(file != INVALID_HANDLE)
     {
      FileWriteArray(file, g_protectDisk);
      FileClose(file);
      ////Print("Se guardó el Protect");
     }
// ... Pega aquí tu código original que estaba dentro de SaveProtectToBin() ...
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
int               OnInit()
  {
   ChartSetInteger(m_chartId, CHART_EVENT_OBJECT_DELETE, true);
   m_trade.SetExpertMagicNumber(MAGIC_NUM); // <--- ASIGNAR EL DNI
   m_chartId = ChartID();

// Cargar el ADN del símbolo actual en la memoria RAM
   Market.UpdateStatic(_Symbol);
   Market.UpdateDynamic(_Symbol);
   m_chartTradeLevelsWasOn = (bool)ChartGetInteger(m_chartId, CHART_SHOW_TRADE_LEVELS);

// =================================================================
// 0. CREACIÓN DE ENTORNO SEGURO (SANDBOX DE CARPETAS)
// =================================================================
   string eaFolder = "TradeAssistantPro";
   string accFolder = IntegerToString(AccountInfoInteger(ACCOUNT_LOGIN));

// Ruta final: "TradeAssistantPro\12345678\"
   g_dataPath = eaFolder + "\\" + accFolder + "\\";

// MQL5 creará la carpeta padre y la subcarpeta automáticamente
   FolderCreate(eaFolder);
   FolderCreate(eaFolder + "\\" + accFolder);
   FolderCreate(eaFolder + "\\Presets");     // <--- NUEVA: Global para plantillas
   FolderCreate(eaFolder + "\\Screenshots"); // <--- NUEVA: Global para fotos

// =================================================================
// 1. INICIALIZACIÓN DE MEMORIA (El Cerebro)
// =================================================================
   PanelState.Init();
   TimeCore.Init();
   InitProtectDefaults();
   InitHotkeyDefaults();
   UpdateDailyProfitCache(); // <--- AÑADE ESTO AQUÍ
   IndPool.Init();

   LoadTradesFromBin(); // <--- AÑADIR ESTO: Carga el .bin a la RAM al instante

   m_lineEntry          = MakeTMName(0, OP_EA1_LINE_ENTRY);
   m_lineSL             = MakeTMName(0, OP_EA1_LINE_SL);
   m_lineTP             = MakeTMName(0, OP_EA1_LINE_TP);
   m_lineStopLimit      = MakeTMName(0, OP_EA1_LINE_SLIM);
   m_rectProfit         = MakeTMName(0, OP_EA1_RECT_PROFIT);
   m_rectLoss           = MakeTMName(0, OP_EA1_RECT_LOSS);

   m_btnCenter_Name     = MakeTMName(0, OP_EA1_BTN_CENTER);
   m_btnTP_Name         = MakeTMName(0, OP_EA1_BTN_TEXT_TP);
   m_btnSL_Name         = MakeTMName(0, OP_EA1_BTN_TEXT_SL);
   m_btnSec_Name        = MakeTMName(0, OP_EA1_BTN_SEC);

   m_btnMKT_Chart_Name  = MakeTMName(0, OP_EA1_BTN_MKT);
   m_btnREV_Chart_Name  = MakeTMName(0, OP_EA1_BTN_REV);
   m_btnSLim_Chart_Name = MakeTMName(0, OP_EA1_BTN_SLIM);
   m_btnClose_Chart_Name= MakeTMName(0, OP_EA1_BTN_CLOSE);
   m_btnOpen_Chart_Name = MakeTMName(0, OP_EA1_BTN_GO);
   m_btnLockSL_Name     = MakeTMName(0, OP_EA1_LOCK_SL);
   m_btnLockTP_Name     = MakeTMName(0, OP_EA1_LOCK_TP);


// (Mantén aquí tu bloque BOMBA NUCLEAR: Limpieza Total de Fantasmas)
   ObjectsDeleteAll(m_chartId, "TM_");
   if(CheckPointer(TemplateState) != POINTER_INVALID)
     {
      delete TemplateState;
      TemplateState = NULL;
     }

   TradeRAM.PurgeAll(); // <--- ELIMINA EL BUCLE Y PON ESTO

   for(int i=0; i<MAX_LEVELS; i++)
     {
      m_tpLineNames[i] = "TA_TPLine_" + IntegerToString(i+1);
      m_slLineNames[i] = "TA_SLLine_" + IntegerToString(i+1);

      m_tpPixelNames[i] = "TA_TP_Pixel_" + IntegerToString(i+1);
      m_slPixelNames[i] = "TA_SL_Pixel_" + IntegerToString(i+1);

      m_tpLabelNames[i] = "TA_TPLabel_" + IntegerToString(i+1);
      m_slLabelNames[i] = "TA_SLLabel_" + IntegerToString(i+1);
     }
   InitProtectDefaults();

   TemplateState = new CTradeState(0, _Symbol);

// =================================================================
// 2. CARGAR LA MEMORIA GUARDADA Y SINCRONIZAR
// =================================================================
   LoadPanelFromBin();
   LoadVirtualOrders();
   LoadTasksFromBin();
   LoadProtectFromBin();
   LoadAlertsFromBin();
   RestoreAlertVisuals();
//LoadHotkeysFromBin();

   LoadTradesFromBin();   // 1. Cargamos el disco a la RAM
   SyncAccountToMemory(); // 2. EL ORÁCULO: Escanea el broker por si abriste trades con el EA apagado

// =================================================================
// 3. INICIAR EL MOTOR CCANVAS (La Vista)
// =================================================================
// =================================================================
// 3. INICIAR EL MOTOR CCANVAS (La Vista)
// =================================================================
   int startX = (Engine.m_panelX > 0) ? Engine.m_panelX : 20; // Default X
   int startY = (Engine.m_panelY > 0) ? Engine.m_panelY : 50; // Default Y

   if(Engine.Init(ENGINE_MAIN_PANEL, "CanvasProEngine", startX, startY, 280, 450))
     {
      DWM.RegisterWindow(GetPointer(Engine));

      // El director levanta el telón e inicializa todos los colores y posiciones
      RefreshGlobalThemeAndUI();
     }

// =================================================================
// 4. RESTAURAR VISUALES EN EL GRÁFICO
// =================================================================
   UpdateOpenTradesVisuals();  // Dibuja los paneles del Gestor (EA2)
   ToggleLines(m_linesActive); // Dibuja la figura del EA1 (usando la memoria reparada)

// =================================================================
// 5. INICIAR SERVICIOS EN SEGUNDO PLANO
// =================================================================
   if(TerminalInfoInteger(TERMINAL_CONNECTED))
      FetchCalendarNews();

   DrawNewsLines();

   EventSetMillisecondTimer(20); // Motor a 50 FPS (Alta Frecuencia)

// =================================================================
// 6. CONFIGURACIÓN FINAL DEL GRÁFICO (Un solo ChartRedraw)
// =================================================================
   ChartSetInteger(m_chartId, CHART_SHOW_OBJECT_DESCR, true);
   ChartSetInteger(m_chartId, CHART_BRING_TO_TOP, true);
   ChartSetInteger(m_chartId, CHART_EVENT_MOUSE_MOVE, true);

   ChartRedraw(); // ¡UN SÓLO PARPADEO AL FINAL DE TODO!

   return INIT_SUCCEEDED;
  }

//+------------------------------------------------------------------+
//| OnDeinit                                                         |
//+------------------------------------------------------------------+
void              OnDeinit(const int reason)
  {
// ====================================================================
// 1. GUARDADO INTELIGENTE (Tomar Fotografía)
// ====================================================================
   if(reason != REASON_REMOVE)
     {
      // Aquí el I/O DEBE ser síncrono para que la foto quede guardada antes de que el EA muera.
      WritePanelToDisk();
      WriteTradesToDisk();
      WriteTasksToDisk();
      WriteProtectToDisk();
     }
   else


      // 2. Si solo cambiamos de timeframe, no borramos el gráfico para evitar parpadeos
      if(reason == REASON_CHARTCHANGE)
         return;

// ====================================================================
// 3. LIMPIEZA TOTAL (El resto de tu código normal...)
// ====================================================================
   ObjectsDeleteAll(m_chartId, "TM_NewsLine_");
   EventKillTimer();
   IndPool.PurgeAll();


   ObjectsDeleteAll(m_chartId, "btnAlert");
   ObjectDelete(m_chartId, "btnTime");

// 1. Borrar Panel Principal y controles básicos
   ObjectsDeleteAll(m_chartId, "btnRR");
   ObjectsDeleteAll(m_chartId, "lblRR_Tp");
   ObjectsDeleteAll(m_chartId, "edtRR_Tp");
   ObjectsDeleteAll(m_chartId, "lblRR_Sl");
   ObjectsDeleteAll(m_chartId, "edtRR_Sl");
   ObjectsDeleteAll(m_chartId, "PanelBg");
   ObjectsDeleteAll(m_chartId, "HeaderBg");
   ObjectsDeleteAll(m_chartId, "Title");
   ObjectsDeleteAll(m_chartId, "btnClose");
   ObjectsDeleteAll(m_chartId, "btnMin");
   ObjectsDeleteAll(m_chartId, "btnTrade");
   ObjectsDeleteAll(m_chartId, "btnTpSl");
   ObjectsDeleteAll(m_chartId, "btnTsBe");
   ObjectsDeleteAll(m_chartId, "btnTool");
   ObjectsDeleteAll(m_chartId, "lblRisk");
   ObjectsDeleteAll(m_chartId, "editRisk");
   ObjectsDeleteAll(m_chartId, "lblSL");
   ObjectsDeleteAll(m_chartId, "editSL");
   ObjectsDeleteAll(m_chartId, "lblTP");
   ObjectsDeleteAll(m_chartId, "editTP");
   ObjectsDeleteAll(m_chartId, "lblRR");
   ObjectsDeleteAll(m_chartId, "editRR");
   ObjectsDeleteAll(m_chartId, "lblLot");
   ObjectsDeleteAll(m_chartId, "editLot");
   ObjectsDeleteAll(m_chartId, "btnLines");
   ObjectsDeleteAll(m_chartId, "btnReset");
   ObjectsDeleteAll(m_chartId, "btnFlip");
   ObjectsDeleteAll(m_chartId, "btnBuy");
   ObjectsDeleteAll(m_chartId, "btnSell");

   ObjectDelete(m_chartId, m_btnSLim_Chart_Name);
   ObjectDelete(m_chartId, m_btnOpen_Chart_Name);

// 4. BORRAR BOTONES FLOTANTES
   ObjectDelete(m_chartId, m_btnLockSL_Name);
   ObjectDelete(m_chartId, m_btnLockTP_Name);
   ObjectDelete(m_chartId, m_btnMKT_Chart_Name);
   ObjectDelete(m_chartId, m_btnREV_Chart_Name);
   ObjectDelete(m_chartId, m_btnClose_Chart_Name);

// 5. --- LIMPIEZA TOTAL DE GESTIÓN (Manage Tab) ---
   ObjectsDeleteAll(m_chartId, "hTP");
   ObjectsDeleteAll(m_chartId, "hSL");

   for(int i=0; i<MAX_LEVELS; i++)
     {
      string s = IntegerToString(i+1);
      ObjectsDeleteAll(m_chartId, "btnTP_"+s);
      ObjectsDeleteAll(m_chartId, "edtValTP_"+s);
      ObjectsDeleteAll(m_chartId, "edtPctTP_"+s);
      ObjectsDeleteAll(m_chartId, "btnSL_"+s);
      ObjectsDeleteAll(m_chartId, "edtValSL_"+s);
      ObjectsDeleteAll(m_chartId, "edtPctSL_"+s);

      ObjectDelete(m_chartId, m_tpLineNames[i]);
      ObjectDelete(m_chartId, m_slLineNames[i]);
      ObjectDelete(m_chartId, m_tpLabelNames[i]);
      ObjectDelete(m_chartId, m_slLabelNames[i]);

      ObjectDelete(m_chartId, m_tpPixelNames[i]);
      ObjectDelete(m_chartId, m_slPixelNames[i]);
     }

   ObjectsDeleteAll(m_chartId, "lblTS_");
   ObjectsDeleteAll(m_chartId, "btnTS_");
   ObjectsDeleteAll(m_chartId, "menuTS");
   ObjectsDeleteAll(m_chartId, "optTS_");
   ObjectsDeleteAll(m_chartId, "edtTS_");
   ObjectsDeleteAll(m_chartId, "tsLbl_");
   ObjectsDeleteAll(m_chartId, "tsBtn_");
   ObjectsDeleteAll(m_chartId, "tsEdt_");
   ObjectsDeleteAll(m_chartId, "ctxMenuBg");
   ObjectsDeleteAll(m_chartId, "ctxOpt_");
   ObjectsDeleteAll(m_chartId, "tsBtnVal_");
   ObjectsDeleteAll(m_chartId, "beSepLine");
   ObjectsDeleteAll(m_chartId, "btnBE_");
   ObjectsDeleteAll(m_chartId, "beLbl_");
   ObjectsDeleteAll(m_chartId, "beBtn_");
   ObjectsDeleteAll(m_chartId, "beEdt_");

   ObjectsDeleteAll(m_chartId, "btnPriceMode");
   ObjectsDeleteAll(m_chartId, "editPrice");
   ObjectsDeleteAll(m_chartId, "Conf_");

// ====================================================================
// 4. RESTAURACIÓN DEL ENTORNO NATIVO (Protocolo Buen Ciudadano)
// ====================================================================
// 1. Liberar el bloqueo de arrastre y la ruedita del ratón (¡La cura!)
   ChartSetInteger(m_chartId, CHART_MOUSE_SCROLL, true);

// 2. Liberar la escala del gráfico (Por si CheckAutoZoom la dejó bloqueada)
   ChartSetInteger(m_chartId, CHART_SCALEFIX, false);

// 3. Apagar los eventos de alta frecuencia para no gastar CPU innecesaria en MT5
   ChartSetInteger(m_chartId, CHART_EVENT_MOUSE_MOVE, false);
   ChartSetInteger(m_chartId, CHART_EVENT_OBJECT_DELETE, false);

// 4. Devolver las líneas nativas del broker (Verdes/Rojas) a como el usuario las tenía
   ChartSetInteger(m_chartId, CHART_SHOW_TRADE_LEVELS, m_chartTradeLevelsWasOn);

// 5. Opcional: Asegurarnos de que el gráfico no se quede "congelado" visualmente
   ChartSetInteger(m_chartId, CHART_AUTOSCROLL, true);

   ConfirmWin.DestroyCanvas();

// --- DEVOLVER LA MEMORIA RAM AL PC ---
   TradeRAM.PurgeAll(); // Aniquilación total y segura sin fugas

   if(CheckPointer(TemplateState) != POINTER_INVALID)
      delete TemplateState;

   ObjectsDeleteAll(0, "ctxOpt_");
   ObjectDelete(m_chartId, "Status_Bg");
   for(int i=0; i<6; i++)
      ObjectDelete(m_chartId, "Status_Lbl_" + IntegerToString(i));


   ObjectsDeleteAll(0, "TM_");
   ChartRedraw();
  }

// ====================================================================
// MOTOR HFT: TELEMETRÍA Y CACHÉ DE TICKS (EL CIGÜEÑAL)
// ====================================================================
ulong g_telemetry_micro_time = 0; // Microsegundos gastados calculando
int   g_telemetry_ticks      = 0; // Ticks interceptados por el radar


//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              OnTick()
  {
   TimeCore.Sync();
   Market.UpdateDynamic(_Symbol);
   if(m_isMarketMode)
     {
      ResetLinesToMarket();
     }

//   // ==============================================================
//   // 🧲 MOTOR DE SEGUIMIENTO: MODO MARKET (Dirty Flag a 2 FPS)
//   // ==============================================================
//
//      static uint last_market_update = 0;
//      uint now = GetTickCount();
//
//      // Filtro de Alta Frecuencia: Solo actualiza cada 500ms
//      if(now - last_market_update >= 500)
//        {
//         ResetLinesToMarket();
//         last_market_update = now;
//        }
//

// ==============================================================
// MOTOR HFT Y EQUITY PROTECT
// ==============================================================
   if(!m_manageAllSymbols)
     {
      ProcessHFT_Engine();
      if(g_hft_nuke_signal >= 0)
        {
         TranslateAndExecuteNuke();
        }
      ////PrintTelemetry();
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              OnTrade()
  {
// Actualizamos la caché de beneficios cerrados automáticamente
   UpdateDailyProfitCache(); // <--- AÑADE ESTO AQUÍ

// Actualizamos las estadísticas de la pestaña Tool si hay un cambio real
   if(m_currentTab == TAB_TOOL)
      UpdateToolData(true);
  }

//+------------------------------------------------------------------+
//| ENRUTADOR FASE 1: EVENTOS DE RATÓN Y TEXTO                       |
//+------------------------------------------------------------------+
void              HandleChartChange()
  {
   if(m_linesActive && !m_isDragging)
     {
      int chartW = (int)ChartGetInteger(m_chartId, CHART_WIDTH_IN_PIXELS);
      if(m_currentFixedX + FIGURE_WIDTH > chartW)
         m_currentFixedX = chartW - FIGURE_WIDTH - 10;
      if(m_currentFixedX < 0)
         m_currentFixedX = 10;
      UpdateInputsFromLines();
      ChartRedraw();
     }
  }

//+------------------------------------------------------------------+
//| ENRUTADOR FASE 1: EVENTOS DE RATÓN Y TEXTO                       |
//+------------------------------------------------------------------+
void              HandleMouseMove(int mouseX, int mouseY, int currMouseState)
  {
   static int lastMouseState = 0;

// --- FASE 1: DETECCIÓN DEL CLIC (EL "AGARRE") ---
   if(currMouseState == 1 && lastMouseState == 0)
     {
      int sub;
      datetime mTime;
      double mPrice;
      if(!ChartXYToTimePrice(m_chartId, mouseX, mouseY, sub, mTime, mPrice))
         return;
      m_isDragging = false;

      // GUARDAR COORDENADAS PARA DETECCIÓN DE CLIC (Tolerancia 1 píxel)
      m_clickStartX_EA1 = mouseX;
      m_clickStartY_EA1 = mouseY;

      // EL RADAR UNIVERSAL: Obtenemos qué objeto tocó realmente el ratón, respetando capas (Z-Order)
      string hitObj = GetObjectAt(mouseX, mouseY);

      // Si tocó el vacío, abortamos para este motor
      if(hitObj == "") 
        {
         lastMouseState = currMouseState;
         return;
        }

      // ESCUDO DE BOTONES: Si tocó un botón nativo de la figura, cortamos el arrastre
      // Esto permite que el clic pase limpio al OnChartEvent sin mover la figura ni colapsarla.
      if(hitObj == m_btnMKT_Chart_Name || hitObj == m_btnREV_Chart_Name || 
         hitObj == m_btnSLim_Chart_Name || hitObj == m_btnClose_Chart_Name || 
         hitObj == m_btnOpen_Chart_Name)
        {
         lastMouseState = currMouseState;
         return; 
        }

      // Identificamos las partes de nuestra figura
      bool isCenterBtn = (hitObj == m_btnCenter_Name);
      bool isSLBtn     = (hitObj == m_btnSL_Name || hitObj == m_btnLockSL_Name);
      bool isTPBtn     = (hitObj == m_btnTP_Name || hitObj == m_btnLockTP_Name);
      bool isSecBtn    = (m_isStopLimitMode && hitObj == m_btnSec_Name);
      bool isRect      = (hitObj == m_rectProfit || hitObj == m_rectLoss);

      // A. MODO NORMAL (FIGURA EXPANDIDA)
      if(!m_isPreOpCollapsed)
        {
         if(isCenterBtn || isRect)
           { m_isDragging = true; m_dragTarget = 1; }
         else if(isSLBtn)
           { m_isDragging = true; m_dragTarget = 2; }
         else if(isTPBtn)
           { m_isDragging = true; m_dragTarget = 3; }
         else if(isSecBtn)
           { m_isDragging = true; m_dragTarget = 8; }
        }
      // B. MODO TRADINGVIEW (FIGURA COLAPSADA)
      else
        {
         // Si está colapsada, los botones no existen (fueron ignorados por GetObjectAt).
         // Solo podemos tocar el rectángulo (isRect).
         if(isRect)
           {
            int yTP = PriceToY(ObjectGetDouble(m_chartId, m_lineTP, OBJPROP_PRICE));
            int ySL = PriceToY(ObjectGetDouble(m_chartId, m_lineSL, OBJPROP_PRICE));

            m_isDragging = true;
            // Física de bordes: A 15 píxeles de las líneas movemos TP/SL
            if(MathAbs(mouseY - yTP) <= 15)
               m_dragTarget = 3; // Mueve TP
            else if(MathAbs(mouseY - ySL) <= 15)
               m_dragTarget = 2; // Mueve SL
            else
               m_dragTarget = 1; // Mueve Todo el bloque
           }
        }

      // Si logramos agarrar algo de nuestra figura, inicializamos la matemática del arrastre
      if(m_isDragging)
        {
         m_dragX_Offset = mouseX - m_currentFixedX;
         if(m_dragTarget == 1) m_dragPriceOffset = mPrice - ObjectGetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE);
         if(m_dragTarget == 2) m_dragPriceOffset = mPrice - ObjectGetDouble(m_chartId, m_lineSL, OBJPROP_PRICE);
         if(m_dragTarget == 3) m_dragPriceOffset = mPrice - ObjectGetDouble(m_chartId, m_lineTP, OBJPROP_PRICE);
         if(m_dragTarget == 8) m_dragPriceOffset = mPrice - ObjectGetDouble(m_chartId, m_lineStopLimit, OBJPROP_PRICE);

         ChartSetInteger(m_chartId, CHART_MOUSE_SCROLL, false);
         if(m_isStopLimitMode && m_dragTarget == 8)
           {
            ObjectSetInteger(m_chartId, m_lineStopLimit, OBJPROP_COLOR, ARGBToColor(Theme.accent));
            ObjectSetInteger(m_chartId, m_lineStopLimit, OBJPROP_TIMEFRAMES, OBJ_ALL_PERIODS);
           }
        }
     }
// --- FASE 2: EL ARRASTRE ---
   else
      if(currMouseState == 1 && m_isDragging)
        {
         int sub;
         datetime mTime;
         double mPrice;
         if(!ChartXYToTimePrice(m_chartId, mouseX, mouseY, sub, mTime, mPrice))
            return;

         if(m_dragTarget == 1)
           {
            m_currentFixedX = mouseX - m_dragX_Offset;
            if(m_currentFixedX < 0)
               m_currentFixedX = 0;

            double oldEntry = ObjectGetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE);
            double newEntryPrice = mPrice - m_dragPriceOffset;
            double delta = newEntryPrice - oldEntry;

            ObjectSetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE, newEntryPrice);

            if(!m_isSLLocked)
               ObjectSetDouble(m_chartId, m_lineSL, OBJPROP_PRICE, ObjectGetDouble(m_chartId, m_lineSL, OBJPROP_PRICE) + delta);
            if(!m_isTPLocked)
               ObjectSetDouble(m_chartId, m_lineTP, OBJPROP_PRICE, ObjectGetDouble(m_chartId, m_lineTP, OBJPROP_PRICE) + delta);

            MoveUnifiedLineByDelta(MakeTMName(0, OP_HLINE_BE_START), delta);
            MoveUnifiedLineByDelta(MakeTMName(0, OP_HLINE_BE_OFF), delta);
            MoveUnifiedLineByDelta(MakeTMName(0, OP_HLINE_TS_START), delta);
            MoveUnifiedLineByDelta(MakeTMName(0, OP_HLINE_TS_DIST), delta);

            for(int k=1; k<=5; k++)
              {
               MoveUnifiedLineByDelta(MakeTMName(0, OP_HLINE_GRID_TP_1 + k - 1), delta);
               MoveUnifiedLineByDelta(MakeTMName(0, OP_HLINE_GRID_SL_1 + k - 1), delta);
              }

            if(m_isMarketMode)
               SetMarketMode(false);
           }
         else
            if(m_dragTarget == 2)
              {
               ObjectSetDouble(m_chartId, m_lineSL, OBJPROP_PRICE, mPrice - m_dragPriceOffset);
               AutoFlipLines(); 
               if(m_isRRActive)
                  SyncRR(true, false); 
              }
            else
               if(m_dragTarget == 3)
                 {
                  ObjectSetDouble(m_chartId, m_lineTP, OBJPROP_PRICE, mPrice - m_dragPriceOffset);
                  AutoFlipLines(); 
                  if(m_isRRActive)
                     SyncRR(false, false); 
                 }
               else
                  if(m_dragTarget == 8)
                    {
                     ObjectSetDouble(m_chartId, m_lineStopLimit, OBJPROP_PRICE, mPrice - m_dragPriceOffset);
                    }

         FastUpdateFigureVisuals(); 
         ChartRedraw();
        }
      // --- FASE 3: SOLTAR EL CLIC (EL "DROP") ---
      else
         if(currMouseState == 0 && lastMouseState == 1)
           {
            if(m_isDragging)
              {
               // LÓGICA DE COLAPSO: Si suelta el ratón casi en el mismo punto donde lo apretó
               if(MathAbs(mouseX - m_clickStartX_EA1) <= 1 && MathAbs(mouseY - m_clickStartY_EA1) <= 1)
                 {
                  if(m_dragTarget == 1 || m_dragTarget == 2 || m_dragTarget == 3 || m_dragTarget == 8)
                    {
                     m_isPreOpCollapsed = !m_isPreOpCollapsed;
                     ApplyPreOpCollapseState(m_isPreOpCollapsed);
                    }
                 }

               if(m_isStopLimitMode && m_dragTarget == 8)
                 {
                  ObjectSetInteger(m_chartId, m_lineStopLimit, OBJPROP_COLOR, clrNONE);
                  if(!m_isPreOpCollapsed)
                     ObjectSetInteger(m_chartId, m_lineStopLimit, OBJPROP_TIMEFRAMES, OBJ_NO_PERIODS);
                 }
                 
               m_isDragging = false;
               m_dragTarget = 0;
               ChartSetInteger(m_chartId, CHART_MOUSE_SCROLL, true);
               UpdateInputsFromLines();
               CalculateLot();
               SavePanelToBin();
               ChartRedraw();
              }
           }
   lastMouseState = currMouseState;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              HandleTextEdit(string sparam)
  {

// --- EQUITY PROTECT INPUTS (NUEVO LECTOR DE MATRIZ) ---
   if(StringFind(sparam, "Prot_Cf_") == 0)
     {
      int idx = (int)StringToInteger(StringSubstr(sparam, 8));
      if(idx >= 0 && idx < 14)
        {
         // Guardamos como String (Texto), porque algunas filas llevan horas ("23:50") y otras Símbolos ("AUDNZD")
         g_protect.f[idx].configStr = ObjectGetString(m_chartId, sparam, OBJPROP_TEXT);
        }
     }

   if(sparam == "edtRR_Tp")
     {
      if(m_isRRActive)
         SyncRR(true);
      ChartRedraw();
     }
   if(sparam == "edtRR_Sl")
     {
      if(m_isRRActive)
         SyncRR(false);
      ChartRedraw();
     }
   if(sparam == "editPrice")
     {
      if(m_linesActive && m_isPriceMode)
        {
         if(m_isRRActive)
           {
            SyncRR(false);
            SyncRR(true);
           }
         UpdateLinesFromInputs();
         UpdateInputsFromLines();
         CalculateLot();
         ChartRedraw();
        }
     }
   if(sparam == "editRisk")
     {
      CalculateLot();
     }
   if(sparam == "editSL")
     {
      if(m_linesActive)
        {
         UpdateLinesFromInputs();
        }
      if(m_linesActive && m_isRRActive)
         SyncRR(true);
      CalculateLot();
     }
   if(sparam == "editTP")
     {
      if(m_linesActive)
        {
         UpdateLinesFromInputs();
        }
      if(m_linesActive && m_isRRActive)
         SyncRR(false);
      CalculateLot();
     }
   if(sparam == "editRR")
     {
      if(m_linesActive)
        {
         UpdateLinesFromInputs();
         CalculateLot();
         ChartRedraw();
        }
     }
   if(sparam == "editLot")
     {
      if(m_riskMode == FIXED_LOT)
        {
         if(m_linesActive)
            UpdateInputsFromLines();
         ChartRedraw();
        }
     }
   if(StringFind(sparam, "edtValTP_") >= 0 || StringFind(sparam, "edtValSL_") >= 0 ||
      StringFind(sparam, "edtPctTP_") >= 0 || StringFind(sparam, "edtPctSL_") >= 0)
     {
      CalculateManageLots();
      UpdateInputsFromLines();
      ChartRedraw();
     }
// --- AÑADIR ESTO AL FINAL DE HandleTextEdit ---
   bool isAutoInput = false;

// Si modificamos algo en AUTO, guardamos y movemos las líneas
   if(isAutoInput)
     {
      SyncPanelToTemplateState();
      if(m_linesActive)
         UpdateInputsFromLines(); // <-- Esto mueve las líneas
      ChartRedraw();
     }
  }

//+------------------------------------------------------------------+
//| EVENTOS DEL GRÁFICO (ENRUTADOR MAESTRO UNIFICADO)                |
//+------------------------------------------------------------------+
void              OnChartEvent(const int id, const long &lparam, const double &dparam, const string &sparam)
  {
// ===================================================================
// EVENTO KEYDOWN: HOTKEYS Y MODO ESCUCHA
// ===================================================================
   if(id == CHARTEVENT_KEYDOWN)
     {
      // 1. ESCUDO DE CONTEXTO: Si el usuario está escribiendo un precio o comentario, ignorar todo
      if(Engine.m_activeGhostID != 0 || TimeWin.m_activeGhostID != 0 || ProtectWin.m_activeGhostID != 0)
         return;

      bool isCtrlPressed = (TerminalInfoInteger(TERMINAL_KEYSTATE_CONTROL) != 0);

      // 2. MODO ESCUCHA ACTIVO (Asignación de tecla)
      if(g_listeningHotkeyIdx >= 0 && g_listeningHotkeyIdx <= 8)
        {
         // Si presiona ESC, cancelamos la asignación
         if(lparam == 27)
           {
            g_listeningHotkeyIdx = -1;
            BuildHotkeyUI();
            return;
           }

         // No procesar si solo apretó el Ctrl solo
         if(lparam == 17)
            return;

         // Guardar la tecla
         g_hotkeyDisk[0].keys[g_listeningHotkeyIdx].keyCode = lparam;
         g_hotkeyDisk[0].keys[g_listeningHotkeyIdx].requireCtrl = isCtrlPressed;
         string keyStr = GetKeyNameStr(lparam);
         StringToCharArray(keyStr, g_hotkeyDisk[0].keys[g_listeningHotkeyIdx].keyName);

         SavePanelToBin(); // <--- REEMPLAZADO: EL PANEL SE ENCARGA AHORA
         g_listeningHotkeyIdx = -1; // Salir del modo escucha
         BuildHotkeyUI();

         return;
        }

      // 3. MODO EJECUCIÓN (Si los Hotkeys están encendidos)
      if(g_hotkeyDisk[0].masterSwitch)
        {
         for(int i=0; i<9; i++)
           {
            if(!g_hotkeyDisk[0].keys[i].enabled)
               continue;

            // Verificar coincidencia exacta (Tecla + Estado de Ctrl)
            if(g_hotkeyDisk[0].keys[i].keyCode == lparam && g_hotkeyDisk[0].keys[i].requireCtrl == isCtrlPressed)
              {
               // Ejecutar la acción
               switch(i)
                 {
                  case 0: // Show/Hide Lines
                     m_linesActive = !m_linesActive;
                     ToggleLines(m_linesActive);
                     BuildCanvasUI();

                     break;
                  case 1: // Execute [GO]
                     if(m_linesActive)
                       {
                        double en = ObjectGetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE);
                        double sl = ObjectGetDouble(m_chartId, m_lineSL, OBJPROP_PRICE);
                        ENUM_ORDER_TYPE oType = (sl < en) ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
                        if(m_confirm_Silence)
                           ExecuteOrder(oType);
                        else
                           ManageConfirmWindow(true, oType);

                       }
                     break;
                  case 2: // Reverse [R]
                     if(m_linesActive)
                       {
                        FlipOrderMode();

                       }
                     break;
                  case 3: // Market Mode [M]
                     if(m_linesActive)
                       {
                        SetMarketMode(!m_isMarketMode);
                        if(m_isMarketMode)
                           ResetLinesToMarket();
                        BuildCanvasUI();

                       }
                     break;
                  case 4: // BUY (Directo del Panel)
                     if(m_confirm_Silence)
                        ExecuteOrder(ORDER_TYPE_BUY);
                     else
                        ManageConfirmWindow(true, ORDER_TYPE_BUY);

                     break;
                  case 5: // SELL (Directo del Panel)
                     if(m_confirm_Silence)
                        ExecuteOrder(ORDER_TYPE_SELL);
                     else
                        ManageConfirmWindow(true, ORDER_TYPE_SELL);

                     break;
                  case 6: // Close All Positions
                     ProcessToolAction(0);
                     BuildCanvasUI();

                     break;
                  case 7: // Delete All Pending
                     ProcessToolAction(18);
                     BuildCanvasUI();

                     break;
                  case 8: // Nuclear Protect & Save Fénix
                     ExecuteNuclearOption("User Triggered (Hotkey)", true);
                     break;
                 }
               break; // Detener bucle tras encontrar y ejecutar la tecla
              }
           }
        }
     }
// ===================================================================
// 0. MOTOR DE SINCRONIZACIÓN VISUAL (HARDWARE SYNC)
// ===================================================================
   if(id == CHARTEVENT_CHART_CHANGE)
     {
      // 1. Sincronizar Figura Pre-Operación (Panel EA1)
      if(m_linesActive && !m_isDragging)
        {
         HandleChartChange();       // Ajusta X si el gráfico se encogió
         FastUpdateFigureVisuals(); // Reposiciona Y al instante
        }

      // 2. Sincronizar Paneles del Gestor (EA2)
      if(!g_isDragging)
        {
         TM_UpdatePanVisualsFast();
         ChartRedraw();
        }
      return; // Cortamos aquí. MT5 se encarga de hacer el repintado (ChartRedraw) automáticamente tras este evento.
     }
// ===================================================================
// 1. EVENTOS DE TEXTO (NATIVOS DE MT5) - ENRUTAMIENTO O(1)
// ===================================================================
   if(id == CHARTEVENT_OBJECT_ENDEDIT && sparam == DWM.m_activeGhostName)
     {
      string newText = ObjectGetString(0, sparam, OBJPROP_TEXT);
      ObjectDelete(0, sparam); // Aniquilamos al fantasma físico

      // Apagamos la bandera local del motor
      if(CheckPointer(DWM.m_activeGhostEngine) != POINTER_INVALID)
         DWM.m_activeGhostEngine.m_activeGhostID = 0;

      // ENRUTADOR A VELOCIDAD DE LA LUZ (Usando el ADN del Motor)
      int eType = DWM.m_activeGhostEngine.m_engineType;
      int opCode = DWM.m_activeGhostOpCode;

      if(eType == ENGINE_EA2_SUBMENU)
        {
         TM_ProcessGhostInputSave(DWM.m_activeGhostTicket, opCode, newText);
        }
      else
         if(eType == ENGINE_TIME_TRADER)
           {
            Time_ProcessGhostInputSave(opCode, newText);
           }
         else
            if(eType == ENGINE_PROTECT)
              {
               Protect_ProcessGhostInputSave(opCode, newText);
              }
            else // ENGINE_MAIN_PANEL, SETTINGS, etc.
              {
               ProcessGhostInputSave(opCode, newText);
              }

      // Limpiamos la memoria del Árbitro
      DWM.m_activeGhostEngine = NULL;
      DWM.m_activeGhostName   = "";
      return;
     }

// ===================================================================
// 2. EL ÁRBITRO DE VENTANAS CCANVAS (HOVER, CLICK Y DRAG)
// ===================================================================
   if(id == CHARTEVENT_MOUSE_MOVE)
     {
      int mouseState = (int)StringToInteger(sparam);
      int absX = (int)lparam;
      int absY = (int)dparam;

      // =================================================================
      // 🚀 INYECCIÓN: DEBOUNCER INTELIGENTE (OPCIÓN C: FLUIDEZ MÁXIMA EN ARRASTRE)
      // =================================================================
      static ulong last_mouse_time = 0;
      static int   last_raw_state  = 0;
      ulong current_time = GetMicrosecondCount(); // Alta precisión (adiós a los saltos inexactos de Windows)

      // ¿El estado del botón del ratón es idéntico al anterior? (Puro movimiento)
      if(mouseState == last_raw_state)
        {
         // OPCIÓN C: Si NO estamos haciendo clic (Hover), aplicamos el limitador para ahorrar CPU en los Raycasts.
         // Si ESTAMOS haciendo clic (Arrastrando), ignoramos el limitador y permitimos FPS ilimitados.
         if(mouseState == 0)
           {
            // Limitamos el Hover a ~66 FPS (15000 microsegundos). Si pasó menos tiempo, ignoramos el evento.
            if(current_time - last_mouse_time < 15000)
               return;
           }
        }

      // Si llegamos aquí, es porque fue un Hover válido (>15ms), un Arrastre (FPS ilimitado), o un Clic nuevo.
      last_mouse_time = current_time;
      last_raw_state  = mouseState;
      // =================================================================

      static int lastStateCanvas = 0;

      //// --- INTERCEPTOR DE PÉRDIDA DE FOCO (BLUR) ---
      //if(mouseState == 1 && lastStateCanvas == 0)
      //  {
      //   if(Engine.m_activeGhostID != 0)
      //     {
      //      string gName = "GhostInput_" + IntegerToString(Engine.m_activeGhostID);
      //      if(!IsMouseOverObject(gName, absX, absY))
      //        {
      //         string t = ObjectGetString(0, gName, OBJPROP_TEXT);
      //         ObjectDelete(0, gName);
      //         int sid = Engine.m_activeGhostID;
      //         Engine.m_activeGhostID = 0;
      //         ProcessGhostInputSave(sid, t);
      //        }
      //     }
      //   if(TimeWin.m_activeGhostID != 0)
      //     {
      //      string gName = "GhostInput_" + IntegerToString(TimeWin.m_activeGhostID);
      //      if(!IsMouseOverObject(gName, absX, absY))
      //        {
      //         string t = ObjectGetString(0, gName, OBJPROP_TEXT);
      //         ObjectDelete(0, gName);
      //         int sid = TimeWin.m_activeGhostID;
      //         TimeWin.m_activeGhostID = 0;
      //         Time_ProcessGhostInputSave(sid, t);
      //        }
      //     }
      //   if(ProtectWin.m_activeGhostID != 0)
      //     {
      //      string gName = "GhostInput_" + IntegerToString(ProtectWin.m_activeGhostID);
      //      if(!IsMouseOverObject(gName, absX, absY))
      //        {
      //         string t = ObjectGetString(0, gName, OBJPROP_TEXT);
      //         ObjectDelete(0, gName);
      //         int sid = ProtectWin.m_activeGhostID;
      //         ProtectWin.m_activeGhostID = 0;
      //         Protect_ProcessGhostInputSave(sid, t);
      //        }
      //     }
      //  }

      // --. SOLUCIÓN DE RAÍZ: EL ESCUDO ANTI-INTERFERENCIAS <---
      // Si el motor nativo ya está arrastrando algo (EA1 o EA2), apagamos el Raycast.
      bool isNativeDragging = (g_isDragging || m_isDragging);

      CUIEngine *hitWin = NULL;

      if(!isNativeDragging)
        {
         // Solo disparamos el láser si no estamos arrastrando nada nativo
         hitWin = DWM.RaycastMouse(absX, absY, mouseState, lastStateCanvas);
        }

      if(CheckPointer(hitWin) != POINTER_INVALID)
        {
         ChartSetInteger(m_chartId, CHART_MOUSE_SCROLL, false); // Bloquear fondo

         // Si es un clic NUEVO, ejecutar acción
         if(mouseState == 1 && lastStateCanvas == 0)
           {
            int clickedBtn = hitWin.GetClickedButton(absX, absY);
            int dropIdx    = hitWin.CheckDropdownClick(absX, absY);

            // Enrutador de Ventanas Principales
            if(hitWin == GetPointer(Engine))
              {
               if(dropIdx >= 0)
                 {
                  ProcessDropdownSelection((ushort)Engine.m_openDropdown, dropIdx);
                  hitWin.ClearDrop();
                 }
               else
                  if(clickedBtn != 0)
                     ProcessCanvasClick(clickedBtn);
              }
            else
               if(hitWin == GetPointer(ExitWin)) // <--- AÑADE ESTO
                 {
                  if(clickedBtn != 0)
                     ProcessExitClick(clickedBtn);
                 }
               else
                  if(hitWin == GetPointer(SettingsWin))
                    {
                     // 1. Escuchar si tocó una opción del menú desplegable
                     if(dropIdx >= 0)
                       {
                        ProcessDropdownSelection((ushort)SettingsWin.m_openDropdown, dropIdx);
                        hitWin.ClearDrop();
                       }
                     // 2. Escuchar si tocó un botón normal
                     else
                        if(clickedBtn != 0)
                          {
                           ProcessSettingsClick(clickedBtn);
                          }
                    }
                  else
                     if(hitWin == GetPointer(HelpWin))
                       {
                        if(clickedBtn != 0)
                           ProcessHelpClick(clickedBtn);
                       }
                     else
                        if(hitWin == GetPointer(HotkeyWin))
                          {
                           if(clickedBtn != 0)
                              ProcessHotkeyClick(clickedBtn);
                          }
                        else
                           if(hitWin == GetPointer(ConfirmWin))
                             {
                              if(clickedBtn != 0)
                                 ProcessConfirmClick((ushort)clickedBtn);
                             }
                           else
                              if(hitWin == GetPointer(TimeWin))
                                {
                                 if(dropIdx >= 0)
                                   {
                                    ProcessDropdownSelection((ushort)TimeWin.m_openDropdown, dropIdx);
                                    hitWin.ClearDrop();
                                   }
                                 else
                                    if(clickedBtn != 0)
                                       ProcessTimeClick(clickedBtn);
                                }
                              else
                                 if(hitWin == GetPointer(ProtectWin))
                                   {
                                    if(dropIdx >= 0)
                                      {
                                       ProcessDropdownSelection((ushort)ProtectWin.m_openDropdown, dropIdx);
                                       hitWin.ClearDrop();
                                      }
                                    else
                                       if(clickedBtn != 0)
                                          ProcessProtectClick(clickedBtn);
                                   }
                                 else
                                    if(hitWin == GetPointer(NewsWin))
                                      {
                                       if(clickedBtn != 0)
                                          ProcessNewsClick(clickedBtn);
                                      }
                                    else
                                       if(hitWin == GetPointer(Modal))
                                         {
                                          if(dropIdx >= 0)
                                            {
                                             ProcessDropdownSelection((ushort)Modal.m_openDropdown, dropIdx);
                                             hitWin.ClearDrop();
                                            }
                                          else
                                             if(clickedBtn != 0)
                                                ProcessModalClick(clickedBtn);
                                         }
                                       // Enrutador de Ventanas del EA2 (Menús de Órdenes)
                                       else
                                         {
                                          int memTotal = TradeRAM.Total();
                                          for(int i=0; i<memTotal; i++)
                                            {
                                             if(CheckPointer(TradeRAM.GetByIndex(i)) != POINTER_INVALID)
                                               {
                                                if(hitWin == GetPointer(TradeRAM.GetByIndex(i).menuCanvas) || hitWin == GetPointer(TradeRAM.GetByIndex(i).subMenuCanvas))
                                                  {
                                                   if(dropIdx >= 0)
                                                     {
                                                      int dropOp = 0;
                                                      if(hitWin.m_openDropdown == OP_TM_GRID_DIST_DROP)
                                                         dropOp = OP_TM_GRID_DIST_SET_0 + dropIdx;
                                                      else
                                                         if(hitWin.m_openDropdown == OP_TM_GRID_LOT_DROP)
                                                            dropOp = OP_TM_GRID_LOT_SET_0 + dropIdx;
                                                         else
                                                            if(hitWin.m_openDropdown >= OP_TM_TS_DROP_0 && hitWin.m_openDropdown <= OP_TM_TS_DROP_5)
                                                              {
                                                               // Guardamos el índice seleccionado
                                                               TradeRAM.GetByIndex(i).ts.dropIdx[hitWin.m_openDropdown - OP_TM_TS_DROP_0] = dropIdx;
                                                               // Guardamos en disco y repintamos SIN volver a llamar al botón
                                                               SaveTradesToBin();
                                                               UpdateOpenTradesVisuals();
                                                               ChartRedraw();
                                                              }
                                                            // --- MAGIA: GUARDAR MODO DEL TS Y REPINTAR ---
                                                            else
                                                               if(hitWin.m_openDropdown == OP_TM_TS_MODE_DROP)
                                                                 {
                                                                  TradeRAM.GetByIndex(i).ts.mode = dropIdx;
                                                                  SaveTradesToBin();

                                                                  // Recalculamos las líneas visuales al instante para el nuevo modo
                                                                  int px = (TradeRAM.GetByIndex(i).panelX > -1) ? TradeRAM.GetByIndex(i).panelX : ((int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS) - 300);
                                                                  TS_Calculation tsCalc = CalculateTSLevels(TradeRAM.GetByIndex(i).ticket);
                                                                  DrawTSVisuals(TradeRAM.GetByIndex(i).ticket, tsCalc, px);

                                                                  UpdateOpenTradesVisuals();
                                                                  ChartRedraw();
                                                                 }

                                                      if(dropOp != 0)
                                                         ProcessOrderMenuClick(TradeRAM.GetByIndex(i).ticket, dropOp);

                                                      hitWin.ClearDrop();
                                                     }
                                                   else
                                                      if(clickedBtn != 0)
                                                        {
                                                         ProcessOrderMenuClick(TradeRAM.GetByIndex(i).ticket, clickedBtn);
                                                        }
                                                   break;
                                                  }
                                               }
                                            }
                                         }
           }
         lastStateCanvas = mouseState;
         return; // 🛑 ¡CORTE DE RAYO! MT5 no se entera de este movimiento.
        }
      else // <--- ¡NUEVO: INYECCIÓN GLOBAL BLUR!
        {
         // Si el ratón hizo clic y no tocó ningún CCanvas (tocó el gráfico o el vacío)
         if(mouseState == 1 && lastStateCanvas == 0)
           {
            DWM.CloseAllDropdowns();
           }
        }

      // --- 3. SI EL RAYO NO TOCÓ LA UI (O ESTAMOS ARRASTRANDO ALGO NATIVO) ---
      // El motor de alta velocidad toma el control ininterrumpido.
      HandleMouseMove(absX, absY, mouseState);     // Líneas EA1
      TM_HandleMouseMove(absX, absY, mouseState);  // Líneas EA2

      lastStateCanvas = mouseState;
      return;
     }

// ===================================================================
// EVENTOS NATIVOS MT5: ARRASTRE Y BORRADO (ALARMAS)
// ===================================================================
   if(id == CHARTEVENT_OBJECT_DRAG)
     {
      ulong tk = 0;
      ushort opcode = ParseTMObject(sparam, tk);

      if(opcode == OP_ALARM_LINE)
        {
         int total = ArraySize(m_activeAlerts);
         for(int i = 0; i < total; i++)
           {
            if(m_activeAlerts[i].id == tk)
              {
               // Actualizamos las coordenadas a las nuevas
               if(m_activeAlerts[i].isTrend)
                 {
                  m_activeAlerts[i].t1 = (datetime)ObjectGetInteger(m_chartId, sparam, OBJPROP_TIME, 0);
                  m_activeAlerts[i].p1 = ObjectGetDouble(m_chartId, sparam, OBJPROP_PRICE, 0);
                  m_activeAlerts[i].t2 = (datetime)ObjectGetInteger(m_chartId, sparam, OBJPROP_TIME, 1);
                  m_activeAlerts[i].p2 = ObjectGetDouble(m_chartId, sparam, OBJPROP_PRICE, 1);
                 }
               else
                 {
                  m_activeAlerts[i].fixedPrice = ObjectGetDouble(m_chartId, sparam, OBJPROP_PRICE, 0);
                 }

               // Reactivamos la alarma, la pintamos roja y deseleccionamos
               m_activeAlerts[i].isActive = true;
               ObjectSetInteger(m_chartId, sparam, OBJPROP_COLOR, clrRed);
               ObjectSetInteger(m_chartId, sparam, OBJPROP_SELECTED, false);

               SaveAlertsToBin();
               ChartRedraw();
               break;
              }
           }
        }
     }

   if(id == CHARTEVENT_OBJECT_DELETE)
     {
      ulong tk = 0;
      ushort opcode = ParseTMObject(sparam, tk);

      if(opcode == OP_ALARM_LINE)
        {
         int total = ArraySize(m_activeAlerts);
         for(int i = 0; i < total; i++)
           {
            if(m_activeAlerts[i].id == tk)
              {
               // 🪦 TOMBSTONE PATTERN: La matamos lógicamente al instante.
               // El HFT dejará de evaluarla y no sonará más.
               m_activeAlerts[i].id = 0;
               break;
              }
           }
        }
     }

// ===================================================================
// 3. CLICS NATIVOS DE MT5 (SOLO PARA FIGURAS Y LÍNEAS)
// ===================================================================
   if(id == CHARTEVENT_OBJECT_CLICK)
     {
      ulong tk = 0;
      ushort op = ParseTMObject(sparam, tk);
      
      // ESCUDO ANTI-FANTASMAS: Ignora clics en botones nativos del EA1 si está colapsado
      if(m_isPreOpCollapsed && tk == 0 && op != OP_NONE)
         return;

      // Ahora que los menús son CCanvas, SOLO procesamos botones nativos (Entry, Move, Cancel, TP, SL)
      if(op >= 200 && op <= 299 && op != OP_TM_MENU)
        {
         DWM.CloseAllDropdowns(); // <--- INYECTAMOS AQUÍ TAMBIÉN
         TM_HandleClick(sparam);
        }
     }
  }







//+------------------------------------------------------------------+
//| NUEVA FUNCIÓN: ANTICOLISIÓN DE LÍNEA DE ENTRADA                  |
//+------------------------------------------------------------------+
void              PreventLineCollision()
  {
// Solo nos importa si estamos moviendo la entrada manualmente
   if(!ObjectGetInteger(m_chartId, m_lineEntry, OBJPROP_SELECTED))
      return;

   double entry = ObjectGetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE);
   double sl    = ObjectGetDouble(m_chartId, m_lineSL, OBJPROP_PRICE);
   double tp    = ObjectGetDouble(m_chartId, m_lineTP, OBJPROP_PRICE);

   double point    = Market.point;
   double minGap = point * 20; // ~2 Pips de seguridad

// Detectar estructura (¿SL está arriba o abajo?)
   if(sl < tp) // Estructura BUY
     {
      // No dejar que Entry baje más que (SL + Gap)
      if(entry <= sl + minGap)
         ObjectSetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE, sl + minGap);
      // No dejar que Entry suba más que (TP - Gap)
      if(entry >= tp - minGap)
         ObjectSetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE, tp - minGap);
     }
   else // Estructura SELL
     {
      // No dejar que Entry suba más que (SL - Gap)
      if(entry >= sl - minGap)
         ObjectSetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE, sl - minGap);
      // No dejar que Entry baje más que (TP + Gap)
      if(entry <= tp + minGap)
         ObjectSetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE, tp + minGap);
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              ToggleLines(bool enable)
  {
   m_linesActive = enable; // <--- FORZAR SINCRONIZACIÓN AL INICIO

   int wPanel = 270; // Ancho total de tu panel

   if(!enable)
     {
      // --- MAGIA: RESCATAMOS LA DIRECCIÓN ANTES DE BORRAR LAS LÍNEAS ---
      bool wasBuy = true; // Por defecto
      if(ObjectFind(m_chartId, m_lineEntry) >= 0 && ObjectFind(m_chartId, m_lineSL) >= 0)
        {
         double currentE = ObjectGetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE);
         double currentS = ObjectGetDouble(m_chartId, m_lineSL, OBJPROP_PRICE);
         if(currentE > 0)
            wasBuy = (currentS < currentE);
        }

      /// Limpiamos la caché en RAM para que nazca fresco la próxima vez (en el precio actual)
      g_panelDisk[0].lineEntryPrice = 0;
      g_panelDisk[0].lineSLPrice = wasBuy ? 1.0 : -1.0; // Usamos el SL como bandera de memoria (1 = Buy, -1 = Sell)
      g_panelDisk[0].lineTPPrice = 0;
      SavePanelToBin();

      // --- INYECCIÓN MATEMÁTICA: RESET DE ESTADOS ---
      m_isStopLimitMode = false;
      m_isPreOpCollapsed = false; // <--- AÑADIR ESTO
      // ----------------------------------------------

      ObjectDelete(m_chartId, m_lineEntry);
      ObjectDelete(m_chartId, m_lineEntry);
      ObjectDelete(m_chartId, m_lineSL);
      ObjectDelete(m_chartId, m_lineTP);
      ObjectDelete(m_chartId, m_lineStopLimit);
      ObjectDelete(m_chartId, m_rectProfit);
      ObjectDelete(m_chartId, m_rectLoss);
      ObjectDelete(m_chartId, m_btnCenter_Name);
      ObjectDelete(m_chartId, m_btnTP_Name);
      ObjectDelete(m_chartId, m_btnSL_Name);
      ObjectDelete(m_chartId, m_btnSec_Name);
      ObjectDelete(m_chartId, m_btnMKT_Chart_Name);
      ObjectDelete(m_chartId, m_btnREV_Chart_Name);
      ObjectDelete(m_chartId, m_btnSLim_Chart_Name);
      ObjectDelete(m_chartId, m_btnClose_Chart_Name);
      ObjectDelete(m_chartId, m_btnOpen_Chart_Name);
      ObjectDelete(m_chartId, m_btnLockSL_Name);
      ObjectDelete(m_chartId, m_btnLockTP_Name);
      ObjectDelete(m_chartId, m_btnSec_Name + "_VisLine");

      DeleteAllTradeVisuals(0);

      m_isSLLocked = false;
      m_isTPLocked = false;
      UpdateBuySellButtons();
      UpdateOpenTradesVisuals();
      ChartRedraw();
      return;
     }

   UpdateTradeLevelsVisibility();


// 2. Colapsar y Borrar visualmente el EA2 de forma limpia
   EraseManagerVisuals();
// ------------------------------------------------------

// =======================================================
// MAGIA DE RESTAURACIÓN VS NACIMIENTO (100% RAM DRIVEN)
// =======================================================
   if(g_panelDisk[0].lineEntryPrice > 0)
     {
      // 1. MODO RESTAURACIÓN (Sobrevivió a un cambio de Timeframe / Reset)
      double savedEntry = g_panelDisk[0].lineEntryPrice;
      double savedSL    = g_panelDisk[0].lineSLPrice;
      double savedTP    = g_panelDisk[0].lineTPPrice;
      m_currentFixedX   = g_panelDisk[0].currentFixedX;

      CreateHLine(m_lineEntry, savedEntry, clrGray, STYLE_DASHDOT);
      CreateHLine(m_lineSL, savedSL, clrRed, STYLE_DASHDOT);
      CreateHLine(m_lineTP, savedTP, clrGreen, STYLE_DASHDOT);
     }
   else
     {
      // 2. MODO NACIMIENTO (El usuario hizo clic en "Show Lines")
      int chartW = (int)ChartGetInteger(m_chartId, CHART_WIDTH_IN_PIXELS);
      m_currentFixedX = (chartW / 2) - (FIGURE_WIDTH / 2);

      double price = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
      double point    = Market.point;
      int digits      = Market.digits;
      double mul      = Market.multiplier;

      double slPips = PanelState.GetSL();
      double tpPips = PanelState.GetTP();

      // --- MAGIA: LEEMOS LA DIRECCIÓN DE LA MEMORIA ---
      // Si guardamos un 1.0, esto será true (Buy). Si guardamos un -1.0, será false (Sell).
      // Si el EA es nuevo, por defecto será 0.0, lo que dará true (Buy).
      bool spawnAsBuy = (g_panelDisk[0].lineSLPrice >= 0);

      // Aplicamos la dirección rescatada
      double slPrice = spawnAsBuy ? (price - (slPips * mul)) : (price + (slPips * mul));
      double tpPrice = spawnAsBuy ? (price + (tpPips * mul)) : (price - (tpPips * mul));

      CreateHLine(m_lineEntry, price, clrGray, STYLE_DASHDOT);
      CreateHLine(m_lineSL, slPrice, clrRed, STYLE_DASHDOT);
      CreateHLine(m_lineTP, tpPrice, clrGreen, STYLE_DASHDOT);

      SetMarketMode(true); // Forzamos Market solo al nacer por primera vez
     }

   UpdateInputsFromLines();
   UpdateBuySellButtons();
   ChartRedraw();
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              CreateHLine(string name, double price, color clr, ENUM_LINE_STYLE style)
  {
   ObjectCreate(m_chartId, name, OBJ_HLINE, 0, 0, price);
   ObjectSetInteger(m_chartId, name, OBJPROP_COLOR, clr);
   ObjectSetInteger(m_chartId, name, OBJPROP_STYLE, style);
   ObjectSetInteger(m_chartId, name, OBJPROP_WIDTH, 1);
   ObjectSetInteger(m_chartId, name, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(m_chartId, name, OBJPROP_SELECTED, false);
  }
//+------------------------------------------------------------------+
//| CREAR RECTÁNGULO DE PÍXELES (OBJ_RECTANGLE_LABEL)                |
//+------------------------------------------------------------------+
void              CreateRect(string name, color clr)
  {
// Borramos por si existía el antiguo de tiempo
   ObjectDelete(m_chartId, name);

   ObjectCreate(m_chartId, name, OBJ_RECTANGLE_LABEL, 0, 0, 0);

// Propiedades visuales
   ObjectSetInteger(m_chartId, name, OBJPROP_COLOR, clr);      // Color del borde
   ObjectSetInteger(m_chartId, name, OBJPROP_BGCOLOR, clr);    // Color del fondo
   ObjectSetInteger(m_chartId, name, OBJPROP_BORDER_TYPE, BORDER_FLAT);
   ObjectSetInteger(m_chartId, name, OBJPROP_CORNER, CORNER_LEFT_UPPER);
   ObjectSetInteger(m_chartId, name, OBJPROP_BACK, true);      // Detrás de las velas y textos
   ObjectSetInteger(m_chartId, name, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(m_chartId, name, OBJPROP_SELECTED, false);
   ObjectSetInteger(m_chartId, name, OBJPROP_HIDDEN, false);
   ObjectSetInteger(m_chartId, name, OBJPROP_ZORDER, 0);       // Al fondo del todo (para no tapar textos)
  }

//+------------------------------------------------------------------+
//| ACTUALIZAR VISUALES (VERSIÓN FUSIONADA - SIN RETRASO)            |
//+------------------------------------------------------------------+
void              UpdateInputsFromLines()
  {
   double entryPrice = ObjectGetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE);
   double slPrice    = ObjectGetDouble(m_chartId, m_lineSL, OBJPROP_PRICE);
   double tpPrice    = ObjectGetDouble(m_chartId, m_lineTP, OBJPROP_PRICE);

   if(entryPrice == 0)
      return;

// 1. CÁLCULOS DE TEXTO
   double point    = Market.point;
   int digits      = Market.digits;
   double mul   = (digits==3 || digits==5) ? 10 * point : point;

   double slDist = MathAbs(entryPrice - slPrice) / mul;
   double tpDist = MathAbs(entryPrice - tpPrice) / mul;

// Reemplaza esta sección en UpdateInputsFromLines():

   if(m_isPriceMode)
     {
      PanelState.SetPrice(entryPrice);
      PanelState.SetSL(slPrice);
      PanelState.SetTP(tpPrice);
     }
   else
     {
      PanelState.SetPrice(0.0);
      PanelState.SetSL(slDist);
      PanelState.SetTP(tpDist);
     }

// Cálculos de Dinero
   double lot = PanelState.GetLot(); // <--- LEEMOS LA RAM DIRECTAMENTE
   double tickVal  = Market.tickValue;
   double tickSize = Market.tickSize;
   string currency = AccountInfoString(ACCOUNT_CURRENCY);
   double moneySL = 0.0, moneyTP = 0.0;

   if(tickSize > 0 && lot > 0)
     {
      double distSL_Points = MathAbs(entryPrice - slPrice);
      double distTP_Points = MathAbs(entryPrice - tpPrice);
      moneySL = (distSL_Points / tickSize) * tickVal * lot;
      moneyTP = (distTP_Points / tickSize) * tickVal * lot;
     }

   string orderTypeStr = GetOrderTypeLabel(entryPrice, slPrice);
   string txtSL = StringFormat("SL %.0f | -%.2f %s | %s", slDist, moneySL, currency, DoubleToString(slPrice, digits));
   string txtTP = StringFormat("TP %.0f | +%.2f %s | %s", tpDist, moneyTP, currency, DoubleToString(tpPrice, digits));
   string type = (slPrice < entryPrice) ? "BUY" : "SELL";

// --- LEEMOS DE LA RAM PARA LA ETIQUETA ---
   string lotStr = DoubleToString(PanelState.GetLot(), 2);
   string txtEntry = StringFormat("%s | L:%s | %s", orderTypeStr, lotStr, DoubleToString(entryPrice, digits));
// -----------------------------------------------------------
// 2. POSICIONAMIENTO (COORDENADAS)
// -----------------------------------------------------------

// A. Coordenada X (LA CLAVE: Usaremos esta variable xStart para TODO)
   int xStart = m_currentFixedX;

// B. Coordenada Y
   int dummyX, yEntry, ySL, yTP;
   datetime currentTime = TimeCurrent();

   ChartTimePriceToXY(m_chartId, 0, currentTime, entryPrice, dummyX, yEntry);
   ChartTimePriceToXY(m_chartId, 0, currentTime, slPrice, dummyX, ySL);
   ChartTimePriceToXY(m_chartId, 0, currentTime, tpPrice, dummyX, yTP);

// ===========================================================
// CÁLCULO DE ESPACIOS, GEOMETRÍA Y COLORES (Detalles 1 y 2)
// ===========================================================
   int h = 18;
   int btnW = BTN_CHART_W;

   int leftGroupW  = btnW * 3;
   int rightGroupW = btnW * 2;
   int mainTextW   = FIGURE_WIDTH - leftGroupW - rightGroupW;

   bool isBuyDir = (slPrice < entryPrice);

// --- DETALLE 2: LÓGICA DE POSICIONAMIENTO ARRIBA/ABAJO ---
// Buy: Entry y SL quedan debajo de la línea. TP queda encima.
// Sell: Entry y SL quedan encima. TP queda debajo.
   int yCommon = isBuyDir ? yEntry : (yEntry - h);
   int yTPVis  = isBuyDir ? (yTP - h) : yTP;
   int ySLVis  = isBuyDir ? ySL : (ySL - h);

// --- DETALLE 1: COLORES DE LAS LÍNEAS HORIZONTALES ---
   color bgDark = ARGBToColor(Theme.surface);
   color tvGreen = C'8,153,129';
   color tvRed   = C'242,54,69';
   color entryBorderColor = isBuyDir ? tvGreen : tvRed;

// Teñimos las líneas nativas
   ObjectSetInteger(m_chartId, m_lineEntry, OBJPROP_COLOR, entryBorderColor);
   ObjectSetInteger(m_chartId, m_lineTP, OBJPROP_COLOR, tvGreen);
   ObjectSetInteger(m_chartId, m_lineSL, OBJPROP_COLOR, tvRed);
// ===========================================================

// 1. IZQUIERDA: [M] [R] [L]
   color cAccent = ARGBToColor(Theme.accent); // <--- EXTRAEMOS EL COLOR DEL TEMA

   color colMkt = m_isMarketMode ? cAccent : bgDark;
   DrawButton(m_btnMKT_Chart_Name, xStart, yCommon, "M", colMkt, m_isMarketMode ? ARGBToColor(Theme.bg) : clrNONE);
   SmartSetInteger(m_btnMKT_Chart_Name, OBJPROP_XSIZE, btnW);
   SmartSetInteger(m_btnMKT_Chart_Name, OBJPROP_BORDER_COLOR, m_isMarketMode ? cAccent : entryBorderColor);

   DrawButton(m_btnREV_Chart_Name, xStart + btnW, yCommon, "R", bgDark);
   SmartSetInteger(m_btnREV_Chart_Name, OBJPROP_XSIZE, btnW);
   SmartSetInteger(m_btnREV_Chart_Name, OBJPROP_BORDER_COLOR, entryBorderColor);

   color colSlim = m_isStopLimitMode ? cAccent : bgDark;
   DrawButton(m_btnSLim_Chart_Name, xStart + (btnW * 2), yCommon, "L", colSlim, m_isStopLimitMode ? ARGBToColor(Theme.bg) : clrNONE);
   SmartSetInteger(m_btnSLim_Chart_Name, OBJPROP_XSIZE, btnW);
   SmartSetInteger(m_btnSLim_Chart_Name, OBJPROP_BORDER_COLOR, m_isStopLimitMode ? cAccent : entryBorderColor);

// 2. CENTRO: Etiqueta de Info (Texto)
   int xTextStart = xStart + leftGroupW;
   DrawButton(m_btnCenter_Name, xTextStart, yCommon, txtEntry, bgDark);
   SmartSetInteger(m_btnCenter_Name, OBJPROP_XSIZE, mainTextW);
   SmartSetInteger(m_btnCenter_Name, OBJPROP_BORDER_COLOR, entryBorderColor);

   m_btnCenter_X = xTextStart;
   m_btnCenter_Y = yCommon;
   m_btnCenter_W = mainTextW;
   m_btnCenter_H = h;

// 3. DERECHA: [GO] [X]
   int xOpenStart = xStart + FIGURE_WIDTH - rightGroupW;
   DrawButton(m_btnOpen_Chart_Name, xOpenStart, yCommon, "GO", bgDark);
   SmartSetInteger(m_btnOpen_Chart_Name, OBJPROP_XSIZE, btnW);
   SmartSetInteger(m_btnOpen_Chart_Name, OBJPROP_BORDER_COLOR, entryBorderColor);

   int xCloseStart = xStart + FIGURE_WIDTH - btnW;
   DrawButton(m_btnClose_Chart_Name, xCloseStart, yCommon, "✖", bgDark);
   SmartSetInteger(m_btnClose_Chart_Name, OBJPROP_XSIZE, btnW);
   SmartSetInteger(m_btnClose_Chart_Name, OBJPROP_BORDER_COLOR, entryBorderColor);

// C. SL / TP (Candados y Texto)
   int lockW = LOCK_WIDTH;
   int textW = FIGURE_WIDTH - lockW;

// SL Objects (Rojo TV)
// --- DETALLE 4: COLOR DEL CANDADO ACTIVO (tvRed) ---
   color colLockSL = m_isSLLocked ? tvRed : bgDark;
   DrawButton(m_btnLockSL_Name, xStart, ySLVis, "F", colLockSL);
   SmartSetInteger(m_btnLockSL_Name, OBJPROP_XSIZE, lockW);
   SmartSetInteger(m_btnLockSL_Name, OBJPROP_BORDER_COLOR, tvRed);

   DrawButton(m_btnSL_Name, xStart + lockW, ySLVis, txtSL, tvRed);
   SmartSetInteger(m_btnSL_Name, OBJPROP_XSIZE, textW);
   SmartSetInteger(m_btnSL_Name, OBJPROP_BORDER_COLOR, tvRed);

// TP Objects (Verde TV)
// --- DETALLE 4: COLOR DEL CANDADO ACTIVO (tvGreen) ---
   color colLockTP = m_isTPLocked ? tvGreen : bgDark;
   DrawButton(m_btnLockTP_Name, xStart, yTPVis, "F", colLockTP);
   SmartSetInteger(m_btnLockTP_Name, OBJPROP_XSIZE, lockW);
   SmartSetInteger(m_btnLockTP_Name, OBJPROP_BORDER_COLOR, tvGreen);

   DrawButton(m_btnTP_Name, xStart + lockW, yTPVis, txtTP, tvGreen);
   SmartSetInteger(m_btnTP_Name, OBJPROP_XSIZE, textW);
   SmartSetInteger(m_btnTP_Name, OBJPROP_BORDER_COLOR, tvGreen);

   m_btnTP_X = xStart + lockW;
   m_btnTP_Y = yTPVis;
   m_btnTP_W = textW;
   m_btnTP_H = h;

   m_btnSL_X = xStart + lockW;
   m_btnSL_Y = ySLVis;
// A. Rectángulos de Fondo
   int yMinProfit = MathMin(yEntry, yTP);
   int hProfit    = MathAbs(yEntry - yTP);
   DrawRect(m_rectProfit, xStart, yEntry, yTP, COLOR_TP_AREA);
   SmartSetInteger(m_rectProfit, OBJPROP_XSIZE, FIGURE_WIDTH);

   int yMinLoss = MathMin(yEntry, ySL);
   int hLoss    = MathAbs(yEntry - ySL);
   DrawRect(m_rectLoss, xStart, yEntry, ySL, COLOR_SL_AREA);
   SmartSetInteger(m_rectLoss, OBJPROP_XSIZE, FIGURE_WIDTH);

// ACTUALIZAR VISUAL STOP LIMIT (Si está activo)
   if(m_isStopLimitMode && ObjectFind(0, m_lineStopLimit) >= 0)
     {
      double limPrice = ObjectGetDouble(0, m_lineStopLimit, OBJPROP_PRICE);
      int limX, limY;
      if(ChartTimePriceToXY(0, 0, currentTime, limPrice, limX, limY))
        {
         // LÓGICA DINÁMICA: Si el precio del límite es mayor a la entrada, va arriba. Si no, va abajo.
         bool isAboveSec = (limPrice > entryPrice);
         int ySecVis = isAboveSec ? (limY - BTN_HEIGHT) : (limY + 1);
         color colBorderSec = ARGBToColor(Theme.accent); // <--- ADIÓS MORADO QUEMADO

         // 1. Botón estilo oscuro (como los del centro)
         DrawButton(m_btnSec_Name, xStart, ySecVis, "Stop Limit", ARGBToColor(Theme.surface));
         SmartSetInteger(m_btnSec_Name, OBJPROP_XSIZE, mainTextW);
         SmartSetInteger(m_btnSec_Name, OBJPROP_ZORDER, 14);
         SmartSetInteger(m_btnSec_Name, OBJPROP_FONTSIZE, 8);
         SmartSetInteger(m_btnSec_Name, OBJPROP_BORDER_COLOR, colBorderSec); // Borde morado

         // 2. Línea Visual Punteada
         string visLineSec = m_btnSec_Name + "_VisLine";
         if(ObjectFind(0, visLineSec) < 0)
           {
            ObjectCreate(0, visLineSec, OBJ_RECTANGLE_LABEL, 0, 0, 0);
            SmartSetInteger(visLineSec, OBJPROP_CORNER, CORNER_LEFT_UPPER);
            SmartSetInteger(visLineSec, OBJPROP_YSIZE, 1);
            SmartSetInteger(visLineSec, OBJPROP_BACK, false);
            SmartSetInteger(visLineSec, OBJPROP_ZORDER, 10);
            SmartSetInteger(visLineSec, OBJPROP_BORDER_TYPE, BORDER_FLAT);
            SmartSetInteger(visLineSec, OBJPROP_STYLE, STYLE_DOT);
           }
         SmartSetInteger(visLineSec, OBJPROP_XSIZE, FIGURE_WIDTH);
         SmartSetInteger(visLineSec, OBJPROP_XDISTANCE, xStart);
         SmartSetInteger(visLineSec, OBJPROP_YDISTANCE, limY);
         SmartSetInteger(visLineSec, OBJPROP_BGCOLOR, clrNONE);
         SmartSetInteger(visLineSec, OBJPROP_COLOR, colBorderSec);
        }
     }
   else
     {
      ObjectDelete(0, m_btnSec_Name);
      ObjectDelete(0, m_btnSec_Name + "_VisLine");
     }


// --------------------------------------------------------------
// ZONA UNIVERSAL DE RENDERIZADO: El Panel usa el motor del Gestor
// --------------------------------------------------------------

// 1. Cargamos lo que el usuario seleccionó en la UI hacia la Plantilla RAM
   SyncPanelToTemplateState();

// 2. Dibujamos el Break Even usando la lógica AAA (Ticket 0 = Panel)
   UpdateBELogic(0, xStart);

// 3. Dibujamos el Trailing Stop usando la lógica AAA (Ticket 0 = Panel)
   TS_Calculation tsCalc = CalculateTSLevels(0);
   DrawTSVisuals(0, tsCalc, xStart);

// 4. Dibujamos el Grid! (Ticket 0 = Panel)
   UpdateGridLogic(0, "", xStart);

// 5. Actualizar botones principales
   UpdateBuySellButtons();
   
   // ---> AÑADIR ESTO:
   ApplyPreOpCollapseState(m_isPreOpCollapsed);

// 6. REDIBUJAR
   ChartRedraw();
  }

// --- Nuevos Helpers pequeños para no repetir código ---
void              MoveLabel(string name, double price, string text)
  {
   int x, y;
   if(ChartTimePriceToXY(m_chartId, 0, TimeCurrent(), price, x, y))
     {
      ObjectSetInteger(m_chartId, name, OBJPROP_XDISTANCE, x);
      ObjectSetInteger(m_chartId, name, OBJPROP_YDISTANCE, y - 9);
      ObjectSetInteger(m_chartId, name, OBJPROP_XSIZE, 220);
      ObjectSetInteger(m_chartId, name, OBJPROP_YSIZE, 18);
      ObjectSetString(m_chartId, name, OBJPROP_TEXT, text);
     }
  }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              SetLabelColor(string name, color c)
  {
   ObjectSetInteger(m_chartId, name, OBJPROP_BGCOLOR, c);
   ObjectSetInteger(m_chartId, name, OBJPROP_BORDER_COLOR, c);
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              AutoFlipLines()
  {
// Obtener precios actuales
   double entry = ObjectGetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE);
   double sl    = ObjectGetDouble(m_chartId, m_lineSL, OBJPROP_PRICE);
   double tp    = ObjectGetDouble(m_chartId, m_lineTP, OBJPROP_PRICE);

// Calcular distancias absolutas (sin importar signo)
   double distSL = MathAbs(entry - sl);
   double distTP = MathAbs(entry - tp);

// CASO A: Estamos arrastrando el STOP LOSS (Target 2)
   if(m_dragTarget == 2)
     {
      // Si el SL subió por encima de la entrada (Sell), pero el TP sigue arriba (Buy)...
      if(sl > entry && tp > entry)
        {
         // ...mandamos el TP abajo para formar una Venta válida
         ObjectSetDouble(m_chartId, m_lineTP, OBJPROP_PRICE, entry - distTP);
        }
      // Si el SL bajó por debajo de la entrada (Buy), pero el TP sigue abajo (Sell)...
      else
         if(sl < entry && tp < entry)
           {
            // ...mandamos el TP arriba para formar una Compra válida
            ObjectSetDouble(m_chartId, m_lineTP, OBJPROP_PRICE, entry + distTP);
           }
     }

// CASO B: Estamos arrastrando el TAKE PROFIT (Target 3)
   if(m_dragTarget == 3)
     {
      // Si el TP bajó por debajo de la entrada (Sell), pero el SL sigue abajo (Buy)...
      if(tp < entry && sl < entry)
        {
         // ...mandamos el SL arriba
         ObjectSetDouble(m_chartId, m_lineSL, OBJPROP_PRICE, entry + distSL);
        }
      // Si el TP subió por encima de la entrada (Buy), pero el SL sigue arriba (Sell)...
      else
         if(tp > entry && sl > entry)
           {
            // ...mandamos el SL abajo
            ObjectSetDouble(m_chartId, m_lineSL, OBJPROP_PRICE, entry - distSL);
           }
     }
  }

// Variable global temporal para sobrecargas
ScheduledTask     g_emptyTask;

// 1. Llamada tradicional desde los botones del Panel
bool              ExecuteOrder(ENUM_ORDER_TYPE btnType)
  {
   return ExecuteOrderCore(btnType, false, g_emptyTask);
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
int g_pending_preop_orders = 0; // Cuántas órdenes estamos esperando (Para el Split)
int g_failed_preop_orders  = 0; // Cuántas fallaron

// 2. EL MOTOR UNIVERSAL DE EJECUCIÓN (Soporta Panel y TimeTrader)
bool              ExecuteOrderCore(ENUM_ORDER_TYPE btnType, bool isTask, ScheduledTask &task)
  {
// ==================================================================
// ESCUDO EQUITY PROTECT
// ==================================================================
   if(g_protect.accountLockedUntil > 0)
     {
      if(TimeCurrent() < g_protect.accountLockedUntil)
        {
         Print("[Execution] TRADE BLOCKED: Account is protected/locked until tomorrow.");
         PlaySound("error.wav");
         return false;
        }
      else
        {
         g_protect.accountLockedUntil = 0; // Desbloqueo automático al pasar el día
         SaveProtectToBin();
        }
     }

// ==================================================================
// ESCUDO DE SPREAD MÁXIMO
// ==================================================================
   if(g_maxSpread > 0 && btnType != -1) // -1 es si solo cerramos
     {
      string symCheck = isTask ? task.symbol : _Symbol;
      int currentSpread = (int)SymbolInfoInteger(symCheck, SYMBOL_SPREAD); // Devuelve en Puntos (Points)
      if(currentSpread > g_maxSpread)
        {
         PrintFormat("[Execution] TRADE BLOCKED: Current Spread (%d pts) exceeds Max Spread Limit (%d pts).", currentSpread, g_maxSpread);
         PlaySound("error.wav");
         return false;
        }
     }

// --- MULTI-SÍMBOLO INTELIGENTE ---
   string sym = isTask ? task.symbol : _Symbol;
   double ask = SymbolInfoDouble(sym, SYMBOL_ASK);
   double bid = SymbolInfoDouble(sym, SYMBOL_BID);

   double entryPrice=0, sl=0, tp=0, stopLimitPrice = 0.0, lot = 0;
   ENUM_ORDER_TYPE finalType = btnType;
   bool isPending = false;

// --- NUEVO: TRATAMIENTO SEGURO DEL COMENTARIO ---
   string baseComm = isTask ? "TimeTask" : PanelState.GetComment();
   if(baseComm == "")
      baseComm = "Auto";
   if(StringLen(baseComm) > 15)
      baseComm = StringSubstr(baseComm, 0, 15); // Seguridad Anti-Rechazo MT5
// ------------------------------------------------

// --- BANDERAS AVANZADAS (Inyección) ---
   bool useVirt  = isTask ? task.isVirtual : m_isVirtActive;
   bool useSplit = isTask ? task.isSplit   : m_isSplitActive;
   bool useHide  = isTask ? task.isHide    : m_isHideActive;

   SGridManager gridSrc = isTask ? task.grid : TemplateState.grid;
   int curLotMode  = isTask ? task.grid.lotMode : m_lotMode;
   int curDistMode = isTask ? task.grid.distMode : m_distMode;

// =======================================================
// 1. LEER DATOS (DE LA TAREA O DEL PANEL)
// =======================================================
   if(isTask)
     {
      lot = task.lots;
      entryPrice = task.entryPrice;
      if(entryPrice == 0)
         entryPrice = (task.actionId % 2 == 0) ? ask : bid;
      stopLimitPrice = task.stopLimitPrice;

      int a = task.actionId;
      if(a==0)
         finalType = ORDER_TYPE_BUY;
      if(a==1)
         finalType = ORDER_TYPE_SELL;
      if(a==2)
        {
         finalType = ORDER_TYPE_BUY_STOP;
         isPending = true;
        }
      if(a==3)
        {
         finalType = ORDER_TYPE_SELL_STOP;
         isPending = true;
        }
      if(a==4)
        {
         finalType = ORDER_TYPE_BUY_LIMIT;
         isPending = true;
        }
      if(a==5)
        {
         finalType = ORDER_TYPE_SELL_LIMIT;
         isPending = true;
        }
      if(a==6)
        {
         finalType = ORDER_TYPE_BUY_STOP_LIMIT;
         isPending = true;
        }
      if(a==7)
        {
         finalType = ORDER_TYPE_SELL_STOP_LIMIT;
         isPending = true;
        }

      bool isBuy = (finalType == ORDER_TYPE_BUY || finalType == ORDER_TYPE_BUY_LIMIT || finalType == ORDER_TYPE_BUY_STOP || finalType == ORDER_TYPE_BUY_STOP_LIMIT);

      if(task.isPriceMode)
        {
         sl = task.sl_value;
         tp = task.tp_value;
        }
      else
        {
         double point = SymbolInfoDouble(sym, SYMBOL_POINT);
         double mul = (SymbolInfoInteger(sym, SYMBOL_DIGITS)%2!=0) ? 10 * point : point;
         sl = (task.sl_value > 0) ? (isBuy ? entryPrice - (task.sl_value * mul) : entryPrice + (task.sl_value * mul)) : 0;
         tp = (task.tp_value > 0) ? (isBuy ? entryPrice + (task.tp_value * mul) : entryPrice - (task.tp_value * mul)) : 0;
        }
     }
   else
     {
      lot = PanelState.GetLot();
      if(m_linesActive)
        {
         entryPrice = ObjectGetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE);
         sl         = ObjectGetDouble(m_chartId, m_lineSL, OBJPROP_PRICE);
         tp         = ObjectGetDouble(m_chartId, m_lineTP, OBJPROP_PRICE);
         if(m_isStopLimitMode && ObjectFind(m_chartId, m_lineStopLimit) >= 0)
            stopLimitPrice = ObjectGetDouble(m_chartId, m_lineStopLimit, OBJPROP_PRICE);
        }
      else
        {
         double point = SymbolInfoDouble(sym, SYMBOL_POINT);
         double mul = (SymbolInfoInteger(sym, SYMBOL_DIGITS)%2!=0) ? 10 * point : point;

         if(m_isPriceMode)
           {
            entryPrice = (PanelState.GetPrice() > 0) ? PanelState.GetPrice() : ((btnType == ORDER_TYPE_BUY) ? ask : bid);
            sl = PanelState.GetSL();
            tp = PanelState.GetTP();
           }
         else
           {
            entryPrice = (btnType == ORDER_TYPE_BUY) ? ask : bid;
            double slPips = PanelState.GetSL();
            double tpPips = PanelState.GetTP();
            sl = (slPips > 0) ? ((btnType == ORDER_TYPE_BUY) ? entryPrice - (slPips * mul) : entryPrice + (slPips * mul)) : 0;
            tp = (tpPips > 0) ? ((btnType == ORDER_TYPE_BUY) ? entryPrice + (tpPips * mul) : entryPrice - (tpPips * mul)) : 0;
           }
        }

      if(m_linesActive && m_isMarketMode)
        {
         finalType = (btnType == ORDER_TYPE_BUY) ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
         entryPrice = (btnType == ORDER_TYPE_BUY) ? ask : bid;
         isPending = false;
        }
      else
         if(m_linesActive || (m_isPriceMode && PanelState.GetPrice() > 0))
           {
            if(btnType == ORDER_TYPE_BUY)
               finalType = (entryPrice > ask) ? ORDER_TYPE_BUY_STOP : ORDER_TYPE_BUY_LIMIT;
            else
               finalType = (entryPrice < bid) ? ORDER_TYPE_SELL_STOP : ORDER_TYPE_SELL_LIMIT;
            isPending = true;

            if(m_isStopLimitMode)
               finalType = (btnType == ORDER_TYPE_BUY) ? ORDER_TYPE_BUY_STOP_LIMIT : ORDER_TYPE_SELL_STOP_LIMIT;
           }
     }

   if(lot <= 0)
     {
      Alert("Invalid Lot Size");
      return false;
     }

// =======================================================================
// 1.5 CÁLCULO DE HERENCIA VISUAL (POSICIÓN X DEL PANEL)
// =======================================================================
   int spawnX = -1;
   if(!isTask) // Solo si viene del panel manual, no del Time Trader
     {
      int chartW = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);
      // Centrado matemático perfecto (Compensa la diferencia de anchos)
      spawnX = m_currentFixedX + (FIGURE_WIDTH / 2) - (TM_FIGURE_WIDTH / 2);

      // Escudos de colisión con los bordes de la pantalla
      if(spawnX < 0)
         spawnX = 0;
      if(spawnX + TM_FIGURE_WIDTH > chartW)
         spawnX = chartW - TM_FIGURE_WIDTH;
     }
   int cascadeStep = 0; // Contador para escalonar paneles en el Trade Splitting
// =======================================================================

// =======================================================================
// BLOQUE VIRTUAL: EL EA SE CONVIERTE EN BROKER (SOPORTA SPLITTING)
// =======================================================================
   if(useVirt && isPending)
     {
      int priceMode = 0;

      if(useSplit)
        {
         double remainingLot = lot;
         double step   = SymbolInfoDouble(sym, SYMBOL_VOLUME_STEP);
         double minLot = SymbolInfoDouble(sym, SYMBOL_VOLUME_MIN);
         double point  = SymbolInfoDouble(sym, SYMBOL_POINT);
         double mul    = (SymbolInfoInteger(sym, SYMBOL_DIGITS)%2!=0) ? 10 * point : point;
         bool isBuyStr = (finalType == ORDER_TYPE_BUY || finalType == ORDER_TYPE_BUY_LIMIT || finalType == ORDER_TYPE_BUY_STOP || finalType == ORDER_TYPE_BUY_STOP_LIMIT);

         int activeTPCount = 0, activeSLCount = 0;
         for(int k=0; k<MAX_LEVELS; k++)
           {
            if(gridSrc.rows[k].isActiveTP)
               activeTPCount++;
            if(gridSrc.rows[k].isActiveSL)
               activeSLCount++;
           }
         int rankTP = 0, rankSL = 0;

         for(int i=0; i<MAX_LEVELS; i++)
           {
            bool hasTP = gridSrc.rows[i].isActiveTP;
            bool hasSL = gridSrc.rows[i].isActiveSL;

            if(hasTP || hasSL)
              {
               double rowLot = 0.0;
               double inputVal = hasTP ? gridSrc.rows[i].valTP_Vol : gridSrc.rows[i].valSL_Vol;

               if(curLotMode == LOT_PCT_TOTAL)
                  rowLot = lot * (inputVal / 100.0);
               else
                  if(curLotMode == LOT_PCT_REMAIN)
                     rowLot = remainingLot * (inputVal / 100.0);
                  else
                     if(curLotMode == LOT_FIXED)
                        rowLot = inputVal;

               rowLot = MathFloor(rowLot / step) * step;
               if(rowLot > remainingLot)
                  rowLot = remainingLot;
               rowLot = MathFloor(rowLot / step) * step;
               if(rowLot < minLot)
                  continue;

               double rowTP = tp;
               double rowSL = sl;

               if(hasTP)
                 {
                  rankTP++;
                  double valTP = gridSrc.rows[i].valTP_Price;
                  if(valTP == 0 && curDistMode != MODE_AUTO)
                     rowTP = entryPrice;
                  else
                     if(curDistMode == MODE_PIPS)
                        rowTP = isBuyStr ? entryPrice + (valTP * mul) : entryPrice - (valTP * mul);
                     else
                        if(curDistMode == MODE_PRICE)
                           rowTP = valTP;
                        else
                           if(curDistMode == MODE_RR)
                             {
                              double risk = MathAbs(entryPrice - sl);
                              if(sl == 0 || risk < point)
                                 risk = 50 * mul;
                              double reward = risk * valTP;
                              rowTP = isBuyStr ? entryPrice + reward : entryPrice - reward;
                             }
                           else
                              if(curDistMode == MODE_AUTO)
                                {
                                 if(tp > 0)
                                   {
                                    double totalDist = MathAbs(tp - entryPrice);
                                    double stepDist = (totalDist / (activeTPCount + 1.0)) * rankTP;
                                    rowTP = isBuyStr ? entryPrice + stepDist : entryPrice - stepDist;
                                   }
                                 else
                                    rowTP = 0;
                                }
                 }

               if(hasSL)
                 {
                  rankSL++;
                  double valSL = gridSrc.rows[i].valSL_Price;
                  if(valSL == 0 && curDistMode != MODE_AUTO)
                     rowSL = entryPrice;
                  else
                     if(curDistMode == MODE_PIPS)
                        rowSL = isBuyStr ? entryPrice - (valSL * mul) : entryPrice + (valSL * mul);
                     else
                        if(curDistMode == MODE_PRICE)
                           rowSL = valSL;
                        else
                           if(curDistMode == MODE_RR)
                             {
                              double risk = MathAbs(entryPrice - sl);
                              if(sl == 0 || risk < point)
                                 risk = 50 * mul;
                              double dist = risk * valSL;
                              rowSL = isBuyStr ? entryPrice - dist : entryPrice + dist;
                             }
                           else
                              if(curDistMode == MODE_AUTO)
                                {
                                 if(sl > 0)
                                   {
                                    double totalDist = MathAbs(entryPrice - sl);
                                    double stepDist = (totalDist / (activeSLCount + 1.0)) * rankSL;
                                    rowSL = isBuyStr ? entryPrice - stepDist : entryPrice + stepDist;
                                   }
                                 else
                                    rowSL = 0;
                                }
                 }

               ulong vTicket = VIRTUAL_TICKET_BASE + (++g_virtualCounter);
               CTradeState *vMem = TradeRAM.Get(vTicket, sym); // <--- INYECCIÓN DIRECTA
               vMem.panelX = (spawnX != -1) ? (spawnX + (cascadeStep * 20)) : -1; // <--- INYECCIÓN (Cascada X)
               cascadeStep++;
               //vMem.symbol = sym; // <--- ¡NUEVO!
               vMem.isVirtual = true;
               vMem.virtType = finalType;
               vMem.virtEntry = entryPrice;
               vMem.virtSL = rowSL;
               vMem.virtTP = rowTP;
               vMem.virtLot = rowLot;
               vMem.virtPriceMode = priceMode;
               vMem.virtStopLimit = stopLimitPrice;
               vMem.virtComment = baseComm + " S" + IntegerToString(i+1);


               InjectSplitOrderSettings(vTicket, rowTP, rowSL, isTask, task);
               SaveVirtualOrder(vTicket);
               remainingLot -= rowLot;
              }
           }

         remainingLot = MathFloor(remainingLot / step) * step;
         if(remainingLot >= minLot)
           {
            ulong vBaseTicket = VIRTUAL_TICKET_BASE + (++g_virtualCounter);
            CTradeState *vBaseMem = TradeRAM.Get(vBaseTicket, sym); // <--- INYECCIÓN DIRECTA
            vBaseMem.panelX = (spawnX != -1) ? (spawnX + (cascadeStep * 20)) : -1; // <--- INYECCIÓN (Cascada X)
            //vBaseMem.symbol = sym; // <--- ¡NUEVO!
            vBaseMem.isVirtual = true;
            vBaseMem.virtType = finalType;
            vBaseMem.virtEntry = entryPrice;
            vBaseMem.virtSL = sl;
            vBaseMem.virtTP = tp;
            vBaseMem.virtLot = remainingLot;
            vBaseMem.virtPriceMode = priceMode;
            vBaseMem.virtStopLimit = stopLimitPrice;
            vBaseMem.virtComment = baseComm + " Base";

            InjectSettingsToManager(vBaseTicket, isTask, task, tp, sl);
            for(int k=0; k<5; k++)
              {
               vBaseMem.grid.rows[k].isActiveTP = false;
               vBaseMem.grid.rows[k].isActiveSL = false;
              }
            SaveVirtualOrder(vBaseTicket);
           }
        }
      else // VIRTUAL NORMAL
        {
         ulong vTicket = VIRTUAL_TICKET_BASE + (++g_virtualCounter);
         CTradeState *vMem = TradeRAM.Get(vTicket, sym); // <--- INYECCIÓN DIRECTA
         vMem.panelX = spawnX; // <--- INYECCIÓN (Centrado puro)
         //vMem.symbol = sym; // <--- ¡NUEVO! Le inyectamos el símbolo correcto
         vMem.isVirtual = true;
         vMem.virtType = finalType;
         vMem.virtEntry = entryPrice;
         vMem.virtSL = sl;
         vMem.virtTP = tp;
         vMem.virtLot = lot;
         vMem.virtPriceMode = priceMode;
         vMem.virtStopLimit = stopLimitPrice;
         vMem.virtComment = baseComm;

         InjectSettingsToManager(vTicket, isTask, task, tp, sl);
         SaveVirtualOrder(vTicket);
        }

      if(!isTask)
        {
         ToggleLines(false);
         m_linesActive = false;

         UpdateOpenTradesVisuals();
         ChartRedraw();

         if(g_autoScreenshot)
            TakeScreenshot("ENTRY_VIRT");
        }
      return true;
     }

// =======================================================================
// ENVÍO REAL AL BROKER (100% ASÍNCRONO + GHOST TICKETS)
// =======================================================================
   MqlTradeRequest req;
   ZeroMemory(req);

   req.action   = (finalType >= ORDER_TYPE_BUY_LIMIT) ? TRADE_ACTION_PENDING : TRADE_ACTION_DEAL;
   req.symbol   = sym;
   req.volume   = lot;
   req.type     = finalType;

   if((finalType == ORDER_TYPE_BUY_STOP_LIMIT || finalType == ORDER_TYPE_SELL_STOP_LIMIT) && stopLimitPrice > 0)
     {
      req.price     = stopLimitPrice;
      req.stoplimit = entryPrice;
     }
   else
     {
      req.price     = entryPrice;
     }

   req.sl       = useHide ? 0 : sl;
   req.tp       = useHide ? 0 : tp;
   req.deviation= 20;
   req.magic    = MAGIC_NUM;
   req.comment  = baseComm;

   long fillingMode = SymbolInfoInteger(sym, SYMBOL_FILLING_MODE);
   req.type_filling = ((fillingMode & SYMBOL_FILLING_FOK) != 0) ? ORDER_FILLING_FOK : (((fillingMode & SYMBOL_FILLING_IOC) != 0) ? ORDER_FILLING_IOC : ORDER_FILLING_RETURN);

// ---------------------------------------------------------
// A. SPLITTING REAL (División en Grids)
// ---------------------------------------------------------
// ---------------------------------------------------------
// A. SPLITTING REAL (División en Grids)
// ---------------------------------------------------------
   if(useSplit) // <--- CORRECCIÓN 1: Eliminamos el candado de m_linesActive
     {
      double remainingLot = lot;
      int ordersSent = 0;
      double step   = SymbolInfoDouble(sym, SYMBOL_VOLUME_STEP);
      double minLot = SymbolInfoDouble(sym, SYMBOL_VOLUME_MIN);
      double point  = SymbolInfoDouble(sym, SYMBOL_POINT);
      double mul    = (SymbolInfoInteger(sym, SYMBOL_DIGITS)%2!=0) ? 10 * point : point;

      // <--- CORRECCIÓN 2: Detectar dirección matemáticamente por el Type, no por el SL visual
      bool isBuyStr = (finalType == ORDER_TYPE_BUY || finalType == ORDER_TYPE_BUY_LIMIT || finalType == ORDER_TYPE_BUY_STOP || finalType == ORDER_TYPE_BUY_STOP_LIMIT);

      int activeTPCount = 0, activeSLCount = 0;
      for(int k=0; k<MAX_LEVELS; k++)
        {
         if(gridSrc.rows[k].isActiveTP)
            activeTPCount++;
         if(gridSrc.rows[k].isActiveSL)
            activeSLCount++;
        }
      int rankTP = 0, rankSL = 0;

      for(int i=0; i<MAX_LEVELS; i++)
        {
         bool hasTP = gridSrc.rows[i].isActiveTP;
         bool hasSL = gridSrc.rows[i].isActiveSL;

         if(hasTP || hasSL)
           {
            double rowLot = 0.0;
            double inputVal = hasTP ? gridSrc.rows[i].valTP_Vol : gridSrc.rows[i].valSL_Vol;

            if(curLotMode == LOT_PCT_TOTAL)
               rowLot = lot * (inputVal / 100.0);
            else
               if(curLotMode == LOT_PCT_REMAIN)
                  rowLot = remainingLot * (inputVal / 100.0);
               else
                  if(curLotMode == LOT_FIXED)
                     rowLot = inputVal;

            rowLot = MathFloor(rowLot / step) * step;
            if(rowLot > remainingLot)
               rowLot = remainingLot;
            rowLot = MathFloor(rowLot / step) * step;
            if(rowLot < minLot)
               continue;

            double rowTP = tp;
            double rowSL = sl;

            if(hasTP)
              {
               rankTP++;
               double valTP = gridSrc.rows[i].valTP_Price;
               if(valTP == 0 && curDistMode != MODE_AUTO)
                  rowTP = entryPrice;
               else
                  if(curDistMode == MODE_PIPS)
                     rowTP = isBuyStr ? entryPrice + (valTP * mul) : entryPrice - (valTP * mul);
                  else
                     if(curDistMode == MODE_PRICE)
                        rowTP = valTP;
                     else
                        if(curDistMode == MODE_RR)
                          {
                           double risk = MathAbs(entryPrice - sl);
                           if(sl == 0 || risk < point)
                              risk = 50 * mul;
                           rowTP = isBuyStr ? entryPrice + (risk * valTP) : entryPrice - (risk * valTP);
                          }
                        else
                           if(curDistMode == MODE_AUTO)
                             {
                              if(tp > 0)
                                {
                                 double totalDist = MathAbs(tp - entryPrice);
                                 double stepDist = (totalDist / (activeTPCount + 1.0)) * rankTP;
                                 rowTP = isBuyStr ? entryPrice + stepDist : entryPrice - stepDist;
                                }
                              else
                                 rowTP = 0;
                             }
              }

            if(hasSL)
              {
               rankSL++;
               double valSL = gridSrc.rows[i].valSL_Price;
               if(valSL == 0 && curDistMode != MODE_AUTO)
                  rowSL = entryPrice;
               else
                  if(curDistMode == MODE_PIPS)
                     rowSL = isBuyStr ? entryPrice - (valSL * mul) : entryPrice + (valSL * mul);
                  else
                     if(curDistMode == MODE_PRICE)
                        rowSL = valSL;
                     else
                        if(curDistMode == MODE_RR)
                          {
                           double risk = MathAbs(entryPrice - sl);
                           if(sl == 0 || risk < point)
                              risk = 50 * mul;
                           rowSL = isBuyStr ? entryPrice - (risk * valSL) : entryPrice + (risk * valSL);
                          }
                        else
                           if(curDistMode == MODE_AUTO)
                             {
                              if(sl > 0)
                                {
                                 double totalDist = MathAbs(entryPrice - sl);
                                 double stepDist = (totalDist / (activeSLCount + 1.0)) * rankSL;
                                 rowSL = isBuyStr ? entryPrice - stepDist : entryPrice + stepDist;
                                }
                              else
                                 rowSL = 0;
                             }
              }

            MqlTradeRequest splitReq = req;
            splitReq.volume  = rowLot;
            splitReq.comment = baseComm; // Corregido: antes tenías req.comment

            if(useHide)
              {
               splitReq.sl = 0;
               splitReq.tp = 0;
              }
            else
              {
               splitReq.sl = (rowSL > 0) ? SanitizePrice(rowSL, sym) : 0;
               splitReq.tp = (rowTP > 0) ? SanitizePrice(rowTP, sym) : 0;
              }

            // Sanitizamos también el precio de entrada de la orden dividida
            splitReq.price = SanitizePrice(splitReq.price, sym);

            // --- MAGIA FANTASMA: Creamos el ADN en RAM para la porción de Split ---
            ulong ghostSplitTk = VIRTUAL_TICKET_BASE + (++g_virtualCounter);
            CTradeState *ghostMem = TradeRAM.Get(ghostSplitTk, sym);
            ghostMem.panelX = (spawnX != -1) ? (spawnX + (cascadeStep * 20)) : -1; // <--- INYECCIÓN (Cascada X)
            cascadeStep++;
            ghostMem.isVirtual = true; // Para que el recolector no lo mate por error
            InjectSplitOrderSettings(ghostSplitTk, rowTP, rowSL, isTask, task);

            // Encolamos el envío
            PushAsyncRequest(splitReq, 0, ghostSplitTk, ASYNC_PLACE_SPLIT);

            remainingLot -= rowLot;
            ordersSent++;
           }
        }

      remainingLot = MathFloor(remainingLot / step) * step;
      if(remainingLot >= minLot)
        {
         MqlTradeRequest baseReq = req;
         baseReq.volume  = remainingLot;
         baseReq.comment = baseComm + " Base";

         // --- MAGIA FANTASMA: Creamos el ADN para la Base ---
         ulong ghostBaseTk = VIRTUAL_TICKET_BASE + (++g_virtualCounter);
         CTradeState *ghostBaseMem = TradeRAM.Get(ghostBaseTk, sym);
         ghostBaseMem.panelX = (spawnX != -1) ? (spawnX + (cascadeStep * 20)) : -1; // <--- INYECCIÓN (Cascada X)
         ghostBaseMem.isVirtual = true;
         InjectSettingsToManager(ghostBaseTk, isTask, task, tp, sl);
         for(int k=0; k<5; k++)
           {
            ghostBaseMem.grid.rows[k].isActiveTP = false;
            ghostBaseMem.grid.rows[k].isActiveSL = false;
           }

         PushAsyncRequest(baseReq, 0, ghostBaseTk, ASYNC_PLACE_BASE);
         ordersSent++;
        }

      if(ordersSent > 0 && !isTask)
        {
         // UI DE CARGA (Esperando al bróker)
         g_pending_preop_orders = ordersSent;
         g_failed_preop_orders = 0;
         ObjectSetString(m_chartId, m_btnCenter_Name, OBJPROP_TEXT, "SENDING ORDER...");
         ChartRedraw();
        }
      return true;
     }
// ---------------------------------------------------------
// B. EJECUCIÓN REAL NORMAL (Sin Grid)
   else
     {
      // --- MAGIA FANTASMA: ADN para orden normal ---
      ulong ghostTk = VIRTUAL_TICKET_BASE + (++g_virtualCounter);
      CTradeState *ghostMem = TradeRAM.Get(ghostTk, sym);
      ghostMem.panelX = spawnX; // <--- INYECCIÓN (Centrado puro)
      ghostMem.isVirtual = true;

      // --- INYECCIÓN DE IDENTIDAD (LA CURA) ---
      ghostMem.virtType  = finalType;
      ghostMem.virtEntry = entryPrice;
      ghostMem.virtLot   = lot;
      ghostMem.virtSL    = sl;
      ghostMem.virtTP    = tp;

      InjectSettingsToManager(ghostTk, isTask, task, tp, sl);


      // --- SANITIZACIÓN DE ÚLTIMO MILISEGUNDO ---
      req.price = SanitizePrice(req.price, sym);
      if(req.stoplimit > 0)
         req.stoplimit = SanitizePrice(req.stoplimit, sym);
      if(req.sl > 0)
         req.sl = SanitizePrice(req.sl, sym);
      if(req.tp > 0)
         req.tp = SanitizePrice(req.tp, sym);

      PushAsyncRequest(req, 0, ghostTk, ASYNC_PLACE_BASE);

      if(!isTask)
        {
         // UI DE CARGA (Esperando al bróker)
         g_pending_preop_orders = 1;
         g_failed_preop_orders = 0;
         ObjectSetString(m_chartId, m_btnCenter_Name, OBJPROP_TEXT, "SENDING ORDER...");
         ChartRedraw();
        }
      return true;
     }
  }


// HELPERS
void              CreateFloatLabel(string name, color bg)
  {
   ObjectCreate(m_chartId, name, OBJ_BUTTON, 0, 0, 0);
   ObjectSetInteger(m_chartId, name, OBJPROP_CORNER, CORNER_LEFT_UPPER);
   ObjectSetInteger(m_chartId, name, OBJPROP_COLOR, clrWhite);      // Texto Blanco
   ObjectSetInteger(m_chartId, name, OBJPROP_BGCOLOR, bg);          // Fondo Color Intenso
   ObjectSetInteger(m_chartId, name, OBJPROP_BORDER_TYPE, BORDER_FLAT); // <--- TRUCO: Borde Plano
   ObjectSetInteger(m_chartId, name, OBJPROP_BORDER_COLOR, C'192,192,192'); // <--- BORDE PLATEADO VISIBLE   ObjectSetInteger(m_chartId, name, OBJPROP_FONTSIZE, 9);
   ObjectSetString(m_chartId, name, OBJPROP_FONT, "Calibri");       // Fuente limpia
   ObjectSetInteger(m_chartId, name, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(m_chartId, name, OBJPROP_HIDDEN, false);
   ObjectSetInteger(m_chartId, name, OBJPROP_ZORDER, 100);          // Encima de todo

   ObjectSetInteger(m_chartId, name, OBJPROP_XSIZE, 25);
   ObjectSetInteger(m_chartId, name, OBJPROP_YSIZE, 18);

  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool              CreateLabel(CChartObjectLabel &obj, string name, string text, int x, int y, int fs, bool bold)
  {
   if(!obj.Create(m_chartId, name, 0, x, y))
      return false;
   obj.Description(text);
   obj.Color(COLOR_TEXT);
   obj.FontSize(fs);
   obj.Font(FONT_FACE);
   obj.Selectable(false);
   obj.Z_Order(0);
   return true;
  }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool              CreateButton(CChartObjectButton &obj, string name, string text, int x, int y, int w, int h, color bg)
  {
   if(!obj.Create(m_chartId, name, 0, x, y, w, h))
      return false;
   obj.Description(text);
   obj.BackColor(bg);
   obj.Color(clrWhite);
   obj.FontSize(10);
   obj.Font(FONT_FACE);
   obj.SetInteger(OBJPROP_BORDER_TYPE, 0);
   obj.Selectable(false);
   obj.Z_Order(110);
   return true;
  }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool              CreateInput(CChartObjectEdit &obj, string name, string text, int x, int y, int w, bool ro)
  {
// ========================================================
// SOLUCIÓN ARQUITECTÓNICA: Destrucción y Resurrección
// Borramos el input viejo (si sobrevivió al cambio de TF)
// para forzar a MT5 a crear uno nuevo con máxima prioridad visual.
// ========================================================
   ObjectDelete(m_chartId, name);

   if(!obj.Create(m_chartId, name, 0, x, y, w, 20))
      return false;

   obj.Description(text);
   obj.BackColor(ro?COLOR_BG:COLOR_INPUT);
   obj.Color(ro?COLOR_TEXT:COLOR_TEXT_INPUT);
   obj.FontSize(10);
   obj.Font(FONT_FACE);
   obj.SetInteger(OBJPROP_BORDER_TYPE, 0);
   obj.ReadOnly(ro);
   obj.TextAlign(ALIGN_CENTER);
   obj.Z_Order(110);
   return true;
  }

//+------------------------------------------------------------------+
//| CALCULADORA MAESTRA DE LOTAJE (100% RAM OPTIMIZADA)              |
//+------------------------------------------------------------------+
void              CalculateLot()
  {
   if(m_riskMode == FIXED_LOT)
     {
      if(m_linesActive)
         UpdateInputsFromLines();
      return;
     }

   if(CheckPointer(TemplateState) == POINTER_INVALID)
      return;

// 1. Dinero a arriesgar
   double inputValue = PanelState.GetRisk();
   double balance    = AccountInfoDouble(ACCOUNT_BALANCE);
   double riskMoney  = (m_riskMode == RISK_PERCENT) ? (balance * (inputValue / 100.0)) : inputValue;

// 2. Oráculo (Lectura en 1 ciclo de reloj desde RAM)
   g_marketDB[TemplateState.sym_id].UpdateDynamic(TemplateState.symbol);
   double tickSize = g_marketDB[TemplateState.sym_id].tickSize;
   double tickVal  = g_marketDB[TemplateState.sym_id].tickValue;
   double point    = g_marketDB[TemplateState.sym_id].point;
   int digits      = g_marketDB[TemplateState.sym_id].digits;

   if(tickSize == 0 || tickVal == 0)
      return;

// 3. Calcular distancia SL
   double slPoints = 0.0;
   if(m_isPriceMode)
     {
      double priceEntry = PanelState.GetPrice();
      double priceSL    = PanelState.GetSL();

      if(priceEntry == 0 && m_linesActive)
         priceEntry = ObjectGetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE);
      if(priceSL == 0 && m_linesActive)
         priceSL    = ObjectGetDouble(m_chartId, m_lineSL, OBJPROP_PRICE);
      if(priceEntry == 0)
         priceEntry = SymbolInfoDouble(_Symbol, SYMBOL_BID);

      if(priceEntry > 0 && priceSL > 0)
         slPoints = MathAbs(priceEntry - priceSL) / point;
     }
   else
     {
      double slPips = PanelState.GetSL();
      slPoints = (digits == 3 || digits == 5) ? slPips * 10 : slPips;
     }

   if(slPoints <= 0)
     {
      PanelState.SetLot(0.00);
      return;
     }

// 4. Calcular Pérdida por Lote y Volumen Final
   double lossPerStandardLot = (slPoints * point) / tickSize * tickVal;
   if(lossPerStandardLot <= 0)
      return;

   double calculatedLot = riskMoney / lossPerStandardLot;

// 5. Normalizar usando el Oráculo
   double minLot = g_marketDB[TemplateState.sym_id].volMin;
   double maxLot = g_marketDB[TemplateState.sym_id].volMax;
   double step   = g_marketDB[TemplateState.sym_id].volStep;

   if(calculatedLot < minLot)
      calculatedLot = minLot;
   if(calculatedLot > maxLot)
      calculatedLot = maxLot;
   calculatedLot = MathFloor(calculatedLot / step) * step;

   PanelState.SetLot(calculatedLot);
   if(m_linesActive)
      UpdateInputsFromLines();
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              SetVisible(CChartObject &obj, bool visible)
  {
   long targetTF = visible ? OBJ_ALL_PERIODS : OBJ_NO_PERIODS;

// Preguntamos directamente al motor de MT5 (super rápido).
// Si el objeto ya está como queremos, lo ignoramos y evitamos el parpadeo.
   if(ObjectGetInteger(m_chartId, obj.Name(), OBJPROP_TIMEFRAMES) != targetTF)
     {
      ObjectSetInteger(m_chartId, obj.Name(), OBJPROP_TIMEFRAMES, targetTF);
     }
  }

//+------------------------------------------------------------------+
//| MOVER LÍNEAS DESDE LA RAM (CERO LAG)                             |
//+------------------------------------------------------------------+
void              UpdateLinesFromInputs()
  {
   double entryPrice = ObjectGetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE);
   if(entryPrice == 0)
      entryPrice = SymbolInfoDouble(_Symbol, SYMBOL_BID);

   if(m_isPriceMode)
     {
      double newEntry = PanelState.GetPrice();
      if(newEntry > 0)
        {
         entryPrice = newEntry;
         ObjectSetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE, entryPrice);
        }

      double newSL = PanelState.GetSL();
      double newTP = PanelState.GetTP();

      if(newSL > 0)
         ObjectSetDouble(m_chartId, m_lineSL, OBJPROP_PRICE, newSL);
      if(newTP > 0)
         ObjectSetDouble(m_chartId, m_lineTP, OBJPROP_PRICE, newTP);
     }
   else
     {
      double slPips = PanelState.GetSL();
      double tpPips = PanelState.GetTP();

      double point    = Market.point;
      int digits      = Market.digits;
      double pipsMultiplier = (digits==3 || digits==5) ? 10 * point : point;

      // Usamos la posición previa del SL para deducir la dirección (Sell o Buy)
      double currentSL = ObjectGetDouble(m_chartId, m_lineSL, OBJPROP_PRICE);
      bool isSell = (currentSL > entryPrice);

      double slPrice = isSell ? entryPrice + (slPips * pipsMultiplier) : entryPrice - (slPips * pipsMultiplier);
      double tpPrice = isSell ? entryPrice - (tpPips * pipsMultiplier) : entryPrice + (tpPips * pipsMultiplier);

      ObjectSetDouble(m_chartId, m_lineSL, OBJPROP_PRICE, slPrice);
      ObjectSetDouble(m_chartId, m_lineTP, OBJPROP_PRICE, tpPrice);
     }
  }

//+------------------------------------------------------------------+
//| INVERTIR ORDEN (BUY <. SELL) sin arrastrar                      |
//+------------------------------------------------------------------+
void              FlipOrderMode()
  {
   double entry = ObjectGetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE);
   double sl    = ObjectGetDouble(m_chartId, m_lineSL, OBJPROP_PRICE);
   double tp    = ObjectGetDouble(m_chartId, m_lineTP, OBJPROP_PRICE);

// 1. Calcular distancias actuales (con signo)
   double slDiff = sl - entry;
   double tpDiff = tp - entry;

// 2. Invertir distancias (Multiplicar por -1)
   double newSL = entry - slDiff;
   double newTP = entry - tpDiff;

// 3. --- FIX: MODO MARKET INTELIGENTE AL HACER REVERSE ---
   if(m_isMarketMode)
     {
      // Si acabo de invertirlo, ¿ahora qué es?
      bool isNowBuy = (newSL < entry); // Si el nuevo SL quedó abajo, ahora es Buy

      double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
      double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);

      // Ajustamos el entry al precio correspondiente
      double marketTarget = isNowBuy ? ask : bid;

      // Ajustamos el delta de movimiento general
      double deltaMarket = marketTarget - entry;

      entry = marketTarget;
      newSL += deltaMarket;
      newTP += deltaMarket;
     }

// 4. Aplicar nuevos precios
   ObjectSetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE, entry);
   ObjectSetDouble(m_chartId, m_lineSL, OBJPROP_PRICE, newSL);
   ObjectSetDouble(m_chartId, m_lineTP, OBJPROP_PRICE, newTP);

// 5. Actualizar todo visualmente
   UpdateInputsFromLines();
   ChartRedraw();
  }

//+------------------------------------------------------------------+
//| Ajustar escala del gráfico si las líneas se salen de la pantalla |
//+------------------------------------------------------------------+
void              CheckAutoZoom()
  {
   if(!m_linesActive)
      return;

// 1. Obtener precios extremos de nuestras líneas
   double sl = ObjectGetDouble(m_chartId, m_lineSL, OBJPROP_PRICE);
   double tp = ObjectGetDouble(m_chartId, m_lineTP, OBJPROP_PRICE);
   double entry = ObjectGetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE);

// Calcular el máximo y mínimo absoluto que necesitamos ver
   double maxPriceNeeded = MathMax(sl, MathMax(tp, entry));
   double minPriceNeeded = MathMin(sl, MathMin(tp, entry));

// 2. Obtener lo que se ve actualmente en pantalla
   double chartMax = ChartGetDouble(m_chartId, CHART_PRICE_MAX);
   double chartMin = ChartGetDouble(m_chartId, CHART_PRICE_MIN);

// 3. ¿Están fuera de visión?
   bool needsZoom = false;
   if(maxPriceNeeded > chartMax)
      needsZoom = true;
   if(minPriceNeeded < chartMin)
      needsZoom = true;

// 4. Si es necesario, aplicar corrección
   if(needsZoom)
     {
      // Calculamos un margen del 10% para que no queden pegados al borde
      double range = maxPriceNeeded - minPriceNeeded;
      double padding = range * 0.1;

      // Activamos escala fija temporalmente con los nuevos límites
      ChartSetInteger(m_chartId, CHART_SCALEFIX, true);
      ChartSetDouble(m_chartId, CHART_FIXED_MAX, maxPriceNeeded + padding);
      ChartSetDouble(m_chartId, CHART_FIXED_MIN, minPriceNeeded - padding);

      ChartRedraw();
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              UpdateBuySellButtons()
  {
// Si estamos en la pestaña Portfolio (3), no hacemos nada
   if(g_activeTab == 3)
      return;

// Reconstruir el CCanvas: Esto actualizará textos, tamaños y botones en las pestañas 0, 1 y 2
   BuildCanvasUI();
  }
//+------------------------------------------------------------------+
//| RESETEAR LÍNEAS AL PRECIO DE MERCADO (INTELIGENTE Y ELÁSTICO)    |
//+------------------------------------------------------------------+
void              ResetLinesToMarket()
  {
   if(!m_linesActive)
      return;

// 1. Obtener precios actuales de las líneas principales
   double currentEntry = ObjectGetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE);
   double currentSL    = ObjectGetDouble(m_chartId, m_lineSL, OBJPROP_PRICE);
   double currentTP    = ObjectGetDouble(m_chartId, m_lineTP, OBJPROP_PRICE);

// 2. Detectar Estructura (¿Es Buy o Sell?)
   bool isBuy = (currentSL < currentEntry);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double targetPrice = isBuy ? ask : bid;

// 3. Calcular la diferencia (Delta) para el imán
   double deltaPrice = targetPrice - currentEntry;

// Escudo de CPU: Si no hay movimiento real, abortamos
   if(deltaPrice == 0)
      return;

// 4. APLICAR CAMBIOS (CON ESCUDO DE ARRASTRE UX)
   ObjectSetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE, targetPrice); // La entrada siempre viaja al precio

   if(!m_isDragging || m_dragTarget != 2) // Si NO tengo agarrado el SL
      ObjectSetDouble(m_chartId, m_lineSL, OBJPROP_PRICE, currentSL + deltaPrice);

   if(!m_isDragging || m_dragTarget != 3) // Si NO tengo agarrado el TP
      ObjectSetDouble(m_chartId, m_lineTP, OBJPROP_PRICE, currentTP + deltaPrice);

   if(m_isStopLimitMode && ObjectFind(m_chartId, m_lineStopLimit) >= 0)
     {
      if(!m_isDragging || m_dragTarget != 8) // Si NO tengo agarrado el Stop Limit
        {
         double currentSLim = ObjectGetDouble(m_chartId, m_lineStopLimit, OBJPROP_PRICE);
         ObjectSetDouble(m_chartId, m_lineStopLimit, OBJPROP_PRICE, currentSLim + deltaPrice);
        }
     }

// 5. MOVER LÍNEAS AVANZADAS (Usando la arquitectura Unificada correcta)
// Escudos para TS y BE
   if(!g_isDragging || g_dragType != 30)
      MoveUnifiedLineByDelta(MakeTMName(0, OP_HLINE_BE_START), deltaPrice);
   if(!g_isDragging || g_dragType != 31)
      MoveUnifiedLineByDelta(MakeTMName(0, OP_HLINE_BE_OFF), deltaPrice);
   if(!g_isDragging || g_dragType != 40)
      MoveUnifiedLineByDelta(MakeTMName(0, OP_HLINE_TS_START), deltaPrice);
   if(!g_isDragging || g_dragType != 41)
      MoveUnifiedLineByDelta(MakeTMName(0, OP_HLINE_TS_DIST), deltaPrice);

// Escudos para el Grid
   for(int k=1; k<=5; k++)
     {
      bool skipTP = (g_isDragging && g_dragType == 10 && g_dragGridRow == k);
      bool skipSL = (g_isDragging && g_dragType == 20 && g_dragGridRow == k);

      if(!skipTP)
         MoveUnifiedLineByDelta(MakeTMName(0, OP_HLINE_GRID_TP_1 + k - 1), deltaPrice);
      if(!skipSL)
         MoveUnifiedLineByDelta(MakeTMName(0, OP_HLINE_GRID_SL_1 + k - 1), deltaPrice);
     }

// 6. ACTUALIZACIÓN INMEDIATA DEL PANEL
   UpdateInputsFromLines();

// 7. MAGIA RISK/REWARD: Si el usuario arrastra algo y el RR está ON, recalculamos distancias
   if(m_isRRActive && m_isDragging)
     {
      if(m_dragTarget == 2)
         SyncRR(true, false);  // Si muevo el SL con el ratón, reajusta el TP
      if(m_dragTarget == 3)
         SyncRR(false, false); // Si muevo el TP con el ratón, reajusta el SL
     }

   ChartRedraw();
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              SetMarketMode(bool active)
  {
   m_isMarketMode = active;

   color cAccent  = ARGBToColor(Theme.accent);
   color cSurface = ARGBToColor(Theme.surface);
   color cBorder  = ARGBToColor(Theme.border);

// 2. Sincronizar Botón FLOTANTE [M] en el gráfico
   ObjectSetInteger(m_chartId, m_btnMKT_Chart_Name, OBJPROP_STATE, active);

   if(active)
     {
      // ENCENDIDO: Color Acento del Tema
      ObjectSetInteger(m_chartId, m_btnMKT_Chart_Name, OBJPROP_BGCOLOR, cAccent);
      ObjectSetInteger(m_chartId, m_btnMKT_Chart_Name, OBJPROP_BORDER_COLOR, cAccent);

      // Forzar salto inmediato al precio actual al activar
      ResetLinesToMarket();
     }
   else
     {
      // APAGADO: Color Superficie del Tema (Adiós Azul quemado)
      ObjectSetInteger(m_chartId, m_btnMKT_Chart_Name, OBJPROP_BGCOLOR, cSurface);
      ObjectSetInteger(m_chartId, m_btnMKT_Chart_Name, OBJPROP_BORDER_COLOR, cBorder);
     }

   ChartRedraw();
  }

//+------------------------------------------------------------------+
bool              IsMouseOverLabel(string name, int mx, int my)
  {
   if(ObjectFind(m_chartId, name) < 0)
      return false;

   // ESCUDO ANTI-FANTASMAS: Si el objeto está oculto en MT5, el ratón lo atraviesa
   if(ObjectGetInteger(m_chartId, name, OBJPROP_TIMEFRAMES) == OBJ_NO_PERIODS)
      return false;

   int x = (int)ObjectGetInteger(m_chartId, name, OBJPROP_XDISTANCE);
   int y = (int)ObjectGetInteger(m_chartId, name, OBJPROP_YDISTANCE);
   int w = (int)ObjectGetInteger(m_chartId, name, OBJPROP_XSIZE);
   int h = (int)ObjectGetInteger(m_chartId, name, OBJPROP_YSIZE);

   return (mx >= x && mx <= x+w && my >= y && my <= y+h);
  }

//+------------------------------------------------------------------+
//| CALCULAR LOTES PARCIALES                                         |
//+------------------------------------------------------------------+
void              CalculateManageLots()
  {
   double totalLot = PanelState.GetLot();
   if(totalLot <= 0)
      return;

// Recorremos TPs
   double remainingLot = totalLot;

   for(int i=0; i<MAX_LEVELS; i++)
     {
      // --- CAMBIO AQUÍ: Si el botón está apagado en RAM, ignoramos ---
      if(!TemplateState.grid.rows[i].isActiveTP)
         continue;


      double inputVal = TemplateState.grid.rows[i].valTP_Vol;
      double calculatedPart = 0.0;

      if(m_lotMode == LOT_PCT_TOTAL)
        {
         // 50% del total siempre es 0.5 lotes (si total es 1.0)
         calculatedPart = totalLot * (inputVal / 100.0);
        }
      else
         if(m_lotMode == LOT_PCT_REMAIN)
           {
            // 50% de lo que queda
            calculatedPart = remainingLot * (inputVal / 100.0);
            remainingLot -= calculatedPart; // Restamos lo usado
           }
         else
            if(m_lotMode == LOT_FIXED)
              {
               // El input YA es el lote
               calculatedPart = inputVal;
               remainingLot -= calculatedPart;
              }

      // IMPORTANTE: Aquí NO cambiamos el texto de la cajita editPct porque es lo que escribe el usuario.
      // Pero sí usaremos 'calculatedPart' para actualizar las Etiquetas Flotantes en el gráfico.
      // (Eso ya lo hace UpdateManageLabels al leer el modo).
     }
  }


//+------------------------------------------------------------------+
//| CREAR ETIQUETA FLOTANTE (Modo Pixel)                             |
//+------------------------------------------------------------------+
void              CreatePixelLabel(string name, color bgClr)
  {
   if(ObjectFind(m_chartId, name) < 0)
     {
      ObjectCreate(m_chartId, name, OBJ_BUTTON, 0, 0, 0);
      ObjectSetInteger(m_chartId, name, OBJPROP_CORNER, CORNER_LEFT_UPPER);
      ObjectSetInteger(m_chartId, name, OBJPROP_COLOR, clrWhite);
      ObjectSetInteger(m_chartId, name, OBJPROP_BORDER_TYPE, BORDER_FLAT);
      ObjectSetInteger(m_chartId, name, OBJPROP_FONTSIZE, 8);
      // CAMBIO AQUÍ: Fuente en Negrita
      ObjectSetString(m_chartId, name, OBJPROP_FONT, "Calibri Bold");
      ObjectSetInteger(m_chartId, name, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(m_chartId, name, OBJPROP_ZORDER, 15); // Un poco más alto
     }
   ObjectSetInteger(m_chartId, name, OBJPROP_BGCOLOR, bgClr);
   ObjectSetInteger(m_chartId, name, OBJPROP_BORDER_COLOR, bgClr);
// El tamaño lo definiremos dinámicamente en el Update,
// pero ponemos un default aquí por seguridad.
   ObjectSetInteger(m_chartId, name, OBJPROP_XSIZE, 80);
   ObjectSetInteger(m_chartId, name, OBJPROP_YSIZE, 18);
  }

//+------------------------------------------------------------------+
//| ACTUALIZAR DATOS GRID (ON TICK)                                  |
//+------------------------------------------------------------------+
void              UpdateToolData(bool forceRedraw = false)
  {
// Acumuladores
   double sumBuy=0, sumSell=0, sumWin=0, sumLoss=0;
   int    cntBuy=0, cntSell=0, cntWin=0, cntLoss=0;
   int cBS=0, cBL=0, cSS=0, cSL=0, cBSL=0, cSSL=0;

// 1. Escanear
   for(int i=PositionsTotal()-1; i>=0; i--)
     {
      ulong ticket = PositionGetTicket(i);
      if(ticket <= 0)
         continue;
      string posSym = PositionGetString(POSITION_SYMBOL);
      // Si el Modo Dios está APAGADO, solo vemos este símbolo. Si está ENCENDIDO, pasamos el filtro.
      if(!m_manageAllSymbols && posSym != _Symbol)
         continue;

      double prof = PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP); // + Comisiones si aplica
      long type   = PositionGetInteger(POSITION_TYPE);

      // Clasificación BUY / SELL
      if(type == POSITION_TYPE_BUY)
        {
         sumBuy  += prof;
         cntBuy++;
        }
      if(type == POSITION_TYPE_SELL)
        {
         sumSell += prof;
         cntSell++;
        }

      // Clasificación WIN / LOSS
      if(prof >= 0)
        {
         sumWin  += prof;
         cntWin++;
        }
      else
        {
         sumLoss += prof;
         cntLoss++;
        }
     }

   if(forceRedraw)
     {
      ChartRedraw();
     }

  }

//+------------------------------------------------------------------+
//| PROCESAR ACCIONES DE LA PESTAÑA TOOL                             |
//+------------------------------------------------------------------+
void              ProcessToolAction(int actionType)
  {
// actionType:
// 0=All, 1=Win, 2=Loss, 3=Buy, 4=Sell
// 5=DelBuyPend, 6=DelSellPend, 7=DelAllPend

// --- A. CERRAR POSICIONES ABIERTAS ---
   if(actionType <= 4)
     {
      for(int i=PositionsTotal()-1; i>=0; i--)
        {
         ulong ticket = PositionGetTicket(i);
         if(ticket <= 0)
            continue;

         if(!g_portAllSymbols && PositionGetString(POSITION_SYMBOL) != _Symbol)
            continue;

         // 🛡️ ESCUDO DE ASESINATO MASIVO
         if(!g_portAllMagics && PositionGetInteger(POSITION_MAGIC) != MAGIC_NUM)
            continue;

         bool closeIt = false;
         long type = PositionGetInteger(POSITION_TYPE);
         double profit = PositionGetDouble(POSITION_PROFIT);

         if(actionType == 0)
            closeIt = true; // Close All
         if(actionType == 1 && profit > 0)
            closeIt = true; // Winners
         if(actionType == 2 && profit < 0)
            closeIt = true; // Losers
         if(actionType == 3 && type == POSITION_TYPE_BUY)
            closeIt = true;
         if(actionType == 4 && type == POSITION_TYPE_SELL)
            closeIt = true;

         if(closeIt)
            QueueClosePosition(ticket);
        }
     }

// --- B. BORRAR ÓRDENES PENDIENTES ---
   else
     {
      // 1. ÓRDENES REALES
      for(int i=OrdersTotal()-1; i>=0; i--)
        {

         ulong ticket = OrderGetTicket(i);
         if(ticket <= 0)
            continue;
         if(!g_portAllSymbols && OrderGetString(ORDER_SYMBOL) != _Symbol)
            continue;

         // 🛡️ ESCUDO DE ASESINATO MASIVO BLINDADO
         if(!g_portAllMagics && OrderGetInteger(ORDER_MAGIC) != MAGIC_NUM)
            continue;

         bool deleteIt = false;
         long type = OrderGetInteger(ORDER_TYPE);

         if(actionType == 18)
            deleteIt = true; // DELETE ALL
         if(actionType == 10 && type == ORDER_TYPE_BUY_STOP)
            deleteIt = true;
         if(actionType == 11 && type == ORDER_TYPE_BUY_LIMIT)
            deleteIt = true;
         if(actionType == 12 && type == ORDER_TYPE_SELL_STOP)
            deleteIt = true;
         if(actionType == 13 && type == ORDER_TYPE_SELL_LIMIT)
            deleteIt = true;
         if(actionType == 14 && (type == ORDER_TYPE_BUY_STOP || type == ORDER_TYPE_SELL_STOP))
            deleteIt = true;
         if(actionType == 15 && (type == ORDER_TYPE_BUY_LIMIT || type == ORDER_TYPE_SELL_LIMIT))
            deleteIt = true;
         if(actionType == 16 && type == ORDER_TYPE_BUY_STOP_LIMIT)
            deleteIt = true;
         if(actionType == 17 && type == ORDER_TYPE_SELL_STOP_LIMIT)
            deleteIt = true;
         if(actionType == 19 && (type == ORDER_TYPE_BUY_STOP_LIMIT || type == ORDER_TYPE_SELL_STOP_LIMIT))
            deleteIt = true;

         if(deleteIt)
            QueueDeleteOrder(ticket);
        }

      // 2. ÓRDENES VIRTUALES
      int memTotal = TradeRAM.Total();
      for(int i = memTotal - 1; i >= 0; i--)
        {
         if(CheckPointer(TradeRAM.GetByIndex(i)) != POINTER_INVALID && TradeRAM.GetByIndex(i).isVirtual)
           {
            ulong vTicket = TradeRAM.GetByIndex(i).ticket;
            ENUM_ORDER_TYPE type = TradeRAM.GetByIndex(i).virtType;
            bool deleteIt = false;

            if(actionType == 18)
               deleteIt = true; // DELETE ALL
            if(actionType == 10 && type == ORDER_TYPE_BUY_STOP)
               deleteIt = true;
            if(actionType == 11 && type == ORDER_TYPE_BUY_LIMIT)
               deleteIt = true;
            if(actionType == 12 && type == ORDER_TYPE_SELL_STOP)
               deleteIt = true;
            if(actionType == 13 && type == ORDER_TYPE_SELL_LIMIT)
               deleteIt = true;
            if(actionType == 14 && (type == ORDER_TYPE_BUY_STOP || type == ORDER_TYPE_SELL_STOP))
               deleteIt = true;
            if(actionType == 15 && (type == ORDER_TYPE_BUY_LIMIT || type == ORDER_TYPE_SELL_LIMIT))
               deleteIt = true;
            if(actionType == 16 && type == ORDER_TYPE_BUY_STOP_LIMIT)
               deleteIt = true;
            if(actionType == 17 && type == ORDER_TYPE_SELL_STOP_LIMIT)
               deleteIt = true;
            if(actionType == 19 && (type == ORDER_TYPE_BUY_STOP_LIMIT || type == ORDER_TYPE_SELL_STOP_LIMIT))
               deleteIt = true;

            if(deleteIt)
              {
               TradeRAM.GetByIndex(i).isVirtual = false; // Muere
               DeleteVirtualOrderData(vTicket); // Borra identidad
              }
           }
        }
     }


//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
   UpdateOpenTradesVisuals(); // Aquí pasará la aspiradora
   UpdateToolData(true);
  }

//+------------------------------------------------------------------+
//| CREAR BOTÓN "GHOST" (Fondo Negro, Borde Neón, Texto Neón)        |
//+------------------------------------------------------------------+
bool              CreateGhostButton(CChartObjectButton &obj, string name, string text, int x, int y, int w, int h, color neonColor)
  {
   if(!obj.Create(m_chartId, name, 0, x, y, w, h))
      return false;

   obj.Description(text);
   obj.Font(FONT_FACE);             // Fuente Consolas
   obj.FontSize(FONT_SIZE_S);

// ESTILO GHOST
   obj.BackColor(COLOR_BTN_GHOST);  // Fondo Negro
   obj.Color(neonColor);            // Texto Color Neón

// Borde del mismo color que el texto
   obj.SetInteger(OBJPROP_BORDER_COLOR, neonColor);
   obj.SetInteger(OBJPROP_BORDER_TYPE, BORDER_FLAT); // Borde plano fino

   obj.Selectable(false);
   obj.Z_Order(110);
   return true;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              SyncRR(bool adjustTP, bool updatePanel = true)
  {
   if(!m_linesActive)
      return;

// 1. Obtener Ratio directo de la memoria RAM
   double valReward = PanelState.GetRR_Reward();
   double valRisk   = PanelState.GetRR_Risk();
   if(valRisk == 0)
      return;
   double ratio = valReward / valRisk;

   double entry = ObjectGetDouble(m_chartId, m_lineEntry, OBJPROP_PRICE);
   double sl    = ObjectGetDouble(m_chartId, m_lineSL, OBJPROP_PRICE);
   double tp    = ObjectGetDouble(m_chartId, m_lineTP, OBJPROP_PRICE);

   bool isBuy = (sl < entry);
   if(MathAbs(sl - entry) < SymbolInfoDouble(_Symbol, SYMBOL_POINT))
      isBuy = (tp > entry);

// 2. Cálculos y movimientos
   if(adjustTP)
     {
      double distRisk = MathAbs(entry - sl);
      double distReward = distRisk * ratio;
      double newTP = isBuy ? (entry + distReward) : (entry - distReward);
      ObjectSetDouble(m_chartId, m_lineTP, OBJPROP_PRICE, newTP);
     }
   else
     {
      double distReward = MathAbs(entry - tp);
      double distRisk = distReward / ratio;
      double newSL = isBuy ? (entry - distRisk) : (entry + distRisk);
      ObjectSetDouble(m_chartId, m_lineSL, OBJPROP_PRICE, newSL);
     }

   if(updatePanel)
     {
      UpdateInputsFromLines();
      ChartRedraw();
     }
  }

//+------------------------------------------------------------------+
//| AUXILIAR: Crear Línea de Orden (Estilo Cyberpunk)                |
//+------------------------------------------------------------------+
void              CreateOrderLine(string name, double price, color clr, ENUM_LINE_STYLE style)
  {
   if(ObjectFind(m_chartId, name) < 0)
     {
      ObjectCreate(m_chartId, name, OBJ_HLINE, 0, 0, price);
      ObjectSetInteger(m_chartId, name, OBJPROP_COLOR, clr);
      ObjectSetInteger(m_chartId, name, OBJPROP_STYLE, style);
      ObjectSetInteger(m_chartId, name, OBJPROP_WIDTH, 1);
      ObjectSetInteger(m_chartId, name, OBJPROP_SELECTABLE, false); // No seleccionable para no mover por error
      ObjectSetInteger(m_chartId, name, OBJPROP_HIDDEN, false);
     }
   else
     {
      // Solo actualizamos precio si ya existe
      ObjectSetDouble(m_chartId, name, OBJPROP_PRICE, price);
      ObjectSetInteger(m_chartId, name, OBJPROP_COLOR, clr); // Actualizar color por si cambia estado
     }
  }

