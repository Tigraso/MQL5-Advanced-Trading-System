      eng.AddButton(0, colRight - 2, wY, halfW + 2, btnH - 2, "Virtual: OFF", Theme.surface, Theme.border, Theme.accent, Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      wY += btnH + 4;
      eng.AddButton(0, colLeft, wY, halfW + 2, btnH - 2, "Time >", Theme.surface, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12, false, VICON_TIME);
