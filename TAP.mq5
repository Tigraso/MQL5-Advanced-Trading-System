// ====================================================================
// FUNCIONES BITWISE (Velocidad: 1 Ciclo de Reloj)
// ====================================================================
ulong             PackID(ulong ticket, int opcode)
  {
// Desplaza el ticket 12 bits a la izquierda y le pega el OpCode
   return (ticket << 12) | (opcode & 0xFFF);
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
ushort            GetOpCode(ulong id)
  {
// Extrae solo los últimos 12 bits
   return (ushort)(id & 0xFFF);
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
ulong             GetTicket(ulong id)
  {
// Devuelve el ticket a su lugar original
   return (id >> 12);
  }

