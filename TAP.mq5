string g_dataPath = "";

// ====================================================================
// MÓDULO I/O: PANEL PRINCIPAL (EA1)
// ====================================================================
SBinPanel         g_panelDisk[1]; // Array de 1 posición para volcado rápido


//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              LoadPanelFromBin()
  {
   string filePath = g_dataPath + "TM_Panel.bin";
   if(!FileIsExist(filePath))
      return;

   int file = FileOpen(filePath, FILE_READ|FILE_BIN);
   if(file != INVALID_HANDLE)
     {
      FileReadArray(file, g_panelDisk);
      FileClose(file);

      // 1. Restaurar Estados
      g_activeTab = g_panelDisk[0].activeTab;
      m_riskMode  = (ENUM_RISK_MODE)g_panelDisk[0].riskMode;
      m_distMode  = (ENUM_DIST_MODE)g_panelDisk[0].distMode;
      m_lotMode   = (ENUM_LOT_MODE)g_panelDisk[0].lotMode;
      m_tsMode    = (ENUM_TS_MODE)g_panelDisk[0].tsMode;

      // --- NUEVO: CARGAR SETTINGS GLOBALES ---
      g_currentTheme    = g_panelDisk[0].theme;
      g_autoScreenshot  = g_panelDisk[0].autoScreenshot;
      g_manageAllMagics = g_panelDisk[0].manageAllMagics;
      g_maxSpread       = g_panelDisk[0].maxSpread;
      ChartSetInteger(0, CHART_SHOW_TRADE_HISTORY, g_panelDisk[0].showTradeHistory);

      InitTheme();

      // 2. Restaurar Toggles
      m_linesActive      = g_panelDisk[0].linesActive;
      m_isMarketMode     = g_panelDisk[0].marketMode;
      m_isPriceMode      = g_panelDisk[0].priceMode;
      m_isRRActive       = g_panelDisk[0].rrActive;
      m_isVirtActive     = g_panelDisk[0].virtActive;
      m_isSplitActive    = g_panelDisk[0].splitActive;
      m_isHideActive     = g_panelDisk[0].hideActive;
      m_isManagerHidden  = g_panelDisk[0].managerHidden;
      m_isOCOActive      = g_panelDisk[0].ocoActive;
      m_isTSActive       = g_panelDisk[0].tsActive;
      m_isBEActive       = g_panelDisk[0].beActive;
      m_isBE_AutoOffset  = g_panelDisk[0].beAuto;
      m_manageAllSymbols = g_panelDisk[0].manageAllSymbols;
      m_isPreOpCollapsed = g_panelDisk[0].preOpCollapsed;

      // 3. Restaurar Inputs (A la memoria RAM encapsulada)
      PanelState.SetRisk(g_panelDisk[0].inpRisk);
      PanelState.SetLot(g_panelDisk[0].inpLot);
      PanelState.SetPrice(g_panelDisk[0].inpPrice);
      PanelState.SetTP(g_panelDisk[0].inpTP);
      PanelState.SetSL(g_panelDisk[0].inpSL);
      PanelState.SetRR_Reward(g_panelDisk[0].inpRR_Reward);
      PanelState.SetRR_Risk(g_panelDisk[0].inpRR_Risk);
      PanelState.SetComment(CharArrayToString(g_panelDisk[0].inpComment));

      // 4. Restaurar Template
      if(CheckPointer(TemplateState) != POINTER_INVALID)
        {
         ArrayCopy(TemplateState.ts.inputs,  g_panelDisk[0].tsInputs);
         ArrayCopy(TemplateState.ts.units,   g_panelDisk[0].tsUnits);
         ArrayCopy(TemplateState.ts.dropIdx, g_panelDisk[0].tsDropIdx);

         TemplateState.be.valStart   = g_panelDisk[0].beValStart;
         TemplateState.be.valOffset  = g_panelDisk[0].beValOffset;
         TemplateState.be.modeStart  = g_panelDisk[0].beModeStart;
         TemplateState.be.modeOffset = g_panelDisk[0].beModeOffset;

         TemplateState.grid.distMode = m_distMode;
         TemplateState.grid.lotMode  = m_lotMode;

         for(int i=0; i<5; i++)
           {
            TemplateState.grid.rows[i].isActiveTP  = g_panelDisk[0].gridRows[i].isActiveTP;
            TemplateState.grid.rows[i].isActiveSL  = g_panelDisk[0].gridRows[i].isActiveSL;
            TemplateState.grid.rows[i].valTP_Price = g_panelDisk[0].gridRows[i].valTP_Price;
            TemplateState.grid.rows[i].valTP_Vol   = g_panelDisk[0].gridRows[i].valTP_Vol;
            TemplateState.grid.rows[i].valSL_Price = g_panelDisk[0].gridRows[i].valSL_Price;
            TemplateState.grid.rows[i].valSL_Vol   = g_panelDisk[0].gridRows[i].valSL_Vol;
           }
        }

      // 5. Posiciones
      Engine.m_panelX = g_panelDisk[0].panelX;
      Engine.m_panelY = g_panelDisk[0].panelY;
      m_currentFixedX = g_panelDisk[0].currentFixedX;

      // 6. Regenerar las líneas si estaban activas
      if(m_linesActive)
        {
         CreateHLine(m_lineEntry, g_panelDisk[0].lineEntryPrice, clrGray, STYLE_DASHDOT);
         CreateHLine(m_lineSL,    g_panelDisk[0].lineSLPrice,    clrRed,  STYLE_DASHDOT);
         CreateHLine(m_lineTP,    g_panelDisk[0].lineTPPrice,    clrGreen,STYLE_DASHDOT);
        }

      CalculateLot();
      // --- INYECCIÓN: RECUPERAR HOTKEYS DEL PANEL A LA RAM ---
      g_hotkeyDisk[0] = g_panelDisk[0].hotkeys;
     }
  }
//+------------------------------------------------------------------+
//| INYECCIÓN QUIRÚRGICA DE PRESETS (Solo carga estrategia, no UI)   |
//+------------------------------------------------------------------+
void              LoadPresetSettings(string presetName)
  {
   string path = "TradeAssistantPro\\Presets\\" + presetName + ".bin";
   if(!FileIsExist(path))
      return;

   SBinPanel tempDisk[];
   int file = FileOpen(path, FILE_READ|FILE_BIN);
   if(file != INVALID_HANDLE)
     {
      FileReadArray(file, tempDisk);
      FileClose(file);

      // --- 1. MODOS Y TOGGLES (Estrategia) ---
      m_riskMode      = (ENUM_RISK_MODE)tempDisk[0].riskMode;
      m_distMode      = (ENUM_DIST_MODE)tempDisk[0].distMode;
      m_lotMode       = (ENUM_LOT_MODE)tempDisk[0].lotMode;
      m_tsMode        = (ENUM_TS_MODE)tempDisk[0].tsMode;

      m_isPriceMode   = tempDisk[0].priceMode;
      m_isRRActive    = tempDisk[0].rrActive;
      m_isSplitActive = tempDisk[0].splitActive;
      m_isHideActive  = tempDisk[0].hideActive;
      m_isOCOActive   = tempDisk[0].ocoActive;
      m_isTSActive    = tempDisk[0].tsActive;
      m_isBEActive    = tempDisk[0].beActive;
      m_isBE_AutoOffset = tempDisk[0].beAuto;

      // --- NUEVO: CARGAR SETTINGS DEL PRESET ---
      g_currentTheme    = tempDisk[0].theme;
      g_autoScreenshot  = tempDisk[0].autoScreenshot;
      g_manageAllMagics = tempDisk[0].manageAllMagics;
      g_maxSpread       = tempDisk[0].maxSpread;
      ChartSetInteger(0, CHART_SHOW_TRADE_HISTORY, tempDisk[0].showTradeHistory);

      // Actualizamos los colores de la paleta en la RAM instantáneamente
      InitTheme();

      // --- 2. INPUTS DE TRADING ---
      PanelState.SetRisk(tempDisk[0].inpRisk);
      PanelState.SetLot(tempDisk[0].inpLot);
      PanelState.SetTP(tempDisk[0].inpTP);
      PanelState.SetSL(tempDisk[0].inpSL);
      PanelState.SetRR_Reward(tempDisk[0].inpRR_Reward);
      PanelState.SetRR_Risk(tempDisk[0].inpRR_Risk);
      // ¡OMITIMOS inpPrice y los precios de las líneas para no desfasar el gráfico actual!

      // --- 3. PLANTILLA AVANZADA (GRID, TS, BE) ---
      if(CheckPointer(TemplateState) != POINTER_INVALID)
        {
         ArrayCopy(TemplateState.ts.inputs,  tempDisk[0].tsInputs);
         ArrayCopy(TemplateState.ts.units,   tempDisk[0].tsUnits);
         ArrayCopy(TemplateState.ts.dropIdx, tempDisk[0].tsDropIdx);

         TemplateState.be.valStart   = tempDisk[0].beValStart;
         TemplateState.be.valOffset  = tempDisk[0].beValOffset;
         TemplateState.be.modeStart  = tempDisk[0].beModeStart;
         TemplateState.be.modeOffset = tempDisk[0].beModeOffset;

         TemplateState.grid.distMode = tempDisk[0].distMode;
         TemplateState.grid.lotMode  = tempDisk[0].lotMode;

         for(int i=0; i<5; i++)
           {
            TemplateState.grid.rows[i].isActiveTP  = tempDisk[0].gridRows[i].isActiveTP;
            TemplateState.grid.rows[i].isActiveSL  = tempDisk[0].gridRows[i].isActiveSL;
            TemplateState.grid.rows[i].valTP_Price = tempDisk[0].gridRows[i].valTP_Price;
            TemplateState.grid.rows[i].valTP_Vol   = tempDisk[0].gridRows[i].valTP_Vol;
            TemplateState.grid.rows[i].valSL_Price = tempDisk[0].gridRows[i].valSL_Price;
            TemplateState.grid.rows[i].valSL_Vol   = tempDisk[0].gridRows[i].valSL_Vol;
           }
        }

      // --- INYECCIÓN: CARGAR HOTKEYS DEL PRESET SELECCIONADO ---
      g_hotkeyDisk[0] = tempDisk[0].hotkeys;

      // --- 4. RECALCULAR Y GUARDAR EN LA CUENTA ACTUAL ---
      CalculateLot();
      SavePanelToBin(); // Forzamos un volcado al disco local de la cuenta
     }
  }



