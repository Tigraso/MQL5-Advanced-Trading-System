//+------------------------------------------------------------------+
//| GESTOR DEL ESTADO DEL PANEL (ENCAPSULACIÓN Y SEGURIDAD)          |
//+------------------------------------------------------------------+
class CPanelStateManager
  {
private:
   // 🛡️ Variables Privadas: Nadie puede tocarlas directamente
   double            m_risk;
   double            m_lot;
   double            m_price;
   double            m_tp;
   double            m_sl;
   double            m_rrReward;
   double            m_rrRisk;
   string            m_comment;

public:
                     CPanelStateManager() { Init(); }

   void              Init()
     {
      m_risk     = 1.0;
      m_lot      = 0.10;
      m_price    = 0.0;
      m_tp       = 60.0;
      m_sl       = 60.0;
      m_rrReward = 2.0;
      m_rrRisk   = 1.0;
      m_comment  = "Comment";
     }

   // =========================================================
   // 🔒 SETTERS (Con Validación Matemática y Seguridad)
   // =========================================================
   void              SetLot(double val)
     {
      // Validamos que nunca sea negativo o cero
      if(val <= 0)
         val = 0.01;

      // Podríamos incluso cruzarlo con el Oráculo aquí mismo:
      // if(val < Market.volMin) val = Market.volMin;

      m_lot = val;
     }

   void              SetRisk(double val)      { if(val < 0) val = 0; m_risk = val; }
   void              SetPrice(double val)     { if(val < 0) val = 0; m_price = val; }
   void              SetTP(double val)        { if(val < 0) val = 0; m_tp = val; }
   void              SetSL(double val)        { if(val < 0) val = 0; m_sl = val; }
   void              SetRR_Reward(double val) { if(val <= 0) val = 1; m_rrReward = val; }
   void              SetRR_Risk(double val)   { if(val <= 0) val = 1; m_rrRisk = val; }

   void              SetComment(string text)
     {
      // Seguridad Anti-Rechazo de MT5 (Max 15 caracteres)
      if(StringLen(text) > 15)
         text = StringSubstr(text, 0, 15);
      if(text == "")
         text = "Auto";

      m_comment = text;
     }

   // =========================================================
   // 🔓 GETTERS (Para leer los valores de forma segura)
   // =========================================================
   double            GetLot()       { return m_lot; }
   double            GetRisk()      { return m_risk; }
   double            GetPrice()     { return m_price; }
   double            GetTP()        { return m_tp; }
   double            GetSL()        { return m_sl; }
   double            GetRR_Reward() { return m_rrReward; }
   double            GetRR_Risk()   { return m_rrRisk; }
   string            GetComment()   { return m_comment; }
  };

