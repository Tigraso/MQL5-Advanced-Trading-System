//+------------------------------------------------------------------+
//| DIBUJA LA BARRA DE HERRAMIENTAS (ESTILO TABS FLUSH - 30px)       |
//+------------------------------------------------------------------+
   void DrawMinimizedWidget(CUIEngine &eng, int w, int wY)
     {
      int btnCount = 6;
      int usableW = w - 2; // Protegemos 1px a la izq y 1px a la der para el borde global
      int btnW = usableW / btnCount; // 278 / 6 = 46px
      int btnH = 29;
      int currX = 0; // Arrancamos en el pixel 1 para no borrar el borde izquierdo

      // 1. ALARMAS (Campana)
      eng.AddButton(OP_BTN_ALARM, currX, wY, btnW, btnH, "", Theme.bg, Theme.surface, Theme.surface, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 12, false, VICON_BELL);
      currX += btnW;

      // 2. HIDE TP/SL (El Ojo)
      uint cHideBg  = m_isManagerHidden ? Theme.sell : Theme.bg;
      uint cHideTxt = m_isManagerHidden ? Theme.textMain : Theme.textDim;
      eng.AddButton(OP_TOG_MANAGER_UI, currX, wY, btnW, btnH, "", cHideBg, Theme.surface, cHideBg, cHideTxt, 0, TA_CENTER|TA_VCENTER, "Arial", 12, false, VICON_EYE);
      currX += btnW;

      // 3. NEWS FILTER (Periódico)
      eng.AddButton(OP_BTN_NEWS, currX, wY, btnW, btnH, "", Theme.bg, Theme.surface, Theme.surface, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 12, false, VICON_NEWS);
      currX += btnW;

      // 4. TIME TRADER (Reloj)
      eng.AddButton(OP_BTN_TIME, currX, wY, btnW, btnH, "", Theme.bg, Theme.surface, Theme.surface, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 12, false, VICON_TIME);
      currX += btnW;

      // 5. EQUITY PROTECT (Escudo)
      eng.AddButton(OP_BTN_SHIELD, currX, wY, btnW, btnH, "", Theme.bg, Theme.surface, Theme.surface, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 12, false, VICON_SHIELD);
      currX += btnW;

      // 6. LÍNEAS PRE-OP
      // El último botón toma el ancho exacto sobrante para tocar el límite sin borrar el borde
      int lastW = (w - 1) - currX;
      uint cLinesBg  = m_linesActive ? Theme.accent : Theme.bg;
      uint cLinesTxt = m_linesActive ? Theme.bg : Theme.textDim;
      eng.AddButton(OP_BTN_SHOWLINES, currX, wY, lastW, btnH, "", cLinesBg, Theme.surface, cLinesBg, cLinesTxt, 0, TA_CENTER|TA_VCENTER, "Arial", 12, false, VICON_LINES);
     }

//+------------------------------------------------------------------+
//| MOCKUP: PÁGINA 0 - EXECUTE TAB (Setup & Control Center)          |
//+------------------------------------------------------------------+
   void DrawMockup_ExecuteTab(CUIEngine &eng, int startX, int startY, int w, int dummyH)
     {
      // Ajustamos la altura para cortar el panel justo después de "Manage All"
      int h = 425;

      // 1. FONDO DEL PANEL
      eng.AddPanel(startX, startY, w, h, Theme.bg, Theme.border);

      // 2. HEADER FALSO
      eng.AddPanel(startX + 1, startY + 1, w - 2, 38, Theme.surface, 0);
      eng.AddButton(0, startX + 7, startY + 8, 65, 20, "EURUSD ▼", Theme.surface, Theme.border, Theme.inputBg, Theme.textMain, 0, TA_LEFT|TA_VCENTER, "Arial", 12);
      eng.AddButton(0, startX + 77, startY + 8, 20, 20, "", Theme.surface, Theme.border, Theme.border, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 14, false, VICON_CAMERA);
      eng.AddLabel("TAP", startX + 150, startY + 12, "Arial Black", 12, Theme.textDim, TA_CENTER|TA_TOP);
      eng.AddButton(0, startX + w - 75, startY + 8, 20, 20, "", Theme.surface, Theme.border, Theme.border, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 14, false, VICON_GEAR);
      eng.AddButton(0, startX + w - 50, startY + 8, 20, 20, "_", Theme.surface, Theme.border, Theme.border, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 14);
      eng.AddButton(0, startX + w - 25, startY + 8, 20, 20, "✕", Theme.surface, Theme.sell, Theme.sell, Theme.sell, 0, TA_CENTER|TA_VCENTER, "Arial", 14);

      // 3. TABS FALSOS
      int tY = startY + 40;
      int wTrade = (w * 22) / 100, wManage = (w * 25) / 100, wAuto = (w * 20) / 100;
      int wPort = w - wTrade - wManage - wAuto - 1;
      int xT = startX;

      eng.AddButton(0, xT, tY, wTrade, 30, "TRADE", Theme.bg, Theme.surface, Theme.surface, Theme.accent, 0, TA_CENTER|TA_VCENTER, "Arial", 12);
      xT += wTrade;
      eng.AddButton(0, xT, tY, wManage, 30, "MANAGE", Theme.bg, Theme.surface, Theme.surface, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 12);
      xT += wManage;
      eng.AddButton(0, xT, tY, wAuto, 30, "AUTO", Theme.bg, Theme.surface, Theme.surface, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 12);
      xT += wAuto;
      eng.AddButton(0, xT, tY, wPort, 30, "PORTFOLIO", Theme.bg, Theme.surface, Theme.surface, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 12);
      eng.AddPanel(startX + 1, tY + 29, w - 2, 1, Theme.border, 0);

      // 4. CONTENIDO
      int wY = tY + 40;
      int colLeft = startX + 15, usableW = w - 30, halfW = (usableW - 10) / 2, colRight = colLeft + halfW + 10;
      int lblW = 65, gap = 5, inpW = halfW - lblW - gap;

      // Bloque 1: Risk & Lot
      eng.AddButton(0, colLeft, wY, halfW, 22, "Risk (%) ▼", Theme.bg, Theme.surface, Theme.surface, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 12);
      eng.AddLabel("Lot Size:", colRight + (halfW / 2), wY + 3, "Arial", 12, Theme.textDim, TA_CENTER|TA_TOP);
      wY += 24;
      eng.AddButton(0, colLeft, wY, halfW, 24, "1.00", Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      eng.AddButton(0, colRight, wY, halfW, 24, "0.10", Theme.bg, Theme.border, Theme.accent, Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      wY += 32;
      eng.AddPanel(colLeft, wY, usableW, 1, Theme.border, 0);
      wY += 12;

      // Bloque 2: Price, PSL, RR, TP, SL, Comment
      // Simulación visual: Price Mode ON + Stop Limit ON
      eng.AddButton(0, colLeft, wY, lblW, 24, "Price: ON", Theme.accent, Theme.surface, Theme.surface, Theme.bg, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      eng.AddButton(0, colLeft + lblW + gap, wY, inpW, 24, "1.15000", Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      // Zona derecha modificada para el PSL
      int lblPslW = 22;
      int inpPslW = 55;
      int btnRRW  = halfW - lblPslW - inpPslW - (gap * 2);
      eng.AddLabel("PSL:", colRight-4, wY + 4, "Arial", 11, Theme.textDim, TA_LEFT|TA_TOP);
      eng.AddButton(0, colRight + lblPslW, wY, inpPslW, 24, "1.15200", Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      eng.AddButton(0, colRight + lblPslW + inpPslW + gap, wY, btnRRW, 24, "RR:ON", Theme.accent, Theme.border, Theme.accent, Theme.bg, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      wY += 30;

      eng.AddLabel("TP:", colLeft + (lblW / 2), wY + 4, "Arial", 12, Theme.textDim, TA_CENTER|TA_TOP);
      eng.AddButton(0, colLeft + lblW + gap, wY, inpW, 24, "30.0", Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      eng.AddLabel("TP:", colRight + (lblW / 2), wY + 4, "Arial", 12, Theme.textDim, TA_CENTER|TA_TOP);
