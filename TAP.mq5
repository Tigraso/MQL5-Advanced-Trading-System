      // ==============================================================
      // 16 STICKERS CIRCULARES, PUESTOS A FRANCOTIRADOR
      // ==============================================================
      int cY = tY + 40; // Base Y para la zona de Inputs

      DrawHelpSticker(eng, startX + 30, startY, "1");        // Target Asset
      DrawHelpSticker(eng, startX + 80, startY, "2");        // Quick Actions
      DrawHelpSticker(eng, startX + 25, tY - 5, "3");           // Navigation Tabs

      DrawHelpSticker(eng, colLeft + 10, cY, "4");               // Risk Mode
      DrawHelpSticker(eng, colRight + 10, cY, "5");              // Lot Size

      DrawHelpSticker(eng, colLeft - 13, cY + 70, "6");           // Price Mode
      DrawHelpSticker(eng, colRight + 12, cY + 70, "7");         // PSL Input
      DrawHelpSticker(eng, colRight + 115, cY + 70, "8");         // RR Mode

      DrawHelpSticker(eng, startX + 95, cY + 160, "9");         // Custom Comment

      DrawHelpSticker(eng, colLeft + 10, cY + 200, "10");        // Alarm
      DrawHelpSticker(eng, colRight + 10, cY + 200, "11");       // Hide
      DrawHelpSticker(eng, colLeft + 10, cY + 230, "12");        // News
      DrawHelpSticker(eng, colRight + 10, cY + 230, "13");       // Virtual
      DrawHelpSticker(eng, colLeft + 10, cY + 260, "14");        // Time
      DrawHelpSticker(eng, colRight + 10, cY + 260, "15");       // Protect

      DrawHelpSticker(eng, startX + 125, cY + 305, "16");        // Manage All
     }

//+------------------------------------------------------------------+
//| MOCKUP: PÁGINA 1 - BOTTOM ZONE (Execution & HUD)                 |
//+------------------------------------------------------------------+
   void DrawMockup_BottomZone(CUIEngine &eng, int startX, int startY, int w)
     {
      int h = 190; // Altura compacta solo para esta zona
      eng.AddPanel(startX, startY, w, h, Theme.bg, Theme.border);

      int bY = startY + 15;

      // 1. BARRA DE HERRAMIENTAS (Líneas ON)
      int btnMktW = 30, btnRevW = 45, gap = 6;
      int btnShowW = w - 20 - btnMktW - btnRevW - (gap * 2);
      int xShow = startX + 10, xRev = xShow + btnShowW + gap, xMkt = xRev + btnRevW + gap;

      eng.AddButton(0, xShow, bY, btnShowW, 28, " HIDE LINES", Theme.surface, Theme.border, Theme.accent, Theme.accent, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12, false, VICON_LINES);
      eng.AddButton(0, xRev, bY, btnRevW, 28, "REV", Theme.surface, Theme.border, Theme.accent, Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 10);

      // Simulamos el MODO MARKET ENCENDIDO
      eng.AddButton(0, xMkt, bY, btnMktW, 28, "M", Theme.accent, Theme.border, Theme.accent, Theme.bg, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      bY += 38;

      // 2. BOTÓN DE EJECUCIÓN GIGANTE (Dinámico)
      int fullW = w - 20;
      eng.AddButton(0, startX + 10, bY, fullW, 45, "BUY LIMIT | L: 0.50 | 1.15000", Theme.buy, Theme.buy, Theme.buy, ColorToARGB(clrWhite,255), 0, TA_CENTER|TA_VCENTER, "Arial Bold", 15);

      bY += 60;

      // 3. STATUS HUD INSTITUCIONAL
      eng.AddPanel(startX + 10, bY, w - 20, 1, Theme.border, 0);
      int yRow1 = bY + 7;
      int yRow2 = bY + 25;

      int cX[4] = { startX + 45, startX + 105, startX + 175, startX + 235 };

      // Fila 1: TS | BE | GRID | SPLIT (Simulando TS y GRID encendidos)
      eng.AddLabel("TS", cX[0], yRow1, "Arial Black", 13, Theme.accent, TA_CENTER|TA_TOP);
      eng.AddLabel("BE", cX[1], yRow1, "Arial Black", 13, Theme.textDim, TA_CENTER|TA_TOP);
      eng.AddLabel("GRID", cX[2], yRow1, "Arial Black", 13, Theme.accent, TA_CENTER|TA_TOP);
      eng.AddLabel("SPLIT", cX[3], yRow1, "Arial Black", 13, Theme.textDim, TA_CENTER|TA_TOP);
      eng.AddLabel("|", startX + 205, yRow1 - 1, "Arial", 12, Theme.border, TA_CENTER|TA_TOP);

      // Fila 2: HIDE | OCO | VIRT | PROT (Simulando VIRT y PROT encendidos)
      eng.AddLabel("HIDE", cX[0], yRow2, "Arial Black", 13, Theme.textDim, TA_CENTER|TA_TOP);
      eng.AddLabel("OCO", cX[1], yRow2, "Arial Black", 13, Theme.textDim, TA_CENTER|TA_TOP);
      eng.AddLabel("VIRT", cX[2], yRow2, "Arial Black", 13, Theme.accent, TA_CENTER|TA_TOP);
      eng.AddLabel("PROT", cX[3], yRow2, "Arial Black", 13, Theme.sell, TA_CENTER|TA_TOP); // Rojo para el Protect

      // ==============================================================
      // STICKERS AMARILLOS (Alineados a los elementos)
      // ==============================================================
      DrawHelpSticker(eng, xShow + (btnShowW/2) - 10, startY + 5, "1"); // Hide Lines
      DrawHelpSticker(eng, xRev + (btnRevW/2) - 10, startY + 5, "2");   // REV
      DrawHelpSticker(eng, xMkt + (btnMktW/2) - 10, startY + 5, "3");   // M

      DrawHelpSticker(eng, startX + (fullW/2), startY + 55, "4");        // Exec Button

      DrawHelpSticker(eng, startX + 15, yRow1, "5");                  // Top HUD
      DrawHelpSticker(eng, startX + 15, yRow2, "6");                  // Bottom HUD
     }

//+------------------------------------------------------------------+
//| MOCKUP: PÁGINA 2 - MANAGE TAB (Grid Trading)                     |
//+------------------------------------------------------------------+
   void DrawMockup_ManageTab(CUIEngine &eng, int startX, int startY, int w, int h)
     {
      // 1. FONDO DEL PANEL
      eng.AddPanel(startX, startY, w, h, Theme.bg, Theme.border);

      // 2. HEADER FALSO Y TABS FALSOS (Iluminando el 2do)
      eng.AddPanel(startX + 1, startY + 1, w - 2, 38, Theme.surface, 0);
      eng.AddButton(0, startX + 7, startY + 8, 65, 20, "EURUSD ▼", Theme.surface, Theme.border, Theme.inputBg, Theme.textMain, 0, TA_LEFT|TA_VCENTER, "Arial", 12);
      eng.AddButton(0, startX + 77, startY + 8, 20, 20, "", Theme.surface, Theme.border, Theme.border, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 14, false, VICON_CAMERA);
      eng.AddLabel("TAP", startX + 150, startY + 12, "Arial Black", 12, Theme.textDim, TA_CENTER|TA_TOP);
      eng.AddButton(0, startX + w - 75, startY + 8, 20, 20, "", Theme.surface, Theme.border, Theme.border, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 14, false, VICON_GEAR);
      eng.AddButton(0, startX + w - 50, startY + 8, 20, 20, "_", Theme.surface, Theme.border, Theme.border, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 14);
      eng.AddButton(0, startX + w - 25, startY + 8, 20, 20, "✕", Theme.surface, Theme.sell, Theme.sell, Theme.sell, 0, TA_CENTER|TA_VCENTER, "Arial", 14);

      int tY = startY + 40;
      int wTrade = (w * 22) / 100, wManage = (w * 25) / 100, wAuto = (w * 20) / 100;
      int wPort = w - wTrade - wManage - wAuto - 1;
      int xT = startX;

      eng.AddButton(0, xT, tY, wTrade, 30, "TRADE", Theme.bg, Theme.surface, Theme.surface, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 12);
      xT += wTrade;
      eng.AddButton(0, xT, tY, wManage, 30, "MANAGE", Theme.bg, Theme.surface, Theme.surface, Theme.accent, 0, TA_CENTER|TA_VCENTER, "Arial", 12);
      xT += wManage;
      eng.AddButton(0, xT, tY, wAuto, 30, "AUTO", Theme.bg, Theme.surface, Theme.surface, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 12);
      xT += wAuto;
      eng.AddButton(0, xT, tY, wPort, 30, "PORTFOLIO", Theme.bg, Theme.surface, Theme.surface, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 12);
      eng.AddPanel(startX + 1, tY + 29, w - 2, 1, Theme.border, 0);

      // 3. CONTENIDO: Grid y Controles
      int wY = tY + 40;
      int colLeft = startX + 15, usableW = w - 30, halfW = (usableW - 10) / 2, colRight = colLeft + halfW + 10;

      // Bloque 1: Modos
      eng.AddButton(0, colLeft, wY, halfW, 26, "Risk Ratio ▼", Theme.bg, Theme.surface, Theme.surface, Theme.textDim, Theme.border, TA_LEFT|TA_VCENTER, "Arial", 12);
      eng.AddButton(0, colRight, wY, halfW, 26, "% Total ▼", Theme.bg, Theme.surface, Theme.surface, Theme.textDim, Theme.border, TA_LEFT|TA_VCENTER, "Arial", 12);
      wY += 32;

      // Cabeceras de la tabla
      int btnW = 32, gap = 3, inpW = 41;
      eng.AddLabel("Dist", colLeft + btnW + gap + (inpW / 2), wY, "Arial", 12, Theme.textDim, TA_CENTER|TA_TOP);
      eng.AddLabel("%Lot", colLeft + btnW + gap + inpW + gap + (inpW / 2), wY, "Arial", 12, Theme.textDim, TA_CENTER|TA_TOP);
      eng.AddLabel("Dist", colRight + btnW + gap + (inpW / 2), wY, "Arial", 12, Theme.textDim, TA_CENTER|TA_TOP);
      eng.AddLabel("%Lot", colRight + btnW + gap + inpW + gap + (inpW / 2), wY, "Arial", 12, Theme.textDim, TA_CENTER|TA_TOP);
      wY += 16;

      // Bloque 2: Las 5 filas del Grid (Simulando TP1 y SL1 activos)
      string defTP[5] = {"1.00", "2.00", "3.00", "4.00", "5.00"};
      string defSL[5] = {"0.50", "1.00", "1.50", "2.00", "2.50"};
      string pct[5]   = {"50", "25", "10", "10", "5"};

      for(int i=0; i<5; i++)
        {
         int rowY = wY + (i * 28);
         string id = IntegerToString(i+1);

         // TP Simulados
         bool isTP = (i == 0); // Solo el TP1 activo para el mockup
         uint cTP  = isTP ? Theme.buy : Theme.surface;
         eng.AddButton(0, colLeft, rowY, btnW, 24, "TP"+id, cTP, Theme.border, cTP, isTP?ColorToARGB(C'0,0,0',255):Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
         eng.AddButton(0, colLeft + btnW + gap, rowY, inpW, 24, defTP[i], Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, isTP ? cTP : Theme.border, TA_CENTER|TA_VCENTER, "Arial", 10);
         eng.AddButton(0, colLeft + btnW + gap + inpW + gap, rowY, inpW, 24, pct[i], Theme.inputBg, Theme.border, Theme.accent, Theme.textDim, isTP ? cTP : Theme.border, TA_CENTER|TA_VCENTER, "Arial", 10);

         // SL Simulados
         bool isSL = (i == 0); // Solo el SL1 activo para el mockup
         uint cSL  = isSL ? Theme.sell : Theme.surface;
         eng.AddButton(0, colRight, rowY, btnW, 24, "SL"+id, cSL, Theme.border, cSL, isSL?ColorToARGB(C'0,0,0',255):Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
         eng.AddButton(0, colRight + btnW + gap, rowY, inpW, 24, defSL[i], Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, isSL ? cSL : Theme.border, TA_CENTER|TA_VCENTER, "Arial", 10);
         eng.AddButton(0, colRight + btnW + gap + inpW + gap, rowY, inpW, 24, pct[i], Theme.inputBg, Theme.border, Theme.accent, Theme.textDim, isSL ? cSL : Theme.border, TA_CENTER|TA_VCENTER, "Arial", 10);
        }
      wY += (5 * 28) + 8;

      // Bloque 3: Toggles (Split, Hide, OCO)
      eng.AddButton(0, colLeft, wY, usableW, 26, "TRADE SPLITTING: ON", Theme.accent, Theme.border, Theme.accent, Theme.bg, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      wY += 32;

      eng.AddButton(0, colLeft, wY, halfW, 26, "HIDE TP/SL: OFF", Theme.surface, Theme.border, Theme.sell, Theme.sell, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      eng.AddButton(0, colRight, wY, halfW, 26, "OCO ORDER: ON", Theme.accent, Theme.border, Theme.accent, Theme.bg, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      // Bloque 4: Botones Apply To (Apilados justo debajo)
      wY += 45; // Damos un respiro después de los botones Hide y OCO
      int applyY = wY;
      eng.AddPanel(colLeft, applyY - 7, usableW, 1, Theme.border, 0);
      eng.AddButton(0, colLeft, applyY, usableW - 66, 22, "This Symbol ▼", Theme.bg, Theme.surface, Theme.surface, Theme.textMain, Theme.border, TA_LEFT|TA_VCENTER, "Arial", 11);
      eng.AddButton(0, colLeft + usableW - 60, applyY, 60, 22, "APPLY", Theme.surface, Theme.border, Theme.accent, Theme.accent, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      // ==============================================================
      // STICKERS DE AYUDA (Mismas coordenadas X, adaptamos las Y relativas)
      // ==============================================================
      int stY = tY + 40;
      DrawHelpSticker(eng, colLeft + (halfW/2) - 10, stY-7, "1");        // Dist Mode
      DrawHelpSticker(eng, colRight + (halfW/2) - 10, stY-1, "2");       // Lot Mode

      int gY = stY + 64; // Tercera fila del grid
      DrawHelpSticker(eng, colLeft +5, gY-27, "3");                      // TP Btn
      DrawHelpSticker(eng, colLeft + btnW + gap + 10, gY-27, "4");        // TP Dist Inp
      DrawHelpSticker(eng, colLeft + btnW + gap + inpW + gap + 10, gY-27, "5"); // TP Lot Inp

      DrawHelpSticker(eng, colRight + 5, gY-27, "6");                     // SL Btn
      DrawHelpSticker(eng, colRight + btnW + gap + 10, gY-27, "7");       // SL Dist Inp
      DrawHelpSticker(eng, colRight + btnW + gap + inpW + gap + 10, gY-27, "8"); // SL Lot Inp

      DrawHelpSticker(eng, startX + (w/2) - 10, gY + 118, "9");         // Trade Splitting

      DrawHelpSticker(eng, colLeft + (halfW/2) - 10, gY + 152, "10");  // Hide TP/SL
      DrawHelpSticker(eng, colRight + (halfW/2) - 10, gY + 153, "11"); // OCO Order

      DrawHelpSticker(eng, startX + (w/2) - 10, applyY+3, "12");         // Apply To Button

      // MAGIA: Pintamos un panel del color del fondo para tapar la parte de abajo que sobra
      // y dar la ilusión de que el panel se recorta perfectamente.
      int finalH = applyY + 40;
      eng.AddPanel(startX, finalH, w, h - finalH + 1, Theme.bg, Theme.bg);
      eng.AddPanel(startX, finalH, w, 1, Theme.border, 0); // Borde inferior limpio
     }

//+------------------------------------------------------------------+
//| MOCKUP: PÁGINA 3 - AUTO TAB (Trailing Stop & Break Even)         |
//+------------------------------------------------------------------+
   void DrawMockup_AutoTab(CUIEngine &eng, int startX, int startY, int w, int h)
     {
      // 1. FONDO DEL PANEL
      eng.AddPanel(startX, startY, w, h, Theme.bg, Theme.border);

      // 2. HEADER FALSO Y TABS FALSOS (Iluminando el 3ro: AUTO)
      eng.AddPanel(startX + 1, startY + 1, w - 2, 38, Theme.surface, 0);
      eng.AddButton(0, startX + 7, startY + 8, 65, 20, "EURUSD ▼", Theme.surface, Theme.border, Theme.inputBg, Theme.textMain, 0, TA_LEFT|TA_VCENTER, "Arial", 12);
      eng.AddButton(0, startX + 77, startY + 8, 20, 20, "", Theme.surface, Theme.border, Theme.border, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 14, false, VICON_CAMERA);
      eng.AddLabel("TAP", startX + 150, startY + 12, "Arial Black", 12, Theme.textDim, TA_CENTER|TA_TOP);
      eng.AddButton(0, startX + w - 75, startY + 8, 20, 20, "", Theme.surface, Theme.border, Theme.border, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 14, false, VICON_GEAR);
      eng.AddButton(0, startX + w - 50, startY + 8, 20, 20, "_", Theme.surface, Theme.border, Theme.border, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 14);
      eng.AddButton(0, startX + w - 25, startY + 8, 20, 20, "✕", Theme.surface, Theme.sell, Theme.sell, Theme.sell, 0, TA_CENTER|TA_VCENTER, "Arial", 14);

      int tY = startY + 40;
      int wTrade = (w * 22) / 100, wManage = (w * 25) / 100, wAuto = (w * 20) / 100;
      int wPort = w - wTrade - wManage - wAuto - 1;
      int xT = startX;

      eng.AddButton(0, xT, tY, wTrade, 30, "TRADE", Theme.bg, Theme.surface, Theme.surface, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 12);
      xT += wTrade;
      eng.AddButton(0, xT, tY, wManage, 30, "MANAGE", Theme.bg, Theme.surface, Theme.surface, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 12);
      xT += wManage;
      eng.AddButton(0, xT, tY, wAuto, 30, "AUTO", Theme.bg, Theme.surface, Theme.surface, Theme.accent, 0, TA_CENTER|TA_VCENTER, "Arial", 12);
      xT += wAuto;
      eng.AddButton(0, xT, tY, wPort, 30, "PORTFOLIO", Theme.bg, Theme.surface, Theme.surface, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 12);
      eng.AddPanel(startX + 1, tY + 29, w - 2, 1, Theme.border, 0);

      // 3. CONTENIDO: Trailing Stop (Modo MA)
      int wY = tY + 40;
      int colLeft = startX + 15, usableW = w - 30, halfW = (usableW - 10) / 2, rightEdge = colLeft + usableW;

      // TS Master Toggle & Dropdown (Modo Mov Avg)
      eng.AddButton(0, colLeft, wY, halfW, 24, "TRAILING STOP: ON", Theme.accent, Theme.border, Theme.accent, Theme.bg, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      eng.AddButton(0, colLeft + halfW + 10, wY, halfW, 24, "Mov Avg ▼", Theme.bg, Theme.surface, Theme.surface, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      wY += 30;

      // 6 Filas del Modo Moving Average
      string maLbls[6] = {"Start:", "Timeframe:", "Period:", "Method:", "Apply:", "Indent:"};
      string maVals[6] = {"20", "M15 ▼", "50.00", "SMA ▼", "Close ▼", "0"};
      bool   isDrop[6] = {false, true, false, true, true, false};

      int rowH = 20, gap = 2;
      for(int i=0; i<6; i++)
        {
         int rY = wY + (i * (rowH + gap));
         eng.AddLabel(maLbls[i], colLeft, rY+3, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);

         if(isDrop[i])
           {
            eng.AddButton(0, rightEdge - 115, rY, 115, rowH, maVals[i], Theme.surface, Theme.border, Theme.surface, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
           }
         else
           {
            int inpX = rightEdge - 115, inpW = (i==2) ? 115 : 50;
            eng.AddButton(0, inpX, rY, inpW, rowH, maVals[i], Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
            if(i==0 || i==5) // Tienen selector de unidad (Pips)
               eng.AddButton(0, rightEdge - 60, rY, 60, rowH, "Pips ▼", Theme.surface, Theme.border, Theme.accent, Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
           }
        }
      wY += (6 * 22) + 6;

      // 4. CONTENIDO: Break Even (Modo Auto)
      eng.AddPanel(colLeft, wY, usableW, 1, Theme.border, 0);
      wY += 12;

      eng.AddButton(0, colLeft, wY, usableW, 24, "BREAK EVEN: ON", Theme.accent, Theme.border, Theme.accent, Theme.bg, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      wY += 28;

      int beInpX = rightEdge - 115;
      eng.AddLabel("Trigger:", colLeft, wY+3, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      eng.AddButton(0, beInpX, wY, 50, 20, "15", Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      eng.AddButton(0, rightEdge - 60, wY, 60, 20, "Pips ▼", Theme.surface, Theme.border, Theme.accent, Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      wY += 22;

      eng.AddLabel("Offset:", colLeft, wY+3, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      eng.AddButton(0, beInpX, wY, 50, 20, "AUTO", Theme.bg, Theme.border, Theme.accent, Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12); // Apagado visualmente
      eng.AddButton(0, rightEdge - 60, wY, 60, 20, "Pips ▼", Theme.surface, Theme.border, Theme.accent, Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      wY += 22;

      eng.AddButton(0, rightEdge - 115, wY, 115, 20, "AUTO OFFSET: ON", Theme.accent, Theme.border, Theme.accent, Theme.bg, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      wY += 35;

      // 5. Botones Apply To
      int applyY = wY;
      eng.AddPanel(colLeft, applyY - 7, usableW, 1, Theme.border, 0);
      eng.AddButton(0, colLeft, applyY, usableW - 66, 22, "This Symbol ▼", Theme.bg, Theme.surface, Theme.surface, Theme.textMain, Theme.border, TA_LEFT|TA_VCENTER, "Arial", 11);
      eng.AddButton(0, colLeft + usableW - 60, applyY, 60, 22, "APPLY", Theme.surface, Theme.border, Theme.accent, Theme.accent, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      // Cortamos el panel
      int finalH = applyY + 40;
      eng.AddPanel(startX, finalH, w, h - finalH + 1, Theme.bg, Theme.bg);
      eng.AddPanel(startX, finalH, w, 1, Theme.border, 0);

      // ==============================================================
      // STICKERS DE AYUDA (Estratégicamente posicionados)
      // ==============================================================
      int stY = tY + 40;
      DrawHelpSticker(eng, colLeft + (halfW/2) - 10, stY-10, "1");        // TS Master Toggle
      DrawHelpSticker(eng, rightEdge - (halfW/2) - 10, stY-10, "2");      // TS Mode Dropdown

      int row1Y = stY + 30; // Fila Start
      DrawHelpSticker(eng, colLeft +60, row1Y + 30, "3");              // TS Parameters block

      int beY = stY + 180;
      DrawHelpSticker(eng, colLeft + (usableW/2) - 10, beY-10, "4");      // BE Master Toggle
      DrawHelpSticker(eng, colLeft + 60, beY + 35, "5");                // BE Trigger

      DrawHelpSticker(eng, rightEdge - 126, beY + 72, "6");             // BE Auto Offset

      DrawHelpSticker(eng, startX + (w/2) - 10, applyY, "7");          // Apply To Button
     }

//+------------------------------------------------------------------+
//| MOCKUP: PÁGINA 4 - PORTFOLIO TAB (Global Management)             |
//+------------------------------------------------------------------+
   void DrawMockup_PortfolioTab(CUIEngine &eng, int startX, int startY, int w, int h)
     {
      // 1. FONDO DEL PANEL
      eng.AddPanel(startX, startY, w, h, Theme.bg, Theme.border);

      // 2. HEADER FALSO Y TABS FALSOS (Iluminando el 4to: PORTFOLIO)
      eng.AddPanel(startX + 1, startY + 1, w - 2, 38, Theme.surface, 0);
      eng.AddButton(0, startX + 7, startY + 8, 65, 20, "EURUSD ▼", Theme.surface, Theme.border, Theme.inputBg, Theme.textMain, 0, TA_LEFT|TA_VCENTER, "Arial", 12);
      eng.AddButton(0, startX + 77, startY + 8, 20, 20, "", Theme.surface, Theme.border, Theme.border, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 14, false, VICON_CAMERA);
      eng.AddLabel("TAP", startX + 150, startY + 12, "Arial Black", 12, Theme.textDim, TA_CENTER|TA_TOP);
      eng.AddButton(0, startX + w - 75, startY + 8, 20, 20, "", Theme.surface, Theme.border, Theme.border, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 14, false, VICON_GEAR);
      eng.AddButton(0, startX + w - 50, startY + 8, 20, 20, "_", Theme.surface, Theme.border, Theme.border, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 14);
      eng.AddButton(0, startX + w - 25, startY + 8, 20, 20, "✕", Theme.surface, Theme.sell, Theme.sell, Theme.sell, 0, TA_CENTER|TA_VCENTER, "Arial", 14);

      int tY = startY + 40;
      int wTrade = (w * 22) / 100, wManage = (w * 25) / 100, wAuto = (w * 20) / 100;
      int wPort = w - wTrade - wManage - wAuto - 1;
      int xT = startX;

      eng.AddButton(0, xT, tY, wTrade, 30, "TRADE", Theme.bg, Theme.surface, Theme.surface, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 12);
      xT += wTrade;
      eng.AddButton(0, xT, tY, wManage, 30, "MANAGE", Theme.bg, Theme.surface, Theme.surface, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 12);
      xT += wManage;
      eng.AddButton(0, xT, tY, wAuto, 30, "AUTO", Theme.bg, Theme.surface, Theme.surface, Theme.textDim, 0, TA_CENTER|TA_VCENTER, "Arial", 12);
      xT += wAuto;
      eng.AddButton(0, xT, tY, wPort, 30, "PORTFOLIO", Theme.bg, Theme.surface, Theme.surface, Theme.accent, 0, TA_CENTER|TA_VCENTER, "Arial", 12);
      eng.AddPanel(startX + 1, tY + 29, w - 2, 1, Theme.border, 0);

      // 3. CONTENIDO: PORTFOLIO
      int wY = tY + 40;
      string cur = "USD";

      eng.AddLabel("Balance:", startX + 15, wY, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      eng.AddLabel("10500.00 " + cur, startX + w - 15, wY, "Arial", 14, Theme.textMain, TA_RIGHT|TA_TOP);
      wY += 22;

      uint mutedRed = ColorToARGB(C'140,40,45', 255);
      eng.AddLabel("Floating P/L:", startX + 15, wY, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      eng.AddLabel("+150.50 " + cur, startX + w - 15, wY, "Arial", 14, Theme.buy, TA_RIGHT|TA_TOP);
      wY += 26;

      eng.AddButton(0, startX + 15, wY, w-30, 24, "More Info (Account, Stats) >", Theme.bg, Theme.surface, Theme.surface, Theme.accent, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      wY += 32;

      int cardW = (w - 40) / 2, cardH = 72, col1 = startX + 15, col2 = startX + 15 + cardW + 10;

      // BUY & SELL CARDS
      eng.AddPanel(col1, wY, cardW, cardH, Theme.surface, Theme.border);
      eng.AddLabel("BUY (2)", col1+10, wY+8, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      eng.AddLabel("+200.00", col1+10, wY+22, "Arial", 14, Theme.buy, TA_LEFT|TA_TOP);
      eng.AddButton(0, col1+10, wY+42, cardW-20, 22, "CLOSE BUYS", Theme.bg, Theme.border, Theme.accent, Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      eng.AddPanel(col2, wY, cardW, cardH, Theme.surface, Theme.border);
      eng.AddLabel("SELL (1)", col2+10, wY+8, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      eng.AddLabel("-49.50", col2+10, wY+22, "Arial", 14, Theme.sell, TA_LEFT|TA_TOP);
      eng.AddButton(0, col2+10, wY+42, cardW-20, 22, "CLOSE SELLS", Theme.bg, Theme.border, Theme.accent, Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      wY += cardH + 8;

      // WINNERS & LOSERS CARDS
      eng.AddPanel(col1, wY, cardW, cardH, Theme.surface, Theme.border);
      eng.AddLabel("WINNERS (2)", col1+10, wY+8, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      eng.AddLabel("+200.00", col1+10, wY+22, "Arial", 14, Theme.buy, TA_LEFT|TA_TOP);
      eng.AddButton(0, col1+10, wY+42, cardW-20, 22, "CLOSE WINNERS", Theme.bg, Theme.border, Theme.accent, Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      eng.AddPanel(col2, wY, cardW, cardH, Theme.surface, Theme.border);
      eng.AddLabel("LOSERS (1)", col2+10, wY+8, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
      eng.AddLabel("-49.50", col2+10, wY+22, "Arial", 14, Theme.sell, TA_LEFT|TA_TOP);
      eng.AddButton(0, col2+10, wY+42, cardW-20, 22, "CLOSE LOSERS", Theme.bg, Theme.border, Theme.accent, Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      wY += cardH + 12;

      // CLOSE ALL POSITIONS
      eng.AddButton(0, startX + 15, wY, w-30, 26, "CLOSE ALL OPEN POSITIONS", mutedRed, Theme.border, Theme.sell, Theme.textMain, mutedRed, TA_CENTER|TA_VCENTER, "Arial", 13);
      wY += 34;
      eng.AddPanel(startX + 15, wY, w-30, 1, Theme.border, 0);
      wY += 8;

      // 4. BLOQUE PENDING ORDERS
      int pBtnW = (w - 40) / 2, pBtnH = 22, pGap = 25;
      eng.AddButton(0, startX + 15, wY, pBtnW, pBtnH, "Buy Stops (1)", Theme.bg, Theme.surface, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      eng.AddButton(0, startX + 25 + pBtnW, wY, pBtnW, pBtnH, "Sell Stops (0)", Theme.bg, Theme.surface, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      wY += pGap;
      eng.AddButton(0, startX + 15, wY, pBtnW, pBtnH, "Buy Limits (0)", Theme.bg, Theme.surface, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      eng.AddButton(0, startX + 25 + pBtnW, wY, pBtnW, pBtnH, "Sell Limits (2)", Theme.bg, Theme.surface, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      wY += pGap;
      eng.AddButton(0, startX + 15, wY, pBtnW, pBtnH, "Buy StpLims (0)", Theme.bg, Theme.surface, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      eng.AddButton(0, startX + 25 + pBtnW, wY, pBtnW, pBtnH, "Sell StpLims (0)", Theme.bg, Theme.surface, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      wY += pGap;

      // 3 BOTONES COMPACTOS DE DELETE
      int pBtnW3 = (w - 45) / 3;
      eng.AddButton(0, startX + 15, wY, pBtnW3, pBtnH, "Del Stops", Theme.surface, Theme.border, Theme.accent, Theme.accent, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      eng.AddButton(0, startX + 15+pBtnW3+7, wY, pBtnW3, pBtnH, "Del Limits", Theme.surface, Theme.border, Theme.accent, Theme.accent, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      eng.AddButton(0, startX + 15+(pBtnW3*2)+14, wY, pBtnW3, pBtnH, "Del S-Lims", Theme.surface, Theme.border, Theme.accent, Theme.accent, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
      wY += pGap + 4;

      eng.AddButton(0, startX + 15, wY, w-30, 26, "DELETE ALL PENDING", Theme.surface, Theme.border, Theme.sell, mutedRed, mutedRed, TA_CENTER|TA_VCENTER, "Arial", 13);
      wY += 34;
      eng.AddPanel(startX + 15, wY, w-30, 1, Theme.border, 0);
      wY += 6;

      // 5. TOGGLES GLOBALES (ALL SYMBOLS & ALL IDS)
      eng.AddButton(0, startX + 15, wY, pBtnW, 24, "All Symbols", Theme.accent, Theme.border, Theme.accent, Theme.bg, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      eng.AddButton(0, startX + 25+pBtnW, wY, pBtnW, 24, "All IDs", Theme.surface, Theme.border, Theme.accent, Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      // ==============================================================
      // STICKERS DE AYUDA
      // ==============================================================
      int r1Y = tY + 40;
      DrawHelpSticker(eng, startX + (w/2) - 10, r1Y + 30, "1");        // More Info

      int cY = r1Y + 115;
      DrawHelpSticker(eng, col1 + cardW-5, cY, "2");            // Close Groups

      int cAllY = cY + cardH + 12;
      DrawHelpSticker(eng, startX + (w/2) - 10, cAllY+30, "3");           // Close All Op

      int pY = cAllY + 60;
      DrawHelpSticker(eng, col1 + cardW-5, pY+30, "4");            // Delete Groups

      int dAllY = pY + 75;
      DrawHelpSticker(eng, startX + (w/2) - 10, dAllY+40, "5");           // Del All Pending

      DrawHelpSticker(eng, col1 + (pBtnW/2) - 10, dAllY + 80, "6");    // All Syms Toggle
      DrawHelpSticker(eng, col2 + (pBtnW/2) - 10, dAllY + 80, "7");    // All IDs Toggle
     }

//+------------------------------------------------------------------+
//| MOCKUP: PÁGINA 5 - ADVANCED TERMINAL                             |
//+------------------------------------------------------------------+
   void DrawMockup_AdvancedTerminal(CUIEngine &eng, int x, int y, int w, int h)
     {
      int modH = 500;
      eng.AddPanel(x, y, w, modH, Theme.bg, Theme.border);

      // HEADER
      eng.AddPanel(x, y, w, 40, Theme.surface, Theme.border);
      eng.AddLabel("ADVANCED PORTFOLIO TERMINAL", x + 15, y + 12, "Arial", 13, Theme.accent, TA_LEFT|TA_TOP);
      eng.AddButton(0, x + w - 40, y + 5, 30, 30, "X", Theme.surface, Theme.sell, Theme.sell, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 14);

      // TABS
      int tabW = (w - 30) / 3;
      eng.AddButton(0, x + 15, y + 50, tabW, 30, "ACCOUNT", Theme.surface, Theme.border, Theme.surface, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      eng.AddButton(0, x + 15 + tabW, y + 50, tabW, 30, "STATISTICS", Theme.accent, Theme.border, Theme.accent, Theme.bg, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      eng.AddButton(0, x + 15 + tabW*2, y + 50, tabW, 30, "SYMBOL", Theme.surface, Theme.border, Theme.surface, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      // FAKE CHART
      int chY = y + 90;
      eng.AddPanel(x + 15, chY, w - 30, 180, Theme.inputBg, Theme.border);
      eng.AddLabel("PERFORMANCE CURVE", x + 25, chY + 5, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);

      // Fake Curve Lines (Simulando un gráfico verde)
      uint lineCol = Theme.buy;
      int lX = x + 25;
      eng.AddLine(lX, chY+150, lX+40, chY+120, lineCol);
      eng.AddLine(lX+40, chY+120, lX+80, chY+140, lineCol);
      eng.AddLine(lX+80, chY+140, lX+160, chY+80, lineCol);
      eng.AddLine(lX+160, chY+80, lX+220, chY+100, lineCol);
      eng.AddLine(lX+220, chY+100, lX+350, chY+30, lineCol);
      eng.AddPanel(lX+347, chY+27, 6, 6, Theme.bg, lineCol, true);

      // FILTER & TITLE
      int infoY = chY + 200;
      eng.AddPanel(x + 15, infoY, w - 30, 1, Theme.border, 0);
      eng.AddLabel("TRADING STATISTICS", x + 15, infoY + 10, "Arial", 13, Theme.accent, TA_LEFT|TA_TOP);
      eng.AddButton(0, x + w - 175, infoY + 8, 160, 24, "DATA: ALL SYMBOLS ▼", Theme.surface, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      // FAKE DATA MATRIX
      int dY = infoY + 40;
      int rH = 26;
      int cW = ((w - 30) / 2) - 5;
      int c1 = x + 15, c2 = x + 15 + (w - 30) / 2 + 10;

      string lbls[6] = {"Total Net Profit", "Profit Factor", "Total Trades", "Short (won %)", "Long (won %)", "Win Rate %"};
      string vals[6] = {"+1,250.00", "2.14", "145", "65.0%", "72.5%", "68.2%"};
      uint vCols[6] = {Theme.buy, Theme.textMain, Theme.textMain, Theme.textMain, Theme.textMain, Theme.buy};

      for(int i=0; i<3; i++)
        {
         int rowY = dY + (i * (rH + 2));
         uint rBg = (i % 2 == 0) ? Theme.bg : Theme.surface;
         // Col 1
         eng.AddPanel(c1, rowY, cW, rH, rBg, 0);
         eng.AddLabel(lbls[i], c1 + 5, rowY + 4, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
         eng.AddLabel(vals[i], c1 + cW - 5, rowY + 4, "Arial", 13, vCols[i], TA_RIGHT|TA_TOP);
         // Col 2
         eng.AddPanel(c2, rowY, cW, rH, rBg, 0);
         eng.AddLabel(lbls[i+3], c2 + 5, rowY + 4, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
         eng.AddLabel(vals[i+3], c2 + cW - 5, rowY + 4, "Arial", 13, vCols[i+3], TA_RIGHT|TA_TOP);
        }

      // STICKERS
      DrawHelpSticker(eng, x + 15 + tabW + (tabW/2) - 10, y + 42, "1"); // Tabs
      DrawHelpSticker(eng, x + (w/2) - 10, chY + 50, "2"); // Chart
      DrawHelpSticker(eng, x + w - 90, infoY - 2, "3"); // Dropdown Filter
      DrawHelpSticker(eng, x + (w/2) - 10, dY + 30, "4"); // Data Matrix
     }

//+------------------------------------------------------------------+
//| MOCKUP: PÁGINA 6 - TIME TRADER                                   |
//+------------------------------------------------------------------+
   void DrawMockup_TimeTrader(CUIEngine &eng, int x, int y, int w)
     {
      int modH = 350;
      eng.AddPanel(x, y, w, modH, Theme.bg, Theme.border);

      eng.AddPanel(x, y, w, 35, Theme.surface, Theme.border);
      eng.AddLabel("TIME TRADER SCHEDULER", x + 15, y + 8, "Arial", 13, Theme.accent, TA_LEFT|TA_TOP);
      eng.AddButton(0, x + w - 35, y + 5, 25, 25, "X", Theme.surface, Theme.sell, Theme.sell, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 13);

      int c1X = x + 20, c2X = x + 195;
      int startY = y + 60;

      // ACTION & ADD
      eng.AddButton(0, c1X, startY, 160, 26, "CLOSE ALL ▼", Theme.surface, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      eng.AddButton(0, c1X, startY + 36, 160, 28, "+ ADD TASK", Theme.accent, Theme.accent, Theme.accent, Theme.bg, 0, TA_CENTER|TA_VCENTER, "Arial", 12);

      // CLOCK & INPUTS
      eng.AddButton(0, c2X, y + 40, 105, 18, "2025-10-24", Theme.bg, Theme.surface, Theme.bg, ColorToARGB(C'0,240,240',255), Theme.bg, TA_CENTER|TA_VCENTER, "Arial", 12);
      eng.AddButton(0, c2X + 110, y + 40, 90, 18, "14:30:00", Theme.bg, Theme.surface, Theme.bg, ColorToARGB(C'0,240,240',255), Theme.bg, TA_CENTER|TA_VCENTER, "Arial", 12);

      eng.AddButton(0, c2X, startY, 105, 26, "2025-10-25", Theme.inputBg, Theme.surface, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      eng.AddButton(0, c2X + 110, startY, 90, 26, "09:00:00", Theme.inputBg, Theme.surface, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      eng.AddButton(0, c2X + 205, startY, 70, 26, "Ticket #", Theme.surface, Theme.surface, Theme.accent, Theme.textDim, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      // DAYS
      int dY = startY + 36;
      string days[7] = {"Mon","Tue","Wed","Thu","Fri","Sat","Sun"};
      for(int i=0; i<7; i++)
        {
         uint dBg = (i < 5) ? Theme.accent : Theme.surface;
         uint dTxt = (i < 5) ? Theme.bg : Theme.textDim;
         eng.AddButton(0, c2X + (i*39), dY, 36, 28, days[i], dBg, Theme.border, Theme.accent, dTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);
        }

      // TASK LIST
      int listY = y + 140;
      eng.AddPanel(x + 15, listY, w - 30, 180, Theme.surface, Theme.border);
      eng.AddPanel(x + 16, listY + 1, w - 32, 26, Theme.bg, 0);
      eng.AddLabel("SCHEDULED TASKS", x + 25, listY + 5, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);

      int tY = listY + 27;
      eng.AddPanel(x + 16, tY, w - 32, 28, Theme.surface, 0);
      eng.AddLabel("EURUSD | 2025-10-25 09:00 | CLOSE ALL [Mon,Tue,Wed,Thu,Fri]", x + 25, tY + 5, "Arial", 11, Theme.textMain, TA_LEFT|TA_TOP);
      eng.AddButton(0, x + w - 45, tY + 3, 22, 22, "X", Theme.bg, Theme.sell, Theme.sell, ColorToARGB(C'255,100,100',255), Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      // STICKERS
      DrawHelpSticker(eng, c1X + 60, startY - 10, "1"); // Action
      DrawHelpSticker(eng, c2X + 90, startY - 20, "2"); // Sync & Inputs
      DrawHelpSticker(eng, c2X + 110, dY - 10, "3");    // Days
      DrawHelpSticker(eng, c1X + 60, startY + 26, "4"); // Add
      DrawHelpSticker(eng, x + (w/2) - 10, listY + 40, "5"); // List
     }

