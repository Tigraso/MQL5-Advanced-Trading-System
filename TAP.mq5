void              WritePanelToDisk()
  {
   SyncPanelToTemplateState(); // Tu función de seguridad

// 1. Estados Globales
   g_panelDisk[0].activeTab = g_activeTab;
   g_panelDisk[0].riskMode  = m_riskMode;
   g_panelDisk[0].distMode  = m_distMode;
   g_panelDisk[0].lotMode   = m_lotMode;
   g_panelDisk[0].tsMode    = m_tsMode;

// --- NUEVO: GUARDAR SETTINGS GLOBALES ---
   g_panelDisk[0].theme            = g_currentTheme;
   g_panelDisk[0].autoScreenshot   = g_autoScreenshot;
   g_panelDisk[0].manageAllMagics  = g_manageAllMagics;
   g_panelDisk[0].maxSpread        = g_maxSpread;
   g_panelDisk[0].showTradeHistory = (bool)ChartGetInteger(0, CHART_SHOW_TRADE_HISTORY);

// 2. Toggles
   g_panelDisk[0].linesActive      = m_linesActive;
   g_panelDisk[0].marketMode       = m_isMarketMode;
   g_panelDisk[0].priceMode        = m_isPriceMode;
   g_panelDisk[0].rrActive         = m_isRRActive;
   g_panelDisk[0].virtActive       = m_isVirtActive;
   g_panelDisk[0].splitActive      = m_isSplitActive;
   g_panelDisk[0].hideActive       = m_isHideActive;
   g_panelDisk[0].managerHidden    = m_isManagerHidden;
   g_panelDisk[0].ocoActive        = m_isOCOActive;
   g_panelDisk[0].tsActive         = m_isTSActive;
   g_panelDisk[0].beActive         = m_isBEActive;
   g_panelDisk[0].beAuto           = m_isBE_AutoOffset;
   g_panelDisk[0].manageAllSymbols = m_manageAllSymbols;
   g_panelDisk[0].preOpCollapsed   = m_isPreOpCollapsed;

// 3. Inputs
   g_panelDisk[0].inpRisk      = PanelState.GetRisk();
   g_panelDisk[0].inpLot       = PanelState.GetLot();
   g_panelDisk[0].inpPrice     = PanelState.GetPrice();
   g_panelDisk[0].inpTP        = PanelState.GetTP();
   g_panelDisk[0].inpSL        = PanelState.GetSL();
   g_panelDisk[0].inpRR_Reward = PanelState.GetRR_Reward();
   g_panelDisk[0].inpRR_Risk   = PanelState.GetRR_Risk();
   StringToCharArray(PanelState.GetComment(), g_panelDisk[0].inpComment);

// 4. Posiciones Visuales
   g_panelDisk[0].panelX        = Engine.m_panelX;
   g_panelDisk[0].panelY        = Engine.m_panelY;
   g_panelDisk[0].currentFixedX = m_currentFixedX;

   if(m_linesActive)
     {
      g_panelDisk[0].lineEntryPrice = ObjectGetDouble(0, m_lineEntry, OBJPROP_PRICE);
      g_panelDisk[0].lineSLPrice    = ObjectGetDouble(0, m_lineSL, OBJPROP_PRICE);
      g_panelDisk[0].lineTPPrice    = ObjectGetDouble(0, m_lineTP, OBJPROP_PRICE);
     }

// 6. Posiciones de Ventanas Modales
   g_panelDisk[0].timeX  = TimeWin.m_panelX;
   g_panelDisk[0].timeY  = TimeWin.m_panelY;
   g_panelDisk[0].protX  = ProtectWin.m_panelX;
   g_panelDisk[0].protY  = ProtectWin.m_panelY;
   g_panelDisk[0].newsX  = NewsWin.m_panelX;
   g_panelDisk[0].newsY  = NewsWin.m_panelY;
   g_panelDisk[0].modalX = Modal.m_panelX;
   g_panelDisk[0].modalY = Modal.m_panelY;
   g_panelDisk[0].confX  = ConfirmWin.m_panelX;
   g_panelDisk[0].confY  = ConfirmWin.m_panelY;

// 5. Configuración del Template
   if(CheckPointer(TemplateState) != POINTER_INVALID)
     {
      ArrayCopy(g_panelDisk[0].tsInputs,  TemplateState.ts.inputs);
      ArrayCopy(g_panelDisk[0].tsUnits,   TemplateState.ts.units);
      ArrayCopy(g_panelDisk[0].tsDropIdx, TemplateState.ts.dropIdx);

      g_panelDisk[0].beValStart   = TemplateState.be.valStart;
      g_panelDisk[0].beValOffset  = TemplateState.be.valOffset;
      g_panelDisk[0].beModeStart  = TemplateState.be.modeStart;
      g_panelDisk[0].beModeOffset = TemplateState.be.modeOffset;

      for(int i=0; i<5; i++)
        {
         g_panelDisk[0].gridRows[i].isActiveTP  = TemplateState.grid.rows[i].isActiveTP;
         g_panelDisk[0].gridRows[i].isActiveSL  = TemplateState.grid.rows[i].isActiveSL;
         g_panelDisk[0].gridRows[i].valTP_Price = TemplateState.grid.rows[i].valTP_Price;
         g_panelDisk[0].gridRows[i].valTP_Vol   = TemplateState.grid.rows[i].valTP_Vol;
         g_panelDisk[0].gridRows[i].valSL_Price = TemplateState.grid.rows[i].valSL_Price;
         g_panelDisk[0].gridRows[i].valSL_Vol   = TemplateState.grid.rows[i].valSL_Vol;
        }
     }

// ¡VOLCADO HFT AL DISCO!
// Reemplaza el FileOpen que tienes por esto:
// --- INYECCIÓN: PASAR HOTKEYS DE LA RAM AL PANEL ANTES DE GUARDAR ---
   g_panelDisk[0].hotkeys = g_hotkeyDisk[0];

   string filePath = g_dataPath + "TM_Panel.bin";
   int file = FileOpen(filePath, FILE_WRITE|FILE_BIN);
   if(file != INVALID_HANDLE)
     {
      FileWriteArray(file, g_panelDisk);
      FileClose(file);
      ////Print("Se guardó el panel");
     }
// ... Pega aquí tu código original que estaba dentro de SavePanelToBin() ...
  }

