  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              LoadVirtualOrders()
  {
   ulong maxTicket = 0;
   int diskTotal = ArraySize(g_tradeDisk);

   for(int i = 0; i < diskTotal; i++)
     {
      if(g_tradeDisk[i].isVirtual)
        {
         ulong tk = g_tradeDisk[i].ticket;
         if(tk > maxTicket)
            maxTicket = tk;

         // 1. Extraemos el símbolo del disco virtual (RAM)
         string disk_sym = CharArrayToString(g_tradeDisk[i].symbol);

         // 2. Obligamos a nacer al objeto inyectándole su verdadero ADN
         CTradeState *vMem = TradeRAM.Get(tk, disk_sym);
        }
     }
   if(maxTicket >= VIRTUAL_TICKET_BASE)
      g_virtualCounter = (maxTicket - VIRTUAL_TICKET_BASE);
  }

//+------------------------------------------------------------------+
//| RADAR: Detectar clic en Flecha de Expiración (Virtual y Real)    |
//+------------------------------------------------------------------+
ulong             GetExpArrowTicketAt(int mouseX, int mouseY)
  {
   int total = ObjectsTotal(0, -1, -1);
   for(int i = 0; i < total; i++)
     {
      string name = ObjectName(0, i, -1, -1);
      if(StringFind(name, "TM_Exp_Arrow_") == 0)
        {
         // 1. Dónde está la flecha en tiempo y precio
         datetime t = (datetime)ObjectGetInteger(0, name, OBJPROP_TIME);
         double   p = ObjectGetDouble(0, name, OBJPROP_PRICE);

         // 2. Convertir a coordenadas de la pantalla (Píxeles)
         int arrX, arrY;
         if(ChartTimePriceToXY(0, 0, t, p, arrX, arrY))
           {
            // 3. Hitbox invisible de 20x20 píxeles (Fácil de agarrar)
            if(MathAbs(mouseX - arrX) < 20 && MathAbs(mouseY - arrY) < 20)
              {
               string parts[];
               StringSplit(name, '_', parts);
               // Nombre es: TM(0)_Exp(1)_Arrow(2)_123456(3)
               if(ArraySize(parts) >= 4)
                  return (ulong)StringToInteger(parts[3]); // ¡Ticket encontrado!
              }
           }
        }
     }
   return 0;
  }

//+------------------------------------------------------------------+
//| MOTOR DE INYECCIÓN POR LOTES (Batch Configuration)               |
//+------------------------------------------------------------------+
void              ExecuteApplyTo(int mode, string targetRaw)
  {
// Limpiamos el texto
   string target = targetRaw;
   StringReplace(target, " ▼", "");

   int injectedCount = 0;
   int memTotal = TradeRAM.Total();

// 1. Asegurarnos que la RAM del Template tiene los últimos cambios de la UI
   SyncPanelToTemplateState();

// 2. Bucle de Inyección
   for(int i=0; i<memTotal; i++)
     {
      if(CheckPointer(TradeRAM.GetByIndex(i)) == POINTER_INVALID || TradeRAM.GetByIndex(i).ticket == 0)
         continue;

      ulong tk = TradeRAM.GetByIndex(i).ticket;
      bool match = false;

      // Evaluar Objetivo
      if(target == "This Symbol")
        {
         if(TradeRAM.GetByIndex(i).symbol == _Symbol)
            match = true;
        }
      else
         if(target == "All Symbols")
           {
            match = true;
           }
         else
            if(target == "Virtuals Only")
              {
               if(TradeRAM.GetByIndex(i).isVirtual)
                  match = true;
              }
            else
               if(target == "Reals Only")
                 {
                  if(!TradeRAM.GetByIndex(i).isVirtual)
                     match = true;
                 }
               else
                  if(StringFind(target, IntegerToString(tk)) > 0)
                    {
                     match = true;   // Ticket Específico
                    }

      if(match)
        {
         string sT = IntegerToString(tk);

         // ============================================
         // INYECCIÓN MODO 1 (+TP/SL: Grid, OCO, Hide)
         // ============================================
         if(mode == 1)
           {
            TradeRAM.GetByIndex(i).grid  = TemplateState.grid;
            TradeRAM.GetByIndex(i).isOCO = m_isOCOActive;
           }
         // ============================================
         // INYECCIÓN MODO 2 (AUTO: Trailing Stop, BE)
         // ============================================
         else
            if(mode == 2)
              {
               TradeRAM.GetByIndex(i).ts = TemplateState.ts;
               TradeRAM.GetByIndex(i).be = TemplateState.be;

               // Forzamos el reset del ancla del Trailing Stop para que calcule desde 0
               TradeRAM.GetByIndex(i).ts.anchorPrice = 0;
              }

         injectedCount++;
        }
     }

   if(injectedCount > 0)
     {
      PrintFormat("[Manager] Successfully applied Grid/TS/BE settings to %d trades.", injectedCount);
      PlaySound("ok.wav");
      SaveTradesToBin(); // <--- LA MAGIA: 1 Solo guardado al disco para TODAS las inyecciones
      UpdateOpenTradesVisuals();
      ChartRedraw();
     }

  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              BuildProtectUI()
  {
   if(!m_isProtectOpen)
     {
      ProtectWin.DestroyCanvas();
      DWM.UnregisterWindow(GetPointer(ProtectWin));
      return;
     }

   int chartW = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);
   int chartH = (int)ChartGetInteger(0, CHART_HEIGHT_IN_PIXELS);

// --- AUMENTO DE DIMENSIONES (Para alojar fuente 12 y la nueva caja) ---
   int mW = 510;
   int mH = 610;
   int defX = (chartW / 2) - (mW / 2);
   int defY = (chartH / 2) - (mH / 2);
   if(defY < 10)
      defY = 10;

   int mX, mY;
   if(ObjectFind(0, "CanvasProtectPro") >= 0)
     {
      mX = ProtectWin.m_panelX;
      mY = ProtectWin.m_panelY;
     }
   else
     {
      mX = (g_panelDisk[0].protX > 0) ? g_panelDisk[0].protX : defX;
      mY = (g_panelDisk[0].protY > 0) ? g_panelDisk[0].protY : defY;
     }

   ProtectWin.Clear();
   ProtectWin.Init(ENGINE_PROTECT, "CanvasProtectPro", mX, mY, mW, mH);
   DWM.RegisterWindow(GetPointer(ProtectWin));


// --- 1. HEADER ---
   ProtectWin.AddPanel(0, 0, mW, 35, Theme.surface, Theme.border);
   ProtectWin.AddLabel("EQUITY PROTECT PRO", 15, 8, "Arial", 13, Theme.accent, TA_LEFT|TA_TOP);
   ProtectWin.AddButton(OP_PROT_CLOSE, mW - 35, 5, 25, 25, "X", Theme.surface, Theme.sell, Theme.sell, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 13);

// --- 2. STATS GLOBALES (Punto 4: Datos dinámicos instantáneos para evitar parpadeos) ---
   int hY = 45;
   string eqStr = "$ " + DoubleToString(AccountInfoDouble(ACCOUNT_EQUITY), 2);
   string pkStr = "$ " + DoubleToString(g_protect.peakEquity, 2);

   string lockStatus = "SAFE";
   uint lockColor = ColorToARGB(C'40,167,69', 255); // Verde

   if(g_protect.accountLockedUntil > 0)
     {
      if(TimeCurrent() < g_protect.accountLockedUntil)
        {
         lockStatus = "LOCKED UNTIL TOMORROW";
         lockColor = ColorToARGB(C'255,50,50', 255); // Rojo
        }
     }

// Movidos hacia la izquierda (X de 155 pasa a 130)
   ProtectWin.AddLabel("Account Equity:", 15, hY, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
   ProtectWin.AddLabelNamed("valEq", eqStr, 130, hY, "Arial", 13, Theme.textMain, TA_LEFT|TA_TOP);

   ProtectWin.AddLabel("Max Equity (Peak):", 15, hY + 22, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
   ProtectWin.AddLabelNamed("valPeak", pkStr, 130, hY + 22, "Arial", 13, Theme.textMain, TA_LEFT|TA_TOP);

   ProtectWin.AddLabel("Protect Status:", 15, hY + 44, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);
   ProtectWin.AddLabelNamed("valStat", lockStatus, 130, hY + 44, "Arial", 13, lockColor, TA_LEFT|TA_TOP);

// --- NUEVO: RELOJ DEL SERVIDOR EN VIVO ---
   int timeX = mW - 260; // Posicionado al centro-derecha
   ProtectWin.AddLabel("SERVER TIME:", timeX, hY, "Arial", 12, Theme.textDim, TA_CENTER|TA_TOP);

   string sTime = TimeToString(TimeCurrent(), TIME_DATE|TIME_MINUTES|TIME_SECONDS);
   ProtectWin.AddLabelNamed("valServerTime", sTime, timeX, hY + 22, "Arial", 14, Theme.textDim, TA_CENTER|TA_TOP);

// --- BOTONES MAESTROS (A la derecha) ---
   uint cMasterBg = g_protect.masterSwitch ? Theme.sell : Theme.surface;
   uint cMasterTxt = g_protect.masterSwitch ? Theme.textMain : Theme.textDim;
   string txtMaster = g_protect.masterSwitch ? "PROTECTION: ON" : "PROTECTION: OFF";
   ProtectWin.AddButton(OP_PROT_MASTER, mW - 185, hY + 10, 170, 32, txtMaster, cMasterBg, Theme.border, Theme.sell, cMasterTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

// ===============================================================
// --- NUEVO: BOTÓN INTELIGENTE RESTORE CHARTS (PROYECTO FÉNIX) ---
// ===============================================================
   bool canRestore = FileIsExist(g_dataPath + "TM_Recovery.bin");

   uint cResBg  = canRestore ? Theme.accent : Theme.surface;
   uint cResTxt = canRestore ? Theme.bg : Theme.border; // Texto oscurecido si no hay nada
   string txtRes = canRestore ? "♻️ RESTORE CHARTS" : "NO SAVED CHARTS";

   ProtectWin.AddButton(OP_PROT_RESTORE_BTN, mW - 185, hY + 47, 170, 24, txtRes, cResBg, Theme.border, Theme.accent, cResTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 11);

// --- 3. CAJA CONTENEDORA DE REGLAS (Punto 1: Borde delimitador) ---
   int boxY = hY + 75; // Y=120
   int boxH = 32 + (14 * 32); // Header(32) + 14 filas de 32px = 480px

   ProtectWin.AddPanel(15, boxY, mW - 30, boxH, Theme.surface, Theme.border);

// Cabecera interna del contenedor
   ProtectWin.AddPanel(16, boxY + 1, mW - 32, 30, Theme.bg, 0);

   int cX[5] = {25, 125, 225, 325, 425}; // Coordenadas X ajustadas al nuevo ancho

   ProtectWin.AddLabel("FUNCTION",   cX[0], boxY + 6, "Arial", 12, Theme.textMain, TA_LEFT|TA_TOP);
   ProtectWin.AddLabel("ENABLE",     cX[1], boxY + 6, "Arial", 12, Theme.textMain, TA_LEFT|TA_TOP);
   ProtectWin.AddLabel("STATUS",     cX[2], boxY + 6, "Arial", 12, Theme.textMain, TA_LEFT|TA_TOP);
   ProtectWin.AddLabel("CONFIG",     cX[3], boxY + 6, "Arial", 12, Theme.textMain, TA_LEFT|TA_TOP);
   ProtectWin.AddLabel("CLOSE EAs",  cX[4], boxY + 6, "Arial", 12, Theme.textMain, TA_LEFT|TA_TOP);

// --- 4. MATRIZ DE 14 FILAS ---
   int rowY = boxY + 31; // Debajo de la cabecera
   int rowH = 32; // Filas más altas

   for(int i=0; i<14; i++)
     {
      int currY = rowY + (i * rowH);
      string sI = IntegerToString(i);
      uint rowBg = (i % 2 == 0) ? Theme.surface : Theme.bg; // Cebra invertida

      ProtectWin.AddPanel(16, currY, mW - 32, rowH, rowBg, 0);

      // Col 1: Function Name (12px)
      ProtectWin.AddLabel(g_protNames[i], cX[0], currY + 8, "Arial", 12, Theme.textDim, TA_LEFT|TA_TOP);

      // Col 2: Enable Button (Reemplazar "btnProtEn_"+sI)
      uint cEnBg = g_protect.f[i].enabled ? Theme.accent : Theme.bg;
      uint cEnTxt = g_protect.f[i].enabled ? Theme.bg : Theme.textDim;
      ProtectWin.AddButton(OP_PROT_EN_0 + i, cX[1], currY + 4, 60, 24, g_protect.f[i].enabled ? "ON" : "OFF", cEnBg, Theme.surface, Theme.accent, cEnTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);

      // Col 3: Status Label se queda igual porque es un AddLabelNamed (no es clickeable)
      ProtectWin.AddLabelNamed("lblProtSt_"+sI, g_protect.f[i].statusStr, cX[2], currY + 8, "Arial", 12, Theme.textMain, TA_LEFT|TA_TOP);

      // Col 4: Config Input
      if(i == 13) // Remote Symbol
        {
         string txtBtn = (g_protect.f[i].configStr == "") ? "Select ▼" : g_protect.f[i].configStr + " ▼";
         ProtectWin.AddButton(OP_PROT_DROP_SYM, cX[3], currY + 4, 85, 24, txtBtn, Theme.surface, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
        }
      else
        {
         ProtectWin.AddButton(OP_PROT_INP_0 + i, cX[3], currY + 4, 85, 24, g_protect.f[i].configStr, Theme.inputBg, Theme.surface, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
        }

      // Col 5: Close EAs Button (Reemplazar "btnProtCEA_"+sI)
      uint cCeBg = g_protect.f[i].closeEAs ? Theme.sell : Theme.bg;
      uint cCeTxt = g_protect.f[i].closeEAs ? Theme.textMain : Theme.textDim;
      ProtectWin.AddButton(OP_PROT_CEA_0 + i, cX[4], currY + 4, 60, 24, g_protect.f[i].closeEAs ? "ON" : "OFF", cCeBg, Theme.surface, Theme.sell, cCeTxt, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
     }

   ProtectWin.Render();
  }

//+------------------------------------------------------------------+
//| MOTOR DEL EQUITY PROTECT PRO (LAS 14 FUNCIONES)                  |
//+------------------------------------------------------------------+
void              CheckEquityProtection()
  {

   MqlDateTime dt;
   TimeCore.NowStruct(dt); // <--- LECTURA SINTÉTICA BLINDADA
   int today = dt.day_of_year;

// =================================================================
// 1. SISTEMA ANTI-TRAMPAS & MÉTRICAS (100% RAM / BINARIO)
// =================================================================
   if(g_protect.currentDay != today)
     {
      g_protect.currentDay   = today;
      g_protect.startBalance = AccountInfoDouble(ACCOUNT_BALANCE);
      g_protect.peakEquity   = AccountInfoDouble(ACCOUNT_EQUITY);

      // Reset de Seguros Diarios
      g_protect.trigEveryday  = false;
      g_protect.trigFriday    = false;
      g_protect.restoredToday = false;

      SaveProtectToBin(); // Guardamos el cambio de día
     }

   double currentEq = AccountInfoDouble(ACCOUNT_EQUITY);

   if(currentEq > g_protect.peakEquity)
     {
      g_protect.peakEquity = currentEq;
      SaveProtectToBin();
     }

// ✅ REEMPLAZA POR ESTA BELLEZA:
   double floatingPL = AccountInfoDouble(ACCOUNT_PROFIT);
   double sigmaPL    = g_cachedDailyProfit + floatingPL; // Matemáticas en 1 ciclo de reloj
// =================================================================
// 2. ACTUALIZAR COLUMNA "STATUS" DE LA UI (INCLUSO SI ESTÁ APAGADO)
// =================================================================
   g_protect.f[0].statusStr = DoubleToString(currentEq, 2);
   g_protect.f[1].statusStr = DoubleToString(currentEq, 2);
   g_protect.f[2].statusStr = DoubleToString(g_protect.peakEquity - currentEq, 2);

   double dropPct = (g_protect.peakEquity > 0) ? ((g_protect.peakEquity - currentEq) / g_protect.peakEquity) * 100.0 : 0;
   g_protect.f[3].statusStr = DoubleToString(dropPct, 2) + "%";

   g_protect.f[4].statusStr = DoubleToString(floatingPL, 2);
   double fltPct = (g_protect.startBalance > 0) ? (floatingPL / g_protect.startBalance) * 100.0 : 0;
   g_protect.f[5].statusStr = DoubleToString(fltPct, 2) + "%";

   g_protect.f[6].statusStr = DoubleToString(floatingPL, 2);
   g_protect.f[7].statusStr = DoubleToString(fltPct, 2) + "%";

   g_protect.f[8].statusStr = DoubleToString(sigmaPL, 2);

// --- CREACIÓN MATEMÁTICA DE FECHAS (Cero Strings, 100% Precisión Sintética) ---
   MqlDateTime dtTarget;
   TimeCore.NowStruct(dtTarget); // Leemos el reloj fluido
   dtTarget.sec = 0;

// 9. EVERYDAY
   dtTarget.hour = g_protect.f[9].configHour;
   dtTarget.min  = g_protect.f[9].configMin;
   datetime target9 = StructToTime(dtTarget);
   g_protect.f[9].statusStr = TimeToString(target9, TIME_MINUTES);

// Rearmado Automático Everyday
   if(TimeCore.Now() < target9 && g_protect.trigEveryday)
     { g_protect.trigEveryday = false; Print(">>> [RADAR] Everyday rearmado."); }

// 10. FRIDAY
   dtTarget.hour = g_protect.f[10].configHour;
   dtTarget.min  = g_protect.f[10].configMin;
   datetime target10 = StructToTime(dtTarget);

// Solo mostramos la hora si hoy es Viernes real (Sintético)
   MqlDateTime dtNow;
   TimeCore.NowStruct(dtNow);
   g_protect.f[10].statusStr = (dtNow.day_of_week == 5) ? TimeToString(target10, TIME_MINUTES) : "Not Friday";

// Rearmado Automático Friday
   if(TimeCore.Now() < target10 && g_protect.trigFriday)
     { g_protect.trigFriday = false; Print(">>> [RADAR] Friday rearmado."); }

// 11. SPECIFIC DATETIME
   datetime target11 = g_protect.f[11].configTime;
   g_protect.f[11].statusStr = TimeToString(target11, TIME_DATE|TIME_MINUTES);

// Rearmado Automático Datetime
   if(TimeCore.Now() < target11 && g_protect.trigDatetime)
     {
      g_protect.trigDatetime = false;  }//Print(">>> [RADAR] Datetime rearmado.");

      // 12. RESTORE
      dtTarget.hour = g_protect.f[12].configHour;
      dtTarget.min  = g_protect.f[12].configMin;
      datetime target12 = StructToTime(dtTarget);
      g_protect.f[12].statusStr = TimeToString(target12, TIME_MINUTES);


      if(TimeCore.Now() < target12 && g_protect.restoredToday)
        {
         g_protect.restoredToday = false;
        }

      string panicSym = g_protect.f[13].configStr;
      g_protect.f[13].statusStr = (panicSym != "" && panicSym != "Select") ? ("Scan: " + panicSym) : "No Symbol";

      // =================================================================
      // 3. LA FUNCIÓN RESTORE (Siempre evalúa para revivir los gráficos)
      // =================================================================
      if(g_protect.masterSwitch && g_protect.f[12].enabled)
        {
         // --- TELEMETRÍA (RADAR) ---

         // Revisamos si es la hora exacta (y no se ha restaurado hoy)
         if(TimeCore.Now() >= target12 && !g_protect.restoredToday)
           {
            //Print(">>> [RESTORE DETONADO] ¡Condición cumplida! Reviviendo gráficos...");
            RestoreWorkspace(); // <--- USA EL NUEVO MOTOR BINARIO

            // --- FIX VITAL: ¡QUITAR EL CANDADO DE LA CUENTA! ---
            g_protect.accountLockedUntil = 0;
            g_protect.peakEquity = AccountInfoDouble(ACCOUNT_EQUITY); // Reset del pico histórico

            g_protect.restoredToday = true; // Cartucho gastado para que no se repita en bucle hoy
            SaveProtectToBin();             // Guardamos en el disco

            // Actualizamos la UI por si el usuario la está mirando
            if(m_isProtectOpen)
              {
               BuildProtectUI();
              }
           }
        }

      // --- BARRERAS DE SALIDA ANTES DE EVALUAR DETONADORES ---
      if(!g_protect.masterSwitch)
         return;

      if(g_protect.accountLockedUntil > TimeCore.Now())
         return; // Bloqueo nuclear nativo de RAM

      // =================================================================
      // 4. EVALUAR DETONADORES
      // =================================================================
      bool triggered = false;
      int triggerSrc = -1;
      string reason = "";

      for(int i=0; i<14; i++)
        {
         if(i == 12 || !g_protect.f[i].enabled)
            continue;
         double cVal = g_protect.f[i].configNum; // SUPER VELOCIDAD

         switch(i)
           {
            case 0:
               if(currentEq <= cVal)
                 {
                  triggered = true;
                  reason = "Lower Limit Hit";
                  triggerSrc = i;
                 }
               break;
            case 1:
               if(currentEq >= cVal && cVal > 0)
                 {
                  triggered = true;
                  reason = "Upper Limit Hit";
                  triggerSrc = i;
                 }
               break;
            case 2:
               if((g_protect.peakEquity - currentEq) >= cVal && cVal > 0)
                 {
                  triggered = true;
                  reason = "Trailing Drop ($) Hit";
                  triggerSrc = i;
                 }
               break;
            case 3:
               if(dropPct >= cVal && cVal > 0)
                 {
                  triggered = true;
                  reason = "Trailing Drop (%) Hit";
                  triggerSrc = i;
                 }
               break;
            case 4:
               if(floatingPL <= cVal && cVal < 0)
                 {
                  triggered = true;
                  reason = "Floating Loss ($) Hit";
                  triggerSrc = i;
                 }
               break;
            case 5:
               if(fltPct <= cVal && cVal < 0)
                 {
                  triggered = true;
                  reason = "Floating Loss (%) Hit";
                  triggerSrc = i;
                 }
               break;
            case 6:
               if(floatingPL >= cVal && cVal > 0)
                 {
                  triggered = true;
                  reason = "Floating Profit ($) Hit";
                  triggerSrc = i;
                 }
               break;
            case 7:
               if(fltPct >= cVal && cVal > 0)
                 {
                  triggered = true;
                  reason = "Floating Profit (%) Hit";
                  triggerSrc = i;
                 }
               break;
            case 8:
               if(sigmaPL >= cVal && cVal > 0)
                 {
                  triggered = true;
                  reason = "Accumulated Profit (Sigma) Hit";
                  triggerSrc = i;
                 }
               break;
            case 9: // EVERYDAY
               if(TimeCore.Now() >= target9 && !g_protect.trigEveryday)
                 {
                  triggered = true;
                  //reason = "Everyday Time Reached";
                  triggerSrc = i;

                  g_protect.trigEveryday = true; // Gastamos el cartucho PARA SIEMPRE hoy
                  SaveProtectToBin();
                 }
               break;

            case 10: // FRIDAY
               // Verificamos que sea Viernes (5) en el reloj sintético puro
               if(dtNow.day_of_week == 5 && TimeCore.Now() >= target10 && !g_protect.trigFriday)
                 {
                  triggered = true;
                  //reason = "Friday Time Reached";
                  triggerSrc = i;

                  g_protect.trigFriday = true; // Gastamos el cartucho PARA SIEMPRE este viernes
                  SaveProtectToBin();
                 }
               break;

            case 11: // SPECIFIC DATETIME
               if(TimeCore.Now() >= target11 && !g_protect.trigDatetime)
                 {
                  triggered = true;
                  //reason = "Specific Datetime Reached";
                  triggerSrc = i;

                  g_protect.trigDatetime = true; // El cartucho se quema. Solo revivirá si cambian la fecha al futuro.
                  SaveProtectToBin();
                 }
               break;
            case 13:
               if(panicSym != "" && panicSym != "Select")
                 {
                  for(int k=OrdersTotal()-1; k>=0; k--)
                    {
                     ulong t = OrderGetTicket(k);
                     if(OrderGetString(ORDER_SYMBOL) == panicSym)
                       {
                        triggered = true;
                        reason = "REMOTE PANIC BUTTON TRIGGERED!";
                        triggerSrc = i;
                        QueueDeleteOrder(t);
                        break;
                       }
                    }
                 }
               break;
           }
         if(triggered)
            break;
        }

      if(triggered && triggerSrc >= 0)
        {
         bool permisoCierre = g_protect.f[triggerSrc].closeEAs;
         ExecuteNuclearOption(reason, g_protect.f[triggerSrc].closeEAs);
        }
     }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
   void              ExecuteNuclearOption(string reason, bool closeOtherCharts)
     {

      // --- LOG & SOUND: EQUITY PROTECT NUKE ---
      PrintFormat("[Equity Protect] FATAL TRIGGER: %s. Liquidating all positions and locking EA.", reason);
      PlaySound("timeout.wav");
      // ----------------------------------------



      // 1. Cerrar Operaciones y Órdenes Reales
      for(int i = PositionsTotal() - 1; i >= 0; i--)
        {
         ulong t = PositionGetTicket(i);
         if(t > 0)
            QueueClosePosition(t);
        }
      for(int i = OrdersTotal() - 1; i >= 0; i--)
        {
         ulong t = OrderGetTicket(i);
         if(t > 0)
            QueueDeleteOrder(t);
        }

      // 2. Aniquilar Órdenes Virtuales
      int memTotal = TradeRAM.Total();
      for(int i = memTotal - 1; i >= 0; i--)
        {
         if(CheckPointer(TradeRAM.GetByIndex(i)) != POINTER_INVALID && TradeRAM.GetByIndex(i).isVirtual)
           {
            ulong vTicket = TradeRAM.GetByIndex(i).ticket;
            TradeRAM.GetByIndex(i).isVirtual = false;
            DeleteVirtualOrderData(vTicket);
           }
        }

      // 3. Bloqueo Lógico (Candado hasta media noche) en RAM
      MqlDateTime dt;
      TimeCurrent(dt);
      dt.hour = 23;
      dt.min = 59;
      dt.sec = 59;

      g_protect.accountLockedUntil = StructToTime(dt);
      SaveProtectToBin();

      // 4. Cerrar y Guardar otros gráficos
      if(closeOtherCharts)
        {
         //Print(">>> [DEBUG NUCLEAR] Permiso concedido. Llamando a SaveWorkspaceAndCloseCharts()...");
         SaveWorkspaceAndCloseCharts();
        }
      else
        {
         //Print(">>> [DEBUG NUCLEAR] Se ignoró el cierre de gráficos porque el parámetro es FALSE.");
        }

      UpdateOpenTradesVisuals();
      ChartRedraw();

      if(m_isProtectOpen)
        {
         BuildProtectUI();
        }

      Alert("ACCOUNT PROTECTED!\n" + reason + "\nAll trades closed and EA locked until tomorrow.");
     }

//+------------------------------------------------------------------+
//| MOTOR DE GUARDADO: Congela el entorno y cierra los gráficos      |
//+------------------------------------------------------------------+
   void              SaveWorkspaceAndCloseCharts()
     {
      //Print(">>> [FÉNIX] Iniciando protocolo de guardado y cierre de gráficos...");
      SChartRecovery recoveryList[];
      int count = 0;

      // 1. RECOLECTAR IDs PRIMERO (Para no romper la cadena de MT5 al cerrar)
      long chartsToClose[];
      int chartsCount = 0;
      long currChart = ChartFirst();

      while(currChart >= 0)
        {
         // ESCUDO: No nos suicidamos a nosotros mismos (El gráfico maestro sobrevive)
         if(currChart != m_chartId)
           {
            ArrayResize(chartsToClose, chartsCount + 1, 20);
            chartsToClose[chartsCount] = currChart;
            chartsCount++;
           }
         currChart = ChartNext(currChart);
        }

      //Print(">>> [FÉNIX] Gráficos secundarios detectados: ", chartsCount);

      // 2. GUARDAR PLANTILLAS Y LUEGO CERRARLOS DE GOLPE
      for(int i = 0; i < chartsCount; i++)
        {
         long targetChart = chartsToClose[i];
         string sym = ChartSymbol(targetChart);
         ENUM_TIMEFRAMES tf = ChartPeriod(targetChart);

         // Usamos el índice 'count' para no sobrescribir plantillas válidas
         string templateName = "TM_REC_" + IntegerToString(count) + ".tpl";
         //Print(">>> [FÉNIX] Guardando plantilla: ", templateName, " (", sym, ")");

         if(ChartSaveTemplate(targetChart, templateName))
           {
            ArrayResize(recoveryList, count + 1, 20);
            StringToCharArray(sym, recoveryList[count].symbol);
            recoveryList[count].timeframe = tf;
            StringToCharArray(templateName, recoveryList[count].tplName);
            count++;
           }
         else
           {
            //Print(">>> [FÉNIX] ERROR al guardar plantilla. Código MT5: ", GetLastError());
           }

         // Asesinamos el gráfico ahora que estamos seguros
         //Print(">>> [FÉNIX] Cerrando gráfico: ", sym);
         ChartClose(targetChart);
        }

      // 3. VOLCADO BINARIO DEL ÍNDICE AL DISCO DURO
      if(count > 0)
        {
         string filePath = g_dataPath + "TM_Recovery.bin";
         int file = FileOpen(filePath, FILE_WRITE|FILE_BIN);
         if(file != INVALID_HANDLE)
           {
            FileWriteArray(file, recoveryList);
            FileClose(file);
            //Print(">>> [FÉNIX] ÉXITO. Entorno guardado. Gráficos congelados: ", count);
           }
         else
           {
            //Print(">>> [FÉNIX] ERROR CRÍTICO al crear archivo .bin. Código: ", GetLastError());
           }
        }
      else
        {
         //Print(">>> [FÉNIX] No se guardó nada. No había otros gráficos o falló el volcado.");
        }
     }

//+------------------------------------------------------------------+
//| MOTOR DE RESTAURACIÓN: Revive los gráficos                       |
//+------------------------------------------------------------------+
   void              RestoreWorkspace()
     {
      string filePath = g_dataPath + "TM_Recovery.bin";
      //Print(">>> [FÉNIX] Intentando restaurar gráficos desde: ", filePath);

      // Si no hay archivo, no hay nada que hacer
      if(!FileIsExist(filePath))
        {
         //Print(">>> [FÉNIX] No se encontró el archivo de recuperación.");
         return;
        }

      SChartRecovery recoveryList[];
      int file = FileOpen(filePath, FILE_READ|FILE_BIN);

      if(file != INVALID_HANDLE)
        {
         // Extraemos la matriz entera desde el archivo binario
         FileReadArray(file, recoveryList);
         FileClose(file);

         int total = ArraySize(recoveryList);
         //Print(">>> [FÉNIX] Iniciando restauración. Gráficos a revivir: ", total);

         for(int i = 0; i < total; i++)
           {
            string sym = CharArrayToString(recoveryList[i].symbol);
            string tpl = CharArrayToString(recoveryList[i].tplName);
            ENUM_TIMEFRAMES tf = recoveryList[i].timeframe;

            //Print(">>> [FÉNIX] Abriendo gráfico: ", sym, " | Plantilla: ", tpl);

            // 1. Abrimos el gráfico
            long newChart = ChartOpen(sym, tf);
            if(newChart > 0)
              {
               // 2. Aplicamos la plantilla reciclada
               if(!ChartApplyTemplate(newChart, tpl))
                 {
                  //Print(">>> [FÉNIX] ERROR al aplicar la plantilla en el nuevo gráfico. MT5 Code: ", GetLastError());
                 }
              }
            else
              {
               //Print(">>> [FÉNIX] ERROR al abrir el símbolo ", sym, ". MT5 Code: ", GetLastError());
              }
           }

         // 3. Destruimos el archivo binario del registro
         FileDelete(filePath);

         //Print(">>> [FÉNIX] Restauración completada con éxito.");
        }
      else
        {
         //Print(">>> [FÉNIX] ERROR CRÍTICO al leer el archivo .bin. MT5 Code: ", GetLastError());
        }
     }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
   void              InitProtectDefaults()
     {
      g_protect.masterSwitch = false;
      for(int i=0; i<14; i++)
        {
         g_protect.f[i].enabled  = false;
         g_protect.f[i].closeEAs = false;
         g_protect.f[i].statusStr= "---";
        }

      // Textos por defecto para la columna CONFIG
      g_protect.f[0].configStr = "10000.0"; // Lower
      g_protect.f[1].configStr = "20000.0"; // Upper
      g_protect.f[2].configStr = "500.0";   // Trail $
      g_protect.f[3].configStr = "5.0";     // Trail %
      g_protect.f[4].configStr = "-200.0";  // Loss $
      g_protect.f[5].configStr = "-2.0";    // Loss %
      g_protect.f[6].configStr = "300.0";   // Profit $
      g_protect.f[7].configStr = "3.0";     // Profit %
      g_protect.f[8].configStr = "400.0";   // Profit Sigma
      g_protect.f[9].configStr = "23:50";   // Everyday
      g_protect.f[10].configStr= "23:00";   // Friday
      g_protect.f[11].configStr= "2025.12.31 23:59"; // Datetime
      g_protect.f[12].configStr= "01:00";   // Restore
      g_protect.f[13].configStr= "AUDNZD";  // Remote

      // PRE-CALCULAR LA RAM RÁPIDA:
      for(int i=0; i<=12; i++)
        {
         if(i <= 8)
            g_protect.f[i].configNum = StringToDouble(g_protect.f[i].configStr);
         else
            if(i == 11)
               g_protect.f[i].configTime = StringToTime(g_protect.f[i].configStr);
            else
              {
               string parts[];
               if(StringSplit(g_protect.f[i].configStr, ':', parts) >= 2)
                 {
                  g_protect.f[i].configHour = (int)StringToInteger(parts[0]);
                  g_protect.f[i].configMin  = (int)StringToInteger(parts[1]);
                 }
              }
        }
     }

//+------------------------------------------------------------------+
//| ACTUALIZADOR VISUAL DE LA TABLA EQUITY PROTECT                   |
//+------------------------------------------------------------------+
   void              UpdateProtectUI()
     {
      if(!m_isProtectOpen)
         return;

      // 1. Actualizar Datos Globales (Header)
      ProtectWin.SetLabelText("valEq", "$ " + DoubleToString(AccountInfoDouble(ACCOUNT_EQUITY), 2));
      ProtectWin.SetLabelText("valPeak", "$ " + DoubleToString(g_protect.peakEquity, 2));

      string lockStatus = "SAFE";
      uint lockColor = ColorToARGB(C'40,167,69', 255); // Verde

      if(g_protect.accountLockedUntil > 0)
        {
         if(TimeCore.Now() < g_protect.accountLockedUntil)
           {
            lockStatus = "LOCKED UNTIL TOMORROW";
            lockColor = ColorToARGB(C'255,50,50', 255); // Rojo
           }
        }

      ProtectWin.SetLabelText("valStat", lockStatus);
      ProtectWin.SetLabelColor("valStat", lockColor);

      // --- NUEVO: ACTUALIZAR EL RELOJ DEL SERVIDOR EN VIVO ---
      string sTime = TimeToString(TimeCore.Now(), TIME_DATE|TIME_MINUTES|TIME_SECONDS);
      ProtectWin.SetLabelText("valServerTime", sTime);

      // 2. Actualizar las 14 filas de Status
      for(int i=0; i<14; i++)
        {
         ProtectWin.SetLabelText("lblProtSt_" + IntegerToString(i), g_protect.f[i].statusStr);
        }

      ProtectWin.Render();
     }

//+------------------------------------------------------------------+
//| MOTOR DEL ORÁCULO: Extraer noticias nativas de MT5               |
//+------------------------------------------------------------------+
   void              FetchCalendarNews()
     {
      ArrayResize(g_newsList, 0); // Vaciamos la memoria

      // 1. Definir la ventana de tiempo (Desde hoy menos 2 horas, hasta 7 días en el futuro)
      datetime now = TimeCurrent();
      datetime startSearch = now - (2 * 3600);
      datetime endSearch   = now + (7 * 86400);

      MqlCalendarValue values[];

      // 2. Extraer todo el historial futuro
      if(CalendarValueHistory(values, startSearch, endSearch))
        {
         int total = ArraySize(values);
         int count = 0;

         // 3. Extraer las monedas del gráfico actual (Ej: "EURUSD" . "EUR" y "USD")
         string sym = _Symbol;
         string curBase   = StringSubstr(sym, 0, 3);
         string curProfit = StringSubstr(sym, 3, 3);

         for(int i=0; i<total; i++)
           {
            MqlCalendarEvent ev;

            // 4. Buscar los detalles del evento (Nombre, Importancia, País)
            if(CalendarEventById(values[i].event_id, ev))
              {
               // Obtener la moneda del país del evento
               MqlCalendarCountry country;
               string evCurrency = "";
               if(CalendarCountryById(ev.country_id, country))
                  evCurrency = country.currency;

               // FILTRO 1: ¿Es una noticia para nuestras monedas?
               if(evCurrency != curBase && evCurrency != curProfit)
                  continue;

               // FILTRO 2: ¿Es de impacto Medio o Alto? (Ignoramos las bajas para no saturar)
               if(ev.importance == CALENDAR_IMPORTANCE_NONE)
                  continue;

               // 5. Guardar en RAM
               ArrayResize(g_newsList, count + 1, 500);
               g_newsList[count].time       = values[i].time;
               g_newsList[count].currency   = evCurrency;
               g_newsList[count].name       = ev.name;
               g_newsList[count].importance = (int)ev.importance;
               g_newsList[count].id         = values[i].event_id;
               g_newsList[count].showLine = false;
               count++;
              }
           }
        }
     }

//+------------------------------------------------------------------+
//| DIBUJAR LÍNEAS DE NOTICIAS (Con Fusión de Solapamientos)         |
//+------------------------------------------------------------------+
   void              DrawNewsLines()
     {
      ObjectsDeleteAll(m_chartId, "TM_NewsLine_");

      int total = ArraySize(g_newsList);
      for(int i=0; i<total; i++)
        {
         // Filtros base
         if(g_newsList[i].time < TimeCurrent() - (4*3600))
            continue;
         if(!g_newsList[i].showLine)
            continue; // Solo si está encendida individualmente

         int imp = g_newsList[i].importance;
         if(imp == CALENDAR_IMPORTANCE_HIGH && !g_newsFltHigh)
            continue;
         if(imp == CALENDAR_IMPORTANCE_MODERATE && !g_newsFltMed)
            continue;
         if(imp == CALENDAR_IMPORTANCE_LOW && !g_newsFltLow)
            continue;

         // EL TRUCO: Nombramos la línea con el TIEMPO EXACTO, no con el ID de la noticia.
         // Así, si 3 noticias son a las 14:30, comparten la misma línea.
         string lineName = "TM_NewsLine_" + IntegerToString((long)g_newsList[i].time);

         color newCol = C'100,100,100';
         if(imp == CALENDAR_IMPORTANCE_HIGH)
            newCol = C'255,50,50';
         if(imp == CALENDAR_IMPORTANCE_MODERATE)
            newCol = C'255,160,0';

         string impactStr = (imp == 3) ? "[HIGH]" : (imp == 2) ? "[MED]" : "[LOW]";
         string newText = TimeToString(g_newsList[i].time, TIME_MINUTES) + " | " + impactStr + " " + g_newsList[i].currency + " | " + g_newsList[i].name;

         if(ObjectFind(m_chartId, lineName) < 0)
           {
            // La línea no existe, la creamos
            ObjectCreate(m_chartId, lineName, OBJ_VLINE, 0, g_newsList[i].time, 0);
            ObjectSetInteger(m_chartId, lineName, OBJPROP_COLOR, newCol);
            ObjectSetInteger(m_chartId, lineName, OBJPROP_STYLE, STYLE_DASHDOT);
            ObjectSetInteger(m_chartId, lineName, OBJPROP_WIDTH, 1);
            ObjectSetInteger(m_chartId, lineName, OBJPROP_BACK, true);
            ObjectSetInteger(m_chartId, lineName, OBJPROP_SELECTABLE, false);
            ObjectSetString(m_chartId, lineName, OBJPROP_TOOLTIP, newText);
           }
         else
           {
            // ¡LA LÍNEA YA EXISTE EN ESTA HORA! (Solapamiento)
            // 1. Upgrade de Color (Si la nueva es más importante, cambiamos el color)
            color currCol = (color)ObjectGetInteger(m_chartId, lineName, OBJPROP_COLOR);
            if(newCol == C'255,50,50' || (newCol == C'255,160,0' && currCol == C'100,100,100'))
              {
               ObjectSetInteger(m_chartId, lineName, OBJPROP_COLOR, newCol);
              }
            // 2. Fusión de Tooltip (Añadimos un salto de línea \n y el nuevo evento)
            string currTooltip = ObjectGetString(m_chartId, lineName, OBJPROP_TOOLTIP);
            ObjectSetString(m_chartId, lineName, OBJPROP_TOOLTIP, currTooltip + "\n" + newText);
           }
        }
     }


