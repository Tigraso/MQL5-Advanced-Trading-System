//+------------------------------------------------------------------+
   void              DrawCanvasSubMenu_Color(CUIEngine &subEngine, ulong ticket, int finalMenuX, int btnY)
     {
      int subW = 125;
      int subH = 65;
      int subX = GetSmartSubMenuX(finalMenuX, subW);
      string canvasName = "CanvasSubMenu_" + IntegerToString(ticket);

      if(ObjectFind(0, canvasName) < 0)
        {
         subEngine.Init(ENGINE_EA2_SUBMENU, canvasName, subX, btnY, subW, subH, ticket);
         DWM.RegisterWindow(GetPointer(subEngine));
         ObjectSetInteger(0, canvasName, OBJPROP_ZORDER, Z_SUB_MENU);
         ObjectSetInteger(0, canvasName, OBJPROP_BACK, false);
        }
      else
        {
         ObjectSetInteger(0, canvasName, OBJPROP_XDISTANCE, subX);
         ObjectSetInteger(0, canvasName, OBJPROP_YDISTANCE, btnY);
         subEngine.m_panelX = subX;
         subEngine.m_panelY = btnY;
        }
      subEngine.Clear();

      subEngine.AddPanel(0, 0, subW, subH, Theme.bg, Theme.border); // <-- TEMA
      subEngine.AddLabel("Select Color:", 5, 5, "Arial", 12, Theme.textMain, TA_LEFT|TA_TOP);

      color pal[10] = { C'0,120,215', C'40,167,69', C'220,53,69', C'255,160,0', C'180,80,255', C'0,240,240', C'255,20,110', C'255,200,0', C'150,150,150', clrNONE };

      int sX = 8, sY = 22, size = 18, gap = 4;
      for(int i = 0; i < 10; i++)
        {
         int col = i % 5;
         int row = i / 5;
         string txt = (pal[i] == clrNONE) ? "X" : "";

         // Si el color es NONE, usamos el fondo "surface" del tema actual
         uint bgC  = (pal[i] == clrNONE) ? Theme.surface : ColorToARGB(pal[i], 255);
         uint txtC = Theme.textDim;

         subEngine.AddButton((ushort)(OP_TM_COLOR_0 + i), sX + (col * (size + gap)), sY + (row * (size + gap)), size, size, txt, bgC, Theme.border, bgC, txtC, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
        }
      subEngine.Render();
     }

