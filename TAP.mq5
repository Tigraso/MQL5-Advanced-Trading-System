      eng.AddButton(0, colLeft + lblW + gap, wY, inpW, 24, "15.0", Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
      eng.AddLabel("SL:", colRight + (lblW / 2), wY + 4, "Arial", 12, Theme.textDim, TA_CENTER|TA_TOP);
      eng.AddButton(0, colRight + lblW + gap, wY, inpW, 24, "1.00", Theme.inputBg, Theme.border, Theme.accent, Theme.textMain, Theme.border, TA_CENTER|TA_VCENTER, "Arial", 12);
