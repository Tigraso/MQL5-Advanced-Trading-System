//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
int               GetIndex(string val, string &arr[])
  {
   int size = ArraySize(arr);
   for(int i=0; i<size; i++)
      if(arr[i] == val)
         return i;
   return 0;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void              UpdateMenuPos(ulong ticket, int &x, int &y, bool update)
  {
   int size = ArraySize(g_menus);
   for(int i=0; i<size; i++)
     {
      if(g_menus[i].ticket == ticket)
        {
         if(update)
           {
            if(x == -1)
              {
               g_menus[i].x = -1;
               g_menus[i].y = -1;
              }
            else
              {
               g_menus[i].x = x;
               g_menus[i].y = y;
              }
           }
         else
           {
            x = g_menus[i].x;
            y = g_menus[i].y;
           }
         return;
        }
     }
   if(update && x != -1)
     {
      ArrayResize(g_menus, size+1);
      g_menus[size].ticket = ticket;
      g_menus[size].x = x;
      g_menus[size].y = y;
     }
  }

